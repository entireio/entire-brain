{"parentUuid":"842f48ec-b68c-4604-98e8-4bfd732115e8","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/suhaan/devenv/p0p1/p1-new/internal/cli/facts_admin_cmd.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"github.com/ashtom/entire-brain/internal/factsync\"\n6\t\t\"strings\"\n7\t\t\"time\"\n8\t\n9\t\t\"github.com/spf13/cobra\"\n10\t)\n11\t\n12\tconst defaultFactRetention = 30 * 24 * time.Hour\n13\t\n14\tfunc newFactsCommand(opts Options) *cobra.Command {\n15\t\tcmd := &cobra.Command{\n16\t\t\tUse:   \"facts\",\n17\t\t\tShort: \"Review, promote, and garbage-collect durable facts\",\n18\t\t\tArgs:  cobra.NoArgs,\n19\t\t}\n20\t\tcmd.AddCommand(newFactsTreeCommand(opts))\n21\t\tcmd.AddCommand(newFactsStatusCommand(opts))\n22\t\tcmd.AddCommand(newFactsSyncCommand(opts))\n23\t\tcmd.AddCommand(newFactsVitalityCommand(opts))\n24\t\tcmd.AddCommand(newFactsEvalCommand(opts))\n25\t\tcmd.AddCommand(newFactsEvalGenCommand(opts))\n26\t\tcmd.AddCommand(newFactsEvalCompareCommand(opts))\n27\t\tcmd.AddCommand(newFactsReviewCommand(opts))\n28\t\tcmd.AddCommand(newFactsProposalsCommand(opts))\n29\t\tcmd.AddCommand(newFactsPromoteCommand(opts))\n30\t\tcmd.AddCommand(newFactsRetractCommand(opts))\n31\t\tcmd.AddCommand(newFactsGCCommand(opts))\n32\t\tcmd.AddCommand(newFactsReclassifyCommand(opts))\n33\t\tcmd.AddCommand(newFactsOutlineCommand(opts))\n34\t\tcmd.AddCommand(newFactsMapCommand(opts))\n35\t\treturn cmd\n36\t}\n37\t\n38\tfunc newFactsRetractCommand(opts Options) *cobra.Command {\n39\t\tvar (\n40\t\t\tbranch  string\n41\t\t\tjsonOut bool\n42\t\t)\n43\t\tcmd := &cobra.Command{\n44\t\t\tUse:   \"retract <fact-id>\",\n45\t\t\tShort: \"Mark a fact as retracted (no longer true); pruned later by gc\",\n46\t\t\tArgs:  cobra.ExactArgs(1),\n47\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n48\t\t\t\tfactID := args[0]\n49\t\t\t\t_, brainDir, resolvedBranch, err := resolveFactsTarget(cmd.Context(), opts, agentSurfaceTarget(opts, nil), branch)\n50\t\t\t\tif err != nil {\n51\t\t\t\t\treturn err\n52\t\t\t\t}\n53\t\t\t\tnow := opts.Now().UTC()\n54\t\t\t\tchanged := false\n55\t\t\t\tif err := withBrainWriteLock(brainDir, func() error {\n56\t\t\t\t\tfacts, err := loadFacts(brainDir, resolvedBranch)\n57\t\t\t\t\tif err != nil {\n58\t\t\t\t\t\treturn err\n59\t\t\t\t\t}\n60\t\t\t\t\tfound, didChange := retractFact(facts, factID, now)\n61\t\t\t\t\tif !found {\n62\t\t\t\t\t\treturn fmt.Errorf(\"no fact %s on %s\", factID, resolvedBranch)\n63\t\t\t\t\t}\n64\t\t\t\t\tchanged = didChange\n65\t\t\t\t\tif !changed {\n66\t\t\t\t\t\treturn nil\n67\t\t\t\t\t}\n68\t\t\t\t\tif err := writeFacts(brainDir, resolvedBranch, facts); err != nil {\n69\t\t\t\t\t\treturn err\n70\t\t\t\t\t}\n71\t\t\t\t\treturn updateFactSourceManifestLocked(brainDir, now)\n72\t\t\t\t}); err != nil {\n73\t\t\t\t\treturn err\n74\t\t\t\t}\n75\t\t\t\tif jsonOut {\n76\t\t\t\t\treturn writeJSON(cmd, map[string]any{\"id\": factID, \"branch\": resolvedBranch, \"status\": factStatusRetracted, \"changed\": changed})\n77\t\t\t\t}\n78\t\t\t\tif changed {\n79\t\t\t\t\tfmt.Fprintf(cmd.OutOrStdout(), \"retracted %s on %s (run `facts gc --force` to prune)\\n\", factID, resolvedBranch)\n80\t\t\t\t} else {\n81\t\t\t\t\tfmt.Fprintf(cmd.OutOrStdout(), \"%s on %s was already retracted\\n\", factID, resolvedBranch)\n82\t\t\t\t}\n83\t\t\t\treturn nil\n84\t\t\t},\n85\t\t}\n86\t\tcmd.Flags().StringVar(&branch, \"branch\", \"\", \"Branch the fact belongs to (default: current branch)\")\n87\t\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"Emit the result as JSON\")\n88\t\treturn cmd\n89\t}\n90\t\n91\t// --- review ---------------------------------------------------------------\n92\t\n93\tfunc newFactsReviewCommand(opts Options) *cobra.Command {\n94\t\tvar (\n95\t\t\tbranch    string\n96\t\t\tjsonOut   bool\n97\t\t\tapply     string\n98\t\t\treject    string\n99\t\t\tapplyAll  bool\n100\t\t\trejectAll bool\n101\t\t)\n102\t\tcmd := &cobra.Command{\n103\t\t\tUse:   \"review\",\n104\t\t\tShort: \"Resolve queued low-confidence merge/supersede proposals\",\n105\t\t\tArgs:  cobra.NoArgs,\n106\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n107\t\t\t\t_, brainDir, resolvedBranch, err := resolveFactsTarget(cmd.Context(), opts, agentSurfaceTarget(opts, nil), branch)\n108\t\t\t\tif err != nil {\n109\t\t\t\t\treturn err\n110\t\t\t\t}\n111\t\t\t\treturn runFactsReview(cmd, opts, brainDir, resolvedBranch, factsReviewActions{apply: apply, reject: reject, applyAll: applyAll, rejectAll: rejectAll, jsonOut: jsonOut})\n112\t\t\t},\n113\t\t}\n114\t\tcmd.Flags().StringVar(&branch, \"branch\", \"\", \"Branch to review (default: current branch)\")\n115\t\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"List pending proposals as JSON\")\n116\t\tcmd.Flags().StringVar(&apply, \"apply\", \"\", \"Apply the proposal for this candidate fact id\")\n117\t\tcmd.Flags().StringVar(&reject, \"reject\", \"\", \"Reject the proposal for this candidate fact id\")\n118\t\tcmd.Flags().BoolVar(&applyAll, \"apply-all\", false, \"Apply every pending proposal\")\n119\t\tcmd.Flags().BoolVar(&rejectAll, \"reject-all\", false, \"Reject every pending proposal\")\n120\t\treturn cmd\n121\t}\n122\t\n123\t// bulkDecisionVerb / targetedDecisionVerb name the `facts proposals` subcommand\n124\t// that settles a shared proposal the same way the local flags asked for.\n125\tfunc bulkDecisionVerb(act factsReviewActions) string {\n126\t\tif act.rejectAll {\n127\t\t\treturn \"reject\"\n128\t\t}\n129\t\treturn \"apply\"\n130\t}\n131\t\n132\tfunc targetedDecisionVerb(act factsReviewActions) string {\n133\t\tif act.reject != \"\" {\n134\t\t\treturn \"reject\"\n135\t\t}\n136\t\treturn \"apply\"\n137\t}\n138\t\n139\ttype factsReviewActions struct {\n140\t\tapply, reject       string\n141\t\tapplyAll, rejectAll bool\n142\t\tjsonOut             bool\n143\t}\n144\t\n145\tfunc runFactsReview(cmd *cobra.Command, opts Options, brainDir, branch string, act factsReviewActions) error {\n146\t\tnow := opts.Now().UTC()\n147\t\n148\t\t// No resolution requested: list pending proposals.\n149\t\tif act.apply == \"\" && act.reject == \"\" && !act.applyAll && !act.rejectAll {\n150\t\t\tproposals, err := loadFactProposals(brainDir, branch)\n151\t\t\tif err != nil {\n152\t\t\t\treturn err\n153\t\t\t}\n154\t\t\tfacts, err := loadFacts(brainDir, branch)\n155\t\t\tif err != nil {\n156\t\t\t\treturn err\n157\t\t\t}\n158\t\t\tif act.jsonOut {\n159\t\t\t\treturn writeJSON(cmd, map[string]any{\"branch\": branch, \"proposals\": proposals})\n160\t\t\t}\n161\t\t\tif len(proposals) == 0 {\n162\t\t\t\tfmt.Fprintf(cmd.OutOrStdout(), \"no pending proposals on %s\\n\", branch)\n163\t\t\t\treturn nil\n164\t\t\t}\n165\t\t\tfor _, p := range proposals {\n166\t\t\t\tfmt.Fprintf(cmd.OutOrStdout(), \"%s %s -> %s (confidence %.2f)\\n\", p.Action, p.CandidateID, p.TargetID, p.Confidence)\n167\t\t\t\tprintProposalContext(cmd, facts, p)\n168\t\t\t}\n169\t\t\treturn nil\n170\t\t}\n171\t\n172\t\tresolved, remaining, deferred := 0, 0, 0\n173\t\tif err := withBrainWriteLock(brainDir, func() error {\n174\t\t\tproposals, err := loadFactProposals(brainDir, branch)\n175\t\t\tif err != nil {\n176\t\t\t\treturn err\n177\t\t\t}\n178\t\t\tfacts, err := loadFacts(brainDir, branch)\n179\t\t\tif err != nil {\n180\t\t\t\treturn err\n181\t\t\t}\n182\t\t\t// A proposal that has reached the shared open set must be settled THERE.\n183\t\t\t// Settling it only locally leaves the hosted copy open, so a teammate's\n184\t\t\t// later apply silently overrides this member's decision and the next sync\n185\t\t\t// mirrors their outcome back over it. The local queue also holds distill's\n186\t\t\t// private, never-shared backlog (no ProposedBy) — that stays settleable\n187\t\t\t// here, which is what keeps the single-user flow untouched.\n188\t\t\tshared, err := loadSharedProposalLedger(brainDir, branch)\n189\t\t\tif err != nil {\n190\t\t\t\treturn err\n191\t\t\t}\n192\t\t\tisShared := func(p factProposal) bool {\n193\t\t\t\tif len(shared) == 0 {\n194\t\t\t\t\treturn false\n195\t\t\t\t}\n196\t\t\t\t_, ok := shared[factsync.ProposalID(p)]\n197\t\t\t\treturn ok\n198\t\t\t}\n199\t\t\tkeep := proposals[:0:0]\n200\t\t\tfor _, p := range proposals {\n201\t\t\t\tapplyThis := act.applyAll || p.CandidateID == act.apply\n202\t\t\t\trejectThis := act.rejectAll || p.CandidateID == act.reject\n203\t\t\t\tif (applyThis || rejectThis) && isShared(p) {\n204\t\t\t\t\tif act.applyAll || act.rejectAll {\n205\t\t\t\t\t\t// Bulk settle: skip the shared ones rather than fail the whole\n206\t\t\t\t\t\t// batch, so the private backlog still clears in one command.\n207\t\t\t\t\t\tfmt.Fprintf(cmd.ErrOrStderr(), \"skip shared proposal %s: settle it with 'facts proposals %s %s' so every member sees the same outcome\\n\",\n208\t\t\t\t\t\t\tp.CandidateID, bulkDecisionVerb(act), p.CandidateID)\n209\t\t\t\t\t\tdeferred++\n210\t\t\t\t\t\tkeep = append(keep, p)\n211\t\t\t\t\t\tcontinue\n212\t\t\t\t\t}\n213\t\t\t\t\treturn fmt.Errorf(\"proposal %s is shared with the team: settle it with 'facts proposals %s %s' instead, so the hosted queue and every member's facts agree (a local-only decision would be overridden by the next sync)\",\n214\t\t\t\t\t\tp.CandidateID, targetedDecisionVerb(act), p.CandidateID)\n215\t\t\t\t}\n216\t\t\t\tswitch {\n217\t\t\t\tcase applyThis:\n\n... [384 lines truncated] ..."},"type":"attachment","uuid":"18ba86c3-b4df-4250-8db0-c6e3c5e430e9","timestamp":"2026-08-17T14:25:47.601Z","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/p0p1/p1-new","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
