{"parentUuid":"7132e5ea-7f73-4c2e-a1f2-3963d5169bbd","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/suhaan/devenv/p0p1/p1-new/internal/cli/facts_sync_cmd.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"os\"\n9\t\t\"path/filepath\"\n10\t\t\"sort\"\n11\t\t\"strings\"\n12\t\n13\t\t\"github.com/ashtom/entire-brain/internal/factgitmeta\"\n14\t\t\"github.com/ashtom/entire-brain/internal/factsync\"\n15\t\n16\t\t\"github.com/spf13/cobra\"\n17\t)\n18\t\n19\tconst (\n20\t\t// factsBackendLocalGitmeta is the default: a bare, on-disk git-meta store\n21\t\t// under the plugin cache; fully local, no network/entiredb/Postgres.\n22\t\tfactsBackendLocalGitmeta = \"local-gitmeta\"\n23\t\t// factsBackendHTTP drives the hosted entire-api FactSetStore (factsync.HTTPServer).\n24\t\tfactsBackendHTTP = \"http\"\n25\t\t// envFactsBackend selects the backend when --facts-backend is unset.\n26\t\tenvFactsBackend = \"ENTIRE_BRAIN_FACTS_BACKEND\"\n27\t)\n28\t\n29\t// factsSyncOptions bundles the flag state for `facts sync`.\n30\ttype factsSyncOptions struct {\n31\t\tbranch  string\n32\t\tbackend string\n33\t\tmember  string\n34\t\t// http backend only (mirror publish's flag/env resolution):\n35\t\tapiURL string\n36\t\ttoken  string\n37\t\trepoID string\n38\t\n39\t\tjsonOut bool\n40\t}\n41\t\n42\tfunc newFactsSyncCommand(opts Options) *cobra.Command {\n43\t\tvar syncOpts factsSyncOptions\n44\t\tcmd := &cobra.Command{\n45\t\t\tUse:   \"sync\",\n46\t\t\tShort: \"Read-merge-CAS this branch's local facts into the shared fact-set head\",\n47\t\t\tLong: `sync runs the factsync read-merge-CAS loop for the current branch: pull the\n48\tcurrent fact-set head, keep-both merge this member's local facts into it, and\n49\tcompare-and-swap the result back; retrying on a losing swap.\n50\t\n51\tBackends (--facts-backend, or ` + envFactsBackend + `):\n52\t  local-gitmeta  (default) a bare, on-disk git-meta store under the brain cache\n53\t                 (<cache>/brain/<repo-key>/gitmeta.git); fully local, no network,\n54\t                 entiredb, or Postgres.\n55\t  http           the hosted entire-api FactSetStore; opt-in, requires\n56\t                 --api-url/ENTIRE_API_URL, --repo-id/ENTIRE_REPO_ID,\n57\t                 --token/ENTIRE_API_TOKEN and ENTIRE_BRAIN_ALLOW_HOSTED=1.`,\n58\t\t\tArgs: cobra.NoArgs,\n59\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n60\t\t\t\treturn runFactsSync(cmd, opts, syncOpts)\n61\t\t\t},\n62\t\t}\n63\t\tcmd.Flags().StringVar(&syncOpts.branch, \"branch\", \"\", \"Branch to sync (default: current branch)\")\n64\t\tcmd.Flags().StringVar(&syncOpts.backend, \"facts-backend\", \"\", \"Fact-set backend: local-gitmeta (default) or http\")\n65\t\tcmd.Flags().StringVar(&syncOpts.member, \"member\", \"\", \"Member identity stamped on cross-member proposals (default: git user.email)\")\n66\t\tcmd.Flags().StringVar(&syncOpts.repoID, \"repo-id\", \"\", \"Target repo id for the http backend (overrides ENTIRE_REPO_ID)\")\n67\t\tcmd.Flags().StringVar(&syncOpts.apiURL, \"api-url\", \"\", \"Entire API base URL for the http backend (overrides ENTIRE_API_URL)\")\n68\t\tcmd.Flags().StringVar(&syncOpts.token, \"token\", \"\", \"Entire API bearer token for the http backend (overrides ENTIRE_API_TOKEN)\")\n69\t\tcmd.Flags().BoolVar(&syncOpts.jsonOut, \"json\", false, \"Emit the sync result as JSON\")\n70\t\treturn cmd\n71\t}\n72\t\n73\tfunc runFactsSync(cmd *cobra.Command, opts Options, syncOpts factsSyncOptions) error {\n74\t\tctx := cmd.Context()\n75\t\n76\t\trepoDir, local, err := resolveLocalTargetRepoDir(ctx, opts.Runner, agentSurfaceTarget(opts, nil))\n77\t\tif err != nil {\n78\t\t\treturn err\n79\t\t}\n80\t\tif !local {\n81\t\t\treturn fmt.Errorf(\"facts sync requires a local repository path\")\n82\t\t}\n83\t\tstorage, err := repoStoragePaths(ctx, opts.Runner, opts.Env, repoDir)\n84\t\tif err != nil {\n85\t\t\treturn err\n86\t\t}\n87\t\n88\t\tbranch := strings.TrimSpace(syncOpts.branch)\n89\t\tif branch == \"\" {\n90\t\t\tif current, gitErr := gitScalar(ctx, opts.Runner, repoDir, \"branch\", \"--show-current\"); gitErr == nil {\n91\t\t\t\tbranch = strings.TrimSpace(current)\n92\t\t\t}\n93\t\t}\n94\t\tif branch == \"\" {\n95\t\t\tbranch = distillDefaultBranch\n96\t\t}\n97\t\n98\t\tfacts, err := loadFacts(storage.BrainDir, branch)\n99\t\tif err != nil {\n100\t\t\treturn err\n101\t\t}\n102\t\tmemberID := resolveSyncMemberID(ctx, opts.Runner, repoDir, syncOpts.member)\n103\t\n104\t\tsrv, repoID, backendLabel, err := buildFactsSyncBackend(opts, resolveFactsBackendName(syncOpts.backend), storage, syncOpts)\n105\t\tif err != nil {\n106\t\t\treturn err\n107\t\t}\n108\t\n109\t\t// The merge runs on this runner (ADR-P1-E); the backend only stores the blob\n110\t\t// and CAS-swaps the head. Sync retries on a losing swap and never drops a\n111\t\t// member's fact.\n112\t\tres, err := factsync.Sync(ctx, srv, repoID, branch, memberID, facts, opts.Now().UTC())\n113\t\tif err != nil {\n114\t\t\treturn err\n115\t\t}\n116\t\tif err := persistFactsSyncProposals(storage.BrainDir, branch, res.Proposals); err != nil {\n117\t\t\treturn err\n118\t\t}\n119\t\n120\t\t// Publish the WHOLE local review queue — this sync's raised conflicts plus any\n121\t\t// earlier entries that never reached the shared set (a previously failed\n122\t\t// publish, or a queue populated before a hosted backend was configured) — so\n123\t\t// other members can review them with `facts proposals`. Only backends that\n124\t\t// serve the queue (the hosted http one) can take them; the local git-meta\n125\t\t// store has no proposal set and is left untouched. After a successful publish\n126\t\t// the hosted set is the source of truth, and the local queue is reconciled to\n127\t\t// it so a conflict a teammate settled hosted-side stops being re-listed (and\n128\t\t// re-appliable) here.\n129\t\t//\n130\t\t// Failure discipline: a backend that does not serve the queue at all\n131\t\t// (entire-api predating the endpoint) is a warning — the sync itself is\n132\t\t// complete and the queue is a hosted add-on. Any OTHER failure fails the\n133\t\t// command: the facts already advanced the shared head, so a swallowed\n134\t\t// publish error would leave conflicts only this member can see.\n135\t\tvar pub factsync.PublishResult\n136\t\tvar pubErr error\n137\t\tif transport, hasQueue := srv.(factsync.ProposalTransport); hasQueue {\n138\t\t\tlocalQueue, queueErr := loadFactProposals(storage.BrainDir, branch)\n139\t\t\tif queueErr != nil {\n140\t\t\t\treturn fmt.Errorf(\"facts sync: load review queue: %w\", queueErr)\n141\t\t\t}\n142\t\t\tledger, ledgerErr := loadSharedProposalLedger(storage.BrainDir, branch)\n143\t\t\tif ledgerErr != nil {\n144\t\t\t\treturn fmt.Errorf(\"facts sync: load shared-proposal ledger: %w\", ledgerErr)\n145\t\t\t}\n146\t\t\t// Publish only entries that are member-attributed AND have never reached\n147\t\t\t// the hosted set. Distill's single-user review backlog shares the same\n148\t\t\t// local queue but carries no ProposedBy: it is this member's private\n149\t\t\t// pending-review state, not a cross-member conflict, and must never\n150\t\t\t// egress (its unattributed id derivation would also collide across\n151\t\t\t// members). An already-shared entry absent from the hosted set was\n152\t\t\t// settled by another member; re-publishing it would resurrect exactly\n153\t\t\t// the conflict they resolved, so reconciliation prunes it instead.\n154\t\t\ttoPublish := make([]factProposal, 0, len(localQueue))\n155\t\t\tfor _, p := range localQueue {\n156\t\t\t\tif strings.TrimSpace(p.ProposedBy) == \"\" {\n157\t\t\t\t\tcontinue\n158\t\t\t\t}\n159\t\t\t\tif _, shared := ledger[factsync.ProposalID(p)]; !shared {\n160\t\t\t\t\ttoPublish = append(toPublish, p)\n161\t\t\t\t}\n162\t\t\t}\n163\t\t\tif len(toPublish) > 0 {\n164\t\t\t\tpub, pubErr = factsync.PublishRaised(ctx, transport, repoID, branch, toPublish)\n165\t\t\t\tswitch {\n166\t\t\t\tcase pubErr == nil:\n167\t\t\t\tcase errors.Is(pubErr, factsync.ErrProposalQueueUnsupported):\n168\t\t\t\t\tfmt.Fprintf(cmd.ErrOrStderr(), \"warning: backend has no shared review queue; %d proposal(s) stay in the local queue ('facts review'): %v\\n\", len(localQueue), pubErr)\n169\t\t\t\tdefault:\n170\t\t\t\t\treturn fmt.Errorf(\"facts sync: facts head advanced to %s, but sharing %d proposal(s) to the review queue failed: %w (they remain reviewable locally with 'facts review', and the next 'facts sync' republishes them)\",\n171\t\t\t\t\t\trefOrNone(res.NewRef), len(toPublish), pubErr)\n172\t\t\t\t}\n173\t\t\t} else if set, listErr := transport.ListProposals(ctx, repoID, branch); listErr != nil {\n174\t\t\t\t// Nothing needed sharing: this list exists only to reconcile the\n175\t\t\t\t// local queue, so a transient failure must not fail a sync whose\n176\t\t\t\t// head-advance fully succeeded. The next sync reconciles.\n177\t\t\t\tpubErr = listErr\n\n... [291 lines truncated] ..."},"type":"attachment","uuid":"8bb5bee4-c69c-434e-ab0e-beb2cde7c76a","timestamp":"2026-08-17T14:22:06.847Z","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/p0p1/p1-new","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
