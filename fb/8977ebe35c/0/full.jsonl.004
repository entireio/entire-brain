{"parentUuid":"e06aa5e7-e12c-4f2a-8e92-cd348225c6eb","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/suhaan/devenv/p0p1/p1-new/internal/cli/facts_settlement_test.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"strings\"\n5\t\t\"testing\"\n6\t\n7\t\t\"github.com/ashtom/entire-brain/internal/factmerge\"\n8\t\t\"github.com/ashtom/entire-brain/internal/factsync\"\n9\t)\n10\t\n11\t// hostedHead re-serializes a fact set as the hosted head blob, so a test can\n12\t// stage exactly the state a teammate's settlement would have left behind.\n13\tfunc hostedHead(t *testing.T, facts []factRecord) []byte {\n14\t\tt.Helper()\n15\t\tvar blob strings.Builder\n16\t\tif err := factmerge.WriteNDJSON(&blob, facts); err != nil {\n17\t\t\tt.Fatal(err)\n18\t\t}\n19\t\treturn []byte(blob.String())\n20\t}\n21\t\n22\t// TestFactsSyncPullsHostedSettlementIntoLocalFacts is the regression for the\n23\t// \"accepted settlements don't stick\" defect: a teammate settling a conflict on\n24\t// the hosted queue used to leave the losing member's local facts untouched, so\n25\t// the next keep-both Promote re-added the retired fact and re-raised the same\n26\t// conflict under a fresh id — an unresolvable loop.\n27\tfunc TestFactsSyncPullsHostedSettlementIntoLocalFacts(t *testing.T) {\n28\t\tf, fake, _ := newHostedProposalsFixture(t)\n29\t\tfake.mu.Lock()\n30\t\tfake.proposals = nil\n31\t\tfake.mu.Unlock()\n32\t\n33\t\tpaths := normalizeFactPaths([]string{\"ops.deploy.strategy\"})\n34\t\tlocal := factRecord{\n35\t\t\tID: factRecordID(\"deploys use a canary rollout\", paths), Paths: paths,\n36\t\t\tText: \"deploys use a canary rollout\", Branch: \"main\", Origin: factOriginDistilled, Status: factStatusActive,\n37\t\t\tProvenance: []factAnchor{{SessionID: \"session-C\"}}, CreatedAt: f.now, UpdatedAt: f.now,\n38\t\t}\n39\t\tf.writeFacts(t, \"main\", []factRecord{local})\n40\t\n41\t\t// Sync 1: the keep-both merge raises a cross-member conflict and publishes it.\n42\t\tif out, err := execute(t, NewRootCommand(f.opts), \"facts\", \"sync\", \"--facts-backend\", \"http\", \"--member\", \"member-C\"); err != nil {\n43\t\t\tt.Fatalf(\"first sync: %v\\n%s\", err, out)\n44\t\t}\n45\t\tqueued, err := loadFactProposals(f.storage.BrainDir, \"main\")\n46\t\tif err != nil {\n47\t\t\tt.Fatalf(\"load queue: %v\", err)\n48\t\t}\n49\t\tif len(queued) == 0 {\n50\t\t\tt.Fatal(\"first sync raised no proposal, nothing to settle\")\n51\t\t}\n52\t\tsettledProposal := queued[0]\n53\t\n54\t\t// A teammate ACCEPTS it on the hosted side: apply the very same operation to\n55\t\t// the hosted head, and drop the entry from the open set.\n56\t\t// The head sync 1 produced is what the teammate would have settled against.\n57\t\thostedFacts := fake.headFacts(t)\n58\t\taccepted, err := factmerge.ApplyProposal(hostedFacts, settledProposal, f.now)\n59\t\tif err != nil {\n60\t\t\tt.Fatalf(\"stage hosted accept: %v\", err)\n61\t\t}\n62\t\tfake.mu.Lock()\n63\t\tfake.facts = hostedHead(t, accepted)\n64\t\tfake.proposals = nil\n65\t\tfake.mu.Unlock()\n66\t\n67\t\t// Sync 2 must mirror that settlement into local facts.\n68\t\tif out, err := execute(t, NewRootCommand(f.opts), \"facts\", \"sync\", \"--facts-backend\", \"http\", \"--member\", \"member-C\"); err != nil {\n69\t\t\tt.Fatalf(\"second sync: %v\\n%s\", err, out)\n70\t\t}\n71\t\n72\t\tlocalAfter, err := loadFacts(f.storage.BrainDir, \"main\")\n73\t\tif err != nil {\n74\t\t\tt.Fatalf(\"load local facts: %v\", err)\n75\t\t}\n76\t\tsettledLocally := false\n77\t\tswitch settledProposal.Action {\n78\t\tcase factActionMerge:\n79\t\t\tsettledLocally = indexOfFact(localAfter, settledProposal.CandidateID) < 0\n80\t\tdefault:\n81\t\t\tif ti := indexOfFact(localAfter, settledProposal.TargetID); ti >= 0 {\n82\t\t\t\tsettledLocally = localAfter[ti].Status == factStatusSuperseded\n83\t\t\t} else {\n84\t\t\t\tsettledLocally = true\n85\t\t\t}\n86\t\t}\n87\t\tif !settledLocally {\n88\t\t\tt.Fatalf(\"hosted settlement did not stick locally: action=%s candidate=%s target=%s facts=%+v\",\n89\t\t\t\tsettledProposal.Action, settledProposal.CandidateID, settledProposal.TargetID, localAfter)\n90\t\t}\n91\t\n92\t\t// And the queue entry is gone, so it cannot be re-raised or re-applied here.\n93\t\tafter, err := loadFactProposals(f.storage.BrainDir, \"main\")\n94\t\tif err != nil {\n95\t\t\tt.Fatalf(\"load queue after reconcile: %v\", err)\n96\t\t}\n97\t\tfor _, p := range after {\n98\t\t\tif factsync.ProposalID(p) == factsync.ProposalID(settledProposal) {\n99\t\t\t\tt.Fatal(\"settled proposal is still queued locally\")\n100\t\t\t}\n101\t\t}\n102\t}\n103\t\n104\t// TestFactsReviewRefusesToSettleSharedProposalLocally is the regression for the\n105\t// missing hosted interlock: settling a published proposal with the local `facts\n106\t// review` used to leave the hosted copy open, so a teammate's later apply\n107\t// silently overrode this member's decision.\n108\tfunc TestFactsReviewRefusesToSettleSharedProposalLocally(t *testing.T) {\n109\t\tf := newVerifyFixture(t)\n110\t\tpaths := normalizeFactPaths([]string{\"ops.deploy.strategy\"})\n111\t\ttarget := factRecord{\n112\t\t\tID: factRecordID(\"deploys use blue-green cutover\", paths), Paths: paths,\n113\t\t\tText: \"deploys use blue-green cutover\", Branch: \"main\", Origin: factOriginDistilled, Status: factStatusActive,\n114\t\t\tCreatedAt: f.now, UpdatedAt: f.now,\n115\t\t}\n116\t\tcandidate := factRecord{\n117\t\t\tID: factRecordID(\"deploys use in-place rolling restart\", paths), Paths: paths,\n118\t\t\tText: \"deploys use in-place rolling restart\", Branch: \"main\", Origin: factOriginDistilled, Status: factStatusActive,\n119\t\t\tCreatedAt: f.now, UpdatedAt: f.now,\n120\t\t}\n121\t\tf.writeFacts(t, \"main\", []factRecord{target, candidate})\n122\t\n123\t\tsharedProposal := factProposal{\n124\t\t\tAction: factActionSupersede, CandidateID: candidate.ID, TargetID: target.ID,\n125\t\t\tBranch: \"main\", ProposedBy: \"member-C\",\n126\t\t}\n127\t\tif err := writeFactProposals(f.storage.BrainDir, \"main\", []factProposal{sharedProposal}); err != nil {\n128\t\t\tt.Fatal(err)\n129\t\t}\n130\t\tif err := writeSharedProposalLedger(f.storage.BrainDir, \"main\", map[string]struct{}{\n131\t\t\tfactsync.ProposalID(sharedProposal): {},\n132\t\t}); err != nil {\n133\t\t\tt.Fatal(err)\n134\t\t}\n135\t\n136\t\tout, err := execute(t, NewRootCommand(f.opts), \"facts\", \"review\", \"--apply\", candidate.ID)\n137\t\tif err == nil {\n138\t\t\tt.Fatalf(\"expected a refusal for a shared proposal, got success:\\n%s\", out)\n139\t\t}\n140\t\tif !strings.Contains(err.Error(), \"facts proposals\") {\n141\t\t\tt.Fatalf(\"refusal should point at 'facts proposals', got: %v\", err)\n142\t\t}\n143\t\n144\t\t// The local facts must be untouched — no half-applied settlement.\n145\t\tfacts, loadErr := loadFacts(f.storage.BrainDir, \"main\")\n146\t\tif loadErr != nil {\n147\t\t\tt.Fatal(loadErr)\n148\t\t}\n149\t\tif ti := indexOfFact(facts, target.ID); ti < 0 || facts[ti].Status != factStatusActive {\n150\t\t\tt.Fatalf(\"refused review still mutated local facts: %+v\", facts)\n151\t\t}\n152\t\tqueued, qErr := loadFactProposals(f.storage.BrainDir, \"main\")\n153\t\tif qErr != nil || len(queued) != 1 {\n154\t\t\tt.Fatalf(\"refused review dropped the queue entry: %v, %d\", qErr, len(queued))\n155\t\t}\n156\t}\n157\t\n158\t// TestFactsReviewBulkSkipsSharedButSettlesPrivate proves the interlock does not\n159\t// break the single-user flow: distill's private backlog carries no ProposedBy,\n160\t// never reaches the hosted set, and must stay settleable in bulk.\n161\tfunc TestFactsReviewBulkSkipsSharedButSettlesPrivate(t *testing.T) {\n162\t\tf := newVerifyFixture(t)\n163\t\tpaths := normalizeFactPaths([]string{\"ops.deploy.strategy\"})\n164\t\tprivPaths := normalizeFactPaths([]string{\"ops.backup.cadence\"})\n165\t\n166\t\ttarget := factRecord{\n167\t\t\tID: factRecordID(\"deploys use blue-green cutover\", paths), Paths: paths,\n168\t\t\tText: \"deploys use blue-green cutover\", Branch: \"main\", Origin: factOriginDistilled, Status: factStatusActive,\n169\t\t\tCreatedAt: f.now, UpdatedAt: f.now,\n170\t\t}\n171\t\tcandidate := factRecord{\n172\t\t\tID: factRecordID(\"deploys use in-place rolling restart\", paths), Paths: paths,\n173\t\t\tText: \"deploys use in-place rolling restart\", Branch: \"main\", Origin: factOriginDistilled, Status: factStatusActive,\n174\t\t\tCreatedAt: f.now, UpdatedAt: f.now,\n175\t\t}\n176\t\tprivTarget := factRecord{\n177\t\t\tID: factRecordID(\"backups run nightly\", privPaths), Paths: privPaths,\n178\t\t\tText: \"backups run nightly\", Branch: \"main\", Origin: factOriginDistilled, Status: factStatusActive,\n179\t\t\tCreatedAt: f.now, UpdatedAt: f.now,\n180\t\t}\n181\t\tprivCandidate := factRecord{\n182\t\t\tID: factRecordID(\"backups run hourly\", privPaths), Paths: privPaths,\n183\t\t\tText: \"backups run hourly\", Branch: \"main\", Origin: factOriginDistilled, Status: factStatusActive,\n184\t\t\tCreatedAt: f.now, UpdatedAt: f.now,\n185\t\t}\n\n... [45 lines truncated] ..."},"type":"attachment","uuid":"0e67fbb8-e148-476c-b94b-56bcb76023e4","timestamp":"2026-08-17T14:27:59.453Z","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/p0p1/p1-new","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
