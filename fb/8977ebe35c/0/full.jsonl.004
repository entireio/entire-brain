{"parentUuid":"fd9e8667-ac4f-418d-98ba-2b99546c4f35","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/suhaan/devenv/p0p1/p1-new/internal/cli/facts_sync_cmd.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"context\"\n6\t\t\"encoding/json\"\n7\t\t\"errors\"\n8\t\t\"fmt\"\n9\t\t\"os\"\n10\t\t\"path/filepath\"\n11\t\t\"sort\"\n12\t\t\"strings\"\n13\t\t\"time\"\n14\t\n15\t\t\"github.com/ashtom/entire-brain/internal/factgitmeta\"\n16\t\t\"github.com/ashtom/entire-brain/internal/factmerge\"\n17\t\t\"github.com/ashtom/entire-brain/internal/factsync\"\n18\t\n19\t\t\"github.com/spf13/cobra\"\n20\t)\n21\t\n22\tconst (\n23\t\t// factsBackendLocalGitmeta is the default: a bare, on-disk git-meta store\n24\t\t// under the plugin cache; fully local, no network/entiredb/Postgres.\n25\t\tfactsBackendLocalGitmeta = \"local-gitmeta\"\n26\t\t// factsBackendHTTP drives the hosted entire-api FactSetStore (factsync.HTTPServer).\n27\t\tfactsBackendHTTP = \"http\"\n28\t\t// envFactsBackend selects the backend when --facts-backend is unset.\n29\t\tenvFactsBackend = \"ENTIRE_BRAIN_FACTS_BACKEND\"\n30\t)\n31\t\n32\t// factsSyncOptions bundles the flag state for `facts sync`.\n33\ttype factsSyncOptions struct {\n34\t\tbranch  string\n35\t\tbackend string\n36\t\tmember  string\n37\t\t// http backend only (mirror publish's flag/env resolution):\n38\t\tapiURL string\n39\t\ttoken  string\n40\t\trepoID string\n41\t\n42\t\tjsonOut bool\n43\t}\n44\t\n45\tfunc newFactsSyncCommand(opts Options) *cobra.Command {\n46\t\tvar syncOpts factsSyncOptions\n47\t\tcmd := &cobra.Command{\n48\t\t\tUse:   \"sync\",\n49\t\t\tShort: \"Read-merge-CAS this branch's local facts into the shared fact-set head\",\n50\t\t\tLong: `sync runs the factsync read-merge-CAS loop for the current branch: pull the\n51\tcurrent fact-set head, keep-both merge this member's local facts into it, and\n52\tcompare-and-swap the result back; retrying on a losing swap.\n53\t\n54\tBackends (--facts-backend, or ` + envFactsBackend + `):\n55\t  local-gitmeta  (default) a bare, on-disk git-meta store under the brain cache\n56\t                 (<cache>/brain/<repo-key>/gitmeta.git); fully local, no network,\n57\t                 entiredb, or Postgres.\n58\t  http           the hosted entire-api FactSetStore; opt-in, requires\n59\t                 --api-url/ENTIRE_API_URL, --repo-id/ENTIRE_REPO_ID,\n60\t                 --token/ENTIRE_API_TOKEN and ENTIRE_BRAIN_ALLOW_HOSTED=1.`,\n61\t\t\tArgs: cobra.NoArgs,\n62\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n63\t\t\t\treturn runFactsSync(cmd, opts, syncOpts)\n64\t\t\t},\n65\t\t}\n66\t\tcmd.Flags().StringVar(&syncOpts.branch, \"branch\", \"\", \"Branch to sync (default: current branch)\")\n67\t\tcmd.Flags().StringVar(&syncOpts.backend, \"facts-backend\", \"\", \"Fact-set backend: local-gitmeta (default) or http\")\n68\t\tcmd.Flags().StringVar(&syncOpts.member, \"member\", \"\", \"Member identity stamped on cross-member proposals (default: git user.email)\")\n69\t\tcmd.Flags().StringVar(&syncOpts.repoID, \"repo-id\", \"\", \"Target repo id for the http backend (overrides ENTIRE_REPO_ID)\")\n70\t\tcmd.Flags().StringVar(&syncOpts.apiURL, \"api-url\", \"\", \"Entire API base URL for the http backend (overrides ENTIRE_API_URL)\")\n71\t\tcmd.Flags().StringVar(&syncOpts.token, \"token\", \"\", \"Entire API bearer token for the http backend (overrides ENTIRE_API_TOKEN)\")\n72\t\tcmd.Flags().BoolVar(&syncOpts.jsonOut, \"json\", false, \"Emit the sync result as JSON\")\n73\t\treturn cmd\n74\t}\n75\t\n76\tfunc runFactsSync(cmd *cobra.Command, opts Options, syncOpts factsSyncOptions) error {\n77\t\tctx := cmd.Context()\n78\t\n79\t\trepoDir, local, err := resolveLocalTargetRepoDir(ctx, opts.Runner, agentSurfaceTarget(opts, nil))\n80\t\tif err != nil {\n81\t\t\treturn err\n82\t\t}\n83\t\tif !local {\n84\t\t\treturn fmt.Errorf(\"facts sync requires a local repository path\")\n85\t\t}\n86\t\tstorage, err := repoStoragePaths(ctx, opts.Runner, opts.Env, repoDir)\n87\t\tif err != nil {\n88\t\t\treturn err\n89\t\t}\n90\t\n91\t\tbranch := strings.TrimSpace(syncOpts.branch)\n92\t\tif branch == \"\" {\n93\t\t\tif current, gitErr := gitScalar(ctx, opts.Runner, repoDir, \"branch\", \"--show-current\"); gitErr == nil {\n94\t\t\t\tbranch = strings.TrimSpace(current)\n95\t\t\t}\n96\t\t}\n97\t\tif branch == \"\" {\n98\t\t\tbranch = distillDefaultBranch\n99\t\t}\n100\t\n101\t\tfacts, err := loadFacts(storage.BrainDir, branch)\n102\t\tif err != nil {\n103\t\t\treturn err\n104\t\t}\n105\t\tmemberID := resolveSyncMemberID(ctx, opts.Runner, repoDir, syncOpts.member)\n106\t\n107\t\tsrv, repoID, backendLabel, err := buildFactsSyncBackend(opts, resolveFactsBackendName(syncOpts.backend), storage, syncOpts)\n108\t\tif err != nil {\n109\t\t\treturn err\n110\t\t}\n111\t\n112\t\t// The merge runs on this runner (ADR-P1-E); the backend only stores the blob\n113\t\t// and CAS-swaps the head. Sync retries on a losing swap and never drops a\n114\t\t// member's fact.\n115\t\tres, err := factsync.Sync(ctx, srv, repoID, branch, memberID, facts, opts.Now().UTC())\n116\t\tif err != nil {\n117\t\t\treturn err\n118\t\t}\n119\t\tif err := persistFactsSyncProposals(storage.BrainDir, branch, res.Proposals); err != nil {\n120\t\t\treturn err\n121\t\t}\n122\t\n123\t\t// Publish the WHOLE local review queue — this sync's raised conflicts plus any\n124\t\t// earlier entries that never reached the shared set (a previously failed\n125\t\t// publish, or a queue populated before a hosted backend was configured) — so\n126\t\t// other members can review them with `facts proposals`. Only backends that\n127\t\t// serve the queue (the hosted http one) can take them; the local git-meta\n128\t\t// store has no proposal set and is left untouched. After a successful publish\n129\t\t// the hosted set is the source of truth, and the local queue is reconciled to\n130\t\t// it so a conflict a teammate settled hosted-side stops being re-listed (and\n131\t\t// re-appliable) here.\n132\t\t//\n133\t\t// Failure discipline: a backend that does not serve the queue at all\n134\t\t// (entire-api predating the endpoint) is a warning — the sync itself is\n135\t\t// complete and the queue is a hosted add-on. Any OTHER failure fails the\n136\t\t// command: the facts already advanced the shared head, so a swallowed\n137\t\t// publish error would leave conflicts only this member can see.\n138\t\tvar pub factsync.PublishResult\n139\t\tvar pubErr error\n140\t\tif transport, hasQueue := srv.(factsync.ProposalTransport); hasQueue {\n141\t\t\tlocalQueue, queueErr := loadFactProposals(storage.BrainDir, branch)\n142\t\t\tif queueErr != nil {\n143\t\t\t\treturn fmt.Errorf(\"facts sync: load review queue: %w\", queueErr)\n144\t\t\t}\n145\t\t\tledger, ledgerErr := loadSharedProposalLedger(storage.BrainDir, branch)\n146\t\t\tif ledgerErr != nil {\n147\t\t\t\treturn fmt.Errorf(\"facts sync: load shared-proposal ledger: %w\", ledgerErr)\n148\t\t\t}\n149\t\t\t// Publish only entries that are member-attributed AND have never reached\n150\t\t\t// the hosted set. Distill's single-user review backlog shares the same\n151\t\t\t// local queue but carries no ProposedBy: it is this member's private\n152\t\t\t// pending-review state, not a cross-member conflict, and must never\n153\t\t\t// egress (its unattributed id derivation would also collide across\n154\t\t\t// members). An already-shared entry absent from the hosted set was\n155\t\t\t// settled by another member; re-publishing it would resurrect exactly\n156\t\t\t// the conflict they resolved, so reconciliation prunes it instead.\n157\t\t\ttoPublish := make([]factProposal, 0, len(localQueue))\n158\t\t\tfor _, p := range localQueue {\n159\t\t\t\tif strings.TrimSpace(p.ProposedBy) == \"\" {\n160\t\t\t\t\tcontinue\n161\t\t\t\t}\n162\t\t\t\tif _, shared := ledger[factsync.ProposalID(p)]; !shared {\n163\t\t\t\t\ttoPublish = append(toPublish, p)\n164\t\t\t\t}\n165\t\t\t}\n166\t\t\tif len(toPublish) > 0 {\n167\t\t\t\tpub, pubErr = factsync.PublishRaised(ctx, transport, repoID, branch, toPublish)\n168\t\t\t\tswitch {\n169\t\t\t\tcase pubErr == nil:\n170\t\t\t\tcase errors.Is(pubErr, factsync.ErrProposalQueueUnsupported):\n171\t\t\t\t\tfmt.Fprintf(cmd.ErrOrStderr(), \"warning: backend has no shared review queue; %d proposal(s) stay in the local queue ('facts review'): %v\\n\", len(localQueue), pubErr)\n172\t\t\t\tdefault:\n173\t\t\t\t\treturn fmt.Errorf(\"facts sync: facts head advanced to %s, but sharing %d proposal(s) to the review queue failed: %w (they remain reviewable locally with 'facts review', and the next 'facts sync' republishes them)\",\n174\t\t\t\t\t\trefOrNone(res.NewRef), len(toPublish), pubErr)\n175\t\t\t\t}\n176\t\t\t} else if set, listErr := transport.ListProposals(ctx, repoID, branch); listErr != nil {\n177\t\t\t\t// Nothing needed sharing: this list exists only to reconcile the\n178\t\t\t\t// local queue, so a transient failure must not fail a sync whose\n\n... [376 lines truncated] ..."},"type":"attachment","uuid":"b179275d-9afc-4ec8-96f6-63530779af64","timestamp":"2026-08-17T14:25:13.349Z","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/p0p1/p1-new","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
