{"timestamp":"2026-08-23T17:44:17.881Z","ordinal":17066,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0200a-63d8-7b21-adef-c3850aecebf7","turn_id":"01a02fb8-5db4-77e3-a158-975075162964","item":{"type":"CommandExecution","id":"exec-77a0b5c0-0552-48a1-9d08-7c889c2d3594","process_id":"35259","command":["/bin/zsh","-lc","nl -ba internal/cli/distill_cmd.go | sed -n '1080,1435p'; nl -ba internal/cli/facts.go | sed -n '1,210p'; nl -ba internal/cli/reconcile.go | sed -n '1,130p'; nl -ba internal/cli/reconcile.go | sed -n '260,410p'"],"cwd":"file:///Users/thomi/Projects/entire-brain","parsed_cmd":[{"type":"read","cmd":"nl -ba internal/cli/distill_cmd.go","name":"distill_cmd.go","path":"internal/cli/distill_cmd.go"},{"type":"read","cmd":"nl -ba internal/cli/facts.go","name":"facts.go","path":"internal/cli/facts.go"},{"type":"read","cmd":"nl -ba internal/cli/reconcile.go","name":"reconcile.go","path":"internal/cli/reconcile.go"}],"source":"unified_exec_startup","status":"completed","stdout":"  1080\t\t\t\t\t\t}\n  1081\t\t\t\t\t}\n  1082\t\t\t\t} else {\n  1083\t\t\t\t\tprior = loadedProposals\n  1084\t\t\t\t}\n  1085\t\t\t\tmerged := dedupeProposals(append(prior, proposalsByBranch[branch]...))\n  1086\t\t\t\tif err := writeFactProposals(brainDir, branch, merged); err != nil {\n  1087\t\t\t\t\treturn err\n  1088\t\t\t\t}\n  1089\t\t\t\t// A force run keeps branches dirty between mid-run flushes so the\n  1090\t\t\t\t// final flush always rewrites them — that write is what drops the\n  1091\t\t\t\t// prior proposal backlog. Otherwise the branch is clean until new\n  1092\t\t\t\t// fact actions touch it.\n  1093\t\t\t\tif final || !distillOpts.force {\n  1094\t\t\t\t\tdelete(dirtyBranches, branch)\n  1095\t\t\t\t}\n  1096\t\t\t}\n  1097\t\t\tif final && distillOpts.force {\n  1098\t\t\t\tfor _, rel := range forceScope.LegacyProposalRels {\n  1099\t\t\t\t\tif err := clearDistillOwnedLegacyProposalStore(brainDir, rel); err != nil {\n  1100\t\t\t\t\t\treturn err\n  1101\t\t\t\t\t}\n  1102\t\t\t\t}\n  1103\t\t\t}\n  1104\t\t\tcache := newCache\n  1105\t\t\tif !final && !distillOpts.force {\n  1106\t\t\t\tcache = distillCache{Version: distillCacheVersion, Sessions: make(map[string]string, len(prevCache.Sessions)+len(newCache.Sessions))}\n  1107\t\t\t\tmaps.Copy(cache.Sessions, prevCache.Sessions)\n  1108\t\t\t\tmaps.Copy(cache.Sessions, newCache.Sessions)\n  1109\t\t\t}\n  1110\t\t\treturn saveDistillCache(brainDir, cache)\n  1111\t\t}\n  1112\t\tflushFactStores := func(final bool) error {\n  1113\t\t\treturn withBrainWriteLock(brainDir, func() error {\n  1114\t\t\t\treturn flushFactStoresLocked(final)\n  1115\t\t\t})\n  1116\t\t}\n  1117\t\tflushInterval := distillOpts.flushEvery\n  1118\t\tif flushInterval <= 0 {\n  1119\t\t\tflushInterval = distillFlushCallInterval\n  1120\t\t}\n  1121\t\tcallsSinceFlush := 0\n  1122\t\tmaybeFlush := func() error {\n  1123\t\t\tif callsSinceFlush < flushInterval {\n  1124\t\t\t\treturn nil\n  1125\t\t\t}\n  1126\t\t\t// Reset even on failure so a persistent write error is retried once per\n  1127\t\t\t// interval, not on every call.\n  1128\t\t\tcallsSinceFlush = 0\n  1129\t\t\tif err := flushFactStores(false); err != nil {\n  1130\t\t\t\tif errors.Is(err, errDistillFactStoreChanged) {\n  1131\t\t\t\t\treturn err\n  1132\t\t\t\t}\n  1133\t\t\t\t// Non-fatal: a mid-run flush only narrows the loss window, and\n  1134\t\t\t\t// aborting an hours-long run over a transient write error would lose\n  1135\t\t\t\t// far more than the flush protects. Failed branches stay dirty, so\n  1136\t\t\t\t// the next interval (and the final flush) retries them.\n  1137\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"mid-run flush failed (will retry): %v\", err))\n  1138\t\t\t}\n  1139\t\t\treturn nil\n  1140\t\t}\n  1141\t\n  1142\t\t// Session pipeline: a producer goroutine prepares sessions ahead —\n  1143\t\t// transcript read, preprocessing, fingerprint/cache check, chunking — and\n  1144\t\t// dispatches chunk agent calls into one pool shared ACROSS sessions (see\n  1145\t\t// startSessionPrefetch), while this loop consumes results strictly in\n  1146\t\t// chronological order, so reconcile and fact application keep their exact\n  1147\t\t// serial semantics. Canceling pipeCtx (deferred; covers the abort return\n  1148\t\t// too) stops preparation, dispatch, and in-flight agent calls.\n  1149\t\tpipeCtx, pipeCancel := context.WithCancel(ctx)\n  1150\t\tprefetch := startSessionPrefetch(pipeCtx, brainDir, repoDir, args, sessions, prevCache, distillOpts, resolveBranch)\n  1151\t\tdefer func() {\n  1152\t\t\tpipeCancel()\n  1153\t\t\tprefetch.wait()\n  1154\t\t}()\n  1155\t\tfor ps := range prefetch.Sessions {\n  1156\t\t\tsession, branch := ps.session, ps.branch\n  1157\t\t\tif ps.skip {\n  1158\t\t\t\t// Carry the session's cache entry through unchanged: the final flush\n  1159\t\t\t\t// persists newCache only, so dropping filtered sessions here would\n  1160\t\t\t\t// make the next unfiltered run re-distill every other branch (or\n  1161\t\t\t\t// session) from scratch. (The fingerprint-match skip below does the\n  1162\t\t\t\t// same.)\n  1163\t\t\t\tcacheKey := distillSessionCacheKeyForPipeline(pipeline, branch, session.SessionID)\n  1164\t\t\t\tif prev, ok := prevCache.Sessions[cacheKey]; ok {\n  1165\t\t\t\t\tnewCache.Sessions[cacheKey] = prev\n  1166\t\t\t\t} else if !distillOpts.force {\n  1167\t\t\t\t\tprev, ok := prevCache.Sessions[session.SessionID]\n  1168\t\t\t\t\tif !ok {\n  1169\t\t\t\t\t\tcontinue\n  1170\t\t\t\t\t}\n  1171\t\t\t\t\t// A legacy entry stays under its legacy key (and formula) until\n  1172\t\t\t\t\t// its session is actually visited and grandfathered — copying it\n  1173\t\t\t\t\t// under the new key would make it permanently unmatchable.\n  1174\t\t\t\t\tnewCache.Sessions[session.SessionID] = prev\n  1175\t\t\t\t}\n  1176\t\t\t\tcontinue\n  1177\t\t\t}\n  1178\t\t\tif ps.readErr != nil {\n  1179\t\t\t\tpipeCancel()\n  1180\t\t\t\treturn nil, fmt.Errorf(\"read canonical transcript %s: %w\", filepath.ToSlash(session.TranscriptPath), ps.readErr)\n  1181\t\t\t}\n  1182\t\t\tensureBranch(branch)\n  1183\t\n  1184\t\t\tsessionsDone++\n  1185\t\t\t// Report once per session, at every exit path, so the running fact count\n  1186\t\t\t// includes the session just processed (an emit at session start would lag\n  1187\t\t\t// by one session and always show 0 for a single-session run).\n  1188\t\t\treportProgress := func() {\n  1189\t\t\t\tif distillOpts.progress != nil {\n  1190\t\t\t\t\tdistillOpts.progress(distillProgress{SessionsDone: sessionsDone, SessionsTotal: totalSessions, Branch: branch, Facts: factsFound})\n  1191\t\t\t\t}\n  1192\t\t\t}\n  1193\t\t\tpreprocessedBytes += int64(ps.preBytes)\n  1194\t\t\tcandidateBytes += int64(ps.candidateBytes)\n  1195\t\t\tif ps.cached {\n  1196\t\t\t\tcacheHits++\n  1197\t\t\t\tnewCache.Sessions[distillSessionCacheKeyForPipeline(pipeline, branch, session.SessionID)] = ps.fingerprint // unchanged; retain in cache and keep existing facts\n  1198\t\t\t\treportProgress()\n  1199\t\t\t\tcontinue\n  1200\t\t\t}\n  1201\t\n  1202\t\t\tsessionFailed := false\n  1203\t\t\tfor chunkIdx, chunk := range ps.chunks {\n  1204\t\t\t\tchunksScanned++\n  1205\t\t\t\tanchor := factAnchor{\n  1206\t\t\t\t\tSessionID:    session.SessionID,\n  1207\t\t\t\t\tCheckpointID: session.LatestCheckpoint,\n  1208\t\t\t\t\tTranscript:   filepath.ToSlash(session.TranscriptPath),\n  1209\t\t\t\t\tLine:         chunk.StartLine,\n  1210\t\t\t\t}\n  1211\t\t\t\tif pipeline == distillPipelineCandidates {\n  1212\t\t\t\t\tanchor.EndLine = chunk.EndLine\n  1213\t\t\t\t\tanchor.DistillTurnID = chunk.DistillTurnID\n  1214\t\t\t\t}\n  1215\t\t\t\textractionStarted := time.Now()\n  1216\t\t\t\tout, runErr := ps.result(chunkIdx)\n  1217\t\t\t\textractionSeconds += time.Since(extractionStarted).Seconds()\n  1218\t\t\t\textractionAgentCalls++\n  1219\t\t\t\tcallsSinceFlush++\n  1220\t\t\t\tif runErr != nil {\n  1221\t\t\t\t\tif pipeline == distillPipelineCandidates {\n  1222\t\t\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"candidate extraction failed for %s:%d\", session.SessionID, chunk.StartLine))\n  1223\t\t\t\t\t} else {\n  1224\t\t\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"agent failed on %s:%d: %v\", session.SessionID, chunk.StartLine, runErr))\n  1225\t\t\t\t\t}\n  1226\t\t\t\t\tsessionFailed = true\n  1227\t\t\t\t\tfailedChunks++\n  1228\t\t\t\t\tagentFailures++\n  1229\t\t\t\t\t// Fail fast on a misconfiguration: nothing has distilled yet and the\n  1230\t\t\t\t\t// agent keeps failing, so every call is almost certainly erroring the\n  1231\t\t\t\t\t// same way (bad --model, missing agent, auth). Abort with the agent's\n  1232\t\t\t\t\t// own error instead of churning through every remaining session.\n  1233\t\t\t\t\tif !anyAgentSuccess && agentFailures >= distillAgentAbortThreshold {\n  1234\t\t\t\t\t\tif pipeline == distillPipelineCandidates {\n  1235\t\t\t\t\t\t\treturn nil, fmt.Errorf(\"candidate distill aborted after %d agent failures with no valid response; check --agent, --model, authentication, and executable PATH\", agentFailures)\n  1236\t\t\t\t\t\t}\n  1237\t\t\t\t\t\treturn nil, fmt.Errorf(\"distill aborted after %d agent failures with no facts distilled — check --agent and --model. Last error: %v\", agentFailures, runErr)\n  1238\t\t\t\t\t}\n  1239\t\t\t\t\t// Flush on the failure path too: a long failure streak (rate\n  1240\t\t\t\t\t// limiting, timeouts) is exactly when a run tends to get killed,\n  1241\t\t\t\t\t// and skipping the flush here would leave pre-streak facts\n  1242\t\t\t\t\t// unpersisted for the streak's entire duration.\n  1243\t\t\t\t\tif err := maybeFlush(); err != nil {\n  1244\t\t\t\t\t\treturn nil, err\n  1245\t\t\t\t\t}\n  1246\t\t\t\t\tcontinue\n  1247\t\t\t\t}\n  1248\t\t\t\trecords, chunkWarnings := distilledFactsFromOutput(out, taxonomy, anchor, branch, now)\n  1249\t\t\t\t// Sharpen provenance where the entity index can place the fact's\n  1250\t\t\t\t// locus; a no-op (and never an error) when the index is absent.\n  1251\t\t\t\trecords = applyEntityProvenance(records, distillOpts.entityProvenance)\n  1252\t\t\t\tif pipeline == distillPipelineCandidates {\n  1253\t\t\t\t\tif !candidateDistillOutputIsProtocolComplete(out) || len(chunkWarnings) > 0 {\n  1254\t\t\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"candidate output at %s:%d violated the extraction protocol\", session.SessionID, chunk.StartLine))\n  1255\t\t\t\t\t\tsessionFailed = true\n  1256\t\t\t\t\t\tfailedChunks++\n  1257\t\t\t\t\t\tagentFailures++\n  1258\t\t\t\t\t\tif !anyAgentSuccess && agentFailures >= distillAgentAbortThreshold {\n  1259\t\t\t\t\t\t\treturn nil, fmt.Errorf(\"candidate distill aborted after %d invalid agent responses with no protocol-valid response; check --agent and --model\", agentFailures)\n  1260\t\t\t\t\t\t}\n  1261\t\t\t\t\t\tif err := maybeFlush(); err != nil {\n  1262\t\t\t\t\t\t\treturn nil, err\n  1263\t\t\t\t\t\t}\n  1264\t\t\t\t\t\tcontinue\n  1265\t\t\t\t\t}\n  1266\t\t\t\t\tanyAgentSuccess = true\n  1267\t\t\t\t\tvar removed bool\n  1268\t\t\t\t\tbyBranch[branch], removed = removeRelocatedDistillAnchors(byBranch[branch], anchor)\n  1269\t\t\t\t\tif removed {\n  1270\t\t\t\t\t\tdirtyBranches[branch] = true\n  1271\t\t\t\t\t}\n  1272\t\t\t\t} else {\n  1273\t\t\t\t\tanyAgentSuccess = true\n  1274\t\t\t\t\twarnings = append(warnings, chunkWarnings...)\n  1275\t\t\t\t}\n  1276\t\t\t\tif len(records) == 0 {\n  1277\t\t\t\t\tif err := maybeFlush(); err != nil {\n  1278\t\t\t\t\t\treturn nil, err\n  1279\t\t\t\t\t}\n  1280\t\t\t\t\tcontinue\n  1281\t\t\t\t}\n  1282\t\t\t\tfactsFound += len(records)\n  1283\t\t\t\tchunksDistilled++\n  1284\t\t\t\tvar actions []factAction\n  1285\t\t\t\tif pipeline == distillPipelineCandidates {\n  1286\t\t\t\t\t// Candidate v1 is fail-conservative: exact fact IDs collapse in\n  1287\t\t\t\t\t// factmerge.Upsert, while every non-identical statement remains a\n  1288\t\t\t\t\t// separate fact. It never asks a model to infer identity or\n  1289\t\t\t\t\t// supersession from a shared taxonomy path.\n  1290\t\t\t\t\tactions = newDistilledFactActions(records)\n  1291\t\t\t\t} else {\n  1292\t\t\t\t\t// Legacy reconciliation remains available unchanged while the\n  1293\t\t\t\t\t// candidate pipeline is evaluated in shadow/opt-in runs.\n  1294\t\t\t\t\treconcileCalled := false\n  1295\t\t\t\t\tcountingReconcileRun := func(ctx context.Context, dir string, args []string, input []byte, timeout time.Duration) (string, error) {\n  1296\t\t\t\t\t\treconcileCalled = true\n  1297\t\t\t\t\t\treturn distillOpts.run(ctx, dir, args, input, timeout)\n  1298\t\t\t\t\t}\n  1299\t\t\t\t\treconcileStarted := time.Now()\n  1300\t\t\t\t\tvar recWarnings []string\n  1301\t\t\t\t\tactions, recWarnings = reconcileChunkCandidates(ctx, countingReconcileRun, reconcileArgs, records, byBranch[branch], repoDir, distillOpts.timeout)\n  1302\t\t\t\t\tif reconcileCalled {\n  1303\t\t\t\t\t\treconcileAgentCalls++\n  1304\t\t\t\t\t\treconcileSeconds += time.Since(reconcileStarted).Seconds()\n  1305\t\t\t\t\t}\n  1306\t\t\t\t\twarnings = append(warnings, recWarnings...)\n  1307\t\t\t\t\t// Preserve the legacy flush cadence: a candidate-bearing chunk\n  1308\t\t\t\t\t// advances the interval even when reconciliation resolves locally.\n  1309\t\t\t\t\tcallsSinceFlush++\n  1310\t\t\t\t}\n  1311\t\t\t\tvar chunkProposals []factProposal\n  1312\t\t\t\tbyBranch[branch], chunkProposals = applyFactActions(byBranch[branch], actions, threshold, now)\n  1313\t\t\t\tproposalsByBranch[branch] = append(proposalsByBranch[branch], chunkProposals...)\n  1314\t\t\t\tdirtyBranches[branch] = true\n  1315\t\t\t\tif err := maybeFlush(); err != nil {\n  1316\t\t\t\t\treturn nil, err\n  1317\t\t\t\t}\n  1318\t\t\t}\n  1319\t\t\tif ps.release != nil {\n  1320\t\t\t\tps.release() // free the work-lookahead slot: chunks fully consumed\n  1321\t\t\t}\n  1322\t\t\t// Only cache a session as distilled when every chunk succeeded, so a\n  1323\t\t\t// session whose agent calls failed is retried on the next run rather\n  1324\t\t\t// than being silently treated as done.\n  1325\t\t\tif !sessionFailed {\n  1326\t\t\t\tif pipeline == distillPipelineCandidates {\n  1327\t\t\t\t\tcurrent := make(map[string]bool, len(ps.chunks))\n  1328\t\t\t\t\tfor _, chunk := range ps.chunks {\n  1329\t\t\t\t\t\tif chunk.DistillTurnID != \"\" {\n  1330\t\t\t\t\t\t\tcurrent[chunk.DistillTurnID] = true\n  1331\t\t\t\t\t\t}\n  1332\t\t\t\t\t}\n  1333\t\t\t\t\tvar removed bool\n  1334\t\t\t\t\tbyBranch[branch], removed = removeMissingDistillTurnAnchors(byBranch[branch], factAnchor{\n  1335\t\t\t\t\t\tSessionID:  session.SessionID,\n  1336\t\t\t\t\t\tTranscript: filepath.ToSlash(session.TranscriptPath),\n  1337\t\t\t\t\t}, current)\n  1338\t\t\t\t\tif removed {\n  1339\t\t\t\t\t\tdirtyBranches[branch] = true\n  1340\t\t\t\t\t}\n  1341\t\t\t\t}\n  1342\t\t\t\tnewCache.Sessions[distillSessionCacheKeyForPipeline(pipeline, branch, session.SessionID)] = ps.fingerprint\n  1343\t\t\t}\n  1344\t\t\treportProgress()\n  1345\t\t}\n  1346\t\tif err := ctx.Err(); err != nil {\n  1347\t\t\treturn nil, err\n  1348\t\t}\n  1349\t\tif agentFailures > 0 && !anyAgentSuccess {\n  1350\t\t\treturn nil, fmt.Errorf(\n  1351\t\t\t\t\"distill aborted after all %d agent calls failed with no successful response; check --agent, --model, authentication, and executable PATH\",\n  1352\t\t\t\tagentFailures,\n  1353\t\t\t)\n  1354\t\t}\n  1355\t\twarnings = capWarnings(warnings, maxDistillWarnings)\n  1356\t\n  1357\t\twriteStarted := time.Now()\n  1358\t\tvar source *factSourceManifest\n  1359\t\terr = withBrainWriteLock(brainDir, func() error {\n  1360\t\t\tif err := flushFactStoresLocked(true); err != nil {\n  1361\t\t\t\treturn err\n  1362\t\t\t}\n  1363\t\t\tif err := writeFactTaxonomy(brainDir, taxonomy); err != nil {\n  1364\t\t\t\treturn err\n  1365\t\t\t}\n  1366\t\n  1367\t\t\t// Summarize the manifest from the whole on-disk store, not just the branches\n  1368\t\t\t// touched this run. A branch-limited (`--branch`) or incremental run only\n  1369\t\t\t// loads a subset into byBranch; folding that subset into the manifest would\n  1370\t\t\t// drop counts/branches/proposals for facts that still exist on other\n  1371\t\t\t// branches. Re-reading the store after writing keeps sources.facts whole.\n  1372\t\t\tallBranches, err := loadAllFactBranches(brainDir)\n  1373\t\t\tif err != nil {\n  1374\t\t\t\treturn err\n  1375\t\t\t}\n  1376\t\t\tbranchNames := make([]string, 0, len(allBranches))\n  1377\t\t\tfor branch := range allBranches {\n  1378\t\t\t\tbranchNames = append(branchNames, branch)\n  1379\t\t\t}\n  1380\t\t\ttotalProposals := countFactProposals(brainDir, branchNames)\n  1381\t\n  1382\t\t\tsource = summarizeFactSource(now, allBranches, chunksScanned, chunksDistilled, totalProposals, warnings)\n  1383\t\t\tsource.CacheHits = cacheHits\n  1384\t\t\tsource.FailedChunks = failedChunks\n  1385\t\t\tsource.PreprocessedBytes = preprocessedBytes\n  1386\t\t\tsource.CandidateBytes = candidateBytes\n  1387\t\t\tsource.Agent = strings.TrimSpace(distillOpts.agent)\n  1388\t\t\tsource.Model = strings.TrimSpace(distillOpts.model)\n  1389\t\t\tsource.Effort = strings.TrimSpace(distillOpts.effort)\n  1390\t\t\tsource.Pipeline = pipeline\n  1391\t\t\tsource.Branch = strings.TrimSpace(distillOpts.branch)\n  1392\t\t\tsource.Force = distillOpts.force\n  1393\t\t\tsource.Jobs = distillRequestedJobs(distillOpts)\n  1394\t\t\tsource.ExtractionJobsCap = distillEffectiveExtractionJobs(extractionAgentCalls, distillOpts)\n  1395\t\t\tsource.MaxChunkBytes = distillMaxChunkBytes(distillOpts)\n  1396\t\t\tsource.Confidence = threshold\n  1397\t\t\tsource.ExtractionCalls = extractionAgentCalls\n  1398\t\t\tsource.ReconcileCalls = reconcileAgentCalls\n  1399\t\t\tsource.TotalAgentCalls = extractionAgentCalls + reconcileAgentCalls\n  1400\t\t\tsource.TokenUsage = usageCollector.summary(source.TotalAgentCalls)\n  1401\t\t\tsource.ExtractionWaitSeconds = extractionSeconds\n  1402\t\t\tsource.ReconcileSeconds = reconcileSeconds\n  1403\t\t\tsource.WriteSeconds = time.Since(writeStarted).Seconds()\n  1404\t\t\tsource.TotalSeconds = time.Since(runStarted).Seconds()\n  1405\t\t\t// Provider work may run for hours. Patch only the facts source while the\n  1406\t\t\t// manifest-leaf lock covers load-through-replace, so a semantic/session/\n  1407\t\t\t// seed writer cannot commit between a stale reload and this publication.\n  1408\t\t\treturn updateBrainManifestAndReadme(brainDir, func(currentManifest *exportManifest) error {\n  1409\t\t\t\tif currentManifest.Sources == nil {\n  1410\t\t\t\t\tcurrentManifest.Sources = &brainSources{}\n  1411\t\t\t\t}\n  1412\t\t\t\t// Manifest schema v3 is decoded strictly by released binaries. Keep\n  1413\t\t\t\t// candidate-only observability in this command's returned summary and\n  1414\t\t\t\t// dry-run report until it has a separately versioned durable leaf; an\n  1415\t\t\t\t// unversioned field addition would make binary rollback impossible.\n  1416\t\t\t\tpersistedSource := *source\n  1417\t\t\t\tpersistedSource.CandidateBytes = 0\n  1418\t\t\t\tpersistedSource.CandidateCards = 0\n  1419\t\t\t\tpersistedSource.CandidateSessions = 0\n  1420\t\t\t\tpersistedSource.CandidatePacks = 0\n  1421\t\t\t\tpersistedSource.CandidatePacksDone = 0\n  1422\t\t\t\tpersistedSource.CandidateMembers = 0\n  1423\t\t\t\tpersistedSource.CandidateCacheHits = 0\n  1424\t\t\t\tpersistedSource.CandidateCacheMisses = 0\n  1425\t\t\t\tpersistedSource.CandidateSplitCalls = 0\n  1426\t\t\t\tpersistedSource.CandidateEmptyResults = 0\n  1427\t\t\t\tpersistedSource.Pipeline = \"\"\n  1428\t\t\t\tpersistedSource.Shadow = false\n  1429\t\t\t\tpersistedSource.ShadowFacts = 0\n  1430\t\t\t\tcurrentManifest.Sources.Facts = &persistedSource\n  1431\t\t\t\tif currentManifest.GeneratedAt.IsZero() {\n  1432\t\t\t\t\tcurrentManifest.GeneratedAt = now\n  1433\t\t\t\t}\n  1434\t\t\t\treturn nil\n  1435\t\t\t})\n     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"crypto/sha256\"\n     6\t\t\"encoding/hex\"\n     7\t\t\"encoding/json\"\n     8\t\t\"errors\"\n     9\t\t\"fmt\"\n    10\t\t\"os\"\n    11\t\t\"path/filepath\"\n    12\t\t\"sort\"\n    13\t\t\"strings\"\n    14\t\t\"time\"\n    15\t\n    16\t\t\"github.com/ashtom/entire-brain/internal/factmerge\"\n    17\t)\n    18\t\n    19\tconst (\n    20\t\tfactsDirName          = \"facts\"\n    21\t\tfactsTaxonomyFileName = \"taxonomy.json\"\n    22\t\tfactsTaxonomyPath     = factsDirName + \"/\" + factsTaxonomyFileName\n    23\t\tfactsFileName         = \"facts.ndjson\"\n    24\t\tfactsMaxPerChunk      = 6 // quality-gate output cap per source chunk\n    25\t\n    26\t\tfactOriginDistilled = \"distilled\"\n    27\t\tfactOriginAuthored  = \"authored\"\n    28\t)\n    29\t\n    30\t// factSourceManifest is recorded under sources.facts in the brain manifest,\n    31\t// parallel to historySourceManifest and the semantic source metadata.\n    32\ttype factSourceManifest struct {\n    33\t\tGeneratedAt           time.Time                 `json:\"generated_at\"`\n    34\t\tTaxonomyPath          string                    `json:\"taxonomy_path\"`\n    35\t\tBranches              []string                  `json:\"branches,omitempty\"`\n    36\t\tFacts                 int                       `json:\"facts\"`\n    37\t\tDistilled             int                       `json:\"distilled\"`\n    38\t\tAuthored              int                       `json:\"authored\"`\n    39\t\tSuperseded            int                       `json:\"superseded\"`\n    40\t\tProposals             int                       `json:\"proposals\"`\n    41\t\tVerified              int                       `json:\"verified\"`\n    42\t\tUnsigned              int                       `json:\"unsigned\"`\n    43\t\tByKind                map[string]int            `json:\"by_kind,omitempty\"`\n    44\t\tChunksScanned         int                       `json:\"chunks_scanned\"`\n    45\t\tChunksDistilled       int                       `json:\"chunks_distilled\"`\n    46\t\tCacheHits             int                       `json:\"cache_hits,omitempty\"`\n    47\t\tFailedChunks          int                       `json:\"failed_chunks,omitempty\"`\n    48\t\tPreprocessedBytes     int64                     `json:\"preprocessed_bytes,omitempty\"`\n    49\t\tCandidateBytes        int64                     `json:\"candidate_bytes,omitempty\"`\n    50\t\tCandidateCards        int                       `json:\"candidate_cards,omitempty\"`\n    51\t\tCandidateSessions     int                       `json:\"candidate_sessions,omitempty\"`\n    52\t\tCandidatePacks        int                       `json:\"candidate_packs,omitempty\"`\n    53\t\tCandidatePacksDone    int                       `json:\"candidate_packs_completed,omitempty\"`\n    54\t\tCandidateMembers      int                       `json:\"candidate_members,omitempty\"`\n    55\t\tCandidateCacheHits    int                       `json:\"candidate_cache_hits,omitempty\"`\n    56\t\tCandidateCacheMisses  int                       `json:\"candidate_cache_misses,omitempty\"`\n    57\t\tCandidateSplitCalls   int                       `json:\"candidate_split_calls,omitempty\"`\n    58\t\tCandidateEmptyResults int                       `json:\"candidate_empty_results,omitempty\"`\n    59\t\tAgent                 string                    `json:\"agent,omitempty\"`\n    60\t\tModel                 string                    `json:\"model,omitempty\"`\n    61\t\tEffort                string                    `json:\"effort,omitempty\"`\n    62\t\tPipeline              string                    `json:\"pipeline,omitempty\"`\n    63\t\tBranch                string                    `json:\"branch,omitempty\"`\n    64\t\tForce                 bool                      `json:\"force,omitempty\"`\n    65\t\tJobs                  int                       `json:\"jobs,omitempty\"`\n    66\t\tExtractionJobsCap     int                       `json:\"extraction_jobs_cap,omitempty\"`\n    67\t\tMaxChunkBytes         int                       `json:\"max_chunk_bytes,omitempty\"`\n    68\t\tConfidence            float64                   `json:\"confidence_threshold,omitempty\"`\n    69\t\tExtractionCalls       int                       `json:\"extraction_agent_calls,omitempty\"`\n    70\t\tReconcileCalls        int                       `json:\"reconcile_agent_calls,omitempty\"`\n    71\t\tTotalAgentCalls       int                       `json:\"total_agent_calls,omitempty\"`\n    72\t\tTokenUsage            *distillTokenUsageSummary `json:\"token_usage,omitempty\"`\n    73\t\t// ExtractionWaitSeconds is the consumer's WAIT on prefetched results, not\n    74\t\t// agent compute: with concurrency > 1, calls completing in the background\n    75\t\t// register ~0s here. Compare total_seconds across --jobs settings for\n    76\t\t// scheduling claims.\n    77\t\tExtractionWaitSeconds float64  `json:\"extraction_wait_seconds,omitempty\"`\n    78\t\tReconcileSeconds      float64  `json:\"reconcile_seconds,omitempty\"`\n    79\t\tWriteSeconds          float64  `json:\"write_seconds,omitempty\"`\n    80\t\tTotalSeconds          float64  `json:\"total_seconds,omitempty\"`\n    81\t\tWarnings              []string `json:\"warnings,omitempty\"`\n    82\t\t// Shadow and ShadowFacts are command-result-only Phase 2 evidence. They\n    83\t\t// are cleared before any schema-v3 manifest publication.\n    84\t\tShadow      bool `json:\"shadow,omitempty\"`\n    85\t\tShadowFacts int  `json:\"shadow_facts,omitempty\"`\n    86\t}\n    87\t\n    88\t// factRecord (factmerge.Record) and factAnchor (factmerge.Anchor) are defined\n    89\t// as type aliases in facts_aliases.go; the durable-fact data model now lives in\n    90\t// internal/factmerge.\n    91\t\n    92\t// factTaxonomy is the active taxonomy snapshot. Paths are validated against\n    93\t// factPathPattern; classification may only invent a new three-level path under\n    94\t// an existing top-level category.\n    95\ttype factTaxonomy struct {\n    96\t\tGeneratedAt time.Time         `json:\"generated_at\"`\n    97\t\tCategories  map[string]string `json:\"categories\"` // top-level -> description\n    98\t\tPaths       []factPathDef     `json:\"paths\"`\n    99\t}\n   100\t\n   101\ttype factPathDef struct {\n   102\t\tPath        string   `json:\"path\"`\n   103\t\tDescription string   `json:\"description\"`\n   104\t\tExamples    []string `json:\"examples,omitempty\"`\n   105\t}\n   106\t\n   107\t// normalizeFactText, factRecordID, validFactPath, and normalizeFactPaths moved\n   108\t// to internal/factmerge (NormalizeText/RecordID/ValidPath/NormalizePaths); the\n   109\t// CLI names are forwarding wrappers in facts_aliases.go.\n   110\t\n   111\t// factTopLevel returns the top-level category of a taxonomy path (the segment\n   112\t// before the first dot), or \"\" if the path is empty.\n   113\tfunc factTopLevel(path string) string {\n   114\t\tif i := strings.IndexByte(path, '.'); i >= 0 {\n   115\t\t\treturn path[:i]\n   116\t\t}\n   117\t\treturn path\n   118\t}\n   119\t\n   120\t// --- on-disk layout -------------------------------------------------------\n   121\t\n   122\t// factsBranchRelDir returns the brain-relative directory holding a branch's\n   123\t// facts. The readable slug alone is not collision-free — distinct branches can\n   124\t// sanitize to the same slug (e.g. \"evis/search\" and \"evis-search\", or \"Main\"\n   125\t// and \"main\") — and two branches sharing a facts file would clobber each other\n   126\t// and break branch isolation. A short hash of the full branch name is appended\n   127\t// so each branch maps to a stable, unique directory while staying greppable.\n   128\tfunc factsBranchRelDir(branch string) string {\n   129\t\tslug := safePathComponent(branch, \"branch\", 80)\n   130\t\tsum := sha256.Sum256([]byte(branch))\n   131\t\treturn filepath.ToSlash(filepath.Join(factsDirName, slug+\"-\"+hex.EncodeToString(sum[:4])))\n   132\t}\n   133\t\n   134\tfunc factsFileRelPath(branch string) string {\n   135\t\treturn filepath.ToSlash(filepath.Join(factsBranchRelDir(branch), factsFileName))\n   136\t}\n   137\t\n   138\t// loadFacts reads a branch's facts.ndjson. A missing file is not an error: it\n   139\t// yields an empty slice so first-run callers do not special-case it. Blank\n   140\t// lines are skipped; a malformed line is a hard error so a corrupt store is\n   141\t// surfaced rather than silently dropping records.\n   142\tfunc loadFacts(brainDir, branch string) ([]factRecord, error) {\n   143\t\tpath := filepath.Join(brainDir, filepath.FromSlash(factsFileRelPath(branch)))\n   144\t\treturn parseFactsFile(path)\n   145\t}\n   146\t\n   147\t// parseFactsFile reads a facts.ndjson file at an absolute path. A missing file\n   148\t// yields an empty slice; a malformed line is a hard error so a corrupt store is\n   149\t// surfaced rather than silently dropping records. The byte-level scan lives in\n   150\t// factmerge.ParseNDJSON; this keeps only the file/path handling and restores the\n   151\t// historical \"parse <file> line N: ...\" message the core cannot know the path\n   152\t// for.\n   153\tfunc parseFactsFile(path string) ([]factRecord, error) {\n   154\t\tf, err := os.Open(path)\n   155\t\tif err != nil {\n   156\t\t\tif os.IsNotExist(err) {\n   157\t\t\t\treturn nil, nil\n   158\t\t\t}\n   159\t\t\treturn nil, err\n   160\t\t}\n   161\t\tdefer f.Close()\n   162\t\trecords, err := factmerge.ParseNDJSON(f)\n   163\t\tif err != nil {\n   164\t\t\tvar perr *factmerge.ParseError\n   165\t\t\tif errors.As(err, &perr) {\n   166\t\t\t\treturn nil, fmt.Errorf(\"parse %s line %d: %w\", filepath.Base(path), perr.Line, perr.Err)\n   167\t\t\t}\n   168\t\t\treturn nil, err\n   169\t\t}\n   170\t\treturn records, nil\n   171\t}\n   172\t\n   173\t// writeFacts persists a branch's facts as newline-delimited JSON, one record\n   174\t// per line, sorted deterministically so the file is stable across rebuilds and\n   175\t// diffs cleanly. The branch directory is created if needed. The byte-level\n   176\t// sort+marshal lives in factmerge.WriteNDJSON; this keeps the atomic,\n   177\t// symlink-rejecting disk write in the CLI.\n   178\tfunc writeFacts(brainDir, branch string, records []factRecord) error {\n   179\t\tvar buf bytes.Buffer\n   180\t\tif err := factmerge.WriteNDJSON(&buf, records); err != nil {\n   181\t\t\treturn err\n   182\t\t}\n   183\t\treturn writeBrainRelativeFileAtomic(brainDir, factsFileRelPath(branch), buf.Bytes(), 0o600)\n   184\t}\n   185\t\n   186\t// --- taxonomy -------------------------------------------------------------\n   187\t\n   188\t// defaultFactTaxonomy is the shipped baseline taxonomy. The top-level\n   189\t// categories here are fixed in Phase A; distillation may invent a new\n   190\t// three-level path only under one of these categories. The brain regenerates\n   191\t// taxonomy.json from this default on refresh.\n   192\tfunc defaultFactTaxonomy(now time.Time) factTaxonomy {\n   193\t\treturn factTaxonomy{\n   194\t\t\tGeneratedAt: now,\n   195\t\t\tCategories: map[string]string{\n   196\t\t\t\t\"preferences\":  \"How the user wants to work and how code should be written.\",\n   197\t\t\t\t\"architecture\": \"Resolved design, boundary, and data-flow decisions and their rationale.\",\n   198\t\t\t\t\"project\":      \"Stack, tooling, CI/CD, ownership, and standing project facts.\",\n   199\t\t\t\t\"workflow\":     \"Branching, testing, review, and release process rules.\",\n   200\t\t\t\t\"constraints\":  \"Non-obvious invariants, gotchas, and hard constraints.\",\n   201\t\t\t},\n   202\t\t\tPaths: []factPathDef{\n   203\t\t\t\t{Path: \"preferences.coding.style\", Description: \"Stated code-style preferences.\", Examples: []string{\"prefers table-driven tests\"}},\n   204\t\t\t\t{Path: \"preferences.workflow.general\", Description: \"How the user prefers to work day to day.\"},\n   205\t\t\t\t{Path: \"architecture.boundaries.rationale\", Description: \"Why a module or package boundary exists.\"},\n   206\t\t\t\t{Path: \"architecture.data.flow\", Description: \"How data moves through the system.\"},\n   207\t\t\t\t{Path: \"project.tooling.stack\", Description: \"Languages, frameworks, and tools the project uses.\"},\n   208\t\t\t\t{Path: \"project.ci_cd.pipeline\", Description: \"Build, test, and deploy pipeline facts.\"},\n   209\t\t\t\t{Path: \"workflow.branching.rules\", Description: \"Branching and merge conventions.\"},\n   210\t\t\t\t{Path: \"workflow.testing.rules\", Description: \"How and when tests must be run.\"},\n     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"context\"\n     5\t\t\"encoding/json\"\n     6\t\t\"fmt\"\n     7\t\t\"math\"\n     8\t\t\"os\"\n     9\t\t\"path/filepath\"\n    10\t\t\"sort\"\n    11\t\t\"strconv\"\n    12\t\t\"strings\"\n    13\t\t\"time\"\n    14\t)\n    15\t\n    16\tconst factsProposalsFileName = \"proposals.ndjson\"\n    17\t\n    18\tfunc factsProposalsRelPath(branch string) string {\n    19\t\treturn filepath.ToSlash(filepath.Join(factsBranchRelDir(branch), factsProposalsFileName))\n    20\t}\n    21\t\n    22\t// loadFactProposals reads a branch's pending proposals; a missing file yields\n    23\t// none. A malformed line is a hard error so a corrupt queue is surfaced.\n    24\tfunc loadFactProposals(brainDir, branch string) ([]factProposal, error) {\n    25\t\tpath := filepath.Join(brainDir, filepath.FromSlash(factsProposalsRelPath(branch)))\n    26\t\tdata, err := os.ReadFile(path)\n    27\t\tif err != nil {\n    28\t\t\tif os.IsNotExist(err) {\n    29\t\t\t\treturn nil, nil\n    30\t\t\t}\n    31\t\t\treturn nil, err\n    32\t\t}\n    33\t\treturn parseFactProposals(data, factsProposalsRelPath(branch))\n    34\t}\n    35\t\n    36\tfunc parseFactProposals(data []byte, displayPath string) ([]factProposal, error) {\n    37\t\tvar proposals []factProposal\n    38\t\tfor i, line := range strings.Split(string(data), \"\\n\") {\n    39\t\t\tline = strings.TrimSpace(line)\n    40\t\t\tif line == \"\" {\n    41\t\t\t\tcontinue\n    42\t\t\t}\n    43\t\t\tvar p factProposal\n    44\t\t\tif err := json.Unmarshal([]byte(line), &p); err != nil {\n    45\t\t\t\treturn nil, fmt.Errorf(\"parse %s line %d: %w\", displayPath, i+1, err)\n    46\t\t\t}\n    47\t\t\tproposals = append(proposals, p)\n    48\t\t}\n    49\t\treturn proposals, nil\n    50\t}\n    51\t\n    52\t// writeFactProposals persists a branch's pending proposals, deduplicated by\n    53\t// (action, candidate, target) and sorted for a stable file. An empty set\n    54\t// removes the file so a fully-resolved branch leaves no stale queue.\n    55\tfunc writeFactProposals(brainDir, branch string, proposals []factProposal) error {\n    56\t\tcanonical := append([]factProposal(nil), proposals...)\n    57\t\tfor i := range canonical {\n    58\t\t\tcanonical[i].Branch = branch\n    59\t\t}\n    60\t\treturn writeFactProposalsAtRel(brainDir, factsProposalsRelPath(branch), canonical)\n    61\t}\n    62\t\n    63\tfunc writeFactProposalsAtRel(brainDir, rel string, proposals []factProposal) error {\n    64\t\tdeduped := dedupeProposals(proposals)\n    65\t\tif len(deduped) == 0 {\n    66\t\t\treturn removeBrainRelativeFile(brainDir, rel)\n    67\t\t}\n    68\t\tvar buf strings.Builder\n    69\t\tfor _, p := range deduped {\n    70\t\t\tdata, err := json.Marshal(p)\n    71\t\t\tif err != nil {\n    72\t\t\t\treturn err\n    73\t\t\t}\n    74\t\t\tbuf.Write(data)\n    75\t\t\tbuf.WriteByte('\\n')\n    76\t\t}\n    77\t\treturn writeBrainRelativeFileAtomic(brainDir, rel, []byte(buf.String()), 0o600)\n    78\t}\n    79\t\n    80\t// clearDistillOwnedLegacyProposalStore cleans a pre-branch-ownership proposal\n    81\t// file in place. Member-attributed sync proposals survive because distillation\n    82\t// does not own or regenerate them.\n    83\tfunc clearDistillOwnedLegacyProposalStore(brainDir, rel string) error {\n    84\t\tdata, present, err := readMemoryStateFile(brainDir, rel, \"legacy fact proposal store\", defaultMaxReadBytes)\n    85\t\tif err != nil || !present {\n    86\t\t\treturn err\n    87\t\t}\n    88\t\tproposals, err := parseFactProposals(data, rel)\n    89\t\tif err != nil {\n    90\t\t\treturn err\n    91\t\t}\n    92\t\tkept := proposals[:0]\n    93\t\tfor _, proposal := range proposals {\n    94\t\t\tif strings.TrimSpace(proposal.ProposedBy) != \"\" {\n    95\t\t\t\tkept = append(kept, proposal)\n    96\t\t\t}\n    97\t\t}\n    98\t\treturn writeFactProposalsAtRel(brainDir, rel, kept)\n    99\t}\n   100\t\n   101\tfunc dedupeProposals(proposals []factProposal) []factProposal {\n   102\t\tseen := make(map[string]struct{}, len(proposals))\n   103\t\tout := make([]factProposal, 0, len(proposals))\n   104\t\tfor _, p := range proposals {\n   105\t\t\tkey := p.Action + \"\\x00\" + p.CandidateID + \"\\x00\" + p.TargetID\n   106\t\t\tif _, ok := seen[key]; ok {\n   107\t\t\t\tcontinue\n   108\t\t\t}\n   109\t\t\tseen[key] = struct{}{}\n   110\t\t\tout = append(out, p)\n   111\t\t}\n   112\t\tsort.SliceStable(out, func(i, j int) bool {\n   113\t\t\tif out[i].TargetID != out[j].TargetID {\n   114\t\t\t\treturn out[i].TargetID < out[j].TargetID\n   115\t\t\t}\n   116\t\t\treturn out[i].CandidateID < out[j].CandidateID\n   117\t\t})\n   118\t\treturn out\n   119\t}\n   120\t\n   121\tconst (\n   122\t\t// maxReconcileExisting bounds how many existing active facts at a\n   123\t\t// candidate's paths are shown to the agent, keeping the reconcile prompt\n   124\t\t// bounded even on busy paths. When more exist, the most recently updated\n   125\t\t// are shown and the cap is reported as a warning (no silent truncation).\n   126\t\tmaxReconcileExisting = 50\n   127\t)\n   128\t\n   129\t// reconcilePrompt is the static system prompt for the reconcile pass. The\n   130\t// dynamic candidate/existing lists are supplied on stdin (see reconcileInput).\n   260\t// isNumericToken reports whether a token parses as a finite float, used to tell\n   261\t// a trailing confidence value apart from a \"-\" placeholder or missing field.\n   262\t// NaN/±Inf are rejected: ParseFloat accepts them, but a NaN confidence would\n   263\t// silently bypass the low-confidence gate downstream (every comparison with NaN\n   264\t// is false), so they must not be treated as a numeric confidence.\n   265\tfunc isNumericToken(token string) bool {\n   266\t\tvalue, err := strconv.ParseFloat(token, 64)\n   267\t\treturn err == nil && !math.IsNaN(value) && !math.IsInf(value, 0)\n   268\t}\n   269\t\n   270\t// parseConfidence reads a confidence token, clamped to [0,1]; unparseable\n   271\t// values (including NaN/±Inf, which would otherwise slip past the [0,1] clamp\n   272\t// and the auto-apply threshold) default to 0 so an unreadable confidence is\n   273\t// treated as low and queued for review rather than auto-applied.\n   274\tfunc parseConfidence(token string) float64 {\n   275\t\tvalue, err := strconv.ParseFloat(token, 64)\n   276\t\tif err != nil || math.IsNaN(value) || math.IsInf(value, 0) {\n   277\t\t\treturn 0\n   278\t\t}\n   279\t\tif value < 0 {\n   280\t\t\treturn 0\n   281\t\t}\n   282\t\tif value > 1 {\n   283\t\t\treturn 1\n   284\t\t}\n   285\t\treturn value\n   286\t}\n   287\t\n   288\t// activeFactsAtPaths returns the active facts whose paths intersect the given\n   289\t// path set, most-recently-updated first, capped at maxReconcileExisting. The\n   290\t// boolean reports whether the cap dropped any facts.\n   291\tfunc activeFactsAtPaths(records []factRecord, paths []string) ([]factRecord, bool) {\n   292\t\twant := make(map[string]struct{}, len(paths))\n   293\t\tfor _, p := range paths {\n   294\t\t\twant[p] = struct{}{}\n   295\t\t}\n   296\t\tvar matched []factRecord\n   297\t\tfor _, record := range records {\n   298\t\t\tif record.Status != factStatusActive {\n   299\t\t\t\tcontinue\n   300\t\t\t}\n   301\t\t\tfor _, p := range record.Paths {\n   302\t\t\t\tif _, ok := want[p]; ok {\n   303\t\t\t\t\tmatched = append(matched, record)\n   304\t\t\t\t\tbreak\n   305\t\t\t\t}\n   306\t\t\t}\n   307\t\t}\n   308\t\tsort.SliceStable(matched, func(i, j int) bool {\n   309\t\t\tif !matched[i].UpdatedAt.Equal(matched[j].UpdatedAt) {\n   310\t\t\t\treturn matched[i].UpdatedAt.After(matched[j].UpdatedAt)\n   311\t\t\t}\n   312\t\t\treturn matched[i].ID < matched[j].ID\n   313\t\t})\n   314\t\tif len(matched) > maxReconcileExisting {\n   315\t\t\treturn matched[:maxReconcileExisting], true\n   316\t\t}\n   317\t\treturn matched, false\n   318\t}\n   319\t\n   320\t// candidatePathSet returns the sorted union of paths across the candidates.\n   321\tfunc candidatePathSet(candidates []factRecord) []string {\n   322\t\tseen := map[string]struct{}{}\n   323\t\tfor _, c := range candidates {\n   324\t\t\tfor _, p := range c.Paths {\n   325\t\t\t\tseen[p] = struct{}{}\n   326\t\t\t}\n   327\t\t}\n   328\t\tpaths := make([]string, 0, len(seen))\n   329\t\tfor p := range seen {\n   330\t\t\tpaths = append(paths, p)\n   331\t\t}\n   332\t\tsort.Strings(paths)\n   333\t\treturn paths\n   334\t}\n   335\t\n   336\t// newDistilledFactActions is the candidate pipeline's conservative settlement\n   337\t// boundary. Every extracted record is applied as new; factmerge.Upsert still\n   338\t// collapses exact content IDs and unions provenance, but no fuzzy relationship\n   339\t// can silently merge or supersede an unrelated fact. Later candidate-pipeline\n   340\t// versions may enqueue evidence-backed ambiguous pairs for review, but automatic\n   341\t// supersession must never be inferred from taxonomy overlap alone.\n   342\tfunc newDistilledFactActions(candidates []factRecord) []factAction {\n   343\t\tactions := make([]factAction, len(candidates))\n   344\t\tfor i, candidate := range candidates {\n   345\t\t\tactions[i] = factAction{Kind: factActionNew, Confidence: 1, Candidate: candidate}\n   346\t\t}\n   347\t\treturn actions\n   348\t}\n   349\t\n   350\t// removeRelocatedDistillAnchors replaces the entire prior materialization for\n   351\t// the same stable candidate trigger before fresh records are applied. This\n   352\t// removes stale line anchors after transcript layout shifts and stale facts\n   353\t// after a crash/retry produces different wording. Facts corroborated by another\n   354\t// trigger/session retain those independent anchors; a distilled fact that loses\n   355\t// its final anchor is dropped.\n   356\tfunc removeRelocatedDistillAnchors(records []factRecord, source factAnchor) ([]factRecord, bool) {\n   357\t\tif source.SessionID == \"\" || source.DistillTurnID == \"\" {\n   358\t\t\treturn records, false\n   359\t\t}\n   360\t\tout := records[:0]\n   361\t\tchanged := false\n   362\t\tfor index := range records {\n   363\t\t\toriginalAnchors := len(records[index].Provenance)\n   364\t\t\tkept := records[index].Provenance[:0]\n   365\t\t\tfor _, anchor := range records[index].Provenance {\n   366\t\t\t\tif anchor.SessionID != source.SessionID || anchor.DistillTurnID != source.DistillTurnID {\n   367\t\t\t\t\tkept = append(kept, anchor)\n   368\t\t\t\t} else {\n   369\t\t\t\t\tchanged = true\n   370\t\t\t\t}\n   371\t\t\t}\n   372\t\t\trecords[index].Provenance = kept\n   373\t\t\tif originalAnchors > 0 && len(kept) == 0 && records[index].Origin == factOriginDistilled {\n   374\t\t\t\tcontinue\n   375\t\t\t}\n   376\t\t\tout = append(out, records[index])\n   377\t\t}\n   378\t\treturn out, changed\n   379\t}\n   380\t\n   381\tfunc removeMissingDistillTurnAnchors(records []factRecord, source factAnchor, current map[string]bool) ([]factRecord, bool) {\n   382\t\tif source.SessionID == \"\" {\n   383\t\t\treturn records, false\n   384\t\t}\n   385\t\tout := records[:0]\n   386\t\tchanged := false\n   387\t\tfor index := range records {\n   388\t\t\toriginalAnchors := len(records[index].Provenance)\n   389\t\t\tkept := records[index].Provenance[:0]\n   390\t\t\tfor _, anchor := range records[index].Provenance {\n   391\t\t\t\tstale := anchor.SessionID == source.SessionID && anchor.DistillTurnID != \"\" && !current[anchor.DistillTurnID]\n   392\t\t\t\tif stale {\n   393\t\t\t\t\tchanged = true\n   394\t\t\t\t\tcontinue\n   395\t\t\t\t}\n   396\t\t\t\tkept = append(kept, anchor)\n   397\t\t\t}\n   398\t\t\trecords[index].Provenance = kept\n   399\t\t\tif originalAnchors > 0 && len(kept) == 0 && records[index].Origin == factOriginDistilled {\n   400\t\t\t\tcontinue\n   401\t\t\t}\n   402\t\t\tout = append(out, records[index])\n   403\t\t}\n   404\t\treturn out, changed\n   405\t}\n   406\t\n   407\t// reconcileChunkCandidates resolves a chunk's candidates against the current\n   408\t// active set: when no existing facts share the candidates' paths, every\n   409\t// candidate is trivially `new` (no agent call); otherwise the agent decides.\n   410\t// An agent error falls back to treating all candidates as `new` so facts are\n","stderr":"","aggregated_output":"  1080\t\t\t\t\t\t}\n  1081\t\t\t\t\t}\n  1082\t\t\t\t} else {\n  1083\t\t\t\t\tprior = loadedProposals\n  1084\t\t\t\t}\n  1085\t\t\t\tmerged := dedupeProposals(append(prior, proposalsByBranch[branch]...))\n  1086\t\t\t\tif err := writeFactProposals(brainDir, branch, merged); err != nil {\n  1087\t\t\t\t\treturn err\n  1088\t\t\t\t}\n  1089\t\t\t\t// A force run keeps branches dirty between mid-run flushes so the\n  1090\t\t\t\t// final flush always rewrites them — that write is what drops the\n  1091\t\t\t\t// prior proposal backlog. Otherwise the branch is clean until new\n  1092\t\t\t\t// fact actions touch it.\n  1093\t\t\t\tif final || !distillOpts.force {\n  1094\t\t\t\t\tdelete(dirtyBranches, branch)\n  1095\t\t\t\t}\n  1096\t\t\t}\n  1097\t\t\tif final && distillOpts.force {\n  1098\t\t\t\tfor _, rel := range forceScope.LegacyProposalRels {\n  1099\t\t\t\t\tif err := clearDistillOwnedLegacyProposalStore(brainDir, rel); err != nil {\n  1100\t\t\t\t\t\treturn err\n  1101\t\t\t\t\t}\n  1102\t\t\t\t}\n  1103\t\t\t}\n  1104\t\t\tcache := newCache\n  1105\t\t\tif !final && !distillOpts.force {\n  1106\t\t\t\tcache = distillCache{Version: distillCacheVersion, Sessions: make(map[string]string, len(prevCache.Sessions)+len(newCache.Sessions))}\n  1107\t\t\t\tmaps.Copy(cache.Sessions, prevCache.Sessions)\n  1108\t\t\t\tmaps.Copy(cache.Sessions, newCache.Sessions)\n  1109\t\t\t}\n  1110\t\t\treturn saveDistillCache(brainDir, cache)\n  1111\t\t}\n  1112\t\tflushFactStores := func(final bool) error {\n  1113\t\t\treturn withBrainWriteLock(brainDir, func() error {\n  1114\t\t\t\treturn flushFactStoresLocked(final)\n  1115\t\t\t})\n  1116\t\t}\n  1117\t\tflushInterval := distillOpts.flushEvery\n  1118\t\tif flushInterval <= 0 {\n  1119\t\t\tflushInterval = distillFlushCallInterval\n  1120\t\t}\n  1121\t\tcallsSinceFlush := 0\n  1122\t\tmaybeFlush := func() error {\n  1123\t\t\tif callsSinceFlush < flushInterval {\n  1124\t\t\t\treturn nil\n  1125\t\t\t}\n  1126\t\t\t// Reset even on failure so a persistent write error is retried once per\n  1127\t\t\t// interval, not on every call.\n  1128\t\t\tcallsSinceFlush = 0\n  1129\t\t\tif err := flushFactStores(false); err != nil {\n  1130\t\t\t\tif errors.Is(err, errDistillFactStoreChanged) {\n  1131\t\t\t\t\treturn err\n  1132\t\t\t\t}\n  1133\t\t\t\t// Non-fatal: a mid-run flush only narrows the loss window, and\n  1134\t\t\t\t// aborting an hours-long run over a transient write error would lose\n  1135\t\t\t\t// far more than the flush protects. Failed branches stay dirty, so\n  1136\t\t\t\t// the next interval (and the final flush) retries them.\n  1137\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"mid-run flush failed (will retry): %v\", err))\n  1138\t\t\t}\n  1139\t\t\treturn nil\n  1140\t\t}\n  1141\t\n  1142\t\t// Session pipeline: a producer goroutine prepares sessions ahead —\n  1143\t\t// transcript read, preprocessing, fingerprint/cache check, chunking — and\n  1144\t\t// dispatches chunk agent calls into one pool shared ACROSS sessions (see\n  1145\t\t// startSessionPrefetch), while this loop consumes results strictly in\n  1146\t\t// chronological order, so reconcile and fact application keep their exact\n  1147\t\t// serial semantics. Canceling pipeCtx (deferred; covers the abort return\n  1148\t\t// too) stops preparation, dispatch, and in-flight agent calls.\n  1149\t\tpipeCtx, pipeCancel := context.WithCancel(ctx)\n  1150\t\tprefetch := startSessionPrefetch(pipeCtx, brainDir, repoDir, args, sessions, prevCache, distillOpts, resolveBranch)\n  1151\t\tdefer func() {\n  1152\t\t\tpipeCancel()\n  1153\t\t\tprefetch.wait()\n  1154\t\t}()\n  1155\t\tfor ps := range prefetch.Sessions {\n  1156\t\t\tsession, branch := ps.session, ps.branch\n  1157\t\t\tif ps.skip {\n  1158\t\t\t\t// Carry the session's cache entry through unchanged: the final flush\n  1159\t\t\t\t// persists newCache only, so dropping filtered sessions here would\n  1160\t\t\t\t// make the next unfiltered run re-distill every other branch (or\n  1161\t\t\t\t// session) from scratch. (The fingerprint-match skip below does the\n  1162\t\t\t\t// same.)\n  1163\t\t\t\tcacheKey := distillSessionCacheKeyForPipeline(pipeline, branch, session.SessionID)\n  1164\t\t\t\tif prev, ok := prevCache.Sessions[cacheKey]; ok {\n  1165\t\t\t\t\tnewCache.Sessions[cacheKey] = prev\n  1166\t\t\t\t} else if !distillOpts.force {\n  1167\t\t\t\t\tprev, ok := prevCache.Sessions[session.SessionID]\n  1168\t\t\t\t\tif !ok {\n  1169\t\t\t\t\t\tcontinue\n  1170\t\t\t\t\t}\n  1171\t\t\t\t\t// A legacy entry stays under its legacy key (and formula) until\n  1172\t\t\t\t\t// its session is actually visited and grandfathered — copying it\n  1173\t\t\t\t\t// under the new key would make it permanently unmatchable.\n  1174\t\t\t\t\tnewCache.Sessions[session.SessionID] = prev\n  1175\t\t\t\t}\n  1176\t\t\t\tcontinue\n  1177\t\t\t}\n  1178\t\t\tif ps.readErr != nil {\n  1179\t\t\t\tpipeCancel()\n  1180\t\t\t\treturn nil, fmt.Errorf(\"read canonical transcript %s: %w\", filepath.ToSlash(session.TranscriptPath), ps.readErr)\n  1181\t\t\t}\n  1182\t\t\tensureBranch(branch)\n  1183\t\n  1184\t\t\tsessionsDone++\n  1185\t\t\t// Report once per session, at every exit path, so the running fact count\n  1186\t\t\t// includes the session just processed (an emit at session start would lag\n  1187\t\t\t// by one session and always show 0 for a single-session run).\n  1188\t\t\treportProgress := func() {\n  1189\t\t\t\tif distillOpts.progress != nil {\n  1190\t\t\t\t\tdistillOpts.progress(distillProgress{SessionsDone: sessionsDone, SessionsTotal: totalSessions, Branch: branch, Facts: factsFound})\n  1191\t\t\t\t}\n  1192\t\t\t}\n  1193\t\t\tpreprocessedBytes += int64(ps.preBytes)\n  1194\t\t\tcandidateBytes += int64(ps.candidateBytes)\n  1195\t\t\tif ps.cached {\n  1196\t\t\t\tcacheHits++\n  1197\t\t\t\tnewCache.Sessions[distillSessionCacheKeyForPipeline(pipeline, branch, session.SessionID)] = ps.fingerprint // unchanged; retain in cache and keep existing facts\n  1198\t\t\t\treportProgress()\n  1199\t\t\t\tcontinue\n  1200\t\t\t}\n  1201\t\n  1202\t\t\tsessionFailed := false\n  1203\t\t\tfor chunkIdx, chunk := range ps.chunks {\n  1204\t\t\t\tchunksScanned++\n  1205\t\t\t\tanchor := factAnchor{\n  1206\t\t\t\t\tSessionID:    session.SessionID,\n  1207\t\t\t\t\tCheckpointID: session.LatestCheckpoint,\n  1208\t\t\t\t\tTranscript:   filepath.ToSlash(session.TranscriptPath),\n  1209\t\t\t\t\tLine:         chunk.StartLine,\n  1210\t\t\t\t}\n  1211\t\t\t\tif pipeline == distillPipelineCandidates {\n  1212\t\t\t\t\tanchor.EndLine = chunk.EndLine\n  1213\t\t\t\t\tanchor.DistillTurnID = chunk.DistillTurnID\n  1214\t\t\t\t}\n  1215\t\t\t\textractionStarted := time.Now()\n  1216\t\t\t\tout, runErr := ps.result(chunkIdx)\n  1217\t\t\t\textractionSeconds += time.Since(extractionStarted).Seconds()\n  1218\t\t\t\textractionAgentCalls++\n  1219\t\t\t\tcallsSinceFlush++\n  1220\t\t\t\tif runErr != nil {\n  1221\t\t\t\t\tif pipeline == distillPipelineCandidates {\n  1222\t\t\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"candidate extraction failed for %s:%d\", session.SessionID, chunk.StartLine))\n  1223\t\t\t\t\t} else {\n  1224\t\t\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"agent failed on %s:%d: %v\", session.SessionID, chunk.StartLine, runErr))\n  1225\t\t\t\t\t}\n  1226\t\t\t\t\tsessionFailed = true\n  1227\t\t\t\t\tfailedChunks++\n  1228\t\t\t\t\tagentFailures++\n  1229\t\t\t\t\t// Fail fast on a misconfiguration: nothing has distilled yet and the\n  1230\t\t\t\t\t// agent keeps failing, so every call is almost certainly erroring the\n  1231\t\t\t\t\t// same way (bad --model, missing agent, auth). Abort with the agent's\n  1232\t\t\t\t\t// own error instead of churning through every remaining session.\n  1233\t\t\t\t\tif !anyAgentSuccess && agentFailures >= distillAgentAbortThreshold {\n  1234\t\t\t\t\t\tif pipeline == distillPipelineCandidates {\n  1235\t\t\t\t\t\t\treturn nil, fmt.Errorf(\"candidate distill aborted after %d agent failures with no valid response; check --agent, --model, authentication, and executable PATH\", agentFailures)\n  1236\t\t\t\t\t\t}\n  1237\t\t\t\t\t\treturn nil, fmt.Errorf(\"distill aborted after %d agent failures with no facts distilled — check --agent and --model. Last error: %v\", agentFailures, runErr)\n  1238\t\t\t\t\t}\n  1239\t\t\t\t\t// Flush on the failure path too: a long failure streak (rate\n  1240\t\t\t\t\t// limiting, timeouts) is exactly when a run tends to get killed,\n  1241\t\t\t\t\t// and skipping the flush here would leave pre-streak facts\n  1242\t\t\t\t\t// unpersisted for the streak's entire duration.\n  1243\t\t\t\t\tif err := maybeFlush(); err != nil {\n  1244\t\t\t\t\t\treturn nil, err\n  1245\t\t\t\t\t}\n  1246\t\t\t\t\tcontinue\n  1247\t\t\t\t}\n  1248\t\t\t\trecords, chunkWarnings := distilledFactsFromOutput(out, taxonomy, anchor, branch, now)\n  1249\t\t\t\t// Sharpen provenance where the entity index can place the fact's\n  1250\t\t\t\t// locus; a no-op (and never an error) when the index is absent.\n  1251\t\t\t\trecords = applyEntityProvenance(records, distillOpts.entityProvenance)\n  1252\t\t\t\tif pipeline == distillPipelineCandidates {\n  1253\t\t\t\t\tif !candidateDistillOutputIsProtocolComplete(out) || len(chunkWarnings) > 0 {\n  1254\t\t\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"candidate output at %s:%d violated the extraction protocol\", session.SessionID, chunk.StartLine))\n  1255\t\t\t\t\t\tsessionFailed = true\n  1256\t\t\t\t\t\tfailedChunks++\n  1257\t\t\t\t\t\tagentFailures++\n  1258\t\t\t\t\t\tif !anyAgentSuccess && agentFailures >= distillAgentAbortThreshold {\n  1259\t\t\t\t\t\t\treturn nil, fmt.Errorf(\"candidate distill aborted after %d invalid agent responses with no protocol-valid response; check --agent and --model\", agentFailures)\n  1260\t\t\t\t\t\t}\n  1261\t\t\t\t\t\tif err := maybeFlush(); err != nil {\n  1262\t\t\t\t\t\t\treturn nil, err\n  1263\t\t\t\t\t\t}\n  1264\t\t\t\t\t\tcontinue\n  1265\t\t\t\t\t}\n  1266\t\t\t\t\tanyAgentSuccess = true\n  1267\t\t\t\t\tvar removed bool\n  1268\t\t\t\t\tbyBranch[branch], removed = removeRelocatedDistillAnchors(byBranch[branch], anchor)\n  1269\t\t\t\t\tif removed {\n  1270\t\t\t\t\t\tdirtyBranches[branch] = true\n  1271\t\t\t\t\t}\n  1272\t\t\t\t} else {\n  1273\t\t\t\t\tanyAgentSuccess = true\n  1274\t\t\t\t\twarnings = append(warnings, chunkWarnings...)\n  1275\t\t\t\t}\n  1276\t\t\t\tif len(records) == 0 {\n  1277\t\t\t\t\tif err := maybeFlush(); err != nil {\n  1278\t\t\t\t\t\treturn nil, err\n  1279\t\t\t\t\t}\n  1280\t\t\t\t\tcontinue\n  1281\t\t\t\t}\n  1282\t\t\t\tfactsFound += len(records)\n  1283\t\t\t\tchunksDistilled++\n  1284\t\t\t\tvar actions []factAction\n  1285\t\t\t\tif pipeline == distillPipelineCandidates {\n  1286\t\t\t\t\t// Candidate v1 is fail-conservative: exact fact IDs collapse in\n  1287\t\t\t\t\t// factmerge.Upsert, while every non-identical statement remains a\n  1288\t\t\t\t\t// separate fact. It never asks a model to infer identity or\n  1289\t\t\t\t\t// supersession from a shared taxonomy path.\n  1290\t\t\t\t\tactions = newDistilledFactActions(records)\n  1291\t\t\t\t} else {\n  1292\t\t\t\t\t// Legacy reconciliation remains available unchanged while the\n  1293\t\t\t\t\t// candidate pipeline is evaluated in shadow/opt-in runs.\n  1294\t\t\t\t\treconcileCalled := false\n  1295\t\t\t\t\tcountingReconcileRun := func(ctx context.Context, dir string, args []string, input []byte, timeout time.Duration) (string, error) {\n  1296\t\t\t\t\t\treconcileCalled = true\n  1297\t\t\t\t\t\treturn distillOpts.run(ctx, dir, args, input, timeout)\n  1298\t\t\t\t\t}\n  1299\t\t\t\t\treconcileStarted := time.Now()\n  1300\t\t\t\t\tvar recWarnings []string\n  1301\t\t\t\t\tactions, recWarnings = reconcileChunkCandidates(ctx, countingReconcileRun, reconcileArgs, records, byBranch[branch], repoDir, distillOpts.timeout)\n  1302\t\t\t\t\tif reconcileCalled {\n  1303\t\t\t\t\t\treconcileAgentCalls++\n  1304\t\t\t\t\t\treconcileSeconds += time.Since(reconcileStarted).Seconds()\n  1305\t\t\t\t\t}\n  1306\t\t\t\t\twarnings = append(warnings, recWarnings...)\n  1307\t\t\t\t\t// Preserve the legacy flush cadence: a candidate-bearing chunk\n  1308\t\t\t\t\t// advances the interval even when reconciliation resolves locally.\n  1309\t\t\t\t\tcallsSinceFlush++\n  1310\t\t\t\t}\n  1311\t\t\t\tvar chunkProposals []factProposal\n  1312\t\t\t\tbyBranch[branch], chunkProposals = applyFactActions(byBranch[branch], actions, threshold, now)\n  1313\t\t\t\tproposalsByBranch[branch] = append(proposalsByBranch[branch], chunkProposals...)\n  1314\t\t\t\tdirtyBranches[branch] = true\n  1315\t\t\t\tif err := maybeFlush(); err != nil {\n  1316\t\t\t\t\treturn nil, err\n  1317\t\t\t\t}\n  1318\t\t\t}\n  1319\t\t\tif ps.release != nil {\n  1320\t\t\t\tps.release() // free the work-lookahead slot: chunks fully consumed\n  1321\t\t\t}\n  1322\t\t\t// Only cache a session as distilled when every chunk succeeded, so a\n  1323\t\t\t// session whose agent calls failed is retried on the next run rather\n  1324\t\t\t// than being silently treated as done.\n  1325\t\t\tif !sessionFailed {\n  1326\t\t\t\tif pipeline == distillPipelineCandidates {\n  1327\t\t\t\t\tcurrent := make(map[string]bool, len(ps.chunks))\n  1328\t\t\t\t\tfor _, chunk := range ps.chunks {\n  1329\t\t\t\t\t\tif chunk.DistillTurnID != \"\" {\n  1330\t\t\t\t\t\t\tcurrent[chunk.DistillTurnID] = true\n  1331\t\t\t\t\t\t}\n  1332\t\t\t\t\t}\n  1333\t\t\t\t\tvar removed bool\n  1334\t\t\t\t\tbyBranch[branch], removed = removeMissingDistillTurnAnchors(byBranch[branch], factAnchor{\n  1335\t\t\t\t\t\tSessionID:  session.SessionID,\n  1336\t\t\t\t\t\tTranscript: filepath.ToSlash(session.TranscriptPath),\n  1337\t\t\t\t\t}, current)\n  1338\t\t\t\t\tif removed {\n  1339\t\t\t\t\t\tdirtyBranches[branch] = true\n  1340\t\t\t\t\t}\n  1341\t\t\t\t}\n  1342\t\t\t\tnewCache.Sessions[distillSessionCacheKeyForPipeline(pipeline, branch, session.SessionID)] = ps.fingerprint\n  1343\t\t\t}\n  1344\t\t\treportProgress()\n  1345\t\t}\n  1346\t\tif err := ctx.Err(); err != nil {\n  1347\t\t\treturn nil, err\n  1348\t\t}\n  1349\t\tif agentFailures > 0 && !anyAgentSuccess {\n  1350\t\t\treturn nil, fmt.Errorf(\n  1351\t\t\t\t\"distill aborted after all %d agent calls failed with no successful response; check --agent, --model, authentication, and executable PATH\",\n  1352\t\t\t\tagentFailures,\n  1353\t\t\t)\n  1354\t\t}\n  1355\t\twarnings = capWarnings(warnings, maxDistillWarnings)\n  1356\t\n  1357\t\twriteStarted := time.Now()\n  1358\t\tvar source *factSourceManifest\n  1359\t\terr = withBrainWriteLock(brainDir, func() error {\n  1360\t\t\tif err := flushFactStoresLocked(true); err != nil {\n  1361\t\t\t\treturn err\n  1362\t\t\t}\n  1363\t\t\tif err := writeFactTaxonomy(brainDir, taxonomy); err != nil {\n  1364\t\t\t\treturn err\n  1365\t\t\t}\n  1366\t\n  1367\t\t\t// Summarize the manifest from the whole on-disk store, not just the branches\n  1368\t\t\t// touched this run. A branch-limited (`--branch`) or incremental run only\n  1369\t\t\t// loads a subset into byBranch; folding that subset into the manifest would\n  1370\t\t\t// drop counts/branches/proposals for facts that still exist on other\n  1371\t\t\t// branches. Re-reading the store after writing keeps sources.facts whole.\n  1372\t\t\tallBranches, err := loadAllFactBranches(brainDir)\n  1373\t\t\tif err != nil {\n  1374\t\t\t\treturn err\n  1375\t\t\t}\n  1376\t\t\tbranchNames := make([]string, 0, len(allBranches))\n  1377\t\t\tfor branch := range allBranches {\n  1378\t\t\t\tbranchNames = append(branchNames, branch)\n  1379\t\t\t}\n  1380\t\t\ttotalProposals := countFactProposals(brainDir, branchNames)\n  1381\t\n  1382\t\t\tsource = summarizeFactSource(now, allBranches, chunksScanned, chunksDistilled, totalProposals, warnings)\n  1383\t\t\tsource.CacheHits = cacheHits\n  1384\t\t\tsource.FailedChunks = failedChunks\n  1385\t\t\tsource.PreprocessedBytes = preprocessedBytes\n  1386\t\t\tsource.CandidateBytes = candidateBytes\n  1387\t\t\tsource.Agent = strings.TrimSpace(distillOpts.agent)\n  1388\t\t\tsource.Model = strings.TrimSpace(distillOpts.model)\n  1389\t\t\tsource.Effort = strings.TrimSpace(distillOpts.effort)\n  1390\t\t\tsource.Pipeline = pipeline\n  1391\t\t\tsource.Branch = strings.TrimSpace(distillOpts.branch)\n  1392\t\t\tsource.Force = distillOpts.force\n  1393\t\t\tsource.Jobs = distillRequestedJobs(distillOpts)\n  1394\t\t\tsource.ExtractionJobsCap = distillEffectiveExtractionJobs(extractionAgentCalls, distillOpts)\n  1395\t\t\tsource.MaxChunkBytes = distillMaxChunkBytes(distillOpts)\n  1396\t\t\tsource.Confidence = threshold\n  1397\t\t\tsource.ExtractionCalls = extractionAgentCalls\n  1398\t\t\tsource.ReconcileCalls = reconcileAgentCalls\n  1399\t\t\tsource.TotalAgentCalls = extractionAgentCalls + reconcileAgentCalls\n  1400\t\t\tsource.TokenUsage = usageCollector.summary(source.TotalAgentCalls)\n  1401\t\t\tsource.ExtractionWaitSeconds = extractionSeconds\n  1402\t\t\tsource.ReconcileSeconds = reconcileSeconds\n  1403\t\t\tsource.WriteSeconds = time.Since(writeStarted).Seconds()\n  1404\t\t\tsource.TotalSeconds = time.Since(runStarted).Seconds()\n  1405\t\t\t// Provider work may run for hours. Patch only the facts source while the\n  1406\t\t\t// manifest-leaf lock covers load-through-replace, so a semantic/session/\n  1407\t\t\t// seed writer cannot commit between a stale reload and this publication.\n  1408\t\t\treturn updateBrainManifestAndReadme(brainDir, func(currentManifest *exportManifest) error {\n  1409\t\t\t\tif currentManifest.Sources == nil {\n  1410\t\t\t\t\tcurrentManifest.Sources = &brainSources{}\n  1411\t\t\t\t}\n  1412\t\t\t\t// Manifest schema v3 is decoded strictly by released binaries. Keep\n  1413\t\t\t\t// candidate-only observability in this command's returned summary and\n  1414\t\t\t\t// dry-run report until it has a separately versioned durable leaf; an\n  1415\t\t\t\t// unversioned field addition would make binary rollback impossible.\n  1416\t\t\t\tpersistedSource := *source\n  1417\t\t\t\tpersistedSource.CandidateBytes = 0\n  1418\t\t\t\tpersistedSource.CandidateCards = 0\n  1419\t\t\t\tpersistedSource.CandidateSessions = 0\n  1420\t\t\t\tpersistedSource.CandidatePacks = 0\n  1421\t\t\t\tpersistedSource.CandidatePacksDone = 0\n  1422\t\t\t\tpersistedSource.CandidateMembers = 0\n  1423\t\t\t\tpersistedSource.CandidateCacheHits = 0\n  1424\t\t\t\tpersistedSource.CandidateCacheMisses = 0\n  1425\t\t\t\tpersistedSource.CandidateSplitCalls = 0\n  1426\t\t\t\tpersistedSource.CandidateEmptyResults = 0\n  1427\t\t\t\tpersistedSource.Pipeline = \"\"\n  1428\t\t\t\tpersistedSource.Shadow = false\n  1429\t\t\t\tpersistedSource.ShadowFacts = 0\n  1430\t\t\t\tcurrentManifest.Sources.Facts = &persistedSource\n  1431\t\t\t\tif currentManifest.GeneratedAt.IsZero() {\n  1432\t\t\t\t\tcurrentManifest.GeneratedAt = now\n  1433\t\t\t\t}\n  1434\t\t\t\treturn nil\n  1435\t\t\t})\n     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"crypto/sha256\"\n     6\t\t\"encoding/hex\"\n     7\t\t\"encoding/json\"\n     8\t\t\"errors\"\n     9\t\t\"fmt\"\n    10\t\t\"os\"\n    11\t\t\"path/filepath\"\n    12\t\t\"sort\"\n    13\t\t\"strings\"\n    14\t\t\"time\"\n    15\t\n    16\t\t\"github.com/ashtom/entire-brain/internal/factmerge\"\n    17\t)\n    18\t\n    19\tconst (\n    20\t\tfactsDirName          = \"facts\"\n    21\t\tfactsTaxonomyFileName = \"taxonomy.json\"\n    22\t\tfactsTaxonomyPath     = factsDirName + \"/\" + factsTaxonomyFileName\n    23\t\tfactsFileName         = \"facts.ndjson\"\n    24\t\tfactsMaxPerChunk      = 6 // quality-gate output cap per source chunk\n    25\t\n    26\t\tfactOriginDistilled = \"distilled\"\n    27\t\tfactOriginAuthored  = \"authored\"\n    28\t)\n    29\t\n    30\t// factSourceManifest is recorded under sources.facts in the brain manifest,\n    31\t// parallel to historySourceManifest and the semantic source metadata.\n    32\ttype factSourceManifest struct {\n    33\t\tGeneratedAt           time.Time                 `json:\"generated_at\"`\n    34\t\tTaxonomyPath          string                    `json:\"taxonomy_path\"`\n    35\t\tBranches              []string                  `json:\"branches,omitempty\"`\n    36\t\tFacts                 int                       `json:\"facts\"`\n    37\t\tDistilled             int                       `json:\"distilled\"`\n    38\t\tAuthored              int                       `json:\"authored\"`\n    39\t\tSuperseded            int                       `json:\"superseded\"`\n    40\t\tProposals             int                       `json:\"proposals\"`\n    41\t\tVerified              int                       `json:\"verified\"`\n    42\t\tUnsigned              int                       `json:\"unsigned\"`\n    43\t\tByKind                map[string]int            `json:\"by_kind,omitempty\"`\n    44\t\tChunksScanned         int                       `json:\"chunks_scanned\"`\n    45\t\tChunksDistilled       int                       `json:\"chunks_distilled\"`\n    46\t\tCacheHits             int                       `json:\"cache_hits,omitempty\"`\n    47\t\tFailedChunks          int                       `json:\"failed_chunks,omitempty\"`\n    48\t\tPreprocessedBytes     int64                     `json:\"preprocessed_bytes,omitempty\"`\n    49\t\tCandidateBytes        int64                     `json:\"candidate_bytes,omitempty\"`\n    50\t\tCandidateCards        int                       `json:\"candidate_cards,omitempty\"`\n    51\t\tCandidateSessions     int                       `json:\"candidate_sessions,omitempty\"`\n    52\t\tCandidatePacks        int                       `json:\"candidate_packs,omitempty\"`\n    53\t\tCandidatePacksDone    int                       `json:\"candidate_packs_completed,omitempty\"`\n    54\t\tCandidateMembers      int                       `json:\"candidate_members,omitempty\"`\n    55\t\tCandidateCacheHits    int                       `json:\"candidate_cache_hits,omitempty\"`\n    56\t\tCandidateCacheMisses  int                       `json:\"candidate_cache_misses,omitempty\"`\n    57\t\tCandidateSplitCalls   int                       `json:\"candidate_split_calls,omitempty\"`\n    58\t\tCandidateEmptyResults int                       `json:\"candidate_empty_results,omitempty\"`\n    59\t\tAgent                 string                    `json:\"agent,omitempty\"`\n    60\t\tModel                 string                    `json:\"model,omitempty\"`\n    61\t\tEffort                string                    `json:\"effort,omitempty\"`\n    62\t\tPipeline              string                    `json:\"pipeline,omitempty\"`\n    63\t\tBranch                string                    `json:\"branch,omitempty\"`\n    64\t\tForce                 bool                      `json:\"force,omitempty\"`\n    65\t\tJobs                  int                       `json:\"jobs,omitempty\"`\n    66\t\tExtractionJobsCap     int                       `json:\"extraction_jobs_cap,omitempty\"`\n    67\t\tMaxChunkBytes         int                       `json:\"max_chunk_bytes,omitempty\"`\n    68\t\tConfidence            float64                   `json:\"confidence_threshold,omitempty\"`\n    69\t\tExtractionCalls       int                       `json:\"extraction_agent_calls,omitempty\"`\n    70\t\tReconcileCalls        int                       `json:\"reconcile_agent_calls,omitempty\"`\n    71\t\tTotalAgentCalls       int                       `json:\"total_agent_calls,omitempty\"`\n    72\t\tTokenUsage            *distillTokenUsageSummary `json:\"token_usage,omitempty\"`\n    73\t\t// ExtractionWaitSeconds is the consumer's WAIT on prefetched results, not\n    74\t\t// agent compute: with concurrency > 1, calls completing in the background\n    75\t\t// register ~0s here. Compare total_seconds across --jobs settings for\n    76\t\t// scheduling claims.\n    77\t\tExtractionWaitSeconds float64  `json:\"extraction_wait_seconds,omitempty\"`\n    78\t\tReconcileSeconds      float64  `json:\"reconcile_seconds,omitempty\"`\n    79\t\tWriteSeconds          float64  `json:\"write_seconds,omitempty\"`\n    80\t\tTotalSeconds          float64  `json:\"total_seconds,omitempty\"`\n    81\t\tWarnings              []string `json:\"warnings,omitempty\"`\n    82\t\t// Shadow and ShadowFacts are command-result-only Phase 2 evidence. They\n    83\t\t// are cleared before any schema-v3 manifest publication.\n    84\t\tShadow      bool `json:\"shadow,omitempty\"`\n    85\t\tShadowFacts int  `json:\"shadow_facts,omitempty\"`\n    86\t}\n    87\t\n    88\t// factRecord (factmerge.Record) and factAnchor (factmerge.Anchor) are defined\n    89\t// as type aliases in facts_aliases.go; the durable-fact data model now lives in\n    90\t// internal/factmerge.\n    91\t\n    92\t// factTaxonomy is the active taxonomy snapshot. Paths are validated against\n    93\t// factPathPattern; classification may only invent a new three-level path under\n    94\t// an existing top-level category.\n    95\ttype factTaxonomy struct {\n    96\t\tGeneratedAt time.Time         `json:\"generated_at\"`\n    97\t\tCategories  map[string]string `json:\"categories\"` // top-level -> description\n    98\t\tPaths       []factPathDef     `json:\"paths\"`\n    99\t}\n   100\t\n   101\ttype factPathDef struct {\n   102\t\tPath        string   `json:\"path\"`\n   103\t\tDescription string   `json:\"description\"`\n   104\t\tExamples    []string `json:\"examples,omitempty\"`\n   105\t}\n   106\t\n   107\t// normalizeFactText, factRecordID, validFactPath, and normalizeFactPaths moved\n   108\t// to internal/factmerge (NormalizeText/RecordID/ValidPath/NormalizePaths); the\n   109\t// CLI names are forwarding wrappers in facts_aliases.go.\n   110\t\n   111\t// factTopLevel returns the top-level category of a taxonomy path (the segment\n   112\t// before the first dot), or \"\" if the path is empty.\n   113\tfunc factTopLevel(path string) string {\n   114\t\tif i := strings.IndexByte(path, '.'); i >= 0 {\n   115\t\t\treturn path[:i]\n   116\t\t}\n   117\t\treturn path\n   118\t}\n   119\t\n   120\t// --- on-disk layout -------------------------------------------------------\n   121\t\n   122\t// factsBranchRelDir returns the brain-relative directory holding a branch's\n   123\t// facts. The readable slug alone is not collision-free — distinct branches can\n   124\t// sanitize to the same slug (e.g. \"evis/search\" and \"evis-search\", or \"Main\"\n   125\t// and \"main\") — and two branches sharing a facts file would clobber each other\n   126\t// and break branch isolation. A short hash of the full branch name is appended\n   127\t// so each branch maps to a stable, unique directory while staying greppable.\n   128\tfunc factsBranchRelDir(branch string) string {\n   129\t\tslug := safePathComponent(branch, \"branch\", 80)\n   130\t\tsum := sha256.Sum256([]byte(branch))\n   131\t\treturn filepath.ToSlash(filepath.Join(factsDirName, slug+\"-\"+hex.EncodeToString(sum[:4])))\n   132\t}\n   133\t\n   134\tfunc factsFileRelPath(branch string) string {\n   135\t\treturn filepath.ToSlash(filepath.Join(factsBranchRelDir(branch), factsFileName))\n   136\t}\n   137\t\n   138\t// loadFacts reads a branch's facts.ndjson. A missing file is not an error: it\n   139\t// yields an empty slice so first-run callers do not special-case it. Blank\n   140\t// lines are skipped; a malformed line is a hard error so a corrupt store is\n   141\t// surfaced rather than silently dropping records.\n   142\tfunc loadFacts(brainDir, branch string) ([]factRecord, error) {\n   143\t\tpath := filepath.Join(brainDir, filepath.FromSlash(factsFileRelPath(branch)))\n   144\t\treturn parseFactsFile(path)\n   145\t}\n   146\t\n   147\t// parseFactsFile reads a facts.ndjson file at an absolute path. A missing file\n   148\t// yields an empty slice; a malformed line is a hard error so a corrupt store is\n   149\t// surfaced rather than silently dropping records. The byte-level scan lives in\n   150\t// factmerge.ParseNDJSON; this keeps only the file/path handling and restores the\n   151\t// historical \"parse <file> line N: ...\" message the core cannot know the path\n   152\t// for.\n   153\tfunc parseFactsFile(path string) ([]factRecord, error) {\n   154\t\tf, err := os.Open(path)\n   155\t\tif err != nil {\n   156\t\t\tif os.IsNotExist(err) {\n   157\t\t\t\treturn nil, nil\n   158\t\t\t}\n   159\t\t\treturn nil, err\n   160\t\t}\n   161\t\tdefer f.Close()\n   162\t\trecords, err := factmerge.ParseNDJSON(f)\n   163\t\tif err != nil {\n   164\t\t\tvar perr *factmerge.ParseError\n   165\t\t\tif errors.As(err, &perr) {\n   166\t\t\t\treturn nil, fmt.Errorf(\"parse %s line %d: %w\", filepath.Base(path), perr.Line, perr.Err)\n   167\t\t\t}\n   168\t\t\treturn nil, err\n   169\t\t}\n   170\t\treturn records, nil\n   171\t}\n   172\t\n   173\t// writeFacts persists a branch's facts as newline-delimited JSON, one record\n   174\t// per line, sorted deterministically so the file is stable across rebuilds and\n   175\t// diffs cleanly. The branch directory is created if needed. The byte-level\n   176\t// sort+marshal lives in factmerge.WriteNDJSON; this keeps the atomic,\n   177\t// symlink-rejecting disk write in the CLI.\n   178\tfunc writeFacts(brainDir, branch string, records []factRecord) error {\n   179\t\tvar buf bytes.Buffer\n   180\t\tif err := factmerge.WriteNDJSON(&buf, records); err != nil {\n   181\t\t\treturn err\n   182\t\t}\n   183\t\treturn writeBrainRelativeFileAtomic(brainDir, factsFileRelPath(branch), buf.Bytes(), 0o600)\n   184\t}\n   185\t\n   186\t// --- taxonomy -------------------------------------------------------------\n   187\t\n   188\t// defaultFactTaxonomy is the shipped baseline taxonomy. The top-level\n   189\t// categories here are fixed in Phase A; distillation may invent a new\n   190\t// three-level path only under one of these categories. The brain regenerates\n   191\t// taxonomy.json from this default on refresh.\n   192\tfunc defaultFactTaxonomy(now time.Time) factTaxonomy {\n   193\t\treturn factTaxonomy{\n   194\t\t\tGeneratedAt: now,\n   195\t\t\tCategories: map[string]string{\n   196\t\t\t\t\"preferences\":  \"How the user wants to work and how code should be written.\",\n   197\t\t\t\t\"architecture\": \"Resolved design, boundary, and data-flow decisions and their rationale.\",\n   198\t\t\t\t\"project\":      \"Stack, tooling, CI/CD, ownership, and standing project facts.\",\n   199\t\t\t\t\"workflow\":     \"Branching, testing, review, and release process rules.\",\n   200\t\t\t\t\"constraints\":  \"Non-obvious invariants, gotchas, and hard constraints.\",\n   201\t\t\t},\n   202\t\t\tPaths: []factPathDef{\n   203\t\t\t\t{Path: \"preferences.coding.style\", Description: \"Stated code-style preferences.\", Examples: []string{\"prefers table-driven tests\"}},\n   204\t\t\t\t{Path: \"preferences.workflow.general\", Description: \"How the user prefers to work day to day.\"},\n   205\t\t\t\t{Path: \"architecture.boundaries.rationale\", Description: \"Why a module or package boundary exists.\"},\n   206\t\t\t\t{Path: \"architecture.data.flow\", Description: \"How data moves through the system.\"},\n   207\t\t\t\t{Path: \"project.tooling.stack\", Description: \"Languages, frameworks, and tools the project uses.\"},\n   208\t\t\t\t{Path: \"project.ci_cd.pipeline\", Description: \"Build, test, and deploy pipeline facts.\"},\n   209\t\t\t\t{Path: \"workflow.branching.rules\", Description: \"Branching and merge conventions.\"},\n   210\t\t\t\t{Path: \"workflow.testing.rules\", Description: \"How and when tests must be run.\"},\n     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"context\"\n     5\t\t\"encoding/json\"\n     6\t\t\"fmt\"\n     7\t\t\"math\"\n     8\t\t\"os\"\n     9\t\t\"path/filepath\"\n    10\t\t\"sort\"\n    11\t\t\"strconv\"\n    12\t\t\"strings\"\n    13\t\t\"time\"\n    14\t)\n    15\t\n    16\tconst factsProposalsFileName = \"proposals.ndjson\"\n    17\t\n    18\tfunc factsProposalsRelPath(branch string) string {\n    19\t\treturn filepath.ToSlash(filepath.Join(factsBranchRelDir(branch), factsProposalsFileName))\n    20\t}\n    21\t\n    22\t// loadFactProposals reads a branch's pending proposals; a missing file yields\n    23\t// none. A malformed line is a hard error so a corrupt queue is surfaced.\n    24\tfunc loadFactProposals(brainDir, branch string) ([]factProposal, error) {\n    25\t\tpath := filepath.Join(brainDir, filepath.FromSlash(factsProposalsRelPath(branch)))\n    26\t\tdata, err := os.ReadFile(path)\n    27\t\tif err != nil {\n    28\t\t\tif os.IsNotExist(err) {\n    29\t\t\t\treturn nil, nil\n    30\t\t\t}\n    31\t\t\treturn nil, err\n    32\t\t}\n    33\t\treturn parseFactProposals(data, factsProposalsRelPath(branch))\n    34\t}\n    35\t\n    36\tfunc parseFactProposals(data []byte, displayPath string) ([]factProposal, error) {\n    37\t\tvar proposals []factProposal\n    38\t\tfor i, line := range strings.Split(string(data), \"\\n\") {\n    39\t\t\tline = strings.TrimSpace(line)\n    40\t\t\tif line == \"\" {\n    41\t\t\t\tcontinue\n    42\t\t\t}\n    43\t\t\tvar p factProposal\n    44\t\t\tif err := json.Unmarshal([]byte(line), &p); err != nil {\n    45\t\t\t\treturn nil, fmt.Errorf(\"parse %s line %d: %w\", displayPath, i+1, err)\n    46\t\t\t}\n    47\t\t\tproposals = append(proposals, p)\n    48\t\t}\n    49\t\treturn proposals, nil\n    50\t}\n    51\t\n    52\t// writeFactProposals persists a branch's pending proposals, deduplicated by\n    53\t// (action, candidate, target) and sorted for a stable file. An empty set\n    54\t// removes the file so a fully-resolved branch leaves no stale queue.\n    55\tfunc writeFactProposals(brainDir, branch string, proposals []factProposal) error {\n    56\t\tcanonical := append([]factProposal(nil), proposals...)\n    57\t\tfor i := range canonical {\n    58\t\t\tcanonical[i].Branch = branch\n    59\t\t}\n    60\t\treturn writeFactProposalsAtRel(brainDir, factsProposalsRelPath(branch), canonical)\n    61\t}\n    62\t\n    63\tfunc writeFactProposalsAtRel(brainDir, rel string, proposals []factProposal) error {\n    64\t\tdeduped := dedupeProposals(proposals)\n    65\t\tif len(deduped) == 0 {\n    66\t\t\treturn removeBrainRelativeFile(brainDir, rel)\n    67\t\t}\n    68\t\tvar buf strings.Builder\n    69\t\tfor _, p := range deduped {\n    70\t\t\tdata, err := json.Marshal(p)\n    71\t\t\tif err != nil {\n    72\t\t\t\treturn err\n    73\t\t\t}\n    74\t\t\tbuf.Write(data)\n    75\t\t\tbuf.WriteByte('\\n')\n    76\t\t}\n    77\t\treturn writeBrainRelativeFileAtomic(brainDir, rel, []byte(buf.String()), 0o600)\n    78\t}\n    79\t\n    80\t// clearDistillOwnedLegacyProposalStore cleans a pre-branch-ownership proposal\n    81\t// file in place. Member-attributed sync proposals survive because distillation\n    82\t// does not own or regenerate them.\n    83\tfunc clearDistillOwnedLegacyProposalStore(brainDir, rel string) error {\n    84\t\tdata, present, err := readMemoryStateFile(brainDir, rel, \"legacy fact proposal store\", defaultMaxReadBytes)\n    85\t\tif err != nil || !present {\n    86\t\t\treturn err\n    87\t\t}\n    88\t\tproposals, err := parseFactProposals(data, rel)\n    89\t\tif err != nil {\n    90\t\t\treturn err\n    91\t\t}\n    92\t\tkept := proposals[:0]\n    93\t\tfor _, proposal := range proposals {\n    94\t\t\tif strings.TrimSpace(proposal.ProposedBy) != \"\" {\n    95\t\t\t\tkept = append(kept, proposal)\n    96\t\t\t}\n    97\t\t}\n    98\t\treturn writeFactProposalsAtRel(brainDir, rel, kept)\n    99\t}\n   100\t\n   101\tfunc dedupeProposals(proposals []factProposal) []factProposal {\n   102\t\tseen := make(map[string]struct{}, len(proposals))\n   103\t\tout := make([]factProposal, 0, len(proposals))\n   104\t\tfor _, p := range proposals {\n   105\t\t\tkey := p.Action + \"\\x00\" + p.CandidateID + \"\\x00\" + p.TargetID\n   106\t\t\tif _, ok := seen[key]; ok {\n   107\t\t\t\tcontinue\n   108\t\t\t}\n   109\t\t\tseen[key] = struct{}{}\n   110\t\t\tout = append(out, p)\n   111\t\t}\n   112\t\tsort.SliceStable(out, func(i, j int) bool {\n   113\t\t\tif out[i].TargetID != out[j].TargetID {\n   114\t\t\t\treturn out[i].TargetID < out[j].TargetID\n   115\t\t\t}\n   116\t\t\treturn out[i].CandidateID < out[j].CandidateID\n   117\t\t})\n   118\t\treturn out\n   119\t}\n   120\t\n   121\tconst (\n   122\t\t// maxReconcileExisting bounds how many existing active facts at a\n   123\t\t// candidate's paths are shown to the agent, keeping the reconcile prompt\n   124\t\t// bounded even on busy paths. When more exist, the most recently updated\n   125\t\t// are shown and the cap is reported as a warning (no silent truncation).\n   126\t\tmaxReconcileExisting = 50\n   127\t)\n   128\t\n   129\t// reconcilePrompt is the static system prompt for the reconcile pass. The\n   130\t// dynamic candidate/existing lists are supplied on stdin (see reconcileInput).\n   260\t// isNumericToken reports whether a token parses as a finite float, used to tell\n   261\t// a trailing confidence value apart from a \"-\" placeholder or missing field.\n   262\t// NaN/±Inf are rejected: ParseFloat accepts them, but a NaN confidence would\n   263\t// silently bypass the low-confidence gate downstream (every comparison with NaN\n   264\t// is false), so they must not be treated as a numeric confidence.\n   265\tfunc isNumericToken(token string) bool {\n   266\t\tvalue, err := strconv.ParseFloat(token, 64)\n   267\t\treturn err == nil && !math.IsNaN(value) && !math.IsInf(value, 0)\n   268\t}\n   269\t\n   270\t// parseConfidence reads a confidence token, clamped to [0,1]; unparseable\n   271\t// values (including NaN/±Inf, which would otherwise slip past the [0,1] clamp\n   272\t// and the auto-apply threshold) default to 0 so an unreadable confidence is\n   273\t// treated as low and queued for review rather than auto-applied.\n   274\tfunc parseConfidence(token string) float64 {\n   275\t\tvalue, err := strconv.ParseFloat(token, 64)\n   276\t\tif err != nil || math.IsNaN(value) || math.IsInf(value, 0) {\n   277\t\t\treturn 0\n   278\t\t}\n   279\t\tif value < 0 {\n   280\t\t\treturn 0\n   281\t\t}\n   282\t\tif value > 1 {\n   283\t\t\treturn 1\n   284\t\t}\n   285\t\treturn value\n   286\t}\n   287\t\n   288\t// activeFactsAtPaths returns the active facts whose paths intersect the given\n   289\t// path set, most-recently-updated first, capped at maxReconcileExisting. The\n   290\t// boolean reports whether the cap dropped any facts.\n   291\tfunc activeFactsAtPaths(records []factRecord, paths []string) ([]factRecord, bool) {\n   292\t\twant := make(map[string]struct{}, len(paths))\n   293\t\tfor _, p := range paths {\n   294\t\t\twant[p] = struct{}{}\n   295\t\t}\n   296\t\tvar matched []factRecord\n   297\t\tfor _, record := range records {\n   298\t\t\tif record.Status != factStatusActive {\n   299\t\t\t\tcontinue\n   300\t\t\t}\n   301\t\t\tfor _, p := range record.Paths {\n   302\t\t\t\tif _, ok := want[p]; ok {\n   303\t\t\t\t\tmatched = append(matched, record)\n   304\t\t\t\t\tbreak\n   305\t\t\t\t}\n   306\t\t\t}\n   307\t\t}\n   308\t\tsort.SliceStable(matched, func(i, j int) bool {\n   309\t\t\tif !matched[i].UpdatedAt.Equal(matched[j].UpdatedAt) {\n   310\t\t\t\treturn matched[i].UpdatedAt.After(matched[j].UpdatedAt)\n   311\t\t\t}\n   312\t\t\treturn matched[i].ID < matched[j].ID\n   313\t\t})\n   314\t\tif len(matched) > maxReconcileExisting {\n   315\t\t\treturn matched[:maxReconcileExisting], true\n   316\t\t}\n   317\t\treturn matched, false\n   318\t}\n   319\t\n   320\t// candidatePathSet returns the sorted union of paths across the candidates.\n   321\tfunc candidatePathSet(candidates []factRecord) []string {\n   322\t\tseen := map[string]struct{}{}\n   323\t\tfor _, c := range candidates {\n   324\t\t\tfor _, p := range c.Paths {\n   325\t\t\t\tseen[p] = struct{}{}\n   326\t\t\t}\n   327\t\t}\n   328\t\tpaths := make([]string, 0, len(seen))\n   329\t\tfor p := range seen {\n   330\t\t\tpaths = append(paths, p)\n   331\t\t}\n   332\t\tsort.Strings(paths)\n   333\t\treturn paths\n   334\t}\n   335\t\n   336\t// newDistilledFactActions is the candidate pipeline's conservative settlement\n   337\t// boundary. Every extracted record is applied as new; factmerge.Upsert still\n   338\t// collapses exact content IDs and unions provenance, but no fuzzy relationship\n   339\t// can silently merge or supersede an unrelated fact. Later candidate-pipeline\n   340\t// versions may enqueue evidence-backed ambiguous pairs for review, but automatic\n   341\t// supersession must never be inferred from taxonomy overlap alone.\n   342\tfunc newDistilledFactActions(candidates []factRecord) []factAction {\n   343\t\tactions := make([]factAction, len(candidates))\n   344\t\tfor i, candidate := range candidates {\n   345\t\t\tactions[i] = factAction{Kind: factActionNew, Confidence: 1, Candidate: candidate}\n   346\t\t}\n   347\t\treturn actions\n   348\t}\n   349\t\n   350\t// removeRelocatedDistillAnchors replaces the entire prior materialization for\n   351\t// the same stable candidate trigger before fresh records are applied. This\n   352\t// removes stale line anchors after transcript layout shifts and stale facts\n   353\t// after a crash/retry produces different wording. Facts corroborated by another\n   354\t// trigger/session retain those independent anchors; a distilled fact that loses\n   355\t// its final anchor is dropped.\n   356\tfunc removeRelocatedDistillAnchors(records []factRecord, source factAnchor) ([]factRecord, bool) {\n   357\t\tif source.SessionID == \"\" || source.DistillTurnID == \"\" {\n   358\t\t\treturn records, false\n   359\t\t}\n   360\t\tout := records[:0]\n   361\t\tchanged := false\n   362\t\tfor index := range records {\n   363\t\t\toriginalAnchors := len(records[index].Provenance)\n   364\t\t\tkept := records[index].Provenance[:0]\n   365\t\t\tfor _, anchor := range records[index].Provenance {\n   366\t\t\t\tif anchor.SessionID != source.SessionID || anchor.DistillTurnID != source.DistillTurnID {\n   367\t\t\t\t\tkept = append(kept, anchor)\n   368\t\t\t\t} else {\n   369\t\t\t\t\tchanged = true\n   370\t\t\t\t}\n   371\t\t\t}\n   372\t\t\trecords[index].Provenance = kept\n   373\t\t\tif originalAnchors > 0 && len(kept) == 0 && records[index].Origin == factOriginDistilled {\n   374\t\t\t\tcontinue\n   375\t\t\t}\n   376\t\t\tout = append(out, records[index])\n   377\t\t}\n   378\t\treturn out, changed\n   379\t}\n   380\t\n   381\tfunc removeMissingDistillTurnAnchors(records []factRecord, source factAnchor, current map[string]bool) ([]factRecord, bool) {\n   382\t\tif source.SessionID == \"\" {\n   383\t\t\treturn records, false\n   384\t\t}\n   385\t\tout := records[:0]\n   386\t\tchanged := false\n   387\t\tfor index := range records {\n   388\t\t\toriginalAnchors := len(records[index].Provenance)\n   389\t\t\tkept := records[index].Provenance[:0]\n   390\t\t\tfor _, anchor := range records[index].Provenance {\n   391\t\t\t\tstale := anchor.SessionID == source.SessionID && anchor.DistillTurnID != \"\" && !current[anchor.DistillTurnID]\n   392\t\t\t\tif stale {\n   393\t\t\t\t\tchanged = true\n   394\t\t\t\t\tcontinue\n   395\t\t\t\t}\n   396\t\t\t\tkept = append(kept, anchor)\n   397\t\t\t}\n   398\t\t\trecords[index].Provenance = kept\n   399\t\t\tif originalAnchors > 0 && len(kept) == 0 && records[index].Origin == factOriginDistilled {\n   400\t\t\t\tcontinue\n   401\t\t\t}\n   402\t\t\tout = append(out, records[index])\n   403\t\t}\n   404\t\treturn out, changed\n   405\t}\n   406\t\n   407\t// reconcileChunkCandidates resolves a chunk's candidates against the current\n   408\t// active set: when no existing facts share the candidates' paths, every\n   409\t// candidate is trivially `new` (no agent call); otherwise the agent decides.\n   410\t// An agent error falls back to treating all candidates as `new` so facts are\n","exit_code":0,"duration":{"secs":0,"nanos":7958},"formatted_output":"Warning: truncated output (original token count: 10171)\nTotal output lines: 847\n\n  1080\t\t\t\t\t\t}\n  1081\t\t\t\t\t}\n  1082\t\t\t\t} else {\n  1083\t\t\t\t\tprior = loadedProposals\n  1084\t\t\t\t}\n  1085\t\t\t\tmerged := dedupeProposals(append(prior, proposalsByBranch[branch]...))\n  1086\t\t\t\tif err := writeFactProposals(brainDir, branch, merged); err != nil {\n  1087\t\t\t\t\treturn err\n  1088\t\t\t\t}\n  1089\t\t\t\t// A force run keeps branches dirty between mid-run flushes so the\n  1090\t\t\t\t// final flush always rewrites them — that write is what drops the\n  1091\t\t\t\t// prior proposal backlog. Otherwise the branch is clean until new\n  1092\t\t\t\t// fact actions touch it.\n  1093\t\t\t\tif final || !distillOpts.force {\n  1094\t\t\t\t\tdelete(dirtyBranches, branch)\n  1095\t\t\t\t}\n  1096\t\t\t}\n  1097\t\t\tif final && distillOpts.force {\n  1098\t\t\t\tfor _, rel := range forceScope.LegacyProposalRels {\n  1099\t\t\t\t\tif err := clearDistillOwnedLegacyProposalStore(brainDir, rel); err != nil {\n  1100\t\t\t\t\t\treturn err\n  1101\t\t\t\t\t}\n  1102\t\t\t\t}\n  1103\t\t\t}\n  1104\t\t\tcache := newCache\n  1105\t\t\tif !final && !distillOpts.force {\n  1106\t\t\t\tcache = distillCache{Version: distillCacheVersion, Sessions: make(map[string]string, len(prevCache.Sessions)+len(newCache.Sessions))}\n  1107\t\t\t\tmaps.Copy(cache.Sessions, prevCache.Sessions)\n  1108\t\t\t\tmaps.Copy(cache.Sessions, newCache.Sessions)\n  1109\t\t\t}\n  1110\t\t\treturn saveDistillCache(brainDir, cache)\n  1111\t\t}\n  1112\t\tflushFactStores := func(final bool) error {\n  1113\t\t\treturn withBrainWriteLock(brainDir, func() error {\n  1114\t\t\t\treturn flushFactStoresLocked(final)\n  1115\t\t\t})\n  1116\t\t}\n  1117\t\tflushInterval := distillOpts.flushEvery\n  1118\t\tif flushInterval <= 0 {\n  1119\t\t\tflushInterval = distillFlushCallInterval\n  1120\t\t}\n  1121\t\tcallsSinceFlush := 0\n  1122\t\tmaybeFlush := func() error {\n  1123\t\t\tif callsSinceFlush < flushInterval {\n  1124\t\t\t\treturn nil\n  1125\t\t\t}\n  1126\t\t\t// Reset even on failure so a persistent write error is retried once per\n  1127\t\t\t// interval, not on every call.\n  1128\t\t\tcallsSinceFlush = 0\n  1129\t\t\tif err := flushFactStores(false); err != nil {\n  1130\t\t\t\tif errors.Is(err, errDistillFactStoreChanged) {\n  1131\t\t\t\t\treturn err\n  1132\t\t\t\t}\n  1133\t\t\t\t// Non-fatal: a mid-run flush only narrows the loss window, and\n  1134\t\t\t\t// aborting an hours-long run over a transient write error would lose\n  1135\t\t\t\t// far more than the flush protects. Failed branches stay dirty, so\n  1136\t\t\t\t// the next interval (and the final flush) retries them.\n  1137\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"mid-run flush failed (will retry): %v\", err))\n  1138\t\t\t}\n  1139\t\t\treturn nil\n  1140\t\t}\n  1141\t\n  1142\t\t// Session pipeline: a producer goroutine prepares sessions ahead —\n  1143\t\t// transcript read, preprocessing, fingerprint/cache check, chunking — and\n  1144\t\t// dispatches chunk agent calls into one pool shared ACROSS sessions (see\n  1145\t\t// startSessionPrefetch), while this loop consumes results strictly in\n  1146\t\t// chronological order, so reconcile and fact application keep their exact\n  1147\t\t// serial semantics. Canceling pipeCtx (deferred; covers the abort return\n  1148\t\t// too) stops preparation, dispatch, and in-flight agent calls.\n  1149\t\tpipeCtx, pipeCancel := context.WithCancel(ctx)\n  1150\t\tprefetch := startSessionPrefetch(pipeCtx, brainDir, repoDir, args, sessions, prevCache, distillOpts, resolveBranch)\n  1151\t\tdefer func() {\n  1152\t\t\tpipeCancel()\n  1153\t\t\tprefetch.wait()\n  1154\t\t}()\n  1155\t\tfor ps := range prefetch.Sessions {\n  1156\t\t\tsession, branch := ps.session, ps.branch\n  1157\t\t\tif ps.skip {\n  1158\t\t\t\t// Carry the session's cache entry through unchanged: the final flush\n  1159\t\t\t\t// persists newCache only, so dropping filtered sessions here would\n  1160\t\t\t\t// make the next unfiltered run re-distill every other branch (or\n  1161\t\t\t\t// session) from scratch. (The fingerprint-match skip below does the\n  1162\t\t\t\t// same.)\n  1163\t\t\t\tcacheKey := distillSessionCacheKeyForPipeline(pipeline, branch, session.SessionID)\n  1164\t\t\t\tif prev, ok := prevCache.Sessions[cacheKey]; ok {\n  1165\t\t\t\t\tnewCache.Sessions[cacheKey] = prev\n  1166\t\t\t\t} else if !distillOpts.force {\n  1167\t\t\t\t\tprev, ok := prevCache.Sessions[session.SessionID]\n  1168\t\t\t\t\tif !ok {\n  1169\t\t\t\t\t\tcontinue\n  1170\t\t\t\t\t}\n  1171\t\t\t\t\t// A legacy entry stays under its legacy key (and formula) until\n  1172\t\t\t\t\t// its session is actually visited and grandfathered — copying it\n  1173\t\t\t\t\t// under the new key would make it permanently unmatchable.\n  1174\t\t\t\t\tnewCache.Sessions[session.SessionID] = prev\n  1175\t\t\t\t}\n  1176\t\t\t\tcontinue\n  1177\t\t\t}\n  1178\t\t\tif ps.readErr != nil {\n  1179\t\t\t\tpipeCancel()\n  1180\t\t\t\treturn nil, fmt.Errorf(\"read canonical transcript %s: %w\", filepath.ToSlash(session.TranscriptPath), ps.readErr)\n  1181\t\t\t}\n  1182\t\t\tensureBranch(branch)\n  1183\t\n  1184\t\t\tsessionsDone++\n  1185\t\t\t// Report once per session, at every exit path, so the running fact count\n  1186\t\t\t// includes the session just processed (an emit at session start would lag\n  1187\t\t\t// by one session and always show 0 for a single-session run).\n  1188\t\t\treportProgress := func() {\n  1189\t\t\t\tif distillOpts.progress != nil {\n  1190\t\t\t\t\tdistillOpts.progress(distillProgress{SessionsDone: sessionsDone, SessionsTotal: totalSessions, Branch: branch, Facts: factsFound})\n  1191\t\t\t\t}\n  1192\t\t\t}\n  1193\t\t\tpreprocessedBytes += int64(ps.preBytes)\n  1194\t\t\tcandidateBytes += int64(ps.candidateBytes)\n  1195\t\t\tif ps.cached {\n  1196\t\t\t\tcacheHits++\n  1197\t\t\t\tnewCache.Sessions[distillSessionCacheKeyForPipeline(pipeline, branch, session.SessionID)] = ps.fingerprint // unchanged; retain in cache and keep existing facts\n  1198\t\t\t\treportProgress()\n  1199\t\t\t\tcontinue\n  1200\t\t\t}\n  1201\t\n  1202\t\t\tsessionFailed := false\n  1203\t\t\tfor chunkIdx, chunk := range ps.chunks {\n  1204\t\t\t\tchunksScanned++\n  1205\t\t\t\tanchor := factAnchor{\n  1206\t\t\t\t\tSessionID:    session.SessionID,\n  1207\t\t\t\t\tCheckpointID: session.LatestCheckpoint,\n  1208\t\t\t\t\tTranscript:   filepath.ToSlash(session.TranscriptPath),\n  1209\t\t\t\t\tLine:         chunk.StartLine,\n  1210\t\t\t\t}\n  1211\t\t\t\tif pipeline == distillPipelineCandidates {\n  1212\t\t\t\t\tanchor.EndLine = chunk.EndLine\n  1213\t\t\t\t\tanchor.DistillTurnID = chunk.DistillTurnID\n  1214\t\t\t\t}\n  1215\t\t\t\textractionStarted := time.Now()\n  1216\t\t\t\tout, runErr := ps.result(chunkIdx)\n  1217\t\t\t\textractionSeconds += time.Since(extractionStarted).Seconds()\n  1218\t\t\t\textractionAgentCalls++\n  1219\t\t\t\tcallsSinceFlush++\n  1220\t\t\t\tif runErr != nil {\n  1221\t\t\t\t\tif pipeline == distillPipelineCandidates {\n  1222\t\t\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"candidate extraction failed for %s:%d\", session.SessionID, chunk.StartLine))\n  1223\t\t\t\t\t} else {\n  1224\t\t\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"agent failed on %s:%d: %v\", session.SessionID, chunk.StartLine, runErr))\n  1225\t\t\t\t\t}\n  1226\t\t\t\t\tsessionFailed = true\n  1227\t\t\t\t\tfailedChunks++\n  1228\t\t\t\t\tagentFailures++\n  1229\t\t\t\t\t// Fail fast on a misconfiguration: nothing has distilled yet and the\n  1230\t\t\t\t\t// agent keeps failing, so every call is almost certainly erroring the\n  1231\t\t\t\t\t// same way (bad --model, missing agent, auth). Abort with the agent's\n  1232\t\t\t\t\t// own error instead of churning through every remaining session.\n  1233\t\t\t\t\tif !anyAgentSuccess && agentFailures >= distillAgentAbortThreshold {\n  1234\t\t\t\t\t\tif pipeline == distillPipelineCandidates {\n  1235\t\t\t\t\t\t\treturn nil, fmt.Errorf(\"candidate distill aborted after %d agent failures with no valid response; check --agent, --model, authentication, and executable PATH\", agentFailures)\n  1236\t\t\t\t\t\t}\n  1237\t\t\t\t\t\treturn nil, fmt.Errorf(\"distill aborted after %d agent failures with no facts distilled — check --agent and --model. Last error: %v\", agentFailures, runErr)\n  1238\t\t\t\t\t}\n  1239\t\t\t\t\t// Flush on the failure path too: a long failure streak (rate\n  1240\t\t\t\t\t// limiting, timeouts) is exactly when a run tends to get killed,\n  1241\t\t\t\t\t// and skipping the flush here would leave pre-streak facts\n  1242\t\t\t\t\t// unpersisted for the streak's entire duration.\n  1243\t\t\t\t\tif err := maybeFlush(); err != nil {\n  1244\t\t\t\t\t\treturn nil, err\n  1245\t\t\t\t\t}\n  1246\t\t\t\t\tcontinue\n  1247\t\t\t\t}\n  1248\t\t\t\trecords, chunkWarnings := distilledFactsFromOutput(out, taxonomy, anchor, branch, now)\n  1249\t\t\t\t// Sharpen provenance where the entity index can place the fact's\n  1250\t\t\t\t// locus; a no-op (and never an error) when the index is absent.\n  1251\t\t\t\trecords = applyEntityProvenance(records, distillOpts.entityProvenance)\n  1252\t\t\t\tif pipeline == distillPipelineCandidates {\n  1253\t\t\t\t\tif !candidateDistillOutputIsProtocolComplete(out) || len(chunkWarnings) > 0 {\n  1254\t\t\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"candidate output at %s:%d violated the extraction protocol\", session.SessionID, chunk.StartLine))\n  1255\t\t\t\t\t\tsessionFailed = true\n  1256\t\t\t\t\t\tfailedChunks++\n  1257\t\t\t\t\t\tagentFailures++\n  1258\t\t\t\t\t\tif !anyAgentSuccess && agentFailures >= distillAgentAbortThreshold {\n  1259\t\t\t\t\t\t\treturn nil, fmt.Errorf(\"candidate distill aborted after %d invalid agent responses with no protocol-valid response; check --agent and --model\", agentFailures)\n  1260\t\t\t\t\t\t}\n  1261\t\t\t\t\t\tif err := maybeFlush(); err != nil {\n  1262\t\t\t\t\t\t\treturn nil, err\n  1263\t\t\t\t\t\t}\n  1264\t\t\t\t\t\tcontinue\n  1265\t\t\t\t\t}\n  1266\t\t\t\t\tanyAgentSuccess = true\n  1267\t\t\t\t\tvar removed bool\n  1268\t\t\t\t\tbyBranch[branch], removed = removeRelocatedDistillAnchors(byBranch[branch], anchor)\n  1269\t\t\t\t\tif removed {\n  1270\t\t\t\t\t\tdirtyBranches[branch] = true\n  1271\t\t\t\t\t}\n  1272\t\t\t\t} else {\n  1273\t\t\t\t\tanyAgentSuccess = true\n  1274\t\t\t\t\twarnings = append(warnings, chunkWarnings...)\n  1275\t\t\t\t}\n  1276\t\t\t\tif len(records) == 0 {\n  1277\t\t\t\t\tif err := maybeFlush(); err != nil {\n  1278\t\t\t\t\t\treturn nil, err\n  1279\t\t\t\t\t}\n  1280\t\t\t\t\tcontinue\n  1281\t\t\t\t}\n  1282\t\t\t\tfactsFound += len(records)\n  1283\t\t\t\tchunksDistilled++\n  1284\t\t\t\tvar actions []factAction\n  1285\t\t\t\tif pipeline == distillPipelineCandidates {\n  1286\t\t\t\t\t// Candidate v1 is fail-conservative: exact fact IDs collapse in\n  1287\t\t\t\t\t// factmerge.Upsert, while every non-identical statement remains a\n  1288\t\t\t\t\t// separate fact. It never asks a model to infer identity or\n  1289\t\t\t\t\t// supersession from a shared taxonomy path.\n  1290\t\t\t\t\tactions = newDistilledFactActions(records)\n  1291\t\t\t\t} else {\n  1292\t\t\t\t\t// Legacy reconciliation remains available unchanged while the\n  1293\t\t\t\t\t// candidate pipeline is evaluated in shadow/opt-in runs.\n  1294\t\t\t\t\treconcileCalled := false\n  1295\t\t\t\t\tcountingReconcileRun := func(ctx context.Context, dir string, args []string, input []byte, timeout time.Duration) (string, error) {\n  1296\t\t\t\t\t\treconcileCalled = true\n  1297\t\t\t\t\t\treturn distillOpts.run(ctx, dir, args, input, timeout)\n  1298\t\t\t\t\t}\n  1299\t\t\t\t\treconcileStarted := time.Now()\n  1300\t\t\t\t\tvar recWarnings []string\n  1301\t\t\t\t\tactions, recWarnings = reconcileChunkCandidates(ctx, countingReconcileRun, reconcileArgs, records, byBranch[branch], repoDir, distillOpts.timeout)\n  1302\t\t\t\t\tif reconcileCalled {\n  1303\t\t\t\t\t\treconcileAgentCalls++\n  1304\t\t\t\t\t\treconcileSeconds += time.Since(reconcileStarted).Seconds()\n  1305\t\t\t\t\t}\n  1306\t\t\t\t\twarnings = append(warnings, recWarnings...)\n  1307\t\t\t\t\t// Preserve the legacy flush cadence: a candidate-bearing chunk\n  1308\t\t\t\t\t// advances the interval even when reconciliation resolves locally.\n  1309\t\t\t\t\tcallsSinceFlush++\n  1310\t\t\t\t}\n  1311\t\t\t\tvar chunkProposals []factProposal\n  1312\t\t\t\tbyBranch[branch], chunkProposals = applyFactActions(byBranch[branch], actions, threshold, now)\n  1313\t\t\t\tproposalsByBranch[branch] = append(proposalsByBranch[branch], chunkProposals...)\n  1314\t\t\t\tdirtyBranches[branch] = true\n  1315\t\t\t\tif err := maybeFlush(); err != nil {\n  1316\t\t\t\t\treturn nil, err\n  1317\t\t\t\t}\n  1318\t\t\t}\n  1319\t\t\tif ps.release != nil {\n  1320\t\t\t\tps.release() // free the work-lookahead slot: chunks fully consumed\n  1321\t\t\t}\n  1322\t\t\t// Only cache a session as distilled when every chunk succeeded, so a\n  1323\t\t\t// session whose agent calls failed is retried on the next run rather\n  1324\t\t\t// than being silently treated as done.\n  1325\t\t\tif !sessionFailed {\n  1326\t\t\t\tif pipeline == distillPipelineCandidates {\n  1327\t\t\t\t\tcurrent := make(map[string]bool, len(ps.chunks))\n  1328\t\t\t\t\tfor _, chunk := range ps.chunks {\n  1329\t\t\t\t\t\tif chunk.DistillTurnID != \"\" {\n  1330\t\t\t\t\t\t\tcurrent[chunk.DistillTurnID] = true\n  1331\t\t\t\t\t\t}\n  1332\t\t\t\t\t}\n  1333\t\t\t\t\tvar removed bool\n  1334\t\t\t\t\tbyBranch[branch], removed = removeMissingDistillTurnAnchors(byBranch[branch], factAnchor{\n  1335\t\t\t\t\t\tSessionID:  session.SessionID,\n  1336\t\t\t\t\t\tTranscript: filepath.ToSlash(session.TranscriptPath),\n  1337\t\t\t\t\t}, current)\n  1338\t\t\t\t\tif removed {\n  1339\t\t\t\t\t\tdirtyBranches[branch] = true\n  1340\t\t\t\t\t}\n  1341\t\t\t\t}\n  1342\t\t\t\tnewCache.Sessions[distillSessionCacheKeyForPipeline(pipeline, branch, session.SessionID)] = ps.fingerprint\n  1343\t\t\t}\n  1344\t\t\treportProgress()\n  1345\t\t}\n  1346\t\tif err := ctx.Err(); err != nil {\n  1347\t\t\treturn nil, err\n  1348\t\t}\n  1349\t\tif agentFailures > 0 && !anyAgentSuccess {\n  1350\t\t\treturn nil, fmt.Errorf(\n  1351\t\t\t\t\"distill aborted after all %d agent calls failed with no successful response; check --agent, --model, authentication, and executable PATH\",\n  1352\t\t\t\tagentFailures,\n  1353\t\t\t)\n  1354\t\t}\n  1355\t\twarnings = capWarnings(warnings, maxDistillWarnings)\n  1356\t\n  1357\t\twriteStarted := time.Now()\n  1358\t\tvar source *factSourceManifest\n  1359\t\terr = withBrainWriteLock(brainDir, func() error {\n  1360\t\t\tif err := flushFactStoresLocked(true); err != nil {\n  1361\t\t\t\treturn err\n  1362\t\t\t}\n  1363\t\t\tif err := writeFactTaxonomy(brainDir, taxonomy); err != nil {\n  1364\t\t\t\treturn err\n  1365\t\t\t}\n  1366\t\n  1367\t\t\t// Summarize the manifest from the whole on-disk store, not just the branches\n  1368\t\t\t// touched this run. A branch-limited (`--branch`) or incremental run only\n  1369\t\t\t// loads a subset into byBranch; folding that subset into the manifest would\n  1370\t\t\t// drop counts/branches/proposals for facts that still exist on other\n  1371\t\t\t// branches. Re-reading the store after writing keeps sources.facts whole.\n  1372\t\t\tallBranches, err := loadAllFactBranches(brainDir)\n  1373\t\t\tif err != nil {\n  1374\t\t\t\treturn err\n  1375\t\t\t}\n  1376\t\t\tbranchNames := make([]string, 0, len(allBranches))\n  1377\t\t\tfor branch := range allBranches {\n  1378\t\t\t\tbranchNames = append(branchNames, branch)\n  1379\t\t\t}\n  1380\t\t\ttotalProposals := countFactProposals(brainDir, branchNames)\n  1381\t\n  1382\t\t\tsource = summarizeFactSource(now, allBranches, chunksScanned, chunksDistilled, totalProposals, warnings)\n  1383\t\t\tsource.CacheHits = cacheHits\n  1384\t\t\tsource.FailedChunks = failedChunks\n  1385\t\t\tsource.PreprocessedBytes = preprocessedBytes\n  1386\t\t\tsource.CandidateBytes = candidateBytes\n  1387\t\t\tsource.Agent = strings.TrimSpace(distillOpts.agent)\n  1388\t\t\tsource.Model = strings.TrimSpace(distillOpts.model)\n  1389\t\t\tsource.Effort = strings.TrimSpace(distillOpts.effort)\n  1390\t\t\tsource.Pipeline = pipeline\n  1391\t\t\tsource.Branch = strings.TrimSpace(distillOpts.branch)\n  1392\t\t\tsource.Force = distillOpts.force\n  1393\t\t\tsource.Jobs = distillRequestedJobs(distillOpts)\n  1394\t\t\tsource.ExtractionJobsCap = distillEffectiveExtractionJobs(extractionAgentCalls, distillOpts)\n  1395\t\t\tsource.MaxChunkBytes = distillMaxChunkBytes(distillOpts)\n  1396\t\t\tsource.Confidence = threshold\n  1397\t\t\tsource.ExtractionCalls = extractionAgentCalls\n  1398\t\t\tsource.ReconcileCalls = reconcileAgentCalls\n  1399\t\t\tsource.TotalAgentCalls = extractionAgentCalls + reconcileAgentCalls\n  1400\t\t\tsource.TokenUsage = usageCollector.summary(source.TotalAgentCalls)\n  1401\t\t\tsource.ExtractionWaitSeconds = extractionSeconds\n  1402\t\t\tsource.ReconcileSeconds = reconcileSeconds\n  1403\t\t\tsource.WriteSeconds = time.Since(writeStarted).Seconds()\n  1404\t\t\tsource.TotalSeconds = time.Since(runStarted).Seconds()\n  1405\t\t\t// Provider work may run for hours. Patch only the facts source while the\n  1406\t\t\t// manifest-leaf lock covers load-through-replace, so a semantic/session/\n  1407\t\t\t// seed writer cannot commit between a stale reload and this publication.\n  1408\t\t\treturn updateBrainManifestAndReadme(brainDir, func(currentManifest *exportManifest) error {\n  1409\t\t\t\tif currentManifest.Sources == nil {\n  1410\t\t\t\t\tcurrentManifest.Sources = &brainSources{}\n  1411\t\t\t\t}\n  1412\t\t\t\t// Manifest schema v3 is decoded strictly by released binaries. Keep\n  1413\t\t\t\t// candidate-only observability in this command's returned summary and\n  1414\t\t\t\t// dry-run report until it has a separately versioned durable leaf; an\n  1415\t\t\t\t// unversioned field addition would make binary rollback impossible.\n  1416\t\t\t\tpersistedSource := *source\n  1417\t\t\t\tpersistedSource.CandidateBytes = 0\n  1418\t\t\t\tpersistedSource.CandidateCards = 0\n  1419\t\t\t\tpersistedSource.CandidateSessions = 0\n  1420\t\t\t\tpersistedSource.CandidatePacks = 0\n  1421\t\t\t\tpersistedSource.CandidatePacksDone = 0\n  1422\t\t\t\tpersistedSource.CandidateMembers = 0\n  1423\t\t\t\tpersistedSource.CandidateCacheHits = 0\n  1424\t\t\t\tpersistedSource.CandidateCacheMisses = 0\n  1425\t\t\t\tpersistedSource.CandidateSplitCalls = 0\n  1426\t\t\t\tpersistedSource.CandidateEmptyResults = 0\n  1427\t\t\t\tpersistedSource.Pipeline = \"\"\n  1428\t\t\t\tpersistedSource.Shadow = false\n  1429\t\t\t\tpersistedSource.ShadowFacts = 0\n  1430\t\t\t\tcurrentManifest.Sources.Facts = &persistedSource\n  1431\t\t\t\tif currentManifest.GeneratedAt.IsZero() {\n  1432\t\t\t\t\tcurrentManifest.GeneratedAt = now\n  1433\t\t\t\t}\n  1434\t\t\t\treturn nil\n  1435\t\t\t})\n     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"crypto/sha256\"\n     6\t\t\"encoding/hex\"\n     7\t\t\"encoding/json\"\n     8\t\t\"errors\"\n     9\t\t\"fmt\"\n    10\t\t\"os\"\n    11\t\t\"path/filepath\"\n    12\t\t\"sort\"\n    13\t\t\"strings\"\n    14\t\t\"time\"\n    15\t\n    16\t\t\"github.com/ashtom/entire-brain/internal/factmerge\"\n    17\t)\n    18\t\n    19\tconst (\n    20\t\tfactsDirName          = \"facts\"\n    21\t\tfactsTaxonomyFileName = \"taxonomy.json\"\n    22\t\tfactsTaxonomyPath     = factsDirName + \"/\" + factsTaxonomyFileName\n    23\t\tfactsFileName         = \"facts.ndjson\"\n    24\t\tfactsMaxPerChunk      = 6 // quality-gate output cap per source chunk\n    25\t\n    26\t\tfactOriginDistilled = \"distilled\"\n    27\t\tfactOriginAuthored  = \"authored\"\n    28\t)\n    29\t\n    30\t// factSourceManifest is recorded under sources.facts in the brain manifest,\n    31\t// parallel to historySourceManifest and the semantic source metadata.\n    32\ttype factSourceManifest struct {\n    33\t\tGeneratedAt           time.Time                 `json:\"generated_at\"`\n    34\t\tTaxonomyPath          string                    `json:\"taxonomy_path\"`\n    35\t\tBranches              []string                  `json:\"branches,omitempty\"`\n    36\t\tFacts                 int                       `json:\"facts\"`\n    37\t\tDistilled             int                       `json:\"distilled\"`\n    38\t\tAuthored              int                       `json:\"authored\"`\n    39\t\tSuperseded            int                       `json:\"superseded\"`\n    40\t\tProposals             int                       `json:\"proposals\"`\n    41\t\tVerified              int                       `json:\"verified\"`\n    42\t\tUnsigned              int                       `json:\"unsigned\"`\n    43\t\tByKind                map[string]int            `json:\"by_kind,omitempty\"`\n    44\t\tChunksScanned         int                       `json:\"chunks_scanned\"`\n    45\t\tChunksDistilled       int                       `json:\"chunks_distilled\"`\n    46\t\tCacheHits             int                       `json:\"cache_hits,omitempty\"`\n    47\t\tFailedChunks          int                       `json:\"failed_chunks,omitempty\"`\n    48\t\tPreprocessedBytes     int64                     `json:\"preprocessed_bytes,omitempty\"`\n    49\t\tCandidateBytes        int64                     `json:\"candidate_bytes,omitempty\"`\n    50\t\tCandidateCards        int                       `json:\"candidate_cards,omitempty\"`\n    51\t\tCandidateSessions     int                       `json:\"candidate_sessions,omitempty\"`\n    52\t\tCandidatePacks        int                       `json:\"candidate_packs,omitempty\"`\n    53\t\tCandidatePacksDone    int                       `json:\"candidate_packs_completed,omitempty\"`\n    54\t\tCandidateMem…171 tokens truncated…json:\"effort,omitempty\"`\n    62\t\tPipeline              string                    `json:\"pipeline,omitempty\"`\n    63\t\tBranch                string                    `json:\"branch,omitempty\"`\n    64\t\tForce                 bool                      `json:\"force,omitempty\"`\n    65\t\tJobs                  int                       `json:\"jobs,omitempty\"`\n    66\t\tExtractionJobsCap     int                       `json:\"extraction_jobs_cap,omitempty\"`\n    67\t\tMaxChunkBytes         int                       `json:\"max_chunk_bytes,omitempty\"`\n    68\t\tConfidence            float64                   `json:\"confidence_threshold,omitempty\"`\n    69\t\tExtractionCalls       int                       `json:\"extraction_agent_calls,omitempty\"`\n    70\t\tReconcileCalls        int                       `json:\"reconcile_agent_calls,omitempty\"`\n    71\t\tTotalAgentCalls       int                       `json:\"total_agent_calls,omitempty\"`\n    72\t\tTokenUsage            *distillTokenUsageSummary `json:\"token_usage,omitempty\"`\n    73\t\t// ExtractionWaitSeconds is the consumer's WAIT on prefetched results, not\n    74\t\t// agent compute: with concurrency > 1, calls completing in the background\n    75\t\t// register ~0s here. Compare total_seconds across --jobs settings for\n    76\t\t// scheduling claims.\n    77\t\tExtractionWaitSeconds float64  `json:\"extraction_wait_seconds,omitempty\"`\n    78\t\tReconcileSeconds      float64  `json:\"reconcile_seconds,omitempty\"`\n    79\t\tWriteSeconds          float64  `json:\"write_seconds,omitempty\"`\n    80\t\tTotalSeconds          float64  `json:\"total_seconds,omitempty\"`\n    81\t\tWarnings              []string `json:\"warnings,omitempty\"`\n    82\t\t// Shadow and ShadowFacts are command-result-only Phase 2 evidence. They\n    83\t\t// are cleared before any schema-v3 manifest publication.\n    84\t\tShadow      bool `json:\"shadow,omitempty\"`\n    85\t\tShadowFacts int  `json:\"shadow_facts,omitempty\"`\n    86\t}\n    87\t\n    88\t// factRecord (factmerge.Record) and factAnchor (factmerge.Anchor) are defined\n    89\t// as type aliases in facts_aliases.go; the durable-fact data model now lives in\n    90\t// internal/factmerge.\n    91\t\n    92\t// factTaxonomy is the active taxonomy snapshot. Paths are validated against\n    93\t// factPathPattern; classification may only invent a new three-level path under\n    94\t// an existing top-level category.\n    95\ttype factTaxonomy struct {\n    96\t\tGeneratedAt time.Time         `json:\"generated_at\"`\n    97\t\tCategories  map[string]string `json:\"categories\"` // top-level -> description\n    98\t\tPaths       []factPathDef     `json:\"paths\"`\n    99\t}\n   100\t\n   101\ttype factPathDef struct {\n   102\t\tPath        string   `json:\"path\"`\n   103\t\tDescription string   `json:\"description\"`\n   104\t\tExamples    []string `json:\"examples,omitempty\"`\n   105\t}\n   106\t\n   107\t// normalizeFactText, factRecordID, validFactPath, and normalizeFactPaths moved\n   108\t// to internal/factmerge (NormalizeText/RecordID/ValidPath/NormalizePaths); the\n   109\t// CLI names are forwarding wrappers in facts_aliases.go.\n   110\t\n   111\t// factTopLevel returns the top-level category of a taxonomy path (the segment\n   112\t// before the first dot), or \"\" if the path is empty.\n   113\tfunc factTopLevel(path string) string {\n   114\t\tif i := strings.IndexByte(path, '.'); i >= 0 {\n   115\t\t\treturn path[:i]\n   116\t\t}\n   117\t\treturn path\n   118\t}\n   119\t\n   120\t// --- on-disk layout -------------------------------------------------------\n   121\t\n   122\t// factsBranchRelDir returns the brain-relative directory holding a branch's\n   123\t// facts. The readable slug alone is not collision-free — distinct branches can\n   124\t// sanitize to the same slug (e.g. \"evis/search\" and \"evis-search\", or \"Main\"\n   125\t// and \"main\") — and two branches sharing a facts file would clobber each other\n   126\t// and break branch isolation. A short hash of the full branch name is appended\n   127\t// so each branch maps to a stable, unique directory while staying greppable.\n   128\tfunc factsBranchRelDir(branch string) string {\n   129\t\tslug := safePathComponent(branch, \"branch\", 80)\n   130\t\tsum := sha256.Sum256([]byte(branch))\n   131\t\treturn filepath.ToSlash(filepath.Join(factsDirName, slug+\"-\"+hex.EncodeToString(sum[:4])))\n   132\t}\n   133\t\n   134\tfunc factsFileRelPath(branch string) string {\n   135\t\treturn filepath.ToSlash(filepath.Join(factsBranchRelDir(branch), factsFileName))\n   136\t}\n   137\t\n   138\t// loadFacts reads a branch's facts.ndjson. A missing file is not an error: it\n   139\t// yields an empty slice so first-run callers do not special-case it. Blank\n   140\t// lines are skipped; a malformed line is a hard error so a corrupt store is\n   141\t// surfaced rather than silently dropping records.\n   142\tfunc loadFacts(brainDir, branch string) ([]factRecord, error) {\n   143\t\tpath := filepath.Join(brainDir, filepath.FromSlash(factsFileRelPath(branch)))\n   144\t\treturn parseFactsFile(path)\n   145\t}\n   146\t\n   147\t// parseFactsFile reads a facts.ndjson file at an absolute path. A missing file\n   148\t// yields an empty slice; a malformed line is a hard error so a corrupt store is\n   149\t// surfaced rather than silently dropping records. The byte-level scan lives in\n   150\t// factmerge.ParseNDJSON; this keeps only the file/path handling and restores the\n   151\t// historical \"parse <file> line N: ...\" message the core cannot know the path\n   152\t// for.\n   153\tfunc parseFactsFile(path string) ([]factRecord, error) {\n   154\t\tf, err := os.Open(path)\n   155\t\tif err != nil {\n   156\t\t\tif os.IsNotExist(err) {\n   157\t\t\t\treturn nil, nil\n   158\t\t\t}\n   159\t\t\treturn nil, err\n   160\t\t}\n   161\t\tdefer f.Close()\n   162\t\trecords, err := factmerge.ParseNDJSON(f)\n   163\t\tif err != nil {\n   164\t\t\tvar perr *factmerge.ParseError\n   165\t\t\tif errors.As(err, &perr) {\n   166\t\t\t\treturn nil, fmt.Errorf(\"parse %s line %d: %w\", filepath.Base(path), perr.Line, perr.Err)\n   167\t\t\t}\n   168\t\t\treturn nil, err\n   169\t\t}\n   170\t\treturn records, nil\n   171\t}\n   172\t\n   173\t// writeFacts persists a branch's facts as newline-delimited JSON, one record\n   174\t// per line, sorted deterministically so the file is stable across rebuilds and\n   175\t// diffs cleanly. The branch directory is created if needed. The byte-level\n   176\t// sort+marshal lives in factmerge.WriteNDJSON; this keeps the atomic,\n   177\t// symlink-rejecting disk write in the CLI.\n   178\tfunc writeFacts(brainDir, branch string, records []factRecord) error {\n   179\t\tvar buf bytes.Buffer\n   180\t\tif err := factmerge.WriteNDJSON(&buf, records); err != nil {\n   181\t\t\treturn err\n   182\t\t}\n   183\t\treturn writeBrainRelativeFileAtomic(brainDir, factsFileRelPath(branch), buf.Bytes(), 0o600)\n   184\t}\n   185\t\n   186\t// --- taxonomy -------------------------------------------------------------\n   187\t\n   188\t// defaultFactTaxonomy is the shipped baseline taxonomy. The top-level\n   189\t// categories here are fixed in Phase A; distillation may invent a new\n   190\t// three-level path only under one of these categories. The brain regenerates\n   191\t// taxonomy.json from this default on refresh.\n   192\tfunc defaultFactTaxonomy(now time.Time) factTaxonomy {\n   193\t\treturn factTaxonomy{\n   194\t\t\tGeneratedAt: now,\n   195\t\t\tCategories: map[string]string{\n   196\t\t\t\t\"preferences\":  \"How the user wants to work and how code should be written.\",\n   197\t\t\t\t\"architecture\": \"Resolved design, boundary, and data-flow decisions and their rationale.\",\n   198\t\t\t\t\"project\":      \"Stack, tooling, CI/CD, ownership, and standing project facts.\",\n   199\t\t\t\t\"workflow\":     \"Branching, testing, review, and release process rules.\",\n   200\t\t\t\t\"constraints\":  \"Non-obvious invariants, gotchas, and hard constraints.\",\n   201\t\t\t},\n   202\t\t\tPaths: []factPathDef{\n   203\t\t\t\t{Path: \"preferences.coding.style\", Description: \"Stated code-style preferences.\", Examples: []string{\"prefers table-driven tests\"}},\n   204\t\t\t\t{Path: \"preferences.workflow.general\", Description: \"How the user prefers to work day to day.\"},\n   205\t\t\t\t{Path: \"architecture.boundaries.rationale\", Description: \"Why a module or package boundary exists.\"},\n   206\t\t\t\t{Path: \"architecture.data.flow\", Description: \"How data moves through the system.\"},\n   207\t\t\t\t{Path: \"project.tooling.stack\", Description: \"Languages, frameworks, and tools the project uses.\"},\n   208\t\t\t\t{Path: \"project.ci_cd.pipeline\", Description: \"Build, test, and deploy pipeline facts.\"},\n   209\t\t\t\t{Path: \"workflow.branching.rules\", Description: \"Branching and merge conventions.\"},\n   210\t\t\t\t{Path: \"workflow.testing.rules\", Description: \"How and when tests must be run.\"},\n     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"context\"\n     5\t\t\"encoding/json\"\n     6\t\t\"fmt\"\n     7\t\t\"math\"\n     8\t\t\"os\"\n     9\t\t\"path/filepath\"\n    10\t\t\"sort\"\n    11\t\t\"strconv\"\n    12\t\t\"strings\"\n    13\t\t\"time\"\n    14\t)\n    15\t\n    16\tconst factsProposalsFileName = \"proposals.ndjson\"\n    17\t\n    18\tfunc factsProposalsRelPath(branch string) string {\n    19\t\treturn filepath.ToSlash(filepath.Join(factsBranchRelDir(branch), factsProposalsFileName))\n    20\t}\n    21\t\n    22\t// loadFactProposals reads a branch's pending proposals; a missing file yields\n    23\t// none. A malformed line is a hard error so a corrupt queue is surfaced.\n    24\tfunc loadFactProposals(brainDir, branch string) ([]factProposal, error) {\n    25\t\tpath := filepath.Join(brainDir, filepath.FromSlash(factsProposalsRelPath(branch)))\n    26\t\tdata, err := os.ReadFile(path)\n    27\t\tif err != nil {\n    28\t\t\tif os.IsNotExist(err) {\n    29\t\t\t\treturn nil, nil\n    30\t\t\t}\n    31\t\t\treturn nil, err\n    32\t\t}\n    33\t\treturn parseFactProposals(data, factsProposalsRelPath(branch))\n    34\t}\n    35\t\n    36\tfunc parseFactProposals(data []byte, displayPath string) ([]factProposal, error) {\n    37\t\tvar proposals []factProposal\n    38\t\tfor i, line := range strings.Split(string(data), \"\\n\") {\n    39\t\t\tline = strings.TrimSpace(line)\n    40\t\t\tif line == \"\" {\n    41\t\t\t\tcontinue\n    42\t\t\t}\n    43\t\t\tvar p factProposal\n    44\t\t\tif err := json.Unmarshal([]byte(line), &p); err != nil {\n    45\t\t\t\treturn nil, fmt.Errorf(\"parse %s line %d: %w\", displayPath, i+1, err)\n    46\t\t\t}\n    47\t\t\tproposals = append(proposals, p)\n    48\t\t}\n    49\t\treturn proposals, nil\n    50\t}\n    51\t\n    52\t// writeFactProposals persists a branch's pending proposals, deduplicated by\n    53\t// (action, candidate, target) and sorted for a stable file. An empty set\n    54\t// removes the file so a fully-resolved branch leaves no stale queue.\n    55\tfunc writeFactProposals(brainDir, branch string, proposals []factProposal) error {\n    56\t\tcanonical := append([]factProposal(nil), proposals...)\n    57\t\tfor i := range canonical {\n    58\t\t\tcanonical[i].Branch = branch\n    59\t\t}\n    60\t\treturn writeFactProposalsAtRel(brainDir, factsProposalsRelPath(branch), canonical)\n    61\t}\n    62\t\n    63\tfunc writeFactProposalsAtRel(brainDir, rel string, proposals []factProposal) error {\n    64\t\tdeduped := dedupeProposals(proposals)\n    65\t\tif len(deduped) == 0 {\n    66\t\t\treturn removeBrainRelativeFile(brainDir, rel)\n    67\t\t}\n    68\t\tvar buf strings.Builder\n    69\t\tfor _, p := range deduped {\n    70\t\t\tdata, err := json.Marshal(p)\n    71\t\t\tif err != nil {\n    72\t\t\t\treturn err\n    73\t\t\t}\n    74\t\t\tbuf.Write(data)\n    75\t\t\tbuf.WriteByte('\\n')\n    76\t\t}\n    77\t\treturn writeBrainRelativeFileAtomic(brainDir, rel, []byte(buf.String()), 0o600)\n    78\t}\n    79\t\n    80\t// clearDistillOwnedLegacyProposalStore cleans a pre-branch-ownership proposal\n    81\t// file in place. Member-attributed sync proposals survive because distillation\n    82\t// does not own or regenerate them.\n    83\tfunc clearDistillOwnedLegacyProposalStore(brainDir, rel string) error {\n    84\t\tdata, present, err := readMemoryStateFile(brainDir, rel, \"legacy fact proposal store\", defaultMaxReadBytes)\n    85\t\tif err != nil || !present {\n    86\t\t\treturn err\n    87\t\t}\n    88\t\tproposals, err := parseFactProposals(data, rel)\n    89\t\tif err != nil {\n    90\t\t\treturn err\n    91\t\t}\n    92\t\tkept := proposals[:0]\n    93\t\tfor _, proposal := range proposals {\n    94\t\t\tif strings.TrimSpace(proposal.ProposedBy) != \"\" {\n    95\t\t\t\tkept = append(kept, proposal)\n    96\t\t\t}\n    97\t\t}\n    98\t\treturn writeFactProposalsAtRel(brainDir, rel, kept)\n    99\t}\n   100\t\n   101\tfunc dedupeProposals(proposals []factProposal) []factProposal {\n   102\t\tseen := make(map[string]struct{}, len(proposals))\n   103\t\tout := make([]factProposal, 0, len(proposals))\n   104\t\tfor _, p := range proposals {\n   105\t\t\tkey := p.Action + \"\\x00\" + p.CandidateID + \"\\x00\" + p.TargetID\n   106\t\t\tif _, ok := seen[key]; ok {\n   107\t\t\t\tcontinue\n   108\t\t\t}\n   109\t\t\tseen[key] = struct{}{}\n   110\t\t\tout = append(out, p)\n   111\t\t}\n   112\t\tsort.SliceStable(out, func(i, j int) bool {\n   113\t\t\tif out[i].TargetID != out[j].TargetID {\n   114\t\t\t\treturn out[i].TargetID < out[j].TargetID\n   115\t\t\t}\n   116\t\t\treturn out[i].CandidateID < out[j].CandidateID\n   117\t\t})\n   118\t\treturn out\n   119\t}\n   120\t\n   121\tconst (\n   122\t\t// maxReconcileExisting bounds how many existing active facts at a\n   123\t\t// candidate's paths are shown to the agent, keeping the reconcile prompt\n   124\t\t// bounded even on busy paths. When more exist, the most recently updated\n   125\t\t// are shown and the cap is reported as a warning (no silent truncation).\n   126\t\tmaxReconcileExisting = 50\n   127\t)\n   128\t\n   129\t// reconcilePrompt is the static system prompt for the reconcile pass. The\n   130\t// dynamic candidate/existing lists are supplied on stdin (see reconcileInput).\n   260\t// isNumericToken reports whether a token parses as a finite float, used to tell\n   261\t// a trailing confidence value apart from a \"-\" placeholder or missing field.\n   262\t// NaN/±Inf are rejected: ParseFloat accepts them, but a NaN confidence would\n   263\t// silently bypass the low-confidence gate downstream (every comparison with NaN\n   264\t// is false), so they must not be treated as a numeric confidence.\n   265\tfunc isNumericToken(token string) bool {\n   266\t\tvalue, err := strconv.ParseFloat(token, 64)\n   267\t\treturn err == nil && !math.IsNaN(value) && !math.IsInf(value, 0)\n   268\t}\n   269\t\n   270\t// parseConfidence reads a confidence token, clamped to [0,1]; unparseable\n   271\t// values (including NaN/±Inf, which would otherwise slip past the [0,1] clamp\n   272\t// and the auto-apply threshold) default to 0 so an unreadable confidence is\n   273\t// treated as low and queued for review rather than auto-applied.\n   274\tfunc parseConfidence(token string) float64 {\n   275\t\tvalue, err := strconv.ParseFloat(token, 64)\n   276\t\tif err != nil || math.IsNaN(value) || math.IsInf(value, 0) {\n   277\t\t\treturn 0\n   278\t\t}\n   279\t\tif value < 0 {\n   280\t\t\treturn 0\n   281\t\t}\n   282\t\tif value > 1 {\n   283\t\t\treturn 1\n   284\t\t}\n   285\t\treturn value\n   286\t}\n   287\t\n   288\t// activeFactsAtPaths returns the active facts whose paths intersect the given\n   289\t// path set, most-recently-updated first, capped at maxReconcileExisting. The\n   290\t// boolean reports whether the cap dropped any facts.\n   291\tfunc activeFactsAtPaths(records []factRecord, paths []string) ([]factRecord, bool) {\n   292\t\twant := make(map[string]struct{}, len(paths))\n   293\t\tfor _, p := range paths {\n   294\t\t\twant[p] = struct{}{}\n   295\t\t}\n   296\t\tvar matched []factRecord\n   297\t\tfor _, record := range records {\n   298\t\t\tif record.Status != factStatusActive {\n   299\t\t\t\tcontinue\n   300\t\t\t}\n   301\t\t\tfor _, p := range record.Paths {\n   302\t\t\t\tif _, ok := want[p]; ok {\n   303\t\t\t\t\tmatched = append(matched, record)\n   304\t\t\t\t\tbreak\n   305\t\t\t\t}\n   306\t\t\t}\n   307\t\t}\n   308\t\tsort.SliceStable(matched, func(i, j int) bool {\n   309\t\t\tif !matched[i].UpdatedAt.Equal(matched[j].UpdatedAt) {\n   310\t\t\t\treturn matched[i].UpdatedAt.After(matched[j].UpdatedAt)\n   311\t\t\t}\n   312\t\t\treturn matched[i].ID < matched[j].ID\n   313\t\t})\n   314\t\tif len(matched) > maxReconcileExisting {\n   315\t\t\treturn matched[:maxReconcileExisting], true\n   316\t\t}\n   317\t\treturn matched, false\n   318\t}\n   319\t\n   320\t// candidatePathSet returns the sorted union of paths across the candidates.\n   321\tfunc candidatePathSet(candidates []factRecord) []string {\n   322\t\tseen := map[string]struct{}{}\n   323\t\tfor _, c := range candidates {\n   324\t\t\tfor _, p := range c.Paths {\n   325\t\t\t\tseen[p] = struct{}{}\n   326\t\t\t}\n   327\t\t}\n   328\t\tpaths := make([]string, 0, len(seen))\n   329\t\tfor p := range seen {\n   330\t\t\tpaths = append(paths, p)\n   331\t\t}\n   332\t\tsort.Strings(paths)\n   333\t\treturn paths\n   334\t}\n   335\t\n   336\t// newDistilledFactActions is the candidate pipeline's conservative settlement\n   337\t// boundary. Every extracted record is applied as new; factmerge.Upsert still\n   338\t// collapses exact content IDs and unions provenance, but no fuzzy relationship\n   339\t// can silently merge or supersede an unrelated fact. Later candidate-pipeline\n   340\t// versions may enqueue evidence-backed ambiguous pairs for review, but automatic\n   341\t// supersession must never be inferred from taxonomy overlap alone.\n   342\tfunc newDistilledFactActions(candidates []factRecord) []factAction {\n   343\t\tactions := make([]factAction, len(candidates))\n   344\t\tfor i, candidate := range candidates {\n   345\t\t\tactions[i] = factAction{Kind: factActionNew, Confidence: 1, Candidate: candidate}\n   346\t\t}\n   347\t\treturn actions\n   348\t}\n   349\t\n   350\t// removeRelocatedDistillAnchors replaces the entire prior materialization for\n   351\t// the same stable candidate trigger before fresh records are applied. This\n   352\t// removes stale line anchors after transcript layout shifts and stale facts\n   353\t// after a crash/retry produces different wording. Facts corroborated by another\n   354\t// trigger/session retain those independent anchors; a distilled fact that loses\n   355\t// its final anchor is dropped.\n   356\tfunc removeRelocatedDistillAnchors(records []factRecord, source factAnchor) ([]factRecord, bool) {\n   357\t\tif source.SessionID == \"\" || source.DistillTurnID == \"\" {\n   358\t\t\treturn records, false\n   359\t\t}\n   360\t\tout := records[:0]\n   361\t\tchanged := false\n   362\t\tfor index := range records {\n   363\t\t\toriginalAnchors := len(records[index].Provenance)\n   364\t\t\tkept := records[index].Provenance[:0]\n   365\t\t\tfor _, anchor := range records[index].Provenance {\n   366\t\t\t\tif anchor.SessionID != source.SessionID || anchor.DistillTurnID != source.DistillTurnID {\n   367\t\t\t\t\tkept = append(kept, anchor)\n   368\t\t\t\t} else {\n   369\t\t\t\t\tchanged = true\n   370\t\t\t\t}\n   371\t\t\t}\n   372\t\t\trecords[index].Provenance = kept\n   373\t\t\tif originalAnchors > 0 && len(kept) == 0 && records[index].Origin == factOriginDistilled {\n   374\t\t\t\tcontinue\n   375\t\t\t}\n   376\t\t\tout = append(out, records[index])\n   377\t\t}\n   378\t\treturn out, changed\n   379\t}\n   380\t\n   381\tfunc removeMissingDistillTurnAnchors(records []factRecord, source factAnchor, current map[string]bool) ([]factRecord, bool) {\n   382\t\tif source.SessionID == \"\" {\n   383\t\t\treturn records, false\n   384\t\t}\n   385\t\tout := records[:0]\n   386\t\tchanged := false\n   387\t\tfor index := range records {\n   388\t\t\toriginalAnchors := len(records[index].Provenance)\n   389\t\t\tkept := records[index].Provenance[:0]\n   390\t\t\tfor _, anchor := range records[index].Provenance {\n   391\t\t\t\tstale := anchor.SessionID == source.SessionID && anchor.DistillTurnID != \"\" && !current[anchor.DistillTurnID]\n   392\t\t\t\tif stale {\n   393\t\t\t\t\tchanged = true\n   394\t\t\t\t\tcontinue\n   395\t\t\t\t}\n   396\t\t\t\tkept = append(kept, anchor)\n   397\t\t\t}\n   398\t\t\trecords[index].Provenance = kept\n   399\t\t\tif originalAnchors > 0 && len(kept) == 0 && records[index].Origin == factOriginDistilled {\n   400\t\t\t\tcontinue\n   401\t\t\t}\n   402\t\t\tout = append(out, records[index])\n   403\t\t}\n   404\t\treturn out, changed\n   405\t}\n   406\t\n   407\t// reconcileChunkCandidates resolves a chunk's candidates against the current\n   408\t// active set: when no existing facts share the candidates' paths, every\n   409\t// candidate is trivially `new` (no agent call); otherwise the agent decides.\n   410\t// An agent error falls back to treating all candidates as `new` so facts are\n"},"started_at_ms":1787507057881,"completed_at_ms":1787507057881}}
{"timestamp":"2026-08-23T17:44:17.939Z","ordinal":17067,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a02fb9-2513-7a11-b585-4eacb849d286","call_id":"call_JlR5W2UgtbTEwHnugFVYOmge","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 10171)\nTotal output lines: 847\n\n  1080\t\t\t\t\t\t}\n  1081\t\t\t\t\t}\n  1082\t\t\t\t} else {\n  1083\t\t\t\t\tprior = loadedProposals\n  1084\t\t\t\t}\n  1085\t\t\t\tmerged := dedupeProposals(append(prior, proposalsByBranch[branch]...))\n  1086\t\t\t\tif err := writeFactProposals(brainDir, branch, merged); err != nil {\n  1087\t\t\t\t\treturn err\n  1088\t\t\t\t}\n  1089\t\t\t\t// A force run keeps branches dirty between mid-run flushes so the\n  1090\t\t\t\t// final flush always rewrites them — that write is what drops the\n  1091\t\t\t\t// prior proposal backlog. Otherwise the branch is clean until new\n  1092\t\t\t\t// fact actions touch it.\n  1093\t\t\t\tif final || !distillOpts.force {\n  1094\t\t\t\t\tdelete(dirtyBranches, branch)\n  1095\t\t\t\t}\n  1096\t\t\t}\n  1097\t\t\tif final && distillOpts.force {\n  1098\t\t\t\tfor _, rel := range forceScope.LegacyProposalRels {\n  1099\t\t\t\t\tif err := clearDistillOwnedLegacyProposalStore(brainDir, rel); err != nil {\n  1100\t\t\t\t\t\treturn err\n  1101\t\t\t\t\t}\n  1102\t\t\t\t}\n  1103\t\t\t}\n  1104\t\t\tcache := newCache\n  1105\t\t\tif !final && !distillOpts.force {\n  1106\t\t\t\tcache = distillCache{Version: distillCacheVersion, Sessions: make(map[string]string, len(prevCache.Sessions)+len(newCache.Sessions))}\n  1107\t\t\t\tmaps.Copy(cache.Sessions, prevCache.Sessions)\n  1108\t\t\t\tmaps.Copy(cache.Sessions, newCache.Sessions)\n  1109\t\t\t}\n  1110\t\t\treturn saveDistillCache(brainDir, cache)\n  1111\t\t}\n  1112\t\tflushFactStores := func(final bool) error {\n  1113\t\t\treturn withBrainWriteLock(brainDir, func() error {\n  1114\t\t\t\treturn flushFactStoresLocked(final)\n  1115\t\t\t})\n  1116\t\t}\n  1117\t\tflushInterval := distillOpts.flushEvery\n  1118\t\tif flushInterval <= 0 {\n  1119\t\t\tflushInterval = distillFlushCallInterval\n  1120\t\t}\n  1121\t\tcallsSinceFlush := 0\n  1122\t\tmaybeFlush := func() error {\n  1123\t\t\tif callsSinceFlush < flushInterval {\n  1124\t\t\t\treturn nil\n  1125\t\t\t}\n  1126\t\t\t// Reset even on failure so a persistent write error is retried once per\n  1127\t\t\t// interval, not on every call.\n  1128\t\t\tcallsSinceFlush = 0\n  1129\t\t\tif err := flushFactStores(false); err != nil {\n  1130\t\t\t\tif errors.Is(err, errDistillFactStoreChanged) {\n  1131\t\t\t\t\treturn err\n  1132\t\t\t\t}\n  1133\t\t\t\t// Non-fatal: a mid-run flush only narrows the loss window, and\n  1134\t\t\t\t// aborting an hours-long run over a transient write error would lose\n  1135\t\t\t\t// far more than the flush protects. Failed branches stay dirty, so\n  1136\t\t\t\t// the next interval (and the final flush) retries them.\n  1137\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"mid-run flush failed (will retry): %v\", err))\n  1138\t\t\t}\n  1139\t\t\treturn nil\n  1140\t\t}\n  1141\t\n  1142\t\t// Session pipeline: a producer goroutine prepares sessions ahead —\n  1143\t\t// transcript read, preprocessing, fingerprint/cache check, chunking — and\n  1144\t\t// dispatches chunk agent calls into one pool shared ACROSS sessions (see\n  1145\t\t// startSessionPrefetch), while this loop consumes results strictly in\n  1146\t\t// chronological order, so reconcile and fact application keep their exact\n  1147\t\t// serial semantics. Canceling pipeCtx (deferred; covers the abort return\n  1148\t\t// too) stops preparation, dispatch, and in-flight agent calls.\n  1149\t\tpipeCtx, pipeCancel := context.WithCancel(ctx)\n  1150\t\tprefetch := startSessionPrefetch(pipeCtx, brainDir, repoDir, args, sessions, prevCache, distillOpts, resolveBranch)\n  1151\t\tdefer func() {\n  1152\t\t\tpipeCancel()\n  1153\t\t\tprefetch.wait()\n  1154\t\t}()\n  1155\t\tfor ps := range prefetch.Sessions {\n  1156\t\t\tsession, branch := ps.session, ps.branch\n  1157\t\t\tif ps.skip {\n  1158\t\t\t\t// Carry the session's cache entry through unchanged: the final flush\n  1159\t\t\t\t// persists newCache only, so dropping filtered sessions here would\n  1160\t\t\t\t// make the next unfiltered run re-distill every other branch (or\n  1161\t\t\t\t// session) from scratch. (The fingerprint-match skip below does the\n  1162\t\t\t\t// same.)\n  1163\t\t\t\tcacheKey := distillSessionCacheKeyForPipeline(pipeline, branch, session.SessionID)\n  1164\t\t\t\tif prev, ok := prevCache.Sessions[cacheKey]; ok {\n  1165\t\t\t\t\tnewCache.Sessions[cacheKey] = prev\n  1166\t\t\t\t} else if !distillOpts.force {\n  1167\t\t\t\t\tprev, ok := prevCache.Sessions[session.SessionID]\n  1168\t\t\t\t\tif !ok {\n  1169\t\t\t\t\t\tcontinue\n  1170\t\t\t\t\t}\n  1171\t\t\t\t\t// A legacy entry stays under its legacy key (and formula) until\n  1172\t\t\t\t\t// its session is actually visited and grandfathered — copying it\n  1173\t\t\t\t\t// under the new key would make it permanently unmatchable.\n  1174\t\t\t\t\tnewCache.Sessions[session.SessionID] = prev\n  1175\t\t\t\t}\n  1176\t\t\t\tcontinue\n  1177\t\t\t}\n  1178\t\t\tif ps.readErr != nil {\n  1179\t\t\t\tpipeCancel()\n  1180\t\t\t\treturn nil, fmt.Errorf(\"read canonical transcript %s: %w\", filepath.ToSlash(session.TranscriptPath), ps.readErr)\n  1181\t\t\t}\n  1182\t\t\tensureBranch(branch)\n  1183\t\n  1184\t\t\tsessionsDone++\n  1185\t\t\t// Report once per session, at every exit path, so the running fact count\n  1186\t\t\t// includes the session just processed (an emit at session start would lag\n  1187\t\t\t// by one session and always show 0 for a single-session run).\n  1188\t\t\treportProgress := func() {\n  1189\t\t\t\tif distillOpts.progress != nil {\n  1190\t\t\t\t\tdistillOpts.progress(distillProgress{SessionsDone: sessionsDone, SessionsTotal: totalSessions, Branch: branch, Facts: factsFound})\n  1191\t\t\t\t}\n  1192\t\t\t}\n  1193\t\t\tpreprocessedBytes += int64(ps.preBytes)\n  1194\t\t\tcandidateBytes += int64(ps.candidateBytes)\n  1195\t\t\tif ps.cached {\n  1196\t\t\t\tcacheHits++\n  1197\t\t\t\tnewCache.Sessions[distillSessionCacheKeyForPipeline(pipeline, branch, session.SessionID)] = ps.fingerprint // unchanged; retain in cache and keep existing facts\n  1198\t\t\t\treportProgress()\n  1199\t\t\t\tcontinue\n  1200\t\t\t}\n  1201\t\n  1202\t\t\tsessionFailed := false\n  1203\t\t\tfor chunkIdx, chunk := range ps.chunks {\n  1204\t\t\t\tchunksScanned++\n  1205\t\t\t\tanchor := factAnchor{\n  1206\t\t\t\t\tSessionID:    session.SessionID,\n  1207\t\t\t\t\tCheckpointID: session.LatestCheckpoint,\n  1208\t\t\t\t\tTranscript:   filepath.ToSlash(session.TranscriptPath),\n  1209\t\t\t\t\tLine:         chunk.StartLine,\n  1210\t\t\t\t}\n  1211\t\t\t\tif pipeline == distillPipelineCandidates {\n  1212\t\t\t\t\tanchor.EndLine = chunk.EndLine\n  1213\t\t\t\t\tanchor.DistillTurnID = chunk.DistillTurnID\n  1214\t\t\t\t}\n  1215\t\t\t\textractionStarted := time.Now()\n  1216\t\t\t\tout, runErr := ps.result(chunkIdx)\n  1217\t\t\t\textractionSeconds += time.Since(extractionStarted).Seconds()\n  1218\t\t\t\textractionAgentCalls++\n  1219\t\t\t\tcallsSinceFlush++\n  1220\t\t\t\tif runErr != nil {\n  1221\t\t\t\t\tif pipeline == distillPipelineCandidates {\n  1222\t\t\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"candidate extraction failed for %s:%d\", session.SessionID, chunk.StartLine))\n  1223\t\t\t\t\t} else {\n  1224\t\t\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"agent failed on %s:%d: %v\", session.SessionID, chunk.StartLine, runErr))\n  1225\t\t\t\t\t}\n  1226\t\t\t\t\tsessionFailed = true\n  1227\t\t\t\t\tfailedChunks++\n  1228\t\t\t\t\tagentFailures++\n  1229\t\t\t\t\t// Fail fast on a misconfiguration: nothing has distilled yet and the\n  1230\t\t\t\t\t// agent keeps failing, so every call is almost certainly erroring the\n  1231\t\t\t\t\t// same way (bad --model, missing agent, auth). Abort with the agent's\n  1232\t\t\t\t\t// own error instead of churning through every remaining session.\n  1233\t\t\t\t\tif !anyAgentSuccess && agentFailures >= distillAgentAbortThreshold {\n  1234\t\t\t\t\t\tif pipeline == distillPipelineCandidates {\n  1235\t\t\t\t\t\t\treturn nil, fmt.Errorf(\"candidate distill aborted after %d agent failures with no valid response; check --agent, --model, authentication, and executable PATH\", agentFailures)\n  1236\t\t\t\t\t\t}\n  1237\t\t\t\t\t\treturn nil, fmt.Errorf(\"distill aborted after %d agent failures with no facts distilled — check --agent and --model. Last error: %v\", agentFailures, runErr)\n  1238\t\t\t\t\t}\n  1239\t\t\t\t\t// Flush on the failure path too: a long failure streak (rate\n  1240\t\t\t\t\t// limiting, timeouts) is exactly when a run tends to get killed,\n  1241\t\t\t\t\t// and skipping the flush here would leave pre-streak facts\n  1242\t\t\t\t\t// unpersisted for the streak's entire duration.\n  1243\t\t\t\t\tif err := maybeFlush(); err != nil {\n  1244\t\t\t\t\t\treturn nil, err\n  1245\t\t\t\t\t}\n  1246\t\t\t\t\tcontinue\n  1247\t\t\t\t}\n  1248\t\t\t\trecords, chunkWarnings := distilledFactsFromOutput(out, taxonomy, anchor, branch, now)\n  1249\t\t\t\t// Sharpen provenance where the entity index can place the fact's\n  1250\t\t\t\t// locus; a no-op (and never an error) when the index is absent.\n  1251\t\t\t\trecords = applyEntityProvenance(records, distillOpts.entityProvenance)\n  1252\t\t\t\tif pipeline == distillPipelineCandidates {\n  1253\t\t\t\t\tif !candidateDistillOutputIsProtocolComplete(out) || len(chunkWarnings) > 0 {\n  1254\t\t\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"candidate output at %s:%d violated the extraction protocol\", session.SessionID, chunk.StartLine))\n  1255\t\t\t\t\t\tsessionFailed = true\n  1256\t\t\t\t\t\tfailedChunks++\n  1257\t\t\t\t\t\tagentFailures++\n  1258\t\t\t\t\t\tif !anyAgentSuccess && agentFailures >= distillAgentAbortThreshold {\n  1259\t\t\t\t\t\t\treturn nil, fmt.Errorf(\"candidate distill aborted after %d invalid agent responses with no protocol-valid response; check --agent and --model\", agentFailures)\n  1260\t\t\t\t\t\t}\n  1261\t\t\t\t\t\tif err := maybeFlush(); err != nil {\n  1262\t\t\t\t\t\t\treturn nil, err\n  1263\t\t\t\t\t\t}\n  1264\t\t\t\t\t\tcontinue\n  1265\t\t\t\t\t}\n  1266\t\t\t\t\tanyAgentSuccess = true\n  1267\t\t\t\t\tvar removed bool\n  1268\t\t\t\t\tbyBranch[branch], removed = removeRelocatedDistillAnchors(byBranch[branch], anchor)\n  1269\t\t\t\t\tif removed {\n  1270\t\t\t\t\t\tdirtyBranches[branch] = true\n  1271\t\t\t\t\t}\n  1272\t\t\t\t} else {\n  1273\t\t\t\t\tanyAgentSuccess = true\n  1274\t\t\t\t\twarnings = append(warnings, chunkWarnings...)\n  1275\t\t\t\t}\n  1276\t\t\t\tif len(records) == 0 {\n  1277\t\t\t\t\tif err := maybeFlush(); err != nil {\n  1278\t\t\t\t\t\treturn nil, err\n  1279\t\t\t\t\t}\n  1280\t\t\t\t\tcontinue\n  1281\t\t\t\t}\n  1282\t\t\t\tfactsFound += len(records)\n  1283\t\t\t\tchunksDistilled++\n  1284\t\t\t\tvar actions []factAction\n  1285\t\t\t\tif pipeline == distillPipelineCandidates {\n  1286\t\t\t\t\t// Candidate v1 is fail-conservative: exact fact IDs collapse in\n  1287\t\t\t\t\t// factmerge.Upsert, while every non-identical statement remains a\n  1288\t\t\t\t\t// separate fact. It never asks a model to infer identity or\n  1289\t\t\t\t\t// supersession from a shared taxonomy path.\n  1290\t\t\t\t\tactions = newDistilledFactActions(records)\n  1291\t\t\t\t} else {\n  1292\t\t\t\t\t// Legacy reconciliation remains available unchanged while the\n  1293\t\t\t\t\t// candidate pipeline is evaluated in shadow/opt-in runs.\n  1294\t\t\t\t\treconcileCalled := false\n  1295\t\t\t\t\tcountingReconcileRun := func(ctx context.Context, dir string, args []string, input []byte, timeout time.Duration) (string, error) {\n  1296\t\t\t\t\t\treconcileCalled = true\n  1297\t\t\t\t\t\treturn distillOpts.run(ctx, dir, args, input, timeout)\n  1298\t\t\t\t\t}\n  1299\t\t\t\t\treconcileStarted := time.Now()\n  1300\t\t\t\t\tvar recWarnings []string\n  1301\t\t\t\t\tactions, recWarnings = reconcileChunkCandidates(ctx, countingReconcileRun, reconcileArgs, records, byBranch[branch], repoDir, distillOpts.timeout)\n  1302\t\t\t\t\tif reconcileCalled {\n  1303\t\t\t\t\t\treconcileAgentCalls++\n  1304\t\t\t\t\t\treconcileSeconds += time.Since(reconcileStarted).Seconds()\n  1305\t\t\t\t\t}\n  1306\t\t\t\t\twarnings = append(warnings, recWarnings...)\n  1307\t\t\t\t\t// Preserve the legacy flush cadence: a candidate-bearing chunk\n  1308\t\t\t\t\t// advances the interval even when reconciliation resolves locally.\n  1309\t\t\t\t\tcallsSinceFlush++\n  1310\t\t\t\t}\n  1311\t\t\t\tvar chunkProposals []factProposal\n  1312\t\t\t\tbyBranch[branch], chunkProposals = applyFactActions(byBranch[branch], actions, threshold, now)\n  1313\t\t\t\tproposalsByBranch[branch] = append(proposalsByBranch[branch], chunkProposals...)\n  1314\t\t\t\tdirtyBranches[branch] = true\n  1315\t\t\t\tif err := maybeFlush(); err != nil {\n  1316\t\t\t\t\treturn nil, err\n  1317\t\t\t\t}\n  1318\t\t\t}\n  1319\t\t\tif ps.release != nil {\n  1320\t\t\t\tps.release() // free the work-lookahead slot: chunks fully consumed\n  1321\t\t\t}\n  1322\t\t\t// Only cache a session as distilled when every chunk succeeded, so a\n  1323\t\t\t// session whose agent calls failed is retried on the next run rather\n  1324\t\t\t// than being silently treated as done.\n  1325\t\t\tif !sessionFailed {\n  1326\t\t\t\tif pipeline == distillPipelineCandidates {\n  1327\t\t\t\t\tcurrent := make(map[string]bool, len(ps.chunks))\n  1328\t\t\t\t\tfor _, chunk := range ps.chunks {\n  1329\t\t\t\t\t\tif chunk.DistillTurnID != \"\" {\n  1330\t\t\t\t\t\t\tcurrent[chunk.DistillTurnID] = true\n  1331\t\t\t\t\t\t}\n  1332\t\t\t\t\t}\n  1333\t\t\t\t\tvar removed bool\n  1334\t\t\t\t\tbyBranch[branch], removed = removeMissingDistillTurnAnchors(byBranch[branch], factAnchor{\n  1335\t\t\t\t\t\tSessionID:  session.SessionID,\n  1336\t\t\t\t\t\tTranscript: filepath.ToSlash(session.TranscriptPath),\n  1337\t\t\t\t\t}, current)\n  1338\t\t\t\t\tif removed {\n  1339\t\t\t\t\t\tdirtyBranches[branch] = true\n  1340\t\t\t\t\t}\n  1341\t\t\t\t}\n  1342\t\t\t\tnewCache.Sessions[distillSessionCacheKeyForPipeline(pipeline, branch, session.SessionID)] = ps.fingerprint\n  1343\t\t\t}\n  1344\t\t\treportProgress()\n  1345\t\t}\n  1346\t\tif err := ctx.Err(); err != nil {\n  1347\t\t\treturn nil, err\n  1348\t\t}\n  1349\t\tif agentFailures > 0 && !anyAgentSuccess {\n  1350\t\t\treturn nil, fmt.Errorf(\n  1351\t\t\t\t\"distill aborted after all %d agent calls failed with no successful response; check --agent, --model, authentication, and executable PATH\",\n  1352\t\t\t\tagentFailures,\n  1353\t\t\t)\n  1354\t\t}\n  1355\t\twarnings = capWarnings(warnings, maxDistillWarnings)\n  1356\t\n  1357\t\twriteStarted := time.Now()\n  1358\t\tvar source *factSourceManifest\n  1359\t\terr = withBrainWriteLock(brainDir, func() error {\n  1360\t\t\tif err := flushFactStoresLocked(true); err != nil {\n  1361\t\t\t\treturn err\n  1362\t\t\t}\n  1363\t\t\tif err := writeFactTaxonomy(brainDir, taxonomy); err != nil {\n  1364\t\t\t\treturn err\n  1365\t\t\t}\n  1366\t\n  1367\t\t\t// Summarize the manifest from the whole on-disk store, not just the branches\n  1368\t\t\t// touched this run. A branch-limited (`--branch`) or incremental run only\n  1369\t\t\t// loads a subset into byBranch; folding that subset into the manifest would\n  1370\t\t\t// drop counts/branches/proposals for facts that still exist on other\n  1371\t\t\t// branches. Re-reading the store after writing keeps sources.facts whole.\n  1372\t\t\tallBranches, err := loadAllFactBranches(brainDir)\n  1373\t\t\tif err != nil {\n  1374\t\t\t\treturn err\n  1375\t\t\t}\n  1376\t\t\tbranchNames := make([]string, 0, len(allBranches))\n  1377\t\t\tfor branch := range allBranches {\n  1378\t\t\t\tbranchNames = append(branchNames, branch)\n  1379\t\t\t}\n  1380\t\t\ttotalProposals := countFactProposals(brainDir, branchNames)\n  1381\t\n  1382\t\t\tsource = summarizeFactSource(now, allBranches, chunksScanned, chunksDistilled, totalProposals, warnings)\n  1383\t\t\tsource.CacheHits = cacheHits\n  1384\t\t\tsource.FailedChunks = failedChunks\n  1385\t\t\tsource.PreprocessedBytes = preprocessedBytes\n  1386\t\t\tsource.CandidateBytes = candidateBytes\n  1387\t\t\tsource.Agent = strings.TrimSpace(distillOpts.agent)\n  1388\t\t\tsource.Model = strings.TrimSpace(distillOpts.model)\n  1389\t\t\tsource.Effort = strings.TrimSpace(distillOpts.effort)\n  1390\t\t\tsource.Pipeline = pipeline\n  1391\t\t\tsource.Branch = strings.TrimSpace(distillOpts.branch)\n  1392\t\t\tsource.Force = distillOpts.force\n  1393\t\t\tsource.Jobs = distillRequestedJobs(distillOpts)\n  1394\t\t\tsource.ExtractionJobsCap = distillEffectiveExtractionJobs(extractionAgentCalls, distillOpts)\n  1395\t\t\tsource.MaxChunkBytes = distillMaxChunkBytes(distillOpts)\n  1396\t\t\tsource.Confidence = threshold\n  1397\t\t\tsource.ExtractionCalls = extractionAgentCalls\n  1398\t\t\tsource.ReconcileCalls = reconcileAgentCalls\n  1399\t\t\tsource.TotalAgentCalls = extractionAgentCalls + reconcileAgentCalls\n  1400\t\t\tsource.TokenUsage = usageCollector.summary(source.TotalAgentCalls)\n  1401\t\t\tsource.ExtractionWaitSeconds = extractionSeconds\n  1402\t\t\tsource.ReconcileSeconds = reconcileSeconds\n  1403\t\t\tsource.WriteSeconds = time.Since(writeStarted).Seconds()\n  1404\t\t\tsource.TotalSeconds = time.Since(runStarted).Seconds()\n  1405\t\t\t// Provider work may run for hours. Patch only the facts source while the\n  1406\t\t\t// manifest-leaf lock covers load-through-replace, so a semantic/session/\n  1407\t\t\t// seed writer cannot commit between a stale reload and this publication.\n  1408\t\t\treturn updateBrainManifestAndReadme(brainDir, func(currentManifest *exportManifest) error {\n  1409\t\t\t\tif currentManifest.Sources == nil {\n  1410\t\t\t\t\tcurrentManifest.Sources = &brainSources{}\n  1411\t\t\t\t}\n  1412\t\t\t\t// Manifest schema v3 is decoded strictly by released binaries. Keep\n  1413\t\t\t\t// candidate-only observability in this command's returned summary and\n  1414\t\t\t\t// dry-run report until it has a separately versioned durable leaf; an\n  1415\t\t\t\t// unversioned field addition would make binary rollback impossible.\n  1416\t\t\t\tpersistedSource := *source\n  1417\t\t\t\tpersistedSource.CandidateBytes = 0\n  1418\t\t\t\tpersistedSource.CandidateCards = 0\n  1419\t\t\t\tpersistedSource.CandidateSessions = 0\n  1420\t\t\t\tpersistedSource.CandidatePacks = 0\n  1421\t\t\t\tpersistedSource.CandidatePacksDone = 0\n  1422\t\t\t\tpersistedSource.CandidateMembers = 0\n  1423\t\t\t\tpersistedSource.CandidateCacheHits = 0\n  1424\t\t\t\tpersistedSource.CandidateCacheMisses = 0\n  1425\t\t\t\tpersistedSource.CandidateSplitCalls = 0\n  1426\t\t\t\tpersistedSource.CandidateEmptyResults = 0\n  1427\t\t\t\tpersistedSource.Pipeline = \"\"\n  1428\t\t\t\tpersistedSource.Shadow = false\n  1429\t\t\t\tpersistedSource.ShadowFacts = 0\n  1430\t\t\t\tcurrentManifest.Sources.Facts = &persistedSource\n  1431\t\t\t\tif currentManifest.GeneratedAt.IsZero() {\n  1432\t\t\t\t\tcurrentManifest.GeneratedAt = now\n  1433\t\t\t\t}\n  1434\t\t\t\treturn nil\n  1435\t\t\t})\n     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"crypto/sha256\"\n     6\t\t\"encoding/hex\"\n     7\t\t\"encoding/json\"\n     8\t\t\"errors\"\n     9\t\t\"fmt\"\n    10\t\t\"os\"\n    11\t\t\"path/filepath\"\n    12\t\t\"sort\"\n    13\t\t\"strings\"\n    14\t\t\"time\"\n    15\t\n    16\t\t\"github.com/ashtom/entire-brain/internal/factmerge\"\n    17\t)\n    18\t\n    19\tconst (\n    20\t\tfactsDirName          = \"facts\"\n    21\t\tfactsTaxonomyFileName = \"taxonomy.json\"\n    22\t\tfactsTaxonomyPath     = factsDirName + \"/\" + factsTaxonomyFileName\n    23\t\tfactsFileName         = \"facts.ndjson\"\n    24\t\tfactsMaxPerChunk      = 6 // quality-gate output cap per source chunk\n    25\t\n    26\t\tfactOriginDistilled = \"distilled\"\n    27\t\tfactOriginAuthored  = \"authored\"\n    28\t)\n    29\t\n    30\t// factSourceManifest is recorded under sources.facts in the brain manifest,\n    31\t// parallel to historySourceManifest and the semantic source metadata.\n    32\ttype factSourceManifest struct {\n    33\t\tGeneratedAt           time.Time                 `json:\"generated_at\"`\n    34\t\tTaxonomyPath          string                    `json:\"taxonomy_path\"`\n    35\t\tBranches              []string                  `json:\"branches,omitempty\"`\n    36\t\tFacts                 int                       `json:\"facts\"`\n    37\t\tDistilled             int                       `json:\"distilled\"`\n    38\t\tAuthored              int                       `json:\"authored\"`\n    39\t\tSuperseded            int                       `json:\"superseded\"`\n    40\t\tProposals             int                       `json:\"proposals\"`\n    41\t\tVerified              int                       `json:\"verified\"`\n    42\t\tUnsigned              int                       `json:\"unsigned\"`\n    43\t\tByKind                map[string]int            `json:\"by_kind,omitempty\"`\n    44\t\tChunksScanned         int                       `json:\"chunks_scanned\"`\n    45\t\tChunksDistilled       int                       `json:\"chunks_distilled\"`\n    46\t\tCacheHits             int                       `json:\"cache_hits,omitempty\"`\n    47\t\tFailedChunks          int                       `json:\"failed_chunks,omitempty\"`\n    48\t\tPreprocessedBytes     int64                     `json:\"preprocessed_bytes,omitempty\"`\n    49\t\tCandidateBytes        int64                     `json:\"candidate_bytes,omitempty\"`\n    50\t\tCandidateCards        int                       `json:\"candidate_cards,omitempty\"`\n    51\t\tCandidateSessions     int                       `json:\"candidate_sessions,omitempty\"`\n    52\t\tCandidatePacks        int                       `json:\"candidate_packs,omitempty\"`\n    53\t\tCandidatePacksDone    int                       `json:\"candidate_packs_completed,omitempty\"`\n    54\t\tCandidateMem…171 tokens truncated…json:\"effort,omitempty\"`\n    62\t\tPipeline              string                    `json:\"pipeline,omitempty\"`\n    63\t\tBranch                string                    `json:\"branch,omitempty\"`\n    64\t\tForce                 bool                      `json:\"force,omitempty\"`\n    65\t\tJobs                  int                       `json:\"jobs,omitempty\"`\n    66\t\tExtractionJobsCap     int                       `json:\"extraction_jobs_cap,omitempty\"`\n    67\t\tMaxChunkBytes         int                       `json:\"max_chunk_bytes,omitempty\"`\n    68\t\tConfidence            float64                   `json:\"confidence_threshold,omitempty\"`\n    69\t\tExtractionCalls       int                       `json:\"extraction_agent_calls,omitempty\"`\n    70\t\tReconcileCalls        int                       `json:\"reconcile_agent_calls,omitempty\"`\n    71\t\tTotalAgentCalls       int                       `json:\"total_agent_calls,omitempty\"`\n    72\t\tTokenUsage            *distillTokenUsageSummary `json:\"token_usage,omitempty\"`\n    73\t\t// ExtractionWaitSeconds is the consumer's WAIT on prefetched results, not\n    74\t\t// agent compute: with concurrency > 1, calls completing in the background\n    75\t\t// register ~0s here. Compare total_seconds across --jobs settings for\n    76\t\t// scheduling claims.\n    77\t\tExtractionWaitSeconds float64  `json:\"extraction_wait_seconds,omitempty\"`\n    78\t\tReconcileSeconds      float64  `json:\"reconcile_seconds,omitempty\"`\n    79\t\tWriteSeconds          float64  `json:\"write_seconds,omitempty\"`\n    80\t\tTotalSeconds          float64  `json:\"total_seconds,omitempty\"`\n    81\t\tWarnings              []string `json:\"warnings,omitempty\"`\n    82\t\t// Shadow and ShadowFacts are command-result-only Phase 2 evidence. They\n    83\t\t// are cleared before any schema-v3 manifest publication.\n    84\t\tShadow      bool `json:\"shadow,omitempty\"`\n    85\t\tShadowFacts int  `json:\"shadow_facts,omitempty\"`\n    86\t}\n    87\t\n    88\t// factRecord (factmerge.Record) and factAnchor (factmerge.Anchor) are defined\n    89\t// as type aliases in facts_aliases.go; the durable-fact data model now lives in\n    90\t// internal/factmerge.\n    91\t\n    92\t// factTaxonomy is the active taxonomy snapshot. Paths are validated against\n    93\t// factPathPattern; classification may only invent a new three-level path under\n    94\t// an existing top-level category.\n    95\ttype factTaxonomy struct {\n    96\t\tGeneratedAt time.Time         `json:\"generated_at\"`\n    97\t\tCategories  map[string]string `json:\"categories\"` // top-level -> description\n    98\t\tPaths       []factPathDef     `json:\"paths\"`\n    99\t}\n   100\t\n   101\ttype factPathDef struct {\n   102\t\tPath        string   `json:\"path\"`\n   103\t\tDescription string   `json:\"description\"`\n   104\t\tExamples    []string `json:\"examples,omitempty\"`\n   105\t}\n   106\t\n   107\t// normalizeFactText, factRecordID, validFactPath, and normalizeFactPaths moved\n   108\t// to internal/factmerge (NormalizeText/RecordID/ValidPath/NormalizePaths); the\n   109\t// CLI names are forwarding wrappers in facts_aliases.go.\n   110\t\n   111\t// factTopLevel returns the top-level category of a taxonomy path (the segment\n   112\t// before the first dot), or \"\" if the path is empty.\n   113\tfunc factTopLevel(path string) string {\n   114\t\tif i := strings.IndexByte(path, '.'); i >= 0 {\n   115\t\t\treturn path[:i]\n   116\t\t}\n   117\t\treturn path\n   118\t}\n   119\t\n   120\t// --- on-disk layout -------------------------------------------------------\n   121\t\n   122\t// factsBranchRelDir returns the brain-relative directory holding a branch's\n   123\t// facts. The readable slug alone is not collision-free — distinct branches can\n   124\t// sanitize to the same slug (e.g. \"evis/search\" and \"evis-search\", or \"Main\"\n   125\t// and \"main\") — and two branches sharing a facts file would clobber each other\n   126\t// and break branch isolation. A short hash of the full branch name is appended\n   127\t// so each branch maps to a stable, unique directory while staying greppable.\n   128\tfunc factsBranchRelDir(branch string) string {\n   129\t\tslug := safePathComponent(branch, \"branch\", 80)\n   130\t\tsum := sha256.Sum256([]byte(branch))\n   131\t\treturn filepath.ToSlash(filepath.Join(factsDirName, slug+\"-\"+hex.EncodeToString(sum[:4])))\n   132\t}\n   133\t\n   134\tfunc factsFileRelPath(branch string) string {\n   135\t\treturn filepath.ToSlash(filepath.Join(factsBranchRelDir(branch), factsFileName))\n   136\t}\n   137\t\n   138\t// loadFacts reads a branch's facts.ndjson. A missing file is not an error: it\n   139\t// yields an empty slice so first-run callers do not special-case it. Blank\n   140\t// lines are skipped; a malformed line is a hard error so a corrupt store is\n   141\t// surfaced rather than silently dropping records.\n   142\tfunc loadFacts(brainDir, branch string) ([]factRecord, error) {\n   143\t\tpath := filepath.Join(brainDir, filepath.FromSlash(factsFileRelPath(branch)))\n   144\t\treturn parseFactsFile(path)\n   145\t}\n   146\t\n   147\t// parseFactsFile reads a facts.ndjson file at an absolute path. A missing file\n   148\t// yields an empty slice; a malformed line is a hard error so a corrupt store is\n   149\t// surfaced rather than silently dropping records. The byte-level scan lives in\n   150\t// factmerge.ParseNDJSON; this keeps only the file/path handling and restores the\n   151\t// historical \"parse <file> line N: ...\" message the core cannot know the path\n   152\t// for.\n   153\tfunc parseFactsFile(path string) ([]factRecord, error) {\n   154\t\tf, err := os.Open(path)\n   155\t\tif err != nil {\n   156\t\t\tif os.IsNotExist(err) {\n   157\t\t\t\treturn nil, nil\n   158\t\t\t}\n   159\t\t\treturn nil, err\n   160\t\t}\n   161\t\tdefer f.Close()\n   162\t\trecords, err := factmerge.ParseNDJSON(f)\n   163\t\tif err != nil {\n   164\t\t\tvar perr *factmerge.ParseError\n   165\t\t\tif errors.As(err, &perr) {\n   166\t\t\t\treturn nil, fmt.Errorf(\"parse %s line %d: %w\", filepath.Base(path), perr.Line, perr.Err)\n   167\t\t\t}\n   168\t\t\treturn nil, err\n   169\t\t}\n   170\t\treturn records, nil\n   171\t}\n   172\t\n   173\t// writeFacts persists a branch's facts as newline-delimited JSON, one record\n   174\t// per line, sorted deterministically so the file is stable across rebuilds and\n   175\t// diffs cleanly. The branch directory is created if needed. The byte-level\n   176\t// sort+marshal lives in factmerge.WriteNDJSON; this keeps the atomic,\n   177\t// symlink-rejecting disk write in the CLI.\n   178\tfunc writeFacts(brainDir, branch string, records []factRecord) error {\n   179\t\tvar buf bytes.Buffer\n   180\t\tif err := factmerge.WriteNDJSON(&buf, records); err != nil {\n   181\t\t\treturn err\n   182\t\t}\n   183\t\treturn writeBrainRelativeFileAtomic(brainDir, factsFileRelPath(branch), buf.Bytes(), 0o600)\n   184\t}\n   185\t\n   186\t// --- taxonomy -------------------------------------------------------------\n   187\t\n   188\t// defaultFactTaxonomy is the shipped baseline taxonomy. The top-level\n   189\t// categories here are fixed in Phase A; distillation may invent a new\n   190\t// three-level path only under one of these categories. The brain regenerates\n   191\t// taxonomy.json from this default on refresh.\n   192\tfunc defaultFactTaxonomy(now time.Time) factTaxonomy {\n   193\t\treturn factTaxonomy{\n   194\t\t\tGeneratedAt: now,\n   195\t\t\tCategories: map[string]string{\n   196\t\t\t\t\"preferences\":  \"How the user wants to work and how code should be written.\",\n   197\t\t\t\t\"architecture\": \"Resolved design, boundary, and data-flow decisions and their rationale.\",\n   198\t\t\t\t\"project\":      \"Stack, tooling, CI/CD, ownership, and standing project facts.\",\n   199\t\t\t\t\"workflow\":     \"Branching, testing, review, and release process rules.\",\n   200\t\t\t\t\"constraints\":  \"Non-obvious invariants, gotchas, and hard constraints.\",\n   201\t\t\t},\n   202\t\t\tPaths: []factPathDef{\n   203\t\t\t\t{Path: \"preferences.coding.style\", Description: \"Stated code-style preferences.\", Examples: []string{\"prefers table-driven tests\"}},\n   204\t\t\t\t{Path: \"preferences.workflow.general\", Description: \"How the user prefers to work day to day.\"},\n   205\t\t\t\t{Path: \"architecture.boundaries.rationale\", Description: \"Why a module or package boundary exists.\"},\n   206\t\t\t\t{Path: \"architecture.data.flow\", Description: \"How data moves through the system.\"},\n   207\t\t\t\t{Path: \"project.tooling.stack\", Description: \"Languages, frameworks, and tools the project uses.\"},\n   208\t\t\t\t{Path: \"project.ci_cd.pipeline\", Description: \"Build, test, and deploy pipeline facts.\"},\n   209\t\t\t\t{Path: \"workflow.branching.rules\", Description: \"Branching and merge conventions.\"},\n   210\t\t\t\t{Path: \"workflow.testing.rules\", Description: \"How and when tests must be run.\"},\n     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"context\"\n     5\t\t\"encoding/json\"\n     6\t\t\"fmt\"\n     7\t\t\"math\"\n     8\t\t\"os\"\n     9\t\t\"path/filepath\"\n    10\t\t\"sort\"\n    11\t\t\"strconv\"\n    12\t\t\"strings\"\n    13\t\t\"time\"\n    14\t)\n    15\t\n    16\tconst factsProposalsFileName = \"proposals.ndjson\"\n    17\t\n    18\tfunc factsProposalsRelPath(branch string) string {\n    19\t\treturn filepath.ToSlash(filepath.Join(factsBranchRelDir(branch), factsProposalsFileName))\n    20\t}\n    21\t\n    22\t// loadFactProposals reads a branch's pending proposals; a missing file yields\n    23\t// none. A malformed line is a hard error so a corrupt queue is surfaced.\n    24\tfunc loadFactProposals(brainDir, branch string) ([]factProposal, error) {\n    25\t\tpath := filepath.Join(brainDir, filepath.FromSlash(factsProposalsRelPath(branch)))\n    26\t\tdata, err := os.ReadFile(path)\n    27\t\tif err != nil {\n    28\t\t\tif os.IsNotExist(err) {\n    29\t\t\t\treturn nil, nil\n    30\t\t\t}\n    31\t\t\treturn nil, err\n    32\t\t}\n    33\t\treturn parseFactProposals(data, factsProposalsRelPath(branch))\n    34\t}\n    35\t\n    36\tfunc parseFactProposals(data []byte, displayPath string) ([]factProposal, error) {\n    37\t\tvar proposals []factProposal\n    38\t\tfor i, line := range strings.Split(string(data), \"\\n\") {\n    39\t\t\tline = strings.TrimSpace(line)\n    40\t\t\tif line == \"\" {\n    41\t\t\t\tcontinue\n    42\t\t\t}\n    43\t\t\tvar p factProposal\n    44\t\t\tif err := json.Unmarshal([]byte(line), &p); err != nil {\n    45\t\t\t\treturn nil, fmt.Errorf(\"parse %s line %d: %w\", displayPath, i+1, err)\n    46\t\t\t}\n    47\t\t\tproposals = append(proposals, p)\n    48\t\t}\n    49\t\treturn proposals, nil\n    50\t}\n    51\t\n    52\t// writeFactProposals persists a branch's pending proposals, deduplicated by\n    53\t// (action, candidate, target) and sorted for a stable file. An empty set\n    54\t// removes the file so a fully-resolved branch leaves no stale queue.\n    55\tfunc writeFactProposals(brainDir, branch string, proposals []factProposal) error {\n    56\t\tcanonical := append([]factProposal(nil), proposals...)\n    57\t\tfor i := range canonical {\n    58\t\t\tcanonical[i].Branch = branch\n    59\t\t}\n    60\t\treturn writeFactProposalsAtRel(brainDir, factsProposalsRelPath(branch), canonical)\n    61\t}\n    62\t\n    63\tfunc writeFactProposalsAtRel(brainDir, rel string, proposals []factProposal) error {\n    64\t\tdeduped := dedupeProposals(proposals)\n    65\t\tif len(deduped) == 0 {\n    66\t\t\treturn removeBrainRelativeFile(brainDir, rel)\n    67\t\t}\n    68\t\tvar buf strings.Builder\n    69\t\tfor _, p := range deduped {\n    70\t\t\tdata, err := json.Marshal(p)\n    71\t\t\tif err != nil {\n    72\t\t\t\treturn err\n    73\t\t\t}\n    74\t\t\tbuf.Write(data)\n    75\t\t\tbuf.WriteByte('\\n')\n    76\t\t}\n    77\t\treturn writeBrainRelativeFileAtomic(brainDir, rel, []byte(buf.String()), 0o600)\n    78\t}\n    79\t\n    80\t// clearDistillOwnedLegacyProposalStore cleans a pre-branch-ownership proposal\n    81\t// file in place. Member-attributed sync proposals survive because distillation\n    82\t// does not own or regenerate them.\n    83\tfunc clearDistillOwnedLegacyProposalStore(brainDir, rel string) error {\n    84\t\tdata, present, err := readMemoryStateFile(brainDir, rel, \"legacy fact proposal store\", defaultMaxReadBytes)\n    85\t\tif err != nil || !present {\n    86\t\t\treturn err\n    87\t\t}\n    88\t\tproposals, err := parseFactProposals(data, rel)\n    89\t\tif err != nil {\n    90\t\t\treturn err\n    91\t\t}\n    92\t\tkept := proposals[:0]\n    93\t\tfor _, proposal := range proposals {\n    94\t\t\tif strings.TrimSpace(proposal.ProposedBy) != \"\" {\n    95\t\t\t\tkept = append(kept, proposal)\n    96\t\t\t}\n    97\t\t}\n    98\t\treturn writeFactProposalsAtRel(brainDir, rel, kept)\n    99\t}\n   100\t\n   101\tfunc dedupeProposals(proposals []factProposal) []factProposal {\n   102\t\tseen := make(map[string]struct{}, len(proposals))\n   103\t\tout := make([]factProposal, 0, len(proposals))\n   104\t\tfor _, p := range proposals {\n   105\t\t\tkey := p.Action + \"\\x00\" + p.CandidateID + \"\\x00\" + p.TargetID\n   106\t\t\tif _, ok := seen[key]; ok {\n   107\t\t\t\tcontinue\n   108\t\t\t}\n   109\t\t\tseen[key] = struct{}{}\n   110\t\t\tout = append(out, p)\n   111\t\t}\n   112\t\tsort.SliceStable(out, func(i, j int) bool {\n   113\t\t\tif out[i].TargetID != out[j].TargetID {\n   114\t\t\t\treturn out[i].TargetID < out[j].TargetID\n   115\t\t\t}\n   116\t\t\treturn out[i].CandidateID < out[j].CandidateID\n   117\t\t})\n   118\t\treturn out\n   119\t}\n   120\t\n   121\tconst (\n   122\t\t// maxReconcileExisting bounds how many existing active facts at a\n   123\t\t// candidate's paths are shown to the agent, keeping the reconcile prompt\n   124\t\t// bounded even on busy paths. When more exist, the most recently updated\n   125\t\t// are shown and the cap is reported as a warning (no silent truncation).\n   126\t\tmaxReconcileExisting = 50\n   127\t)\n   128\t\n   129\t// reconcilePrompt is the static system prompt for the reconcile pass. The\n   130\t// dynamic candidate/existing lists are supplied on stdin (see reconcileInput).\n   260\t// isNumericToken reports whether a token parses as a finite float, used to tell\n   261\t// a trailing confidence value apart from a \"-\" placeholder or missing field.\n   262\t// NaN/±Inf are rejected: ParseFloat accepts them, but a NaN confidence would\n   263\t// silently bypass the low-confidence gate downstream (every comparison with NaN\n   264\t// is false), so they must not be treated as a numeric confidence.\n   265\tfunc isNumericToken(token string) bool {\n   266\t\tvalue, err := strconv.ParseFloat(token, 64)\n   267\t\treturn err == nil && !math.IsNaN(value) && !math.IsInf(value, 0)\n   268\t}\n   269\t\n   270\t// parseConfidence reads a confidence token, clamped to [0,1]; unparseable\n   271\t// values (including NaN/±Inf, which would otherwise slip past the [0,1] clamp\n   272\t// and the auto-apply threshold) default to 0 so an unreadable confidence is\n   273\t// treated as low and queued for review rather than auto-applied.\n   274\tfunc parseConfidence(token string) float64 {\n   275\t\tvalue, err := strconv.ParseFloat(token, 64)\n   276\t\tif err != nil || math.IsNaN(value) || math.IsInf(value, 0) {\n   277\t\t\treturn 0\n   278\t\t}\n   279\t\tif value < 0 {\n   280\t\t\treturn 0\n   281\t\t}\n   282\t\tif value > 1 {\n   283\t\t\treturn 1\n   284\t\t}\n   285\t\treturn value\n   286\t}\n   287\t\n   288\t// activeFactsAtPaths returns the active facts whose paths intersect the given\n   289\t// path set, most-recently-updated first, capped at maxReconcileExisting. The\n   290\t// boolean reports whether the cap dropped any facts.\n   291\tfunc activeFactsAtPaths(records []factRecord, paths []string) ([]factRecord, bool) {\n   292\t\twant := make(map[string]struct{}, len(paths))\n   293\t\tfor _, p := range paths {\n   294\t\t\twant[p] = struct{}{}\n   295\t\t}\n   296\t\tvar matched []factRecord\n   297\t\tfor _, record := range records {\n   298\t\t\tif record.Status != factStatusActive {\n   299\t\t\t\tcontinue\n   300\t\t\t}\n   301\t\t\tfor _, p := range record.Paths {\n   302\t\t\t\tif _, ok := want[p]; ok {\n   303\t\t\t\t\tmatched = append(matched, record)\n   304\t\t\t\t\tbreak\n   305\t\t\t\t}\n   306\t\t\t}\n   307\t\t}\n   308\t\tsort.SliceStable(matched, func(i, j int) bool {\n   309\t\t\tif !matched[i].UpdatedAt.Equal(matched[j].UpdatedAt) {\n   310\t\t\t\treturn matched[i].UpdatedAt.After(matched[j].UpdatedAt)\n   311\t\t\t}\n   312\t\t\treturn matched[i].ID < matched[j].ID\n   313\t\t})\n   314\t\tif len(matched) > maxReconcileExisting {\n   315\t\t\treturn matched[:maxReconcileExisting], true\n   316\t\t}\n   317\t\treturn matched, false\n   318\t}\n   319\t\n   320\t// candidatePathSet returns the sorted union of paths across the candidates.\n   321\tfunc candidatePathSet(candidates []factRecord) []string {\n   322\t\tseen := map[string]struct{}{}\n   323\t\tfor _, c := range candidates {\n   324\t\t\tfor _, p := range c.Paths {\n   325\t\t\t\tseen[p] = struct{}{}\n   326\t\t\t}\n   327\t\t}\n   328\t\tpaths := make([]string, 0, len(seen))\n   329\t\tfor p := range seen {\n   330\t\t\tpaths = append(paths, p)\n   331\t\t}\n   332\t\tsort.Strings(paths)\n   333\t\treturn paths\n   334\t}\n   335\t\n   336\t// newDistilledFactActions is the candidate pipeline's conservative settlement\n   337\t// boundary. Every extracted record is applied as new; factmerge.Upsert still\n   338\t// collapses exact content IDs and unions provenance, but no fuzzy relationship\n   339\t// can silently merge or supersede an unrelated fact. Later candidate-pipeline\n   340\t// versions may enqueue evidence-backed ambiguous pairs for review, but automatic\n   341\t// supersession must never be inferred from taxonomy overlap alone.\n   342\tfunc newDistilledFactActions(candidates []factRecord) []factAction {\n   343\t\tactions := make([]factAction, len(candidates))\n   344\t\tfor i, candidate := range candidates {\n   345\t\t\tactions[i] = factAction{Kind: factActionNew, Confidence: 1, Candidate: candidate}\n   346\t\t}\n   347\t\treturn actions\n   348\t}\n   349\t\n   350\t// removeRelocatedDistillAnchors replaces the entire prior materialization for\n   351\t// the same stable candidate trigger before fresh records are applied. This\n   352\t// removes stale line anchors after transcript layout shifts and stale facts\n   353\t// after a crash/retry produces different wording. Facts corroborated by another\n   354\t// trigger/session retain those independent anchors; a distilled fact that loses\n   355\t// its final anchor is dropped.\n   356\tfunc removeRelocatedDistillAnchors(records []factRecord, source factAnchor) ([]factRecord, bool) {\n   357\t\tif source.SessionID == \"\" || source.DistillTurnID == \"\" {\n   358\t\t\treturn records, false\n   359\t\t}\n   360\t\tout := records[:0]\n   361\t\tchanged := false\n   362\t\tfor index := range records {\n   363\t\t\toriginalAnchors := len(records[index].Provenance)\n   364\t\t\tkept := records[index].Provenance[:0]\n   365\t\t\tfor _, anchor := range records[index].Provenance {\n   366\t\t\t\tif anchor.SessionID != source.SessionID || anchor.DistillTurnID != source.DistillTurnID {\n   367\t\t\t\t\tkept = append(kept, anchor)\n   368\t\t\t\t} else {\n   369\t\t\t\t\tchanged = true\n   370\t\t\t\t}\n   371\t\t\t}\n   372\t\t\trecords[index].Provenance = kept\n   373\t\t\tif originalAnchors > 0 && len(kept) == 0 && records[index].Origin == factOriginDistilled {\n   374\t\t\t\tcontinue\n   375\t\t\t}\n   376\t\t\tout = append(out, records[index])\n   377\t\t}\n   378\t\treturn out, changed\n   379\t}\n   380\t\n   381\tfunc removeMissingDistillTurnAnchors(records []factRecord, source factAnchor, current map[string]bool) ([]factRecord, bool) {\n   382\t\tif source.SessionID == \"\" {\n   383\t\t\treturn records, false\n   384\t\t}\n   385\t\tout := records[:0]\n   386\t\tchanged := false\n   387\t\tfor index := range records {\n   388\t\t\toriginalAnchors := len(records[index].Provenance)\n   389\t\t\tkept := records[index].Provenance[:0]\n   390\t\t\tfor _, anchor := range records[index].Provenance {\n   391\t\t\t\tstale := anchor.SessionID == source.SessionID && anchor.DistillTurnID != \"\" && !current[anchor.DistillTurnID]\n   392\t\t\t\tif stale {\n   393\t\t\t\t\tchanged = true\n   394\t\t\t\t\tcontinue\n   395\t\t\t\t}\n   396\t\t\t\tkept = append(kept, anchor)\n   397\t\t\t}\n   398\t\t\trecords[index].Provenance = kept\n   399\t\t\tif originalAnchors > 0 && len(kept) == 0 && records[index].Origin == factOriginDistilled {\n   400\t\t\t\tcontinue\n   401\t\t\t}\n   402\t\t\tout = append(out, records[index])\n   403\t\t}\n   404\t\treturn out, changed\n   405\t}\n   406\t\n   407\t// reconcileChunkCandidates resolves a chunk's candidates against the current\n   408\t// active set: when no existing facts share the candidates' paths, every\n   409\t// candidate is trivially `new` (no agent call); otherwise the agent decides.\n   410\t// An agent error falls back to treating all candidates as `new` so facts are\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a02fb8-5db4-77e3-a158-975075162964"}}}
