zeDistillTranscriptV1 turns the supported Codex, Claude, Pi, and\n   173\t// OpenCode transcript dialects into typed visible narrative. It intentionally\n   174\t// has no plain-text fallback: an untyped line cannot prove its role or that it\n   175\t// is not tool/system mechanics.\n   176\tfunc normalizeDistillTranscriptV1(session exportSession, resolvedBranch, content string) distillNormalizedTranscriptV1 {\n   177\t\tbranch := strings.TrimSpace(resolvedBranch)\n   178\t\tif branch == \"\" {\n   179\t\t\tbranch = strings.TrimSpace(session.Branch)\n   180\t\t}\n  1370\t\t\t\t\tbounded.Turns[index].Text = card.Turns[index].Text\n  1371\t\t\t\t\tcontinue\n  1372\t\t\t\t}\n  1373\t\t\t\tvar cues []distillCandidateCueV1\n  1374\t\t\t\tfor _, trigger := range card.Triggers {\n  1375\t\t\t\t\tif trigger.TurnID == bounded.Turns[index].ID {\n  1376\t\t\t\t\t\tcues = trigger.Cues\n  1377\t\t\t\t\t\tbreak\n  1378\t\t\t\t\t}\n  1379\t\t\t\t}\n  1380\t\t\t\tif bounded.Turns[index].Role == distillTranscriptRoleAssistantV1 && distillCandidateCardHasCueV1(card, distillCandidateCueAcceptanceV1) {\n  1381\t\t\t\t\tbounded.Turns[index].Text = boundDistillCandidateTextHeadTailV1(card.Turns[index].Text, maxRunes)\n  1382\t\t\t\t} else {\n  1383\t\t\t\t\tbounded.Turns[index].Text = boundDistillCandidateTextV1(card.Turns[index].Text, cues, maxRunes)\n  1384\t\t\t\t}\n  1385\t\t\t}\n  1386\t\t\tif rendered := renderDistillCandidateCardV1(bounded); len(rendered) <= maxBytes {\n  1387\t\t\t\treturn rendered, nil\n  1388\t\t\t}\n  1389\t\t}\n  1390\t\treturn \"\", fmt.Errorf(\"candidate %s cannot fit within %d rendered bytes\", card.ID, maxBytes)\n  1391\t}\n  1392\t\n  1393\tfunc distillCandidateTurnIsTriggerV1(card distillCandidateCardV1, turnID string) bool {\n  1394\t\tfor _, trigger := range card.Triggers {\n  1395\t\t\tif trigger.TurnID == turnID {\n  1396\t\t\t\treturn true\n  1397\t\t\t}\n  1398\t\t}\n  1399\t\treturn false\n  1400\t}\n  1401\t\n  1402\tfunc distillCandidateCardHasCueV1(card distillCandidateCardV1, cue distillCandidateCueV1) bool {\n  1403\t\tfor _, trigger := range card.Triggers {\n  1404\t\t\tif distillCandidateCueSliceContainsV1(trigger.Cues, cue) {\n  1405\t\t\t\treturn true\n  1406\t\t\t}\n  1407\t\t}\n  1408\t\treturn false\n  1409\t}\n  1410\t\n  1411\t// packDistillCandidateCardsV1 deterministically sorts cards and emits exactly\n  1412\t// one bounded card per batch. It never exceeds maxBytes: context is reduced\n  1413\t// around the trigger until the rendered JSON fits, or planning fails closed.\n  1414\tfunc packDistillCandidateCardsV1(cards []distillCandidateCardV1, maxBytes int) ([]distillCandidateBatchV1, error) {\n  1415\t\tif len(cards) == 0 {\n  1416\t\t\treturn nil, nil\n  1417\t\t}\n  1418\t\tif maxBytes <= 0 {\n  1419\t\t\tmaxBytes = defaultDistillChunkSize\n  1420\t\t}\n  1421\t\tif maxBytes < distillCandidateMinChunkBytes {\n  1422\t\t\treturn nil, fmt.Errorf(\"candidate pipeline requires at least %d --max-chunk-bytes\", distillCandidateMinChunkBytes)\n  1423\t\t}\n  1424\t\tordered := append([]distillCandidateCardV1(nil), cards...)\n  1425\t\tsort.SliceStable(ordered, func(i, j int) bool {\n  1426\t\t\tleft, right := ordered[i], ordered[j]\n  1427\t\t\tleftSource, rightSource := distillCandidateSourceIdentityV1(left.Source), distillCandidateSourceIdentityV1(right.Source)\n  1428\t\t\tif leftSource != rightSource {\n  1429\t\t\t\treturn leftSource < rightSource\n  1430\t\t\t}\n  1431\t\t\tif left.StartLine != right.StartLine {\n  1432\t\t\t\treturn left.StartLine < right.StartLine\n  1433\t\t\t}\n  1434\t\t\treturn left.ID < right.ID\n  1435\t\t})\n  1436\t\n  1437\t\tbatches := make([]distillCandidateBatchV1, 0, len(ordered))\n  1438\t\tfor _, card := range ordered {\n  1439\t\t\trendered, err := renderBoundedDistillCandidateCardV1(card, maxBytes)\n  1440\t\t\tif err != nil {\n  1441\t\t\t\treturn nil, err\n  1442\t\t\t}\n  1443\t\t\tanchor := distillCandidateAnchorV1{\n  1444\t\t\t\tCandidateID:  card.ID,\n  1445\t\t\t\tSessionID:    card.Source.SessionID,\n  1446\t\t\t\tCheckpointID: card.Source.LatestCheckpoint,\n  1447\t\t\t\tBranch:       card.Source.Branch,\n  1448\t\t\t\tTranscript:   card.Source.Transcript,\n  1449\t\t\t\tStartLine:    card.StartLine,\n  1450\t\t\t\tEndLine:      card.EndLine,\n  1451\t\t\t}\n  1452\t\t\ttriggerLine := distillCandidateTriggerLineV1(card)\n  1453\t\t\ttriggerTurnID := distillCandidateTriggerTurnIDV1(card)\n  1454\t\t\tanchorStart, anchorEnd := triggerLine, triggerLine\n  1455\t\t\tif distillCandidateCardHasCueV1(card, distillCandidateCueAcceptanceV1) {\n  1456\t\t\t\tanchorStart, anchorEnd = card.StartLine, triggerLine\n  1457\t\t\t}\n  1458\t\t\tbatches = append(batches, distillCandidateBatchV1{\n  1459\t\t\t\tCandidateIDs: []string{card.ID},\n  1460\t\t\t\tAnchors:      []distillCandidateAnchorV1{anchor},\n  1461\t\t\t\tChunk: transcriptChunk{\n  1462\t\t\t\t\tStartLine:     anchorStart,\n  1463\t\t\t\t\tEndLine:       anchorEnd,\n  1464\t\t\t\t\tDistillTurnID: triggerTurnID,\n  1465\t\t\t\t\tText:          rendered,\n  1466\t\t\t\t},\n  1467\t\t\t})\n  1468\t\t}\n  1469\t\treturn batches, nil\n  1470\t}\n  1471\t\n  1472\tfunc distillCandidateTriggerTurnIDV1(card distillCandidateCardV1) string {\n  1473\t\tif len(card.Triggers) > 0 {\n  1474\t\t\treturn card.Triggers[0].TurnID\n  1475\t\t}\n  1476\t\treturn \"\"\n  1477\t}\n  1478\t\n  1479\tfunc distillCandidateTriggerLineV1(card distillCandidateCardV1) int {\n  1480\t\tfor _, trigger := range card.Triggers {\n  1481\t\t\tfor _, turn := range card.Turns {\n  1482\t\t\t\tif turn.ID == trigger.TurnID {\n  1483\t\t\t\t\treturn turn.StartLine\n  1484\t\t\t\t}\n  1485\t\t\t}\n  1486\t\t}\n  1487\t\treturn card.StartLine\n  1488\t}\n  1489\t\n  1490\t// renderDistillCandidateCardsV1 is the direct adapter for the existing distill\n  1491\t// runner. Call packDistillCandidateCardsV1 instead when candidate IDs/anchors\n  1492\t// are also needed by execution accounting or dry-run output.\n  1493\tfunc renderDistillCandidateCardsV1(cards []distillCandidateCardV1, maxBytes int) ([]transcriptChunk, error) {\n  1494\t\tbatches, err := packDistillCandidateCardsV1(cards, maxBytes)\n  1495\t\tif err != nil {\n  1496\t\t\treturn nil, err\n  1497\t\t}\n  1498\t\tchunks := make([]transcriptChunk, len(batches))\n144:\tCandidateID  string `json:\"candidate_id\"`\n154:// for the existing extraction runner; CandidateIDs and Anchors retain the typed\n157:\tCandidateIDs []string                   `json:\"candidate_ids\"`\n1289:\tCandidateID   string                      `json:\"candidate_id\"`\n1296:\tCandidateID     string                  `json:\"candidate_id\"`\n1309:\t\tCandidateID:   card.ID,\n1333:\t\t\tCandidateID:     card.ID,\n1444:\t\t\tCandidateID:  card.ID,\n1459:\t\t\tCandidateIDs: []string{card.ID},\n1464:\t\t\t\tDistillTurnID: triggerTurnID,\n"},"started_at_ms":1787507085828,"completed_at_ms":1787507085828}}
