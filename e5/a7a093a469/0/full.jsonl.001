93:\t\tmainLegacy:       \"sha256:main-legacy\",\ninternal/cli/distill_cmd_test.go:1894:\t\tmainCandidate:    \"sha256:main-candidate\",\ninternal/cli/distill_cmd_test.go:1895:\t\tfeatureLegacy:    \"sha256:feature-legacy\",\ninternal/cli/distill_cmd_test.go:1896:\t\tfeatureCandidate: \"sha256:feature-candidate\",\ninternal/cli/distill_cmd_test.go:1897:\t\t\"s1\":             \"sha256:ambiguous-pre-upgrade\",\ninternal/cli/distill_shadow_v2_test.go:36:\tif err := saveDistillCache(brainDir, distillCache{Version: distillCacheVersion, Sessions: map[string]string{\"main/legacy\": \"sha256:legacy\"}}); err != nil {\ninternal/cli/distill_cmd.go:6:\t\"crypto/sha256\"\ninternal/cli/distill_cmd.go:75:\tsum := sha256.Sum256(data)\ninternal/cli/distill_cmd.go:112:const distillSessionLookahead = 256\ninternal/cli/distill_cmd.go:424:\t\t\tif totalCandidateBytes > distillCandidateMaxPreflightBytes {\ninternal/cli/distill_cmd.go:425:\t\t\t\treturn nil, fmt.Errorf(\"candidate preflight input exceeds %d bytes\", distillCandidateMaxPreflightBytes)\ninternal/cli/distill_cmd.go:435:\t\treturn readCanonicalHistoryTranscriptBounded(ctx, brainDir, rel, int64(distillCandidateMaxRawBytes))\ninternal/cli/distill_cmd.go:665:\tcmd.Flags().IntVar(&distillOpts.maxChunkBytes, \"max-chunk-bytes\", defaultDistillChunkSize, \"Maximum legacy transcript chunk or candidate-card input size in bytes\")\ninternal/cli/distill_cmd.go:1395:\t\tsource.MaxChunkBytes = distillMaxChunkBytes(distillOpts)\ninternal/cli/distill_cmd.go:1531:\t\tMaxChunkBytes:                 distillMaxChunkBytes(distillOpts),\ninternal/cli/distill_cmd.go:1557:\t\treport.MaxChunkBytes = distillCandidatePackMaxRenderedBytesV2\ninternal/cli/distill_cmd.go:1669:\t\t\t\treport.CandidatePacks, report.CandidatePacksIfUncached, distillCandidatePackMaxRenderedBytesV2, distillCandidatePackMaxMembersV2)\ninternal/cli/distill_cmd.go:1732:func distillMaxChunkBytes(distillOpts distillCommandOptions) int {\ninternal/cli/distill_cmd.go:1840:\t\tif pipeline == distillPipelineCandidates && plan.CandidateBytes > int64(distillCandidateMaxPreflightBytes) {\ninternal/cli/distill_cmd.go:1841:\t\t\treturn distillPlan{}, fmt.Errorf(\"candidate preflight input exceeds %d bytes\", distillCandidateMaxPreflightBytes)\ninternal/cli/distill_cmd.go:2070:\t\t\tif allowMinified && len(messages) >= distillCandidateMaxTurns {\ninternal/cli/distill_cmd.go:2084:\t\t\tif allowMinified && len(rawMessage) > distillCandidateMaxRecordBytes {\ninternal/cli/distill_cmd.go:2098:\t\t\t\tif len(*msg.Parts) > distillCandidateMaxMessageParts || totalParts > distillCandidateMaxDocumentParts {\ninternal/cli/distill_cmd.go:2286:\tcards, overflow := selectDistillCandidateCardsLimitedV1(normalized, distillCandidateMaxCards)\ninternal/cli/distill_cmd.go:2288:\t\treturn preparedDistillSessionInput{Err: fmt.Errorf(\"candidate pipeline selected more than %d cards for %s\", distillCandidateMaxCards, filepath.ToSlash(session.TranscriptPath))}\ninternal/cli/distill_cmd.go:2294:\t\tcardLimit = distillCandidatePackMaxRenderedBytesV2\ninternal/cli/distill_cmd.go:2301:\tfingerprint := sha256.New()\ninternal/cli/distill_cmd.go:2306:\t\tif candidateBytes > distillCandidateMaxInputBytes {\ninternal/cli/distill_cmd.go:2307:\t\t\treturn preparedDistillSessionInput{Err: fmt.Errorf(\"candidate pipeline rendered input for %s exceeds %d bytes\", filepath.ToSlash(session.TranscriptPath), distillCandidateMaxInputBytes)}\ninternal/cli/distill_cmd.go:2316:\t\tFingerprintMaterial: \"sha256:\" + hex.EncodeToString(fingerprint.Sum(nil)),\ninternal/cli/distill_cmd.go:2407:\tcontentSum := sha256.Sum256([]byte(content))\ninternal/cli/distill_cmd.go:2408:\tsum := sha256.Sum256([]byte(strings.Join([]string{\ninternal/cli/distill_cmd.go:2415:\treturn \"sha256:\" + hex.EncodeToString(sum[:])\ninternal/cli/distill_cmd.go:2424:\tcontentSum := sha256.Sum256([]byte(content))\ninternal/cli/distill_cmd.go:2425:\tsum := sha256.Sum256([]byte(strings.Join([]string{\ninternal/cli/distill_cm