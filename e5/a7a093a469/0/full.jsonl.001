ad\":{\"type\":\"agent_message\",\"message\":\"Understood.\"}}`,\n  2186\t\t\t`{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"I prefer explicit transactions over implicit ones.\"}}`,\n  2187\t\t}, \"\\n\")\n  2188\t\tbrainDir := writeSingleSessionFixture(t, now, transcript)\n  2189\t\tcalls := 0\n  2190\t\trun := func(context.Context, string, []string, []byte, time.Duration) (string, error) {\n  2191\t\t\tcalls++\n  2192\t\t\tif calls == 2 {\n  2193\t\t\t\terr := withBrainWriteLock(brainDir, func() error {\n  2194\t\t\t\t\tfacts, err := loadFacts(brainDir, \"main\")\n  2195\t\t\t\t\tif err != nil {\n  2196\t\t\t\t\t\treturn err\n  2197\t\t\t\t\t}\n  2198\t\t\t\t\tfacts = append(facts, factRecord{\n  2199\t\t\t\t\t\tID:   factRecordID(\"A human-authored concurrent fact.\", []string{\"project.tooling.stack\"}),\n  2200\t\t\t\t\t\tText: \"A human-authored concurrent fact.\", Paths: []string{\"project.tooling.stack\"},\n  2201\t\t\t\t\t\tBranch: \"main\", Origin: factOriginAuthored, Status: factStatusActive, CreatedAt: now, UpdatedAt: now,\n  2202\t\t\t\t\t})\n  2203\t\t\t\t\treturn writeFacts(brainDir, \"main\", facts)\n  2204\t\t\t\t})\n  2205\t\t\t\tif err != nil {\n  2206\t\t\t\t\tt.Fatal(err)\n  2207\t\t\t\t}\n  2208\t\t\t}\n  2209\t\t\treturn fmt.Sprintf(\"convention\\tpreferences.coding.style\\tCandidate fact %d.\\n\", calls), nil\n  2210\t\t}\n  2211\t\t_, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, distillCommandOptions{\n  2212\t\t\tagent: \"command\", agentCommand: []string{\"fake\"}, pipeline: distillPipelineCandidates,\n  2213\t\t\tmaxChunkBytes: defaultDistillChunkSize, timeout: time.Minute, flushEvery: 1, run: run,\n  2214\t\t}, now)\n  2215\t\tif err == nil || !errors.Is(err, errDistillFactStoreChanged) {\n  2216\t\t\tt.Fatalf(\"concurrent fact change was not detected: %v\", err)\n  2217\t\t}\n  2218\t\tfacts, loadErr := loadFacts(brainDir, \"main\")\n  2219\t\tif loadErr != nil {\n  2220\t\t\tt.Fatal(loadErr)\n  2221\t\t}\n  2222\t\tfoundAuthored := false\n  2223\t\tfor _, fact := range facts {\n  2224\t\t\tif fact.Origin == factOriginAuthored && fact.Text == \"A human-authored concurrent fact.\" {\n  2225\t\t\t\tfoundAuthored = true\n  2226\t\t\t}\n  2227\t\t}\n  2228\t\tif !foundAuthored {\n  2229\t\t\tt.Fatalf(\"candidate flush clobbered concurrent authored fact: %+v\", facts)\n  2230\t\t}\n  2231\t}\n  2232\t\n  2233\tfunc TestCandidatePipelineRefusesUnknownDialectBeforeProviderEgress(t *testing.T) {\n  2234\t\tnow := time.Date(2026, 8, 22, 12, 0, 0, 0, time.UTC)\n  2235\t\tbrainDir := writeSingleSessionFixture(t, now, \"unknown compact transcript\")\n  2236\t\tproviderCalls := 0\n  2237\t\t_, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, distillCommandOptions{\n  2238\t\t\tagent: \"command\", agentCommand: []string{\"fake\"}, pipeline: distillPipelineCandidates,\n  2239\t\t\tmaxChunkBytes: defaultDistillChunkSize, timeout: time.Minute,\n  2240\t\t\trun: func(context.Context, string, []string, []byte, time.Duration) (string, error) {\n  2241\t\t\t\tproviderCalls++\n  2242\t\t\t\treturn \"\", nil\n  2243\t\t\t},\n  2244\t\t}, now)\n  2245\t\tif err == nil || (!strings.Contains(err.Error(), \"does not recognize transcript format\") && !strings.Contains(err.Error(), \"unsupported narrative record\")) {\n","stderr":"","aggregated_output":"  1600\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now); err != nil {\n  1601\t\t\tt.Fatalf(\"seed run: %v\", err)\n  1602\t\t}\n  1603\t\n  1604\t\treport, err := buildDistillDryRunReport(brainDir, opts, now)\n  1605\t\tif err != nil {\n  1606\t\t\tt.Fatalf(\"dry-run: %v\", err)\n  1607\t\t}\n  1608\t\tif report.CachedSessions != 2 || report.SessionsToDistill != 0 {\n  1609\t\t\tt.Fatalf(\"same-config dry-run must predict all cached: cached=%d to_distill=%d\", report.CachedSessions, report.SessionsToDistill)\n  1610\t\t}\n  1611\t\tif report.EstimatedAgentCallsUpperBound != 0 {\n  1612\t\t\tt.Fatalf(\"same-config dry-run must predict zero agent calls, got %d\", report.EstimatedAgentCallsUpperBound)\n  1613\t\t}\n  1614\t\n  1615\t\t// A different model salts differently: the dry-run must predict re-distill.\n  1616\t\tchanged := opts\n  1617\t\tchanged.model = \"some-other-model\"\n  1618\t\treport, err = buildDistillDryRunReport(brainDir, changed, now)\n  1619\t\tif err != nil {\n  1620\t\t\tt.Fatalf(\"dry-run (changed model): %v\", err)\n  1621\t\t}\n  1622\t\tif report.SessionsToDistill != 2 || report.CachedSessions != 0 {\n  1623\t\t\tt.Fatalf(\"changed-model dry-run must predict re-distill: cached=%d to_distill=%d\", report.CachedSessions, report.SessionsToDistill)\n  1624\t\t}\n  1625\t}\n  1626\t\n  1627\tfunc TestDistillPipelineValidationAndCacheSaltCompatibility(t *testing.T) {\n  1628\t\tfor _, tc := range []struct {\n  1629\t\t\tinput string\n  1630\t\t\twant  string\n  1631\t\t\tok    bool\n  1632\t\t}{\n  1633\t\t\t{input: \"\", want: distillPipelineLegacy, ok: true},\n  1634\t\t\t{input: distillPipelineLegacy, want: distillPipelineLegacy, ok: true},\n  1635\t\t\t{input: distillPipelineCandidates, want: distillPipelineCandidates, ok: true},\n  1636\t\t\t{input: \"all\", ok: false},\n  1637\t\t} {\n  1638\t\t\tgot, err := normalizeDistillPipeline(tc.input)\n  1639\t\t\tif tc.ok && (err != nil || got != tc.want) {\n  1640\t\t\t\tt.Errorf(\"normalizeDistillPipeline(%q) = %q, %v; want %q\", tc.input, got, err, tc.want)\n  1641\t\t\t}\n  1642\t\t\tif !tc.ok && err == nil {\n  1643\t\t\t\tt.Errorf(\"normalizeDistillPipeline(%q) unexpectedly succeeded with %q\", tc.input, got)\n  1644\t\t\t}\n  1645\t\t}\n  1646\t\n  1647\t\tbase := distillCommandOptions{agent: \"command\", agentCommand: []string{\"fake\"}, model: \"local\"}\n  1648\t\temptySalt := distillCacheSalt(\"extract\", \"reconcile\", 0.75, base)\n  1649\t\tlegacy := base\n  1650\t\tlegacy.pipeline = distillPipelineLegacy\n  1651\t\tif got := distillCacheSalt(\"extract\", \"reconcile\", 0.75, legacy); got != emptySalt {\n  1652\t\t\tt.Fatalf(\"explicit legacy pipeline changed the pre-pipeline cache salt: %q != %q\", got, emptySalt)\n  1653\t\t}\n  1654\t\tcandidates := base\n  1655\t\tcandidates.pipeline = distillPipelineCandidates\n  1656\t\tcandidateSalt := distillCacheSalt(\"extract\", \"reconcile\", 0.75, candidates)\n  1657\t\tif candidateSalt == emptySalt {\n  1658\t\t\tt.Fatal(\"candidate and legacy pipelines must not share a session cache salt\")\n  1659\t\t}\n  1660\t\tif got := distillCacheSalt(\"extract\", \"changed reconcile prompt\", 0.12, candidates); got != candidateSalt {\n  1661\t\t\tt.Fatalf(\"legacy-only reconciliation knobs invalidated candidate extraction: %q != %q\", got, candidateSalt)\n  1662\t\t}\n  1663\t\tif distillSessionCacheKeyForPipeline(distillPipelineCandidates, \"main\", \"s1\") == distillSessionCacheKey(\"main\", \"s1\") {\n  1664\t\t\tt.Fatal(\"candidate and legacy pipelines must not share a session cache key\")\n  1665\t\t}\n  1666\t}\n  1667\t\n  1668\tfunc TestCandidatePipelinePreservesLegacyRollbackCacheUnlessForced(t *testing.T) {\n  1669\t\tnow := time.Date(2026, 8, 22, 12, 0, 0, 0, time.UTC)\n  1670\t\tbrainDir := writeSingleSessionFixture(t, now, `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always keep migrations reversible.\"}}`)\n  1671\t\trun := func(context.Context, string, []string, []byte, time.Duration) (string, error) { return \"NO_FACTS\", nil }\n  1672\t\tbase := distillCommandOptions{agent: \"command\", agentCommand: []string{\"fake\"}, run: run, maxChunkBytes: defaultDistillChunkSize, timeout: time.Minute}\n  1673\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, base, now); err != nil {\n  1674\t\t\tt.Fatal(err)\n  1675\t\t}\n  1676\t\tcandidate := base\n  1677\t\tcandidate.pipeline = distillPipelineCandidates\n  1678\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, candidate, now.Add(time.Minute)); err != nil {\n  1679\t\t\tt.Fatal(err)\n  1680\t\t}\n  1681\t\tcache := loadDistillCache(brainDir)\n  1682\t\tlegacyKey := distillSessionCacheKey(\"main\", \"s1\")\n  1683\t\tcandidateKey := distillSessionCacheKeyForPipeline(distillPipelineCandidates, \"main\", \"s1\")\n  1684\t\tif cache.Sessions[legacyKey] == \"\" || cache.Sessions[candidateKey] == \"\" {\n  1685\t\t\tt.Fatalf(\"normal candidate run did not preserve both cache namespaces: %+v\", cache.Sessions)\n  1686\t\t}\n  1687\t\n  1688\t\tcandidate.force = true\n  1689\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, candidate, now.Add(2*time.Minute)); err != nil {\n  1690\t\t\tt.Fatal(err)\n  1691\t\t}\n  1692\t\tcache = loadDistillCache(brainDir)\n  1693\t\tif cache.Sessions[legacyKey] != \"\" || cache.Sessions[candidateKey] == \"\" {\n  1694\t\t\tt.Fatalf(\"forced rebuild retained stale rollback fingerprints: %+v\", cache.Sessions)\n  1695\t\t}\n  1696\t}\n  1697\t\n  1698\tfunc TestCandidatePipelineCoalescesSameBranchSessionReexports(t *testing.T) {\n  1699\t\tnow := time.Date(2026, 8, 22, 12, 0, 0, 0, time.UTC)\n  1700\t\tbrainDir := t.TempDir()\n  1701\t\tolderRel := \"sessions/main/older.jsonl\"\n  1702\t\tnewerRel := \"sessions/main/newer.jsonl\"\n  1703\t\tolder := `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always keep migrations reversible.\"}}`\n  1704\t\tnewer := older + \"\\n\" + `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Never skip race tests.\"}}`\n  1705\t\tfor rel, content := range map[string]string{olderRel: older, newerRel: newer} {\n  1706\t\t\tpath := filepath.Join(brainDir, filepath.FromSlash(rel))\n  1707\t\t\tif err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {\n  1708\t\t\t\tt.Fatal(err)\n  1709\t\t\t}\n  1710\t\t\tif err := os.WriteFile(path, []byte(content), 0o600); err != nil {\n  1711\t\t\t\tt.Fatal(err)\n  1712\t\t\t}\n  1713\t\t}\n  1714\t\tmanifest := exportManifest{SchemaVersion: brainManifestSchemaVersion, GeneratedAt: now, DefaultBranch: \"main\", Sources: &brainSources{\n  1715\t\t\tSessions: &sessionSourceManifest{GeneratedAt: now, DefaultBranch: \"main\", Sessions: []exportSession{\n  1716\t\t\t\t{SessionID: \"shared\", Branch: \"main\", LatestCheckpoint: \"cp1\", TranscriptPath: olderRel, CreatedAt: now.Add(-2 * time.Hour)},\n  1717\t\t\t\t{SessionID: \"shared\", Branch: \"main\", LatestCheckpoint: \"cp2\", TranscriptPath: newerRel, CreatedAt: now.Add(-time.Hour)},\n  1718\t\t\t}},\n  1719\t\t}}\n  1720\t\tif err := writeBrainManifestAndReadme(brainDir, manifest); err != nil {\n  1721\t\t\tt.Fatal(err)\n  1722\t\t}\n  1723\t\tcalls := 0\n  1724\t\topts := distillCommandOptions{\n  1725\t\t\tagent: \"command\", agentCommand: []string{\"fake\"}, pipeline: distillPipelineCandidates,\n  1726\t\t\tmaxChunkBytes: defaultDistillChunkSize, timeout: time.Minute,\n  1727\t\t\trun: func(_ context.Context, _ string, _ []string, input []byte, _ time.Duration) (string, error) {\n  1728\t\t\t\tcalls++\n  1729\t\t\t\tif bytes.Contains(input, []byte(\"race tests\")) {\n  1730\t\t\t\t\treturn \"convention\\tpreferences.coding.style\\tRace tests must never be skipped.\\n\", nil\n  1731\t\t\t\t}\n  1732\t\t\t\treturn \"convention\\tpreferences.coding.style\\tMigrations must remain reversible.\\n\", nil\n  1733\t\t\t},\n  1734\t\t}\n  1735\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now); err != nil {\n  1736\t\t\tt.Fatal(err)\n  1737\t\t}\n  1738\t\tif calls != 2 {\n  1739\t\t\tt.Fatalf(\"initial candidate calls = %d, want 2 from only the newest export\", calls)\n  1740\t\t}\n  1741\t\tfacts, err := loadFacts(brainDir, \"main\")\n  1742\t\tif err != nil || len(facts) != 2 {\n  1743\t\t\tt.Fatalf(\"newest export facts = %+v, %v\", facts, err)\n  1744\t\t}\n  1745\t\tcalls = 0\n  1746\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now.Add(time.Minute)); err != nil {\n  1747\t\t\tt.Fatal(err)\n  1748\t\t}\n  1749\t\tif calls != 0 {\n  1750\t\t\tt.Fatalf(\"no-op rerun called provider %d times; older export poisoned the shared cache\", calls)\n  1751\t\t}\n  1752\t\tfacts, err = loadFacts(brainDir, \"main\")\n  1753\t\tif err != nil || len(facts) != 2 {\n  1754\t\t\tt.Fatalf(\"no-op rerun corrupted newest materialization: %+v, %v\", facts, err)\n  1755\t\t}\n  1756\t\tplan, err := buildDistillPlan(brainDir, &manifest, opts, distillCacheSalt(\"prompt\", \"reconcile\", 0.75, opts))\n  1757\t\tif err != nil || plan.TotalSessions != 1 {\n  1758\t\t\tt.Fatalf(\"dry-run plan did not coalesce session views: sessions=%d err=%v\", plan.TotalSessions, err)\n  1759\t\t}\n  1760\t}\n  1761\t\n  1762\tfunc TestCandidateCoalesceTiedViewsPrefersStrictTurnExtensionAndRejectsDivergence(t *testing.T) {\n  1763\t\tnow := time.Date(2026, 8, 22, 12, 0, 0, 0, time.UTC)\n  1764\t\tbrainDir := t.TempDir()\n  1765\t\tbase := `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always keep migrations reversible.\"}}`\n  1766\t\textended := base + \"\\n\" + `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Never skip race tests.\"}}`\n  1767\t\tdivergent := `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always squash migration commits.\"}}`\n  1768\t\twrite := func(rel, content string) {\n  1769\t\t\tt.Helper()\n  1770\t\t\tpath := filepath.Join(brainDir, filepath.FromSlash(rel))\n  1771\t\t\tif err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {\n  1772\t\t\t\tt.Fatal(err)\n  1773\t\t\t}\n  1774\t\t\tif err := os.WriteFile(path, []byte(content), 0o600); err != nil {\n  1775\t\t\t\tt.Fatal(err)\n  1776\t\t\t}\n  1777\t\t}\n  1778\t\twrite(\"sessions/base.jsonl\", base)\n  1779\t\twrite(\"sessions/extended.jsonl\", extended)\n  1780\t\twrite(\"sessions/divergent.jsonl\", divergent)\n  1781\t\tbaseSession := exportSession{SessionID: \"shared\", Branch: \"main\", LatestCheckpoint: \"fffffffffffe\", TranscriptPath: \"sessions/base.jsonl\", CreatedAt: now}\n  1782\t\textendedSession := exportSession{SessionID: \"shared\", Branch: \"main\", LatestCheckpoint: \"000000000001\", TranscriptPath: \"sessions/extended.jsonl\", CreatedAt: now}\n  1783\t\n  1784\t\tgot, err := coalesceCandidateDistillSessions(context.Background(), brainDir, []exportSession{baseSession, extendedSession}, func(session exportSession) string {\n  1785\t\t\treturn session.Branch\n  1786\t\t}, nil)\n  1787\t\tif err != nil {\n  1788\t\t\tt.Fatal(err)\n  1789\t\t}\n  1790\t\tif len(got) != 1 || got[0].TranscriptPath != extendedSession.TranscriptPath {\n  1791\t\t\tt.Fatalf(\"tied strict extension = %+v, want extended view despite lexically older checkpoint\", got)\n  1792\t\t}\n  1793\t\n  1794\t\tdivergentSession := exportSession{SessionID: \"shared\", Branch: \"main\", LatestCheckpoint: \"000000000002\", TranscriptPath: \"sessions/divergent.jsonl\", CreatedAt: now}\n  1795\t\tif _, err := coalesceCandidateDistillSessions(context.Background(), brainDir, []exportSession{baseSession, divergentSession}, func(session exportSession) string {\n  1796\t\t\treturn session.Branch\n  1797\t\t}, nil); err == nil || !strings.Contains(err.Error(), \"divergent tied exports\") {\n  1798\t\t\tt.Fatalf(\"divergent tied views error = %v\", err)\n  1799\t\t}\n  1800\t}\n  1801\t\n  1802\tfunc TestCandidateScopedRunIgnoresDivergentTiedViewsOutsideSelection(t *testing.T) {\n  1803\t\tnow := time.Date(2026, 8, 23, 1, 0, 0, 0, time.UTC)\n  1804\t\tbrainDir := t.TempDir()\n  1805\t\tsessions := []exportSession{\n  1806\t\t\t{SessionID: \"selected\", Branch: \"main\", LatestCheckpoint: \"main\", TranscriptPath: \"sessions/main.jsonl\", CreatedAt: now},\n  1807\t\t\t{SessionID: \"unrelated\", Branch: \"feature\", LatestCheckpoint: \"old\", TranscriptPath: \"sessions/feature-old.jsonl\", CreatedAt: now},\n  1808\t\t\t{SessionID: \"unrelated\", Branch: \"feature\", LatestCheckpoint: \"new\", TranscriptPath: \"sessions/feature-new.jsonl\", CreatedAt: now},\n  1809\t\t}\n  1810\t\tcontents := []string{\n  1811\t\t\t`{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always keep migrations reversible.\"}}`,\n  1812\t\t\t`{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always use SQLite.\"}}`,\n  1813\t\t\t`{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Never use SQLite.\"}}`,\n  1814\t\t}\n  1815\t\tfor index, session := range sessions {\n  1816\t\t\tpath := filepath.Join(brainDir, filepath.FromSlash(session.TranscriptPath))\n  1817\t\t\tif err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {\n  1818\t\t\t\tt.Fatal(err)\n  1819\t\t\t}\n  1820\t\t\tif err := os.WriteFile(path, []byte(contents[index]), 0o600); err != nil {\n  1821\t\t\t\tt.Fatal(err)\n  1822\t\t\t}\n  1823\t\t}\n  1824\t\tmanifest := exportManifest{SchemaVersion: brainManifestSchemaVersion, GeneratedAt: now, DefaultBranch: \"main\", Sources: &brainSources{\n  1825\t\t\tSessions: &sessionSourceManifest{GeneratedAt: now, DefaultBranch: \"main\", Sessions: sessions},\n  1826\t\t}}\n  1827\t\tif err := writeBrainManifestAndReadme(brainDir, manifest); err != nil {\n  1828\t\t\tt.Fatal(err)\n  1829\t\t}\n  1830\t\tcalls := 0\n  1831\t\topts := distillCommandOptions{\n  1832\t\t\tagent: \"command\", agentCommand: []string{\"fake\"}, pipeline: distillPipelineCandidates, branch: \"main\",\n  1833\t\t\tmaxChunkBytes: defaultDistillChunkSize, timeout: time.Minute,\n  1834\t\t\trun: func(context.Context, string, []string, []byte, time.Duration) (string, error) {\n  1835\t\t\t\tcalls++\n  1836\t\t\t\treturn \"NO_FACTS\", nil\n  1837\t\t\t},\n  1838\t\t}\n  1839\t\tif report, err := buildDistillDryRunReport(brainDir, opts, now); err != nil || report.Sessions != 1 {\n  1840\t\t\tt.Fatalf(\"scoped dry-run = %+v, %v\", report, err)\n  1841\t\t}\n  1842\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now); err != nil {\n  1843\t\t\tt.Fatal(err)\n  1844\t\t}\n  1845\t\tif calls != 1 {\n  1846\t\t\tt.Fatalf(\"scoped run calls = %d, want 1\", calls)\n  1847\t\t}\n  1848\t\tunscoped := opts\n  1849\t\tunscoped.branch = \"\"\n  1850\t\tif _, err := buildDistillDryRunReport(brainDir, unscoped, now); err == nil || !strings.Contains(err.Error(), \"divergent tied exports\") {\n  1851\t\t\tt.Fatalf(\"unscoped divergent dry-run error = %v\", err)\n  1852\t\t}\n  1853\t}\n  1854\t\n  1855\tfunc TestCandidatePipelineCacheNamespaceDoesNotClaimLegacyBranchName(t *testing.T) {\n  1856\t\tlegacyCollision := distillSessionCacheKey(\"pipeline:candidates\", \"s1\")\n  1857\t\tcandidate := distillSessionCacheKeyForPipeline(distillPipelineCandidates, \"main\", \"s1\")\n  1858\t\tif isCandidateDistillCacheKey(legacyCollision) {\n  1859\t\t\tt.Fatalf(\"legacy branch cache key %q was classified as candidate state\", legacyCollision)\n  1860\t\t}\n  1861\t\tif !isCandidateDistillCacheKey(candidate) {\n  1862\t\t\tt.Fatalf(\"candidate cache key %q was not recognized\", candidate)\n  1863\t\t}\n  1864\t\tif got, ok := distillCacheKeyBranch(legacyCollision); !ok || got != \"pipeline:candidates\" {\n  1865\t\t\tt.Fatalf(\"legacy branch owner = %q, %v\", got, ok)\n  1866\t\t}\n  1867\t\tif got, ok := distillCacheKeyBranch(candidate); !ok || got != \"main\" {\n  1868\t\t\tt.Fatalf(\"candidate branch owner = %q, %v\", got, ok)\n  1869\t\t}\n  1870\t}\n  1871\t\n  1872\tfunc TestCandidateBranchScopedForceInvalidatesOnlySelectedBranchCaches(t *testing.T) {\n  1873\t\tnow := time.Date(2026, 8, 22, 12, 0, 0, 0, time.UTC)\n  1874\t\tbrainDir := writeDistillFixture(t, now)\n  1875\t\tmanifest, err := loadBrainManifest(brainDir)\n  1876\t\tif err != nil {\n  1877\t\t\tt.Fatal(err)\n  1878\t\t}\n  1879\t\t// The same captured session can legitimately be exported on two branches.\n  1880\t\tmanifest.Sources.Sessions.Sessions[1].SessionID = \"s1\"\n  1881\t\tif err := writeBrainManifestAndReadme(brainDir, *manifest); err != nil {\n  1882\t\t\tt.Fatal(err)\n  1883\t\t}\n  1884\t\tfeatureTranscript := filepath.Join(brainDir, filepath.FromSlash(manifest.Sources.Sessions.Sessions[1].TranscriptPath))\n  1885\t\tif err := os.WriteFile(featureTranscript, []byte(`{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always keep migrations reversible.\"}}`), 0o600); err != nil {\n  1886\t\t\tt.Fatal(err)\n  1887\t\t}\n  1888\t\tmainLegacy := distillSessionCacheKey(\"main\", \"s1\")\n  1889\t\tmainCandidate := distillSessionCacheKeyForPipeline(distillPipelineCandidates, \"main\", \"s1\")\n  1890\t\tfeatureLegacy := distillSessionCacheKey(\"feature\", \"s1\")\n  1891\t\tfeatureCandidate := distillSessionCacheKeyForPipeline(distillPipelineCandidates, \"feature\", \"s1\")\n  1892\t\tif err := saveDistillCache(brainDir, distillCache{Version: distillCacheVersion, Sessions: map[string]string{\n  1893\t\t\tmainLegacy:       \"sha256:main-legacy\",\n  1894\t\t\tmainCandidate:    \"sha256:main-candidate\",\n  1895\t\t\tfeatureLegacy:    \"sha256:feature-legacy\",\n  1896\t\t\tfeatureCandidate: \"sha256:feature-candidate\",\n  1897\t\t\t\"s1\":             \"sha256:ambiguous-pre-upgrade\",\n  1898\t\t}}); err != nil {\n  1899\t\t\tt.Fatal(err)\n  1900\t\t}\n  1901\t\tcheckedUpfront := false\n  1902\t\topts := distillCommandOptions{\n  1903\t\t\tagent: \"command\", agentCommand: []string{\"fake\"}, pipeline: distillPipelineCandidates,\n  1904\t\t\tbranch: \"feature\", force: true, maxChunkBytes: defaultDistillChunkSize, timeout: time.Minute,\n  1905\t\t\trun: func(context.Context, string, []string, []byte, time.Duration) (string, error) {\n  1906\t\t\t\tcache := loadDistillCache(brainDir)\n  1907\t\t\t\tcheckedUpfront = cache.Sessions[mainLegacy] != \"\" && cache.Sessions[mainCandidate] != \"\" &&\n  1908\t\t\t\t\tcache.Sessions[featureLegacy] == \"\" && cache.Sessions[featureCandidate] == \"\" && cache.Sessions[\"s1\"] == \"\"\n  1909\t\t\t\treturn \"NO_FACTS\", nil\n  1910\t\t\t},\n  1911\t\t}\n  1912\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now.Add(time.Minute)); err != nil {\n  1913\t\t\tt.Fatal(err)\n  1914\t\t}\n  1915\t\tif !checkedUpfront {\n  1916\t\t\tt.Fatal(\"scoped force did not durably invalidate only the selected branch before provider work\")\n  1917\t\t}\n  1918\t\tcache := loadDistillCache(brainDir)\n  1919\t\tif cache.Sessions[mainLegacy] == \"\" || cache.Sessions[mainCandidate] == \"\" || cache.Sessions[featureLegacy] != \"\" || cache.Sessions[featureCandidate] == \"\" || cache.Sessions[\"s1\"] != \"\" {\n  1920\t\t\tt.Fatalf(\"scoped force cache result = %+v\", cache.Sessions)\n  1921\t\t}\n  1922\t}\n  1923\t\n  1924\tfunc TestCandidateForceIncludesOrphanFactAndProposalOnlyBranches(t *testing.T) {\n  1925\t\tnow := time.Date(2026, 8, 22, 12, 0, 0, 0, time.UTC)\n  1926\t\tbrainDir := writeSingleSessionFixture(t, now, `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always keep migrations reversible.\"}}`)\n  1927\t\tpaths := normalizeFactPaths([]string{\"workflow.testing.rules\"})\n  1928\t\torphanFact := factRecord{\n  1929\t\t\tID:        factRecordID(\"Always run the orphan test.\", paths),\n  1930\t\t\tPaths:     paths,\n  1931\t\t\tText:      \"Always run the orphan test.\",\n  1932\t\t\tBranch:    \"orphan-facts\",\n  1933\t\t\tOrigin:    factOriginDistilled,\n  1934\t\t\tStatus:    factStatusActive,\n  1935\t\t\tCreatedAt: now,\n  1936\t\t\tUpdatedAt: now,\n  1937\t\t}\n  1938\t\tif err := writeFacts(brainDir, orphanFact.Branch, []factRecord{orphanFact}); err != nil {\n  1939\t\t\tt.Fatal(err)\n  1940\t\t}\n  1941\t\tproposalBranch := \"orphan-proposals\"\n  1942\t\tif err := writeFactProposals(brainDir, proposalBranch, []factProposal{{\n  1943\t\t\tAction: factActionMerge, CandidateID: \"fact:candidate\", TargetID: \"fact:target\", Confidence: 0.5, Branch: \"wrong-before-write\",\n  1944\t\t}}); err != nil {\n  1945\t\t\tt.Fatal(err)\n  1946\t\t}\n  1947\t\tlegacyBranch := \"legacy-branchless\"\n  1948\t\tif err := writeFactProposalsAtRel(brainDir, factsProposalsRelPath(legacyBranch), []factProposal{\n  1949\t\t\t{Action: factActionMerge, CandidateID: \"fact:local\", TargetID: \"fact:target\", Confidence: 0.4},\n  1950\t\t\t{Action: factActionMerge, CandidateID: \"fact:member\", TargetID: \"fact:target\", Confidence: 0.4, ProposedBy: \"member-b\"},\n  1951\t\t}); err != nil {\n  1952\t\t\tt.Fatal(err)\n  1953\t\t}\n  1954\t\tmismatchBranch := \"legacy-mismatch\"\n  1955\t\tif err := writeFactProposalsAtRel(brainDir, factsProposalsRelPath(mismatchBranch), []factProposal{{\n  1956\t\t\tAction: factActionMerge, CandidateID: \"fact:mismatch\", TargetID: \"fact:target\", Confidence: 0.4, Branch: \"different-owner\",\n  1957\t\t}}); err != nil {\n  1958\t\t\tt.Fatal(err)\n  1959\t\t}\n  1960\t\tsessionScoped, err := distillForceScopeBranches(brainDir, \"\", []string{\"main\"}, false)\n  1961\t\tif err != nil {\n  1962\t\t\tt.Fatal(err)\n  1963\t\t}\n  1964\t\tif !slices.Equal(sessionScoped.Branches, []string{\"main\"}) || len(sessionScoped.LegacyProposalRels) != 0 {\n  1965\t\t\tt.Fatalf(\"session-scoped force expanded into unrelated stores: %+v\", sessionScoped)\n  1966\t\t}\n  1967\t\topts := distillCommandOptions{\n  1968\t\t\tagent: \"command\", agentCommand: []string{\"fake\"}, pipeline: distillPipelineCandidates,\n  1969\t\t\tforce: true, maxChunkBytes: defaultDistillChunkSize, timeout: time.Minute,\n  1970\t\t\trun: func(context.Context, string, []string, []byte, time.Duration) (string, error) { return \"NO_FACTS\", nil },\n  1971\t\t}\n  1972\t\treport, err := buildDistillDryRunReport(brainDir, opts, now)\n  1973\t\tif err != nil {\n  1974\t\t\tt.Fatal(err)\n  1975\t\t}\n  1976\t\tif report.ExistingDistilledFactsAtRisk != 1 {\n  1977\t\t\tt.Fatalf(\"dry-run facts at risk = %d, want 1\", report.ExistingDistilledFactsAtRisk)\n  1978\t\t}\n  1979\t\tseenBranches := map[string]bool{}\n  1980\t\tfor _, branch := range report.Branches {\n  1981\t\t\tseenBranches[branch.Branch] = true\n  1982\t\t}\n  1983\t\tif !seenBranches[orphanFact.Branch] || !seenBranches[proposalBranch] {\n  1984\t\t\tt.Fatalf(\"dry-run force scope omitted orphan stores: %+v\", report.Branches)\n  1985\t\t}\n  1986\t\tif !slices.ContainsFunc(report.Warnings, func(warning string) bool { return strings.Contains(warning, \"2 legacy proposal stores\") }) {\n  1987\t\t\tt.Fatalf(\"dry-run did not disclose legacy proposal cleanup: %+v\", report.Warnings)\n  1988\t\t}\n  1989\t\n  1990\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now.Add(time.Minute)); err != nil {\n  1991\t\t\tt.Fatal(err)\n  1992\t\t}\n  1993\t\tif facts, err := loadFacts(brainDir, orphanFact.Branch); err != nil || len(facts) != 0 {\n  1994\t\t\tt.Fatalf(\"orphan distilled facts survived force: %+v, %v\", facts, err)\n  1995\t\t}\n  1996\t\tif proposals, err := loadFactProposals(brainDir, proposalBranch); err != nil || len(proposals) != 0 {\n  1997\t\t\tt.Fatalf(\"proposal-only branch survived force: %+v, %v\", proposals, err)\n  1998\t\t}\n  1999\t\tif proposals, err := loadFactProposals(brainDir, legacyBranch); err != nil || len(proposals) != 1 || proposals[0].ProposedBy != \"member-b\" {\n  2000\t\t\tt.Fatalf(\"legacy proposal cleanup did not retain only attributed work: %+v, %v\", proposals, err)\n  2001\t\t}\n  2002\t\tif proposals, err := loadFactProposals(brainDir, mismatchBranch); err != nil || len(proposals) != 0 {\n  2003\t\t\tt.Fatalf(\"mismatched legacy proposal store survived force: %+v, %v\", proposals, err)\n  2004\t\t}\n  2005\t}\n  2006\t\n  2007\tfunc TestCandidateEmptyReprocessDoesNotDeleteLegacyOwnedFact(t *testing.T) {\n  2008\t\tnow := time.Date(2026, 8, 22, 12, 0, 0, 0, time.UTC)\n  2009\t\tbrainDir := writeSingleSessionFixture(t, now, `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always keep migrations reversible.\"}}`)\n  2010\t\tfactLine := \"convention\\tpreferences.coding.style\\tMigrations must remain reversible.\\n\"\n  2011\t\tlegacyCalls := 0\n  2012\t\tlegacy := distillCommandOptions{\n  2013\t\t\tagent: \"command\", agentCommand: []string{\"fake\"}, model: \"legacy\", maxChunkBytes: defaultDistillChunkSize, timeout: time.Minute,\n  2014\t\t\trun: func(context.Context, string, []string, []byte, time.Duration) (string, error) {\n  2015\t\t\t\tlegacyCalls++\n  2016\t\t\t\treturn factLine, nil\n  2017\t\t\t},\n  2018\t\t}\n  2019\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, legacy, now); err != nil {\n  2020\t\t\tt.Fatal(err)\n  2021\t\t}\n  2022\t\tcandidate := legacy\n  2023\t\tcandidate.pipeline = distillPipelineCandidates\n  2024\t\tcandidate.model = \"candidate-fact\"\n  2025\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, candidate, now.Add(time.Minute)); err != nil {\n  2026\t\t\tt.Fatal(err)\n  2027\t\t}\n  2028\t\tcandidate.model = \"candidate-empty\"\n  2029\t\tcandidate.run = func(context.Context, string, []string, []byte, time.Duration) (string, error) { return \"NO_FACTS\", nil }\n  2030\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, candidate, now.Add(2*time.Minute)); err != nil {\n  2031\t\t\tt.Fatal(err)\n  2032\t\t}\n  2033\t\tfacts, err := loadFacts(brainDir, \"main\")\n  2034\t\tif err != nil {\n  2035\t\t\tt.Fatal(err)\n  2036\t\t}\n  2037\t\tif len(facts) != 1 || len(facts[0].Provenance) != 1 || facts[0].Provenance[0].DistillTurnID != \"\" {\n  2038\t\t\tt.Fatalf(\"candidate cleanup stole or deleted legacy provenance: %+v\", facts)\n  2039\t\t}\n  2040\t\tbefore := legacyCalls\n  2041\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, legacy, now.Add(3*time.Minute)); err != nil {\n  2042\t\t\tt.Fatal(err)\n  2043\t\t}\n  2044\t\tif legacyCalls != before {\n  2045\t\t\tt.Fatalf(\"rollback cache missed after candidate cleanup: calls %d -> %d\", before, legacyCalls)\n  2046\t\t}\n  2047\t}\n  2048\t\n  2049\tfunc TestCandidatePipelineSkipsModelReconciliation(t *testing.T) {\n  2050\t\tnow := time.Date(2026, 8, 22, 12, 0, 0, 0, time.UTC)\n  2051\t\tbaseTranscript := strings.Join([]string{\n  2052\t\t\t`{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always keep migrations reversible.\"}}`,\n  2053\t\t\t`{\"type\":\"event_msg\",\"payload\":{\"type\":\"agent_message\",\"message\":\"I will preserve the rollback path.\"}}`,\n  2054\t\t\t`{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Please inspect the remaining files.\"}}`,\n  2055\t\t\t`{\"type\":\"event_msg\",\"payload\":{\"type\":\"agent_message\",\"message\":\"Inspection is complete.\"}}`,\n  2056\t\t}, \"\\n\")\n  2057\t\tbrainDir := writeSingleSessionFixture(t, now, baseTranscript)\n  2058\t\n  2059\t\tproviderCalls := 0\n  2060\t\trun := func(ctx context.Context, dir string, args []string, input []byte, timeout time.Duration) (string, error) {\n  2061\t\t\tproviderCalls++\n  2062\t\t\tif !bytes.Contains(input, []byte(`\"type\":\"distill_candidate_v1\"`)) || !bytes.Contains(input, []byte(`\"role\":\"user\"`)) {\n  2063\t\t\t\tt.Fatalf(\"candidate runner received legacy/untyped input: %s\", input)\n  2064\t\t\t}\n  2065\t\t\treturn \"convention\\tpreferences.coding.style\\tMigrations must remain reversible.\\n\", nil\n  2066\t\t}\n  2067\t\topts := distillCommandOptions{\n  2068\t\t\tagent: \"command\", agentCommand: []string{\"fake\"}, run: run,\n  2069\t\t\tpipeline: distillPipelineCandidates, maxChunkBytes: defaultDistillChunkSize, timeout: time.Minute,\n  2070\t\t}\n  2071\t\tfirst, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now)\n  2072\t\tif err != nil {\n  2073\t\t\tt.Fatalf(\"first candidate run: %v\", err)\n  2074\t\t}\n  2075\t\tif providerCalls != 1 || first.ExtractionCalls != 1 || first.ReconcileCalls != 0 {\n  2076\t\t\tt.Fatalf(\"unexpected first-run accounting: provider=%d source=%+v\", providerCalls, first)\n  2077\t\t}\n  2078\t\tif first.Pipeline != distillPipelineCandidates || first.ChunksScanned != 1 {\n  2079\t\t\tt.Fatalf(\"candidate pipeline evidence missing: %+v\", first)\n  2080\t\t}\n  2081\t\tif first.CandidateBytes <= 0 || first.PreprocessedBytes != 0 {\n  2082\t\t\tt.Fatalf(\"candidate run invoked or reported the legacy preprocessor: %+v\", first)\n  2083\t\t}\n  2084\t\tmanifestBytes, err := os.ReadFile(filepath.Join(brainDir, exportManifestFileName))\n  2085\t\tif err != nil {\n  2086\t\t\tt.Fatal(err)\n  2087\t\t}\n  2088\t\tvar manifestJSON map[string]any\n  2089\t\tif err := json.Unmarshal(manifestBytes, &manifestJSON); err != nil {\n  2090\t\t\tt.Fatal(err)\n  2091\t\t}\n  2092\t\tpersistedFacts := jsonMap(jsonMap(manifestJSON[\"sources\"])[\"facts\"])\n  2093\t\tfor _, candidateOnlyField := range []string{\"candidate_bytes\", \"pipeline\", \"preprocessed_bytes_available\"} {\n  2094\t\t\tif _, present := persistedFacts[candidateOnlyField]; present {\n  2095\t\t\t\tt.Fatalf(\"schema-v3 manifest persisted candidate-only field %q: %+v\", candidateOnlyField, persistedFacts)\n  2096\t\t\t}\n  2097\t\t}\n  2098\t\n  2099\t\t// Insert ignored mechanics before the same candidate and append neutral\n  2100\t\t// turns. The provider input is unchanged, but the provenance line moved, so\n  2101\t\t// the materialization fingerprint must re-apply the fact at its fresh anchor.\n  2102\t\tmanifest, err := loadBrainManifest(brainDir)\n  2103\t\tif err != nil {\n  2104\t\t\tt.Fatal(err)\n  2105\t\t}\n  2106\t\ttp := manifest.Sources.Sessions.Sessions[0].TranscriptPath\n  2107\t\tappended := `{\"type\":\"session_meta\",\"payload\":{\"cwd\":\"/tmp\"}}` + \"\\n\" + baseTranscript + \"\\n\" + strings.Join([]string{\n  2108\t\t\t`{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Show the current status.\"}}`,\n  2109\t\t\t`{\"type\":\"event_msg\",\"payload\":{\"type\":\"agent_message\",\"message\":\"The status is clean.\"}}`,\n  2110\t\t}, \"\\n\")\n  2111\t\tif err := os.WriteFile(filepath.Join(brainDir, filepath.FromSlash(tp)), []byte(appended), 0o600); err != nil {\n  2112\t\t\tt.Fatal(err)\n  2113\t\t}\n  2114\t\treport, err := buildDistillDryRunReport(brainDir, opts, now.Add(time.Minute))\n  2115\t\tif err != nil {\n  2116\t\t\tt.Fatalf(\"candidate dry-run: %v\", err)\n  2117\t\t}\n  2118\t\tif report.Pipeline != distillPipelineCandidates || report.CandidateCards != 1 ||\n  2119\t\t\treport.ExtractionAgentCalls != 1 || report.ReconcileAgentCallsUpperBound != 0 || report.EstimatedAgentCallsUpperBound != 1 {\n  2120\t\t\tt.Fatalf(\"candidate dry-run did not predict one extraction and no reconciliation: %+v\", report)\n  2121\t\t}\n  2122\t\tif report.CandidateBytes <= 0 || report.PreprocessedBytes != 0 || report.PreprocessedBytesAvailable {\n  2123\t\t\tt.Fatalf(\"candidate dry-run byte accounting is wrong: %+v\", report)\n  2124\t\t}\n  2125\t\n  2126\t\tsecond, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now.Add(time.Minute))\n  2127\t\tif err != nil {\n  2128\t\t\tt.Fatalf(\"second candidate run: %v\", err)\n  2129\t\t}\n  2130\t\tif providerCalls != 2 || second.ExtractionCalls != 1 || second.ReconcileCalls != 0 {\n  2131\t\t\tt.Fatalf(\"candidate extraction/reconciliation accounting is wrong: provider=%d source=%+v\", providerCalls, second)\n  2132\t\t}\n  2133\t\tfacts, err := loadFacts(brainDir, \"main\")\n  2134\t\tif err != nil {\n  2135\t\t\tt.Fatal(err)\n  2136\t\t}\n  2137\t\tif len(facts) != 1 || len(facts[0].Provenance) != 1 {\n  2138\t\t\tt.Fatalf(\"candidate re-application did not preserve idempotence/fresh provenance: %+v\", facts)\n  2139\t\t}\n  2140\t\tif facts[0].Provenance[0].Line != 2 || facts[0].Provenance[0].DistillTurnID == \"\" {\n  2141\t\t\tt.Fatalf(\"candidate materialization retained a stale or unowned line anchor: %+v\", facts[0].Provenance)\n  2142\t\t}\n  2143\t}\n  2144\t\n  2145\tfunc TestCandidatePipelineBlankPreservesAndSentinelClearsMaterialization(t *testing.T) {\n  2146\t\tnow := time.Date(2026, 8, 22, 12, 0, 0, 0, time.UTC)\n  2147\t\tbrainDir := writeSingleSessionFixture(t, now, `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always keep migrations reversible.\"}}`)\n  2148\t\toutput := \"convention\\tpreferences.coding.style\\tMigrations must remain reversible.\\n\"\n  2149\t\topts := distillCommandOptions{\n  2150\t\t\tagent: \"command\", agentCommand: []string{\"fake\"}, pipeline: distillPipelineCandidates,\n  2151\t\t\tmodel: \"first\", maxChunkBytes: defaultDistillChunkSize, timeout: time.Minute,\n  2152\t\t\trun: func(context.Context, string, []string, []byte, time.Duration) (string, error) { return output, nil },\n  2153\t\t}\n  2154\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now); err != nil {\n  2155\t\t\tt.Fatal(err)\n  2156\t\t}\n  2157\t\n  2158\t\tblank := opts\n  2159\t\tblank.model = \"blank\"\n  2160\t\tblank.run = func(context.Context, string, []string, []byte, time.Duration) (string, error) { return \"\", nil }\n  2161\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, blank, now.Add(time.Minute)); err == nil {\n  2162\t\t\tt.Fatal(\"blank candidate output was accepted as an intentional empty result\")\n  2163\t\t}\n  2164\t\tfacts, err := loadFacts(brainDir, \"main\")\n  2165\t\tif err != nil || len(facts) != 1 {\n  2166\t\t\tt.Fatalf(\"blank output erased prior materialization: facts=%+v err=%v\", facts, err)\n  2167\t\t}\n  2168\t\n  2169\t\tempty := opts\n  2170\t\tempty.model = \"explicit-empty\"\n  2171\t\tempty.run = func(context.Context, string, []string, []byte, time.Duration) (string, error) { return \"NO_FACTS\", nil }\n  2172\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, empty, now.Add(2*time.Minute)); err != nil {\n  2173\t\t\tt.Fatal(err)\n  2174\t\t}\n  2175\t\tfacts, err = loadFacts(brainDir, \"main\")\n  2176\t\tif err != nil || len(facts) != 0 {\n  2177\t\t\tt.Fatalf(\"explicit empty sentinel did not clear prior candidate materialization: facts=%+v err=%v\", facts, err)\n  2178\t\t}\n  2179\t}\n  2180\t\n  2181\tfunc TestCandidatePipelineRefusesToClobberConcurrentFactAdminWrite(t *testing.T) {\n  2182\t\tnow := time.Date(2026, 8, 22, 12, 0, 0, 0, time.UTC)\n  2183\t\ttranscript := strings.Join([]string{\n  2184\t\t\t`{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always keep migrations reversible.\"}}`,\n  2185\t\t\t`{\"type\":\"event_msg\",\"payload\":{\"type\":\"agent_message\",\"message\":\"Understood.\"}}`,\n  2186\t\t\t`{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"I prefer explicit transactions over implicit ones.\"}}`,\n  2187\t\t}, \"\\n\")\n  2188\t\tbrainDir := writeSingleSessionFixture(t, now, transcript)\n  2189\t\tcalls := 0\n  2190\t\trun := func(context.Context, string, []string, []byte, time.Duration) (string, error) {\n  2191\t\t\tcalls++\n  2192\t\t\tif calls == 2 {\n  2193\t\t\t\terr := withBrainWriteLock(brainDir, func() error {\n  2194\t\t\t\t\tfacts, err := loadFacts(brainDir, \"main\")\n  2195\t\t\t\t\tif err != nil {\n  2196\t\t\t\t\t\treturn err\n  2197\t\t\t\t\t}\n  2198\t\t\t\t\tfacts = append(facts, factRecord{\n  2199\t\t\t\t\t\tID:   factRecordID(\"A human-authored concurrent fact.\", []string{\"project.tooling.stack\"}),\n  2200\t\t\t\t\t\tText: \"A human-authored concurrent fact.\", Paths: []string{\"project.tooling.stack\"},\n  2201\t\t\t\t\t\tBranch: \"main\", Origin: factOriginAuthored, Status: factStatusActive, CreatedAt: now, UpdatedAt: now,\n  2202\t\t\t\t\t})\n  2203\t\t\t\t\treturn writeFacts(brainDir, \"main\", facts)\n  2204\t\t\t\t})\n  2205\t\t\t\tif err != nil {\n  2206\t\t\t\t\tt.Fatal(err)\n  2207\t\t\t\t}\n  2208\t\t\t}\n  2209\t\t\treturn fmt.Sprintf(\"convention\\tpreferences.coding.style\\tCandidate fact %d.\\n\", calls), nil\n  2210\t\t}\n  2211\t\t_, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, distillCommandOptions{\n  2212\t\t\tagent: \"command\", agentCommand: []string{\"fake\"}, pipeline: distillPipelineCandidates,\n  2213\t\t\tmaxChunkBytes: defaultDistillChunkSize, timeout: time.Minute, flushEvery: 1, run: run,\n  2214\t\t}, now)\n  2215\t\tif err == nil || !errors.Is(err, errDistillFactStoreChanged) {\n  2216\t\t\tt.Fatalf(\"concurrent fact change was not detected: %v\", err)\n  2217\t\t}\n  2218\t\tfacts, loadErr := loadFacts(brainDir, \"main\")\n  2219\t\tif loadErr != nil {\n  2220\t\t\tt.Fatal(loadErr)\n  2221\t\t}\n  2222\t\tfoundAuthored := false\n  2223\t\tfor _, fact := range facts {\n  2224\t\t\tif fact.Origin == factOriginAuthored && fact.Text == \"A human-authored concurrent fact.\" {\n  2225\t\t\t\tfoundAuthored = true\n  2226\t\t\t}\n  2227\t\t}\n  2228\t\tif !foundAuthored {\n  2229\t\t\tt.Fatalf(\"candidate flush clobbered concurrent authored fact: %+v\", facts)\n  2230\t\t}\n  2231\t}\n  2232\t\n  2233\tfunc TestCandidatePipelineRefusesUnknownDialectBeforeProviderEgress(t *testing.T) {\n  2234\t\tnow := time.Date(2026, 8, 22, 12, 0, 0, 0, time.UTC)\n  2235\t\tbrainDir := writeSingleSessionFixture(t, now, \"unknown compact transcript\")\n  2236\t\tproviderCalls := 0\n  2237\t\t_, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, distillCommandOptions{\n  2238\t\t\tagent: \"command\", agentCommand: []string{\"fake\"}, pipeline: distillPipelineCandidates,\n  2239\t\t\tmaxChunkBytes: defaultDistillChunkSize, timeout: time.Minute,\n  2240\t\t\trun: func(context.Context, string, []string, []byte, time.Duration) (string, error) {\n  2241\t\t\t\tproviderCalls++\n  2242\t\t\t\treturn \"\", nil\n  2243\t\t\t},\n  2244\t\t}, now)\n  2245\t\tif err == nil || (!strings.Contains(err.Error(), \"does not recognize transcript format\") && !strings.Contains(err.Error(), \"unsupported narrative record\")) {\n","exit_code":0,"duration":{"secs":0,"nanos":4083},"formatted_output":"  1600\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now); err != nil {\n  1601\t\t\tt.Fatalf(\"seed run: %v\", err)\n  1602\t\t}\n  1603\t\n  1604\t\treport, err := buildDistillDryRunReport(brainDir, opts, now)\n  1605\t\tif err != nil {\n  1606\t\t\tt.Fatalf(\"dry-run: %v\", err)\n  1607\t\t}\n  1608\t\tif report.CachedSessions != 2 || report.SessionsToDistill != 0 {\n  1609\t\t\tt.Fatalf(\"same-config dry-run must predict all cached: cached=%d to_distill=%d\", report.CachedSessions, report.SessionsToDistill)\n  1610\t\t}\n  1611\t\tif report.EstimatedAgentCallsUpperBound != 0 {\n  1612\t\t\tt.Fatalf(\"same-config dry-run must predict zero agent calls, got %d\", report.EstimatedAgentCallsUpperBound)\n  1613\t\t}\n  1614\t\n  1615\t\t// A different model salts differently: the dry-run must predict re-distill.\n  1616\t\tchanged := opts\n  1617\t\tchanged.model = \"some-other-model\"\n  1618\t\treport, err = buildDistillDryRunReport(brainDir, changed, now)\n  1619\t\tif err != nil {\n  1620\t\t\tt.Fatalf(\"dry-run (changed model): %v\", err)\n  1621\t\t}\n  1622\t\tif report.SessionsToDistill != 2 || report.CachedSessions != 0 {\n  1623\t\t\tt.Fatalf(\"changed-model dry-run must predict re-distill: cached=%d to_distill=%d\", report.CachedSessions, report.SessionsToDistill)\n  1624\t\t}\n  1625\t}\n  1626\t\n  1627\tfunc TestDistillPipelineValidationAndCacheSaltCompatibility(t *testing.T) {\n  1628\t\tfor _, tc := range []struct {\n  1629\t\t\tinput string\n  1630\t\t\twant  string\n  1631\t\t\tok    bool\n  1632\t\t}{\n  1633\t\t\t{input: \"\", want: distillPipelineLegacy, ok: true},\n  1634\t\t\t{input: distillPipelineLegacy, want: distillPipelineLegacy, ok: true},\n  1635\t\t\t{input: distillPipelineCandidates, want: distillPipelineCandidates, ok: true},\n  1636\t\t\t{input: \"all\", ok: false},\n  1637\t\t} {\n  1638\t\t\tgot, err := normalizeDistillPipeline(tc.input)\n  1639\t\t\tif tc.ok && (err != nil || got != tc.want) {\n  1640\t\t\t\tt.Errorf(\"normalizeDistillPipeline(%q) = %q, %v; want %q\", tc.input, got, err, tc.want)\n  1641\t\t\t}\n  1642\t\t\tif !tc.ok && err == nil {\n  1643\t\t\t\tt.Errorf(\"normalizeDistillPipeline(%q) unexpectedly succeeded with %q\", tc.input, got)\n  1644\t\t\t}\n  1645\t\t}\n  1646\t\n  1647\t\tbase := distillCommandOptions{agent: \"command\", agentCommand: []string{\"fake\"}, model: \"local\"}\n  1648\t\temptySalt := distillCacheSalt(\"extract\", \"reconcile\", 0.75, base)\n  1649\t\tlegacy := base\n  1650\t\tlegacy.pipeline = distillPipelineLegacy\n  1651\t\tif got := distillCacheSalt(\"extract\", \"reconcile\", 0.75, legacy); got != emptySalt {\n  1652\t\t\tt.Fatalf(\"explicit legacy pipeline changed the pre-pipeline cache salt: %q != %q\", got, emptySalt)\n  1653\t\t}\n  1654\t\tcandidates := base\n  1655\t\tcandidates.pipeline = distillPipelineCandidates\n  1656\t\tcandidateSalt := distillCacheSalt(\"extract\", \"reconcile\", 0.75, candidates)\n  1657\t\tif candidateSalt == emptySalt {\n  1658\t\t\tt.Fatal(\"candidate and legacy pipelines must not share a session cache salt\")\n  1659\t\t}\n  1660\t\tif got := distillCacheSalt(\"extract\", \"changed reconcile prompt\", 0.12, candidates); got != candidateSalt {\n  1661\t\t\tt.Fatalf(\"legacy-only reconciliation knobs invalidated candidate extraction: %q != %q\", got, candidateSalt)\n  1662\t\t}\n  1663\t\tif distillSessionCacheKeyForPipeline(distillPipelineCandidates, \"main\", \"s1\") == distillSessionCacheKey(\"main\", \"s1\") {\n  1664\t\t\tt.Fatal(\"candidate and legacy pipelines must not share a session cache key\")\n  1665\t\t}\n  1666\t}\n  1667\t\n  1668\tfunc TestCandidatePipelinePreservesLegacyRollbackCacheUnlessForced(t *testing.T) {\n  1669\t\tnow := time.Date(2026, 8, 22, 12, 0, 0, 0, time.UTC)\n  1670\t\tbrainDir := writeSingleSessionFixture(t, now, `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always keep migrations reversible.\"}}`)\n  1671\t\trun := func(context.Context, string, []string, []byte, time.Duration) (string, error) { return \"NO_FACTS\", nil }\n  1672\t\tbase := distillCommandOptions{agent: \"command\", agentCommand: []string{\"fake\"}, run: run, maxChunkBytes: defaultDistillChunkSize, timeout: time.Minute}\n  1673\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, base, now); err != nil {\n  1674\t\t\tt.Fatal(err)\n  1675\t\t}\n  1676\t\tcandidate := base\n  1677\t\tcandidate.pipeline = distillPipelineCandidates\n  1678\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, candidate, now.Add(time.Minute)); err != nil {\n  1679\t\t\tt.Fatal(err)\n  1680\t\t}\n  1681\t\tcache := loadDistillCache(brainDir)\n  1682\t\tlegacyKey := distillSessionCacheKey(\"main\", \"s1\")\n  1683\t\tcandidateKey := distillSessionCacheKeyForPipeline(distillPipelineCandidates, \"main\", \"s1\")\n  1684\t\tif cache.Sessions[legacyKey] == \"\" || cache.Sessions[candidateKey] == \"\" {\n  1685\t\t\tt.Fatalf(\"normal candidate run did not preserve both cache namespaces: %+v\", cache.Sessions)\n  1686\t\t}\n  1687\t\n  1688\t\tcandidate.force = true\n  1689\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, candidate, now.Add(2*time.Minute)); err != nil {\n  1690\t\t\tt.Fatal(err)\n  1691\t\t}\n  1692\t\tcache = loadDistillCache(brainDir)\n  1693\t\tif cache.Sessions[legacyKey] != \"\" || cache.Sessions[candidateKey] == \"\" {\n  1694\t\t\tt.Fatalf(\"forced rebuild retained stale rollback fingerprints: %+v\", cache.Sessions)\n  1695\t\t}\n  1696\t}\n  1697\t\n  1698\tfunc TestCandidatePipelineCoalescesSameBranchSessionReexports(t *testing.T) {\n  1699\t\tnow := time.Date(2026, 8, 22, 12, 0, 0, 0, time.UTC)\n  1700\t\tbrainDir := t.TempDir()\n  1701\t\tolderRel := \"sessions/main/older.jsonl\"\n  1702\t\tnewerRel := \"sessions/main/newer.jsonl\"\n  1703\t\tolder := `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always keep migrations reversible.\"}}`\n  1704\t\tnewer := older + \"\\n\" + `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Never skip race tests.\"}}`\n  1705\t\tfor rel, content := range map[string]string{olderRel: older, newerRel: newer} {\n  1706\t\t\tpath := filepath.Join(brainDir, filepath.FromSlash(rel))\n  1707\t\t\tif err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {\n  1708\t\t\t\tt.Fatal(err)\n  1709\t\t\t}\n  1710\t\t\tif err := os.WriteFile(path, []byte(content), 0o600); err != nil {\n  1711\t\t\t\tt.Fatal(err)\n  1712\t\t\t}\n  1713\t\t}\n  1714\t\tmanifest := exportManifest{SchemaVersion: brainManifestSchemaVersion, GeneratedAt: now, DefaultBranch: \"main\", Sources: &brainSources{\n  1715\t\t\tSessions: &sessionSourceManifest{GeneratedAt: now, DefaultBranch: \"main\", Sessions: []exportSession{\n  1716\t\t\t\t{SessionID: \"shared\", Branch: \"main\", LatestCheckpoint: \"cp1\", TranscriptPath: olderRel, CreatedAt: now.Add(-2 * time.Hour)},\n  1717\t\t\t\t{SessionID: \"shared\", Branch: \"main\", LatestCheckpoint: \"cp2\", TranscriptPath: newerRel, CreatedAt: now.Add(-time.Hour)},\n  1718\t\t\t}},\n  1719\t\t}}\n  1720\t\tif err := writeBrainManifestAndReadme(brainDir, manifest); err != nil {\n  1721\t\t\tt.Fatal(err)\n  1722\t\t}\n  1723\t\tcalls := 0\n  1724\t\topts := distillCommandOptions{\n  1725\t\t\tagent: \"command\", agentCommand: []string{\"fake\"}, pipeline: distillPipelineCandidates,\n  1726\t\t\tmaxChunkBytes: defaultDistillChunkSize, timeout: time.Minute,\n  1727\t\t\trun: func(_ context.Context, _ string, _ []string, input []byte, _ time.Duration) (string, error) {\n  1728\t\t\t\tcalls++\n  1729\t\t\t\tif bytes.Contains(input, []byte(\"race tests\")) {\n  1730\t\t\t\t\treturn \"convention\\tpreferences.coding.style\\tRace tests must never be skipped.\\n\", nil\n  1731\t\t\t\t}\n  1732\t\t\t\treturn \"convention\\tpreferences.coding.style\\tMigrations must remain reversible.\\n\", nil\n  1733\t\t\t},\n  1734\t\t}\n  1735\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now); err != nil {\n  1736\t\t\tt.Fatal(err)\n  1737\t\t}\n  1738\t\tif calls != 2 {\n  1739\t\t\tt.Fatalf(\"initial candidate calls = %d, want 2 from only the newest export\", calls)\n  1740\t\t}\n  1741\t\tfacts, err := loadFacts(brainDir, \"main\")\n  1742\t\tif err != nil || len(facts) != 2 {\n  1743\t\t\tt.Fatalf(\"newest export facts = %+v, %v\", facts, err)\n  1744\t\t}\n  1745\t\tcalls = 0\n  1746\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now.Add(time.Minute)); err != nil {\n  1747\t\t\tt.Fatal(err)\n  1748\t\t}\n  1749\t\tif calls != 0 {\n  1750\t\t\tt.Fatalf(\"no-op rerun called provider %d times; older export poisoned the shared cache\", calls)\n  1751\t\t}\n  1752\t\tfacts, err = loadFacts(brainDir, \"main\")\n  1753\t\tif err != nil || len(facts) != 2 {\n  1754\t\t\tt.Fatalf(\"no-op rerun corrupted newest materialization: %+v, %v\", facts, err)\n  1755\t\t}\n  1756\t\tplan, err := buildDistillPlan(brainDir, &manifest, opts, distillCacheSalt(\"prompt\", \"reconcile\", 0.75, opts))\n  1757\t\tif err != nil || plan.TotalSessions != 1 {\n  1758\t\t\tt.Fatalf(\"dry-run plan did not coalesce session views: sessions=%d err=%v\", plan.TotalSessions, err)\n  1759\t\t}\n  1760\t}\n  1761\t\n  1762\tfunc TestCandidateCoalesceTiedViewsPrefersStrictTurnExtensionAndRejectsDivergence(t *testing.T) {\n  1763\t\tnow := time.Date(2026, 8, 22, 12, 0, 0, 0, time.UTC)\n  1764\t\tbrainDir := t.TempDir()\n  1765\t\tbase := `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always keep migrations reversible.\"}}`\n  1766\t\textended := base + \"\\n\" + `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Never skip race tests.\"}}`\n  1767\t\tdivergent := `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always squash migration commits.\"}}`\n  1768\t\twrite := func(rel, content string) {\n  1769\t\t\tt.Helper()\n  1770\t\t\tpath := filepath.Join(brainDir, filepath.FromSlash(rel))\n  1771\t\t\tif err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {\n  1772\t\t\t\tt.Fatal(err)\n  1773\t\t\t}\n  1774\t\t\tif err := os.WriteFile(path, []byte(content), 0o600); err != nil {\n  1775\t\t\t\tt.Fatal(err)\n  1776\t\t\t}\n  1777\t\t}\n  1778\t\twrite(\"sessions/base.jsonl\", base)\n  1779\t\twrite(\"sessions/extended.jsonl\", extended)\n  1780\t\twrite(\"sessions/divergent.jsonl\", divergent)\n  1781\t\tbaseSession := exportSession{SessionID: \"shared\", Branch: \"main\", LatestCheckpoint: \"fffffffffffe\", TranscriptPath: \"sessions/base.jsonl\", CreatedAt: now}\n  1782\t\textendedSession := exportSession{SessionID: \"shared\", Branch: \"main\", LatestCheckpoint: \"000000000001\", TranscriptPath: \"sessions/extended.jsonl\", CreatedAt: now}\n  1783\t\n  1784\t\tgot, err := coalesceCandidateDistillSessions(context.Background(), brainDir, []exportSession{baseSession, extendedSession}, func(session exportSession) string {\n  1785\t\t\treturn session.Branch\n  1786\t\t}, nil)\n  1787\t\tif err != nil {\n  1788\t\t\tt.Fatal(err)\n  1789\t\t}\n  1790\t\tif len(got) != 1 || got[0].TranscriptPath != extendedSession.TranscriptPath {\n  1791\t\t\tt.Fatalf(\"tied strict extension = %+v, want extended view despite lexically older checkpoint\", got)\n  1792\t\t}\n  1793\t\n  1794\t\tdivergentSession := exportSession{SessionID: \"shared\", Branch: \"main\", LatestCheckpoint: \"000000000002\", TranscriptPath: \"sessions/divergent.jsonl\", CreatedAt: now}\n  1795\t\tif _, err := coalesceCandidateDistillSessions(context.Background(), brainDir, []exportSession{baseSession, divergentSession}, func(session exportSession) string {\n  1796\t\t\treturn session.Branch\n  1797\t\t}, nil); err == nil || !strings.Contains(err.Error(), \"divergent tied exports\") {\n  1798\t\t\tt.Fatalf(\"divergent tied views error = %v\", err)\n  1799\t\t}\n  1800\t}\n  1801\t\n  1802\tfunc TestCandidateScopedRunIgnoresDivergentTiedViewsOutsideSelection(t *testing.T) {\n  1803\t\tnow := time.Date(2026, 8, 23, 1, 0, 0, 0, time.UTC)\n  1804\t\tbrainDir := t.TempDir()\n  1805\t\tsessions := []exportSession{\n  1806\t\t\t{SessionID: \"selected\", Branch: \"main\", LatestCheckpoint: \"main\", TranscriptPath: \"sessions/main.jsonl\", CreatedAt: now},\n  1807\t\t\t{SessionID: \"unrelated\", Branch: \"feature\", LatestCheckpoint: \"old\", TranscriptPath: \"sessions/feature-old.jsonl\", CreatedAt: now},\n  1808\t\t\t{SessionID: \"unrelated\", Branch: \"feature\", LatestCheckpoint: \"new\", TranscriptPath: \"sessions/feature-new.jsonl\", CreatedAt: now},\n  1809\t\t}\n  1810\t\tcontents := []string{\n  1811\t\t\t`{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always keep migrations reversible.\"}}`,\n  1812\t\t\t`{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always use SQLite.\"}}`,\n  1813\t\t\t`{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Never use SQLite.\"}}`,\n  1814\t\t}\n  1815\t\tfor index, session := range sessions {\n  1816\t\t\tpath := filepath.Join(brainDir, filepath.FromSlash(session.TranscriptPath))\n  1817\t\t\tif err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {\n  1818\t\t\t\tt.Fatal(err)\n  1819\t\t\t}\n  1820\t\t\tif err := os.WriteFile(path, []byte(contents[index]), 0o600); err != nil {\n  1821\t\t\t\tt.Fatal(err)\n  1822\t\t\t}\n  1823\t\t}\n  1824\t\tmanifest := exportManifest{SchemaVersion: brainManifestSchemaVersion, GeneratedAt: now, DefaultBranch: \"main\", Sources: &brainSources{\n  1825\t\t\tSessions: &sessionSourceManifest{GeneratedAt: now, DefaultBranch: \"main\", Sessions: sessions},\n  1826\t\t}}\n  1827\t\tif err := writeBrainManifestAndReadme(brainDir, manifest); err != nil {\n  1828\t\t\tt.Fatal(err)\n  1829\t\t}\n  1830\t\tcalls := 0\n  1831\t\topts := distillCommandOptions{\n  1832\t\t\tagent: \"command\", agentCommand: []string{\"fake\"}, pipeline: distillPipelineCandidates, branch: \"main\",\n  1833\t\t\tmaxChunkBytes: defaultDistillChunkSize, timeout: time.Minute,\n  1834\t\t\trun: func(context.Context, string, []string, []byte, time.Duration) (string, error) {\n  1835\t\t\t\tcalls++\n  1836\t\t\t\treturn \"NO_FACTS\", nil\n  1837\t\t\t},\n  1838\t\t}\n  1839\t\tif report, err := buildDistillDryRunReport(brainDir, opts, now); err != nil || report.Sessions != 1 {\n  1840\t\t\tt.Fatalf(\"scoped dry-run = %+v, %v\", report, err)\n  1841\t\t}\n  1842\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now); err != nil {\n  1843\t\t\tt.Fatal(err)\n  1844\t\t}\n  1845\t\tif calls != 1 {\n  1846\t\t\tt.Fatalf(\"scoped run calls = %d, want 1\", calls)\n  1847\t\t}\n  1848\t\tunscoped := opts\n  1849\t\tunscoped.branch = \"\"\n  1850\t\tif _, err := buildDistillDryRunReport(brainDir, unscoped, now); err == nil || !strings.Contains(err.Error(), \"divergent tied exports\") {\n  1851\t\t\tt.Fatalf(\"unscoped divergent dry-run error = %v\", err)\n  1852\t\t}\n  1853\t}\n  1854\t\n  1855\tfunc TestCandidatePipelineCacheNamespaceDoesNotClaimLegacyBranchName(t *testing.T) {\n  1856\t\tlegacyCollision := distillSessionCacheKey(\"pipeline:candidates\", \"s1\")\n  1857\t\tcandidate := distillSessionCacheKeyForPipeline(distillPipelineCandidates, \"main\", \"s1\")\n  1858\t\tif isCandidateDistillCacheKey(legacyCollision) {\n  1859\t\t\tt.Fatalf(\"legacy branch cache key %q was classified as candidate state\", legacyCollision)\n  1860\t\t}\n  1861\t\tif !isCandidateDistillCacheKey(candidate) {\n  1862\t\t\tt.Fatalf(\"candidate cache key %q was not recognized\", candidate)\n  1863\t\t}\n  1864\t\tif got, ok := distillCacheKeyBranch(legacyCollision); !ok || got != \"pipeline:candidates\" {\n  1865\t\t\tt.Fatalf(\"legacy branch owner = %q, %v\", got, ok)\n  1866\t\t}\n  1867\t\tif got, ok := distillCacheKeyBranch(candidate); !ok || got != \"main\" {\n  1868\t\t\tt.Fatalf(\"candidate branch owner = %q, %v\", got, ok)\n  1869\t\t}\n  1870\t}\n  1871\t\n  1872\tfunc TestCandidateBranchScopedForceInvalidatesOnlySelectedBranchCaches(t *testing.T) {\n  1873\t\tnow := time.Date(2026, 8, 22, 12, 0, 0, 0, time.UTC)\n  1874\t\tbrainDir := writeDistillFixture(t, now)\n  1875\t\tmanifest, err := loadBrainManifest(brainDir)\n  1876\t\tif err != nil {\n  1877\t\t\tt.Fatal(err)\n  1878\t\t}\n  1879\t\t// The same captured session can legitimately be exported on two branches.\n  1880\t\tmanifest.Sources.Sessions.Sessions[1].SessionID = \"s1\"\n  1881\t\tif err := writeBrainManifestAndReadme(brainDir, *manifest); err != nil {\n  1882\t\t\tt.Fatal(err)\n  1883\t\t}\n  1884\t\tfeatureTranscript := filepath.Join(brainDir, filepath.FromSlash(manifest.Sources.Sessions.Sessions[1].TranscriptPath))\n  1885\t\tif err := os.WriteFile(featureTranscript, []byte(`{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always keep migrations reversible.\"}}`), 0o600); err != nil {\n  1886\t\t\tt.Fatal(err)\n  1887\t\t}\n  1888\t\tmainLegacy := distillSessionCacheKey(\"main\", \"s1\")\n  1889\t\tmainCandidate := distillSessionCacheKeyForPipeline(distillPipelineCandidates, \"main\", \"s1\")\n  1890\t\tfeatureLegacy := distillSessionCacheKey(\"feature\", \"s1\")\n  1891\t\tfeatureCandidate := distillSessionCacheKeyForPipeline(distillPipelineCandidates, \"feature\", \"s1\")\n  1892\t\tif err := saveDistillCache(brainDir, distillCache{Version: distillCacheVersion, Sessions: map[string]string{\n  1893\t\t\tmainLegacy:       \"sha256:main-legacy\",\n  1894\t\t\tmainCandidate:    \"sha256:main-candidate\",\n  1895\t\t\tfeatureLegacy:    \"sha256:feature-legacy\",\n  1896\t\t\tfeatureCandidate: \"sha256:feature-candidate\",\n  1897\t\t\t\"s1\":             \"sha256:ambiguous-pre-upgrade\",\n  1898\t\t}}); err != nil {\n  1899\t\t\tt.Fatal(err)\n  1900\t\t}\n  1901\t\tcheckedUpfront := false\n  1902\t\topts := distillCommandOptions{\n  1903\t\t\tagent: \"command\", agentCommand: []string{\"fake\"}, pipeline: distillPipelineCandidates,\n  1904\t\t\tbranch: \"feature\", force: true, maxChunkBytes: defaultDistillChunkSize, timeout: time.Minute,\n  1905\t\t\trun: func(context.Context, string, []string, []byte, time.Duration) (string, error) {\n  1906\t\t\t\tcache := loadDistillCache(brainDir)\n  1907\t\t\t\tcheckedUpfront = cache.Sessions[mainLegacy] != \"\" && cache.Sessions[mainCandidate] != \"\" &&\n  1908\t\t\t\t\tcache.Sessions[featureLegacy] == \"\" && cache.Sessions[featureCandidate] == \"\" && cache.Sessions[\"s1\"] == \"\"\n  1909\t\t\t\treturn \"NO_FACTS\", nil\n  1910\t\t\t},\n  1911\t\t}\n  1912\t\tif _, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now.Add(time.Minute)); err != nil {\n  1913\t\t\tt.Fatal(err)\n  1914\t\t}\n  1915\t\tif !checkedUpfront {\n  1916\t\t\tt.Fatal(\"scoped force did not durably invalidate only the selected branch before provider work\")\n  1917\t\t}\n  1918\t\tcache := loadDistillCache(brainDir)\n  1919\t\tif cache.Sessions[mainLegacy] == \"\" || cache.Sessions[mainCandidate] == \"\" || cache.Sessions[featureLegacy] != \"\" || cache.Sessions[featureCandidate] == \"\" || cache.Sessions[\"s1\"] != \"\" {\n  1920\t\t\tt.Fatalf(\"scoped force cache result = %+v\", cache.Sessions)\n  1921\t\t}\n  1922\t}\n  1923\t\n  1924\tfunc TestCandidateForceIncludesOrphanFactAndProposalOnlyBranches(t *testing.T) {\n  1925\t\tnow := time.Date(2026, 8, 22, 12, 0, 0, 0, time.UTC)\n  1926\t\tbrainDir := writeSingleSessionFixture(t, now, `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Always keep migrations reversible.\"}}`)\n  1927\t\tpaths := normalizeFactPaths([]string{\"workflow.testing.rules\"})\n  1928\t\torphanFact := factRecord{\n  1929\t\t\tID:        factRecordID(\"Always run the orphan test.\", paths),\n  1930\t\t\tPaths:     paths,\n  1931\t\t\tText:      \"Always run the orphan test.\",\n  1932\t\t\tBranch:    \"orphan-facts\",\n  1933\t\t\tOrigin:    factOriginDistilled,\n  1934\t\t\tStatus:    factStatusActive,\n  1935\t\t\tCreatedAt: now,\n  1936\t\t\tUpdatedAt: now,\n  1937\t\t}\n  1938\t\tif err := writeFacts(brainDir, orphanFact.Branch, []factRecord{orphanFact}); err != nil {\n  1939\t\t\tt.Fatal(err)\n  1940\t\t}\n  1941\t\tproposalBranch := \"orphan-proposals\"\n  1942\t\tif err := writeFactProposals(brainDir, proposalBranch, []factProposal{{\n  1943\t\t\tAction: factActionMerge, CandidateID: \"fact:candidate\", TargetID: \"fact:target\", Confidence: 0.5, Branch: \"wrong-before-write\",\n  1944\t\t}}); err != nil {\n  1945\t\t\tt.Fatal(err)\n  1946\t\t}\n  1947\t\tlegacyBranch := \"legacy-branchless\"\n  1948\t\tif err := writeFactProposalsAtRel(brainDir, factsProposalsRelPath(legacyBranch), []factProposal{\n  1949\t\t\t{Action: factActionMerge, CandidateID: \"fact:local\", TargetID: \"fact:target\", Confidence: 0.4},\n  1950\t\t\t{Action: factActionMerge, CandidateID: \"fact:member\", TargetID: \"fact:target\", Confidence: 0.4, ProposedBy: \"member-b\"},\n  1951\t\t}); err != nil {\n  1952\t\t\tt.Fatal(err)\n  1953\t\t}\n  1954\t\tmismatchBranch := \"legacy-mismatch\"\n  1955\t\tif err := writeFactProposalsAtRel(brainDir, factsProposalsRelPath(mismatchBranch), []factProposal{{\n  1956\t\t\tAction: factActionMerge, CandidateID: \"fact:mismatch\", TargetID: \"fact:target\", Confidence: 0.4, Branch: \"different-owner\",\n  1957\t\t}}); err != nil {\n  1958\t\t\tt.Fatal(err)\n  1959\t\t}\n  1960\t\tsessionScoped, err := distillForceScopeBranches(brainDir, \"\", []string{\"main\"}, false)\n  1961\t\tif err != nil {\n  1962\t\t\tt.Fatal(err)\n  1963\t\t}\n  1964\t\tif !slices.Equal(sessionScoped.Branches, []string{\"main\"}) || len(sessionScoped.LegacyProposalRels) != 0 {\n  1965\t\t\tt.Fatalf(\"session-scoped force