{"timestamp":"2026-08-23T16:25:54.373Z","ordinal":15698,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":310631235,"cached_input_tokens":305034752,"cache_write_input_tokens":0,"output_tokens":649274,"reasoning_output_tokens":264658,"total_tokens":311280509},"last_token_usage":{"input_tokens":151389,"cached_input_tokens":148224,"cache_write_input_tokens":0,"output_tokens":240,"reasoning_output_tokens":7,"total_tokens":151629},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":100.0,"window_minutes":10080,"resets_at":1787968095},"secondary":null,"credits":{"has_credits":true,"unlimited":false,"balance":"3109.4079575000"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
