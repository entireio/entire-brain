sion_privacy.go:711:// pre-commit step fails, the exact validated tombstone and transaction bytes are\ninternal/cli/session_privacy.go:728:\t_, transactionPresent, err := loadPrivacyTransactionChecked(brainDir, sessionID)\ninternal/cli/session_privacy.go:732:\tvar transactionBefore []byte\ninternal/cli/session_privacy.go:733:\ttransactionRel := privacyTransactionRel(sessionID)\ninternal/cli/session_privacy.go:734:\tif transactionPresent {\ninternal/cli/session_privacy.go:735:\t\ttransactionBefore, present, err = readPrivacyArtifact(brainDir, transactionRel, \"privacy transaction\", maxManifestBytes)\ninternal/cli/session_privacy.go:740:\t\t\treturn fmt.Errorf(\"%s: privacy transaction disappeared before include\", memoryErrStateUnsafe)\ninternal/cli/session_privacy.go:742:\t\tif _, err := decodePrivacyTransaction(transactionBefore, sessionID); err != nil {\ninternal/cli/session_privacy.go:754:\t\ttransactionRel: transactionRel, transactionBefore: transactionBefore, transactionPresent: transactionPresent,\ninternal/cli/session_privacy.go:769:\t// Re-include is a clean slate: the old cleanup transaction no longer\ninternal/cli/session_privacy.go:772:\tif err := removePrivacyTransactionForInclude(brainDir, sessionID, transactionPresent); err != nil {\ninternal/cli/session_privacy.go:806:\tcurrentTransaction, transactionPresent, err := readPrivacyArtifact(brainDir, rollback.transactionRel, \"privacy transaction during include rollback\", maxManifestBytes)\ninternal/cli/session_privacy.go:810:\tcase !rollback.transactionPresent && !transactionPresent:\ninternal/cli/session_privacy.go:811:\tcase !rollback.transactionPresent:\ninternal/cli/session_privacy.go:812:\t\trestoreErr = errors.Join(restoreErr, fmt.Errorf(\"%s: privacy transaction appeared during include rollback\", memoryErrStateUnsafe))\ninternal/cli/session_privacy.go:813:\tcase transactionPresent && bytes.Equal(currentTransaction, rollback.transactionBefore):\ninternal/cli/session_privacy.go:814:\tcase transactionPresent:\ninternal/cli/session_privacy.go:815:\t\trestoreErr = errors.Join(restoreErr, fmt.Errorf(\"%s: privacy transaction changed during include rollback\", memoryErrStateUnsafe))\ninternal/cli/session_privacy.go:817:\t\tif err := restoreIncludePrivacyFile(brainDir, rollback.transactionRel, \"privacy transaction\", rollback.transactionBefore); err != nil {\n"},"started_at_ms":1787508054302,"completed_at_ms":1787508054302}}
