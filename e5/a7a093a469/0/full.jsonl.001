{"timestamp":"2026-08-23T16:44:04.186Z","ordinal":16230,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":323934461,"cached_input_tokens":318151680,"cache_write_input_tokens":0,"output_tokens":690119,"reasoning_output_tokens":279674,"total_tokens":324624580},"last_token_usage":{"input_tokens":131388,"cached_input_tokens":130816,"cache_write_input_tokens":0,"output_tokens":41,"reasoning_output_tokens":7,"total_tokens":131429},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":100.0,"window_minutes":10080,"resets_at":1787968095},"secondary":null,"credits":{"has_credits":true,"unlimited":false,"balance":"2489.0422775000"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
