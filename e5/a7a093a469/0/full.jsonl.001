oved, anchor)\n \t\t\t\t\tcontinue\n@@ -1668,3 +1687,3 @@\n \t\t\t}\n-\t\t\tif stripped > 0 && len(remaining) == 0 && fact.Origin != factOriginAuthored {\n+\t\t\tif stripped > 0 && len(remaining) == 0 && fact.Origin != factOriginAuthored && removedFactAnchorsOwnFact(removed) {\n \t\t\t\tdeletedIDs[fact.ID] = true\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /Users/thomi/Projects/entire-brain/internal/cli/session_privacy.go\n","stderr":""},"started_at_ms":1787508943889,"completed_at_ms":1787508943895}}
