    distillCandidateCueV1 = \"decision\"\n   107\t\tdistillCandidateCueClosedNegativeV1 distillCandidateCueV1 = \"closed_negative\"\n   108\t\tdistillCandidateCueInvariantV1      distillCandidateCueV1 = \"invariant\"\n   109\t\tdistillCandidateCueGotchaV1         distillCandidateCueV1 = \"gotcha\"\n   110\t\tdistillCandidateCueAcceptanceV1     distillCandidateCueV1 = \"acceptance\"\n   111\t)\n   112\t\n   113\t// distillCandidateTriggerV1 makes authority explicit. A user trigger is direct\n   114\t// evidence. An assistant trigger is useful enough to review, but is never\n   115\t// authoritative by default; it is marked as eligible for corroboration against\n   116\t// another user turn, repository evidence, or an independent session.\n   117\ttype distillCandidateTriggerV1 struct {\n   118\t\tTurnID                string                  `json:\"turn_id\"`\n   119\t\tRole                  distillTranscriptRoleV1 `json:\"role\"`\n   120\t\tCues                  []distillCandidateCueV1 `json:\"cues\"`\n   121\t\tAuthoritative         bool                    `json:\"authoritative\"`\n   122\t\tCorroborationEligible bool                    `json:\"corroboration_eligible\"`\n   123\t}\n   124\t\n   125\ttype distillCandidateCardV1 struct {\n   126\t\tSchemaVersion int                         `json:\"schema_version\"`\n   127\t\tID            string                      `json:\"id\"`\n   128\t\tSource        distillCandidateSourceV1    `json:\"source\"`\n   129\t\tStartLine     int                         `json:\"start_line\"`\n   130\t\tEndLine       int                         `json:\"end_line\"`\n   131\t\tTriggers      []distillCandidateTriggerV1 `json:\"triggers\"`\n   132\t\tEvidence      distillCandidateEvidenceV1  `json:\"evidence,omitempty\"`\n   133\t\tTurns         []distillNormalizedTurnV1   `json:\"turns\"`\n   134\t}\n   135\t\n  1080\t// from transitively becoming one provider-sized mega-card.\n  1081\tfunc selectDistillCandidateCardsV1(transcript distillNormalizedTranscriptV1) []distillCandidateCardV1 {\n  1082\t\tcards, _ := selectDistillCandidateCardsLimitedV1(transcript, 0)\n  1083\t\treturn cards\n  1084\t}\n  1085\t\n  1086\t// selectDistillCandidateCardsLimitedV1 stops during trigger discovery, before\n  1087\t// card/window copies are allocated, when limit is exceeded. limit<=0 is\n  1088\t// unbounded and is reserved for focused tests/local helpers; provider planning\n  1089\t// always supplies the per-session admission cap.\n  1090\tfunc selectDistillCandidateCardsLimitedV1(transcript distillNormalizedTranscriptV1, limit int) ([]distillCandidateCardV1, bool) {\n  1091\t\ttype triggerAt struct {\n  1092\t\t\tindex    int\n  1093\t\t\tcues     []distillCandidateCueV1\n  1094\t\t\tevidence distillCandidateEvidenceV1\n  1095\t\t}\n  1096\t\tvar triggers []triggerAt\n  1097\t\tfor index, turn := range transcript.Turns {\n  1098\t\t\tvar trigger triggerAt\n  1099\t\t\tswitch turn.Role {\n  1100\t\t\tcase distillTranscriptRoleUserV1:\n  1101\t\t\t\tif !turn.DirectUser {\n  1102\t\t\t\t\tcontinue\n  1103\t\t\t\t}\n  1104\t\t\t\tcues := distillCandidateCuesV1(turn.Text)\n  1105\t\t\t\tif len(cues) == 0 && index > 0 && transcript.Turns[index-1].Role == distillTranscriptRoleAssistantV1 && distillCandidateAdjacentAcceptanceV1.MatchString(strings.TrimSpace(turn.Text)) {\n  1106\t\t\t\t\tcues = []distillCandidateCueV1{distillCandidateCueAcceptanceV1}\n  1107\t\t\t\t}\n  1108\t\t\t\tif len(cues) == 0 {\n  1109\t\t\t\t\tcontinue\n  1110\t\t\t\t}\n  1111\t\t\t\ttrigger = triggerAt{index: index, cues: cues}\n  1112\t\t\tcase distillTranscriptRoleAssistantV1:\n  1113\t\t\t\tif transcript.AgentReview || !transcript.CheckpointSuccess {\n  1114\t\t\t\t\tcontinue\n  1115\t\t\t\t}\n  1116\t\t\t\tcues := distillCandidateAssistantCuesV1(turn.Text)\n  1117\t\t\t\tif len(cues) == 0 || !distillCandidateAssistantSameLocusV1(turn.Text, transcript.FilesTouched) {\n  1118\t\t\t\t\tcontinue\n  1119\t\t\t\t}\n  1120\t\t\t\t// Prefer a direct-user card whenever the adjacent human text already\n  1121\t\t\t\t// carries the authority or explicitly resolves this claim.\n  1122\t\t\t\tif index > 0 && transcript.Turns[index-1].Role == distillTranscriptRoleUserV1 && transcript.Turns[index-1].DirectUser && len(distillCandidateCuesV1(transcript.Turns[index-1].Text)) > 0 {\n  1123\t\t\t\t\tcontinue\n  1124\t\t\t\t}\n  1125\t\t\t\tif index+1 < len(transcript.Turns) && transcript.Turns[index+1].Role == distillTranscriptRoleUserV1 && transcript.Turns[index+1].DirectUser {\n  1126\t\t\t\t\tnextCues := distillCandidateCuesV1(transcript.Turns[index+1].Text)\n  1127\t\t\t\t\tif len(nextCues) == 0 && distillCandidateAdjacentAcceptanceV1.MatchString(strings.TrimSpace(transcript.Turns[index+1].Text)) {\n  1128\t\t\t\t\t\tnextCues = []distillCandidateCueV1{distillCandidateCueAcceptanceV1}\n  1129\t\t\t\t\t}\n  1130\t\t\t\t\tif distillCandidateCueSliceContainsV1(nextCues, distillCandidateCueAcceptanceV1) || distillCandidateCueSliceContainsV1(nextCues, distillCandidateCueCorrectionV1) {\n  1131\t\t\t\t\t\tcontinue\n  1132\t\t\t\t\t}\n  1133\t\t\t\t}\n  1134\t\t\t\ttrigger = triggerAt{\n  1135\t\t\t\t\tindex: index,\n  1136\t\t\t\t\tcues:  cues,\n  1137\t\t\t\t\tevidence: distillCandidateEvidenceV1{\n  1138\t\t\t\t\t\tCheckpointSuccess: true,\n  1139\t\t\t\t\t\tSameLocus:         true,\n  1140\t\t\t\t\t},\n  1141\t\t\t\t}\n  1142\t\t\tdefault:\n  1143\t\t\t\tcontinue\n  1144\t\t\t}\n  1145\t\t\ttriggers = append(triggers, trigger)\n  1146\t\t\tif limit > 0 && len(triggers) > limit {\n  1147\t\t\t\treturn nil, true\n  1148\t\t\t}\n  1149\t\t}\n  1150\t\tif len(triggers) == 0 {\n  1151\t\t\treturn nil, false\n  1152\t\t}\n  1153\t\n  1154\t\tcards := make([]distillCandidateCardV1, 0, len(triggers))\n  1155\t\tfor _, trigger := range triggers {\n  1156\t\t\tstart, end := trigger.index, trigger.index\n  1157\t\t\ttriggerRole := transcript.Turns[trigger.index].Role\n  1158\t\t\tif triggerRole == distillTranscriptRoleUserV1 {\n  1159\t\t\t\tif trigger.index > 0 && transcript.Turns[trigger.index-1].Role == distillTranscriptRoleAssistantV1 {\n  1160\t\t\t\t\tstart--\n  1161\t\t\t\t}\n  1162\t\t\t\tif trigger.index+1 < len(transcript.Turns) && transcript.Turns[trigger.index+1].Role == distillTranscriptRoleAssistantV1 {\n  1163\t\t\t\t\tend++\n  1164\t\t\t\t}\n  1165\t\t\t} else {\n  1166\t\t\t\tif trigger.index > 0 && transcript.Turns[trigger.index-1].Role == distillTranscriptRoleUserV1 {\n  1167\t\t\t\t\tstart--\n  1168\t\t\t\t}\n  1169\t\t\t\tif trigger.index+1 < len(transcript.Turns) && transcript.Turns[trigger.index+1].Role == distillTranscriptRoleUserV1 {\n  1170\t\t\t\t\tend++\n  2280\t\t// kept separately, and FingerprintMaterial is their streamed digest plus\n  2281\t\t// source anchors so a relocation or mechanics-only line shift re-applies facts\n  2282\t\t// with current provenance without materializing another full input copy or\n  2283\t\t// leaking paths/lines into provider input.\n  2284\t\tContent             string\n  2285\t\tFingerprintMaterial string\n  2286\t\tPreprocessedBytes   int\n  2287\t\tCandidateBytes      int\n  2288\t\tChunks              []transcriptChunk\n  2289\t\t// CandidateBatches retains the typed identity/provenance that Phase 2 needs\n  2290\t\t// to pack cards across sessions. Phase 1 continues consuming Chunks.\n  2291\t\tCandidateBatches []distillCandidateBatchV1\n  2292\t\tCandidateCards   int\n  2293\t\tErr              error\n  2294\t}\n  2295\t\n  2296\t// prepareDistillSessionInput is the single transcript-to-model boundary used\n  2297\t// by execution and dry-run planning. Keeping both callers on this helper makes\n  2298\t// the planned call/byte counts an exact prediction of the chosen pipeline.\n  2299\tfunc prepareDistillSessionInput(session exportSession, branch, content string, opts distillCommandOptions) preparedDistillSessionInput {\n  2300\t\tif mustDistillPipeline(opts.pipeline) != distillPipelineCandidates {\n  2301\t\t\tpreprocessed := preprocessTranscriptForDistill(content)\n  2302\t\t\treturn preparedDistillSessionInput{\n  2303\t\t\t\tContent:             preprocessed,\n  2304\t\t\t\tFingerprintMaterial: preprocessed,\n  2305\t\t\t\tPreprocessedBytes:   len(preprocessed),\n  2306\t\t\t\tChunks:              chunkTranscript(preprocessed, opts.maxChunkBytes),\n  2307\t\t\t}\n  2308\t\t}\n  2309\t\n  2310\t\tnormalized := normalizeDistillTranscriptV1(session, branch, content)\n  2311\t\tif normalized.Overflow {\n  2312\t\t\treturn preparedDistillSessionInput{Err: fmt.Errorf(\"candidate pipeline transcript exceeds normalization limits for %s\", filepath.ToSlash(session.TranscriptPath))}\n  2313\t\t}\n  2314\t\tif normalized.Unsupported {\n  2315\t\t\treturn preparedDistillSessionInput{Err: fmt.Errorf(\"candidate pipeline found an unsupported narrative record in %s\", filepath.ToSlash(session.TranscriptPath))}\n  2316\t\t}\n  2317\t\tif !normalized.Recognized {\n  2318\t\t\treturn preparedDistillSessionInput{Err: fmt.Errorf(\"candidate pipeline does not recognize transcript format for %s\", filepath.ToSlash(session.TranscriptPath))}\n  2319\t\t}\n  2320\t\tcards, overflow := selectDistillCandidateCardsLimitedV1(normalized, distillCandidateMaxCards)\n  2321\t\tif overflow {\n  2322\t\t\treturn preparedDistillSessionInput{Err: fmt.Errorf(\"candidate pipeline selected more than %d cards for %s\", distillCandidateMaxCards, filepath.ToSlash(session.TranscriptPath))}\n  2323\t\t}\n  2324\t\tcardLimit := opts.maxChunkBytes\n  2325\t\tif opts.shadow {\n  2326\t\t\t// Phase 2 freezes one policy for its performance evaluation. A complete\n  2327\t\t\t// card must fit the same hard ceiling as a pack; no silent trigger trim.\n  2328\t\t\tcardLimit = distillCandidatePackMaxRenderedBytesV2\n  2329\t\t}\n  2330\t\tbatches, err := packDistillCandidateCardsV1(cards, cardLimit)\n  2331\t\tif err != nil {\n  2332\t\t\treturn preparedDistillSessionInput{Err: err}\n  2333\t\t}\n  2334\t\tchunks := make([]transcriptChunk, len(batches))\n  2335\t\tfingerprint := sha256.New()\n  2336\t\tcandidateBytes := 0\n  2337\t\tfor i := range batches {\n  2338\t\t\tchunks[i] = batches[i].Chunk\n  2339\t\t\tcandidateBytes += len(batches[i].Chunk.Text)\n  2340\t\t\tif candidateBytes > distillCandidateMaxInputBytes {\n  2341\t\t\t\treturn preparedDistillSessionInput{Err: fmt.Errorf(\"candidate pipeline rendered input for %s exceeds %d bytes\", filepath.ToSlash(session.TranscriptPath), distillCandidateMaxInputBytes)}\n  2342\t\t\t}\n  2343\t\t\t_, _ = io.WriteString(fingerprint, batches[i].Chunk.Text)\n  2344\t\t\tfmt.Fprintf(fingerprint, \"\\x00%s\\x00%d\\x00%d\", batches[i].Chunk.DistillTurnID, batches[i].Chunk.StartLine, batches[i].Chunk.EndLine)\n  2345\t\t\tfor _, anchor := range batches[i].Anchors {\n  2346\t\t\t\tfmt.Fprintf(fingerprint, \"\\x00%s\\x00%s\\x00%s\\x00%d\\x00%d\", anchor.CandidateID, anchor.CheckpointID, anchor.Transcript, anchor.StartLine, anchor.EndLine)\n  2347\t\t\t}\n  2348\t\t}\n  2349\t\treturn preparedDistillSessionInput{\n  2350\t\t\tFingerprintMaterial: \"sha256:\" + hex.EncodeToString(fingerprint.Sum(nil)),\n  2351\t\t\tCandidateBytes:      candidateBytes,\n  2352\t\t\tChunks:              chunks,\n  2353\t\t\tCandidateBatches:    batches,\n  2354\t\t\tCandidateCards:      len(cards),\n  2355\t\t}\n  2356\t}\n  2357\t\n  2358\t// chunkTranscript splits a transcript into line-numbered chunks no larger than\n  2359\t// maxBytes (measured on the rendered, line-numbered text). A single line that\n  2360\t// exceeds maxBytes still becomes its own chunk rather than being dropped, so no\n  2361\t// content is silently lost. Blank input yields no chunks.\n  2362\tfunc chunkTranscript(content string, maxBytes int) []transcriptChunk {\n  2363\t\treturn chunkLines(content, maxBytes, true)\n  2364\t}\n  2365\t\n  2366\t// chunkLines is the shared chunker behind chunkTranscript. numberLines controls\n  2367\t// the per-line rendering: distill wants the \"<lineNo>\\t\" prefix so the agent can\n  2368\t// cite exact source lines, but the doc index wants clean text — the prefix would\n  2369\t// otherwise pollute the indexed text/embeddings and stop firstHeading from seeing\n  2370\t// markdown headings (a chunk would start \"12\\t## Title\", not \"## Title\").\n  2371\t// Chunk StartLine/EndLine metadata is preserved either way.\n  2372\tfunc chunkLines(content string, maxBytes int, numberLines bool) []transcriptChunk {\n  2373\t\tif maxBytes <= 0 {\n  2374\t\t\tmaxBytes = defaultDistillChunkSize\n  2375\t\t}\n"},"started_at_ms":1787507072228,"completed_at_ms":1787507072228}}
{"timestamp":"2026-08-23T17:44:32.287Z","ordinal":17085,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a02fb9-5d1f-78c2-80a0-a98ce3be0d1b","call_id":"call_fRLoKWpPok3pORd8n4140i05","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"internal/cli/distill_cmd.go:2330:\tbatches, err := packDistillCandidateCardsV1(cards, cardLimit)\ninternal/cli/distill_candidates.go:143:type distillCandidateAnchorV1 struct {\ninternal/cli/distill_candidates.go:156:type distillCandidateBatchV1 struct {\ninternal/cli/distill_candidates.go:1411:// packDistillCandidateCardsV1 deterministically sorts cards and emits exactly\ninternal/cli/distill_candidates.go:1414:func packDistillCandidateCardsV1(cards []distillCandidateCardV1, maxBytes int) ([]distillCandidateBatchV1, error) {\ninternal/cli/distill_candidates.go:1490:// renderDistillCandidateCardsV1 is the direct adapter for the existing distill\ninternal/cli/distill_candidates.go:1491:// runner. Call packDistillCandidateCardsV1 instead when candidate IDs/anchors\ninternal/cli/distill_candidates.go:1493:func renderDistillCandidateCardsV1(cards []distillCandidateCardV1, maxBytes int) ([]transcriptChunk, error) {\ninternal/cli/distill_candidates.go:1494:\tbatches, err := packDistillCandidateCardsV1(cards, maxBytes)\n    60\t\n    61\t// distillCandidateSourceV1 is the stable source identity carried by every card.\n    62\t// LatestCheckpoint is provenance, not part of turn IDs: appending a checkpoint\n    63\t// must not rename an unchanged earlier turn.\n    64\ttype distillCandidateSourceV1 struct {\n    65\t\tSessionID        string `json:\"session_id,omitempty\"`\n    66\t\tLatestCheckpoint string `json:\"checkpoint_id,omitempty\"`\n    67\t\tBranch           string `json:\"branch,omitempty\"`\n    68\t\tTranscript       string `json:\"transcript,omitempty\"`\n    69\t}\n    70\t\n    71\t// distillNormalizedTurnV1 is one visible user/assistant narrative turn. Origins\n    72\t// and SourceLines are plural because Codex commonly exports the same semantic\n    73\t// turn twice (event_msg plus response_item); normalization collapses that pair\n    74\t// without discarding either original source anchor.\n    75\ttype distillNormalizedTurnV1 struct {\n    76\t\tID          string                      `json:\"id\"`\n    77\t\tRole        distillTranscriptRoleV1     `json:\"role\"`\n    78\t\tOrigins     []distillTranscriptOriginV1 `json:\"origins\"`\n    79\t\tSourceLines []int                       `json:\"source_lines\"`\n    80\t\tStartLine   int                         `json:\"start_line\"`\n    81\t\tEndLine     int                         `json:\"end_line\"`\n    82\t\tText        string                      `json:\"text\"`\n    83\t\tDirectUser  bool                        `json:\"direct_user,omitempty\"`\n    84\t}\n    85\t\n    86\ttype distillNormalizedTranscriptV1 struct {\n    87\t\tSchemaVersion int                       `json:\"schema_version\"`\n    88\t\tRecognized    bool                      `json:\"recognized\"`\n    89\t\tUnsupported   bool                      `json:\"unsupported,omitempty\"`\n    90\t\tOverflow      bool                      `json:\"overflow,omitempty\"`\n    91\t\tSource        distillCandidateSourceV1  `json:\"source\"`\n    92\t\tTurns         []distillNormalizedTurnV1 `json:\"turns\"`\n    93\t\t// Repository evidence is bounded metadata from the canonical session\n    94\t\t// manifest. It is never copied wholesale into provider input.\n    95\t\tCheckpointSuccess bool     `json:\"-\"`\n    96\t\tFilesTouched      []string `json:\"-\"`\n    97\t\tAgentReview       bool     `json:\"-\"`\n    98\t}\n    99\t\n   100\ttype distillCandidateCueV1 string\n   101\t\n   102\tconst (\n   103\t\tdistillCandidateCueRuleV1           distillCandidateCueV1 = \"rule\"\n   104\t\tdistillCandidateCuePreferenceV1     distillCandidateCueV1 = \"preference\"\n   105\t\tdistillCandidateCueCorrectionV1     distillCandidateCueV1 = \"correction\"\n   106\t\tdistillCandidateCueDecisionV1       distillCandidateCueV1 = \"decision\"\n   107\t\tdistillCandidateCueClosedNegativeV1 distillCandidateCueV1 = \"closed_negative\"\n   108\t\tdistillCandidateCueInvariantV1      distillCandidateCueV1 = \"invariant\"\n   109\t\tdistillCandidateCueGotchaV1         distillCandidateCueV1 = \"gotcha\"\n   110\t\tdistillCandidateCueAcceptanceV1     distillCandidateCueV1 = \"acceptance\"\n   111\t)\n   112\t\n   113\t// distillCandidateTriggerV1 makes authority explicit. A user trigger is direct\n   114\t// evidence. An assistant trigger is useful enough to review, but is never\n   115\t// authoritative by default; it is marked as eligible for corroboration against\n   116\t// another user turn, repository evidence, or an independent session.\n   117\ttype distillCandidateTriggerV1 struct {\n   118\t\tTurnID                string                  `json:\"turn_id\"`\n   119\t\tRole                  distillTranscriptRoleV1 `json:\"role\"`\n   120\t\tCues                  []distillCandidateCueV1 `json:\"cues\"`\n   121\t\tAuthoritative         bool                    `json:\"authoritative\"`\n   122\t\tCorroborationEligible bool                    `json:\"corroboration_eligible\"`\n   123\t}\n   124\t\n   125\ttype distillCandidateCardV1 struct {\n   126\t\tSchemaVersion int                         `json:\"schema_version\"`\n   127\t\tID            string                      `json:\"id\"`\n   128\t\tSource        distillCandidateSourceV1    `json:\"source\"`\n   129\t\tStartLine     int                         `json:\"start_line\"`\n   130\t\tEndLine       int                         `json:\"end_line\"`\n   131\t\tTriggers      []distillCandidateTriggerV1 `json:\"triggers\"`\n   132\t\tEvidence      distillCandidateEvidenceV1  `json:\"evidence,omitempty\"`\n   133\t\tTurns         []distillNormalizedTurnV1   `json:\"turns\"`\n   134\t}\n   135\t\n  1080\t// from transitively becoming one provider-sized mega-card.\n  1081\tfunc selectDistillCandidateCardsV1(transcript distillNormalizedTranscriptV1) []distillCandidateCardV1 {\n  1082\t\tcards, _ := selectDistillCandidateCardsLimitedV1(transcript, 0)\n  1083\t\treturn cards\n  1084\t}\n  1085\t\n  1086\t// selectDistillCandidateCardsLimitedV1 stops during trigger discovery, before\n  1087\t// card/window copies are allocated, when limit is exceeded. limit<=0 is\n  1088\t// unbounded and is reserved for focused tests/local helpers; provider planning\n  1089\t// always supplies the per-session admission cap.\n  1090\tfunc selectDistillCandidateCardsLimitedV1(transcript distillNormalizedTranscriptV1, limit int) ([]distillCandidateCardV1, bool) {\n  1091\t\ttype triggerAt struct {\n  1092\t\t\tindex    int\n  1093\t\t\tcues     []distillCandidateCueV1\n  1094\t\t\tevidence distillCandidateEvidenceV1\n  1095\t\t}\n  1096\t\tvar triggers []triggerAt\n  1097\t\tfor index, turn := range transcript.Turns {\n  1098\t\t\tvar trigger triggerAt\n  1099\t\t\tswitch turn.Role {\n  1100\t\t\tcase distillTranscriptRoleUserV1:\n  1101\t\t\t\tif !turn.DirectUser {\n  1102\t\t\t\t\tcontinue\n  1103\t\t\t\t}\n  1104\t\t\t\tcues := distillCandidateCuesV1(turn.Text)\n  1105\t\t\t\tif len(cues) == 0 && index > 0 && transcript.Turns[index-1].Role == distillTranscriptRoleAssistantV1 && distillCandidateAdjacentAcceptanceV1.MatchString(strings.TrimSpace(turn.Text)) {\n  1106\t\t\t\t\tcues = []distillCandidateCueV1{distillCandidateCueAcceptanceV1}\n  1107\t\t\t\t}\n  1108\t\t\t\tif len(cues) == 0 {\n  1109\t\t\t\t\tcontinue\n  1110\t\t\t\t}\n  1111\t\t\t\ttrigger = triggerAt{index: index, cues: cues}\n  1112\t\t\tcase distillTranscriptRoleAssistantV1:\n  1113\t\t\t\tif transcript.AgentReview || !transcript.CheckpointSuccess {\n  1114\t\t\t\t\tcontinue\n  1115\t\t\t\t}\n  1116\t\t\t\tcues := distillCandidateAssistantCuesV1(turn.Text)\n  1117\t\t\t\tif len(cues) == 0 || !distillCandidateAssistantSameLocusV1(turn.Text, transcript.FilesTouched) {\n  1118\t\t\t\t\tcontinue\n  1119\t\t\t\t}\n  1120\t\t\t\t// Prefer a direct-user card whenever the adjacent human text already\n  1121\t\t\t\t// carries the authority or explicitly resolves this claim.\n  1122\t\t\t\tif index > 0 && transcript.Turns[index-1].Role == distillTranscriptRoleUserV1 && transcript.Turns[index-1].DirectUser && len(distillCandidateCuesV1(transcript.Turns[index-1].Text)) > 0 {\n  1123\t\t\t\t\tcontinue\n  1124\t\t\t\t}\n  1125\t\t\t\tif index+1 < len(transcript.Turns) && transcript.Turns[index+1].Role == distillTranscriptRoleUserV1 && transcript.Turns[index+1].DirectUser {\n  1126\t\t\t\t\tnextCues := distillCandidateCuesV1(transcript.Turns[index+1].Text)\n  1127\t\t\t\t\tif len(nextCues) == 0 && distillCandidateAdjacentAcceptanceV1.MatchString(strings.TrimSpace(transcript.Turns[index+1].Text)) {\n  1128\t\t\t\t\t\tnextCues = []distillCandidateCueV1{distillCandidateCueAcceptanceV1}\n  1129\t\t\t\t\t}\n  1130\t\t\t\t\tif distillCandidateCueSliceContainsV1(nextCues, distillCandidateCueAcceptanceV1) || distillCandidateCueSliceContainsV1(nextCues, distillCandidateCueCorrectionV1) {\n  1131\t\t\t\t\t\tcontinue\n  1132\t\t\t\t\t}\n  1133\t\t\t\t}\n  1134\t\t\t\ttrigger = triggerAt{\n  1135\t\t\t\t\tindex: index,\n  1136\t\t\t\t\tcues:  cues,\n  1137\t\t\t\t\tevidence: distillCandidateEvidenceV1{\n  1138\t\t\t\t\t\tCheckpointSuccess: true,\n  1139\t\t\t\t\t\tSameLocus:         true,\n  1140\t\t\t\t\t},\n  1141\t\t\t\t}\n  1142\t\t\tdefault:\n  1143\t\t\t\tcontinue\n  1144\t\t\t}\n  1145\t\t\ttriggers = append(triggers, trigger)\n  1146\t\t\tif limit > 0 && len(triggers) > limit {\n  1147\t\t\t\treturn nil, true\n  1148\t\t\t}\n  1149\t\t}\n  1150\t\tif len(triggers) == 0 {\n  1151\t\t\treturn nil, false\n  1152\t\t}\n  1153\t\n  1154\t\tcards := make([]distillCandidateCardV1, 0, len(triggers))\n  1155\t\tfor _, trigger := range triggers {\n  1156\t\t\tstart, end := trigger.index, trigger.index\n  1157\t\t\ttriggerRole := transcript.Turns[trigger.index].Role\n  1158\t\t\tif triggerRole == distillTranscriptRoleUserV1 {\n  1159\t\t\t\tif trigger.index > 0 && transcript.Turns[trigger.index-1].Role == distillTranscriptRoleAssistantV1 {\n  1160\t\t\t\t\tstart--\n  1161\t\t\t\t}\n  1162\t\t\t\tif trigger.index+1 < len(transcript.Turns) && transcript.Turns[trigger.index+1].Role == distillTranscriptRoleAssistantV1 {\n  1163\t\t\t\t\tend++\n  1164\t\t\t\t}\n  1165\t\t\t} else {\n  1166\t\t\t\tif trigger.index > 0 && transcript.Turns[trigger.index-1].Role == distillTranscriptRoleUserV1 {\n  1167\t\t\t\t\tstart--\n  1168\t\t\t\t}\n  1169\t\t\t\tif trigger.index+1 < len(transcript.Turns) && transcript.Turns[trigger.index+1].Role == distillTranscriptRoleUserV1 {\n  1170\t\t\t\t\tend++\n  2280\t\t// kept separately, and FingerprintMaterial is their streamed digest plus\n  2281\t\t// source anchors so a relocation or mechanics-only line shift re-applies facts\n  2282\t\t// with current provenance without materializing another full input copy or\n  2283\t\t// leaking paths/lines into provider input.\n  2284\t\tContent             string\n  2285\t\tFingerprintMaterial string\n  2286\t\tPreprocessedBytes   int\n  2287\t\tCandidateBytes      int\n  2288\t\tChunks              []transcriptChunk\n  2289\t\t// CandidateBatches retains the typed identity/provenance that Phase 2 needs\n  2290\t\t// to pack cards across sessions. Phase 1 continues consuming Chunks.\n  2291\t\tCandidateBatches []distillCandidateBatchV1\n  2292\t\tCandidateCards   int\n  2293\t\tErr              error\n  2294\t}\n  2295\t\n  2296\t// prepareDistillSessionInput is the single transcript-to-model boundary used\n  2297\t// by execution and dry-run planning. Keeping both callers on this helper makes\n  2298\t// the planned call/byte counts an exact prediction of the chosen pipeline.\n  2299\tfunc prepareDistillSessionInput(session exportSession, branch, content string, opts distillCommandOptions) preparedDistillSessionInput {\n  2300\t\tif mustDistillPipeline(opts.pipeline) != distillPipelineCandidates {\n  2301\t\t\tpreprocessed := preprocessTranscriptForDistill(content)\n  2302\t\t\treturn preparedDistillSessionInput{\n  2303\t\t\t\tContent:             preprocessed,\n  2304\t\t\t\tFingerprintMaterial: preprocessed,\n  2305\t\t\t\tPreprocessedBytes:   len(preprocessed),\n  2306\t\t\t\tChunks:              chunkTranscript(preprocessed, opts.maxChunkBytes),\n  2307\t\t\t}\n  2308\t\t}\n  2309\t\n  2310\t\tnormalized := normalizeDistillTranscriptV1(session, branch, content)\n  2311\t\tif normalized.Overflow {\n  2312\t\t\treturn preparedDistillSessionInput{Err: fmt.Errorf(\"candidate pipeline transcript exceeds normalization limits for %s\", filepath.ToSlash(session.TranscriptPath))}\n  2313\t\t}\n  2314\t\tif normalized.Unsupported {\n  2315\t\t\treturn preparedDistillSessionInput{Err: fmt.Errorf(\"candidate pipeline found an unsupported narrative record in %s\", filepath.ToSlash(session.TranscriptPath))}\n  2316\t\t}\n  2317\t\tif !normalized.Recognized {\n  2318\t\t\treturn preparedDistillSessionInput{Err: fmt.Errorf(\"candidate pipeline does not recognize transcript format for %s\", filepath.ToSlash(session.TranscriptPath))}\n  2319\t\t}\n  2320\t\tcards, overflow := selectDistillCandidateCardsLimitedV1(normalized, distillCandidateMaxCards)\n  2321\t\tif overflow {\n  2322\t\t\treturn preparedDistillSessionInput{Err: fmt.Errorf(\"candidate pipeline selected more than %d cards for %s\", distillCandidateMaxCards, filepath.ToSlash(session.TranscriptPath))}\n  2323\t\t}\n  2324\t\tcardLimit := opts.maxChunkBytes\n  2325\t\tif opts.shadow {\n  2326\t\t\t// Phase 2 freezes one policy for its performance evaluation. A complete\n  2327\t\t\t// card must fit the same hard ceiling as a pack; no silent trigger trim.\n  2328\t\t\tcardLimit = distillCandidatePackMaxRenderedBytesV2\n  2329\t\t}\n  2330\t\tbatches, err := packDistillCandidateCardsV1(cards, cardLimit)\n  2331\t\tif err != nil {\n  2332\t\t\treturn preparedDistillSessionInput{Err: err}\n  2333\t\t}\n  2334\t\tchunks := make([]transcriptChunk, len(batches))\n  2335\t\tfingerprint := sha256.New()\n  2336\t\tcandidateBytes := 0\n  2337\t\tfor i := range batches {\n  2338\t\t\tchunks[i] = batches[i].Chunk\n  2339\t\t\tcandidateBytes += len(batches[i].Chunk.Text)\n  2340\t\t\tif candidateBytes > distillCandidateMaxInputBytes {\n  2341\t\t\t\treturn preparedDistillSessionInput{Err: fmt.Errorf(\"candidate pipeline rendered input for %s exceeds %d bytes\", filepath.ToSlash(session.TranscriptPath), distillCandidateMaxInputBytes)}\n  2342\t\t\t}\n  2343\t\t\t_, _ = io.WriteString(fingerprint, batches[i].Chunk.Text)\n  2344\t\t\tfmt.Fprintf(fingerprint, \"\\x00%s\\x00%d\\x00%d\", batches[i].Chunk.DistillTurnID, batches[i].Chunk.StartLine, batches[i].Chunk.EndLine)\n  2345\t\t\tfor _, anchor := range batches[i].Anchors {\n  2346\t\t\t\tfmt.Fprintf(fingerprint, \"\\x00%s\\x00%s\\x00%s\\x00%d\\x00%d\", anchor.CandidateID, anchor.CheckpointID, anchor.Transcript, anchor.StartLine, anchor.EndLine)\n  2347\t\t\t}\n  2348\t\t}\n  2349\t\treturn preparedDistillSessionInput{\n  2350\t\t\tFingerprintMaterial: \"sha256:\" + hex.EncodeToString(fingerprint.Sum(nil)),\n  2351\t\t\tCandidateBytes:      candidateBytes,\n  2352\t\t\tChunks:              chunks,\n  2353\t\t\tCandidateBatches:    batches,\n  2354\t\t\tCandidateCards:      len(cards),\n  2355\t\t}\n  2356\t}\n  2357\t\n  2358\t// chunkTranscript splits a transcript into line-numbered chunks no larger than\n  2359\t// maxBytes (measured on the rendered, line-numbered text). A single line that\n  2360\t// exceeds maxBytes still becomes its own chunk rather than being dropped, so no\n  2361\t// content is silently lost. Blank input yields no chunks.\n  2362\tfunc chunkTranscript(content string, maxBytes int) []transcriptChunk {\n  2363\t\treturn chunkLines(content, maxBytes, true)\n  2364\t}\n  2365\t\n  2366\t// chunkLines is the shared chunker behind chunkTranscript. numberLines controls\n  2367\t// the per-line rendering: distill wants the \"<lineNo>\\t\" prefix so the agent can\n  2368\t// cite exact source lines, but the doc index wants clean text — the prefix would\n  2369\t// otherwise pollute the indexed text/embeddings and stop firstHeading from seeing\n  2370\t// markdown headings (a chunk would start \"12\\t## Title\", not \"## Title\").\n  2371\t// Chunk StartLine/EndLine metadata is preserved either way.\n  2372\tfunc chunkLines(content string, maxBytes int, numberLines bool) []transcriptChunk {\n  2373\t\tif maxBytes <= 0 {\n  2374\t\t\tmaxBytes = defaultDistillChunkSize\n  2375\t\t}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a02fb8-5db4-77e3-a158-975075162964"}}}
