ft.Source), distillCandidateSourceIdentityV1(right.Source)\n  1428\t\t\tif leftSource != rightSource {\n  1429\t\t\t\treturn leftSource < rightSource\n  1430\t\t\t}\n  1431\t\t\tif left.StartLine != right.StartLine {\n  1432\t\t\t\treturn left.StartLine < right.StartLine\n  1433\t\t\t}\n  1434\t\t\treturn left.ID < right.ID\n  1435\t\t})\n  1436\t\n  1437\t\tbatches := make([]distillCandidateBatchV1, 0, len(ordered))\n  1438\t\tfor _, card := range ordered {\n  1439\t\t\trendered, err := renderBoundedDistillCandidateCardV1(card, maxBytes)\n  1440\t\t\tif err != nil {\n  1441\t\t\t\treturn nil, err\n  1442\t\t\t}\n  1443\t\t\tanchor := distillCandidateAnchorV1{\n  1444\t\t\t\tCandidateID:  card.ID,\n  1445\t\t\t\tSessionID:    card.Source.SessionID,\n  1446\t\t\t\tCheckpointID: card.Source.LatestCheckpoint,\n  1447\t\t\t\tBranch:       card.Source.Branch,\n  1448\t\t\t\tTranscript:   card.Source.Transcript,\n  1449\t\t\t\tStartLine:    card.StartLine,\n  1450\t\t\t\tEndLine:      card.EndLine,\n  1451\t\t\t}\n  1452\t\t\ttriggerLine := distillCandidateTriggerLineV1(card)\n  1453\t\t\ttriggerTurnID := distillCandidateTriggerTurnIDV1(card)\n  1454\t\t\tanchorStart, anchorEnd := triggerLine, triggerLine\n  1455\t\t\tif distillCandidateCardHasCueV1(card, distillCandidateCueAcceptanceV1) {\n  1456\t\t\t\tanchorStart, anchorEnd = card.StartLine, triggerLine\n  1457\t\t\t}\n  1458\t\t\tbatches = append(batches, distillCandidateBatchV1{\n  1459\t\t\t\tCandidateIDs: []string{card.ID},\n  1460\t\t\t\tAnchors:      []distillCandidateAnchorV1{anchor},\n  1461\t\t\t\tChunk: transcriptChunk{\n  1462\t\t\t\t\tStartLine:     anchorStart,\n  1463\t\t\t\t\tEndLine:       anchorEnd,\n  1464\t\t\t\t\tDistillTurnID: triggerTurnID,\n  1465\t\t\t\t\tText:          rendered,\n  1466\t\t\t\t},\n  1467\t\t\t})\n  1468\t\t}\n  1469\t\treturn batches, nil\n  1470\t}\n  1471\t\n  1472\tfunc distillCandidateTriggerTurnIDV1(card distillCandidateCardV1) string {\n  1473\t\tif len(card.Triggers) > 0