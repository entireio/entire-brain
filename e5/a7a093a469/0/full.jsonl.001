he reconcile prompt\ninternal/cli/reconcile.go:129:// reconcilePrompt is the static system prompt for the reconcile pass. The\ninternal/cli/reconcile.go:130:// dynamic candidate/existing lists are supplied on stdin (see reconcileInput).\ninternal/cli/reconcile.go:133:func reconcilePrompt() string {\ninternal/cli/reconcile.go:166:// reconcileInput renders the candidate and existing fact lists for stdin. Both\ninternal/cli/reconcile.go:169:func reconcileInput(candidates, existing []factRecord) []byte {\ninternal/cli/reconcile.go:203:\t\t\twarnings = append(warnings, \"reconcile: malformed line: \"+truncateString(line, 80))\ninternal/cli/reconcile.go:208:\t\t\twarnings = append(warnings, \"reconcile: bad candidate number: \"+truncateString(line, 80))\ninternal/cli/reconcile.go:226:\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"reconcile: %s missing existing number, treating candidate %d as new\", kind, ci))\ninternal/cli/reconcile.go:232:\t\t\t\twarnings = append(warnings, fmt.Sprintf(\"reconcile: %s with bad existing number, treating candidate %d as new\", kind, ci))\ninternal/cli/reconcile.go:244:\t\t\twarnings = append(warnings, \"reconcile: unknown decision: \"+truncateString(line, 80))\ninternal/cli/reconcile.go:254:\t\twarnings = append(warnings, fmt.Sprintf(\"reconcile: no decision for candidate %d, treating as new\", i+1))\ninternal/cli/reconcile.go:336:// newDistilledFactActions is the candidate pipeline's conservative settlement\ninternal/cli/reconcile.go:337:// boundary. Every extracted record is applied as new; factmerge.Upsert still\ninternal/cli/reconcile.go:339:// can silently merge or supersede an unrelated fact. Later candidate-pipeline\ninternal/cli/reconcile.go:350:// removeRelocatedDistillAnchors replaces the entire prior materialization for\ninternal/cli/reconcile.go:356:func removeRelocatedDistillAnchors(records []factRecord, source factAnchor) ([]factRecord, bool) {\ninternal/cli/reconcile.go:381:func removeMissingDistillTurnAnchors(records []