eCards = input.CandidateCards\n  1837\t\t\tplan.RawBytes += int64(sessionPlan.RawBytes)\n  1838\t\t\tplan.PreprocessedBytes += int64(sessionPlan.PreprocessedBytes)\n  1839\t\t\tplan.CandidateBytes += int64(sessionPlan.CandidateBytes)\n  1840\t\t\tif pipeline == distillPipelineCandidates && plan.CandidateBytes > int64(distillCandidateMaxPreflightBytes) {\n  1841\t\t\t\treturn distillPlan{}, fmt.Errorf(\"candidate preflight input exceeds %d bytes\", distillCandidateMaxPreflightBytes)\n  1842\t\t\t}\n  1843\t\t\tplan.CandidateCardsIfUncached += input.CandidateCards\n  1844\t\t\tif distillOpts.shadow {\n  1845\t\t\t\tfor _, batch := range input.CandidateBatches {\n  1846\t\t\t\t\tif len(batch.CandidateIDs) != 1 || len(batch.Anchors) != 1 || batch.CandidateIDs[0] != batch.Anchors[0].CandidateID {\n  1847\t\t\t\t\t\treturn distillPlan{}, fmt.Errorf(\"candidate shadow found an invalid Phase 1 card boundary for %s\", filepath.ToSlash(session.TranscriptPath))\n  1848\t\t\t\t\t}\n  1849\t\t\t\t\tmember := distillCandidatePackMemberV2{CandidateID: batch.CandidateIDs[0], RenderedCard: batch.Chunk.Text, Anchor: batch.Anchors[0]}\n  1850\t\t\t\t\tif prior, exists := candidateMemberSeen[member.CandidateID]; exists {\n  1851\t\t\t\t\t\tif prior.RenderedCard != member.RenderedCard || prior.Anchor.SessionID != member.Anchor.SessionID {\n  1852\t\t\t\t\t\t\treturn distillPlan{}, fmt.Errorf(\"candidate shadow member %q has conflicting content-addressed views\", member.CandidateID)\n  1853\t\t\t\t\t\t}\n  1854\t\t\t\t\t\tcontinue\n  1855\t\t\t\t\t}\n  1856\t\t\t\t\tcandidateMemberSeen[member.CandidateID] = member\n  1857\t\t\t\t\tplan.CandidatePackMembersV2 = append(plan.CandidatePackMembersV2, member)\n  1858\t\t\t\t}\n  1859\t\t\t}\n  1860\t\t\tsessionPlan.Fingerprint = distillSessionFingerprint(session, branch, input.FingerprintMaterial, plan.CacheSalt)\n  1861\t\t\tchunks := input.Chunks\n  1862\t\t\tsessionPlan.ChunksIfUncached = len(chunks)\n  1863\t\t\tplan.ChunksIfUncached += sessionPlan.ChunksIfUncached\n  1864\t\t\tif !distillOpts.force {\n  1865\t\t\t\tprev, ok := cachedDistillSessionFingerprint(prevCache, distillOpts.pipeline, branch, session.SessionID)\n  1866\t\t\t\tlegacyGrandfathered := distillOpts.pipeline == distillPipelineLegacy && grandfatheredDistillFingerprint(prevCache, session, branch, input.Content)\n  1867\t\t\t\tif (ok && prev == sessionPlan.Fingerprint) || legacyGrandfathered {\n  1868\t\t\t\t\tsessionPlan.Cached = true\n  1869\t\t\t\t\tplan.CachedSessions++\n  1870\t\t\t\t\tplan.Sessions = append(plan.Sessions, sessionPlan)\n  1871\t\t\t\t\tcontinue\n  1872\t\t\t\t}\n  1873\t\t\t}\n  1874\t\t\tplan.SessionsToDistill++\n  1875\t\t\tplan.CandidateCards += input.CandidateCards\n  1875\t\t\tplan.CandidateCards += input.CandidateCards\n  1876\t\t\tfor chunkIndex := range chunks {\n  1877\t\t\t\tworkIndex := len(plan.Work)\n  1878\t\t\t\tsessionPlan.ChunkIndexes = append(sessionPlan.ChunkIndexes, workIndex)\n  1879\t\t\t\tplan.Work = append(plan.Work, distillChunkWork{\n  1880\t\t\t\t\tSessionIndex: len(plan.Sessions),\n  1881\t\t\t\t\tChunkIndex:   chunkIndex,\n  1882\t\t\t\t\tBranch:       branch,\n  1883\t\t\t\t})\n  1884\t\t\t}\n  1885\t\t\tplan.Chunks += len(chunks)\n  1886\t\t\tplan.Sessions = append(plan.Sessions, sessionPlan)\n  1887\t\t}\n  1888\t\tsort.Strings(plan.BranchOrder)\n  1889\t\treturn plan, nil\n  1890\t}\n  1891\t\n  1892\t// sortDistillSessionsDeterministically fixes the global order used by both\n  1893\t// live extraction and dry-run packing. CreatedAt is the semantic chronology;\n  1894\t// the remaining fields make timestamp ties independent of manifest/export\n  1895\t// iteration order. Candidate cards retain their normalized source-turn order\n  1896\t// within each selected session.\n  1897\tfunc sortDistillSessionsDeterministically(sessions []exportSession, resolveBranch func(exportSession) string) {\n  1898\t\tsort.Slice(sessions, func(i, j int) bool {\n  1899\t\t\tleft, right := sessions[i], sessions[j]\n  1900\t\t\tif !left.CreatedAt.Equal(right.CreatedAt) {\n  1901\t\t\t\treturn left.CreatedAt.Before(right.CreatedAt)\n  1902\t\t\t}\n  1903\t\t\tleftValues := []string{\n  1904\t\t\t\tstrings.TrimSpace(left.SessionID),\n  1905\t\t\t\tstrings.TrimSpace(resolveBranch(left)),\n  1906\t\t\t\tfilepath.ToSlash(strings.TrimSpace(left.TranscriptPath)),\n  1907\t\t\t\tstrings.TrimSpace(left.LatestCheckpoint),\n  1908\t\t\t\tstrings.TrimSpace(left.TurnID),\n  1909\t\t\t}\n  1910\t\t\trightValues := []string{\n  1911\t\t\t\tstrings.TrimSpace(right.SessionID),\n  1912\t\t\t\tstrings.TrimSpace(resolveBranch(right)),\n  1913\t\t\t\tfilepath.ToSlash(strings.TrimSpace(right.TranscriptPath)),\n  1914\t\t\t\tstrings.TrimSpace(right.LatestCheckpoint),\n  1915\t\t\t\tstrings.TrimSpace(right.TurnID),\n  1916\t\t\t}\n  1917\t\t\tfor index := range leftValues {\n  1918\t\t\t\tif leftValues[index] != rightValues[index] {\n  1919\t\t\t\t\treturn leftValues[index] < rightValues[index]\n  1920\t\t\t\t}\n  1921\t\t\t}\n  1922\t\t\treturn left.SessionIndex < right.SessionIndex\n  1923\t\t})\n  1924\t}\n  1925\t\n  1926\tfunc resolveDistillBranch(manifest *exportManifest, session exportSession) string {\n  1927\t\tbranch := session.Branch\n  1928\t\tif branch == \"\" && manifest != nil {\n  1929\t\t\tbranch = strings.TrimSpace(manifest.DefaultBranch)\n  1930\t\t}\n  1931\t\tif branch == \"\" {\n  1932\t\t\tbranch = distillDefaultBranch\n  1933\t\t}\n  1934\t\treturn branch\n  1935\t}\n  1936\t\n  1937\t// preprocessTranscriptForDistill strips tool calls and tool outputs (plus\n  1938\t// session/meta records) from a JSONL transcript before chunking, leaving only the\n  1939\t// human and assistant conversation text that the quality gate actually mines for\n  1940\t// facts. Each input line maps to exactly one output line: a dropped record\n  1941\t// becomes a blank line, which chunkTranscript skips while still incrementing the\n  1942\t// line counter, so a distilled fact's provenance anchor keeps pointing at the\n  1943\t// correct line in the original transcript. Lines that are not JSON objects (for\n  1944\t// example an already-rendered/compact transcript) are passed through unchanged so\n  1945\t// the preprocessor is safe for any transcript format.\n  1946\tfunc preprocessTranscriptForDistill(content string) string {\n  1947\t\tif doc, ok := distillDocumentConversation(content); ok {\n  1948\t\t\treturn doc\n539:\tCandidatePackMembersV2   []distillCandidatePackMemberV2\n1489:\t\tmisses := make([]distillCandidatePackMemberV2, 0, len(plan.CandidatePackMembersV2))\n1490:\t\tfor _, member := range plan.CandidatePackMembersV2 {\n1498:\t\tallPacks, packErr := packDistillCandidateMembersV2(plan.CandidatePackMembersV2)\n1543:\t\tCandidateMembers:              len(plan.CandidatePackMembersV2),\n1857:\t\t\t\tplan.CandidatePackMembersV2 = append(plan.CandidatePackMembersV2, member)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a02fb8-5db4-77e3-a158-975075162964"}}}
