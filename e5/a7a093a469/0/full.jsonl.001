n   100\t\tsource, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now)\n   101\t\tif err != nil {\n   102\t\t\tt.Fatalf(\"runDistillForBrain: %v\", err)\n   103\t\t}\n   104\t\tif calls != 2 {\n   105\t\t\tt.Fatalf(\"expected one agent call per session (2), got %d\", calls)\n   300\t\t}\n   301\t\tif second.ExtractionCalls != 0 || second.CandidateCacheHits != 1 || calls != 1 {\n   302\t\t\tt.Fatalf(\"mechanics relocation invalidated extraction: calls=%d source=%+v\", calls, second)\n   303\t\t}\n   304\t\tappended := relocated + \"\\n\" + `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Never skip race tests.\"}}`\n   305\t\tif err := os.WriteFile(filepath.Join(brainDir, filepath.FromSlash(rel)), []byte(appended), 0o600); err != nil {\n   306\t\t\tt.Fatal(err)\n   307\t\t}\n   308\t\tthird, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now.Add(2*time.Minute))\n   309\t\tif err != nil {\n   310\t\t\tt.Fatal(err)\n   311\t\t}\n   312\t\tif third.ExtractionCalls != 1 || third.CandidateCacheHits != 1 || third.CandidateCacheMisses != 1 || calls != 2 {\n   313\t\t\tt.Fatalf(\"one appended candidate did not cost exactly one pack call: calls=%d source=%+v\", calls, third)\n   314\t\t}\n   315\t}\n   316\t\n   317\tfunc candidateIDsFromPackedInputV2(t *testing.T, input []byte) []string {\n   318\t\tt.Helper()\n   319\t\tvar ids []string\n   320\t\tseen := map[string]bool{}\n   321\t\tfor _, line := range bytes.Split(input, []byte(\"\\n\")) {\n   322\t\t\tif len(bytes.TrimSpace(line)) == 0 {\n   323\t\t\t\tcontinue\n   324\t\t\t}\n   325\t\t\tvar header struct {\n   326\t\t\t\tType        string `json:\"type\"`\n   327\t\t\t\tCandidateID string `json:\"candidate_id\"`\n   328\t\t\t}\n   329\t\t\tif err := json.Unmarshal(line, &header); err != nil {\n   330\t\t\t\tt.Fatalf(\"packed candidate input is not JSONL: %v\", err)\n   331\t\t\t}\n   332\t\t\tif header.Type == \"distill_candidate_v1\" && !seen[header.CandidateID] {\n   333\t\t\t\tseen[header.CandidateID] = true\n   334\t\t\t\tids = append(ids, header.CandidateID)\n   335\t\t\t}\n   336\t\t}\n   337\t\tif len(ids) == 0 {\n   338\t\t\tt.Fatal(\"packed candidate input contains no candidate headers\")\n   339\t\t}\n   340\t\treturn ids\n   341\t}\n   342\t\n   343\tfunc readDistillShadowFilesV2(t *testing.T, brainDir string, rels []string) map[string][]byte {\n   344\t\tt.Helper()\n   345\t\tout := make(map[string][]byte, len(rels))\n   346\t\tfor _, rel := range rels {\n   347\t\t\tdata, err := os.ReadFile(filepath.Join(brainDir, filepath.FromSlash(rel)))\n   348\t\t\tif err != nil {\n   349\t\t\t\tt.Fatalf(\"read %s: %v\", rel, err)\n   350\t\t\t}\n   351\t\t\tout[rel] = data\n   352\t\t}\n   353\t\treturn out\n   354\t}\n"},"started_at_ms":1787507727279,"completed_at_ms":1787507727280}}
