h, input.Content) {\n400:\tcandidateMode := mustDistillPipeline(distillOpts.pipeline) == distillPipelineCandidates\n413:\t\tdata, err := readDistillCanonicalTranscript(ctx, brainDir, session.TranscriptPath, distillOpts.pipeline)\n433:func readDistillCanonicalTranscript(ctx context.Context, brainDir, rel, pipeline string) ([]byte, error) {\n434:\tif mustDistillPipeline(pipeline) == distillPipelineCandidates {\n463:\t// shadow runs candidate extraction without mutating active Brain state.\n464:\tshadow bool\n465:\t// pipeline selects the transcript-to-agent input path. The empty value is\n467:\tpipeline  string\n575:\tPipeline                      string                 `json:\"pipeline\"`\n605:\tShadow                        bool                   `json:\"shadow,omitempty\"`\n635:\tdistillOpts := distillCommandOptions{agent: \"auto\", timeout: defaultDistillTimeout, maxChunkBytes: defaultDistillChunkSize, confidenceThreshold: defaultFactConfidenceThreshold, concurrency: defaultDistillConcurrency, pipeline: distillPipelineLegacy}\n657:\tcmd.Flags().Float64Var(&distillOpts.confidenceThreshold, \"confidence\", defaultFactConfidenceThreshold, \"Minimum legacy-agent confidence to auto-apply a merge/supersede; ignored by the candidates pipeline\")\n661:\tcmd.Flags().BoolVar(&distillOpts.shadow, \"shadow\", false, \"Run candidate extraction without mutating active facts, proposals, taxonomy, or manifest (successful member results update the isolated v2 cache)\")\n662:\tcmd.Flags().StringVar(&distillOpts.pipeline, \"pipeline\", distillPipelineLegacy, \"Distillation input pipeline: legacy or candidates (experimental)\")\n665:\tcmd.Flags().IntVar(&distillOpts.maxChunkBytes, \"max-chunk-bytes\", defaultDistillChunkSize, \"Maximum legacy transcript chunk or candidate-card input size in bytes\")\n682:\t\treturn fmt.Errorf(\"--max-chunk-bytes must be greater than 0\")\n687:\tpipeline, err := normalizeDistillPipeline(distillOpts.pipeline)\n691:\tdistillOpts.pipeline = pipeline\n692:\tif distillOpts.shadow && pipeline != distillPipelineCandidates {\n693:\t\treturn errors.New(\"--shadow requires --pipeline candidates\")\n695:\tif distillOpts.shadow && distillOpts.force {\n696:\t\treturn errors.New(\"--shadow cannot be combined with --force\")\n698:\tif mustDistillPipeline(distillOpts.pipeline) == distillPipelineCandidates && distillOpts.maxChunkBytes < distillCandidateMinChunkBytes {\n699:\t\treturn fmt.Errorf(\"candidate pipeline requires --max-chunk-bytes >= %d\", distillCandidateMinChunkBytes)\n765:\tif distillOpts.shadow {\n766:\t\tfmt.Fprintf(cmd.OutOrStdout(), \"shadow extracted %d facts from %d candidate pack(s) in %d provider call(s); active Brain state was not changed\\n\",\n826:\tpipeline, err := normalizeDistillPipeline(distillOpts.pipeline)\n830:\tdistillOpts.pipeline = pipeline\n831:\tif distillOpts.shadow && pipeline != distillPipelineCandidates {\n832:\t\treturn nil, errors.New(\"--shadow requires --pipeline candidates\")\n834:\tif distillOpts.shadow && distillOpts.force {\n835:\t\treturn nil, errors.New(\"--shadow cannot be combined with --force\")\n837:\tif pipeline == distillPipelineCandidates && distillOpts.maxChunkBytes < distillCandidateMinChunkBytes {\n838:\t\treturn nil, fmt.Errorf(\"candidate pipeline requires --max-chunk-bytes >= %d\", distillCandidateMinChunkBytes)\n874:\tif pipeline == distillPipelineCandidates {\n891:\tif pipeline == distillPipelineCandidates {\n897:\t// Each pipeline owns a distinct key namespace. Preserve the inactive\n898:\t// pipeline's entries so an experimental candidate run never destroys the\n903:\t\t\tif (pipeline == distillPipelineCandidates && !candidateKey) || (pipeline == distillPipelineLegacy && candidateKey) {\n908:\t\t// A branch-scoped force rebuild invalidates both pipeline namespaces for\n949:\tif pipeline == distillPipelineCandidates {\n951:\t\tif err != nil || distillOpts.shadow {\n957:\tif distillOpts.force && pipeline == distillPipelineCandidates {\n971:\t\t// cache flush. Invalidate both pipeline namespaces for the rebuild scope up\n1048:\t\tif distillOpts.shadow {\n1145:\t// Session pipeline: a producer goroutine prepares sessions ahead —\n1166:\t\t\tcacheKey := distillSessionCacheKeyForPipeline(pipeline, branch, session.SessionID)\n1200:\t\t\tnewCache.Sessions[distillSessionCacheKeyForPipeline(pipeline, branch, session.SessionID)] = ps.fingerprint // unchanged; retain in cache and keep existing facts\n1214:\t\t\tif pipeline == distillPipelineCandidates {\n1224:\t\t\t\tif pipeline == distillPipelineCandidates {\n1237:\t\t\t\t\tif pipeline == distillPipelineCandidates {\n1255:\t\t\tif pipeline == distillPipelineCandidates {\n1288:\t\t\tif pipeline == distillPipelineCandidates {\n1296:\t\t\t\t// candidate pipeline is evaluated in shadow/opt-in runs.\n1329:\t\t\tif pipeline == distillPipelineCandidates {\n1345:\t\t\tnewCache.Sessions[distillSessionCacheKeyForPipeline(pipeline, branch, session.SessionID)] = ps.fingerprint\n1393:\t\tsource.Pipeline = pipeline\n1467:\tif mustDistillPipeline(distillOpts.pipeline) == distillPipelineCandidates {\n1504:\tif mustDistillPipeline(distillOpts.pipeline) == distillPipelineCandidates {\n1520:\t\tPipeline:                      mustDistillPipeline(distillOpts.pipeline),\n1531:\t\tPreprocessedBytesAvailable:    mustDistillPipeline(distillOpts.pipeline) != distillPipelineCandidates,\n1546:\t\tShadow:                        distillOpts.shadow,\n1548:\tif mustDistillPipeline(distillOpts.pipeline) == distillPipelineCandidates {\n1762:\t\treturn \"\", fmt.Errorf(\"--pipeline must be %q or %q\", distillPipelineLegacy, distillPipelineCandidates)\n1767:\tpipeline, err := normalizeDistillPipeline(value)\n1771:\treturn pipeline\n1779:\tpipeline, err := normalizeDistillPipeline(distillOpts.pipeline)\n1783:\tdistillOpts.pipeline = pipeline\n1787:\tif pipeline == distillPipelineCandidates && distillOpts.maxChunkBytes < distillCandidateMinChunkBytes {\n1788:\t\treturn distillPlan{}, fmt.Errorf(\"candidate pipeline requires --max-chunk-bytes >= %d\", distillCandidateMinChunkBytes)\n1796:\tif pipeline == distillPipelineCandidates {\n\tBranch        string\n\tFacts         int // candidate facts the agent has produced so far\n}\n\n// transcriptChunk is a line-numbered slice of one session transcript handed to\n// the agent. StartLine is the 1-based line offset of the chunk's first line in\n// the original transcript, used as the chunk's provenance anchor in Phase A.\ntype transcriptChunk struct {\n\tStartLine     int\n\tEndLine       int\n\tDistillTurnID string\n\tText          string\n}\n\n// distillCache memoizes the fingerprint of each session that has been\n// distilled, so an incremental run skips sessions whose transcript and\n// checkpoint are unchanged.\ntype distillCache struct {\n\tVersion  int               `json:\"version\"`\n\tSessions map[string]string `json:\"sessions\"`\n}\n\ntype distillPlan struct {\n\tSessions                 []distillSessionPlan\n\tWork                     []distillChunkWork\n\tBranchOrder              []string\n\tTotalSessions            int\n\tCachedSessions           int\n\tSessionsToDistill        int\n\tMissingTranscripts       int\n\tRawBytes                 int64\n\tPreprocessedBytes        int64\n\tCandidateBytes           int64\n\tCandidateCards           int\n\tCandidateCardsIfUncached int\n\tChunks                   int\n\tChunksIfUncached         int\n\tWarnings                 []string\n\tCacheSalt                string\n\tCandidatePackMembersV2   []distillCandidatePackMemberV2\n}\n\ntype distillSessionPlan struct {\n\tSession           exportSession\n\tBranch            string\n\tFingerprint       string\n\tCached            bool\n\tReadFailed        bool\n\tRawBytes          int\n\tPreprocessedBytes int\n\tCandidateBytes    int\n\tCandidateCards    int\n\tChunksIfUncached  int\n\tChunkIndexes      []int\n}\n\n// distillChunkWork is one planned (session, chunk) extraction call. Only the\n// indexes are kept: the dry-run reports count