 * time.Hour)},\n    32\t\t}\n    33\t\tfor _, s := range sessions {\n    34\t\t\tpath := filepath.Join(brainDir, filepath.FromSlash(s.TranscriptPath))\n    35\t\t\tif err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {\n    36\t\t\t\tt.Fatal(err)\n    37\t\t\t}\n    38\t\t\tif err := os.WriteFile(path, []byte(\"turn one\\nturn two\\n\"), 0o600); err != nil {\n    39\t\t\t\tt.Fatal(err)\n    40\t\t\t}\n    41\t\t}\n    42\t\tmanifest := exportManifest{\n    43\t\t\tSchemaVersion: brainManifestSchemaVersion,\n    44\t\t\tGeneratedAt:   now,\n    45\t\t\tDefaultBranch: \"main\",\n    46\t\t\tSources: &brainSources{\n    47\t\t\t\tSessions: &sessionSourceManifest{GeneratedAt: now, DefaultBranch: \"main\", Sessions: sessions},\n    48\t\t\t},\n    49\t\t}\n    50\t\tif err := writeBrainManifestAndReadme(brainDir, manifest); err != nil {\n    51\t\t\tt.Fatal(err)\n    52\t\t}\n    53\t\treturn brainDir\n    54\t}\n    55\t\n    56\t// writeSingleSessionFixture lays down a brain dir with a session manifest and\n    57\t// one main-branch session whose transcript holds the given content, returning\n    58\t// the brain dir.\n    59\tfunc writeSingleSessionFixture(t *testing.T, now time.Time, transcript string) string {\n    60\t\tt.Helper()\n    61\t\tbrainDir := t.TempDir()\n    62\t\ttp := \"sessions/main/s1.jsonl\"\n    63\t\tp := filepath.Join(brainDir, filepath.FromSlash(tp))\n    64\t\tif err := os.MkdirAll(filepath.Dir(p), 0o700); err != nil {\n    65\t\t\tt.Fatal(err)\n    66\t\t}\n    67\t\tif err := os.WriteFile(p, []byte(transcript), 0o600); err != nil {\n    68\t\t\tt.Fatal(err)\n    69\t\t}\n    70\t\tmanifest := exportManifest{\n    71\t\t\tSchemaVersion: brainManifestSchemaVersion,\n    72\t\t\tGeneratedAt:   now,\n    73\t\t\tDefaultBranch: \"main\",\n    74\t\t\tSources: &brainSources{Sessions: &sessionSourceManifest{GeneratedAt: now, DefaultBranch: \"main\", Sessions: []exportSession{\n    75\t\t\t\t{SessionID: \"s1\", Branch: \"main\", LatestCheckpoint: \"cp1\", TranscriptPath: tp, CreatedAt: now.Add(-time.Hour)},\n    76\t\t\t}}},\n    77\t\t}\n    78\t\tif err := writeBrainManifestAndReadme(brainDir, manifest); err != nil {\n    79\t\t\tt.Fatal(err)\n    80\t\t}\n    81\t\treturn brainDir\n    82\t}\n    83\t\n    84\tfunc TestRunDistillForBrainWritesFactsAndManifest(t *testing.T) {\n    85\t\tnow := time.Date(2026, 6, 4, 12, 0, 0, 0, time.UTC)\n    86\t\tbrainDir := writeDistillFixture(t, now)\n    87\t\n    88\t\tvar calls int\n    89\t\tfakeRun := func(ctx context.Context, dir string, args []string, input []byte, timeout time.Duration) (string, error) {\n    90\t\t\tcalls++\n    91\t\t\trecordDistillProviderUsage(ctx, distillProviderUsage{Source: \"test_provider\", Reported: true, InputReported: true, OutputReported: true, InputTokens: 100, OutputTokens: 10})\n    92\t\t\t// The agent must receive a line-numbered transcript chunk on stdin.\n    93\t\t\tif !strings.Contains(string(input), \"1\\tturn one\") {\n    94\t\t\t\tt.Errorf(\"chunk not line-numbered: %q\", input)\n    95\t\t\t}\n    96\t\t\treturn \"preferences.coding.style\\tThe user prefers concise commits.\\n\", nil\n    97\t\t}\n    98\t\topts := distillCommandOptions{agent: \"command\", agentCommand: []string{\"fake\"}, run: fakeRun, maxChunkBytes: defaultDistillChunkSize, timeout: time.Minute}\n    99\t\n   100\t\tsource, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now)\n   101\t\tif err != nil {\n   102\t\t\tt.Fatalf(\"runDistillForBrain: %v\", err)\n   103\t\t}\n   104\t\tif calls != 2 {\n   105\t\t\tt.Fatalf(\"expected one agent call per session (2), got %d\", calls)\n   300\t\t}\n   301\t\tif second.ExtractionCalls != 0 || second.CandidateCacheHits != 1 || calls != 1 {\n   302\t\t\tt.Fatalf(\"mechanics relocation invalidated extraction: calls=%d source=%+v\", calls, second)\n   303\t\t}\n   304\t\tappended := relocated + \"\\n\" + `{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"Never skip race tests.\"}}`\n   305\t\tif err := os.WriteFile(filepath.Join(brainDir, filepath.FromSlash(rel)), []byte(appended), 0o600); err != nil {\n   306\t\t\tt.Fatal(err)\n   307\t\t}\n   308\t\tthird, err := runDistillForBrain(context.Background(), t.TempDir(), brainDir, opts, now.Add(2*time.Minute))\n   309\t\tif err != nil {\n   310\t\t\tt.Fatal(err)\n   311\t\t}\n   312\t\tif third.ExtractionCalls != 1 || third.CandidateCacheHits != 1 || third.CandidateCacheMisses != 1 || calls != 2 {\n   313\t\t\tt.Fatalf(\"one appended candidate did not cost exactly one pack call: calls=%d source=%+v\", calls, third)\n   314\t\t}\n   315\t}\n   316\t\n   317\tfunc candidateIDsFromPackedInputV2(t *testing.T, input []byte) []string {\n   318\t\tt.Helper()\n   319\t\tvar ids []string\n   320\t\tseen := map[string]bool{}\n   321\t\tfor _, line := range bytes.Split(input, []byte(\"\\n\")) {\n   322\t\t\tif len(bytes.TrimSpace(line)) == 0 {\n   323\t\t\t\tcontinue\n   324\t\t\t}\n   325\t\t\tvar header struct {\n   326\t\t\t\tType        string `json:\"type\"`\n   327\t\t\t\tCandidateID string `json:\"candidate_id\"`\n   328\t\t\t}\n   329\t\t\tif err := json.Unmarshal(line, &header); err != nil {\n   330\t\t\t\tt.Fatalf(\"packed candidate input is not JSONL: %v\", err)\n   331\t\t\t}\n   332\t\t\tif header.Type == \"distill_candidate_v1\" && !seen[header.CandidateID] {\n   333\t\t\t\tseen[header.CandidateID] = true\n   334\t\t\t\tids = append(ids, header.CandidateID)\n   335\t\t\t}\n   336\t\t}\n   337\t\tif len(ids) == 0 {\n   338\t\t\tt.Fatal(\"packed candidate input contains no candidate headers\")\n   339\t\t}\n   340\t\treturn ids\n   341\t}\n   342\t\n   343\tfunc readDistillShadowFilesV2(t *testing.T, brainDir string, rels []string) map[string][]byte {\n   344\t\tt.Helper()\n   345\t\tout := make(map[string][]byte, len(rels))\n   346\t\tfor _, rel := range rels {\n   347\t\t\tdata, err := os.ReadFile(filepath.Join(brainDir, filepath.FromSlash(rel)))\n   348\t\t\ti