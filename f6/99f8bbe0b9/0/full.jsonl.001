{"timestamp":"2026-06-10T15:13:40.050Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_6xjt8zLFrCO9rB5WUiwop7ep","output":"Chunk ID: 152ad6\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 1200\nOutput:\n[tools]\n# Keep aligned with the `toolchain` directive in go.mod.\ngo = { version = \"1.26.2\" }\nshellcheck = \"0.11.0\"\n\n[tasks.fmt]\ndescription = \"Run gofmt\"\nrun = \"gofmt -s -w .\"\n\n[tasks.test]\ndescription = \"Run tests\"\nrun = \"go test ./...\"\n\n[tasks.\"test:ci\"]\ndescription = \"Run tests with race detection\"\nrun = \"go test -race ./...\"\n\n[tasks.\"test:phase1\"]\ndescription = \"Run deterministic Phase 1 semantic brain contract tests\"\nrun = \"ENTIRE_BRAIN_PHASE1_CI=1 go test -race ./internal/cli -run 'TestPhase1|TestSemantic|TestWorkspace|TestMCP|TestRefreshSemantic'\"\n\n[tasks.\"release:evidence\"]\ndescription = \"Check retained release-candidate replay-lab evidence without rewriting tracked reports\"\nrun = '''\nset -e\npython3 benchmarks/agent-brain/run_test.py\ntmp=\"$(mktemp -d)\"\ntrap 'rm -rf \"$tmp\"' EXIT\npython3 benchmarks/agent-brain/audit_codex.py \\\n  --results benchmarks/agent-brain/evidence/release \\\n  --release-manifest benchmarks/agent-brain/evidence/release/manifest.json \\\n  --out-dir \"$tmp\" \\\n  --fail-on-flags\nfor report in codex-audit-report.json codex-audit-report.md; do\n  committed=\"benchmarks/agent-brain/evidence/release/$report\"\n  generated=\"$tmp/$report\"\n  if ! cmp -s \"$committed\" \"$generated\"; then\n    echo \"retained release evidence report is stale: $report\" >&2\n    diff -u \"$committed\" \"$generated\" >&2 || true\n    echo \"run: mise run release:evidence:update\" >&2\n    exit 1\n  fi\ndone\n'''\n\n[tasks.\"release:evidence:update\"]\ndescription = \"Regenerate retained release-candidate replay-lab audit reports after the release gate passes\"\nrun = '''\nset -e\npython3 benchmarks/agent-brain/run_test.py\ntmp=\"$(mktemp -d)\"\ntrap 'rm -rf \"$tmp\"' EXIT\npython3 benchmarks/agent-brain/audit_codex.py \\\n  --results benchmarks/agent-brain/evidence/release \\\n  --release-manifest benchmarks/agent-brain/evidence/release/manifest.json \\\n  --out-dir \"$tmp\" \\\n  --fail-on-flags\nmkdir -p benchmarks/agent-brain/evidence/release\ncp \"$tmp\"/codex-audit-report.json \"$tmp\"/codex-audit-report.md benchmarks/agent-brain/evidence/release/\n'''\n\n[tasks.\"radar:screen\"]\ndescription = \"Summarize Regression Radar pilots/release-candidates and flag saturated candidates\"\nrun = '''\nset -e\ntmp=\"$(mktemp -d)\"\ntrap 'rm -rf \"$tmp\"' EXIT\npython3 benchmarks/agent-brain/audit_codex.py \\\n  --results benchmarks/agent-brain/results \\\n  --suite-glob 'pilot-radar-*' \\\n  --suite-glob 'release-candidate-*-radar-*' \\\n  --suite-glob 'release-candidate-*-workspace-radar-*' \\\n  --out-dir \"$tmp\" > \"$tmp/codex-audit.stdout\"\npython3 benchmarks/agent-brain/audit_radar_evidence.py \\\n  --results benchmarks/agent-brain/results \\\n  --suite-glob 'pilot-radar-*' \\\n  --suite-glob 'release-candidate-*-radar-*' \\\n  --suite-glob 'release-candidate-*-workspace-radar-*' \\\n  --out-dir \"$tmp\" \\\n  --codex-audit-report \"$tmp/codex-audit-report.json\"\ncat \"$tmp/radar-candidate-report.md\"\n'''\n\n[tasks.\"radar:screen:audit\"]\ndescription = \"Build the independent Codex audit used to back the Radar screen\"\nrun = '''\nset -e\ntmp=\"$(mktemp -d)\"\ntrap 'rm -rf \"$tmp\"' EXIT\npython3 benchmarks/agent-brain/audit_codex.py \\\n  --results benchmarks/agent-brain/results \\\n  --suite-glob 'pilot-radar-*' \\\n  --suite-glob 'release-candidate-*-radar-*' \\\n  --suite-glob 'release-candidate-*-workspace-radar-*' \\\n  --out-dir \"$tmp\"\ncat \"$tmp/codex-audit-report.md\"\n'''\n\n[tasks.\"radar:evidence\"]\ndescription = \"Check deterministic retained MCP/Radar tool-contract evidence\"\nrun = '''\nset -e\ntmp=\"$(mktemp -d)\"\ntrap 'rm -rf \"$tmp\"' EXIT\npython3 benchmarks/agent-brain/audit_radar_tool_evidence.py \\\n  --manifest benchmarks/agent-brain/evidence/radar-tool/manifest.json \\\n  --out-dir \"$tmp\" \\\n  --fail-on-flags\nfor report in radar-tool-audit-report.json radar-tool-audit-report.md; do\n  committed=\"benchmarks/agent-brain/evidence/radar-tool/$report\"\n  generated=\"$tmp/$report\"\n  if ! cmp -s \"$committed\" \"$generated\"; then\n    echo \"retained Radar tool evidence report is stale: $report\" >&2\n    diff -u \"$committed\" \"$generated\" >&2 || true\n    echo \"run: mise run radar:evidence:update\" >&2\n    exit 1\n  fi\ndone\n'''\n\n[tasks.\"radar:evidence:update\"]\ndescription = \"Regenerate retained deterministic MCP/Radar tool-contract audit reports after the gate passes\"\nrun = '''\nset -e\ntmp=\"$(mktemp -d)\"\ntrap 'rm -rf \"$tmp\"' EXIT\npython3 benchmarks/agent-brain/audit_radar_tool_evidence.py \\\n  --manifest benchmarks/agent-brain/evidence/radar-tool/manifest.json \\\n  --out-dir \"$tmp\" \\\n  --fail-on-flags\nmkdir -p benchmarks/agent-brain/evidence/radar-tool\ncp \"$tmp\"/radar-tool-audit-report.json \"$tmp\"/radar-tool-audit-report.md benchmarks/agent-brain/evidence/radar-tool/\n'''\n\n[tasks.\"radar:agent-evidence\"]\ndescription = \"Optional: require at least one retained proof-ready Regression Radar agent comparison\"\nrun = '''\nset -e\ntmp=\"$(mktemp -d)\"\ntrap 'rm -rf \"$tmp\"' EXIT\n"}}
