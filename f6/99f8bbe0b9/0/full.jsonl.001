the resource.","strict":false,"defer_loading":true,"parameters":{"type":"object","properties":{"agent":{"type":"string"},"fence":{"type":"number","description":"The fence from your prior claim, to refresh it; omit for a new claim."},"mode":{"type":"string","enum":["read","write","review"]},"path":{"type":"string"},"priority":{"type":"number","description":"Urgency for the auto-handoff queue (default 0). A higher-priority waiter (e.g. a hotfix) is granted before lower-priority ones already waiting."},"reason":{"type":"string"},"symbol":{"type":"string","description":"Optional: claim only this function/class/method (from list_symbols). Omit for the whole file."}},"required":["agent","path"]}},{"type":"function","name":"list_team_members","description":"List local Regente team members, their GitHub identities, live status, claims, tasks, and routed delivery counts.","strict":false,"defer_loading":true,"parameters":{"type":"object","properties":{}}},{"type":"function","name":"list_claims","description":"List active and historical claims.","strict":false,"defer_loading":true,"parameters":{"type":"object","properties":{}}},{"type":"function","name":"list_queue","description":"List the auto-handoff queue: agents waiting on files another agent holds. Each waiter is granted its file automatically the moment the holder releases it.","strict":false,"defer_loading":true,"parameters":{"type":"object","properties":{}}},{"type":"function","name":"check_conflicts","description":"Return detected claim/path conflicts.","strict":false,"defer_loading":true,"parameters":{"type":"object","properties":{}}},{"type":"function","name":"check_handoffs","description":"Check your inbox: files you were just auto-handed (with the fence to release them later), messages addressed to you, and what you're still waiting on. Call this after being queued to learn — on your own turn — that a file is now yours, no dashboard needed.","strict":false,"defer_loading":true,"parameters":{"type":"object","properties":{"agent":{"type":"string"},"cursor":{"type":"string","description":"ISO timestamp from a prior check; only newer messages are returned."}},"required":["agent"]}},{"type":"function","name":"claim_task","description":"Claim a task as the calling agent. Reserves the task's paths via the same claim+fence+auto-handoff queue; if any path is busy the task is queued and returned blocked (poll check_handoffs, then retry). Blocked if dependencies aren't done yet.","strict":false,"defer_loading":true,"parameters":{"type":"object","properties":{"agent":{"type":"string"},"id":{"type":"string","description":"The task id to claim."},"priority":{"type":"number","description":"Queue priority if paths are busy (higher preempts)."}},"required":["agent","id"]}}]}]}}
