{"timestamp":"2026-06-10T15:44:32.337Z","type":"response_item","payload":{"type":"function_call","name":"exec_command","arguments":"{\"cmd\":\"python3 - <<'PY'\\nimport json, pathlib, statistics\\nroot=pathlib.Path('benchmarks/agent-brain/results')\\nrows=[]\\nfor p in root.glob('*/summary.json'):\\n    try:\\n        s=json.loads(p.read_text())\\n    except Exception:\\n        continue\\n    comps=s.get('comparisons') or []\\n    for c in comps:\\n        name=str(p.parent.name)\\n        # collect radar/mcp-ish suites or conditions\\n        text=json.dumps(c).lower()+name.lower()\\n        if 'radar' not in text and 'mcp' not in text:\\n            continue\\n        rows.append((name,c))\\n\\ndef get(c, *keys):\\n    for k in keys:\\n        if k in c:\\n            return c[k]\\n    return None\\nfor name,c in rows:\\n    # print compact useful fields\\n    conds=(c.get('conditions') or c.get('arms') or c.get('comparison') or '')\\n    nb=None; brain=None\\n    for k,v in c.items():\\n        pass\\n    print('\\\\nSUITE',name)\\n    for key in ['task','runner','conditions','condition_a','condition_b','baseline','treatment','score_delta','mean_delta','pass_rate_delta','proof_ready','stability_tag','stability','flags']:\\n        if key in c:\\n            print(' ',key,':',c[key])\\n    # dump keys if unknown\\n    print(' keys=', sorted(c.keys()))\\nPY\",\"workdir\":\"/Users/suhaan/Documents/Coding/entire-brain\",\"yield_time_ms\":1000,\"max_output_tokens\":40000}","call_id":"call_u9vwRwGUaJLxAAyiNpab7AIy"}}
