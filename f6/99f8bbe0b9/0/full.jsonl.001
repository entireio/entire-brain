1646\t\tcmd.SetOut(&stdout)\n  1647\t\tcmd.SetErr(&stderr)\n  1648\t\tcmd.SetArgs([]string{\"distill\", \"--agent\", \"ollama\", \"--model\", \"llama3.2\", \"--json\", \"--force\", \"--jobs\", \"2\"})\n  1649\t\tif err := cmd.Execute(); err != nil {\n  1650\t\t\tt.Fatalf(\"distill ollama command: %v\\nstdout:\\n%s\\nstderr:\\n%s\", err, stdout.String(), stderr.String())\n  1651\t\t}\n  1652\t\tvar source factSourceManifest\n  1653\t\tif err := json.Unmarshal(stdout.Bytes(), &source); err != nil {\n  1654\t\t\tt.Fatalf(\"distill ollama JSON did not decode: %v\\nstdout:\\n%s\\nstderr:\\n%s\", err, stdout.String(), stderr.String())\n  1655\t\t}\n  1656\t\tif source.Agent != \"ollama\" || source.Model != \"llama3.2\" || source.Jobs != 2 || source.EffectiveJobs != 2 {\n  1657\t\t\tt.Fatalf(\"summary missing ollama run config: %+v\", source)\n  1658\t\t}\n  1659\t\tif source.Facts != 2 || source.ExtractionCalls != 2 || source.ReconcileCalls != 0 || source.TotalAgentCalls != 2 {\n  1660\t\t\tt.Fatalf(\"summary missing fact/call counts: %+v\", source)\n  1661\t\t}\n  1662\t\tif source.TotalSeconds < 0 || source.ExtractionSeconds < 0 || source.WriteSeconds < 0 {\n  1663\t\t\tt.Fatalf(\"summary timings should be non-negative: %+v\", source)\n  1664\t\t}\n  1665\t\tif len(seen) != 2 {\n  1666\t\t\tt.Fatalf(\"expected one loopback ollama request per fixture session, got %d\", len(seen))\n  1667\t\t}\n  1668\t\tfor _, req := range seen {\n  1669\t\t\tif req.Model != \"llama3.2\" {\n  1670\t\t\t\tt.Fatalf(\"ollama request used wrong model: %+v\", req)\n  1671\t\t\t}\n  1672\t\t\tif !strings.Contains(req.System, \"durable facts\") || !strings.Contains(req.Prompt, \"turn one\") {\n  1673\t\t\t\tt.Fatalf(\"ollama request missing distill system/prompt context: %+v\", req)\n  1674\t\t\t}\n  1675\t\t}\n  1676\t\tfor _, call := range runner.calls {\n  1677\t\t\tif call.name == \"ollama\" {\n  1678\t\t\t\tt.Fatalf(\"distill must use loopback HTTP runner, not PATH ollama binary: %+v\", ca