{"timestamp":"2026-06-10T16:52:15.604Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_MwFvvK5QCjD4W3BOzwI1dwbi","output":"Chunk ID: b83665\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 841\nOutput:\ntotal 96\ndrwxr-xr-x@ 11 suhaan  staff   352 Jun 10 12:52 .\ndrwxr-xr-x@  6 suhaan  staff   192 Jun 10 09:38 ..\n-rw-r--r--@  1 suhaan  staff  2796 Jun 10 07:20 README.md\n-rw-r--r--@  1 suhaan  staff  1041 Jun 10 07:26 distill-perf-audit-report.json\n-rw-r--r--@  1 suhaan  staff   338 Jun 10 07:26 distill-perf-audit-report.md\n-rw-r--r--@  1 suhaan  staff  6079 Jun 10 07:26 dry-run.json\n-rw-r--r--@  1 suhaan  staff  8416 Jun 10 12:52 go-test-internal-cli-ollama-distill.jsonl\n-rw-r--r--@  1 suhaan  staff   941 Jun 10 07:26 jobs-1.json\n-rw-r--r--@  1 suhaan  staff   939 Jun 10 07:26 jobs-4.json\n-rw-r--r--@  1 suhaan  staff  1794 Jun 10 07:16 local-command-agent.py\n-rw-r--r--@  1 suhaan  staff  2634 Jun 10 07:26 manifest.json\n{\n  \"schema\": 1,\n  \"target\": {\n    \"repo\": \"github.com/ashtom/entire-brain\",\n    \"repo_key\": \"gh/ashtom/entire-brain\",\n    \"source_head\": \"55518db0766bf7eab6b902bfee6ad178870003e2\",\n    \"brain_manifest_sha256\": \"sha256:f40ff62f445e2dda7b8523fbdb63e40a7c37abe6e9c89b31ee1f2c10cd95f03f\",\n    \"claim_scope\": \"current-repo local command-agent distill extraction scheduling speedup\"\n  },\n  \"cache_state\": \"force_recomputed_each_run\",\n  \"dry_run\": \"dry-run.json\",\n  \"serial_run\": \"jobs-1.json\",\n  \"parallel_run\": \"jobs-4.json\",\n  \"artifact_sha256\": {\n    \"dry_run\": \"sha256:17f9aef2309a055fe7426debd4409b5ba5b2cdfdbc69537141de24007f80aeaf\",\n    \"serial_run\": \"sha256:963c4862f604da8ea8bbd3650e0b9c4486bcdce59651033ee4a1a90a09271e21\",\n    \"parallel_run\": \"sha256:d065d8daf51d1259947279ed47ef7f679b445dfb22288f1f84396adc262d6574\"\n  },\n  \"commands\": {\n    \"dry_run\": [\n      \"entire-brain\",\n      \"distill\",\n      \"--dry-run\",\n      \"--json\",\n      \"--agent\",\n      \"command\",\n      \"--agent-command\",\n      \"python3\",\n      \"--agent-command\",\n      \"benchmarks/agent-brain/evidence/distill-perf/local-command-agent.py\",\n      \"--force\",\n      \"--max-chunk-bytes\",\n      \"262144\",\n      \"--confidence\",\n      \"0.75\",\n      \"--jobs\",\n      \"1\"\n    ],\n    \"serial_run\": [\n      \"entire-brain\",\n      \"distill\",\n      \"--json\",\n      \"--agent\",\n      \"command\",\n      \"--agent-command\",\n      \"python3\",\n      \"--agent-command\",\n      \"benchmarks/agent-brain/evidence/distill-perf/local-command-agent.py\",\n      \"--force\",\n      \"--max-chunk-bytes\",\n      \"262144\",\n      \"--confidence\",\n      \"0.75\",\n      \"--jobs\",\n      \"1\"\n    ],\n    \"parallel_run\": [\n      \"entire-brain\",\n      \"distill\",\n      \"--json\",\n      \"--agent\",\n      \"command\",\n      \"--agent-command\",\n      \"python3\",\n      \"--agent-command\",\n      \"benchmarks/agent-brain/evidence/distill-perf/local-command-agent.py\",\n      \"--force\",\n      \"--max-chunk-bytes\",\n      \"262144\",\n      \"--confidence\",\n      \"0.75\",\n      \"--jobs\",\n      \"4\"\n    ]\n  },\n  \"min_speedup\": 1.25,\n  \"notes\": [\n    \"Collected offline from a temporary copy of the current entire-brain local brain store.\",\n    \"Uses a deterministic local command agent to prove scheduler/extraction mechanics, not fact quality or hosted-model latency.\",\n    \"Does not support a frontend/entire.io 24h backfill claim; that still needs target-repo retained artifacts.\"\n  ],\n  \"redactions\": {\n    \"dry_run.brain_path\": \"redacted isolated temp store path; repo_key remains in the path suffix\",\n    \"branch_labels\": \"old local branch labels with person names redacted from retained current-repo evidence artifacts\"\n  }\n}\n"}}
