re/cli/doctor.go:52:  - Skip: Leave the session as-is\n../cli-bench/cmd/entire/cli/doctor.go:54:Use --force to condense all fixable sessions without prompting.  Sessions that can't\n../cli-bench/cmd/entire/cli/doctor.go:74:// stuckSession holds a session state along with diagnostic info.\n../cli-bench/cmd/entire/cli/doctor.go:97:\t// Agent-specific: Codex hook trust state.\n../cli-bench/cmd/entire/cli/doctor.go:100:\t// Stuck sessions\n../cli-bench/cmd/entire/cli/doctor.go:101:\t// Load all session states\n../cli-bench/cmd/entire/cli/doctor.go:102:\tstates, err := strategy.ListSessionStates(ctx)\n../cli-bench/cmd/entire/cli/doctor.go:104:\t\treturn fmt.Errorf(\"failed to list session states: %w\", err)\n../cli-bench/cmd/entire/cli/doctor.go:107:\tif len(states) == 0 {\n../cli-bench/cmd/entire/cli/doctor.go:108:\t\tfmt.Fprintln(cmd.OutOrStdout(), \"No stuck sessions found.\")\n../cli-bench/cmd/entire/cli/doctor.go:122:\t// Identify stuck sessions\n../cli-bench/cmd/entire/cli/doctor.go:126:\tfor _, state := range states {\n../cli-bench/cmd/entire/cli/doctor.go:127:\t\tss := classifySession(state, repo, now)\n../cli-bench/cmd/entire/cli/doctor.go:134:\t\tfmt.Fprintln(cmd.OutOrStdout(), \"No stuck sessions found.\")\n../cli-bench/cmd/entire/cli/doctor.go:144:\tfmt.Fprintf(cmd.OutOrStdout(), \"Found %d stuck session(s):\\n\\n\", len(stuck))\n../cli-bench/cmd/entire/cli/doctor.go:152:\t\t\t\t\tfmt.Fprintf(cmd.ErrOrStderr(), \"Warning: failed to condense session %s: %v\\n\", ss.State.SessionID, err)\n../cli-bench/cmd/entire/cli/doctor.go:154:\t\t\t\t\tfmt.Fprintf(cmd.OutOrStdout(), \"  ✓ Condensed session %s\\n\\n\", ss.State.SessionID)\n../cli-bench/cmd/entire/cli/doctor.go:159:\t\t\t\t\tfmt.Fprintf(cmd.ErrOrStderr(), \"Warning: failed to discard session %s: %v\\n\", ss.State.SessionID, err)\n../cli-bench/cmd/entire/cli/doctor.go:161:\t\t\t\t\tfmt.Fprintf(cmd.OutOrStdout(), \"  ✓ Discarded session %s\\n\\n\", ss.State.SessionID)\n../cli-bench/cmd/entire/cli/doctor.go:179: