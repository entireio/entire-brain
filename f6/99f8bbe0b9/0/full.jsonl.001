Precision          float64                `json:\"mean_precision\"`\ninternal/cli/facts_eval.go:79:\tMeanUsefulPer1k        float64                `json:\"mean_useful_per_1k\"`\ninternal/cli/facts_eval.go:150:// for recall; pass 0 when relevance came from a judge or source-match proxy\ninternal/cli/facts_eval.go:347:\t\tShort: \"Measure retrieval quality (tokens, precision, useful-items-per-1k) over held-out tasks\",\ninternal/cli/facts_eval.go:349:\tin aggregate: retrieved items, estimated tokens, precision, recall when labels\ninternal/cli/facts_eval.go:350:\texist for that retriever, and useful-items-per-1k-tokens (the headline agent\ninternal/cli/facts_eval.go:359:\t\t\tdecide relevance per surfaced item. With source-session tasks, pass\ninternal/cli/facts_eval.go:361:\t\t\tjudge-labeled relevance for history/preprocessed-session arms.`,\ninternal/cli/facts_eval.go:436:\t\t\tsummary := summarizeEvalWithConfig(results, &evalRunConfig{\ninternal/cli/facts_eval.go:449:\t\t\t\tLabelPolicy:           \"human and judge_refined labels define precision/recall; provenance_silver is reported but not proof-labeled\",\ninternal/cli/facts_eval.go:454:\t\t\t\treturn writeJSON(cmd, summary)\ninternal/cli/facts_eval.go:456:\t\t\tprintEvalSummary(cmd, summary)\ninternal/cli/facts_eval.go:463:\tcmd.Flags().BoolVar(&judge, \"judge\", false, \"Use the agent to judge relevance when a task has no labels\")\ninternal/cli/facts_eval.go:464:\tcmd.Flags().BoolVar(&judgeSource, \"judge-source-matches\", false, \"With --judge, judge source-match proxy rows instead of counting transcript/session overlap as relevance\")\ninternal/cli/facts_eval.go:473:\tcmd.Flags().BoolVar(&jsonOut, \"json\", false, \"Emit the summary as JSON\")\ninternal/cli/facts_eval.go:477:// judgeCache persists agent relevance verdicts keyed by a digest of the task,\ninternal/cli/facts_eval.go:1077:\t\trelevant, totalRelevant, labeled, relevanceSource := evalLabelsForRetriever(task, retriever, surfaced)\ninternal/cli/facts_eval.go:1078:\t\tshouldJudge := judge && len(surfaced) > 0 && !labeled && relevanceSource != evalRelevanceSourceMatch\ninternal/cli/facts_eval.go:1079:\t\tif judge && len(surfaced) > 0 && !labeled && runOpts.JudgeSourceMatches && relevanceSource == evalRelevanceSourceMatch {\ninternal/cli/facts_eval.go:1088:\t\t\trelevanceSource = evalRelevanceJudge\ninternal/cli/facts_eval.go:1094:\t\tres.RelevanceSource = relevanceSource\ninternal/cli/facts_eval.go:1180:\t\tfmt.Fprintf(out, \"%-14s %-24s %-13s %8s %8s %8s %8s %7s %7s %9s\\n\", \"task\", \"relevance\", \"label\", \"tokens\", \"lat(ms)\", \"exp(ms)\", \"e2e(ms)\", \"prec\", \"recall\", \"useful/1k\")\ninternal/cli/facts_eval.go:1182:\t\tfmt.Fprintf(out, \"%-14s %-24s %-13s %8s %8s %7s %7s %9s\\n\", \"task\", \"relevance\", \"label\", \"tokens\", \"lat(ms)\", \"prec\", \"recall\", \"useful/1k\")\ninternal/cli/facts_eval.go:1191:\t\trelevance := truncateString(valueOrUnset(r.RelevanceSource), 24)\ninternal/cli/facts_eval.go:1194:\t\t\tfmt.Fprintf(out, \"%-14s %-24s %-13s %8d %8d %8d %8d %7.2f %7s %9.2f\\n\", truncateString(r.ID, 14), relevance, label, r.Tokens, r.LatencyMS, r.ExpansionLatencyMS, evalEndToEndLatencyMS(r), r.Precision, recall, r.UsefulPer1k)\ninternal/cli/facts_eval.go:1196:\t\t\tfmt.Fprintf(out, \"%-14s %-24s %-13s %8d %8d %7.2f %7s %9.2f\\n\", truncateString(r.ID, 14), relevance, label, r.Tokens, r.LatencyMS, r.Precision, recall, r.UsefulPer1k)\ninternal/cli/facts_eval.go:1208:\t\tfmt.Fprintf(out, \"\\n%-14s %8s %7s %7s %9s\\n\", \"stratum\", \"tokens\", \"prec\", \"tasks\", \"useful/1k\")\ninternal/cli/facts_eval.go:1244:\treturn \"note: non-proof relevance rows present (\" + strings.Join(sources, \", \") + \"); source-match, silver, judge, mixed, or none rows are not human/judge_refined recall proof.\"\nbenchmarks/agent-brain/evidence/facts-eval/facts-eval-audit-report.json:11:  \"summary_paths\": {},\nbenchmarks/agent-brain/evidence/facts-eval/README.md:11:precision, or useful-per-token claim.\