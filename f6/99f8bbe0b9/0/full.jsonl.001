{"timestamp":"2026-06-10T15:44:51.340Z","type":"response_item","payload":{"type":"function_call","name":"exec_command","arguments":"{\"cmd\":\"python3 - <<'PY'\\nimport json, pathlib, math\\nroot=pathlib.Path('benchmarks/agent-brain/results')\\ninteresting=[]\\nfor p in root.glob('*/summary.json'):\\n    try: s=json.loads(p.read_text())\\n    except Exception: continue\\n    for c in s.get('comparisons') or []:\\n        suite=p.parent.name\\n        text=(suite+' '+json.dumps(c)).lower()\\n        if not any(x in text for x in ['radar','mcp_workspace','mcp-history','mcp_history','mcp']):\\n            continue\\n        prb=c.get('pass_rate_baseline', c.get('success_rate_baseline'))\\n        prc=c.get('pass_rate_condition', c.get('success_rate_condition'))\\n        mb=c.get('mean_baseline'); mc=c.get('mean_condition')\\n        n_b=c.get('n_baseline'); n_c=c.get('n_condition')\\n        cond=c.get('condition')\\n        task=c.get('task_id')\\n        runner=c.get('runner')\\n        proof=c.get('proof_ready')\\n        tag=(c.get('stability') or {}).get('tag')\\n        verdict=c.get('verdict')\\n        if prb is None and mb is not None:\\n            prb=c.get('success_rate_baseline')\\n        if prc is None and mc is not None:\\n            prc=c.get('success_rate_condition')\\n        lift=(prc-prb) if isinstance(prb,(int,float)) and isinstance(prc,(int,float)) else None\\n        score_lift=(mc-mb) if isinstance(mb,(int,float)) and isinstance(mc,(int,float)) else None\\n        # Keep likely useful: proof, positive lift, low baseline, or current Radar suites\\n        if proof or (lift is not None and lift>0) or (score_lift is not None and score_lift>5) or suite.startswith(('pilot-radar','release-candidate-entire-cli-radar','release-candidate-entire-cli-workspace')):\\n            interesting.append({\\n                'suite':suite,'task':task,'runner':runner,'condition':cond,\\n                'n':(n_b,n_c),'pass':(prb,prc),'mean':(mb,mc),'lift':lift,'score_lift':score_lift,\\n                'proof':proof,'tag':tag,'verdict':verdict,'reasons':c.get('verdict_reasons')\\n            })\\n# Sort: radar/workspace first, lift desc, baseline low\\ninteresting.sort(key=lambda r: (\\n    0 if 'radar' in r['suite'].lower() or 'radar' in str(r['condition']).lower() else 1,\\n    -(r['lift'] if isinstance(r['lift'],(int,float)) else -999),\\n    (r['pass'][0] if isinstance(r['pass'][0],(int,float)) else 999),\\n    r['suite']))\\nfor r in interesting[:120]:\\n    print(f\\\"{r['suite']} | task={r['task']} | runner={r['runner']} | cond={r['condition']} | n={r['n']} | pass={r['pass']} | mean={r['mean']} | lift={r['lift']} score_lift={r['score_lift']} | proof={r['proof']} tag={r['tag']} verdict={r['verdict']}\\\")\\n    if r['reasons']:\\n        print('  reasons:', '; '.join(map(str,r['reasons'][:3])))\\nPY\",\"workdir\":\"/Users/suhaan/Documents/Coding/entire-brain\",\"yield_time_ms\":1000,\"max_output_tokens\":30000}","call_id":"call_lqoc20riSEL3AeUFqjfoxPHk"}}
