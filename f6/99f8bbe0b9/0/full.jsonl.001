ises the `inspect regressions` CLI command end to end (runRegressionDetect via cobra),\ninternal/cli/regression_test.go:240:func TestRegressionDetectorWarnings(t *testing.T) {\ninternal/cli/regression_test.go:243:\tbrainDir, repoRoot := writeRegressionFixture(t, `{\"text\":\"x\"}`, \"a.go\", \"package a\\n\")\ninternal/cli/regression_test.go:244:\tan, _, w := detectRegressionAnomalies(brainDir, repoRoot, nil, \"the and for with\", 20, false)\ninternal/cli/regression_test.go:249:\tbrainDir, repoRoot = writeRegressionFixture(t, `{\"text\":\"we touched scopeBaseRef somewhere in prose\"}`, \"a.go\", \"package a\\n\")\ninternal/cli/regression_test.go:250:\tif _, _, w := detectRegressionAnomalies(brainDir, repoRoot, nil, \"fix scopeBaseRef\", 20, false); len(w) == 0 || !strings.Contains(w[len(w)-1], \"no precise code assertions\") {\ninternal/cli/regression_test.go:254:\tbrainDir, repoRoot = writeRegressionFixture(t, `{\"text\":\"in pkg/gone.go the range is scopeBaseRef+\\\"..HEAD\\\"\"}`, \"other.go\", \"package x\\n\")\ninternal/cli/regression_test.go:255:\tif _, _, w := detectRegressionAnomalies(brainDir, repoRoot, nil, \"fix scopeBaseRef base scope\", 20, false); len(w) == 0 || !strings.Contains(w[len(w)-1], \"no current files\") {\ninternal/cli/regression_test.go:260:func TestRegressionDeletionIsOptIn(t *testing.T) {\ninternal/cli/regression_test.go:264:\tbrainDir, repoRoot := writeRegressionFixture(t, session, \"pkg/resolve_transcript.go\", body)\ninternal/cli/regression_test.go:267:\tif an, _, _ := detectRegressionAnomalies(brainDir, repoRoot, nil, q, 20, false); len(an) != 0 {\ninternal/cli/regression_test.go:270:\tan, _, _ := detectRegressionAnomalies(brainDir, repoRoot, nil, q, 20, true)\ninternal/cli/regression_test.go:287:func TestRegressionDeletionRanksCallLocusWithHistoryFileHint(t *testing.T) {\ninternal/cli/regression_test.go:294:\tbrainDir, repoRoot := writeRegressionFixture(t, session, \"cmd/entire/cli/strategy/manual_commit_hooks.go\", hooks)\ninternal/cli/regression_test.go:303:\tan, _, _ := detectRegressionAnomalies(brainDir, repoRoot, nil, \"RealignAttributionBase newHead HumanAdded\", 20, true)\ninternal/cli/regression_test.go:318:func TestRegressionDeletionReportsEachMissingAnchoredCallSite(t *testing.T) {\ninternal/cli/regression_test.go:321:\tbrainDir, repoRoot := writeRegressionFixture(t, session, \"cmd/entire/cli/strategy/manual_commit_hooks.go\", body)\ninternal/cli/regression_test.go:323:\tan, _, _ := detectRegressionAnomalies(brainDir, repoRoot, nil, \"RealignAttributionBase newHead manual commit hooks\", 20, true)\ninternal/cli/regression_test.go:341:func TestRegressionDedupeRankPrefersBoostedCallDeletion(t *testing.T) {\ninternal/cli/seed_test.go:318:\t// Regression: a non-\"success\" but non-failure status (codex models emit \"ok\")\ninternal/cli/regression.go:19:// Regression Radar: turn the brain from a passive librarian into an active reviewer.\ninternal/cli/regression.go:71:\tincludeDeletions bool // deletions are higher-recall but noisier (no recency data); opt-in\ninternal/cli/regression.go:72:\tlocationOnly     bool // emit file:line only, NOT expected/current — so a fair A/B can't paste the answer\ninternal/cli/regression.go:144:func mergeRegressionHints(a, b []string) []string {\ninternal/cli/regression.go:345:\t\t\t\t\t\tdeletes[idx].hints = mergeRegressionHints(deletes[idx].hints, hints)\ninternal/cli/regression.go:346:\t\t\t\t\t\tdeletes[idx].anchors = mergeRegressionHints(deletes[idx].anchors, s.anchors)\ninternal/cli/regression.go:364:func detectRegressionAnomalies(brainDir, repoRoot string, semSource *semanticSourceManifest, query string, limit int, includeDeletions bool) ([]regressionAnomaly, int, []string) {\ninternal/cli/regression.go:516:\t\tif !includeDeletions {\ninternal/cli/regression.go:523:\t\t\thomes := regressionMissingCallHomes(files, d)\ninternal/cli/regression.go:569:\tanomalies = annotateRegressionLocationContext(regressionDedupeRank(anomalies), files)\ninternal/cli/re