ce/distill-perf\ncp \"$tmp\"/distill-perf-audit-report.json \"$tmp\"/distill-perf-audit-report.md benchmarks/agent-brain/evidence/distill-perf/\n'''\n\n[tasks.\"semantic:evidence\"]\ndescription = \"Check the local semantic audit release gate against the current indexed brain\"\nrun = '''\nset -e\ntmp=\"$(mktemp)\"\ntrap 'rm -f \"$tmp\"' EXIT\nset +e\ngo run ./cmd/entire-brain semantic-audit --json --fail-on release > \"$tmp\"\nrc=$?\nset -e\npython3 - \"$tmp\" <<'PY'\nimport json\nimport sys\n\ntry:\n    with open(sys.argv[1]) as f:\n        data = json.load(f)\nexcept Exception as exc:\n    print(f\"semantic audit: unable to parse report: {exc}\", file=sys.stderr)\n    raise SystemExit(0)\nprint(\n    \"semantic audit:\",\n    f\"freshness={data['freshness']['severity']}\",\n    f\"files={data['files']}\",\n    f\"symbols={data['symbols']}\",\n    f\"relations={data['relations']}\",\n    f\"blind_spots={len(data.get('blind_spots', []))}\",\n)\nfor name, axis in sorted((data.get(\"freshness\", {}).get(\"axes\") or {}).items()):\n    if axis.get(\"state\") != \"ok\":\n        print(f\"semantic audit axis {name}: {axis.get('state')} {axis.get('detail', '')}\".rstrip())\nPY\nexit \"$rc\"\n'''\n\n[tasks.\"release:readiness\"]\ndescription = \"Run the full local release-readiness gate, including retained evidence checks\"\nrun = '''\nset +e\nfailures=0\nfailed=\"\"\nfor task in check release:evidence radar:evidence distill:evidence facts:evidence semantic:evidence; do\n  echo \"==> mise run $task\"\n  mise run \"$task\"\n  rc=$?\n  if [ \"$rc\" -eq 0 ]; then\n    echo \"PASS $task\"\n  else\n    echo \"FAIL $task (exit $rc)\" >&2\n    failures=$((failures + 1))\n    failed=\"${failed}${failed:+, }$task\"\n  fi\ndone\nif [ \"$failures\" -ne 0 ]; then\n  echo \"release readiness failed: $failed\" >&2\n  exit 1\nfi\necho \"release readiness passed\"\n'''\n\n[tasks.build]\ndescription = \"Build the plugin binary\"\nrun = \"go build -o entire-brain ./cmd/entire-brain\"\n\n[tasks.build-all]\ndescription = \"Cross-build common Entire CLI plugin targets\"\nrun = '''\nset -e\nfor target in darwin/amd64 darwin/arm64 linux/amd64 linux/arm64 windows/amd64; do\n  GOOS=\"${target%/*}\" GOARCH=\"${target#*/}\" go build ./...\ndone\n'''\n\n[tasks.check]\ndescription = \"Run formatting, linting, tests, and builds\"\ndepends = [\"lint\", \"test:ci\", \"test:phase1\", \"build-all\"]\n"}}
