tion_only\"]\nbenchmarks/agent-brain/run_test.py:2118:            self.assertEqual(passing[\"gate_status\"][\"requirements\"][\"required_named_tool_proof_scopes\"], [\"mcp_radar_location_only\"])\nbenchmarks/agent-brain/run_test.py:2120:    def test_audit_codex_radar_backing_requires_named_tool_records(self):\nbenchmarks/agent-brain/run_test.py:2125:            \"delivery_scope\": \"mcp_radar_location_only\",\nbenchmarks/agent-brain/run_test.py:2150:                \"delivery_scope\": \"mcp_radar_location_only\",\nbenchmarks/agent-brain/run_test.py:2151:                \"run_id\": f\"radar-{i}\",\nbenchmarks/agent-brain/run_test.py:2167:    def test_audit_codex_radar_backing_requires_completed_named_tool_records(self):\nbenchmarks/agent-brain/run_test.py:2172:            \"delivery_scope\": \"mcp_radar_location_only\",\nbenchmarks/agent-brain/run_test.py:2197:                \"delivery_scope\": \"mcp_radar_location_only\",\nbenchmarks/agent-brain/run_test.py:2198:                \"run_id\": f\"radar-{i}\",\nbenchmarks/agent-brain/run_test.py:2216:            suite = \"release-candidate-radar-unverified-mcp\"\nbenchmarks/agent-brain/run_test.py:2220:                mcp = self._mcp_release_record(suite, repetition=i, run_id=f\"radar-{i}\")\nbenchmarks/agent-brain/run_test.py:2226:                self._write_mcp_server_log(suite_dir, f\"radar-{i}\", \"brain_regressions\", tool_args={\"location_only\": True})\nbenchmarks/agent-brain/run_test.py:2232:                    \"delivery_scope\": \"mcp_radar_location_only\",\nbenchmarks/agent-brain/run_test.py:2253:            suite = \"release-candidate-radar-no-response\"\nbenchmarks/agent-brain/run_test.py:2254:            record = self._mcp_release_record(suite, repetition=1, run_id=\"radar-1\")\n"}}
