{"timestamp":"2026-06-10T16:22:26.447Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_2MLC2YktCpfIm7eyG9gbVj7N","output":"Chunk ID: c03fff\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 335\nOutput:\nfi\ntmp=\"$(mktemp -d)\"\ntrap 'rm -rf \"$tmp\"' EXIT\npython3 benchmarks/agent-brain/audit_distill_perf.py \\\n  --manifest \"$manifest\" \\\n  --out-dir \"$tmp\" \\\n  --fail-on-flags\nmkdir -p benchmarks/agent-brain/evidence/distill-perf\ncp \"$tmp\"/distill-perf-audit-report.json \"$tmp\"/distill-perf-audit-report.md benchmarks/agent-brain/evidence/distill-perf/\n'''\n\n[tasks.\"semantic:evidence\"]\ndescription = \"Check the local semantic audit release gate against the current indexed brain\"\nrun = '''\nset -e\ntmp=\"$(mktemp)\"\ntrap 'rm -f \"$tmp\"' EXIT\nset +e\ngo run ./cmd/entire-brain semantic-audit --json --fail-on release > \"$tmp\"\nrc=$?\nset -e\npython3 - \"$tmp\" <<'PY'\nimport json\nimport sys\n\ntry:\n    with open(sys.argv[1]) as f:\n        data = json.load(f)\nexcept Exception as exc:\n    print(f\"semantic audit: unable to parse report: {exc}\", file=sys.stderr)\n    raise SystemExit(0)\nprint(\n    \"semantic audit:\",\n    f\"freshness={data['freshness']['severity']}\",\n    f\"files={data['files']}\",\n    f\"symbols={data['symbols']}\",\n    f\"relations={data['relations']}\",\n    f\"blind_spots={len(data.get('blind_spots', []))}\",\n)\nfor name, axis in sorted((data.get(\"freshness\", {}).get(\"axes\") or {}).items()):\n    if axis.get(\"state\") != \"ok\":\n        print(f\"semantic audit axis {name}: {axis.get('state')} {axis.get('detail', '')}\".rstrip())\nPY\nexit \"$rc\"\n'''\n\n"}}
