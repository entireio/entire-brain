{"timestamp":"2026-06-10T16:06:45.111Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_b7j2wwpNxIjTNdIRiDCGYqGc","output":"Chunk ID: ba45e8\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 1622\nOutput:\n    34\t\n    35\tBENCH = pathlib.Path(__file__).resolve().parent\n    36\tRESULTS = BENCH / \"results\"\n    37\tTASK_DIR = BENCH / \"tasks\"\n    38\tDEFAULT_PROOF_MIN_REPETITIONS = 4\n    39\t\n    40\tMCP_CONDITIONS = {\"mcp_semantic\", \"mcp_history\", \"mcp_workspace_radar\"}\n    41\tSEMANTIC_CONDITIONS = {\"semantic_brain\", \"semantic_cli\", \"mcp_semantic\"}\n    42\tHISTORY_CONDITIONS = {\"full_brain\", \"full_cli_original\", \"full_cli_compact\", \"mcp_history\", \"mcp_workspace_radar\"}\n    43\tBRAIN_CONDITIONS = SEMANTIC_CONDITIONS | HISTORY_CONDITIONS\n    44\tMCP_NAMED_TOOL_REQUIRED_SCOPES = {\n    45\t    \"mcp_radar_location_only\",\n    46\t    \"mcp_radar_answer_assisted\",\n    47\t    \"mcp_workspace_radar_location_only\",\n    48\t}\n    49\tMCP_BRAIN_TOOL_RE = r\"brain_(?:stale|brief|query|search|vsearch|get|multi_get|context|impact|changes|code|tests|boundaries|regressions|review|workspace_regressions|workspace_review)\"\n    50\tCOMMIT_RE = re.compile(r\"^[0-9a-f]{40}$\")\n    51\tSHA256_RE = re.compile(r\"^[0-9a-f]{64}$\")\n    52\tHOST_PATH_RE = re.compile(\n    53\t    r\"(?i)(?:\"\n    54\t    r\"/Users/[^\\s\\\"'`]+\"            # macOS home paths\n    55\t    r\"|/home/[^\\s\\\"'`]+\"            # Linux home paths\n    56\t    r\"|/private/(?:var|tmp)/[^\\s\\\"'`]+\"  # macOS temp paths\n    57\t    r\"|/tmp/[^\\s\\\"'`]+\"             # POSIX temp paths\n    58\t    r\"|[A-Z]:\\\\Users\\\\[^\\s\\\"'`]+\"   # Windows home paths\n    59\t    r\")\"\n    60\t)\n    61\t\n    62\t\n    63\tdef load_records(suite_dir: pathlib.Path) -> list[dict[str, Any]]:\n    64\t    nd = suite_dir / \"records.ndjson\"\n    65\t    if not nd.exists():\n    66\t        return []\n    67\t    recs = []\n    68\t    for line in nd.read_text().splitlines():\n    69\t        line = line.strip()\n    70\t        if not line:\n    71\t            continue\n    72\t        try:\n    73\t            recs.append(json.loads(line))\n    74\t        except json.JSONDecodeError:\n    75\t            pass\n    76\t    return recs\n    77\t\n    78\t\n    79\tdef server_log_toolcalls(run_dir: pathlib.Path) -> int | None:\n    80\t    log = run_dir / \"mcp-server.log\"\n    81\t    if not log.exists():\n    82\t        return None\n    83\t    text = log.read_text(errors=\"ignore\")\n    84\t    return len(re.findall(r\"^message: tools/call$\", text, flags=re.MULTILINE))\n    85\t\n    86\t\n    87\tdef server_log_toolcall_responses(run_dir: pathlib.Path) -> int | None:\n    88\t    log = run_dir / \"mcp-server.log\"\n    89\t    if not log.exists():\n    90\t        return None\n    91\t    text = log.read_text(errors=\"ignore\")\n    92\t    return len(re.findall(r\"^response: tools/call$\", text, flags=re.MULTILINE))\n    93\t\n    94\t\n    95\tdef server_log_tool_names(run_dir: pathlib.Path) -> list[str] | None:\n    96\t    log = run_dir / \"mcp-server.log\"\n    97\t    if not log.exists():\n    98\t        return None\n    99\t    text = log.read_text(errors=\"ignore\")\n   100\t    return re.findall(rf\"^tool: ({MCP_BRAIN_TOOL_RE})$\", text, flags=re.MULTILINE)\n   101\t\n   102\t\n   103\tdef server_log_tool_results(run_dir: pathlib.Path) -> list[dict[str, str]] | None:\n   104\t    log = run_dir / \"mcp-server.log\"\n   105\t    if not log.exists():\n   106\t        return None\n   107\t    text = log.read_text(errors=\"ignore\")\n   108\t    return [\n   109\t        {\"tool\": tool, \"status\": status}\n   110\t        for tool, status in re.findall(rf\"^tool_result: ({MCP_BRAIN_TOOL_RE}) (ok|error)$\", text, flags=re.MULTILINE)\n   111\t    ]\n   112\t\n   113\t\n   114\tdef server_log_tool_args(run_dir: pathlib.Path) -> list[dict[str, Any]] | None:\n   115\t    log = run_dir / \"mcp-server.log\"\n   116\t    if not log.exists():\n   117\t        return None\n   118\t    out: list[dict[str, Any]] = []\n   119\t    current_tool: str | None = None\n   120\t    for line in log.read_text(errors=\"ignore\").splitlines():\n   121\t        tool_match = re.fullmatch(rf\"tool: ({MCP_BRAIN_TOOL_RE})\", line)\n   122\t        if tool_match:\n   123\t            current_tool = tool_match.group(1)\n   124\t            continue\n   125\t        args_match = re.fullmatch(r\"tool_args: (\\{.*\\})\", line)\n   126\t        if not args_match or current_tool is None:\n   127\t            continue\n   128\t        try:\n   129\t            raw_args = json.loads(args_match.group(1))\n   130\t        except json.JSONDecodeError:\n   131\t            raw_args = {}\n   132\t        if not isinstance(raw_args, dict):\n   133\t            raw_args = {}\n   134\t        safe_args = {\n   135\t            str(key): value\n   136\t            for key, value in raw_args.items()\n   137\t            if key in {\"blind_spots\", \"include_deletions\", \"location_only\"} and isinstance(value, bool)\n   138\t        }\n   139\t        out.append({\"tool\": current_tool, \"arguments\": safe_args})\n   140\t    return out\n   141\t\n   142\t\n   143\tdef server_log_tool_call_records(run_dir: pathlib.Path) -> list[dict[str, Any]] | None:\n   144\t    log = run_dir / \"mcp-server.log\"\n   145\t    if not log.exists():\n   146\t        return None\n   147\t    out: list[dict[str, Any]] = []\n   148\t    current: dict[str, Any] | None = None\n   149\t\n   150\t    def flush_current() -> None:\n   151\t        nonlocal current\n   152\t        if current is not None:\n   153\t            out.append(current)\n   154\t            current = None\n   155\t\n   156\t    for line in log.read_text(errors=\"ignore\").splitlines():\n   157\t        tool_match = re.fullmatch(rf\"tool: ({MCP_BRAIN_TOOL_RE})\", line)\n   158\t        if tool_match:\n   159\t            flush_current()\n   160\t            current = {\"tool\": tool_match.group(1), \"arguments\": {}, \"status\": \"\"}\n   161\t            continue\n   162\t        args_match = re.fullmatch(r\"tool_args: (\\{.*\\})\", line)\n   163\t        if args_match and current is not None:\n   164\t            try:\n   165\t                raw_args = json.loads(args_match.group(1))\n   166\t            except json.JSONDecodeError:\n   167\t                raw_args = {}\n   168\t            if not isinstance(raw_args, dict):\n   169\t                raw_args = {}\n   170\t            current[\"arguments\"] = {\n   171\t                str(key): value\n   172\t                for key, value in raw_args.items()\n   173\t                if key in {\"blind_spots\", \"include_deletions\", \"location_only\"} and isinstance(value, bool)\n   174\t            }\n   175\t            continue\n   176\t        result_match = re.fullmatch(rf\"tool_result: ({MCP_BRAIN_TOOL_RE}) (ok|error)\", line)\n   177\t        if result_match:\n   178\t            tool, status = result_match.groups()\n   179\t            if current is None or current.get(\"tool\") != tool:\n   180\t                flush_current()\n"}}
