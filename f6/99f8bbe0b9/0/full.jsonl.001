{"timestamp":"2026-06-10T15:10:59.572Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_0CaEaZHDsFjYbCfQHBhfHloe","output":"Chunk ID: 98c5f8\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 194\nOutput:\n    if axis.get(\"state\") != \"ok\":\n        print(f\"semantic audit axis {name}: {axis.get('state')} {axis.get('detail', '')}\".rstrip())\nPY\nexit \"$rc\"\n'''\n\n[tasks.\"release:readiness\"]\ndescription = \"Run the full local release-readiness gate, including retained evidence checks\"\nrun = '''\nset +e\nfailures=0\nfailed=\"\"\nfor task in check release:evidence radar:evidence distill:evidence facts:evidence semantic:evidence; do\n  echo \"==> mise run $task\"\n  mise run \"$task\"\n  rc=$?\n  if [ \"$rc\" -eq 0 ]; then\n    echo \"PASS $task\"\n  else\n    echo \"FAIL $task (exit $rc)\" >&2\n    failures=$((failures + 1))\n    failed=\"${failed}${failed:+, }$task\"\n  fi\ndone\nif [ \"$failures\" -ne 0 ]; then\n  echo \"release readiness failed: $failed\" >&2\n  exit 1\nfi\necho \"release readiness passed\"\n'''\n\n"}}
