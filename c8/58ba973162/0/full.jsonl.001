.Binding\n\tQuit    key.Binding\n}\n\nfunc defaultKeys() keyMap {\n\treturn keyMap{\n\t\tUp:      key.NewBinding(key.WithKeys(\"up\", \"k\"), key.WithHelp(\"↑/k\", \"up\")),\n\t\tDown:    key.NewBinding(key.WithKeys(\"down\", \"j\"), key.WithHelp(\"↓/j\", \"down\")),\n\t\tEnter:   key.NewBinding(key.WithKeys(\"enter\", \"right\", \"l\"), key.WithHelp(\"enter/→\", \"open\")),\n\t\tBack:    key.NewBinding(key.WithKeys(\"esc\", \"left\", \"h\"), key.WithHelp(\"esc/←\", \"back\")),\n\t\tSection: key.NewBinding(key.WithKeys(\"tab\"), key.WithHelp(\"tab\", \"next section\")),\n\t\tPrevTab: key.NewBinding(key.WithKeys(\"shift+tab\"), key.WithHelp(\"shift+tab\", \"prev section\")),\n\t\tFilter:  key.NewBinding(key.WithKeys(\"/\"), key.WithHelp(\"/\", \"filter\")),\n\t\tSearch:  key.NewBinding(key.WithKeys(\"s\"), key.WithHelp(\"s\", \"search brain\")),\n\t\tOpen:    key.NewBinding(key.WithKeys(\"o\"), key.WithHelp(\"o\", \"open source\")),\n\t\tHelp:    key.NewBinding(key.WithKeys(\"?\"), key.WithHelp(\"?\", \"help\")),\n\t\tQuit:    key.NewBinding(key.WithKeys(\"q\", \"ctrl+c\"), key.WithHelp(\"q\", \"quit\")),\n\t}\n}\n\n// ShortHelp is the single-line help shown in the footer.\nfunc (k keyMap) ShortHelp() []key.Binding {\n\treturn []key.Binding{k.Up, k.Down, k.Enter, k.Section, k.Filter, k.Open, k.Help, k.Quit}\n}\n\n// FullHelp is the expanded help shown when ? is toggled.\nfunc (k keyMap) FullHelp() [][]key.Binding {\n\treturn [][]key.Binding{\n\t\t{k.Up, k.Down, k.Enter, k.Back},\n\t\t{k.Section, k.PrevTab, k.Filter, k.Open},\n\t\t{k.Help, k.Quit},\n\t}\n}\n","structuredPatch":[{"oldStart":36,"oldLines":14,"newStart":36,"newLines":14,"lines":[" "," // ShortHelp is the single-line help shown in the footer."," func (k keyMap) ShortHelp() []key.Binding {","-  return []key.Binding{k.Up, k.Down, k.Enter, k.Section, k.Filter, k.Open, k.Help, k.Quit}","+  return []key.Binding{k.Up, k.Down, k.Enter, k.Section, k.Filter, k.Search, k.Open, k.Help, k.Quit}"," }"," "," // FullHelp is the expanded help shown when ? is toggled."," func (k keyMap) FullHelp() [][]key.Binding {","   return [][]key.Binding{","     {k.Up, k.Down, k.Enter, k.Back},","-    {k.Section, k.PrevTab, k.Filter, k.Open},","-    {k.Help, k.Quit},","+    {k.Section, k.PrevTab, k.Filter, k.Search},","+    {k.Open, k.Help, k.Quit},","   }"," }"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"579fcc09-a39d-4e4b-81e4-dd3fd48a8efa","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/Documents/Coding/entire-brain/internal/cli","sessionId":"af861ed9-9e1d-41a7-8400-b53c2995aed8","version":"2.1.177","gitBranch":"claude/brain-dash-tui","slug":"zippy-floating-lovelace"}
