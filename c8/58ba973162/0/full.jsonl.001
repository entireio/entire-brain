{"parentUuid":"83ff2581-630d-466a-96ea-6c0780d0f9d7","isSidechain":false,"promptId":"a0fe0e1e-23b8-44fc-8722-a9e008460227","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PeAkA6By1yZmsDGqyWy9f7","type":"tool_result","content":"20\t\tDefaultBranch = \"main\"\n21\t\n22\t\t// repoStoreDirName is the per-repo subtree under ENTIRE_PLUGIN_DATA_DIR.\n23\t\trepoStoreDirName = \"repos\"\n24\t)\n25\t\n26\t// Exists reports whether a directory holds an exported brain (a readable\n27\t// manifest.json that is not a directory).\n28\tfunc Exists(brainDir string) bool {\n29\t\tinfo, err := os.Stat(filepath.Join(brainDir, manifestFileName))\n30\t\treturn err == nil && !info.IsDir()\n31\t}\n32\t\n33\t// LoadManifest reads and parses the brain manifest. A missing manifest yields an\n34\t// empty manifest (so first-run callers do not special-case it); a malformed\n35\t// manifest is a hard error.\n36\tfunc LoadManifest(brainDir string) (*Manifest, error) {\n37\t\tpath := filepath.Join(brainDir, manifestFileName)\n38\t\tdata, err := os.ReadFile(path)\n39\t\tif err != nil {\n40\t\t\tif os.IsNotExist(err) {\n41\t\t\t\treturn &Manifest{SchemaVersion: SchemaVersion}, nil\n42\t\t\t}\n43\t\t\treturn nil, fmt.Errorf(\"read brain manifest: %w\", err)\n44\t\t}\n45\t\tvar manifest Manifest\n46\t\tif err := json.Unmarshal(data, &manifest); err != nil {\n47\t\t\treturn nil, fmt.Errorf(\"parse brain manifest: %w\", err)\n48\t\t}\n49\t\treturn &manifest, nil\n50\t}\n51\t\n52\t// Branch resolves the brain's default branch, falling back to DefaultBranch.\n53\tfunc (m *Manifest) Branch() string {\n54\t\tif m != nil && m.DefaultBranch != \"\" {\n55\t\t\treturn m.DefaultBranch\n56\t\t}\n57\t\tif m != nil && m.Sources != nil && m.Sources.Sessions != nil && m.Sources.Sessions.DefaultBranch != \"\" {\n58\t\t\treturn m.Sources.Sessions.DefaultBranch\n59\t\t}\n60\t\treturn DefaultBranch\n61\t}\n62\t\n63\t// LoadFacts reads a branch's durable facts. Durable facts are an optional signal:\n64\t// a brain may have none, and a missing facts directory or file yields an empty\n65\t// slice rather than an error. Candidate layouts are probed in order so both the\n66\t// simple <facts>/<branch>/facts.ndjson layout and a slugged sibling layout\n67\t// resolve.\n68\tfunc LoadFacts(brainDir, branch string) ([]FactRecord, error) {\n69\t\tfor _, candidate := range factsCandidatePaths(brainDir, branch) {\n70\t\t\trecords, err := parseFactsFile(candidate)\n71\t\t\tif err != nil {\n72\t\t\t\treturn nil, err\n73\t\t\t}\n74\t\t\tif len(records) > 0 {\n75\t\t\t\treturn records, nil\n76\t\t\t}\n77\t\t}\n78\t\treturn nil, nil\n79\t}\n80\t\n81\t// factsCandidatePaths lists the on-disk locations a branch's facts file may live\n82\t// at. The simple <facts>/<branch>/facts.ndjson layout is tried first; a slugged\n83\t// branch directory (facts/<branch-slug>-<hash>/facts.ndjson) is matched by glob\n84\t// as a fallback so a brain built by the slugging layout still resolves.\n85\tfunc factsCandidatePaths(brainDir, branch string) []string {\n86\t\tvar paths []string\n87\t\tfactsRoot := filepath.Join(brainDir, factsDirName)\n88\t\tpaths = append(paths, filepath.Join(factsRoot, filepath.FromSlash(branch), factsFileName))\n89\t\t// Slugged sibling layout: facts/<branch-slug>-<hash>/facts.ndjson.\n90\t\tif matches, err := filepath.Glob(filepath.Join(factsRoot, \"*\", factsFileName)); err == nil {\n91\t\t\tpaths = append(paths, matches...)\n92\t\t}\n93\t\treturn paths\n94\t}"}]},"uuid":"a5d7950a-2313-4e5c-84a3-cbae539d86af","timestamp":"2026-06-17T14:08:30.285Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/suhaan/Documents/Coding/entire-judge/internal/brainstore/store.go","content":"\tDefaultBranch = \"main\"\n\n\t// repoStoreDirName is the per-repo subtree under ENTIRE_PLUGIN_DATA_DIR.\n\trepoStoreDirName = \"repos\"\n)\n\n// Exists reports whether a directory holds an exported brain (a readable\n// manifest.json that is not a directory).\nfunc Exists(brainDir string) bool {\n\tinfo, err := os.Stat(filepath.Join(brainDir, manifestFileName))\n\treturn err == nil && !info.IsDir()\n}\n\n// LoadManifest reads and parses the brain manifest. A missing manifest yields an\n// empty manifest (so first-run callers do not special-case it); a malformed\n// manifest is a hard error.\nfunc LoadManifest(brainDir string) (*Manifest, error) {\n\tpath := filepath.Join(brainDir, manifestFileName)\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn &Manifest{SchemaVersion: SchemaVersion}, nil\n\t\t}\n\t\treturn nil, fmt.Errorf(\"read brain manifest: %w\", err)\n\t}\n\tvar manifest Manifest\n\tif err := json.Unmarshal(data, &manifest); err != nil {\n\t\treturn nil, fmt.Errorf(\"parse brain manifest: %w\", err)\n\t}\n\treturn &manifest, nil\n}\n\n// Branch resolves the brain's default branch, falling back to DefaultBranch.\nfunc (m *Manifest) Branch() string {\n\tif m != nil && m.DefaultBranch != \"\" {\n\t\treturn m.DefaultBranch\n\t}\n\tif m != nil && m.Sources != nil && m.Sources.Sessions != nil && m.Sources.Sessions.DefaultBranch != \"\" {\n\t\treturn m.Sources.Sessions.DefaultBranch\n\t}\n\treturn DefaultBranch\n}\n\n// LoadFacts reads a branch's durable facts. Durable facts are an optional signal:\n// a brain may have none, and a missing facts directory or file yields an empty\n// slice rather than an error. Candidate layouts are probed in order so both the\n// simple <facts>/<branch>/facts.ndjson layout and a slugged sibling layout\n// resolve.\nfunc LoadFacts(brainDir, branch string) ([]FactRecord, error) {\n\tfor _, candidate := range factsCandidatePaths(brainDir, branch) {\n\t\trecords, err := parseFactsFile(candidate)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif len(records) > 0 {\n\t\t\treturn records, nil\n\t\t}\n\t}\n\treturn nil, nil\n}\n\n// factsCandidatePaths lists the on-disk locations a branch's facts file may live\n// at. The simple <facts>/<branch>/facts.ndjson layout is tried first; a slugged\n// branch directory (facts/<branch-slug>-<hash>/facts.ndjson) is matched by glob\n// as a fallback so a brain built by the slugging layout still resolves.\nfunc factsCandidatePaths(brainDir, branch string) []string {\n\tvar paths []string\n\tfactsRoot := filepath.Join(brainDir, factsDirName)\n\tpaths = append(paths, filepath.Join(factsRoot, filepath.FromSlash(branch), factsFileName))\n\t// Slugged sibling layout: facts/<branch-slug>-<hash>/facts.ndjson.\n\tif matches, err := filepath.Glob(filepath.Join(factsRoot, \"*\", factsFileName)); err == nil {\n\t\tpaths = append(paths, matches...)\n\t}\n\treturn paths\n}","numLines":75,"startLine":20,"totalLines":148}},"sourceToolAssistantUUID":"83ff2581-630d-466a-96ea-6c0780d0f9d7","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/Documents/Coding/entire-brain","sessionId":"af861ed9-9e1d-41a7-8400-b53c2995aed8","version":"2.1.177","gitBranch":"claude/brain-dash-tui","slug":"zippy-floating-lovelace"}
