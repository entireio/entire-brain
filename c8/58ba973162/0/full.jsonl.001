{"parentUuid":"cfbcc8bc-d0a5-4d02-8b5a-01d7976f7af2","isSidechain":false,"message":{"model":"claude-opus-4-8","id":"msg_013J1ACMscoh3UksBoy427uN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01H6fqjMT3cdT6QmoXqryxD6","name":"Write","input":{"file_path":"/Users/suhaan/Documents/Coding/entire-brain/internal/tui/keys.go","content":"package tui\n\nimport \"github.com/charmbracelet/bubbles/key\"\n\n// keyMap is the dashboard keymap. It implements help.KeyMap so bubbles/help can\n// render the short and full help views.\ntype keyMap struct {\n\tUp      key.Binding\n\tDown    key.Binding\n\tEnter   key.Binding\n\tBack    key.Binding\n\tSection key.Binding\n\tPrevTab key.Binding\n\tFilter  key.Binding\n\tOpen    key.Binding\n\tHelp    key.Binding\n\tQuit    key.Binding\n}\n\nfunc defaultKeys() keyMap {\n\treturn keyMap{\n\t\tUp:      key.NewBinding(key.WithKeys(\"up\", \"k\"), key.WithHelp(\"↑/k\", \"up\")),\n\t\tDown:    key.NewBinding(key.WithKeys(\"down\", \"j\"), key.WithHelp(\"↓/j\", \"down\")),\n\t\tEnter:   key.NewBinding(key.WithKeys(\"enter\", \"right\", \"l\"), key.WithHelp(\"enter/→\", \"open\")),\n\t\tBack:    key.NewBinding(key.WithKeys(\"esc\", \"left\", \"h\"), key.WithHelp(\"esc/←\", \"back\")),\n\t\tSection: key.NewBinding(key.WithKeys(\"tab\"), key.WithHelp(\"tab\", \"next section\")),\n\t\tPrevTab: key.NewBinding(key.WithKeys(\"shift+tab\"), key.WithHelp(\"shift+tab\", \"prev section\")),\n\t\tFilter:  key.NewBinding(key.WithKeys(\"/\"), key.WithHelp(\"/\", \"filter\")),\n\t\tOpen:    key.NewBinding(key.WithKeys(\"o\"), key.WithHelp(\"o\", \"open source\")),\n\t\tHelp:    key.NewBinding(key.WithKeys(\"?\"), key.WithHelp(\"?\", \"help\")),\n\t\tQuit:    key.NewBinding(key.WithKeys(\"q\", \"ctrl+c\"), key.WithHelp(\"q\", \"quit\")),\n\t}\n}\n\n// ShortHelp is the single-line help shown in the footer.\nfunc (k keyMap) ShortHelp() []key.Binding {\n\treturn []key.Binding{k.Up, k.Down, k.Enter, k.Section, k.Filter, k.Open, k.Help, k.Quit}\n}\n\n// FullHelp is the expanded help shown when ? is toggled.\nfunc (k keyMap) FullHelp() [][]key.Binding {\n\treturn [][]key.Binding{\n\t\t{k.Up, k.Down, k.Enter, k.Back},\n\t\t{k.Section, k.PrevTab, k.Filter, k.Open},\n\t\t{k.Help, k.Quit},\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2818,"cache_read_input_tokens":214902,"output_tokens":1088,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2818,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1088,"cache_read_input_tokens":214902,"cache_creation_input_tokens":2818,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2818},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011Cc7xTXsjz44THBgmJTcXu","attributionSkill":"superpowers:brainstorming","attributionPlugin":"superpowers","type":"assistant","uuid":"9e3ab88c-d643-4c35-9843-d0a360c88587","timestamp":"2026-06-17T01:23:03.330Z","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/Documents/Coding/entire-brain","sessionId":"af861ed9-9e1d-41a7-8400-b53c2995aed8","version":"2.1.177","gitBranch":"claude/brain-dash-tui","slug":"zippy-floating-lovelace"}
