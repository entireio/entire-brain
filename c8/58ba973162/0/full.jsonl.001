, want \\\"\\\" (escapes the brain)\", rel, got)\ninternal/cli/dash_test.go:188:\tif got := containedPath(\"/brain\", \"sessions/sub/x.jsonl\"); got != filepath.Join(\"/brain\", \"sessions/sub/x.jsonl\") {\ninternal/cli/dash.go:121:\t\tsr.OpenPath = containedPath(brainDir, r.Path)\ninternal/cli/dash.go:314:\t\t\tview.Source = containedPath(brainDir, f.Provenance[0].Transcript)\ninternal/cli/dash.go:349:\t\t\tview.Source = containedPath(brainDir, s.TranscriptPath)\ninternal/cli/dash.go:371:\t\t\tview.Source = containedPath(brainDir, r.Path)\ninternal/cli/dash.go:395:\t\t\tif src := containedPath(repoDir, s.FilePath); src != \"\" {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"36e61e71-9555-4ef4-9966-6f259b48f63c","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/Documents/Coding/entire-brain","sessionId":"af861ed9-9e1d-41a7-8400-b53c2995aed8","version":"2.1.177","gitBranch":"claude/brain-dash-tui","slug":"zippy-floating-lovelace"}
{"parentUuid":"6d8e1488-b3c5-416b-88f8-ccc325e373f3","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/suhaan/Documents/Coding/entire-brain/internal/cli/dash_test.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\t\"path/filepath\"\n6\t\t\"testing\"\n7\t\t\"time\"\n8\t)\n9\t\n10\tfunc TestDashFactViewsMapsFieldsAndSource(t *testing.T) {\n11\t\tfacts := []factRecord{\n12\t\t\t{\n13\t\t\t\tID: \"fact:aaa\", Kind: \"decision\", Text: \"Chose SQLite.\", Paths: []string{\"architecture.storage\"},\n14\t\t\t\tStatus: \"active\", Origin: \"distilled\", RelatedIDs: []string{\"fact:bbb\"},\n15\t\t\t\tProvenance: []factAnchor{{SessionID: \"s1\", Transcript: \"sessions/x.jsonl\", Line: 9, Verified: true}},\n16\t\t\t},\n17\t\t\t{ID: \"fact:bbb\", Kind: \"gotcha\", Text: \"No transcript anchor here.\", Status: \"active\"},\n18\t\t}\n19\t\tviews := dashFactViews(facts, \"/brain\", 0)\n20\t\tif len(views) != 2 {\n21\t\t\tt.Fatalf(\"got %d views, want 2\", len(views))\n22\t\t}\n23\t\tif views[0].Kind != \"decision\" || views[0].Text != \"Chose SQLite.\" || len(views[0].Provenance) != 1 {\n24\t\t\tt.Errorf(\"fact[0] mapped wrong: %+v\", views[0])\n25\t\t}\n26\t\tif views[0].Source != filepath.Join(\"/brain\", \"sessions/x.jsonl\") || views[0].SourceLine != 9 {\n27\t\t\tt.Errorf(\"fact[0] source = %q:%d\", views[0].Source, views[0].SourceLine)\n28\t\t}\n29\t\tif views[1].Source != \"\" {\n30\t\t\tt.Errorf(\"fact[1] without an anchor should have no open target, got %q\", views[1].Source)\n31\t\t}\n32\t\t// Limit caps the slice.\n33\t\tif got := dashFactViews(facts, \"/brain\", 1); len(got) != 1 {\n34\t\t\tt.Errorf(\"limit 1 -> %d views\", len(got))\n35\t\t}\n36\t}\n37\t\n38\tfunc TestDashSessionViewsMapsUsageAndSummary(t *testing.T) {\n39\t\tsessions := []exportSession{{\n40\t\t\tSessionID: \"sess-1\", Agent: \"claude-code\", Model: \"opus\", CreatedAt: time.Date(2026, 6, 9, 10, 0, 0, 0, time.UTC),\n41\t\t\tFilesTouched: []string{\"a.go\"}, CheckpointsCount: 3, TranscriptPath: \"sessions/x.jsonl\",\n42\t\t\tTokenUsage: &checkpointTokenUsage{InputTokens: 100, OutputTokens: 40},\n43\t\t\tSummary:    &checkpointSummary{Intent: \"add dash\", Outcome: \"shipped\"},\n44\t\t}}\n45\t\tv := dashSessionViews(sessions, \"/brain\", 0)[0]\n46\t\tif v.Agent != \"claude-code\" || v.Model != \"opus\" || v.InputTok != 100 || v.OutputTok != 40 {\n47\t\t\tt.Errorf(\"session usage mapped wrong: %+v\", v)\n48\t\t}\n49\t\tif v.Intent != \"add dash\" || v.Outcome != \"shipped\" || v.Checkpoints != 3 {\n50\t\t\tt.Errorf(\"session summary mapped wrong: %+v\", v)\n51\t\t}\n52\t\tif v.Created != \"2026-06-09 10:00Z\" || v.Source != filepath.Join(\"/brain\", \"sessions/x.jsonl\") {\n53\t\t\tt.Errorf(\"session created/source mapped wrong: %q / %q\", v.Created, v.Source)\n54\t\t}\n55\t}\n56\t\n57\tfunc TestDashSemanticViewsResolvesRepoSource(t *testing.T) {\n58\t\tsyms := []semanticRecord{{RecordType: \"symbol\", Kind: \"func\", Name: \"Run\", QualifiedName: \"tui.Run\",\n59\t\t\tFilePath: \"internal/tui/tui.go\", StartLine: 80, EndLine: 90, Signature: \"func Run()\", Language: \"go\"}}\n60\t\tv := dashSemanticViews(syms, \"/work/acme\")[0]\n61\t\tif v.Name != \"Run\" || v.Language != \"go\" || v.StartLine != 80 {\n62\t\t\tt.Errorf(\"semantic mapped wrong: %+v\", v)\n63\t\t}\n64\t\tif v.Source != filepath.Join(\"/work/acme\", \"internal/tui/tui.go\") || v.SourceLine != 80 {\n65\t\t\tt.Errorf(\"semantic source = %q:%d\", v.Source, v.SourceLine)\n66\t\t}\n67\t}\n68\t\n69\tfunc TestDashHomeViewSourcesAndNotBuilt(t *testing.T) {\n70\t\t// An empty manifest (no sources, zero generated_at) flags \"not built\".\n71\t\treport := brainStatusReport{Sources: brainStatusSources{}}\n72\t\tempty := &exportManifest{}\n73\t\thome := dashHomeView(report, empty, \"main\")\n74\t\tif len(home.Sources) != 5 {\n75\t\t\tt.Fatalf(\"want 5 source rows, got %d\", len(home.Sources))\n76\t\t}\n77\t\tfoundNotBuilt := false\n78\t\tfor _, w := range home.Warnings {\n79\t\t\tif w == \"brain not built yet — run `entire brain refresh`\" {\n80\t\t\t\tfoundNotBuilt = true\n81\t\t\t}\n82\t\t}\n83\t\tif !foundNotBuilt {\n84\t\t\tt.Errorf(\"empty brain should warn it is not built; warnings=%v\", home.Warnings)\n85\t\t}\n86\t\n87\t\t// A built brain with sources present should not warn \"not built\" and should\n88\t\t// carry per-source detail.\n89\t\tbuilt := brainStatusReport{\n90\t\t\tSources: brainStatusSources{Sessions: true, Semantic: true},\n91\t\t\tBrain:   brainStatusBrain{GeneratedAt: \"2026-06-10T09:00:00Z\"},\n92\t\t}\n93\t\tmanifest := &exportManifest{\n94\t\t\tGeneratedAt: time.Now(),\n95\t\t\tSources: &brainSources{\n96\t\t\t\tSessions: &sessionSourceManifest{Sessions: make([]exportSession, 14), CheckpointsScanned: 30},\n97\t\t\t\tSemantic: &semanticSourceManifest{Symbols: 55, Relations: 165, Files: 8},\n98\t\t\t},\n99\t\t}\n100\t\thome = dashHomeView(built, manifest, \"main\")\n101\t\tfor _, w := range home.Warnings {\n102\t\t\tif w == \"brain not built yet — run `entire brain refresh`\" {\n103\t\t\t\tt.Errorf(\"built brain should not warn not-built\")\n104\t\t\t}\n105\t\t}\n106\t\tvar semDetail string\n107\t\tfor _, s := range home.Sources {\n108\t\t\tif s.Name == \"Semantic\" {\n109\t\t\t\tsemDetail = s.Detail\n110\t\t\t}\n111\t\t}\n112\t\tif semDetail == \"\" || semDetail[:2] != \"55\" {\n113\t\t\tt.Errorf(\"semantic source detail = %q, want it to start with the symbol count\", semDetail)\n114\t\t}\n115\t}\n116\t\n117\tfunc TestDashLiveSummary(t *testing.T) {\n118\t\tif got := dashLiveSummary(brainLiveState{Dirty: false}); got != \"clean\" {\n119\t\t\tt.Errorf(\"clean tree summary = %q\", got)\n120\t\t}\n121\t\tgot := dashLiveSummary(brainLiveState{Dirty: true, Staged: []string{\"a\"}, Untracked: []string{\"b\", \"c\"}})\n122\t\tif got != \"1 staged · 2 untracked\" {\n123\t\t\tt.Errorf(\"dirty summary = %q, want \\\"1 staged · 2 untracked\\\"\", got)\n124\t\t}\n125\t}\n126\t\n127\tfunc TestLoadSemanticSymbolsReadsSnapshot(t *testing.T) {\n128\t\tdir := t.TempDir()\n129\t\trel := filepath.FromSlash(\"semantic/snapshots/gen1/snapshot.ndjson\")\n130\t\tif err := os.MkdirAll(filepath.Dir(filepath.Join(dir, rel)), 0o755); err != nil {\n131\t\t\tt.Fatal(err)\n132\t\t}\n133\t\t// Header line + two symbols + one relation; only symbols should come back.\n134\t\tcontent := `{\"schema_version\":\"1.0\",\"provider\":\"entire-sem\"}\n135\t{\"record_type\":\"symbol\",\"id\":\"s1\",\"kind\":\"func\",\"name\":\"Run\",\"file_path\":\"a.go\",\"start_line\":1}\n136\t{\"record_type\":\"relation\",\"id\":\"r1\",\"type\":\"calls\",\"from_id\":\"s1\",\"to_id\":\"s2\"}\n137\t{\"record_type\":\"symbol\",\"id\":\"s2\",\"kind\":\"type\",\"name\":\"Model\",\"file_path\":\"b.go\",\"start_line\":5}\n138\t`\n139\t\tif err := os.WriteFile(filepath.Join(dir, rel), []byte(content), 0o644); err != nil {\n140\t\t\tt.Fatal(err)\n141\t\t}\n142\t\tsource := &semanticSourceManifest{SnapshotPath: filepath.ToSlash(rel)}\n143\t\tsyms, err := loadSemanticSymbols(dir, source, 0)\n144\t\tif err != nil {\n145\t\t\tt.Fatal(err)\n146\t\t}\n147\t\tif len(syms) != 2 || syms[0].Name != \"Run\" || syms[1].Name != \"Model\" {\n148\t\t\tt.Fatalf(\"symbols = %+v, want Run + Model only\", syms)\n149\t\t}\n150\t\t// Limit caps the result.\n151\t\tcapped, err := loadSemanticSymbols(dir, source, 1)\n152\t\tif err != nil || len(capped) != 1 {\n153\t\t\tt.Fatalf(\"limit 1 -> %d symbols (err %v)\", len(capped), err)\n154\t\t}\n155\t\t// A missing snapshot is not an error.\n156\t\tif got, err := loadSemanticSymbols(dir, &semanticSourceManifest{SnapshotPath: \"semantic/snapshots/missing/snapshot.ndjson\"}, 0); err != nil || got != nil {\n157\t\t\tt.Errorf(\"missing snapshot -> %v (err %v), want nil/nil\", got, err)\n158\t\t}\n159\t}\n160\t\n161\tfunc TestAppendCapNote(t *testing.T) {\n162\t\tif n := appendCapNote(nil, \"facts\", 1234, 500); len(n) != 1 || n[0] != \"facts: showing 500 of 1234\" {\n163\t\t\tt.Errorf(\"cap note = %v\", n)\n164\t\t}\n165\t\tif n := appendCapNote(nil, \"facts\", 10, 10); n != nil {\n166\t\t\tt.Errorf(\"no cap should add no note, got %v\", n)\n167\t\t}\n168\t}\n169\t\n170\tfunc TestBrainRelPathRejectsAbsolute(t *testing.T) {\n171\t\tif got := containedPath(\"/brain\", \"/etc/passwd\"); got != \"\" {\n172\t\t\tt.Errorf(\"absolute path should not become an open target, got %q\", got)\n173\t\t}\n174\t\tif got := containedPath(\"/brain\", \"sessions/x.jsonl\"); got != filepath.Join(\"/brain\", \"sessions/x.jsonl\") {\n175\t\t\tt.Errorf(\"rel path join = %q\", got)\n176\t\t}\n177\t}\n178\t\n179\tfunc TestBrainRelPathRejectsTraversal(t *testing.T) {\n180\t\t// A \"../\"-laden anchor read from a brain file must never resolve to an open\n181\t\t// target outside the brain (the `o` key hands the result to the OS opener).\n182\t\tfor _, rel := range []string{\"../../etc/passwd\", \"..\", \"sessions/../../secret\", \"a/../../b\"} {\n183\t\t\tif got := containedPath(\"/brain\", rel); got != \"\" {\n184\t\t\t\tt.Errorf(\"containedPath(/brain, %q) = %q, want \\\"\\\" (escapes the brain)\", rel, got)\n185\t\t\t}\n186\t\t}\n187\t\t// A legitimate nested path that stays inside the brain is still allowed.\n\n... [4 lines truncated] ..."},"type":"attachment","uuid":"bf327ec3-f140-421e-8543-bcba73a1eb2d","timestamp":"2026-06-17T16:14:27.339Z","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/Documents/Coding/entire-brain","sessionId":"af861ed9-9e1d-41a7-8400-b53c2995aed8","version":"2.1.177","gitBranch":"claude/brain-dash-tui","slug":"zippy-floating-lovelace"}
{"parentUuid":"bf327ec3-f140-421e-8543-bcba73a1eb2d","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/suhaan/Documents/Coding/entire-brain/internal/cli/dash.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"context\"\n6\t\t\"encoding/json\"\n7\t\t\"fmt\"\n8\t\t\"os\"\n9\t\t\"path/filepath\"\n10\t\t\"strings\"\n11\t\n12\t\t\"github.com/mattn/go-isatty\"\n13\t\t\"github.com/spf13/cobra\"\n14\t\n15\t\t\"github.com/ashtom/entire-brain/internal/tui\"\n16\t)\n17\t\n18\t// dashDefaultLimit caps how many entries per tab the dashboard loads. Large\n19\t// brains can hold thousands of facts/symbols; the cap keeps the snapshot bounded\n20\t// and a Note records what was dropped so the truncation is never silent. A\n21\t// non-positive --limit means no cap.\n22\tconst dashDefaultLimit = 500\n23\t\n24\t// dashSearchLimit caps results from an in-dashboard search (the `s` key),\n25\t// matching the `entire brain search` default surface.\n26\tconst dashSearchLimit = 25\n27\t\n28\ttype dashFlags struct {\n29\t\ttheme  string\n30\t\ttab    string\n31\t\tbranch string\n32\t\tlimit  int\n33\t\tjson   bool\n34\t\tplain  bool\n35\t}\n36\t\n37\tfunc newDashCommand(opts Options) *cobra.Command {\n38\t\tvar flags dashFlags\n39\t\tcmd := &cobra.Command{\n40\t\t\tUse:   \"dash [path]\",\n41\t\t\tShort: \"Browse the brain in an interactive dashboard (status, facts, sessions, history, semantic)\",\n42\t\t\tLong: `dash opens an interactive terminal dashboard over the brain: a Home tab\n43\tsummarizing source health, freshness, and blind spots, plus explorer tabs that\n44\tbrowse individual facts, sessions, history records, and semantic symbols, each\n45\twith a detail page. It is read-only and makes no agent calls.\n46\t\n47\tOn a non-TTY (piped output) it prints a plain summary instead; --json emits the\n48\tloaded snapshot.`,\n49\t\t\tArgs: cobra.MaximumNArgs(1),\n50\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n51\t\t\t\treturn runDash(cmd.Context(), cmd, opts, flags, agentSurfaceTarget(opts, args))\n52\t\t\t},\n53\t\t}\n54\t\tcmd.Flags().StringVar(&flags.theme, \"theme\", \"\", \"Color theme: \"+strings.Join(tui.ThemeNames(), \", \")+\" (or set ENTIRE_BRAIN_THEME)\")\n55\t\tcmd.Flags().StringVar(&flags.tab, \"tab\", \"\", \"Tab to open on: home, facts, sessions, history, semantic, search\")\n56\t\tcmd.Flags().StringVar(&flags.branch, \"branch\", \"\", \"Branch whose facts to load (default: current branch)\")\n57\t\tcmd.Flags().IntVar(&flags.limit, \"limit\", dashDefaultLimit, \"Max entries loaded per tab (0 = no cap)\")\n58\t\tcmd.Flags().BoolVar(&flags.json, \"json\", false, \"Emit the loaded snapshot as JSON instead of opening the dashboard\")\n59\t\tcmd.Flags().BoolVar(&flags.plain, \"plain\", false, \"Print a plain text summary instead of opening the dashboard\")\n60\t\treturn cmd\n61\t}\n62\t\n63\tfunc runDash(ctx context.Context, cmd *cobra.Command, opts Options, flags dashFlags, target string) error {\n64\t\tstartTab, ok := tui.ParseTab(flags.tab)\n65\t\tif !ok && flags.tab != \"\" {\n66\t\t\treturn fmt.Errorf(\"unknown_tab: %q (want home, facts, sessions, history, semantic, or search)\", flags.tab)\n67\t\t}\n68\t\n69\t\trepoDir, brainDir, branch, err := resolveFactsTarget(ctx, opts, target, flags.branch)\n70\t\tif err != nil {\n71\t\t\treturn err\n72\t\t}\n73\t\n74\t\tsnap, err := assembleBrainSnapshot(ctx, opts, target, repoDir, brainDir, branch, flags.limit)\n75\t\tif err != nil {\n76\t\t\treturn err\n77\t\t}\n78\t\n79\t\tif flags.json {\n80\t\t\treturn writeJSON(cmd, snap)\n81\t\t}\n82\t\tif flags.plain || !commandOutputIsTTY(cmd) {\n83\t\t\tprintDashPlain(cmd, snap)\n84\t\t\treturn nil\n85\t\t}\n86\t\treturn tui.Run(snap, resolveDashTheme(flags.theme), brainSearchFunc(brainDir, branch), startTab, cmd.OutOrStdout())\n87\t}\n88\t\n89\t// brainSearchFunc adapts the lexical retrieval (`entire brain search`) into the\n90\t// callback the dashboard's `s` key invokes, so search runs the same code path as\n91\t// the CLI verb while keeping the TUI free of file IO.\n92\tfunc brainSearchFunc(brainDir, branch string) tui.SearchFunc {\n93\t\treturn func(query string) ([]tui.SearchResult, error) {\n94\t\t\tresults, err := retrieveUnified(brainDir, branch, query, dashSearchLimit, modeLexical)\n95\t\t\tif err != nil {\n96\t\t\t\treturn nil, err\n97\t\t\t}\n98\t\t\tout := make([]tui.SearchResult, 0, len(results))\n99\t\t\tfor _, r := range results {\n100\t\t\t\tout = append(out, searchResultFromUnified(r, brainDir))\n101\t\t\t}\n102\t\t\treturn out, nil\n103\t\t}\n104\t}\n105\t\n106\t// searchResultFromUnified maps a retrieval hit to the TUI view model and decides\n107\t// its \"open source\" target. Only history and doc hits carry a real\n108\t// brain-relative file path; a fact's Path is its taxonomy labels (not a file),\n109\t// so a fact hit gets no open target rather than a bogus one.\n110\tfunc searchResultFromUnified(r unifiedResult, brainDir string) tui.SearchResult {\n111\t\tsr := tui.SearchResult{\n112\t\t\tSource:  r.Source,\n113\t\t\tID:      r.ID,\n114\t\t\tPath:    r.Path,\n115\t\t\tHeading: r.Heading,\n116\t\t\tLine:    r.Line,\n117\t\t\tText:    r.Text,\n118\t\t\tScore:   r.Score,\n119\t\t}\n120\t\tif r.Path != \"\" && (r.Source == \"history\" || r.Source == \"doc\") {\n121\t\t\tsr.OpenPath = containedPath(brainDir, r.Path)\n122\t\t\tsr.OpenLine = r.Line\n123\t\t}\n124\t\treturn sr\n125\t}\n126\t\n127\t// assembleBrainSnapshot is the only place that touches the brain on disk. It\n128\t// reuses the existing loaders to build a read-only tui.Snapshot; no agent calls.\n129\tfunc assembleBrainSnapshot(ctx context.Context, opts Options, target, repoDir, brainDir, branch string, limit int) (tui.Snapshot, error) {\n130\t\tsnap := tui.Snapshot{Repo: repoDir, Branch: branch}\n131\t\n132\t\tstatus, err := buildBrainStatusReport(ctx, opts, target)\n133\t\tif err != nil {\n134\t\t\treturn snap, err\n135\t\t}\n136\t\tif status.Repo.Root != \"\" {\n137\t\t\tsnap.Repo = status.Repo.Root\n138\t\t}\n139\t\tsnap.GeneratedAt = status.Brain.GeneratedAt\n140\t\tmanifest := status.Manifest\n141\t\tsnap.Home = dashHomeView(status, manifest, branch)\n142\t\n143\t\t// Facts (per branch).\n144\t\tif facts, err := loadFacts(brainDir, branch); err != nil {\n145\t\t\tsnap.Home.Warnings = append(snap.Home.Warnings, \"facts unavailable: \"+err.Error())\n146\t\t} else {\n147\t\t\tsnap.Facts = dashFactViews(facts, brainDir, limit)\n148\t\t\tsnap.Notes = appendCapNote(snap.Notes, \"facts\", len(facts), len(snap.Facts))\n149\t\t}\n150\t\n151\t\tif manifest != nil && manifest.Sources != nil {\n152\t\t\t// Sessions (from the manifest).\n153\t\t\tif s := manifest.Sources.Sessions; s != nil {\n154\t\t\t\tsnap.Sessions = dashSessionViews(s.Sessions, brainDir, limit)\n155\t\t\t\tsnap.Notes = appendCapNote(snap.Notes, \"sessions\", len(s.Sessions), len(snap.Sessions))\n156\t\t\t}\n157\t\t\t// History (index.json).\n158\t\t\tif h := manifest.Sources.History; h != nil {\n159\t\t\t\tif idx, err := loadBrainHistoryIndex(brainDir, h); err != nil {\n160\t\t\t\t\tsnap.Home.Warnings = append(snap.Home.Warnings, \"history unavailable: \"+err.Error())\n161\t\t\t\t} else {\n162\t\t\t\t\tsnap.History = dashHistoryViews(idx.Records, brainDir, limit)\n163\t\t\t\t\tsnap.Notes = appendCapNote(snap.Notes, \"history\", len(idx.Records), len(snap.History))\n164\t\t\t\t}\n165\t\t\t}\n166\t\t\t// Semantic symbols (snapshot.ndjson).\n167\t\t\tif sem := manifest.Sources.Semantic; sem != nil {\n168\t\t\t\tif syms, err := loadSemanticSymbols(brainDir, sem, limit); err != nil {\n169\t\t\t\t\tsnap.Home.Warnings = append(snap.Home.Warnings, \"semantic unavailable: \"+err.Error())\n170\t\t\t\t} else {\n171\t\t\t\t\tsnap.Semantic = dashSemanticViews(syms, repoDir)\n172\t\t\t\t\tsnap.Notes = appendCapNote(snap.Notes, \"semantic symbols\", sem.Symbols, len(snap.Semantic))\n173\t\t\t\t}\n174\t\t\t}\n175\t\t}\n176\t\n177\t\treturn snap, nil\n178\t}\n179\t\n180\t// dashHomeView maps the status report into the Home tab view model.\n181\tfunc dashHomeView(status brainStatusReport, manifest *exportManifest, branch string) tui.HomeView {\n182\t\thome := tui.HomeView{\n183\t\t\tFreshness:  brainStatusFreshnessSeverity(status),\n184\t\t\tWarnings:   append([]string(nil), status.Warnings...),\n185\t\t\tBlindSpots: dashBlindSpotLabels(brainStatusBlindSpots(status)),\n186\t\t}\n187\t\n188\t\tpresent := status.Sources\n189\t\tdetail := dashSourceDetails(manifest)\n190\t\thome.Sources = []tui.SourceHealth{\n191\t\t\t{Name: \"Seed\", Present: present.Seed, Detail: detail[\"seed\"]},\n192\t\t\t{Name: \"Sessions\", Present: present.Sessions, Detail: detail[\"sessions\"]},\n193\t\t\t{Name: \"Semantic\", Present: present.Semantic, Detail: detail[\"semantic\"]},\n194\t\t\t{Name: \"History\", Present: present.History, Detail: detail[\"history\"]},\n195\t\t\t{Name: \"Facts\", Present: present.Facts, Detail: detail[\"facts\"]},\n196\t\t}\n197\t\n198\t\tif status.Semantic != nil && status.Semantic.Freshness != nil {\n199\t\t\tfor name, axis := range status.Semantic.Freshness.Axes {\n\n... [374 lines truncated] ..."},"type":"attachment","uuid":"2cd282d9-d444-4f17-9fcd-f24ed88060a0","timestamp":"2026-06-17T16:14:27.339Z","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/Documents/Coding/entire-brain","sessionId":"af861ed9-9e1d-41a7-8400-b53c2995aed8","version":"2.1.177","gitBranch":"claude/brain-dash-tui","slug":"zippy-floating-lovelace"}
