Branch != \\\"feature/already-merged\\\" {\\n\\t\\tt.Fatalf(\\\"source branch = %q, want the original feature branch preserved\\\", session.SourceBranch)\\n\\t}\\n\\tif _, leaked := selected[selectedSessionKey(\\\"feature/already-merged\\\", \\\"session-one\\\")]; leaked {\\n\\t\\tt.Fatalf(\\\"reachable checkpoint must not also land in its recorded feature-branch folder: %+v\\\", selected)\\n\\t}\\n}\\n\"\n32\t    }\n33\t  ],\n34\t  \"expected_files\": [\n35\t    \"internal/cli/export.go\"\n36\t  ],\n37\t  \"forbidden_files\": [\n38\t    \"go.mod\",\n39\t    \"go.sum\"\n40\t  ],\n41\t  \"hide_expected_from_agent\": true,\n42\t  \"hide_validation_from_agent\": true,\n43\t  \"leak_markers\": [\n44\t    \"go test ./internal/cli -run 'TestReachableCheckpointRoutesToDefaultBranchFolder'\"\n45\t  ],\n46\t  \"agent_hidden_paths\": [\n47\t    \"benchmarks/agent-brain\"\n48\t  ],\n49\t  \"brain_queries\": [\n50\t    \"exported session from a merged feature branch lands in the wrong folder\",\n51\t    \"which folder should hold a checkpoint that is also on the main line\",\n52\t    \"should the recorded branch or git reachability decide the export folder\",\n53\t    \"session grouping after a feature branch was merged\",\n54\t    \"where do merged checkpoints belong in the export\"\n55\t  ]\n56\t}\n57\t"}]},"uuid":"b26ddc72-7e96-4fb5-928c-d809401694dd","timestamp":"2026-06-18T18:36:56.254Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/suhaan/Documents/Coding/entire-brain/benchmarks/agent-brain/tasks/entire-brain-clean-contract-checkpoint-branch-reachability.json","content":"{\n  \"id\": \"entire-brain-clean-contract-checkpoint-branch-reachability\",\n  \"repo\": \"entire-brain\",\n  \"repo_path\": \"entire-brain\",\n  \"base_commit\": \"fc65f656615f4623a2370ec7943f8d575714cfe8\",\n  \"conditions\": [\n    \"no_brain\",\n    \"full_brain\"\n  ],\n  \"copy_checkpoint_ref_from_source\": true,\n  \"prepare_semantic\": false,\n  \"prompt\": \"Session export regression