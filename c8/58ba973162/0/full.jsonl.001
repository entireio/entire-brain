\n\t\tSection: key.NewBinding(key.WithKeys(\"tab\"), key.WithHelp(\"tab\", \"next section\")),\n\t\tPrevTab: key.NewBinding(key.WithKeys(\"shift+tab\"), key.WithHelp(\"shift+tab\", \"prev section\")),\n\t\tFilter:  key.NewBinding(key.WithKeys(\"/\"), key.WithHelp(\"/\", \"filter\")),\n\t\tOpen:    key.NewBinding(key.WithKeys(\"o\"), key.WithHelp(\"o\", \"open source\")),\n\t\tHelp:    key.NewBinding(key.WithKeys(\"?\"), key.WithHelp(\"?\", \"help\")),\n\t\tQuit:    key.NewBinding(key.WithKeys(\"q\", \"ctrl+c\"), key.WithHelp(\"q\", \"quit\")),\n\t}\n}\n\n// ShortHelp is the single-line help shown in the footer.\nfunc (k keyMap) ShortHelp() []key.Binding {\n\treturn []key.Binding{k.Up, k.Down, k.Enter, k.Section, k.Filter, k.Open, k.Help, k.Quit}\n}\n\n// FullHelp is the expanded help shown when ? is toggled.\nfunc (k keyMap) FullHelp() [][]key.Binding {\n\treturn [][]key.Binding{\n\t\t{k.Up, k.Down, k.Enter, k.Back},\n\t\t{k.Section, k.PrevTab, k.Filter, k.Open},\n\t\t{k.Help, k.Quit},\n\t}\n}\n","structuredPatch":[{"oldStart":27,"oldLines":6,"newStart":27,"newLines":7,"lines":["     Section: key.NewBinding(key.WithKeys(\"tab\"), key.WithHelp(\"tab\", \"next section\")),","     PrevTab: key.NewBinding(key.WithKeys(\"shift+tab\"), key.WithHelp(\"shift+tab\", \"prev section\")),","     Filter:  key.NewBinding(key.WithKeys(\"/\"), key.WithHelp(\"/\", \"filter\")),","+    Search:  key.NewBinding(key.WithKeys(\"s\"), key.WithHelp(\"s\", \"search brain\")),","     Open:    key.NewBinding(key.WithKeys(\"o\"), key.WithHelp(\"o\", \"open source\")),","     Help:    key.NewBinding(key.WithKeys(\"?\"), key.WithHelp(\"?\", \"help\")),","     Quit:    key.NewBinding(key.WithKeys(\"q\", \"ctrl+c\"), key.WithHelp(\"q\", \"quit\")),"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"5e679da3-d2c8-4e85-b6de-1b924d21b50c","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/Documents/Coding/entire-brain/internal/cli","sessionId":"af861ed9-9e1d-41a7-8400-