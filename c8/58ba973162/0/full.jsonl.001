{"parentUuid":"76b6b02e-7b81-473f-b7ce-513b92d5df63","isSidechain":false,"promptId":"f9f3b7db-34bc-4a1f-a1ca-d8031b2c6a87","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015etatKkHzzGzEuLUV6Hgzk","type":"tool_result","content":"=== dash --help ===\ndash opens an interactive terminal dashboard over the brain: a Home tab\nsummarizing source health, freshness, and blind spots, plus explorer tabs that\nbrowse individual facts, sessions, history records, and semantic symbols, each\nwith a detail page. It is read-only and makes no agent calls.\n\nOn a non-TTY (piped output) it prints a plain summary instead; --json emits the\nloaded snapshot.\n\nUsage:\n  entire-brain dash [path] [flags]\n\nFlags:\n      --branch string   Branch whose facts to load (default: current branch)\n  -h, --help            help for dash\n      --json            Emit the loaded snapshot as JSON instead of opening the dashboard\n      --limit int       Max entries loaded per tab (0 = no cap) (default 500)\n      --plain           Print a plain text summary instead of opening the dashboard\n      --tab string      Tab to open on: home, facts, sessions, history, semantic\n      --theme string    Color theme: default, catppuccin, gruvbox, tokyonight (or set ENTIRE_BRAIN_THEME)","is_error":false}]},"uuid":"7e6b1ec1-f87e-49dd-ada1-dd4dc7add1aa","timestamp":"2026-06-17T01:35:07.405Z","toolUseResult":{"stdout":"=== dash --help ===\ndash opens an interactive terminal dashboard over the brain: a Home tab\nsummarizing source health, freshness, and blind spots, plus explorer tabs that\nbrowse individual facts, sessions, history records, and semantic symbols, each\nwith a detail page. It is read-only and makes no agent calls.\n\nOn a non-TTY (piped output) it prints a plain summary instead; --json emits the\nloaded snapshot.\n\nUsage:\n  entire-brain dash [path] [flags]\n\nFlags:\n      --branch string   Branch whose facts to load (default: current branch)\n  -h, --help            help for dash\n      --json            Emit the loaded snapshot as JSON instead of opening the dashboard\n      --limit int       Max entries loaded per tab (0 = no cap) (default 500)\n      --plain           Print a plain text summary instead of opening the dashboard\n      --tab string      Tab to open on: home, facts, sessions, history, semantic\n      --theme string    Color theme: default, catppuccin, gruvbox, tokyonight (or set ENTIRE_BRAIN_THEME)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"76b6b02e-7b81-473f-b7ce-513b92d5df63","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/Documents/Coding/entire-brain","sessionId":"af861ed9-9e1d-41a7-8400-b53c2995aed8","version":"2.1.177","gitBranch":"claude/brain-dash-tui","slug":"zippy-floating-lovelace"}
