{"parentUuid":"84fb890f-23f9-4102-83b5-d8d4cf1476d6","isSidechain":false,"message":{"model":"claude-opus-4-8","id":"msg_019Qu1RT2ZnLiVgiJ3ThbRfU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Se8PmRt37CLTmH2KVuq3Cd","name":"Read","input":{"file_path":"/Users/suhaan/Documents/Coding/entire-brain/internal/cli/skill_cmd.go"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2914,"cache_read_input_tokens":533542,"output_tokens":371,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2914,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":371,"cache_read_input_tokens":533542,"cache_creation_input_tokens":2914,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2914},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011Cc994Lr6wKqwYWD8Un5Tz","type":"assistant","uuid":"5b16c05d-09c3-4df3-abe1-4a69c7eed21b","timestamp":"2026-06-17T16:22:34.396Z","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/Documents/Coding/entire-brain","sessionId":"af861ed9-9e1d-41a7-8400-b53c2995aed8","version":"2.1.177","gitBranch":"claude/patterns-v2-corpus","slug":"zippy-floating-lovelace"}
{"parentUuid":"5b16c05d-09c3-4df3-abe1-4a69c7eed21b","isSidechain":false,"promptId":"e994dde8-5879-4b7d-b7a3-329a07d36f1c","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Se8PmRt37CLTmH2KVuq3Cd","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"fmt\"\n6\t\t\"io\"\n7\t\t\"os\"\n8\t\t\"path/filepath\"\n9\t\t\"time\"\n10\t\n11\t\t\"github.com/spf13/cobra\"\n12\t)\n13\t\n14\t// `patterns skills` — the real skill surface (Phase 2 redo). It lists recurring\n15\t// task candidates and synthesizes an actual SKILL.md from one via an agent,\n16\t// gated on non-obviousness. This supersedes the command-n-gram procedure listing\n17\t// as the source of skills.\n18\t\n19\tfunc newPatternsSkillsCommand(opts Options) *cobra.Command {\n20\t\tvar (\n21\t\t\tasJSON bool\n22\t\t\tlimit  int\n23\t\t)\n24\t\tcmd := &cobra.Command{\n25\t\t\tUse:   \"skills [path]\",\n26\t\t\tShort: \"List recurring task candidates that can be synthesized into skills\",\n27\t\t\tArgs:  cobra.MaximumNArgs(1),\n28\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n29\t\t\t\treturn runPatternsSkillsList(cmd.Context(), cmd, opts, targetFromArgs(opts, args), asJSON, limit)\n30\t\t\t},\n31\t\t}\n32\t\tcmd.Flags().BoolVar(&asJSON, \"json\", false, \"Emit task candidates as JSON\")\n33\t\tcmd.Flags().IntVar(&limit, \"limit\", 20, \"Maximum candidates to show\")\n34\t\tcmd.AddCommand(newPatternsSkillsFormCommand(opts))\n35\t\treturn cmd\n36\t}\n37\t\n38\tfunc newPatternsSkillsFormCommand(opts Options) *cobra.Command {\n39\t\tvar s skillFormOptions\n40\t\tcmd := &cobra.Command{\n41\t\t\tUse:   \"form <task-id> [path]\",\n42\t\t\tShort: \"Synthesize a SKILL.md from a task candidate (previews until --yes)\",\n43\t\t\tArgs:  cobra.RangeArgs(1, 2),\n44\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n45\t\t\t\ttarget := targetFromArgs(opts, nil)\n46\t\t\t\tif len(args) == 2 {\n47\t\t\t\t\ttarget = args[1]\n48\t\t\t\t}\n49\t\t\t\ts.taskID = args[0]\n50\t\t\t\treturn runPatternsSkillsForm(cmd.Context(), cmd, opts, target, s)\n51\t\t\t},\n52\t\t}\n53\t\tcmd.Flags().StringVar(&s.name, \"name\", \"\", \"Override the skill name (default: from the synthesized frontmatter)\")\n54\t\tcmd.Flags().StringVar(&s.target, \"target\", \"standard\", \"Install target: standard|claude-code|codex|factoryai-droid|all\")\n55\t\tcmd.Flags().StringVar(&s.scope, \"scope\", \"global\", \"Install scope: global|repo\")\n56\t\tcmd.Flags().StringVar(&s.agent, \"agent\", \"auto\", \"Synthesis agent: auto|codex|claude-code\")\n57\t\tcmd.Flags().StringVar(&s.model, \"model\", \"\", \"Override the agent model\")\n58\t\tcmd.Flags().StringVar(&s.effort, \"effort\", \"\", \"Override the agent reasoning effort\")\n59\t\tcmd.Flags().BoolVar(&s.yes, \"yes\", false, \"Write the synthesized skill files\")\n60\t\tcmd.Flags().BoolVar(&s.force, \"force\", false, \"Overwrite an existing skill file\")\n61\t\tcmd.Flags().BoolVar(&s.draftOnly, \"draft-only\", false, \"Print the synthesized SKILL.md without writing\")\n62\t\tcmd.Flags().BoolVar(&s.asJSON, \"json\", false, \"Emit the result as JSON\")\n63\t\treturn cmd\n64\t}\n65\t\n66\ttype skillFormOptions struct {\n67\t\ttaskID    string\n68\t\tname      string\n69\t\ttarget    string\n70\t\tscope     string\n71\t\tagent     string\n72\t\tmodel     string\n73\t\teffort    string\n74\t\tyes       bool\n75\t\tforce     bool\n76\t\tdraftOnly bool\n77\t\tasJSON    bool\n78\t}\n79\t\n80\tfunc runPatternsSkillsList(ctx context.Context, cmd *cobra.Command, opts Options, target string, asJSON bool, limit int) error {\n81\t\tbrainDir, err := resolvePatternsBrainDir(ctx, opts, target)\n82\t\tif err != nil {\n83\t\t\treturn err\n84\t\t}\n85\t\t// V2 corpus is the primary source; legacy task JSON is the fallback.\n86\t\ttasks, corpusBacked := loadCorpusTaskCandidates(brainDir)\n87\t\tif !corpusBacked {\n88\t\t\tif tasks, err = loadBrainTasks(brainDir); err != nil {\n89\t\t\t\treturn err\n90\t\t\t}\n91\t\t}\n92\t\t// Suppress already-formed-and-current / declined-unchanged candidates.\n93\t\ttasks = filterSkillCandidatesByMemory(brainDir, tasks)\n94\t\tif limit > 0 && len(tasks) > limit {\n95\t\t\ttasks = tasks[:limit]\n96\t\t}\n97\t\tif asJSON {\n98\t\t\tredacted := make([]taskCandidate, len(tasks))\n99\t\t\tfor i, t := range tasks {\n100\t\t\t\tredacted[i] = redactCandidate(t)\n101\t\t\t}\n102\t\t\treturn writeJSON(cmd, redacted)\n103\t\t}\n104\t\tout := cmd.OutOrStdout()\n105\t\tif len(tasks) == 0 {\n106\t\t\tfmt.Fprintln(out, \"no task candidates (run `entire brain patterns refresh`)\")\n107\t\t\treturn nil\n108\t\t}\n109\t\tfor _, t := range tasks {\n110\t\t\tr := t.Reinforcement\n111\t\t\tfmt.Fprintf(out, \"[%s] %s  (strength %.2f)\\n\", t.StrengthLabel, redactText(t.Label), t.Strength)\n112\t\t\tfmt.Fprintf(out, \"    %d session(s), %d with commands; %d↑ %d↓ %d·; commands: %s\\n\",\n113\t\t\t\tt.Support, t.WithCommands, r.Success, r.Corrected, r.Neutral, redactText(joinMax(t.Commands, 5)))\n114\t\t\tfmt.Fprintf(out, \"    id %s\\n\", t.ID)\n115\t\t}\n116\t\treturn nil\n117\t}\n118\t\n119\tfunc runPatternsSkillsForm(ctx context.Context, cmd *cobra.Command, opts Options, target string, s skillFormOptions) error {\n120\t\trepoDir, local, err := resolveLocalTargetRepoDir(ctx, opts.Runner, target)\n121\t\tif err != nil {\n122\t\t\treturn err\n123\t\t}\n124\t\tif !local {\n125\t\t\treturn fmt.Errorf(\"patterns skills form requires a local repository path: %s\", target)\n126\t\t}\n127\t\tstorage, err := repoStoragePaths(ctx, opts.Runner, opts.Env, repoDir)\n128\t\tif err != nil {\n129\t\t\treturn err\n130\t\t}\n131\t\tbrainDir := storage.BrainDir\n132\t\n133\t\tvar cand *taskCandidate\n134\t\tif c, corpusBacked := corpusTaskCandidateByID(brainDir, s.taskID); corpusBacked {\n135\t\t\tcand = c\n136\t\t} else {\n137\t\t\ttasks, err := loadBrainTasks(brainDir)\n138\t\t\tif err != nil {\n139\t\t\t\treturn err\n140\t\t\t}\n141\t\t\tfor i := range tasks {\n142\t\t\t\tif tasks[i].ID == s.taskID {\n143\t\t\t\t\tcand = &tasks[i]\n144\t\t\t\t\tbreak\n145\t\t\t\t}\n146\t\t\t}\n147\t\t}\n148\t\tif cand == nil {\n149\t\t\treturn fmt.Errorf(\"task candidate not found: %s (run `entire brain patterns skills`)\", s.taskID)\n150\t\t}\n151\t\n152\t\tagent := s.agent\n153\t\tif agent == \"\" || agent == \"auto\" {\n154\t\t\tagent = defaultRefreshAgent(ctx, opts.Runner, repoDir)\n155\t\t}\n156\t\tif agent == \"none\" {\n157\t\t\treturn fmt.Errorf(\"skill synthesis requires an agent (codex or claude-code); none found on PATH\")\n158\t\t}\n159\t\treturn synthesizeAndForm(ctx, cmd, *cand, brainDir, repoDir, agent, defaultDistillAgentRunner(agent), s, opts.Now().UTC())\n160\t}\n161\t\n162\t// synthesizeAndForm is the single skill-creation path (repo and workspace):\n163\t// synthesize via the agent, reject NOT_A_SKILL, then show evidence + draft and\n164\t// stop unless --yes. All evidence/draft egress is redacted. storeDir is where the\n165\t// skill-memory decision is recorded. run is injected so tests can stub the agent.\n166\tfunc synthesizeAndForm(ctx context.Context, cmd *cobra.Command, cand taskCandidate, storeDir, repoDir, agent string, run distillAgentRunner, s skillFormOptions, now time.Time) error {\n167\t\tfmt.Fprintf(cmd.ErrOrStderr(), \"synthesizing skill from %d sessions via %s…\\n\", cand.Support, agent)\n168\t\tres, err := synthesizeSkill(ctx, repoDir, storeDir, cand, agent, s.model, s.effort, run)\n169\t\tif err != nil {\n170\t\t\treturn err\n171\t\t}\n172\t\tif !res.IsSkill {\n173\t\t\tif s.asJSON {\n174\t\t\t\treturn writeJSON(cmd, map[string]any{\"task_id\": cand.ID, \"is_skill\": false, \"reason\": res.Reason})\n175\t\t\t}\n176\t\t\tfmt.Fprintf(cmd.OutOrStdout(), \"not a skill: %s\\n\", res.Reason)\n177\t\t\treturn nil\n178\t\t}\n179\t\tname := s.name\n180\t\tif name == \"\" {\n181\t\t\tname = res.Name\n182\t\t}\n183\t\tif name == \"\" {\n184\t\t\tname = \"skill\"\n185\t\t}\n186\t\tskillText := redactText(res.SkillText)\n187\t\n188\t\tif s.draftOnly {\n189\t\t\tif s.asJSON {\n190\t\t\t\treturn writeJSON(cmd, map[string]any{\"task_id\": cand.ID, \"is_skill\": true, \"name\": name, \"skill\": skillText})\n191\t\t\t}\n192\t\t\tfmt.Fprintln(cmd.OutOrStdout(), skillText)\n193\t\t\treturn nil\n194\t\t}\n195\t\n196\t\tdests, err := skillDestinations(s.target, s.scope, name, repoDir)\n197\t\tif err != nil {\n198\t\t\treturn err\n199\t\t}\n200\t\n201\t\t// Evidence-first preview (Priority 6): show WHY this is a skill, then the\n202\t\t// draft and the exact would-write destinations. Nothing is written.\n203\t\tif !s.yes {\n204\t\t\tif s.asJSON {\n205\t\t\t\treturn writeJSON(cmd, map[string]any{\n206\t\t\t\t\t\"task_id\": cand.ID, \"is_skill\": true, \"name\": name,\n207\t\t\t\t\t\"evidence\": redactCandidate(cand), \"skill\": skillText, \"would_write\": dests,\n208\t\t\t\t})\n209\t\t\t}\n210\t\t\tout := cmd.OutOrStdout()\n211\t\t\trenderCandidateEvidence(out, cand)\n212\t\t\tfmt.Fprintln(out, \"\\n--- proposed SKILL.md ---\")\n213\t\t\tfmt.Fprintln(out, skillText)\n214\t\t\tfmt.Fprintln(out, \"\\nwould write to:\")\n215\t\t\tfor _, d := range dests {\n216\t\t\t\tfmt.Fprintf(out, \"  %s   (%s)\\n\", d.Path, joinMax(d.Agents, 8))\n217\t\t\t}\n218\t\t\tfmt.Fprintf(out, \"\\nre-run with --yes to write%s\\n\", overwriteHint(dests))\n219\t\t\treturn nil\n220\t\t}\n221\t\n222\t\t// Write path.\n223\t\tif !s.force {\n224\t\t\tfor _, d := range dests {\n225\t\t\t\tif _, statErr := os.Stat(skillFilePath(d.Path)); statErr == nil {\n226\t\t\t\t\treturn fmt.Errorf(\"refusing to overwrite existing skill file: %s (use --force)\", d.Path)\n227\t\t\t\t}\n228\t\t\t}\n229\t\t}\n230\t\tdata := []byte(skillText)\n231\t\tsha := \"sha256:\" + fmt.Sprintf(\"%x\", sha256Sum(data))\n232\t\tvar installs []skillInstall\n233\t\tfor _, d := range dests {\n234\t\t\tabs := skillFilePath(d.Path)\n235\t\t\tif err := os.MkdirAll(filepath.Dir(abs), 0o755); err != nil {\n236\t\t\t\treturn fmt.Errorf(\"create skill dir: %w\", err)\n237\t\t\t}\n238\t\t\tif err := os.WriteFile(abs, data, 0o644); err != nil {\n239\t\t\t\treturn fmt.Errorf(\"write skill: %w\", err)\n240\t\t\t}\n241\t\t\tinstalls = append(installs, skillInstall{Agents: d.Agents, Path: d.Path, ContentSHA: sha})\n242\t\t}\n243\t\tif err := recordSkillDecision(storeDir, skillMemoryRecord{\n244\t\t\tPatternID: cand.ID, Scope: candScope(cand), Status: skillStatusActive, SkillName: name,\n245\t\t\tInstalls: installs, Fingerprint: patternEvidenceFingerprint(taskView(cand)),\n246\t\t\tSupport: cand.Support, Reinforcement: cand.Reinforcement, CreatedAt: now, UpdatedAt: now,\n247\t\t}); err != nil {\n248\t\t\treturn err\n249\t\t}\n250\t\tif s.asJSON {\n251\t\t\treturn writeJSON(cmd, map[string]any{\"task_id\": cand.ID, \"name\": name, \"status\": \"active\", \"installs\": installs})\n252\t\t}\n253\t\tfmt.Fprintf(cmd.OutOrStdout(), \"formed skill %q from %s:\\n\", name, cand.ID)\n254\t\tfor _, in := range installs {\n255\t\t\tfmt.Fprintf(cmd.OutOrStdout(), \"  wrote %s   (%s)\\n\", in.Path, joinMax(in.Agents, 8))\n256\t\t}\n257\t\treturn nil\n258\t}\n259\t\n260\t// renderCandidateEvidence prints the evidence-first approval view: why this is a\n261\t// skill, before the draft. All fields are redacted.\n262\tfunc renderCandidateEvidence(out io.Writer, cand taskCandidate) {\n263\t\tc := redactCandidate(cand)\n264\t\tr := c.Reinforcement\n265\t\tfmt.Fprintf(out, \"Candidate: %s\\n\", c.Label)\n266\t\tfmt.Fprintf(out, \"id %s\\n\", cand.ID)\n267\t\tif c.Repos > 0 {\n268\t\t\tfmt.Fprintf(out, \"Support: %d session(s) across %d repo(s); reinforcement %d↑ %d↓ %d·\\n\", c.Support, c.Repos, r.Success, r.Corrected, r.Neutral)\n269\t\t} else {\n270\t\t\tfmt.Fprintf(out, \"Support: %d session(s) (%d with commands); reinforcement %d↑ %d↓ %d·\\n\", c.Support, c.WithCommands, r.Success, r.Corrected, r.Neutral)\n271\t\t}\n272\t\tif len(c.SampleIntents) > 0 {\n273\t\t\tfmt.Fprintln(out, \"Sample intents:\")\n274\t\t\tfor _, s := range c.SampleIntents {\n275\t\t\t\tfmt.Fprintf(out, \"  - %s\\n\", s)\n276\t\t\t}\n277\t\t}\n278\t\tif len(c.Procedures) > 0 {\n279\t\t\tfmt.Fprintln(out, \"Co-occurring procedure evidence:\")\n280\t\t\tfor _, p := range c.Procedures {\n281\t\t\t\tfmt.Fprintf(out, \"  - %s  (in %d sessions, specificity %.2f)\\n\", joinArrow(p.Commands), p.Count, p.Specificity)\n282\t\t\t}\n283\t\t}\n284\t\tif len(c.MatchingFacts) > 0 {\n285\t\t\tfmt.Fprintln(out, \"Relevant durable facts:\")\n286\t\t\tfor _, f := range c.MatchingFacts {\n287\t\t\t\tfmt.Fprintf(out, \"  - %s\\n\", f)\n288\t\t\t}\n289\t\t}\n290\t\tif len(cand.Examples) > 0 {\n291\t\t\tfmt.Fprintln(out, \"Source anchors:\")\n292\t\t\tfor _, a := range cand.Examples {\n293\t\t\t\tfmt.Fprintf(out, \"  - %s:%d\\n\", redactText(a.Path), a.Line)\n294\t\t\t}\n295\t\t}\n296\t}\n297\t\n298\tfunc joinArrow(cmds []string) string {\n299\t\tout := \"\"\n300\t\tfor i, c := range cmds {\n301\t\t\tif i > 0 {\n302\t\t\t\tout += \" → \"\n303\t\t\t}\n304\t\t\tout += c\n305\t\t}\n306\t\treturn out\n307\t}\n308\t\n309\t// candScope reports the scope of a task candidate for skill-memory.\n310\tfunc candScope(c taskCandidate) string {\n311\t\tif c.Workspace != \"\" {\n312\t\t\treturn \"workspace\"\n313\t\t}\n314\t\treturn \"repo\"\n315\t}\n316\t\n317\t// taskView adapts a task candidate to a patternView for fingerprinting/skill memory.\n318\tfunc taskView(c taskCandidate) patternView {\n319\t\tr := c.Reinforcement\n320\t\treturn patternView{ID: c.ID, Type: \"task\", Scope: candScope(c), Title: c.Label,\n321\t\t\tStrength: c.Strength, StrengthLabel: c.StrengthLabel, Support: c.Support, Reinforcement: &r}\n322\t}\n323\t\n324\tfunc joinMax(items []string, n int) string {\n325\t\tif len(items) > n {\n326\t\t\titems = items[:n]\n327\t\t}\n328\t\tout := \"\"\n329\t\tfor i, s := range items {\n330\t\t\tif i > 0 {\n331\t\t\t\tout += \", \"\n332\t\t\t}\n333\t\t\tout += s\n334\t\t}\n335\t\treturn out\n336\t}\n337\t"}]},"uuid":"45a12fa4-14c9-4cb3-b2a4-9e13ca99f12e","timestamp":"2026-06-17T16:22:34.401Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/suhaan/Documents/Coding/entire-brain/internal/cli/skill_cmd.go","content":"package cli\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"time\"\n\n\t\"github.com/spf13/cobra\"\n)\n\n// `patterns skills` — the real skill surface (Phase 2 redo). It lists recurring\n// task candidates and synthesizes an actual SKILL.md from one via an agent,\n// gated on non-obviousness. This supersedes the command-n-gram procedure listing\n// as the source of skills.\n\nfunc newPatternsSkillsCommand(opts Options) *cobra.Command {\n\tvar (\n\t\tasJSON bool\n\t\tlimit  int\n\t)\n\tcmd := &cobra.Command{\n\t\tUse:   \"skills [path]\",\n\t\tShort: \"List recurring task candidates that can be synthesized into skills\",\n\t\tArgs:  cobra.MaximumNArgs(1),\n\t\tRunE: func(cmd *cobra.Command, args []string) error {\n\t\t\treturn runPatternsSkillsList(cmd.Context(), cmd, opts, targetFromArgs(opts, args), asJSON, limit)\n\t\t},\n\t}\n\tcmd.Flags().BoolVar(&asJSON, \"json\", false, \"Emit task candidates as JSON\")\n\tcmd.Flags().IntVar(&limit, \"limit\", 20, \"Maximum candidates to show\")\n\tcmd.AddCommand(newPatternsSkillsFormCommand(opts))\n\treturn cmd\n}\n\nfunc newPatternsSkillsFormCommand(opts Options) *cobra.Command {\n\tvar s skillFormOptions\n\tcmd := &cobra.Command{\n\t\tUse:   \"form <task-id> [path]\",\n\t\tShort: \"Synthesize a SKILL.md from a task candidate (previews until --yes)\",\n\t\tArgs:  cobra.RangeArgs(1, 2),\n\t\tRunE: func(cmd *cobra.Command, args []string) error {\n\t\t\ttarget := targetFromArgs(opts, nil)\n\t\t\tif len(args) == 2 {\n\t\t\t\ttarget = args[1]\n\t\t\t}\n\t\t\ts.taskID = args[0]\n\t\t\treturn runPatternsSkillsForm(cmd.Context(), cmd, opts, target, s)\n\t\t},\n\t}\n\tcmd.Flags().StringVar(&s.name, \"name\", \"\", \"Override the skill name (default: from the synthesized frontmatter)\")\n\tcmd.Flags().StringVar(&s.target, \"target\", \"standard\", \"Install target: standard|claude-code|codex|factoryai-droid|all\")\n\tcmd.Flags().StringVar(&s.scope, \"scope\", \"global\", \"Install scope: global|repo\")\n\tcmd.Flags().StringVar(&s.agent, \"agent\", \"auto\", \"Synthesis agent: auto|codex|claude-code\")\n\tcmd.Flags().StringVar(&s.model, \"model\", \"\", \"Override the agent model\")\n\tcmd.Flags().StringVar(&s.effort, \"effort\", \"\", \"Override the agent reasoning effort\")\n\tcmd.Flags().BoolVar(&s.yes, \"yes\", false, \"Write the synthesized skill files\")\n\tcmd.Flags().BoolVar(&s.force, \"force\", false, \"Overwrite an existing skill file\")\n\tcmd.Flags().BoolVar(&s.draftOnly, \"draft-only\", false, \"Print the synthesized SKILL.md without writing\")\n\tcmd.Flags().BoolVar(&s.asJSON, \"json\", false, \"Emit the result as JSON\")\n\treturn cmd\n}\n\ntype skillFormOptions struct {\n\ttaskID    string\n\tname      string\n\ttarget    string\n\tscope     string\n\tagent     string\n\tmodel     string\n\teffort    string\n\tyes       bool\n\tforce     bool\n\tdraftOnly bool\n\tasJSON    bool\n}\n\nfunc runPatternsSkillsList(ctx context.Context, cmd *cobra.Command, opts Options, target string, asJSON bool, limit int) error {\n\tbrainDir, err := resolvePatternsBrainDir(ctx, opts, target)\n\tif err != nil {\n\t\treturn err\n\t}\n\t// V2 corpus is the primary source; legacy task JSON is the fallback.\n\ttasks, corpusBacked := loadCorpusTaskCandidates(brainDir)\n\tif !corpusBacked {\n\t\tif tasks, err = loadBrainTasks(brainDir); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\t// Suppress already-formed-and-current / declined-unchanged candidates.\n\ttasks = filterSkillCandidatesByMemory(brainDir, tasks)\n\tif limit > 0 && len(tasks) > limit {\n\t\ttasks = tasks[:limit]\n\t}\n\tif asJSON {\n\t\tredacted := make([]taskCandidate, len(tasks))\n\t\tfor i, t := range tasks {\n\t\t\tredacted[i] = redactCandidate(t)\n\t\t}\n\t\treturn writeJSON(cmd, redacted)\n\t}\n\tout := cmd.OutOrStdout()\n\tif len(tasks) == 0 {\n\t\tfmt.Fprintln(out, \"no task candidates (run `entire brain patterns refresh`)\")\n\t\treturn nil\n\t}\n\tfor _, t := range tasks {\n\t\tr := t.Reinforcement\n\t\tfmt.Fprintf(out, \"[%s] %s  (strength %.2f)\\n\", t.StrengthLabel, redactText(t.Label), t.Strength)\n\t\tfmt.Fprintf(out, \"    %d session(s), %d with commands; %d↑ %d↓ %d·; commands: %s\\n\",\n\t\t\tt.Support, t.WithCommands, r.Success, r.Corrected, r.Neutral, redactText(joinMax(t.Commands, 5)))\n\t\tfmt.Fprintf(out, \"    id %s\\n\", t.ID)\n\t}\n\treturn nil\n}\n\nfunc runPatternsSkillsForm(ctx context.Context, cmd *cobra.Command, opts Options, target string, s skillFormOptions) error {\n\trepoDir, local, err := resolveLocalTargetRepoDir(ctx, opts.Runner, target)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif !local {\n\t\treturn fmt.Errorf(\"patterns skills form requires a local repository path: %s\", target)\n\t}\n\tstorage, err := repoStoragePaths(ctx, opts.Runner, opts.Env, repoDir)\n\tif err != nil {\n\t\treturn err\n\t}\n\tbrainDir := storage.BrainDir\n\n\tvar cand *taskCandidate\n\tif c, corpusBacked := corpusTaskCandidateByID(brainDir, s.taskID); corpusBacked {\n\t\tcand = c\n\t} else {\n\t\ttasks, err := loadBrainTasks(brainDir)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tfor i := range tasks {\n\t\t\tif tasks[i].ID == s.taskID {\n\t\t\t\tcand = &tasks[i]\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t}\n\tif cand == nil {\n\t\treturn fmt.Errorf(\"task candidate not found: %s (run `entire brain patterns skills`)\", s.taskID)\n\t}\n\n\tagent := s.agent\n\tif agent == \"\" || agent == \"auto\" {\n\t\tagent = defaultRefreshAgent(ctx, opts.Runner, repoDir)\n\t}\n\tif agent == \"none\" {\n\t\treturn fmt.Errorf(\"skill synthesis requires an agent (codex or claude-code); none found on PATH\")\n\t}\n\treturn synthesizeAndForm(ctx, cmd, *cand, brainDir, repoDir, agent, defaultDistillAgentRunner(agent), s, opts.Now().UTC())\n}\n\n// synthesizeAndForm is the single skill-creation path (repo and workspace):\n// synthesize via the agent, reject NOT_A_SKILL, then show evidence + draft and\n// stop unless --yes. All evidence/draft egress is redacted. storeDir is where the\n// skill-memory decision is recorded. run is injected so tests can stub the agent.\nfunc synthesizeAndForm(ctx context.Context, cmd *cobra.Command, cand taskCandidate, storeDir, repoDir, agent string, run distillAgentRunner, s skillFormOptions, now time.Time) error {\n\tfmt.Fprintf(cmd.ErrOrStderr(), \"synthesizing skill from %d sessions via %s…\\n\", cand.Support, agent)\n\tres, err := synthesizeSkill(ctx, repoDir, storeDir, cand, agent, s.model, s.effort, run)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif !res.IsSkill {\n\t\tif s.asJSON {\n\t\t\treturn writeJSON(cmd, map[string]any{\"task_id\": cand.ID, \"is_skill\": false, \"reason\": res.Reason})\n\t\t}\n\t\tfmt.Fprintf(cmd.OutOrStdout(), \"not a skill: %s\\n\", res.Reason)\n\t\treturn nil\n\t}\n\tname := s.name\n\tif name == \"\" {\n\t\tname = res.Name\n\t}\n\tif name == \"\" {\n\t\tname = \"skill\"\n\t}\n\tskillText := redactText(res.SkillText)\n\n\tif s.draftOnly {\n\t\tif s.asJSON {\n\t\t\treturn writeJSON(cmd, map[string]any{\"task_id\": cand.ID, \"is_skill\": true, \"name\": name, \"skill\": skillText})\n\t\t}\n\t\tfmt.Fprintln(cmd.OutOrStdout(), skillText)\n\t\treturn nil\n\t}\n\n\tdests, err := skillDestinations(s.target, s.scope, name, repoDir)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\t// Evidence-first preview (Priority 6): show WHY this is a skill, then the\n\t// draft and the exact would-write destinations. Nothing is written.\n\tif !s.yes {\n\t\tif s.asJSON {\n\t\t\treturn writeJSON(cmd, map[string]any{\n\t\t\t\t\"task_id\": cand.ID, \"is_skill\": true, \"name\": name,\n\t\t\t\t\"evidence\": redactCandidate(cand), \"skill\": skillText, \"would_write\": dests,\n\t\t\t})\n\t\t}\n\t\tout := cmd.OutOrStdout()\n\t\trenderCandidateEvidence(out, cand)\n\t\tfmt.Fprintln(out, \"\\n--- proposed SKILL.md ---\")\n\t\tfmt.Fprintln(out, skillText)\n\t\tfmt.Fprintln(out, \"\\nwould write to:\")\n\t\tfor _, d := range dests {\n\t\t\tfmt.Fprintf(out, \"  %s   (%s)\\n\", d.Path, joinMax(d.Agents, 8))\n\t\t}\n\t\tfmt.Fprintf(out, \"\\nre-run with --yes to write%s\\n\", overwriteHint(dests))\n\t\treturn nil\n\t}\n\n\t// Write path.\n\tif !s.force {\n\t\tfor _, d := range dests {\n\t\t\tif _, statErr := os.Stat(skillFilePath(d.Path)); statErr == nil {\n\t\t\t\treturn fmt.Errorf(\"refusing to overwrite existing skill file: %s (use --force)\", d.Path)\n\t\t\t}\n\t\t}\n\t}\n\tdata := []byte(skillText)\n\tsha := \"sha256:\" + fmt.Sprintf(\"%x\", sha256Sum(data))\n\tvar installs []skillInstall\n\tfor _, d := range dests {\n\t\tabs := skillFilePath(d.Path)\n\t\tif err := os.MkdirAll(filepath.Dir(abs), 0o755); err != nil {\n\t\t\treturn fmt.Errorf(\"create skill dir: %w\", err)\n\t\t}\n\t\tif err := os.WriteFile(abs, data, 0o644); err != nil {\n\t\t\treturn fmt.Errorf(\"write skill: %w\", err)\n\t\t}\n\t\tinstalls = append(installs, skillInstall{Agents: d.Agents, Path: d.Path, ContentSHA: sha})\n\t}\n\tif err := recordSkillDecision(storeDir, skillMemoryRecord{\n\t\tPatternID: cand.ID, Scope: candScope(cand), Status: skillStatusActive, SkillName: name,\n\t\tInstalls: installs, Fingerprint: patternEvidenceFingerprint(taskView(cand)),\n\t\tSupport: cand.Support, Reinforcement: cand.Reinforcement, CreatedAt: now, UpdatedAt: now,\n\t}); err != nil {\n\t\treturn err\n\t}\n\tif s.asJSON {\n\t\treturn writeJSON(cmd, map[string]any{\"task_id\": cand.ID, \"name\": name, \"status\": \"active\", \"installs\": installs})\n\t}\n\tfmt.Fprintf(cmd.OutOrStdout(), \"formed skill %q from %s:\\n\", name, cand.ID)\n\tfor _, in := range installs {\n\t\tfmt.Fprintf(cmd.OutOrStdout(), \"  wrote %s   (%s)\\n\", in.Path, joinMax(in.Agents, 8))\n\t}\n\treturn nil\n}\n\n// renderCandidateEvidence prints the evidence-first approval view: why this is a\n// skill, before the draft. All fields are redacted.\nfunc renderCandidateEvidence(out io.Writer, cand taskCandidate) {\n\tc := redactCandidate(cand)\n\tr := c.Reinforcement\n\tfmt.Fprintf(out, \"Candidate: %s\\n\", c.Label)\n\tfmt.Fprintf(out, \"id %s\\n\", cand.ID)\n\tif c.Repos > 0 {\n\t\tfmt.Fprintf(out, \"Support: %d session(s) across %d repo(s); reinforcement %d↑ %d↓ %d·\\n\", c.Support, c.Repos, r.Success, r.Corrected, r.Neutral)\n\t} else {\n\t\tfmt.Fprintf(out, \"Support: %d session(s) (%d with commands); reinforcement %d↑ %d↓ %d·\\n\", c.Support, c.WithCommands, r.Success, r.Corrected, r.Neutral)\n\t}\n\tif len(c.SampleIntents) > 0 {\n\t\tfmt.Fprintln(out, \"Sample intents:\")\n\t\tfor _, s := range c.SampleIntents {\n\t\t\tfmt.Fprintf(out, \"  - %s\\n\", s)\n\t\t}\n\t}\n\tif len(c.Procedures) > 0 {\n\t\tfmt.Fprintln(out, \"Co-occurring procedure evidence:\")\n\t\tfor _, p := range c.Procedures {\n\t\t\tfmt.Fprintf(out, \"  - %s  (in %d sessions, specificity %.2f)\\n\", joinArrow(p.Commands), p.Count, p.Specificity)\n\t\t}\n\t}\n\tif len(c.MatchingFacts) > 0 {\n\t\tfmt.Fprintln(out, \"Relevant durable facts:\")\n\t\tfor _, f := range c.MatchingFacts {\n\t\t\tfmt.Fprintf(out, \"  - %s\\n\", f)\n\t\t}\n\t}\n\tif len(cand.Examples) > 0 {\n\t\tfmt.Fprintln(out, \"Source anchors:\")\n\t\tfor _, a := range cand.Examples {\n\t\t\tfmt.Fprintf(out, \"  - %s:%d\\n\", redactText(a.Path), a.Line)\n\t\t}\n\t}\n}\n\nfunc joinArrow(cmds []string) string {\n\tout := \"\"\n\tfor i, c := range cmds {\n\t\tif i > 0 {\n\t\t\tout += \" → \"\n\t\t}\n\t\tout += c\n\t}\n\treturn out\n}\n\n// candScope reports the scope of a task candidate for skill-memory.\nfunc candScope(c taskCandidate) string {\n\tif c.Workspace != \"\" {\n\t\treturn \"workspace\"\n\t}\n\treturn \"repo\"\n}\n\n// taskView adapts a task candidate to a patternView for fingerprinting/skill memory.\nfunc taskView(c taskCandidate) patternView {\n\tr := c.Reinforcement\n\treturn patternView{ID: c.ID, Type: \"task\", Scope: candScope(c), Title: c.Label,\n\t\tStrength: c.Strength, StrengthLabel: c.StrengthLabel, Support: c.Support, Reinforcement: &r}\n}\n\nfunc joinMax(items []string, n int) string {\n\tif len(items) > n {\n\t\titems = items[:n]\n\t}\n\tout := \"\"\n\tfor i, s := range items {\n\t\tif i > 0 {\n\t\t\tout += \", \"\n\t\t}\n\t\tout += s\n\t}\n\treturn out\n}\n","numLines":337,"startLine":1,"totalLines":337}},"sourceToolAssistantUUID":"5b16c05d-09c3-4df3-abe1-4a69c7eed21b","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/Documents/Coding/entire-brain","sessionId":"af861ed9-9e1d-41a7-8400-b53c2995aed8","version":"2.1.177","gitBranch":"claude/patterns-v2-corpus","slug":"zippy-floating-lovelace"}
