tPath)\n513:\t\treturn fmt.Errorf(\"active semantic snapshot must be a file: %s\", source.SnapshotPath)\n532:\t\treturn fmt.Errorf(\"semantic snapshot path has no generation id: %s\", source.SnapshotPath)\n554:\tfmt.Fprintf(cmd.OutOrStdout(), \"snapshot: %s\\n\", source.SnapshotPath)\n948:func newSemanticScanner(r io.Reader) *bufio.Scanner {\n2077:\tif source.SnapshotPath == \"\" {\n2079:\t} else if _, err := validateSemanticSnapshotPath(source.SnapshotPath); err != nil {\n=== historySourceManifest fields ===\n51:type historySourceManifest struct {\n52-\tGeneratedAt         time.Time `json:\"generated_at\"`\n53-\tIndexPath           string    `json:\"index_path\"`\n54-\tSessionsFingerprint string    `json:\"sessions_fingerprint,omitempty\"`\n55-\tRecords             int       `json:\"records\"`\n56-\tDecisions           int       `json:\"decisions\"`\n57-\tLearnings           int       `json:\"learnings\"`\n58-\tValidations         int       `json:\"validations\"`\n59-\tToolCalls           int       `json:\"tool_calls\"`\n60-\tCodeFacts           int       `json:\"code_facts\"`\n61-\tWarnings            []string  `json:\"warnings,omitempty\"`\n62-}\n63-\n=== factSourceManifest ByKind etc ===\n42:type factSourceManifest struct {\n43-\tGeneratedAt       time.Time      `json:\"generated_at\"`\n44-\tTaxonomyPath      string         `json:\"taxonomy_path\"`\n45-\tBranches          []string       `json:\"branches,omitempty\"`\n46-\tFacts             int            `json:\"facts\"`\n47-\tDistilled         int            `json:\"distilled\"`\n48-\tAuthored          int            `json:\"authored\"`\n49-\tSuperseded        int            `json:\"superseded\"`\n50-\tProposals         int            `json:\"proposals\"`","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"33b7f168-7de3-456e-9bb9-660f84fc15c6","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/Documents/Coding/entire-brain/internal/cli","sessionId":"a