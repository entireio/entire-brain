t ./internal/cli -run 'TestReachableCheckpointRoutesToDefaultBranchFolder'\"\n  ],\n  \"validation_files\": [\n    {\n      \"path\": \"internal/cli/zz_contract_validation_test.go\",\n      \"content\": \"package cli\\n\\nimport (\\n\\t\\\"testing\\\"\\n\\t\\\"time\\\"\\n)\\n\\nfunc TestReachableCheckpointRoutesToDefaultBranchFolder(t *testing.T) {\\n\\tselected := map[string]selectedSession{}\\n\\tdestinations := checkpointBranchDestinations{\\n\\t\\tDefaultBranch: \\\"main\\\",\\n\\t\\tDefaultCheckpointIDs: map[string]struct{}{\\n\\t\\t\\t\\\"aaa111aaa111\\\": {},\\n\\t\\t},\\n\\t}\\n\\n\\taddSelectedSession(selected, selectedSession{\\n\\t\\tCheckpointID: \\\"aaa111aaa111\\\",\\n\\t\\tSessionID:    \\\"session-one\\\",\\n\\t\\tBranch:       \\\"feature/already-merged\\\",\\n\\t\\tCreatedAt:    time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC),\\n\\t}, destinations)\\n\\n\\tsession, ok := selected[selectedSessionKey(\\\"main\\\", \\\"session-one\\\")]\\n\\tif !ok {\\n\\t\\tt.Fatalf(\\\"reachable checkpoint was not routed to the default branch folder: %+v\\\", selected)\\n\\t}\\n\\tif session.Branch != \\\"main\\\" {\\n\\t\\tt.Fatalf(\\\"destination branch = %q, want main\\\", session.Branch)\\n\\t}\\n\\tif session.SourceBranch != \\\"feature/already-merged\\\" {\\n\\t\\tt.Fatalf(\\\"source branch = %q, want the original feature branch preserved\\\", session.SourceBranch)\\n\\t}\\n\\tif _, leaked := selected[selectedSessionKey(\\\"feature/already-merged\\\", \\\"session-one\\\")]; leaked {\\n\\t\\tt.Fatalf(\\\"reachable checkpoint must not also land in its recorded feature-branch folder: %+v\\\", selected)\\n\\t}\\n}\\n\"\n    }\n  ],\n  \"expected_files\": [\n    \"internal/cli/export.go\"\n  ],\n  \"forbidden_files\": [\n    \"go.mod\",\n    \"go.sum\"\n  ],\n  \"hide_expected_from_agent\": true,\n  \"hide_validation_from_agent\": true,\n  \"leak_markers\": [\n    \"go test ./internal/cli -run 'TestReachableCheckpointRoutesToDefaultBranchFolder'\"\n  ],\n  \"agent_hidd