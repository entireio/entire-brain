  fi\ndone\n'''\n\n[tasks.\"release:matrix:update\"]\ndescription = \"Regenerate retained release-readiness matrix reports after the evidence gate passes\"\nrun = '''\nset -e\nmanifest=\"benchmarks/agent-brain/evidence/release-matrix/manifest.json\"\nif [ ! -f \"$manifest\" ]; then\n  echo \"release matrix manifest is missing: $manifest\" >&2\n  echo \"retain a release matrix before citing aggregate release-readiness status\" >&2\n  exit 1\nfi\ntmp=\"$(mktemp -d)\"\ntrap 'rm -rf \"$tmp\"' EXIT\npython3 benchmarks/agent-brain/audit_release_matrix.py \\\n  --manifest \"$manifest\" \\\n  --out-dir \"$tmp\" \\\n  --fail-on-flags\nmkdir -p benchmarks/agent-brain/evidence/release-matrix\ncp \"$tmp\"/release-matrix-report.json \"$tmp\"/release-matrix-report.md benchmarks/agent-brain/evidence/release-matrix/\n'''\n\n[tasks.\"release:readiness\"]\ndescription = \"Run the full local release-readiness gate, including retained evidence checks\"\nrun = '''\nset +e\nfailures=0\nfailed=\"\"\nfor task in check release:evidence radar:evidence radar:agent-evidence workspace-radar:evidence distill:evidence facts:evidence semantic:evidence release:matrix; do\n  echo \"==> mise run $task\"\n  mise run \"$task\"\n  rc=$?\n  if [ \"$rc\" -eq 0 ]; then\n    echo \"PASS $task\"\n  else\n    echo \"FAIL $task (exit $rc)\" >&2\n    failures=$((failures + 1))\n    failed=\"${failed}${failed:+, }$task\"\n  fi\ndone\nif [ \"$failures\" -ne 0 ]; then\n  echo \"release readiness failed: $failed\" >&2\n  exit 1\nfi\necho \"release readiness passed\"\n'''\n\n[tasks.build]\ndescription = \"Build the plugin binary (pure-Go fallback stack)\"\nrun = \"go build -o entire-brain ./cmd/entire-brain\"\n\n[tasks.\"build:cgo\"]\ndescription = \"Build the Stage 1b cgo stack (mattn + sqlite-vec vec0 + FTS5)\"\nrun = \"CGO_ENABLED=1 go build -tags 'brain_cgo sqlite_fts5' -o entire-brain ./cmd/entire-brain\"","numLines":170,"startLine":306,"totalLines":493}},"sourceToolAssistantUUID":"5863820e-e302-4e9c-bd1c-32351