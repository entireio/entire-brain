{"parentUuid":"4906060b-a5e9-479f-86b1-b3d6e85d9357","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/suhaan/Documents/Coding/entire-brain/internal/cli/root.go","snippet":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"os\"\n9\t\t\"reflect\"\n10\t\t\"regexp\"\n11\t\t\"strings\"\n12\t\t\"time\"\n13\t\n14\t\t\"github.com/spf13/cobra\"\n15\t)\n16\t\n17\ttype Options struct {\n18\t\tVersion string\n19\t\tEnv     EntireEnv\n20\t\tRunner  CommandRunner\n21\t\tNow     func() time.Time\n22\t}\n23\t\n24\t// Execute runs the plugin root command with the real process environment.\n25\tfunc Execute(version string) error {\n26\t\tcmd := NewRootCommand(Options{\n27\t\t\tVersion: version,\n28\t\t\tEnv:     EnvFromOS(),\n29\t\t})\n30\t\terr := cmd.Execute()\n31\t\tif err != nil && commandErrorWasRendered(err) {\n32\t\t\treturn err\n33\t\t}\n34\t\treturn err\n35\t}\n36\t\n37\tfunc NewRootCommand(opts Options) *cobra.Command {\n38\t\tif opts.Version == \"\" {\n39\t\t\topts.Version = \"dev\"\n40\t\t}\n41\t\tif opts.Runner == nil {\n42\t\t\topts.Runner = ExecRunner{}\n43\t\t}\n44\t\tif opts.Now == nil {\n45\t\t\topts.Now = time.Now\n46\t\t}\n47\t\n48\t\tcmd := &cobra.Command{\n49\t\t\tUse:           \"entire-brain\",\n50\t\t\tShort:         \"Build and query a local repository brain for agents\",\n51\t\t\tSilenceUsage:  true,\n52\t\t\tSilenceErrors: true,\n53\t\t\tLong: `entire-brain is an external-command plugin for the Entire CLI.\n54\t\n55\tIt builds a local, inspectable repository brain from retained sessions, seed\n56\tcontext, docs, history, semantic records, and durable facts, then exposes\n57\tretrieval, verification, evaluation, and MCP surfaces for agents.`,\n58\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n59\t\t\t\treturn cmd.Help()\n60\t\t\t},\n61\t\t}\n62\t\n63\t\t// The shell-completion generator targets the standalone binary name and is\n64\t\t// dead weight when dispatched as `entire brain`, so drop it entirely.\n65\t\tcmd.CompletionOptions.DisableDefaultCmd = true\n66\t\n67\t\tcmd.AddGroup(\n68\t\t\t&cobra.Group{ID: \"create\", Title: \"Create the brain:\"},\n69\t\t\t&cobra.Group{ID: \"explore\", Title: \"Explore the brain:\"},\n70\t\t\t&cobra.Group{ID: \"maintain\", Title: \"Maintain & share:\"},\n71\t\t)\n72\t\n73\t\taddGrouped := func(group string, c *cobra.Command) {\n74\t\t\tc.GroupID = group\n75\t\t\tcmd.AddCommand(c)\n76\t\t}\n77\t\t// addHidden registers commands kept out of help but still invocable: the\n78\t\t// Entire CLI host / MCP clients drive some programmatically, and the rest\n79\t\t// are redundant aliases fully covered by `search` and `inspect <sub>`.\n80\t\taddHidden := func(c *cobra.Command) {\n81\t\t\tc.Hidden = true\n82\t\t\tcmd.AddCommand(c)\n83\t\t}\n84\t\n85\t\t// Create the brain — locate it, build/refresh it, manage workspaces.\n86\t\taddGrouped(\"create\", newPathCommand(opts))\n87\t\taddGrouped(\"create\", newRefreshCommand(opts))\n88\t\taddGrouped(\"create\", newWatchCommand(opts))\n89\t\taddGrouped(\"create\", newDistillCommand(opts))\n90\t\taddGrouped(\"create\", newRememberCommand(opts))\n91\t\taddGrouped(\"create\", newPatternsCommand(opts))\n92\t\taddGrouped(\"create\", newAgentStatusCommand(opts))\n93\t\taddGrouped(\"create\", newWorkspaceCommand(opts))\n94\t\n95\t\t// Explore the brain — task packets, search, records, specialist inspection.\n96\t\taddGrouped(\"explore\", newBrainOverviewCommand(opts))\n97\t\taddGrouped(\"explore\", newBrainBriefCommand(opts))\n98\t\taddGrouped(\"explore\", newBrainGuideCommand())\n99\t\taddGrouped(\"explore\", newBrainInspectCommand(opts))\n100\t\taddGrouped(\"explore\", newMCPCommand(opts))\n101\t\taddGrouped(\"explore\", newRecallCommand(opts))\n102\t\taddGrouped(\"explore\", newVerifyCommand(opts))\n103\t\t// qmd-inspired retrieval over the unified text index (facts + history + docs).\n104\t\t// Symbol/code search stays at `inspect code`.\n105\t\taddGrouped(\"explore\", newQueryCommand(opts))\n106\t\taddGrouped(\"explore\", newSearchCommand(opts))\n107\t\taddGrouped(\"explore\", newVsearchCommand(opts))\n108\t\taddGrouped(\"explore\", newGetCommand(opts))\n109\t\taddGrouped(\"explore\", newMultiGetCommand(opts))\n110\t\taddGrouped(\"explore\", newBrainShowCommand(opts))\n111\t\n112\t\t// Maintain & share — freshness, cleanup, portability, version.\n113\t\t// (Build stages live under `refresh`: sessions, index, seed.)\n114\t\taddGrouped(\"maintain\", newSemanticBundleCommand(opts))\n115\t\taddGrouped(\"maintain\", newFactsCommand(opts))\n116\t\taddGrouped(\"maintain\", newSemanticGCCommand(opts))\n117\t\taddGrouped(\"maintain\", newSemanticRepairCommand(opts))\n118\t\taddGrouped(\"maintain\", newSemanticResetCommand(opts))\n119\t\taddGrouped(\"maintain\", newVersionCommand(opts.Version))\n120\t\n121\t\t// Hidden: `review` is the machine contract `entire review`'s diff-less mode shells\n122\t\t// (`entire-brain review --json`), NOT a human-facing verb — the human\n123\t\t// review surface is `entire review` in the cli, not a standalone brain command.\n124\t\taddHidden(newBrainReviewCommand(opts))\n125\t\n126\t\t// Hidden plugin/config commands.\n127\t\taddHidden(newDoctorCommand(opts))\n128\t\taddHidden(newConfigCommand(opts.Env))\n129\t\n130\t\t// Hidden measurement harness for the history retrieval layer (the facts\n131\t\t// analog lives under `facts eval`/`eval-gen`; summaries are compatible with\n132\t\t// `facts eval-compare`). Developer tooling, not agent surface.\n133\t\taddHidden(newHistoryEvalGenCommand(opts))\n134\t\taddHidden(newHistoryEvalCommand(opts))\n135\t\n136\t\t// Hidden agent-harness hook surface (Phase 2 item 2): wired into hooks by\n137\t\t// the harness (Claude Code, Entire CLI), not invoked by humans or agents.\n138\t\taddHidden(newHookCommand(opts))\n139\t\n140\t\tcmd.SetHelpCommandGroupID(\"maintain\")\n141\t\n142\t\twrapJSONErrorRendering(cmd)\n143\t\treturn cmd\n144\t}\n145\t\n146\ttype commandJSONError struct {\n147\t\tCode    string `json:\"code\"`\n148\t\tMessage string `json:\"message\"`\n149\t}\n150\t\n151\ttype renderedCommandError struct {\n152\t\terr error\n153\t}\n154\t\n155\tvar errRenderedCommand = renderedCommandError{}\n156\t\n157\tfunc RenderedError() error {\n158\t\treturn errRenderedCommand\n159\t}\n160\t\n161\tfunc (e renderedCommandError) Error() string {\n162\t\tif e.err == nil {\n163\t\t\treturn \"command error rendered\"\n164\t\t}\n165\t\treturn e.err.Error()\n166\t}\n167\t\n168\tfunc (e renderedCommandError) Unwrap() error {\n169\t\treturn e.err\n170\t}\n171\t\n172\tfunc (e renderedCommandError) Is(target error) bool {\n173\t\t_, ok := target.(renderedCommandError)\n174\t\treturn ok\n175\t}\n176\t\n177\tfunc commandErrorWasRendered(err error) bool {\n178\t\tvar rendered renderedCommandError\n179\t\treturn errors.As(err, &rendered)\n180\t}\n181\t\n182\tfunc wrapJSONErrorRendering(cmd *cobra.Command) {\n183\t\tif cmd.Args != nil {\n184\t\t\targsFunc := cmd.Args\n185\t\t\tcmd.Args = func(cmd *cobra.Command, args []string) error {\n186\t\t\t\terr := argsFunc(cmd, args)\n187\t\t\t\tif err == nil || !commandWantsJSONError(cmd) {\n188\t\t\t\t\treturn err\n189\t\t\t\t}\n190\t\t\t\t_ = writeCommandJSONError(cmd.ErrOrStderr(), err)\n191\t\t\t\treturn renderedCommandError{err: err}\n192\t\t\t}\n193\t\t}\n194\t\tif cmd.RunE != nil {\n195\t\t\trun := cmd.RunE\n196\t\t\tcmd.RunE = func(cmd *cobra.Command, args []string) error {\n197\t\t\t\terr := run(cmd, args)\n198\t\t\t\tif err == nil || !commandWantsJSONError(cmd) {\n199\t\t\t\t\treturn err\n200\t\t\t\t}\n201\t\t\t\tif commandErrorWasRendered(err) {\n202\t\t\t\t\treturn err\n203\t\t\t\t}\n204\t\t\t\t_ = writeCommandJSONError(cmd.ErrOrStderr(), err)\n205\t\t\t\treturn renderedCommandError{err: err}\n206\t\t\t}\n207\t\t}\n208\t\tcmd.SetFlagErrorFunc(func(cmd *cobra.Command, err error) error {\n209\t\t\tif !commandWantsJSONError(cmd) {\n210\t\t\t\treturn err\n211\t\t\t}\n212\t\t\t_ = writeCommandJSONError(cmd.ErrOrStderr(), err)\n213\t\t\treturn renderedCommandError{err: err}\n214\t\t})\n215\t\tfor _, child := range cmd.Commands() {\n216\t\t\twrapJSONErrorRendering(child)\n217\t\t}\n218\t}\n219\t\n220\tfunc commandWantsJSONError(cmd *cobra.Command) bool {\n221\t\tif flag := cmd.Flags().Lookup(\"format\"); flag != nil && flag.Changed {\n222\t\t\tif wants, ok := commandFormatFlagWantsJSON(flag.Value.String()); ok {\n223\t\t\t\treturn wants\n224\t\t\t}\n225\t\t}\n226\t\tif flag := cmd.InheritedFlags().Lookup(\"format\"); flag != nil && flag.Changed {\n227\t\t\tif wants, ok := commandFormatFlagWantsJSON(flag.Value.String()); ok {\n228\t\t\t\treturn wants\n229\t\t\t}\n230\t\t}\n231\t\tif wants, ok := commandRawFormatWantsJSON(append(cmd.Flags().Args(), commandRawArgs(cmd)...)); ok {\n232\t\t\treturn wants\n233\t\t}\n234\t\tif flag := cmd.Flags().Lookup(\"json\"); flag != nil && flag.Changed {\n235\t\t\treturn commandJSONFlagEnabled(flag.Value.String())\n236\t\t}\n237\t\tif flag := cmd.InheritedFlags().Lookup(\"json\"); flag != nil && flag.Changed {\n238\t\t\treturn commandJSONFlagEnabled(flag.Value.String())\n239\t\t}\n240\t\tfor _, arg := range append(cmd.Flags().Args(), commandRawArgs(cmd)...) {\n\n... [88 lines truncated] ..."},"type":"attachment","uuid":"0130a863-2bd3-4e35-bf6b-bf74d1e816da","timestamp":"2026-06-17T16:22:03.822Z","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/Documents/Coding/entire-brain","sessionId":"af861ed9-9e1d-41a7-8400-b53c2995aed8","version":"2.1.177","gitBranch":"claude/brain-dash-tui","slug":"zippy-floating-lovelace"}
