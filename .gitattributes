# Embedded template assets are compiled into the binary via go:embed, so their
# bytes must be identical on every platform. Force LF so a Windows checkout does
# not turn them into CRLF (which leaked a stray "\r" into the distill prompt).
templates/** text eol=lf

# Golden byte fixtures are compared exactly in tests and must remain stable on
# Windows checkouts too.
# Every golden, wherever it lives. Pinning only internal/cli's left
# internal/setupui/testdata/pipe.golden unpinned, so a Windows checkout turned
# it into CRLF while the generated output stayed LF and the byte comparison
# failed. A path-specific rule only protects the directory someone remembered.
*.golden text eol=lf
*.golden* text eol=lf
internal/cli/testdata/*.golden* text eol=lf

# render_json_contract_test.go round-trips these through json.Marshal (always LF)
# and compares bytes; a Windows checkout without this pin gets CRLF and fails the
# contract test on content it never actually changed.
internal/cli/testdata/render/*.json text eol=lf

# Unified-diff context markers intentionally put one space before tab-indented
# source. Do not report that patch syntax as a whitespace defect in outer diffs.
*.patch -whitespace
