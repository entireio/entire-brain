t.go-184-// unsatisfied gate and every missing target field refuses BEFORE any HTTP request.\ninternal/cli/facts_proposals_cmd_test.go-185-func TestFactsProposalsRefusesWithoutGates(t *testing.T) {\ninternal/cli/facts_proposals_cmd_test.go-186-\tfor _, tc := range []struct {\ninternal/cli/facts_proposals_cmd_test.go-187-\t\tname string\ninternal/cli/facts_proposals_cmd_test.go-188-\t\tenv  map[string]string\ninternal/cli/facts_proposals_cmd_test.go-189-\t\targs []string\ninternal/cli/facts_proposals_cmd_test.go-190-\t\twant string","is_error":false}]},"uuid":"8a6c7332-b68b-40b7-8c2f-93631544da5d","timestamp":"2026-08-17T14:26:34.585Z","toolUseResult":{"stdout":"internal/cli/facts_proposals_cmd_test.go:145:func newHostedProposalsFixture(t *testing.T) (verifyFixture, *hostedProposalsFake, factsync.OpenProposal) {\n=== fixture + fake server shape ===\ninternal/cli/facts_proposals_cmd_test.go:145:func newHostedProposalsFixture(t *testing.T) (verifyFixture, *hostedProposalsFake, factsync.OpenProposal) {\ninternal/cli/facts_proposals_cmd_test.go-146-\tt.Helper()\ninternal/cli/facts_proposals_cmd_test.go-147-\tf := newVerifyFixture(t)\ninternal/cli/facts_proposals_cmd_test.go-148-\tnow := f.now\ninternal/cli/facts_proposals_cmd_test.go-149-\ninternal/cli/facts_proposals_cmd_test.go-150-\tpaths := normalizeFactPaths([]string{\"ops.deploy.strategy\"})\ninternal/cli/facts_proposals_cmd_test.go-151-\ttarget := factRecord{\ninternal/cli/facts_proposals_cmd_test.go-152-\t\tID: factRecordID(\"deploys use blue-green cutover\", paths), Paths: paths,\ninternal/cli/facts_proposals_cmd_test.go-153-\t\tText: \"deploys use blue-green cutover\", Branch: \"main\", Origin: factOriginDistilled, Status: factStatusActive,\ninternal/cli/facts_proposals_cmd_test.go-154-\t\tProvenance: []factAnchor{{SessionID: \"session-A\"}}, CreatedAt: now, UpdatedAt: now,\ninternal/cli/facts_proposals_cmd_test.go-155-\t}\ninternal/cli/facts_proposals_cmd_test.go-156-\tcandidate := factRecord{\ninternal/cli/fa