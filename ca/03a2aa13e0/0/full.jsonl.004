{"parentUuid":"407a94be-51e3-4a8f-9ca6-0f923d30bf86","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/suhaan/devenv/p0p1/p1-new/internal/factsync/httpproposals.go","snippet":"1\tpackage factsync\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"context\"\n6\t\t\"encoding/json\"\n7\t\t\"fmt\"\n8\t\t\"net/http\"\n9\t\t\"net/url\"\n10\t\t\"strings\"\n11\t\n12\t\t\"github.com/ashtom/entire-brain/internal/factmerge\"\n13\t)\n14\t\n15\t// HTTPServer also drives the OPEN-PROPOSAL SET endpoints, symmetric with the fact-set\n16\t// head endpoints in httpserver.go:\n17\t//\n18\t//\tGET  {BaseURL}/api/v1/repos/{repoID}/brain/facts/proposals?branch=…       → 200\n19\t//\t     {found, ref, version, proposals:[{id, proposal}]}      (pull-gated)\n20\t//\tGET  {BaseURL}/api/v1/repos/{repoID}/brain/facts/proposals/{id}?branch=…  → 200\n21\t//\t     {found, ref, version, proposal:{id, proposal}}         (pull-gated)\n22\t//\t     404 or found=false → ErrProposalNotFound (already settled / never existed)\n23\t//\tPOST {BaseURL}/api/v1/repos/{repoID}/brain/facts/proposals                → 200\n24\t//\t     {ref, version, changed}                                (push-gated)\n25\t//\t     body {branch, oldRef, proposals}                       (whole-set CAS)\n26\t//\t     412/409 → the set advanced concurrently (→ ErrConflict, re-read + re-union)\n27\t//\tPOST {BaseURL}/api/v1/repos/{repoID}/brain/facts/proposals/{id}/resolve   → 200\n28\t//\t     {factsRef, proposalsRef, changed}                      (push-gated)\n29\t//\t     body {branch, decision, factsOldRef, data(base64), proposalsOldRef, proposals}\n30\t//\t     412/409 → a head advanced concurrently (→ ErrConflict, re-read + re-resolve)\n31\t//\t     404     → the proposal is no longer open (→ ErrProposalNotFound)\n32\t//\n33\t// The resolve body carries the runner-computed result of the merge, never an\n34\t// instruction to merge: `data` is the full resolved fact set (NDJSON, base64 as\n35\t// huma/encoding/json encode a []byte) and `proposals` is the full open set minus the\n36\t// resolved one. The server compare-and-swaps both from the supplied old refs. The\n37\t// `decision` field is informational (audit/telemetry) — the server does not act on it.\n38\t//\n39\t// Egress redaction is applied HERE, at the transport chokepoint, exactly as Sync\n40\t// applies it before pushing merged facts: SanitizeForEgress strips every anchor's\n41\t// local transcript path and line offset, so a resolution can never leak a member's\n42\t// filesystem layout even if a caller hands the client unsanitized records.\n43\t\n44\t// proposalsPath is the collection endpoint for a repo's open proposal set.\n45\tfunc proposalsPath(repoID string) string {\n46\t\treturn fmt.Sprintf(\"/api/v1/repos/%s/brain/facts/proposals\", url.PathEscape(repoID))\n47\t}\n48\t\n49\t// wireProposalSet is the list/get response envelope.\n50\ttype wireProposalSet struct {\n51\t\tFound     bool           `json:\"found\"`\n52\t\tRef       string         `json:\"ref\"`\n53\t\tVersion   int64          `json:\"version\"`\n54\t\tProposals []OpenProposal `json:\"proposals\"`\n55\t\tProposal  *OpenProposal  `json:\"proposal\"`\n56\t}\n57\t\n58\t// ListProposals reads the branch's open proposal set. found=false (no set stored yet)\n59\t// is an EMPTY set, not an error — a branch with no cross-member conflict has nothing\n60\t// to review. Any non-200 is an error: the caller must not resolve against an unknown\n61\t// open set.\n62\tfunc (h *HTTPServer) ListProposals(ctx context.Context, repoID, branch string) (ProposalSet, error) {\n63\t\tpath := proposalsPath(repoID) + \"?branch=\" + url.QueryEscape(branch)\n64\t\treq, err := h.newRequest(ctx, http.MethodGet, path, nil)\n65\t\tif err != nil {\n66\t\t\treturn ProposalSet{}, err\n67\t\t}\n68\t\tresp, err := h.client().Do(req)\n69\t\tif err != nil {\n70\t\t\treturn ProposalSet{}, fmt.Errorf(\"factsync: GET proposals %s/%s: %w\", repoID, branch, err)\n71\t\t}\n72\t\tdefer resp.Body.Close()\n73\t\tswitch resp.StatusCode {\n74\t\tcase http.StatusOK:\n75\t\tcase http.StatusNotFound, http.StatusNotImplemented, http.StatusServiceUnavailable:\n76\t\t\t// 503 is \"this deployment has no queue\", not a transient outage to retry:\n77\t\t\t// entire-api answers it whenever the hosted brain is disabled, the same way its\n78\t\t\t// fact-set endpoints do. Treating it as unsupported degrades to the local review\n79\t\t\t// queue with a warning, which is right for an optional sub-feature — and the\n80\t\t\t// next sync re-checks, so a genuinely transient 503 costs one cycle, never a\n81\t\t\t// failed sync whose head-advance already succeeded.\n82\t\t\treturn ProposalSet{}, fmt.Errorf(\"%w: GET proposals %s/%s: %s\", ErrProposalQueueUnsupported, repoID, branch, resp.Status)\n83\t\tdefault:\n84\t\t\treturn ProposalSet{}, fmt.Errorf(\"factsync: GET proposals %s/%s: unexpected status %s\", repoID, branch, resp.Status)\n85\t\t}\n86\t\tvar out wireProposalSet\n87\t\tif err := json.NewDecoder(resp.Body).Decode(&out); err != nil {\n88\t\t\treturn ProposalSet{}, fmt.Errorf(\"factsync: decode proposals %s/%s: %w\", repoID, branch, err)\n89\t\t}\n90\t\tset := ProposalSet{Branch: branch, Ref: out.Ref, Found: out.Found, Proposals: out.Proposals}\n91\t\t// A server that omits ids (older/looser implementation) still yields addressable\n92\t\t// proposals: the id is content-derived, so recomputing it is always correct.\n93\t\tfor i := range set.Proposals {\n94\t\t\tif set.Proposals[i].ID == \"\" {\n95\t\t\t\tset.Proposals[i].ID = ProposalID(set.Proposals[i].Proposal)\n96\t\t\t}\n97\t\t}\n98\t\treturn set, nil\n99\t}\n100\t\n101\t// GetProposal fetches one open proposal by id. A 404, or a 200 with found=false /\n102\t// no proposal, is ErrProposalNotFound — the normal outcome when another member\n103\t// already settled it.\n104\tfunc (h *HTTPServer) GetProposal(ctx context.Context, repoID, branch, proposalID string) (OpenProposal, error) {\n105\t\tpath := proposalsPath(repoID) + \"/\" + url.PathEscape(proposalID) + \"?branch=\" + url.QueryEscape(branch)\n106\t\treq, err := h.newRequest(ctx, http.MethodGet, path, nil)\n107\t\tif err != nil {\n108\t\t\treturn OpenProposal{}, err\n109\t\t}\n110\t\tresp, err := h.client().Do(req)\n111\t\tif err != nil {\n112\t\t\treturn OpenProposal{}, fmt.Errorf(\"factsync: GET proposal %s/%s/%s: %w\", repoID, branch, proposalID, err)\n113\t\t}\n114\t\tdefer resp.Body.Close()\n115\t\tswitch resp.StatusCode {\n116\t\tcase http.StatusOK:\n117\t\tcase http.StatusNotFound:\n118\t\t\treturn OpenProposal{}, fmt.Errorf(\"%w: %s\", ErrProposalNotFound, proposalID)\n119\t\tdefault:\n120\t\t\treturn OpenProposal{}, fmt.Errorf(\"factsync: GET proposal %s/%s/%s: unexpected status %s\", repoID, branch, proposalID, resp.Status)\n121\t\t}\n122\t\tvar out wireProposalSet\n123\t\tif err := json.NewDecoder(resp.Body).Decode(&out); err != nil {\n124\t\t\treturn OpenProposal{}, fmt.Errorf(\"factsync: decode proposal %s/%s/%s: %w\", repoID, branch, proposalID, err)\n125\t\t}\n126\t\tif !out.Found || out.Proposal == nil {\n127\t\t\treturn OpenProposal{}, fmt.Errorf(\"%w: %s\", ErrProposalNotFound, proposalID)\n128\t\t}\n129\t\tp := *out.Proposal\n130\t\tif p.ID == \"\" {\n131\t\t\tp.ID = ProposalID(p.Proposal)\n132\t\t}\n133\t\treturn p, nil\n134\t}\n135\t\n136\t// publishRequestBody is the POST body for a whole-set publish.\n137\ttype publishProposalsBody struct {\n138\t\tBranch    string         `json:\"branch\"`\n139\t\tOldRef    string         `json:\"oldRef\"`\n140\t\tProposals []OpenProposal `json:\"proposals\"`\n141\t}\n142\t\n143\t// PublishProposals compare-and-swaps the branch's whole open proposal set from oldRef\n144\t// (empty when the branch has no set yet) onto the supplied list, returning the new ref.\n145\t// 412/409 → ErrConflict (another member changed the set first); a 200 reporting\n146\t// changed=false → ErrNoChange, mirroring Advance's contract on the fact-set head.\n147\tfunc (h *HTTPServer) PublishProposals(ctx context.Context, repoID, branch, oldRef string, proposals []OpenProposal) (string, error) {\n148\t\tbody := publishProposalsBody{Branch: branch, OldRef: oldRef, Proposals: proposals}\n149\t\tif body.Proposals == nil {\n150\t\t\tbody.Proposals = []OpenProposal{}\n151\t\t}\n152\t\tencoded, err := json.Marshal(body)\n153\t\tif err != nil {\n154\t\t\treturn \"\", err\n155\t\t}\n156\t\treq, err := h.newRequest(ctx, http.MethodPost, proposalsPath(repoID), bytes.NewReader(encoded))\n157\t\tif err != nil {\n158\t\t\treturn \"\", err\n159\t\t}\n160\t\tresp, err := h.client().Do(req)\n161\t\tif err != nil {\n162\t\t\treturn \"\", fmt.Errorf(\"factsync: POST proposals %s/%s: %w\", repoID, branch, err)\n163\t\t}\n164\t\tdefer resp.Body.Close()\n165\t\tswitch resp.StatusCode {\n166\t\tcase http.StatusOK:\n167\t\t\tvar out struct {\n168\t\t\t\tRef     string `json:\"ref\"`\n169\t\t\t\tVersion int64  `json:\"version\"`\n\n... [117 lines truncated] ..."},"type":"attachment","uuid":"8dcce598-30bb-4fa8-ab4b-76a3497116db","timestamp":"2026-08-17T17:40:03.037Z","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/p0p1/p1-new","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
