n.Decoder, tok json.Token, depth int) (any, error) {\n227:const (\n238:const (\n262:var canonicalContentRef = &canonicalType{\n272:var canonicalSnapshotRef = &canonicalType{\n281:var canonicalOverlayRef = &canonicalType{\n291:var canonicalFactsRef = &canonicalType{\n299:var canonicalManifest = &canonicalType{\n312:var canonicalArtifact = &canonicalType{\n326:func normalizeObject(t *canonicalType, in map[string]any) (map[string]any, error) {\n351:func normalizeField(t *canonicalType, f canonicalField, raw any) (any, error) {\n458:const maxCanonicalInt = int64(1) << 53\n465:func canonicalInt(lit string) (int64, error) {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"9742acd8-bc94-4cba-8bb1-a63a48fbd4e7","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/p0p1/p1-new","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
