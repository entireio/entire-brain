ch Opus exactly)\n  cacheRead     48.85% of cost  (95.8% of tokens)   eg saves +7.40%\n  output        32.93% of cost  ( 1.3% of tokens)   eg saves +4.64%\n  cacheCreation 18.15% of cost  ( 2.9% of tokens)   eg saves +0.13%\n[515 more lines]...\n535","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"0dfc081a-4462-4366-8e4c-085fa5411006","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
