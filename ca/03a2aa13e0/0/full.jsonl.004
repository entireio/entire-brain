ll.\nfunc fakeReaderMember(pullable, member []string, fail bool) *authz.Reader {\n\treturn authz.NewReaderFromClient(&fakeAuthz{\n\t\trepos: toSet(pullable), listRepos: toSet(member), fail: fail,\n=== jwksAuth ===\ninternal/httpapi/me_http_test.go:39:func jwksAuth(t *testing.T) (*auth.Authenticator, func(account string) string) {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"b0d39fd1-42d4-4ee1-b7f7-4df95e124c33","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/p0p1/api-242","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
