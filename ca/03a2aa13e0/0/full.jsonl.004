{"type":"agent-name","agentName":"audit-git-meta-finish-p0-p1","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af"}
{"type":"mode","mode":"normal","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af"}
