{"parentUuid":"1f36f35e-9436-4775-806f-fee40ad3bca2","isSidechain":false,"message":{"model":"claude-opus-5","id":"msg_011Ce8j5jSaVaxzCb3LJgbFs","type":"message","role":"assistant","content":[{"type":"text","text":"Clean pattern to mirror. Replacing the old test file:"}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":657,"cache_read_input_tokens":875598,"output_tokens":6167,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":657,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":6167,"cache_read_input_tokens":875598,"cache_creation_input_tokens":657,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":657},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011Ce8j5bJvfEA2Kn2ngKGdn","type":"assistant","uuid":"31372389-d909-4514-b5ac-a829ec64fcd6","timestamp":"2026-08-17T17:37:00.734Z","effort":"xhigh","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/p0p1/api-242","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
{"parentUuid":"31372389-d909-4514-b5ac-a829ec64fcd6","isSidechain":false,"message":{"model":"claude-opus-5","id":"msg_011Ce8j5jSaVaxzCb3LJgbFs","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01AzVJhNg5eG8sM4ScbPdPBK","name":"Write","input":{"file_path":"/Users/suhaan/devenv/p0p1/api-242/internal/httpapi/brain_proposals_test.go","content":"package httpapi\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"testing\"\n\n\t\"github.com/danielgtaylor/huma/v2\"\n\n\t\"github.com/entirehq/entire-api/internal/brainbuild\"\n\t\"github.com/entirehq/entire-api/internal/brainstore\"\n\t\"github.com/entirehq/entire-api/internal/snapshotcrypt/snapshotcrypttest\"\n)\n\n// newProposalsTest wires Mem-backed fact-set AND proposal-set heads behind\n// RepoActivityDeps. They share the encrypting store (as production does) but hold\n// SEPARATE ref indexes, which is the point: the two heads must move independently.\nfunc newProposalsTest() *RepoActivityDeps {\n\tinner := brainstore.NewMemStore()\n\tenc := brainstore.NewEncryptingStore(inner, snapshotcrypttest.NewCipher(), brainstore.NewMemDEKStore())\n\tresolver := fakeSlugResolver{slug: factsSlug}\n\tfacts := brainbuild.NewFactSetStore(enc, brainbuild.NewMemFactRefIndex(), resolver)\n\tproposals := brainbuild.NewProposalSetStore(enc, brainbuild.NewMemFactRefIndex(), resolver)\n\treturn &RepoActivityDeps{Facts: facts, Proposals: proposals}\n}\n\n// proposalEntry builds one set entry with the client's shape: a derived id plus an\n// opaque proposal body the server never interprets.\nfunc proposalEntry(t *testing.T, id, action, candidate, target string) brainProposal {\n\tt.Helper()\n\tbody, err := json.Marshal(map[string]any{\n\t\t\"action\":       action,\n\t\t\"candidate_id\": candidate,\n\t\t\"target_id\":    target,\n\t\t\"branch\":       factsBranch,\n\t\t\"proposed_by\":  \"member-A\",\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn brainProposal{ID: id, Proposal: body}\n}\n\nfunc publishInput(branch, oldRef string, set []brainProposal) *BrainProposalsPublishInput {\n\tin := &BrainProposalsPublishInput{RepoID: factsRepoID}\n\tin.Body.Branch = branch\n\tin.Body.OldRef = oldRef\n\tin.Body.Proposals = set\n\treturn in\n}\n\nfunc resolveInput(branch, id, decision, factsOldRef string, data []byte, setOldRef string, remaining []brainProposal) *BrainProposalResolveInput {\n\tin := &BrainProposalResolveInput{RepoID: factsRepoID, ProposalID: id}\n\tin.Body.Branch = branch\n\tin.Body.Decision = decision\n\tin.Body.FactsOldRef = factsOldRef\n\tin.Body.Data = data\n\tin.Body.ProposalsOldRef = setOldRef\n\tin.Body.Proposals = remaining\n\treturn in\n}\n\nfunc statusOf(t *testing.T, err error) int {\n\tt.Helper()\n\tvar se huma.StatusError\n\tif !asStatusError(err, &se) {\n\t\tt.Fatalf(\"expected a huma.StatusError, got %v\", err)\n\t}\n\treturn se.GetStatus()\n}\n\nfunc asStatusError(err error, out *huma.StatusError) bool {\n\tse, ok := err.(huma.StatusError)\n\tif ok {\n\t\t*out = se\n\t}\n\treturn ok\n}\n\n// TestProposalsPublishThenList: an empty branch lists found=false with an empty set;\n// after a publish the set round-trips through the CAS'd blob unchanged, including the\n// opaque proposal body.\nfunc TestProposalsPublishThenList(t *testing.T) {\n\tdeps := newProposalsTest()\n\tctx := context.Background()\n\n\tempty, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch})\n\tif err != nil {\n\t\tt.Fatalf(\"list empty: %v\", err)\n\t}\n\tif empty.Body.Found {\n\t\tt.Fatal(\"a branch with no set must read found=false\")\n\t}\n\tif empty.Body.Proposals == nil || len(empty.Body.Proposals) != 0 {\n\t\tt.Fatalf(\"empty set must be an empty array, not null: %+v\", empty.Body.Proposals)\n\t}\n\n\tset := []brainProposal{proposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\")}\n\tpub, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", set))\n\tif err != nil {\n\t\tt.Fatalf(\"publish: %v\", err)\n\t}\n\tif !pub.Body.Changed || pub.Body.Ref == \"\" {\n\t\tt.Fatalf(\"publish should have created a head: %+v\", pub.Body)\n\t}\n\n\tgot, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch})\n\tif err != nil {\n\t\tt.Fatalf(\"list: %v\", err)\n\t}\n\tif !got.Body.Found || len(got.Body.Proposals) != 1 {\n\t\tt.Fatalf(\"published set did not round-trip: %+v\", got.Body)\n\t}\n\tif got.Body.Proposals[0].ID != \"prop-aaaa\" {\n\t\tt.Fatalf(\"client-derived id was not preserved: %q\", got.Body.Proposals[0].ID)\n\t}\n\t// The server must not reinterpret the proposal body.\n\tvar decoded map[string]any\n\tif err := json.Unmarshal(got.Body.Proposals[0].Proposal, &decoded); err != nil {\n\t\tt.Fatalf(\"proposal body is not intact JSON: %v\", err)\n\t}\n\tif decoded[\"candidate_id\"] != \"fact:a\" || decoded[\"proposed_by\"] != \"member-A\" {\n\t\tt.Fatalf(\"proposal body was altered: %+v\", decoded)\n\t}\n}\n\n// TestProposalsPublishStaleOldRefConflicts: a publish from a ref another member has\n// already moved past must lose the CAS with 412, never clobber.\nfunc TestProposalsPublishStaleOldRefConflicts(t *testing.T) {\n\tdeps := newProposalsTest()\n\tctx := context.Background()\n\n\tfirst, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\",\n\t\t[]brainProposal{proposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\")}))\n\tif err != nil {\n\t\tt.Fatalf(\"first publish: %v\", err)\n\t}\n\tif _, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, first.Body.Ref,\n\t\t[]brainProposal{proposalEntry(t, \"prop-bbbb\", \"merge\", \"fact:c\", \"fact:d\")})); err != nil {\n\t\tt.Fatalf(\"second publish: %v\", err)\n\t}\n\t// Third publish still quotes the FIRST ref: stale.\n\t_, err = publishBrainProposals(ctx, deps, publishInput(factsBranch, first.Body.Ref,\n\t\t[]brainProposal{proposalEntry(t, \"prop-cccc\", \"merge\", \"fact:e\", \"fact:f\")}))\n\tif err == nil {\n\t\tt.Fatal(\"a stale oldRef must not win the CAS\")\n\t}\n\tif got := statusOf(t, err); got != http.StatusPreconditionFailed {\n\t\tt.Fatalf(\"stale publish status = %d, want 412\", got)\n\t}\n}\n\n// TestProposalResolveAdvancesBothHeads is the settlement path: the runner sends the\n// resolved fact set and the remaining proposals, each under the ref it read, and both\n// heads move together.\nfunc TestProposalResolveAdvancesBothHeads(t *testing.T) {\n\tdeps := newProposalsTest()\n\tctx := context.Background()\n\n\t// A fact head to settle against.\n\tfactsAdv, err := advanceBrainFacts(ctx, deps, advanceInput(factsBranch, \"\", []byte(`{\"id\":\"fact:a\"}`)))\n\tif err != nil {\n\t\tt.Fatalf(\"seed facts: %v\", err)\n\t}\n\tset := []brainProposal{\n\t\tproposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\"),\n\t\tproposalEntry(t, \"prop-bbbb\", \"merge\", \"fact:c\", \"fact:d\"),\n\t}\n\tpub, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", set))\n\tif err != nil {\n\t\tt.Fatalf(\"publish: %v\", err)\n\t}\n\n\tres, err := resolveBrainProposal(ctx, deps, resolveInput(\n\t\tfactsBranch, \"prop-aaaa\", \"accept\",\n\t\tfactsAdv.Body.NewRef, []byte(`{\"id\":\"fact:a\",\"resolved\":true}`),\n\t\tpub.Body.Ref, set[1:],\n\t))\n\tif err != nil {\n\t\tt.Fatalf(\"resolve: %v\", err)\n\t}\n\tif res.Body.FactsRef == factsAdv.Body.NewRef {\n\t\tt.Fatal(\"accept did not advance the fact head\")\n\t}\n\tif res.Body.ProposalsRef == pub.Body.Ref {\n\t\tt.Fatal(\"resolve did not advance the proposal set\")\n\t}\n\n\tafter, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(after.Body.Proposals) != 1 || after.Body.Proposals[0].ID != \"prop-bbbb\" {\n\t\tt.Fatalf(\"settled entry was not removed from the set: %+v\", after.Body.Proposals)\n\t}\n}\n\n// TestProposalResolveFactsUnchangedPrunesWithoutTouchingFacts covers the orphan path:\n// a proposal whose facts are gone cannot be accepted, and reject changes no facts, so\n// the settlement must move ONLY the proposal set and leave the fact head exactly where\n// it was.\nfunc TestProposalResolveFactsUnchangedPrunesWithoutTouchingFacts(t *testing.T) {\n\tdeps := newProposalsTest()\n\tctx := context.Background()\n\n\tfactsAdv, err := advanceBrainFacts(ctx, deps, advanceInput(factsBranch, \"\", []byte(`{\"id\":\"fact:a\"}`)))\n\tif err != nil {\n\t\tt.Fatalf(\"seed facts: %v\", err)\n\t}\n\tset := []brainProposal{proposalEntry(t, \"prop-orphan\", \"supersede\", \"fact:gone\", \"fact:alsogone\")}\n\tpub, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", set))\n\tif err != nil {\n\t\tt.Fatalf(\"publish: %v\", err)\n\t}\n\n\tin := resolveInput(factsBranch, \"prop-orphan\", \"reject\", factsAdv.Body.NewRef, nil, pub.Body.Ref, nil)\n\tin.Body.FactsUnchanged = true\n\tres, err := resolveBrainProposal(ctx, deps, in)\n\tif err != nil {\n\t\tt.Fatalf(\"prune: %v\", err)\n\t}\n\tif res.Body.FactsRef != factsAdv.Body.NewRef {\n\t\tt.Fatalf(\"prune moved the fact head: %q -> %q\", factsAdv.Body.NewRef, res.Body.FactsRef)\n\t}\n\n\tcur, err := currentBrainFacts(ctx, deps, currentInput(factsBranch))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif cur.Body.Ref != factsAdv.Body.NewRef {\n\t\tt.Fatalf(\"fact head changed behind a facts-unchanged prune: %q\", cur.Body.Ref)\n\t}\n\tafter, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(after.Body.Proposals) != 0 {\n\t\tt.Fatalf(\"orphan was not pruned: %+v\", after.Body.Proposals)\n\t}\n}\n\n// TestProposalResolveRejectsFactsUnchangedOnAccept guards the boundary: skipping the\n// fact write on an accept would retire the proposal while dropping its merge result.\nfunc TestProposalResolveRejectsFactsUnchangedOnAccept(t *testing.T) {\n\tdeps := newProposalsTest()\n\tin := resolveInput(factsBranch, \"prop-aaaa\", \"accept\", \"\", nil, \"\", nil)\n\tin.Body.FactsUnchanged = true\n\t_, err := resolveBrainProposal(context.Background(), deps, in)\n\tif err == nil {\n\t\tt.Fatal(\"factsUnchanged with accept must be refused\")\n\t}\n\tif got := statusOf(t, err); got != http.StatusBadRequest {\n\t\tt.Fatalf(\"status = %d, want 400\", got)\n\t}\n}\n\n// TestProposalResolveStaleSetRefConflicts: losing the proposal-set CAS is a 412 so\n// the runner re-reads and re-resolves rather than clobbering a concurrent settlement.\nfunc TestProposalResolveStaleSetRefConflicts(t *testing.T) {\n\tdeps := newProposalsTest()\n\tctx := context.Background()\n\n\tfactsAdv, err := advanceBrainFacts(ctx, deps, advanceInput(factsBranch, \"\", []byte(`{\"id\":\"fact:a\"}`)))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tset := []brainProposal{proposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\")}\n\tpub, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", set))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// Someone else moves the set first.\n\tif _, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, pub.Body.Ref,\n\t\t[]brainProposal{proposalEntry(t, \"prop-zzzz\", \"merge\", \"fact:y\", \"fact:z\")})); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t_, err = resolveBrainProposal(ctx, deps, resolveInput(\n\t\tfactsBranch, \"prop-aaaa\", \"accept\",\n\t\tfactsAdv.Body.NewRef, []byte(`{\"id\":\"fact:a\",\"resolved\":true}`),\n\t\tpub.Body.Ref, nil, // stale set ref\n\t))\n\tif err == nil {\n\t\tt.Fatal(\"a stale proposalsOldRef must not win\")\n\t}\n\tif got := statusOf(t, err); got != http.StatusPreconditionFailed {\n\t\tt.Fatalf(\"status = %d, want 412\", got)\n\t}\n}\n\n// TestProposalsNilStoreUnavailable: an unconfigured queue fails closed with 503 on\n// every endpoint rather than pretending the set is empty.\nfunc TestProposalsNilStoreUnavailable(t *testing.T) {\n\tdeps := &RepoActivityDeps{} // Proposals nil\n\tctx := context.Background()\n\tif _, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch}); err == nil {\n\t\tt.Fatal(\"list with no store must fail\")\n\t} else if got := statusOf(t, err); got != http.StatusServiceUnavailable {\n\t\tt.Fatalf(\"list status = %d, want 503\", got)\n\t}\n\tif _, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", nil)); err == nil {\n\t\tt.Fatal(\"publish with no store must fail\")\n\t} else if got := statusOf(t, err); got != http.StatusServiceUnavailable {\n\t\tt.Fatalf(\"publish status = %d, want 503\", got)\n\t}\n}\n\n// TestProposalGetReportsAbsentAsFound false, not 404: \"settled by someone else\" is a\n// normal answer a reconciling client must be able to tell from a failed request.\nfunc TestProposalGetReportsAbsentAsFound(t *testing.T) {\n\tdeps := newProposalsTest()\n\tctx := context.Background()\n\tset := []brainProposal{proposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\")}\n\tif _, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", set)); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgot, err := getBrainProposal(ctx, deps, &BrainProposalGetInput{RepoID: factsRepoID, ProposalID: \"prop-missing\", Branch: factsBranch})\n\tif err != nil {\n\t\tt.Fatalf(\"absent proposal must not be an error: %v\", err)\n\t}\n\tif got.Body.Found || got.Body.Proposal != nil {\n\t\tt.Fatalf(\"absent proposal reported as found: %+v\", got.Body)\n\t}\n\tpresent, err := getBrainProposal(ctx, deps, &BrainProposalGetInput{RepoID: factsRepoID, ProposalID: \"prop-aaaa\", Branch: factsBranch})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !present.Body.Found || present.Body.Proposal == nil {\n\t\tt.Fatalf(\"present proposal not returned: %+v\", present.Body)\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":657,"cache_read_input_tokens":875598,"output_tokens":6167,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":657,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":6167,"cache_read_input_tokens":875598,"cache_creation_input_tokens":657,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":657},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011Ce8j5bJvfEA2Kn2ngKGdn","type":"assistant","uuid":"9ccce43c-eeb5-4916-9ac3-695424e7d896","timestamp":"2026-08-17T17:37:53.348Z","effort":"xhigh","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/p0p1/api-242","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
{"parentUuid":"9ccce43c-eeb5-4916-9ac3-695424e7d896","isSidechain":false,"promptId":"008251ba-5894-4079-a812-8e401d59a62b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AzVJhNg5eG8sM4ScbPdPBK","type":"tool_result","content":"The file /Users/suhaan/devenv/p0p1/api-242/internal/httpapi/brain_proposals_test.go has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"e70d3e96-7202-409e-bf03-9a4ac72d2d95","timestamp":"2026-08-17T17:37:53.371Z","toolUseResult":{"type":"update","filePath":"/Users/suhaan/devenv/p0p1/api-242/internal/httpapi/brain_proposals_test.go","content":"package httpapi\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"net/http\"\n\t\"testing\"\n\n\t\"github.com/danielgtaylor/huma/v2\"\n\n\t\"github.com/entirehq/entire-api/internal/brainbuild\"\n\t\"github.com/entirehq/entire-api/internal/brainstore\"\n\t\"github.com/entirehq/entire-api/internal/snapshotcrypt/snapshotcrypttest\"\n)\n\n// newProposalsTest wires Mem-backed fact-set AND proposal-set heads behind\n// RepoActivityDeps. They share the encrypting store (as production does) but hold\n// SEPARATE ref indexes, which is the point: the two heads must move independently.\nfunc newProposalsTest() *RepoActivityDeps {\n\tinner := brainstore.NewMemStore()\n\tenc := brainstore.NewEncryptingStore(inner, snapshotcrypttest.NewCipher(), brainstore.NewMemDEKStore())\n\tresolver := fakeSlugResolver{slug: factsSlug}\n\tfacts := brainbuild.NewFactSetStore(enc, brainbuild.NewMemFactRefIndex(), resolver)\n\tproposals := brainbuild.NewProposalSetStore(enc, brainbuild.NewMemFactRefIndex(), resolver)\n\treturn &RepoActivityDeps{Facts: facts, Proposals: proposals}\n}\n\n// proposalEntry builds one set entry with the client's shape: a derived id plus an\n// opaque proposal body the server never interprets.\nfunc proposalEntry(t *testing.T, id, action, candidate, target string) brainProposal {\n\tt.Helper()\n\tbody, err := json.Marshal(map[string]any{\n\t\t\"action\":       action,\n\t\t\"candidate_id\": candidate,\n\t\t\"target_id\":    target,\n\t\t\"branch\":       factsBranch,\n\t\t\"proposed_by\":  \"member-A\",\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn brainProposal{ID: id, Proposal: body}\n}\n\nfunc publishInput(branch, oldRef string, set []brainProposal) *BrainProposalsPublishInput {\n\tin := &BrainProposalsPublishInput{RepoID: factsRepoID}\n\tin.Body.Branch = branch\n\tin.Body.OldRef = oldRef\n\tin.Body.Proposals = set\n\treturn in\n}\n\nfunc resolveInput(branch, id, decision, factsOldRef string, data []byte, setOldRef string, remaining []brainProposal) *BrainProposalResolveInput {\n\tin := &BrainProposalResolveInput{RepoID: factsRepoID, ProposalID: id}\n\tin.Body.Branch = branch\n\tin.Body.Decision = decision\n\tin.Body.FactsOldRef = factsOldRef\n\tin.Body.Data = data\n\tin.Body.ProposalsOldRef = setOldRef\n\tin.Body.Proposals = remaining\n\treturn in\n}\n\nfunc statusOf(t *testing.T, err error) int {\n\tt.Helper()\n\tvar se huma.StatusError\n\tif !asStatusError(err, &se) {\n\t\tt.Fatalf(\"expected a huma.StatusError, got %v\", err)\n\t}\n\treturn se.GetStatus()\n}\n\nfunc asStatusError(err error, out *huma.StatusError) bool {\n\tse, ok := err.(huma.StatusError)\n\tif ok {\n\t\t*out = se\n\t}\n\treturn ok\n}\n\n// TestProposalsPublishThenList: an empty branch lists found=false with an empty set;\n// after a publish the set round-trips through the CAS'd blob unchanged, including the\n// opaque proposal body.\nfunc TestProposalsPublishThenList(t *testing.T) {\n\tdeps := newProposalsTest()\n\tctx := context.Background()\n\n\tempty, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch})\n\tif err != nil {\n\t\tt.Fatalf(\"list empty: %v\", err)\n\t}\n\tif empty.Body.Found {\n\t\tt.Fatal(\"a branch with no set must read found=false\")\n\t}\n\tif empty.Body.Proposals == nil || len(empty.Body.Proposals) != 0 {\n\t\tt.Fatalf(\"empty set must be an empty array, not null: %+v\", empty.Body.Proposals)\n\t}\n\n\tset := []brainProposal{proposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\")}\n\tpub, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", set))\n\tif err != nil {\n\t\tt.Fatalf(\"publish: %v\", err)\n\t}\n\tif !pub.Body.Changed || pub.Body.Ref == \"\" {\n\t\tt.Fatalf(\"publish should have created a head: %+v\", pub.Body)\n\t}\n\n\tgot, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch})\n\tif err != nil {\n\t\tt.Fatalf(\"list: %v\", err)\n\t}\n\tif !got.Body.Found || len(got.Body.Proposals) != 1 {\n\t\tt.Fatalf(\"published set did not round-trip: %+v\", got.Body)\n\t}\n\tif got.Body.Proposals[0].ID != \"prop-aaaa\" {\n\t\tt.Fatalf(\"client-derived id was not preserved: %q\", got.Body.Proposals[0].ID)\n\t}\n\t// The server must not reinterpret the proposal body.\n\tvar decoded map[string]any\n\tif err := json.Unmarshal(got.Body.Proposals[0].Proposal, &decoded); err != nil {\n\t\tt.Fatalf(\"proposal body is not intact JSON: %v\", err)\n\t}\n\tif decoded[\"candidate_id\"] != \"fact:a\" || decoded[\"proposed_by\"] != \"member-A\" {\n\t\tt.Fatalf(\"proposal body was altered: %+v\", decoded)\n\t}\n}\n\n// TestProposalsPublishStaleOldRefConflicts: a publish from a ref another member has\n// already moved past must lose the CAS with 412, never clobber.\nfunc TestProposalsPublishStaleOldRefConflicts(t *testing.T) {\n\tdeps := newProposalsTest()\n\tctx := context.Background()\n\n\tfirst, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\",\n\t\t[]brainProposal{proposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\")}))\n\tif err != nil {\n\t\tt.Fatalf(\"first publish: %v\", err)\n\t}\n\tif _, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, first.Body.Ref,\n\t\t[]brainProposal{proposalEntry(t, \"prop-bbbb\", \"merge\", \"fact:c\", \"fact:d\")})); err != nil {\n\t\tt.Fatalf(\"second publish: %v\", err)\n\t}\n\t// Third publish still quotes the FIRST ref: stale.\n\t_, err = publishBrainProposals(ctx, deps, publishInput(factsBranch, first.Body.Ref,\n\t\t[]brainProposal{proposalEntry(t, \"prop-cccc\", \"merge\", \"fact:e\", \"fact:f\")}))\n\tif err == nil {\n\t\tt.Fatal(\"a stale oldRef must not win the CAS\")\n\t}\n\tif got := statusOf(t, err); got != http.StatusPreconditionFailed {\n\t\tt.Fatalf(\"stale publish status = %d, want 412\", got)\n\t}\n}\n\n// TestProposalResolveAdvancesBothHeads is the settlement path: the runner sends the\n// resolved fact set and the remaining proposals, each under the ref it read, and both\n// heads move together.\nfunc TestProposalResolveAdvancesBothHeads(t *testing.T) {\n\tdeps := newProposalsTest()\n\tctx := context.Background()\n\n\t// A fact head to settle against.\n\tfactsAdv, err := advanceBrainFacts(ctx, deps, advanceInput(factsBranch, \"\", []byte(`{\"id\":\"fact:a\"}`)))\n\tif err != nil {\n\t\tt.Fatalf(\"seed facts: %v\", err)\n\t}\n\tset := []brainProposal{\n\t\tproposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\"),\n\t\tproposalEntry(t, \"prop-bbbb\", \"merge\", \"fact:c\", \"fact:d\"),\n\t}\n\tpub, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", set))\n\tif err != nil {\n\t\tt.Fatalf(\"publish: %v\", err)\n\t}\n\n\tres, err := resolveBrainProposal(ctx, deps, resolveInput(\n\t\tfactsBranch, \"prop-aaaa\", \"accept\",\n\t\tfactsAdv.Body.NewRef, []byte(`{\"id\":\"fact:a\",\"resolved\":true}`),\n\t\tpub.Body.Ref, set[1:],\n\t))\n\tif err != nil {\n\t\tt.Fatalf(\"resolve: %v\", err)\n\t}\n\tif res.Body.FactsRef == factsAdv.Body.NewRef {\n\t\tt.Fatal(\"accept did not advance the fact head\")\n\t}\n\tif res.Body.ProposalsRef == pub.Body.Ref {\n\t\tt.Fatal(\"resolve did not advance the proposal set\")\n\t}\n\n\tafter, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(after.Body.Proposals) != 1 || after.Body.Proposals[0].ID != \"prop-bbbb\" {\n\t\tt.Fatalf(\"settled entry was not removed from the set: %+v\", after.Body.Proposals)\n\t}\n}\n\n// TestProposalResolveFactsUnchangedPrunesWithoutTouchingFacts covers the orphan path:\n// a proposal whose facts are gone cannot be accepted, and reject changes no facts, so\n// the settlement must move ONLY the proposal set and leave the fact head exactly where\n// it was.\nfunc TestProposalResolveFactsUnchangedPrunesWithoutTouchingFacts(t *testing.T) {\n\tdeps := newProposalsTest()\n\tctx := context.Background()\n\n\tfactsAdv, err := advanceBrainFacts(ctx, deps, advanceInput(factsBranch, \"\", []byte(`{\"id\":\"fact:a\"}`)))\n\tif err != nil {\n\t\tt.Fatalf(\"seed facts: %v\", err)\n\t}\n\tset := []brainProposal{proposalEntry(t, \"prop-orphan\", \"supersede\", \"fact:gone\", \"fact:alsogone\")}\n\tpub, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", set))\n\tif err != nil {\n\t\tt.Fatalf(\"publish: %v\", err)\n\t}\n\n\tin := resolveInput(factsBranch, \"prop-orphan\", \"reject\", factsAdv.Body.NewRef, nil, pub.Body.Ref, nil)\n\tin.Body.FactsUnchanged = true\n\tres, err := resolveBrainProposal(ctx, deps, in)\n\tif err != nil {\n\t\tt.Fatalf(\"prune: %v\", err)\n\t}\n\tif res.Body.FactsRef != factsAdv.Body.NewRef {\n\t\tt.Fatalf(\"prune moved the fact head: %q -> %q\", factsAdv.Body.NewRef, res.Body.FactsRef)\n\t}\n\n\tcur, err := currentBrainFacts(ctx, deps, currentInput(factsBranch))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif cur.Body.Ref != factsAdv.Body.NewRef {\n\t\tt.Fatalf(\"fact head changed behind a facts-unchanged prune: %q\", cur.Body.Ref)\n\t}\n\tafter, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(after.Body.Proposals) != 0 {\n\t\tt.Fatalf(\"orphan was not pruned: %+v\", after.Body.Proposals)\n\t}\n}\n\n// TestProposalResolveRejectsFactsUnchangedOnAccept guards the boundary: skipping the\n// fact write on an accept would retire the proposal while dropping its merge result.\nfunc TestProposalResolveRejectsFactsUnchangedOnAccept(t *testing.T) {\n\tdeps := newProposalsTest()\n\tin := resolveInput(factsBranch, \"prop-aaaa\", \"accept\", \"\", nil, \"\", nil)\n\tin.Body.FactsUnchanged = true\n\t_, err := resolveBrainProposal(context.Background(), deps, in)\n\tif err == nil {\n\t\tt.Fatal(\"factsUnchanged with accept must be refused\")\n\t}\n\tif got := statusOf(t, err); got != http.StatusBadRequest {\n\t\tt.Fatalf(\"status = %d, want 400\", got)\n\t}\n}\n\n// TestProposalResolveStaleSetRefConflicts: losing the proposal-set CAS is a 412 so\n// the runner re-reads and re-resolves rather than clobbering a concurrent settlement.\nfunc TestProposalResolveStaleSetRefConflicts(t *testing.T) {\n\tdeps := newProposalsTest()\n\tctx := context.Background()\n\n\tfactsAdv, err := advanceBrainFacts(ctx, deps, advanceInput(factsBranch, \"\", []byte(`{\"id\":\"fact:a\"}`)))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tset := []brainProposal{proposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\")}\n\tpub, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", set))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// Someone else moves the set first.\n\tif _, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, pub.Body.Ref,\n\t\t[]brainProposal{proposalEntry(t, \"prop-zzzz\", \"merge\", \"fact:y\", \"fact:z\")})); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t_, err = resolveBrainProposal(ctx, deps, resolveInput(\n\t\tfactsBranch, \"prop-aaaa\", \"accept\",\n\t\tfactsAdv.Body.NewRef, []byte(`{\"id\":\"fact:a\",\"resolved\":true}`),\n\t\tpub.Body.Ref, nil, // stale set ref\n\t))\n\tif err == nil {\n\t\tt.Fatal(\"a stale proposalsOldRef must not win\")\n\t}\n\tif got := statusOf(t, err); got != http.StatusPreconditionFailed {\n\t\tt.Fatalf(\"status = %d, want 412\", got)\n\t}\n}\n\n// TestProposalsNilStoreUnavailable: an unconfigured queue fails closed with 503 on\n// every endpoint rather than pretending the set is empty.\nfunc TestProposalsNilStoreUnavailable(t *testing.T) {\n\tdeps := &RepoActivityDeps{} // Proposals nil\n\tctx := context.Background()\n\tif _, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch}); err == nil {\n\t\tt.Fatal(\"list with no store must fail\")\n\t} else if got := statusOf(t, err); got != http.StatusServiceUnavailable {\n\t\tt.Fatalf(\"list status = %d, want 503\", got)\n\t}\n\tif _, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", nil)); err == nil {\n\t\tt.Fatal(\"publish with no store must fail\")\n\t} else if got := statusOf(t, err); got != http.StatusServiceUnavailable {\n\t\tt.Fatalf(\"publish status = %d, want 503\", got)\n\t}\n}\n\n// TestProposalGetReportsAbsentAsFound false, not 404: \"settled by someone else\" is a\n// normal answer a reconciling client must be able to tell from a failed request.\nfunc TestProposalGetReportsAbsentAsFound(t *testing.T) {\n\tdeps := newProposalsTest()\n\tctx := context.Background()\n\tset := []brainProposal{proposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\")}\n\tif _, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", set)); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgot, err := getBrainProposal(ctx, deps, &BrainProposalGetInput{RepoID: factsRepoID, ProposalID: \"prop-missing\", Branch: factsBranch})\n\tif err != nil {\n\t\tt.Fatalf(\"absent proposal must not be an error: %v\", err)\n\t}\n\tif got.Body.Found || got.Body.Proposal != nil {\n\t\tt.Fatalf(\"absent proposal reported as found: %+v\", got.Body)\n\t}\n\tpresent, err := getBrainProposal(ctx, deps, &BrainProposalGetInput{RepoID: factsRepoID, ProposalID: \"prop-aaaa\", Branch: factsBranch})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !present.Body.Found || present.Body.Proposal == nil {\n\t\tt.Fatalf(\"present proposal not returned: %+v\", present.Body)\n\t}\n}\n","structuredPatch":[{"oldStart":1,"oldLines":422,"newStart":1,"newLines":331,"lines":[" package httpapi"," "," import (","-  \"bytes\"","   \"context\"","   \"encoding/json\"","   \"net/http\"","-  \"net/http/httptest\"","   \"testing\""," ","+  \"github.com/danielgtaylor/huma/v2\"","+","   \"github.com/entirehq/entire-api/internal/brainbuild\"","   \"github.com/entirehq/entire-api/internal/brainstore\"","   \"github.com/entirehq/entire-api/internal/snapshotcrypt/snapshotcrypttest\""," )"," ","-// The open-proposal-set handler tests drive the five handlers over a fully in-memory","-// stack (Mem object store + local test cipher + Mem DEK store + Mem proposal index +","-// Mem CAS index + a fake ULID→slug resolver), so no Postgres is needed — mirroring","-// brain_facts_test.go. The authz tests additionally stand up the real router + JWT","-// auth (jwksAuth) + the SpiceDB double (fakeReaderRW) to prove each route's gate.","-","-const (","-  propsRepoID = \"01ARZ3NDEKTSV4RRFFQ69G5FAV\"","-  propsSlug   = \"gh/acme/widget\"","-  propsBranch = \"main\"","-)","-","-// newProposalsTest wires a Mem-backed ProposalStore (and the FactSetStore it shares)","-// behind RepoActivityDeps with a fake resolver (propsRepoID → slug).","-func newProposalsTest(slug string) *RepoActivityDeps {","-  enc := brainstore.NewEncryptingStore(brainstore.NewMemStore(), snapshotcrypttest.NewCipher(), brainstore.NewMemDEKStore())","-  resolver := fakeSlugResolver{slug: slug}","+// newProposalsTest wires Mem-backed fact-set AND proposal-set heads behind","+// RepoActivityDeps. They share the encrypting store (as production does) but hold","+// SEPARATE ref indexes, which is the point: the two heads must move independently.","+func newProposalsTest() *RepoActivityDeps {","+  inner := brainstore.NewMemStore()","+  enc := brainstore.NewEncryptingStore(inner, snapshotcrypttest.NewCipher(), brainstore.NewMemDEKStore())","+  resolver := fakeSlugResolver{slug: factsSlug}","   facts := brainbuild.NewFactSetStore(enc, brainbuild.NewMemFactRefIndex(), resolver)","-  proposals := brainbuild.NewProposalStore(enc, brainbuild.NewMemProposalIndex(), facts, resolver)","+  proposals := brainbuild.NewProposalSetStore(enc, brainbuild.NewMemFactRefIndex(), resolver)","   return &RepoActivityDeps{Facts: facts, Proposals: proposals}"," }"," ","-func openProposalInput(branch, baseRef string, data []byte) *BrainProposalOpenInput {","-  in := &BrainProposalOpenInput{RepoID: propsRepoID}","+// proposalEntry builds one set entry with the client's shape: a derived id plus an","+// opaque proposal body the server never interprets.","+func proposalEntry(t *testing.T, id, action, candidate, target string) brainProposal {","+  t.Helper()","+  body, err := json.Marshal(map[string]any{","+    \"action\":       action,","+    \"candidate_id\": candidate,","+    \"target_id\":    target,","+    \"branch\":       factsBranch,","+    \"proposed_by\":  \"member-A\",","+  })","+  if err != nil {","+    t.Fatal(err)","+  }","+  return brainProposal{ID: id, Proposal: body}","+}","+","+func publishInput(branch, oldRef string, set []brainProposal) *BrainProposalsPublishInput {","+  in := &BrainProposalsPublishInput{RepoID: factsRepoID}","   in.Body.Branch = branch","-  in.Body.BaseRef = baseRef","-  in.Body.Summary = \"add facts\"","-  in.Body.ProposedBy = \"alice\"","-  in.Body.Data = data","+  in.Body.OldRef = oldRef","+  in.Body.Proposals = set","   return in"," }"," ","-func rejectProposalInput(id, reason string) *BrainProposalRejectInput {","-  in := &BrainProposalRejectInput{RepoID: propsRepoID, ProposalID: id}","-  in.Body.Reason = reason","+func resolveInput(branch, id, decision, factsOldRef string, data []byte, setOldRef string, remaining []brainProposal) *BrainProposalResolveInput {","+  in := &BrainProposalResolveInput{RepoID: factsRepoID, ProposalID: id}","+  in.Body.Branch = branch","+  in.Body.Decision = decision","+  in.Body.FactsOldRef = factsOldRef","+  in.Body.Data = data","+  in.Body.ProposalsOldRef = setOldRef","+  in.Body.Proposals = remaining","   return in"," }"," ","-// TestProposalsOpenListGetRoundTrip: open → the proposal appears in the open set and","-// reads back with its decrypted plaintext.","-func TestProposalsOpenListGetRoundTrip(t *testing.T) {","+func statusOf(t *testing.T, err error) int {","+  t.Helper()","+  var se huma.StatusError","+  if !asStatusError(err, &se) {","+    t.Fatalf(\"expected a huma.StatusError, got %v\", err)","+  }","+  return se.GetStatus()","+}","+","+func asStatusError(err error, out *huma.StatusError) bool {","+  se, ok := err.(huma.StatusError)","+  if ok {","+    *out = se","+  }","+  return ok","+}","+","+// TestProposalsPublishThenList: an empty branch lists found=false with an empty set;","+// after a publish the set round-trips through the CAS'd blob unchanged, including the","+// opaque proposal body.","+func TestProposalsPublishThenList(t *testing.T) {","+  deps := newProposalsTest()","   ctx := context.Background()","-  deps := newProposalsTest(propsSlug)"," ","-  // Empty queue.","-  list, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: propsRepoID, Limit: 50})","+  empty, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch})","   if err != nil {","-    t.Fatalf(\"list(empty): %v\", err)","+    t.Fatalf(\"list empty: %v\", err)","   }","-  if len(list.Body.Proposals) != 0 {","-    t.Fatalf(\"list(empty) = %d entries, want 0\", len(list.Body.Proposals))","+  if empty.Body.Found {","+    t.Fatal(\"a branch with no set must read found=false\")","   }","+  if empty.Body.Proposals == nil || len(empty.Body.Proposals) != 0 {","+    t.Fatalf(\"empty set must be an empty array, not null: %+v\", empty.Body.Proposals)","+  }"," ","-  blob := []byte(\"fact:a\\nfact:b\\n\")","-  opened, err := openBrainProposal(ctx, deps, openProposalInput(propsBranch, \"\", blob))","+  set := []brainProposal{proposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\")}","+  pub, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", set))","   if err != nil {","-    t.Fatalf(\"open: %v\", err)","+    t.Fatalf(\"publish: %v\", err)","   }","-  p := opened.Body.Proposal","-  if p.Status != brainbuild.ProposalStatusOpen || p.ID == \"\" || p.ContentRef != brainbuild.FactSetRef(blob) {","-    t.Fatalf(\"opened = %+v, want an open proposal at %s\", p, brainbuild.FactSetRef(blob))","+  if !pub.Body.Changed || pub.Body.Ref == \"\" {","+    t.Fatalf(\"publish should have created a head: %+v\", pub.Body)","   }"," ","-  list, err = listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: propsRepoID, Branch: propsBranch, Limit: 50})","+  got, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch})","   if err != nil {","     t.Fatalf(\"list: %v\", err)","   }","-  if len(list.Body.Proposals) != 1 || list.Body.Proposals[0].ID != p.ID {","-    t.Fatalf(\"list = %+v, want exactly %s\", list.Body.Proposals, p.ID)","+  if !got.Body.Found || len(got.Body.Proposals) != 1 {","+    t.Fatalf(\"published set did not round-trip: %+v\", got.Body)","   }","-","-  got, err := getBrainProposal(ctx, deps, &BrainProposalGetInput{RepoID: propsRepoID, ProposalID: p.ID})","-  if err != nil {","-    t.Fatalf(\"get: %v\", err)","+  if got.Body.Proposals[0].ID != \"prop-aaaa\" {","+    t.Fatalf(\"client-derived id was not preserved: %q\", got.Body.Proposals[0].ID)","   }","-  if got.Body.Proposal.ID != p.ID || !bytes.Equal(got.Body.Data, blob) {","-    t.Fatalf(\"get = %+v / %q, want %s / %q\", got.Body.Proposal, got.Body.Data, p.ID, blob)","+  // The server must not reinterpret the proposal body.","+  var decoded map[string]any","+  if err := json.Unmarshal(got.Body.Proposals[0].Proposal, &decoded); err != nil {","+    t.Fatalf(\"proposal body is not intact JSON: %v\", err)","   }","+  if decoded[\"candidate_id\"] != \"fact:a\" || decoded[\"proposed_by\"] != \"member-A\" {","+    t.Fatalf(\"proposal body was altered: %+v\", decoded)","+  }"," }"," ","-// TestProposalsApplyMovesHead: apply advances the branch head and closes the proposal;","-// the fact-sync read endpoint then serves the applied content.","-func TestProposalsApplyMovesHead(t *testing.T) {","+// TestProposalsPublishStaleOldRefConflicts: a publish from a ref another member has","+// already moved past must lose the CAS with 412, never clobber.","+func TestProposalsPublishStaleOldRefConflicts(t *testing.T) {","+  deps := newProposalsTest()","   ctx := context.Background()","-  deps := newProposalsTest(propsSlug)"," ","-  blob := []byte(\"fact:a\\n\")","-  opened, err := openBrainProposal(ctx, deps, openProposalInput(propsBranch, \"\", blob))","+  first, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\",","+    []brainProposal{proposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\")}))","   if err != nil {","-    t.Fatalf(\"open: %v\", err)","+    t.Fatalf(\"first publish: %v\", err)","   }","-  id := opened.Body.Proposal.ID","+  if _, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, first.Body.Ref,","+    []brainProposal{proposalEntry(t, \"prop-bbbb\", \"merge\", \"fact:c\", \"fact:d\")})); err != nil {","+    t.Fatalf(\"second publish: %v\", err)","+  }","+  // Third publish still quotes the FIRST ref: stale.","+  _, err = publishBrainProposals(ctx, deps, publishInput(factsBranch, first.Body.Ref,","+    []brainProposal{proposalEntry(t, \"prop-cccc\", \"merge\", \"fact:e\", \"fact:f\")}))","+  if err == nil {","+    t.Fatal(\"a stale oldRef must not win the CAS\")","+  }","+  if got := statusOf(t, err); got != http.StatusPreconditionFailed {","+    t.Fatalf(\"stale publish status = %d, want 412\", got)","+  }","+}"," ","-  applied, err := applyBrainProposal(ctx, deps, &BrainProposalApplyInput{RepoID: propsRepoID, ProposalID: id})","+// TestProposalResolveAdvancesBothHeads is the settlement path: the runner sends the","+// resolved fact set and the remaining proposals, each under the ref it read, and both","+// heads move together.","+func TestProposalResolveAdvancesBothHeads(t *testing.T) {","+  deps := newProposalsTest()","+  ctx := context.Background()","+","+  // A fact head to settle against.","+  factsAdv, err := advanceBrainFacts(ctx, deps, advanceInput(factsBranch, \"\", []byte(`{\"id\":\"fact:a\"}`)))","   if err != nil {","-    t.Fatalf(\"apply: %v\", err)","+    t.Fatalf(\"seed facts: %v\", err)","   }","-  if !applied.Body.Changed || applied.Body.Version != 1 || applied.Body.HeadRef != brainbuild.FactSetRef(blob) {","-    t.Fatalf(\"apply = %+v, want changed head v1 at %s\", applied.Body, brainbuild.FactSetRef(blob))","+  set := []brainProposal{","+    proposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\"),","+    proposalEntry(t, \"prop-bbbb\", \"merge\", \"fact:c\", \"fact:d\"),","   }","-  if applied.Body.Proposal.Status != brainbuild.ProposalStatusApplied {","-    t.Fatalf(\"proposal status = %q, want applied\", applied.Body.Proposal.Status)","+  pub, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", set))","+  if err != nil {","+    t.Fatalf(\"publish: %v\", err)","   }"," ","-  // The fact-sync read surface now serves it.","-  cur, err := currentBrainFacts(ctx, deps, &BrainFactsCurrentInput{RepoID: propsRepoID, Branch: propsBranch})","+  res, err := resolveBrainProposal(ctx, deps, resolveInput(","+    factsBranch, \"prop-aaaa\", \"accept\",","+    factsAdv.Body.NewRef, []byte(`{\"id\":\"fact:a\",\"resolved\":true}`),","+    pub.Body.Ref, set[1:],","+  ))","   if err != nil {","-    t.Fatalf(\"facts current: %v\", err)","+    t.Fatalf(\"resolve: %v\", err)","   }","-  if !cur.Body.Found || !bytes.Equal(cur.Body.Data, blob) {","-    t.Fatalf(\"facts current = %+v, want the applied blob\", cur.Body)","+  if res.Body.FactsRef == factsAdv.Body.NewRef {","+    t.Fatal(\"accept did not advance the fact head\")","   }","+  if res.Body.ProposalsRef == pub.Body.Ref {","+    t.Fatal(\"resolve did not advance the proposal set\")","+  }"," ","-  // Re-applying is 409 (no longer open), not a second advance.","-  if _, err := applyBrainProposal(ctx, deps, &BrainProposalApplyInput{RepoID: propsRepoID, ProposalID: id}); statusOf(t, err) != 409 {","-    t.Fatalf(\"re-apply status = %d, want 409\", statusOf(t, err))","+  after, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch})","+  if err != nil {","+    t.Fatal(err)","   }","-  // Rejecting an applied proposal is 409 too.","-  if _, err := rejectBrainProposal(ctx, deps, rejectProposalInput(id, \"too late\")); statusOf(t, err) != 409 {","-    t.Fatalf(\"reject(applied) status = %d, want 409\", statusOf(t, err))","+  if len(after.Body.Proposals) != 1 || after.Body.Proposals[0].ID != \"prop-bbbb\" {","+    t.Fatalf(\"settled entry was not removed from the set: %+v\", after.Body.Proposals)","   }"," }"," ","-// TestProposalsApplyStaleBaseIs412: a proposal whose base head was overtaken maps","-// ErrFactRefConflict → 412, exactly like the direct advance endpoint's CAS mismatch.","-func TestProposalsApplyStaleBaseIs412(t *testing.T) {","+// TestProposalResolveFactsUnchangedPrunesWithoutTouchingFacts covers the orphan path:","+// a proposal whose facts are gone cannot be accepted, and reject changes no facts, so","+// the settlement must move ONLY the proposal set and leave the fact head exactly where","+// it was.","+func TestProposalResolveFactsUnchangedPrunesWithoutTouchingFacts(t *testing.T) {","+  deps := newProposalsTest()","   ctx := context.Background()","-  deps := newProposalsTest(propsSlug)"," ","-  // Seed a head, propose against it, then move the head on directly.","-  seed, err := advanceBrainFacts(ctx, deps, advanceInput(propsBranch, \"\", []byte(\"fact:a\\n\")))","+  factsAdv, err := advanceBrainFacts(ctx, deps, advanceInput(factsBranch, \"\", []byte(`{\"id\":\"fact:a\"}`)))","   if err != nil {","-    t.Fatalf(\"seed head: %v\", err)","+    t.Fatalf(\"seed facts: %v\", err)","   }","-  opened, err := openBrainProposal(ctx, deps, openProposalInput(propsBranch, seed.Body.NewRef, []byte(\"fact:a\\nfact:proposed\\n\")))","+  set := []brainProposal{proposalEntry(t, \"prop-orphan\", \"supersede\", \"fact:gone\", \"fact:alsogone\")}","+  pub, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", set))","   if err != nil {","-    t.Fatalf(\"open: %v\", err)","+    t.Fatalf(\"publish: %v\", err)","   }","-  if _, err := advanceBrainFacts(ctx, deps, advanceInput(propsBranch, seed.Body.NewRef, []byte(\"fact:a\\nfact:direct\\n\"))); err != nil {","-    t.Fatalf(\"direct advance: %v\", err)","-  }"," ","-  _, err = applyBrainProposal(ctx, deps, &BrainProposalApplyInput{RepoID: propsRepoID, ProposalID: opened.Body.Proposal.ID})","-  if got := statusOf(t, err); got != 412 {","-    t.Fatalf(\"apply(stale base) status = %d, want 412\", got)","-  }","-  // Still open: 412 means \"re-base\", not \"discarded\".","-  list, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: propsRepoID, Limit: 50})","+  in := resolveInput(factsBranch, \"prop-orphan\", \"reject\", factsAdv.Body.NewRef, nil, pub.Body.Ref, nil)","+  in.Body.FactsUnchanged = true","+  res, err := resolveBrainProposal(ctx, deps, in)","   if err != nil {","-    t.Fatalf(\"list: %v\", err)","+    t.Fatalf(\"prune: %v\", err)","   }","-  if len(list.Body.Proposals) != 1 {","-    t.Fatalf(\"open set = %d after a 412, want the proposal still open\", len(list.Body.Proposals))","+  if res.Body.FactsRef != factsAdv.Body.NewRef {","+    t.Fatalf(\"prune moved the fact head: %q -> %q\", factsAdv.Body.NewRef, res.Body.FactsRef)","   }","-}"," ","-// TestProposalsRejectLeavesHeadUntouched: reject closes the proposal, records the","-// reason, and never advances the branch.","-func TestProposalsRejectLeavesHeadUntouched(t *testing.T) {","-  ctx := context.Background()","-  deps := newProposalsTest(propsSlug)","-","-  opened, err := openBrainProposal(ctx, deps, openProposalInput(propsBranch, \"\", []byte(\"fact:junk\\n\")))","+  cur, err := currentBrainFacts(ctx, deps, currentInput(factsBranch))","   if err != nil {","-    t.Fatalf(\"open: %v\", err)","+    t.Fatal(err)","   }","-  rejected, err := rejectBrainProposal(ctx, deps, rejectProposalInput(opened.Body.Proposal.ID, \"not durable\"))","-  if err != nil {","-    t.Fatalf(\"reject: %v\", err)","+  if cur.Body.Ref != factsAdv.Body.NewRef {","+    t.Fatalf(\"fact head changed behind a facts-unchanged prune: %q\", cur.Body.Ref)","   }","-  if rejected.Body.Proposal.Status != brainbuild.ProposalStatusRejected || rejected.Body.Proposal.Reason != \"not durable\" {","-    t.Fatalf(\"rejected = %+v, want rejected with the reason\", rejected.Body.Proposal)","-  }","-  cur, err := currentBrainFacts(ctx, deps, &BrainFactsCurrentInput{RepoID: propsRepoID, Branch: propsBranch})","+  after, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch})","   if err != nil {","-    t.Fatalf(\"facts current: %v\", err)","+    t.Fatal(err)","   }","-  if cur.Body.Found {","-    t.Fatal(\"a rejected proposal created a fact-set head\")","+  if len(after.Body.Proposals) != 0 {","+    t.Fatalf(\"orphan was not pruned: %+v\", after.Body.Proposals)","   }","-  // Re-rejecting is 409.","-  if _, err := rejectBrainProposal(ctx, deps, rejectProposalInput(opened.Body.Proposal.ID, \"again\")); statusOf(t, err) != 409 {","-    t.Fatalf(\"re-reject status = %d, want 409\", statusOf(t, err))","-  }"," }"," ","-// TestProposalsValidationAndNotFound covers the client-error paths on every endpoint.","-func TestProposalsValidationAndNotFound(t *testing.T) {","-  ctx := context.Background()","-  deps := newProposalsTest(propsSlug)","-","-  if _, err := openBrainProposal(ctx, deps, openProposalInput(\"\", \"\", []byte(\"x\"))); statusOf(t, err) != 400 {","-    t.Fatalf(\"open(no branch) status = %d, want 400\", statusOf(t, err))","+// TestProposalResolveRejectsFactsUnchangedOnAccept guards the boundary: skipping the","+// fact write on an accept would retire the proposal while dropping its merge result.","+func TestProposalResolveRejectsFactsUnchangedOnAccept(t *testing.T) {","+  deps := newProposalsTest()","+  in := resolveInput(factsBranch, \"prop-aaaa\", \"accept\", \"\", nil, \"\", nil)","+  in.Body.FactsUnchanged = true","+  _, err := resolveBrainProposal(context.Background(), deps, in)","+  if err == nil {","+    t.Fatal(\"factsUnchanged with accept must be refused\")","   }","-  if _, err := openBrainProposal(ctx, deps, openProposalInput(propsBranch, \"\", nil)); statusOf(t, err) != 400 {","-    t.Fatalf(\"open(no data) status = %d, want 400\", statusOf(t, err))","+  if got := statusOf(t, err); got != http.StatusBadRequest {","+    t.Fatalf(\"status = %d, want 400\", got)","   }","-  if _, err := getBrainProposal(ctx, deps, &BrainProposalGetInput{RepoID: propsRepoID, ProposalID: \"\"}); statusOf(t, err) != 400 {","-    t.Fatalf(\"get(no id) status = %d, want 400\", statusOf(t, err))","-  }","-  if _, err := getBrainProposal(ctx, deps, &BrainProposalGetInput{RepoID: propsRepoID, ProposalID: \"prop-nope\"}); statusOf(t, err) != 404 {","-    t.Fatalf(\"get(unknown) status = %d, want 404\", statusOf(t, err))","-  }","-  if _, err := applyBrainProposal(ctx, deps, &BrainProposalApplyInput{RepoID: propsRepoID, ProposalID: \"prop-nope\"}); statusOf(t, err) != 404 {","-    t.Fatalf(\"apply(unknown) status = %d, want 404\", statusOf(t, err))","-  }","-  if _, err := rejectBrainProposal(ctx, deps, rejectProposalInput(\"prop-nope\", \"\")); statusOf(t, err) != 404 {","-    t.Fatalf(\"reject(unknown) status = %d, want 404\", statusOf(t, err))","-  }"," }"," ","-// TestProposalsUnresolvedRepoIs404 proves the fail-closed tenancy path: a repo the","-// resolver cannot map yields 404 on every endpoint, never a partial answer.","-func TestProposalsUnresolvedRepoIs404(t *testing.T) {","+// TestProposalResolveStaleSetRefConflicts: losing the proposal-set CAS is a 412 so","+// the runner re-reads and re-resolves rather than clobbering a concurrent settlement.","+func TestProposalResolveStaleSetRefConflicts(t *testing.T) {","+  deps := newProposalsTest()","   ctx := context.Background()","-  deps := newProposalsTest(\"\") // resolver yields no slug"," ","-  if _, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: propsRepoID, Limit: 50}); statusOf(t, err) != 404 {","-    t.Fatalf(\"list status = %d, want 404\", statusOf(t, err))","+  factsAdv, err := advanceBrainFacts(ctx, deps, advanceInput(factsBranch, \"\", []byte(`{\"id\":\"fact:a\"}`)))","+  if err != nil {","+    t.Fatal(err)","   }","-  if _, err := getBrainProposal(ctx, deps, &BrainProposalGetInput{RepoID: propsRepoID, ProposalID: \"prop-x\"}); statusOf(t, err) != 404 {","-    t.Fatalf(\"get status = %d, want 404\", statusOf(t, err))","+  set := []brainProposal{proposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\")}","+  pub, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", set))","+  if err != nil {","+    t.Fatal(err)","   }","-  if _, err := openBrainProposal(ctx, deps, openProposalInput(propsBranch, \"\", []byte(\"x\"))); statusOf(t, err) != 404 {","-    t.Fatalf(\"open status = %d, want 404\", statusOf(t, err))","+  // Someone else moves the set first.","+  if _, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, pub.Body.Ref,","+    []brainProposal{proposalEntry(t, \"prop-zzzz\", \"merge\", \"fact:y\", \"fact:z\")})); err != nil {","+    t.Fatal(err)","   }","-  if _, err := applyBrainProposal(ctx, deps, &BrainProposalApplyInput{RepoID: propsRepoID, ProposalID: \"prop-x\"}); statusOf(t, err) != 404 {","-    t.Fatalf(\"apply status = %d, want 404\", statusOf(t, err))","+  _, err = resolveBrainProposal(ctx, deps, resolveInput(","+    factsBranch, \"prop-aaaa\", \"accept\",","+    factsAdv.Body.NewRef, []byte(`{\"id\":\"fact:a\",\"resolved\":true}`),","+    pub.Body.Ref, nil, // stale set ref","+  ))","+  if err == nil {","+    t.Fatal(\"a stale proposalsOldRef must not win\")","   }","-  if _, err := rejectBrainProposal(ctx, deps, rejectProposalInput(\"prop-x\", \"\")); statusOf(t, err) != 404 {","-    t.Fatalf(\"reject status = %d, want 404\", statusOf(t, err))","+  if got := statusOf(t, err); got != http.StatusPreconditionFailed {","+    t.Fatalf(\"status = %d, want 412\", got)","   }"," }"," ","-// TestProposalsNilStoreUnavailable: hosted brain not configured → 503 everywhere.","+// TestProposalsNilStoreUnavailable: an unconfigured queue fails closed with 503 on","+// every endpoint rather than pretending the set is empty."," func TestProposalsNilStoreUnavailable(t *testing.T) {","-  ctx := context.Background()","   deps := &RepoActivityDeps{} // Proposals nil","-","-  if _, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: propsRepoID}); statusOf(t, err) != 503 {","-    t.Fatalf(\"list status = %d, want 503\", statusOf(t, err))","+  ctx := context.Background()","+  if _, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch}); err == nil {","+    t.Fatal(\"list with no store must fail\")","+  } else if got := statusOf(t, err); got != http.StatusServiceUnavailable {","+    t.Fatalf(\"list status = %d, want 503\", got)","   }","-  if _, err := getBrainProposal(ctx, deps, &BrainProposalGetInput{RepoID: propsRepoID, ProposalID: \"prop-x\"}); statusOf(t, err) != 503 {","-    t.Fatalf(\"get status = %d, want 503\", statusOf(t, err))","+  if _, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", nil)); err == nil {","+    t.Fatal(\"publish with no store must fail\")","+  } else if got := statusOf(t, err); got != http.StatusServiceUnavailable {","+    t.Fatalf(\"publish status = %d, want 503\", got)","   }","-  if _, err := openBrainProposal(ctx, deps, openProposalInput(propsBranch, \"\", []byte(\"x\"))); statusOf(t, err) != 503 {","-    t.Fatalf(\"open status = %d, want 503\", statusOf(t, err))","-  }","-  if _, err := applyBrainProposal(ctx, deps, &BrainProposalApplyInput{RepoID: propsRepoID, ProposalID: \"prop-x\"}); statusOf(t, err) != 503 {","-    t.Fatalf(\"apply status = %d, want 503\", statusOf(t, err))","-  }","-  if _, err := rejectBrainProposal(ctx, deps, rejectProposalInput(\"prop-x\", \"\")); statusOf(t, err) != 503 {","-    t.Fatalf(\"reject status = %d, want 503\", statusOf(t, err))","-  }"," }"," ","-// TestProposalsListLimitClamped: an over-large page request is clamped to","-// maxOpenProposals rather than serving an unbounded queue.","-func TestProposalsListLimitClamped(t *testing.T) {","+// TestProposalGetReportsAbsentAsFound false, not 404: \"settled by someone else\" is a","+// normal answer a reconciling client must be able to tell from a failed request.","+func TestProposalGetReportsAbsentAsFound(t *testing.T) {","+  deps := newProposalsTest()","   ctx := context.Background()","-  deps := newProposalsTest(propsSlug)","-  for _, fact := range []string{\"a\", \"b\", \"c\"} {","-    if _, err := openBrainProposal(ctx, deps, openProposalInput(propsBranch, \"\", []byte(\"fact:\"+fact+\"\\n\"))); err != nil {","-      t.Fatalf(\"open %s: %v\", fact, err)","-    }","+  set := []brainProposal{proposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\")}","+  if _, err := publishBrainProposals(ctx, deps, publishInput(factsBranch, \"\", set)); err != nil {","+    t.Fatal(err)","   }","-  // limit above the cap still succeeds (clamped, not rejected).","-  all, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: propsRepoID, Limit: maxOpenProposals * 10})","+  got, err := getBrainProposal(ctx, deps, &BrainProposalGetInput{RepoID: factsRepoID, ProposalID: \"prop-missing\", Branch: factsBranch})","   if err != nil {","-    t.Fatalf(\"list(over-cap): %v\", err)","+    t.Fatalf(\"absent proposal must not be an error: %v\", err)","   }","-  if len(all.Body.Proposals) != 3 {","-    t.Fatalf(\"list(over-cap) = %d, want 3\", len(all.Body.Proposals))","+  if got.Body.Found || got.Body.Proposal != nil {","+    t.Fatalf(\"absent proposal reported as found: %+v\", got.Body)","   }","-  // A single-entry page returns the OLDEST proposal (queue order).","-  one, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: propsRepoID, Limit: 1})","+  present, err := getBrainProposal(ctx, deps, &BrainProposalGetInput{RepoID: factsRepoID, ProposalID: \"prop-aaaa\", Branch: factsBranch})","   if err != nil {","-    t.Fatalf(\"list(limit 1): %v\", err)","+    t.Fatal(err)","   }","-  if len(one.Body.Proposals) != 1 || one.Body.Proposals[0].ContentRef != brainbuild.FactSetRef([]byte(\"fact:a\\n\")) {","-    t.Fatalf(\"list(limit 1) = %+v, want the oldest proposal\", one.Body.Proposals)","+  if !present.Body.Found || present.Body.Proposal == nil {","+    t.Fatalf(\"present proposal not returned: %+v\", present.Body)","   }"," }","-","-// proposalRoutes are the five routes with the gate each must enforce.","-var proposalRoutes = []struct {","-  name   string","-  method string","-  path   string","-  body   string","-  // push reports whether the route requires repo PUSH (else repo pull suffices).","-  push bool","-}{","-  {\"list\", http.MethodGet, \"/brain/proposals\", \"\", false},","-  {\"get\", http.MethodGet, \"/brain/proposals/prop-x\", \"\", false},","-  {\"open\", http.MethodPost, \"/brain/proposals\", `{\"branch\":\"main\",\"data\":\"ZmFjdDphCg==\"}`, true},","-  {\"apply\", http.MethodPost, \"/brain/proposals/prop-x/apply\", `{}`, true},","-  {\"reject\", http.MethodPost, \"/brain/proposals/prop-x/reject\", `{\"reason\":\"no\"}`, true},","-}","-","-// TestProposalRoutesAuthz drives every proposal route through the real router + JWT","-// auth + the SpiceDB double: an unauthenticated caller is 401 everywhere, and a","-// pull-only caller is 403 on each of the three write routes (which is the check that","-// would silently pass if a write route were registered on the read gate). All are","-// deny paths that short-circuit before the repo store, so no Postgres is needed.","-func TestProposalRoutesAuthz(t *testing.T) {","-  authn, mint := jwksAuth(t)","-  base := baseDeps{Authenticator: authn, Reader: fakeReaderRW([]string{propsRepoID}, nil, nil, false)} // pull only","-  repoDeps := newProposalsTest(propsSlug)","-  repoDeps.baseDeps = base","-  userDeps := &UserActivityDeps{baseDeps: base, Store: fakeUserReader{}}","-  r := NewActivityAPIRouter(repoDeps, userDeps)","-","-  do := func(method, path, body, token string) int {","-    var rdr *bytes.Reader","-    if body == \"\" {","-      rdr = bytes.NewReader(nil)","-    } else {","-      rdr = bytes.NewReader([]byte(body))","-    }","-    req := httptest.NewRequest(method, \"/api/v1/repos/\"+propsRepoID+path, rdr)","-    req.Header.Set(\"Content-Type\", \"application/json\")","-    if token != \"\" {","-      req.Header.Set(\"Authorization\", \"Bearer \"+token)","-    }","-    w := httptest.NewRecorder()","-    r.HTTPHandler().ServeHTTP(w, req)","-    return w.Code","-  }","-","-  for _, rt := range proposalRoutes {","-    // No token → 401 on every route, read or write.","-    if got := do(rt.method, rt.path, rt.body, \"\"); got != http.StatusUnauthorized {","-      t.Fatalf(\"%s with no token = %d, want 401\", rt.name, got)","-    }","-    got := do(rt.method, rt.path, rt.body, mint(routeULID(\"acc1\")))","-    if rt.push {","-      if got != http.StatusForbidden {","-        t.Fatalf(\"%s as pull-only caller = %d, want 403 (push required)\", rt.name, got)","-      }","-      continue","-    }","-    // A pull-only caller passes the READ gate (so it must NOT be 401/403); what it","-    // gets afterwards is the handler's own answer.","-    if got == http.StatusUnauthorized || got == http.StatusForbidden {","-      t.Fatalf(\"%s as pull-capable caller = %d, want the read gate to admit it\", rt.name, got)","-    }","-  }","-}","-","-// TestProposalCrossTenantDenied: a caller authorized on ANOTHER repo is 403 on every","-// proposal route for this repo — the authz half of ADR-0004's two isolation layers","-// (the store half is covered by TestProposalTenantIsolation in brainbuild).","-func TestProposalCrossTenantDenied(t *testing.T) {","-  const otherRepoID = \"01BX5ZZKBKACTAV9WEVGEMMVRZ\"","-  authn, mint := jwksAuth(t)","-  // The caller can pull AND push a DIFFERENT repo, and nothing on propsRepoID.","-  base := baseDeps{Authenticator: authn, Reader: fakeReaderRW([]string{otherRepoID}, []string{otherRepoID}, nil, false)}","-  repoDeps := newProposalsTest(propsSlug)","-  repoDeps.baseDeps = base","-  userDeps := &UserActivityDeps{baseDeps: base, Store: fakeUserReader{}}","-  r := NewActivityAPIRouter(repoDeps, userDeps)","-","-  token := mint(routeULID(\"acc1\"))","-  for _, rt := range proposalRoutes {","-    req := httptest.NewRequest(rt.method, \"/api/v1/repos/\"+propsRepoID+rt.path, bytes.NewReader([]byte(rt.body)))","-    req.Header.Set(\"Content-Type\", \"application/json\")","-    req.Header.Set(\"Authorization\", \"Bearer \"+token)","-    w := httptest.NewRecorder()","-    r.HTTPHandler().ServeHTTP(w, req)","-    if w.Code != http.StatusForbidden {","-      t.Fatalf(\"%s as cross-tenant caller = %d, want 403\", rt.name, w.Code)","-    }","-  }","-}","-","-// TestProposalOpenBodyCapIsGenerous documents that the open op carries the same","-// generous cap as publish/advance (a proposed fact-set arrives base64-encoded), not","-// huma's 1 MiB default.","-func TestProposalOpenBodyCapIsGenerous(t *testing.T) {","-  op := teamOp(\"repoBrainProposalOpen\", http.MethodPost, \"/repos/{repo_id}/brain/proposals\", \"x\", \"brain\", []opMiddleware{})","-  op.MaxBodyBytes = maxBrainArtifactBytes","-  if op.MaxBodyBytes <= 1<<20 {","-    t.Fatalf(\"op.MaxBodyBytes = %d, must exceed huma's 1 MiB default\", op.MaxBodyBytes)","-  }","-}","-","-// TestProposalWireShapeOmitsEmpties keeps the JSON contract stable: an open proposal","-// carries no applied/reason fields.","-func TestProposalWireShapeOmitsEmpties(t *testing.T) {","-  raw, err := json.Marshal(wireProposal(brainbuild.Proposal{","-    ID: \"prop-x\", Branch: \"main\", ContentRef: \"facts-a\", Status: brainbuild.ProposalStatusOpen,","-  }))","-  if err != nil {","-    t.Fatalf(\"marshal: %v\", err)","-  }","-  for _, absent := range []string{\"appliedRef\", \"appliedVersion\", \"reason\", \"baseRef\"} {","-    if bytes.Contains(raw, []byte(absent)) {","-      t.Fatalf(\"open proposal JSON carries %q: %s\", absent, raw)","-    }","-  }","-  for _, present := range []string{\"id\", \"branch\", \"contentRef\", \"status\"} {","-    if !bytes.Contains(raw, []byte(present)) {","-      t.Fatalf(\"proposal JSON missing %q: %s\", present, raw)","-    }","-  }","-}"]}],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"9ccce43c-eeb5-4916-9ac3-695424e7d896","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/p0p1/api-242","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
