{"parentUuid":"a5f33e16-ffd4-4b1e-9a13-6f6e78fbd3b0","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/suhaan/devenv/p0p1/api-242/internal/httpapi/brain_proposals_test.go","snippet":"1\tpackage httpapi\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"net/http\"\n7\t\t\"testing\"\n8\t\n9\t\t\"github.com/entirehq/entire-api/internal/brainbuild\"\n10\t\t\"github.com/entirehq/entire-api/internal/brainstore\"\n11\t\t\"github.com/entirehq/entire-api/internal/snapshotcrypt/snapshotcrypttest\"\n12\t)\n13\t\n14\t// newProposalsTest wires Mem-backed fact-set AND proposal-set heads behind\n15\t// RepoActivityDeps. They share the encrypting store (as production does) but hold\n16\t// SEPARATE ref indexes, which is the point: the two heads must move independently.\n17\tfunc newProposalsTest() *RepoActivityDeps {\n18\t\tinner := brainstore.NewMemStore()\n19\t\tenc := brainstore.NewEncryptingStore(inner, snapshotcrypttest.NewCipher(), brainstore.NewMemDEKStore())\n20\t\tresolver := fakeSlugResolver{slug: factsSlug}\n21\t\tfacts := brainbuild.NewFactSetStore(enc, brainbuild.NewMemFactRefIndex(), resolver)\n22\t\tproposals := brainbuild.NewProposalSetStore(enc, brainbuild.NewMemFactRefIndex(), resolver)\n23\t\treturn &RepoActivityDeps{Facts: facts, Proposals: proposals}\n24\t}\n25\t\n26\t// proposalEntry builds one set entry with the client's shape: a derived id plus an\n27\t// opaque proposal body the server never interprets.\n28\tfunc proposalEntry(t *testing.T, id, action, candidate, target string) brainProposal {\n29\t\tt.Helper()\n30\t\tbody, err := json.Marshal(map[string]any{\n31\t\t\t\"action\":       action,\n32\t\t\t\"candidate_id\": candidate,\n33\t\t\t\"target_id\":    target,\n34\t\t\t\"branch\":       factsBranch,\n35\t\t\t\"proposed_by\":  \"member-A\",\n36\t\t})\n37\t\tif err != nil {\n38\t\t\tt.Fatal(err)\n39\t\t}\n40\t\treturn brainProposal{ID: id, Proposal: body}\n41\t}\n42\t\n43\tfunc proposalPublishInput(branch, oldRef string, set []brainProposal) *BrainProposalsPublishInput {\n44\t\tin := &BrainProposalsPublishInput{RepoID: factsRepoID}\n45\t\tin.Body.Branch = branch\n46\t\tin.Body.OldRef = oldRef\n47\t\tin.Body.Proposals = set\n48\t\treturn in\n49\t}\n50\t\n51\tfunc resolveInput(branch, id, decision, factsOldRef string, data []byte, setOldRef string, remaining []brainProposal) *BrainProposalResolveInput {\n52\t\tin := &BrainProposalResolveInput{RepoID: factsRepoID, ProposalID: id}\n53\t\tin.Body.Branch = branch\n54\t\tin.Body.Decision = decision\n55\t\tin.Body.FactsOldRef = factsOldRef\n56\t\tin.Body.Data = data\n57\t\tin.Body.ProposalsOldRef = setOldRef\n58\t\tin.Body.Proposals = remaining\n59\t\treturn in\n60\t}\n61\t\n62\t// TestProposalsPublishThenList: an empty branch lists found=false with an empty set;\n63\t// after a publish the set round-trips through the CAS'd blob unchanged, including the\n64\t// opaque proposal body.\n65\tfunc TestProposalsPublishThenList(t *testing.T) {\n66\t\tdeps := newProposalsTest()\n67\t\tctx := context.Background()\n68\t\n69\t\tempty, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch})\n70\t\tif err != nil {\n71\t\t\tt.Fatalf(\"list empty: %v\", err)\n72\t\t}\n73\t\tif empty.Body.Found {\n74\t\t\tt.Fatal(\"a branch with no set must read found=false\")\n75\t\t}\n76\t\tif empty.Body.Proposals == nil || len(empty.Body.Proposals) != 0 {\n77\t\t\tt.Fatalf(\"empty set must be an empty array, not null: %+v\", empty.Body.Proposals)\n78\t\t}\n79\t\n80\t\tset := []brainProposal{proposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\")}\n81\t\tpub, err := publishBrainProposals(ctx, deps, proposalPublishInput(factsBranch, \"\", set))\n82\t\tif err != nil {\n83\t\t\tt.Fatalf(\"publish: %v\", err)\n84\t\t}\n85\t\tif !pub.Body.Changed || pub.Body.Ref == \"\" {\n86\t\t\tt.Fatalf(\"publish should have created a head: %+v\", pub.Body)\n87\t\t}\n88\t\n89\t\tgot, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch})\n90\t\tif err != nil {\n91\t\t\tt.Fatalf(\"list: %v\", err)\n92\t\t}\n93\t\tif !got.Body.Found || len(got.Body.Proposals) != 1 {\n94\t\t\tt.Fatalf(\"published set did not round-trip: %+v\", got.Body)\n95\t\t}\n96\t\tif got.Body.Proposals[0].ID != \"prop-aaaa\" {\n97\t\t\tt.Fatalf(\"client-derived id was not preserved: %q\", got.Body.Proposals[0].ID)\n98\t\t}\n99\t\t// The server must not reinterpret the proposal body.\n100\t\tvar decoded map[string]any\n101\t\tif err := json.Unmarshal(got.Body.Proposals[0].Proposal, &decoded); err != nil {\n102\t\t\tt.Fatalf(\"proposal body is not intact JSON: %v\", err)\n103\t\t}\n104\t\tif decoded[\"candidate_id\"] != \"fact:a\" || decoded[\"proposed_by\"] != \"member-A\" {\n105\t\t\tt.Fatalf(\"proposal body was altered: %+v\", decoded)\n106\t\t}\n107\t}\n108\t\n109\t// TestProposalsPublishStaleOldRefConflicts: a publish from a ref another member has\n110\t// already moved past must lose the CAS with 412, never clobber.\n111\tfunc TestProposalsPublishStaleOldRefConflicts(t *testing.T) {\n112\t\tdeps := newProposalsTest()\n113\t\tctx := context.Background()\n114\t\n115\t\tfirst, err := publishBrainProposals(ctx, deps, proposalPublishInput(factsBranch, \"\",\n116\t\t\t[]brainProposal{proposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\")}))\n117\t\tif err != nil {\n118\t\t\tt.Fatalf(\"first publish: %v\", err)\n119\t\t}\n120\t\tif _, err := publishBrainProposals(ctx, deps, proposalPublishInput(factsBranch, first.Body.Ref,\n121\t\t\t[]brainProposal{proposalEntry(t, \"prop-bbbb\", \"merge\", \"fact:c\", \"fact:d\")})); err != nil {\n122\t\t\tt.Fatalf(\"second publish: %v\", err)\n123\t\t}\n124\t\t// Third publish still quotes the FIRST ref: stale.\n125\t\t_, err = publishBrainProposals(ctx, deps, proposalPublishInput(factsBranch, first.Body.Ref,\n126\t\t\t[]brainProposal{proposalEntry(t, \"prop-cccc\", \"merge\", \"fact:e\", \"fact:f\")}))\n127\t\tif err == nil {\n128\t\t\tt.Fatal(\"a stale oldRef must not win the CAS\")\n129\t\t}\n130\t\tif got := statusOf(t, err); got != http.StatusPreconditionFailed {\n131\t\t\tt.Fatalf(\"stale publish status = %d, want 412\", got)\n132\t\t}\n133\t}\n134\t\n135\t// TestProposalResolveAdvancesBothHeads is the settlement path: the runner sends the\n136\t// resolved fact set and the remaining proposals, each under the ref it read, and both\n137\t// heads move together.\n138\tfunc TestProposalResolveAdvancesBothHeads(t *testing.T) {\n139\t\tdeps := newProposalsTest()\n140\t\tctx := context.Background()\n141\t\n142\t\t// A fact head to settle against.\n143\t\tfactsAdv, err := advanceBrainFacts(ctx, deps, advanceInput(factsBranch, \"\", []byte(`{\"id\":\"fact:a\"}`)))\n144\t\tif err != nil {\n145\t\t\tt.Fatalf(\"seed facts: %v\", err)\n146\t\t}\n147\t\tset := []brainProposal{\n148\t\t\tproposalEntry(t, \"prop-aaaa\", \"supersede\", \"fact:a\", \"fact:b\"),\n149\t\t\tproposalEntry(t, \"prop-bbbb\", \"merge\", \"fact:c\", \"fact:d\"),\n150\t\t}\n151\t\tpub, err := publishBrainProposals(ctx, deps, proposalPublishInput(factsBranch, \"\", set))\n152\t\tif err != nil {\n153\t\t\tt.Fatalf(\"publish: %v\", err)\n154\t\t}\n155\t\n156\t\tres, err := resolveBrainProposal(ctx, deps, resolveInput(\n157\t\t\tfactsBranch, \"prop-aaaa\", \"accept\",\n158\t\t\tfactsAdv.Body.NewRef, []byte(`{\"id\":\"fact:a\",\"resolved\":true}`),\n159\t\t\tpub.Body.Ref, set[1:],\n160\t\t))\n161\t\tif err != nil {\n162\t\t\tt.Fatalf(\"resolve: %v\", err)\n163\t\t}\n164\t\tif res.Body.FactsRef == factsAdv.Body.NewRef {\n165\t\t\tt.Fatal(\"accept did not advance the fact head\")\n166\t\t}\n167\t\tif res.Body.ProposalsRef == pub.Body.Ref {\n168\t\t\tt.Fatal(\"resolve did not advance the proposal set\")\n169\t\t}\n170\t\n171\t\tafter, err := listBrainProposals(ctx, deps, &BrainProposalsListInput{RepoID: factsRepoID, Branch: factsBranch})\n172\t\tif err != nil {\n173\t\t\tt.Fatal(err)\n174\t\t}\n175\t\tif len(after.Body.Proposals) != 1 || after.Body.Proposals[0].ID != \"prop-bbbb\" {\n176\t\t\tt.Fatalf(\"settled entry was not removed from the set: %+v\", after.Body.Proposals)\n177\t\t}\n178\t}\n179\t\n180\t// TestProposalResolveFactsUnchangedPrunesWithoutTouchingFacts covers the orphan path:\n181\t// a proposal whose facts are gone cannot be accepted, and reject changes no facts, so\n182\t// the settlement must move ONLY the proposal set and leave the fact head exactly where\n183\t// it was.\n184\tfunc TestProposalResolveFactsUnchangedPrunesWithoutTouchingFacts(t *testing.T) {\n185\t\tdeps := newProposalsTest()\n186\t\tctx := context.Background()\n187\t\n188\t\tfactsAdv, err := advanceBrainFacts(ctx, deps, advanceInput(factsBranch, \"\", []byte(`{\"id\":\"fact:a\"}`)))\n189\t\tif err != nil {\n190\t\t\tt.Fatalf(\"seed facts: %v\", err)\n191\t\t}\n192\t\tset := []brainProposal{proposalEntry(t, \"prop-orphan\", \"supersede\", \"fact:gone\", \"fact:alsogone\")}\n193\t\tpub, err := publishBrainProposals(ctx, deps, proposalPublishInput(factsBranch, \"\", set))\n194\t\tif err != nil {\n195\t\t\tt.Fatalf(\"publish: %v\", err)\n196\t\t}\n197\t\n\n... [115 lines truncated] ..."},"type":"attachment","uuid":"4180e3e5-6fb9-45b9-8278-444bf18882e5","timestamp":"2026-08-17T17:38:26.190Z","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/p0p1/api-242","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
