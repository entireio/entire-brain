{"parentUuid":"47092b3d-5179-456f-80db-c97572c15651","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/suhaan/devenv/p0p1/p1-new/internal/factsync/orphan_prune_test.go","snippet":"1\tpackage factsync\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"testing\"\n7\t\t\"time\"\n8\t\n9\t\t\"github.com/ashtom/entire-brain/internal/factmerge\"\n10\t)\n11\t\n12\t// orphanServer models the state that made a proposal unremovable: an open proposal\n13\t// set whose fact head is gone entirely (both facts retracted and GC'd).\n14\ttype orphanServer struct {\n15\t\tset       []OpenProposal\n16\t\tsetRef    string\n17\t\tresolved  []ResolveProposalRequest\n18\t\tfactsHead []byte // nil = no head at all\n19\t}\n20\t\n21\tfunc (s *orphanServer) Current(context.Context, string, string) (string, []byte, bool, error) {\n22\t\tif len(s.factsHead) == 0 {\n23\t\t\treturn \"\", nil, false, nil\n24\t\t}\n25\t\treturn \"facts-1\", s.factsHead, true, nil\n26\t}\n27\t\n28\tfunc (s *orphanServer) Advance(context.Context, string, string, string, []byte) (string, error) {\n29\t\treturn \"\", errors.New(\"orphanServer: Advance must not be called for a reject-prune\")\n30\t}\n31\t\n32\tfunc (s *orphanServer) ListProposals(context.Context, string, string) (ProposalSet, error) {\n33\t\treturn ProposalSet{Branch: \"main\", Ref: s.setRef, Found: true, Proposals: s.set}, nil\n34\t}\n35\t\n36\tfunc (s *orphanServer) GetProposal(_ context.Context, _, _, id string) (OpenProposal, error) {\n37\t\tfor _, p := range s.set {\n38\t\t\tif p.ID == id {\n39\t\t\t\treturn p, nil\n40\t\t\t}\n41\t\t}\n42\t\treturn OpenProposal{}, ErrProposalNotFound\n43\t}\n44\t\n45\tfunc (s *orphanServer) PublishProposals(context.Context, string, string, string, []OpenProposal) (string, error) {\n46\t\treturn s.setRef, nil\n47\t}\n48\t\n49\tfunc (s *orphanServer) ResolveProposal(_ context.Context, req ResolveProposalRequest) (ResolveProposalResponse, error) {\n50\t\ts.resolved = append(s.resolved, req)\n51\t\t// The prune writes the proposal set only; the fact head must stay where it was.\n52\t\treturn ResolveProposalResponse{FactsRef: req.FactsOldRef, ProposalsRef: \"props-2\", Changed: true}, nil\n53\t}\n54\t\n55\t// TestResolveOpenPrunesOrphanOnReject is the regression for the unremovable-orphan\n56\t// defect. A proposal whose fact head has vanished cannot be accepted, and reject\n57\t// used to be blocked too — the empty-head guard returned before the reject path and\n58\t// pushing an empty fact set is refused on purpose — so the entry sat in every\n59\t// member's open list forever with no way out.\n60\tfunc TestResolveOpenPrunesOrphanOnReject(t *testing.T) {\n61\t\tp := factmerge.Proposal{\n62\t\t\tAction: factmerge.ActionSupersede, CandidateID: \"fact:aaa\", TargetID: \"fact:bbb\",\n63\t\t\tBranch: \"main\", ProposedBy: \"member-A\",\n64\t\t}\n65\t\topen := OpenProposals([]factmerge.Proposal{p})\n66\t\tsrv := &orphanServer{set: open, setRef: \"props-1\"} // factsHead nil: head is gone\n67\t\n68\t\tres, err := ResolveOpen(context.Background(), srv, \"repo-1\", \"main\", open[0].ID, Reject, time.Now().UTC())\n69\t\tif err != nil {\n70\t\t\tt.Fatalf(\"reject on an absent fact head must prune, got: %v\", err)\n71\t\t}\n72\t\tif res.Remaining != 0 {\n73\t\t\tt.Fatalf(\"orphan was not removed from the set: remaining=%d\", res.Remaining)\n74\t\t}\n75\t\tif len(srv.resolved) != 1 {\n76\t\t\tt.Fatalf(\"expected exactly one resolve call, got %d\", len(srv.resolved))\n77\t\t}\n78\t\tgot := srv.resolved[0]\n79\t\tif !got.FactsUnchanged {\n80\t\t\tt.Fatal(\"prune must set FactsUnchanged so the server leaves the fact head alone\")\n81\t\t}\n82\t\tif len(got.Facts) != 0 {\n83\t\t\tt.Fatalf(\"prune must not push facts, got %d record(s)\", len(got.Facts))\n84\t\t}\n85\t\tif len(got.Remaining) != 0 {\n86\t\t\tt.Fatalf(\"prune must drop the entry from the remaining set, got %d\", len(got.Remaining))\n87\t\t}\n88\t}\n89\t\n90\t// TestResolveOpenStillRefusesAcceptOnAbsentHead pins the other half: the prune path\n91\t// must not become a way to \"settle\" an accept with no facts, which would retire the\n92\t// proposal while silently dropping the merge result.\n93\tfunc TestResolveOpenStillRefusesAcceptOnAbsentHead(t *testing.T) {\n94\t\tp := factmerge.Proposal{\n95\t\t\tAction: factmerge.ActionMerge, CandidateID: \"fact:aaa\", TargetID: \"fact:bbb\",\n96\t\t\tBranch: \"main\", ProposedBy: \"member-A\",\n97\t\t}\n98\t\topen := OpenProposals([]factmerge.Proposal{p})\n99\t\tsrv := &orphanServer{set: open, setRef: \"props-1\"}\n100\t\n101\t\t_, err := ResolveOpen(context.Background(), srv, \"repo-1\", \"main\", open[0].ID, Accept, time.Now().UTC())\n102\t\tif !errors.Is(err, ErrProposalNotApplicable) {\n103\t\t\tt.Fatalf(\"accept with no fact head must fail loudly, got: %v\", err)\n104\t\t}\n105\t\tif len(srv.resolved) != 0 {\n106\t\t\tt.Fatalf(\"accept must not reach the server with no facts, got %d call(s)\", len(srv.resolved))\n107\t\t}\n108\t}\n109\t\n110\t// TestHTTPResolveRejectsFactsUnchangedOnAccept guards the wire: factsUnchanged is a\n111\t// reject-only prune signal, and must never let an accept skip its fact write.\n112\tfunc TestHTTPResolveRejectsFactsUnchangedOnAccept(t *testing.T) {\n113\t\th := &HTTPServer{}\n114\t\t_, err := h.ResolveProposal(context.Background(), ResolveProposalRequest{\n115\t\t\tRepoID: \"repo-1\", Branch: \"main\", ProposalID: \"prop-x\",\n116\t\t\tDecision: Accept, FactsUnchanged: true,\n117\t\t})\n118\t\tif err == nil {\n119\t\t\tt.Fatal(\"factsUnchanged with accept must be refused before any request is sent\")\n120\t\t}\n121\t}"},"type":"attachment","uuid":"864a40b3-58e5-4e49-ba3d-09775948f8f8","timestamp":"2026-08-17T15:19:29.740Z","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/p0p1/p1-new","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
