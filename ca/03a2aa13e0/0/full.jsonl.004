{"parentUuid":"fc3f03e5-d0f4-4965-b4e0-174eba9b93cf","isSidechain":false,"message":{"model":"claude-opus-5","id":"msg_011Ce8ipSrm4UcvirQgenP3A","type":"message","role":"assistant","content":[{"type":"text","text":"Contract fully captured. Writing the new handler layer:"}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1500,"cache_read_input_tokens":853766,"output_tokens":5406,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1500,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":5406,"cache_read_input_tokens":853766,"cache_creation_input_tokens":1500,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1500},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011Ce8ipE8HygH7E5fyu7KAn","type":"assistant","uuid":"8e8f7e6c-7552-45ab-aa25-cd9f844c7f40","timestamp":"2026-08-17T17:33:33.120Z","effort":"xhigh","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/p0p1/p1-new","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
{"parentUuid":"8e8f7e6c-7552-45ab-aa25-cd9f844c7f40","isSidechain":false,"message":{"model":"claude-opus-5","id":"msg_011Ce8ipSrm4UcvirQgenP3A","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WveXy8eXTg563v8ZyN7mP4","name":"Write","input":{"file_path":"/Users/suhaan/devenv/p0p1/api-242/internal/httpapi/brain_proposals.go","content":"package httpapi\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"net/http\"\n\t\"strings\"\n\n\t\"github.com/danielgtaylor/huma/v2\"\n\n\t\"github.com/entirehq/entire-api/internal/brainbuild\"\n)\n\n// The OPEN PROPOSAL SET surface: the review queue in front of a branch's durable\n// fact-set head, served as ONE compare-and-swapped blob rather than a row per\n// proposal.\n//\n// The shape is dictated by ADR-P1-E: the merge runs on the runner. The runner reads\n// the fact head and the open set, computes the resolution locally, and swaps BOTH\n// back under the refs it read. This server never interprets a proposal — it stores\n// bytes and moves pointers. A row model would force the server to re-derive which\n// entries survive a resolution, which is merge logic, and a second implementation of\n// merge logic is exactly the divergence the wire contract exists to prevent. It would\n// also fork proposal identity: ids are derived by the client from the proposal's own\n// fields, and a server-side id derived from storage coordinates could never match.\n//\n// Paths sit under the fact-set family (/brain/facts/proposals) because the set IS the\n// fact set's review queue, and the client addresses it there.\n\n// brainProposal is one entry in the set. The server treats Proposal as opaque JSON:\n// only the client derives or interprets it, so a newer client may add fields without\n// a server change.\ntype brainProposal struct {\n\tID       string          `json:\"id\"`\n\tProposal json.RawMessage `json:\"proposal\"`\n}\n\n// BrainProposalsListInput is GET /repos/{repo_id}/brain/facts/proposals?branch=\ntype BrainProposalsListInput struct {\n\tRepoID string `path:\"repo_id\"`\n\tBranch string `query:\"branch\"`\n}\n\n// BrainProposalsListOutput is the branch's open set at the ref it was read at. Found\n// is false — with an empty list, not an error — when the branch has no set yet: a\n// branch with no cross-member conflict simply has nothing to review.\ntype BrainProposalsListOutput struct {\n\tBody struct {\n\t\tFound     bool            `json:\"found\"`\n\t\tRef       string          `json:\"ref\"`\n\t\tVersion   int64           `json:\"version\"`\n\t\tProposals []brainProposal `json:\"proposals\"`\n\t}\n}\n\n// BrainProposalGetInput is GET /repos/{repo_id}/brain/facts/proposals/{proposal_id}\ntype BrainProposalGetInput struct {\n\tRepoID     string `path:\"repo_id\"`\n\tProposalID string `path:\"proposal_id\"`\n\tBranch     string `query:\"branch\"`\n}\n\n// BrainProposalGetOutput carries the entry when present. found=false is a normal\n// answer (settled by someone else meanwhile), not a 404, so a client reconciling its\n// local queue can tell \"gone\" from \"the request failed\".\ntype BrainProposalGetOutput struct {\n\tBody struct {\n\t\tFound    bool           `json:\"found\"`\n\t\tRef      string         `json:\"ref\"`\n\t\tProposal *brainProposal `json:\"proposal\"`\n\t}\n}\n\n// BrainProposalsPublishInput is POST /repos/{repo_id}/brain/facts/proposals — replace\n// the whole set under CAS. OldRef is the ref the caller read; empty means \"no set\n// yet\" (a create).\ntype BrainProposalsPublishInput struct {\n\tRepoID string `path:\"repo_id\"`\n\tBody   struct {\n\t\tBranch    string          `json:\"branch\"`\n\t\tOldRef    string          `json:\"oldRef\"`\n\t\tProposals []brainProposal `json:\"proposals\"`\n\t}\n}\n\n// BrainProposalsPublishOutput reports the new head. Changed is false when the set was\n// byte-identical to the current one, in which case Ref/Version echo the head that\n// already existed — a no-op, not a failure, so a republish is idempotent.\ntype BrainProposalsPublishOutput struct {\n\tBody struct {\n\t\tRef     string `json:\"ref\"`\n\t\tVersion int64  `json:\"version\"`\n\t\tChanged bool   `json:\"changed\"`\n\t}\n}\n\n// BrainProposalResolveInput is POST .../proposals/{proposal_id}/resolve: the runner's\n// computed settlement, compare-and-swapping BOTH heads from the refs it read.\ntype BrainProposalResolveInput struct {\n\tRepoID     string `path:\"repo_id\"`\n\tProposalID string `path:\"proposal_id\"`\n\tBody       struct {\n\t\tBranch      string `json:\"branch\"`\n\t\tDecision    string `json:\"decision\"`\n\t\tFactsOldRef string `json:\"factsOldRef\"`\n\t\tData        []byte `json:\"data\"`\n\t\t// FactsUnchanged settles WITHOUT touching the fact head. It is how an orphaned\n\t\t// proposal — one whose facts are gone entirely — is pruned: it cannot be\n\t\t// accepted, and reject changes no facts, so the only write it needs is the set.\n\t\t// Valid only with decision=reject; Data is then empty and must NOT be read as\n\t\t// \"empty the fact set\".\n\t\tFactsUnchanged  bool            `json:\"factsUnchanged\"`\n\t\tProposalsOldRef string          `json:\"proposalsOldRef\"`\n\t\tProposals       []brainProposal `json:\"proposals\"`\n\t}\n}\n\n// BrainProposalResolveOutput reports where both heads landed.\ntype BrainProposalResolveOutput struct {\n\tBody struct {\n\t\tFactsRef     string `json:\"factsRef\"`\n\t\tProposalsRef string `json:\"proposalsRef\"`\n\t\tChanged      bool   `json:\"changed\"`\n\t}\n}\n\n// decodeProposalSet reads a stored set blob. An empty blob is an empty set.\nfunc decodeProposalSet(plaintext []byte) ([]brainProposal, error) {\n\tif len(plaintext) == 0 {\n\t\treturn nil, nil\n\t}\n\tvar out []brainProposal\n\tif err := json.Unmarshal(plaintext, &out); err != nil {\n\t\treturn nil, err\n\t}\n\treturn out, nil\n}\n\n// encodeProposalSet renders a set for storage. An explicit empty array is stored\n// rather than null so the last resolution CLEARS the set with content a head can\n// point at (a head always points at content).\nfunc encodeProposalSet(in []brainProposal) ([]byte, error) {\n\tif in == nil {\n\t\tin = []brainProposal{}\n\t}\n\treturn json.Marshal(in)\n}\n\n// listBrainProposals returns the branch's open set (repo pull).\nfunc listBrainProposals(ctx context.Context, deps *RepoActivityDeps, in *BrainProposalsListInput) (*BrainProposalsListOutput, error) {\n\tif deps.Proposals == nil {\n\t\treturn nil, huma.Error503ServiceUnavailable(\"brain proposal queue not configured\")\n\t}\n\tbranch := strings.TrimSpace(in.Branch)\n\tif branch == \"\" {\n\t\treturn nil, huma.Error400BadRequest(\"branch is required\")\n\t}\n\tref, version, plaintext, found, err := deps.Proposals.Current(ctx, in.RepoID, branch)\n\tif err != nil {\n\t\treturn nil, brainProposalStoreError(err)\n\t}\n\tout := &BrainProposalsListOutput{}\n\tout.Body.Found = found\n\tout.Body.Ref = ref\n\tout.Body.Version = version\n\tout.Body.Proposals = []brainProposal{}\n\tif found {\n\t\tset, decErr := decodeProposalSet(plaintext)\n\t\tif decErr != nil {\n\t\t\treturn nil, huma.Error500InternalServerError(\"stored proposal set is unreadable\")\n\t\t}\n\t\tif set != nil {\n\t\t\tout.Body.Proposals = set\n\t\t}\n\t}\n\treturn out, nil\n}\n\n// getBrainProposal returns one entry by id. Absent is found=false, not 404 — see\n// BrainProposalGetOutput.\nfunc getBrainProposal(ctx context.Context, deps *RepoActivityDeps, in *BrainProposalGetInput) (*BrainProposalGetOutput, error) {\n\tif deps.Proposals == nil {\n\t\treturn nil, huma.Error503ServiceUnavailable(\"brain proposal queue not configured\")\n\t}\n\tbranch := strings.TrimSpace(in.Branch)\n\tif branch == \"\" {\n\t\treturn nil, huma.Error400BadRequest(\"branch is required\")\n\t}\n\tid := strings.TrimSpace(in.ProposalID)\n\tif id == \"\" {\n\t\treturn nil, huma.Error400BadRequest(\"proposal_id is required\")\n\t}\n\tref, _, plaintext, found, err := deps.Proposals.Current(ctx, in.RepoID, branch)\n\tif err != nil {\n\t\treturn nil, brainProposalStoreError(err)\n\t}\n\tout := &BrainProposalGetOutput{}\n\tout.Body.Ref = ref\n\tif !found {\n\t\treturn out, nil\n\t}\n\tset, decErr := decodeProposalSet(plaintext)\n\tif decErr != nil {\n\t\treturn nil, huma.Error500InternalServerError(\"stored proposal set is unreadable\")\n\t}\n\tfor i := range set {\n\t\tif set[i].ID == id {\n\t\t\tout.Body.Found = true\n\t\t\tout.Body.Proposal = &set[i]\n\t\t\tbreak\n\t\t}\n\t}\n\treturn out, nil\n}\n\n// publishBrainProposals replaces the whole set under CAS (repo push).\nfunc publishBrainProposals(ctx context.Context, deps *RepoActivityDeps, in *BrainProposalsPublishInput) (*BrainProposalsPublishOutput, error) {\n\tif deps.Proposals == nil {\n\t\treturn nil, huma.Error503ServiceUnavailable(\"brain proposal queue not configured\")\n\t}\n\tbranch := strings.TrimSpace(in.Body.Branch)\n\tif branch == \"\" {\n\t\treturn nil, huma.Error400BadRequest(\"branch is required\")\n\t}\n\tplaintext, err := encodeProposalSet(in.Body.Proposals)\n\tif err != nil {\n\t\treturn nil, huma.Error400BadRequest(\"proposals could not be encoded\")\n\t}\n\tnewRef, version, err := deps.Proposals.Advance(ctx, in.RepoID, branch, in.Body.OldRef, plaintext)\n\tout := &BrainProposalsPublishOutput{}\n\tswitch {\n\tcase err == nil:\n\t\tout.Body.Ref = newRef\n\t\tout.Body.Version = version\n\t\tout.Body.Changed = true\n\t\treturn out, nil\n\tcase errors.Is(err, brainbuild.ErrNoFactSetChange):\n\t\t// Byte-identical to the current set: idempotent republish. Echo the head.\n\t\tref, v, _, _, curErr := deps.Proposals.Current(ctx, in.RepoID, branch)\n\t\tif curErr != nil {\n\t\t\treturn nil, brainProposalStoreError(curErr)\n\t\t}\n\t\tout.Body.Ref = ref\n\t\tout.Body.Version = v\n\t\tout.Body.Changed = false\n\t\treturn out, nil\n\tdefault:\n\t\treturn nil, brainProposalStoreError(err)\n\t}\n}\n\n// resolveBrainProposal applies the runner's settlement: swap the fact head (unless\n// the settlement touches no facts) and the proposal set, each from the ref the runner\n// read. Either CAS losing is a 412 — the runner re-reads and re-resolves.\nfunc resolveBrainProposal(ctx context.Context, deps *RepoActivityDeps, in *BrainProposalResolveInput) (*BrainProposalResolveOutput, error) {\n\tif deps.Proposals == nil || deps.Facts == nil {\n\t\treturn nil, huma.Error503ServiceUnavailable(\"brain proposal queue not configured\")\n\t}\n\tbranch := strings.TrimSpace(in.Body.Branch)\n\tif branch == \"\" {\n\t\treturn nil, huma.Error400BadRequest(\"branch is required\")\n\t}\n\tif strings.TrimSpace(in.ProposalID) == \"\" {\n\t\treturn nil, huma.Error400BadRequest(\"proposal_id is required\")\n\t}\n\tdecision := strings.TrimSpace(in.Body.Decision)\n\tif decision != \"accept\" && decision != \"reject\" {\n\t\treturn nil, huma.Error400BadRequest(\"decision must be accept or reject\")\n\t}\n\tif in.Body.FactsUnchanged && decision != \"reject\" {\n\t\t// Guard the prune path at the boundary: skipping the fact write on an accept\n\t\t// would retire the proposal while silently dropping its merge result.\n\t\treturn nil, huma.Error400BadRequest(\"factsUnchanged is only valid with decision=reject\")\n\t}\n\tif !in.Body.FactsUnchanged && len(in.Body.Data) == 0 {\n\t\treturn nil, huma.Error400BadRequest(\"data is required (a fact-set head always points at content)\")\n\t}\n\n\t// FACTS FIRST. A settlement that advances facts but loses the proposal-set CAS\n\t// leaves a settled fact set with the entry still queued — the runner re-reads and\n\t// re-resolves, and re-applying the same settlement is a no-op. The reverse order\n\t// could drop the entry while the facts never moved, losing the settlement.\n\tfactsRef := in.Body.FactsOldRef\n\tif !in.Body.FactsUnchanged {\n\t\tnewFactsRef, _, err := deps.Facts.Advance(ctx, in.RepoID, branch, in.Body.FactsOldRef, in.Body.Data)\n\t\tswitch {\n\t\tcase err == nil:\n\t\t\tfactsRef = newFactsRef\n\t\tcase errors.Is(err, brainbuild.ErrNoFactSetChange):\n\t\t\t// The resolution produced the current content: keep the head as-is.\n\t\tdefault:\n\t\t\treturn nil, brainProposalStoreError(err)\n\t\t}\n\t}\n\n\tremaining, err := encodeProposalSet(in.Body.Proposals)\n\tif err != nil {\n\t\treturn nil, huma.Error400BadRequest(\"proposals could not be encoded\")\n\t}\n\tout := &BrainProposalResolveOutput{}\n\tout.Body.FactsRef = factsRef\n\tnewSetRef, _, err := deps.Proposals.Advance(ctx, in.RepoID, branch, in.Body.ProposalsOldRef, remaining)\n\tswitch {\n\tcase err == nil:\n\t\tout.Body.ProposalsRef = newSetRef\n\t\tout.Body.Changed = true\n\t\treturn out, nil\n\tcase errors.Is(err, brainbuild.ErrNoFactSetChange):\n\t\tref, _, _, _, curErr := deps.Proposals.Current(ctx, in.RepoID, branch)\n\t\tif curErr != nil {\n\t\t\treturn nil, brainProposalStoreError(curErr)\n\t\t}\n\t\tout.Body.ProposalsRef = ref\n\t\tout.Body.Changed = false\n\t\treturn out, nil\n\tdefault:\n\t\treturn nil, brainProposalStoreError(err)\n\t}\n}\n\n// brainProposalStoreError maps store faults to the status codes the runner's retry\n// loop is written against: a lost CAS is 412 (re-read and re-resolve), an\n// unresolvable repo is 404 (fail closed), anything else is 500.\nfunc brainProposalStoreError(err error) error {\n\tswitch {\n\tcase errors.Is(err, brainbuild.ErrFactRefConflict):\n\t\treturn huma.Error412PreconditionFailed(\"proposal set advanced concurrently; re-read and re-resolve\")\n\tcase errors.Is(err, brainbuild.ErrRepoNotFound):\n\t\treturn huma.NewError(http.StatusNotFound, \"repo not found\")\n\tdefault:\n\t\treturn huma.Error500InternalServerError(\"brain proposal store unavailable\")\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1500,"cache_read_input_tokens":853766,"output_tokens":5406,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1500,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":5406,"cache_read_input_tokens":853766,"cache_creation_input_tokens":1500,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1500},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011Ce8ipE8HygH7E5fyu7KAn","type":"assistant","uuid":"d3be1099-aa0a-433c-aa65-93ec4a0856c1","timestamp":"2026-08-17T17:34:23.223Z","effort":"xhigh","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/p0p1/p1-new","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
{"parentUuid":"d3be1099-aa0a-433c-aa65-93ec4a0856c1","isSidechain":false,"promptId":"008251ba-5894-4079-a812-8e401d59a62b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WveXy8eXTg563v8ZyN7mP4","type":"tool_result","content":"The file /Users/suhaan/devenv/p0p1/api-242/internal/httpapi/brain_proposals.go has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"405c57ad-9125-4bef-bbf5-273cbd261f7e","timestamp":"2026-08-17T17:34:23.262Z","toolUseResult":{"type":"update","filePath":"/Users/suhaan/devenv/p0p1/api-242/internal/httpapi/brain_proposals.go","content":"package httpapi\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"net/http\"\n\t\"strings\"\n\n\t\"github.com/danielgtaylor/huma/v2\"\n\n\t\"github.com/entirehq/entire-api/internal/brainbuild\"\n)\n\n// The OPEN PROPOSAL SET surface: the review queue in front of a branch's durable\n// fact-set head, served as ONE compare-and-swapped blob rather than a row per\n// proposal.\n//\n// The shape is dictated by ADR-P1-E: the merge runs on the runner. The runner reads\n// the fact head and the open set, computes the resolution locally, and swaps BOTH\n// back under the refs it read. This server never interprets a proposal — it stores\n// bytes and moves pointers. A row model would force the server to re-derive which\n// entries survive a resolution, which is merge logic, and a second implementation of\n// merge logic is exactly the divergence the wire contract exists to prevent. It would\n// also fork proposal identity: ids are derived by the client from the proposal's own\n// fields, and a server-side id derived from storage coordinates could never match.\n//\n// Paths sit under the fact-set family (/brain/facts/proposals) because the set IS the\n// fact set's review queue, and the client addresses it there.\n\n// brainProposal is one entry in the set. The server treats Proposal as opaque JSON:\n// only the client derives or interprets it, so a newer client may add fields without\n// a server change.\ntype brainProposal struct {\n\tID       string          `json:\"id\"`\n\tProposal json.RawMessage `json:\"proposal\"`\n}\n\n// BrainProposalsListInput is GET /repos/{repo_id}/brain/facts/proposals?branch=\ntype BrainProposalsListInput struct {\n\tRepoID string `path:\"repo_id\"`\n\tBranch string `query:\"branch\"`\n}\n\n// BrainProposalsListOutput is the branch's open set at the ref it was read at. Found\n// is false — with an empty list, not an error — when the branch has no set yet: a\n// branch with no cross-member conflict simply has nothing to review.\ntype BrainProposalsListOutput struct {\n\tBody struct {\n\t\tFound     bool            `json:\"found\"`\n\t\tRef       string          `json:\"ref\"`\n\t\tVersion   int64           `json:\"version\"`\n\t\tProposals []brainProposal `json:\"proposals\"`\n\t}\n}\n\n// BrainProposalGetInput is GET /repos/{repo_id}/brain/facts/proposals/{proposal_id}\ntype BrainProposalGetInput struct {\n\tRepoID     string `path:\"repo_id\"`\n\tProposalID string `path:\"proposal_id\"`\n\tBranch     string `query:\"branch\"`\n}\n\n// BrainProposalGetOutput carries the entry when present. found=false is a normal\n// answer (settled by someone else meanwhile), not a 404, so a client reconciling its\n// local queue can tell \"gone\" from \"the request failed\".\ntype BrainProposalGetOutput struct {\n\tBody struct {\n\t\tFound    bool           `json:\"found\"`\n\t\tRef      string         `json:\"ref\"`\n\t\tProposal *brainProposal `json:\"proposal\"`\n\t}\n}\n\n// BrainProposalsPublishInput is POST /repos/{repo_id}/brain/facts/proposals — replace\n// the whole set under CAS. OldRef is the ref the caller read; empty means \"no set\n// yet\" (a create).\ntype BrainProposalsPublishInput struct {\n\tRepoID string `path:\"repo_id\"`\n\tBody   struct {\n\t\tBranch    string          `json:\"branch\"`\n\t\tOldRef    string          `json:\"oldRef\"`\n\t\tProposals []brainProposal `json:\"proposals\"`\n\t}\n}\n\n// BrainProposalsPublishOutput reports the new head. Changed is false when the set was\n// byte-identical to the current one, in which case Ref/Version echo the head that\n// already existed — a no-op, not a failure, so a republish is idempotent.\ntype BrainProposalsPublishOutput struct {\n\tBody struct {\n\t\tRef     string `json:\"ref\"`\n\t\tVersion int64  `json:\"version\"`\n\t\tChanged bool   `json:\"changed\"`\n\t}\n}\n\n// BrainProposalResolveInput is POST .../proposals/{proposal_id}/resolve: the runner's\n// computed settlement, compare-and-swapping BOTH heads from the refs it read.\ntype BrainProposalResolveInput struct {\n\tRepoID     string `path:\"repo_id\"`\n\tProposalID string `path:\"proposal_id\"`\n\tBody       struct {\n\t\tBranch      string `json:\"branch\"`\n\t\tDecision    string `json:\"decision\"`\n\t\tFactsOldRef string `json:\"factsOldRef\"`\n\t\tData        []byte `json:\"data\"`\n\t\t// FactsUnchanged settles WITHOUT touching the fact head. It is how an orphaned\n\t\t// proposal — one whose facts are gone entirely — is pruned: it cannot be\n\t\t// accepted, and reject changes no facts, so the only write it needs is the set.\n\t\t// Valid only with decision=reject; Data is then empty and must NOT be read as\n\t\t// \"empty the fact set\".\n\t\tFactsUnchanged  bool            `json:\"factsUnchanged\"`\n\t\tProposalsOldRef string          `json:\"proposalsOldRef\"`\n\t\tProposals       []brainProposal `json:\"proposals\"`\n\t}\n}\n\n// BrainProposalResolveOutput reports where both heads landed.\ntype BrainProposalResolveOutput struct {\n\tBody struct {\n\t\tFactsRef     string `json:\"factsRef\"`\n\t\tProposalsRef string `json:\"proposalsRef\"`\n\t\tChanged      bool   `json:\"changed\"`\n\t}\n}\n\n// decodeProposalSet reads a stored set blob. An empty blob is an empty set.\nfunc decodeProposalSet(plaintext []byte) ([]brainProposal, error) {\n\tif len(plaintext) == 0 {\n\t\treturn nil, nil\n\t}\n\tvar out []brainProposal\n\tif err := json.Unmarshal(plaintext, &out); err != nil {\n\t\treturn nil, err\n\t}\n\treturn out, nil\n}\n\n// encodeProposalSet renders a set for storage. An explicit empty array is stored\n// rather than null so the last resolution CLEARS the set with content a head can\n// point at (a head always points at content).\nfunc encodeProposalSet(in []brainProposal) ([]byte, error) {\n\tif in == nil {\n\t\tin = []brainProposal{}\n\t}\n\treturn json.Marshal(in)\n}\n\n// listBrainProposals returns the branch's open set (repo pull).\nfunc listBrainProposals(ctx context.Context, deps *RepoActivityDeps, in *BrainProposalsListInput) (*BrainProposalsListOutput, error) {\n\tif deps.Proposals == nil {\n\t\treturn nil, huma.Error503ServiceUnavailable(\"brain proposal queue not configured\")\n\t}\n\tbranch := strings.TrimSpace(in.Branch)\n\tif branch == \"\" {\n\t\treturn nil, huma.Error400BadRequest(\"branch is required\")\n\t}\n\tref, version, plaintext, found, err := deps.Proposals.Current(ctx, in.RepoID, branch)\n\tif err != nil {\n\t\treturn nil, brainProposalStoreError(err)\n\t}\n\tout := &BrainProposalsListOutput{}\n\tout.Body.Found = found\n\tout.Body.Ref = ref\n\tout.Body.Version = version\n\tout.Body.Proposals = []brainProposal{}\n\tif found {\n\t\tset, decErr := decodeProposalSet(plaintext)\n\t\tif decErr != nil {\n\t\t\treturn nil, huma.Error500InternalServerError(\"stored proposal set is unreadable\")\n\t\t}\n\t\tif set != nil {\n\t\t\tout.Body.Proposals = set\n\t\t}\n\t}\n\treturn out, nil\n}\n\n// getBrainProposal returns one entry by id. Absent is found=false, not 404 — see\n// BrainProposalGetOutput.\nfunc getBrainProposal(ctx context.Context, deps *RepoActivityDeps, in *BrainProposalGetInput) (*BrainProposalGetOutput, error) {\n\tif deps.Proposals == nil {\n\t\treturn nil, huma.Error503ServiceUnavailable(\"brain proposal queue not configured\")\n\t}\n\tbranch := strings.TrimSpace(in.Branch)\n\tif branch == \"\" {\n\t\treturn nil, huma.Error400BadRequest(\"branch is required\")\n\t}\n\tid := strings.TrimSpace(in.ProposalID)\n\tif id == \"\" {\n\t\treturn nil, huma.Error400BadRequest(\"proposal_id is required\")\n\t}\n\tref, _, plaintext, found, err := deps.Proposals.Current(ctx, in.RepoID, branch)\n\tif err != nil {\n\t\treturn nil, brainProposalStoreError(err)\n\t}\n\tout := &BrainProposalGetOutput{}\n\tout.Body.Ref = ref\n\tif !found {\n\t\treturn out, nil\n\t}\n\tset, decErr := decodeProposalSet(plaintext)\n\tif decErr != nil {\n\t\treturn nil, huma.Error500InternalServerError(\"stored proposal set is unreadable\")\n\t}\n\tfor i := range set {\n\t\tif set[i].ID == id {\n\t\t\tout.Body.Found = true\n\t\t\tout.Body.Proposal = &set[i]\n\t\t\tbreak\n\t\t}\n\t}\n\treturn out, nil\n}\n\n// publishBrainProposals replaces the whole set under CAS (repo push).\nfunc publishBrainProposals(ctx context.Context, deps *RepoActivityDeps, in *BrainProposalsPublishInput) (*BrainProposalsPublishOutput, error) {\n\tif deps.Proposals == nil {\n\t\treturn nil, huma.Error503ServiceUnavailable(\"brain proposal queue not configured\")\n\t}\n\tbranch := strings.TrimSpace(in.Body.Branch)\n\tif branch == \"\" {\n\t\treturn nil, huma.Error400BadRequest(\"branch is required\")\n\t}\n\tplaintext, err := encodeProposalSet(in.Body.Proposals)\n\tif err != nil {\n\t\treturn nil, huma.Error400BadRequest(\"proposals could not be encoded\")\n\t}\n\tnewRef, version, err := deps.Proposals.Advance(ctx, in.RepoID, branch, in.Body.OldRef, plaintext)\n\tout := &BrainProposalsPublishOutput{}\n\tswitch {\n\tcase err == nil:\n\t\tout.Body.Ref = newRef\n\t\tout.Body.Version = version\n\t\tout.Body.Changed = true\n\t\treturn out, nil\n\tcase errors.Is(err, brainbuild.ErrNoFactSetChange):\n\t\t// Byte-identical to the current set: idempotent republish. Echo the head.\n\t\tref, v, _, _, curErr := deps.Proposals.Current(ctx, in.RepoID, branch)\n\t\tif curErr != nil {\n\t\t\treturn nil, brainProposalStoreError(curErr)\n\t\t}\n\t\tout.Body.Ref = ref\n\t\tout.Body.Version = v\n\t\tout.Body.Changed = false\n\t\treturn out, nil\n\tdefault:\n\t\treturn nil, brainProposalStoreError(err)\n\t}\n}\n\n// resolveBrainProposal applies the runner's settlement: swap the fact head (unless\n// the settlement touches no facts) and the proposal set, each from the ref the runner\n// read. Either CAS losing is a 412 — the runner re-reads and re-resolves.\nfunc resolveBrainProposal(ctx context.Context, deps *RepoActivityDeps, in *BrainProposalResolveInput) (*BrainProposalResolveOutput, error) {\n\tif deps.Proposals == nil || deps.Facts == nil {\n\t\treturn nil, huma.Error503ServiceUnavailable(\"brain proposal queue not configured\")\n\t}\n\tbranch := strings.TrimSpace(in.Body.Branch)\n\tif branch == \"\" {\n\t\treturn nil, huma.Error400BadRequest(\"branch is required\")\n\t}\n\tif strings.TrimSpace(in.ProposalID) == \"\" {\n\t\treturn nil, huma.Error400BadRequest(\"proposal_id is required\")\n\t}\n\tdecision := strings.TrimSpace(in.Body.Decision)\n\tif decision != \"accept\" && decision != \"reject\" {\n\t\treturn nil, huma.Error400BadRequest(\"decision must be accept or reject\")\n\t}\n\tif in.Body.FactsUnchanged && decision != \"reject\" {\n\t\t// Guard the prune path at the boundary: skipping the fact write on an accept\n\t\t// would retire the proposal while silently dropping its merge result.\n\t\treturn nil, huma.Error400BadRequest(\"factsUnchanged is only valid with decision=reject\")\n\t}\n\tif !in.Body.FactsUnchanged && len(in.Body.Data) == 0 {\n\t\treturn nil, huma.Error400BadRequest(\"data is required (a fact-set head always points at content)\")\n\t}\n\n\t// FACTS FIRST. A settlement that advances facts but loses the proposal-set CAS\n\t// leaves a settled fact set with the entry still queued — the runner re-reads and\n\t// re-resolves, and re-applying the same settlement is a no-op. The reverse order\n\t// could drop the entry while the facts never moved, losing the settlement.\n\tfactsRef := in.Body.FactsOldRef\n\tif !in.Body.FactsUnchanged {\n\t\tnewFactsRef, _, err := deps.Facts.Advance(ctx, in.RepoID, branch, in.Body.FactsOldRef, in.Body.Data)\n\t\tswitch {\n\t\tcase err == nil:\n\t\t\tfactsRef = newFactsRef\n\t\tcase errors.Is(err, brainbuild.ErrNoFactSetChange):\n\t\t\t// The resolution produced the current content: keep the head as-is.\n\t\tdefault:\n\t\t\treturn nil, brainProposalStoreError(err)\n\t\t}\n\t}\n\n\tremaining, err := encodeProposalSet(in.Body.Proposals)\n\tif err != nil {\n\t\treturn nil, huma.Error400BadRequest(\"proposals could not be encoded\")\n\t}\n\tout := &BrainProposalResolveOutput{}\n\tout.Body.FactsRef = factsRef\n\tnewSetRef, _, err := deps.Proposals.Advance(ctx, in.RepoID, branch, in.Body.ProposalsOldRef, remaining)\n\tswitch {\n\tcase err == nil:\n\t\tout.Body.ProposalsRef = newSetRef\n\t\tout.Body.Changed = true\n\t\treturn out, nil\n\tcase errors.Is(err, brainbuild.ErrNoFactSetChange):\n\t\tref, _, _, _, curErr := deps.Proposals.Current(ctx, in.RepoID, branch)\n\t\tif curErr != nil {\n\t\t\treturn nil, brainProposalStoreError(curErr)\n\t\t}\n\t\tout.Body.ProposalsRef = ref\n\t\tout.Body.Changed = false\n\t\treturn out, nil\n\tdefault:\n\t\treturn nil, brainProposalStoreError(err)\n\t}\n}\n\n// brainProposalStoreError maps store faults to the status codes the runner's retry\n// loop is written against: a lost CAS is 412 (re-read and re-resolve), an\n// unresolvable repo is 404 (fail closed), anything else is 500.\nfunc brainProposalStoreError(err error) error {\n\tswitch {\n\tcase errors.Is(err, brainbuild.ErrFactRefConflict):\n\t\treturn huma.Error412PreconditionFailed(\"proposal set advanced concurrently; re-read and re-resolve\")\n\tcase errors.Is(err, brainbuild.ErrRepoNotFound):\n\t\treturn huma.NewError(http.StatusNotFound, \"repo not found\")\n\tdefault:\n\t\treturn huma.Error500InternalServerError(\"brain proposal store unavailable\")\n\t}\n}\n","structuredPatch":[{"oldStart":2,"oldLines":366,"newStart":2,"newLines":333,"lines":[" "," import (","   \"context\"","+  \"encoding/json\"","   \"errors\"","   \"net/http\"","-  \"time\"","+  \"strings\""," ","   \"github.com/danielgtaylor/huma/v2\""," ","   \"github.com/entirehq/entire-api/internal/brainbuild\""," )"," ","-// The open-proposal-set endpoints (P1): the server half of the brain's review","-// transport. Where brain_facts.go exposes the DIRECT read-merge-CAS loop (a member","-// with push advances the head itself), these expose the REVIEWED path — a","-// contribution is parked in a queue, read by other members, then applied or refused:","+// The OPEN PROPOSAL SET surface: the review queue in front of a branch's durable","+// fact-set head, served as ONE compare-and-swapped blob rather than a row per","+// proposal."," //","-//\tPOST …/brain/proposals                    — offer a contribution (push)","-//\tGET  …/brain/proposals?branch=            — the open set, oldest first (pull)","-//\tGET  …/brain/proposals/{proposal_id}      — one proposal + its plaintext (pull)","-//\tPOST …/brain/proposals/{proposal_id}/apply  — merge it into the head (push)","-//\tPOST …/brain/proposals/{proposal_id}/reject — refuse it, with a reason (push)","+// The shape is dictated by ADR-P1-E: the merge runs on the runner. The runner reads","+// the fact head and the open set, computes the resolution locally, and swaps BOTH","+// back under the refs it read. This server never interprets a proposal — it stores","+// bytes and moves pointers. A row model would force the server to re-derive which","+// entries survive a resolution, which is merge logic, and a second implementation of","+// merge logic is exactly the divergence the wire contract exists to prevent. It would","+// also fork proposal identity: ids are derived by the client from the proposal's own","+// fields, and a server-side id derived from storage coordinates could never match."," //","-// TENANCY. Per ADR-0004 the brain's tenant IS the repo, so these routes gate on the","-// SAME requireAuth + requireRepoAccess / requireRepoPush middleware every other","-// repo-scoped endpoint uses — reads need repo pull, state changes need repo push.","-// No brain-specific scope is invented, and none of the handlers re-derives a subject","-// from request input.","-//","-// STATUS CODES follow the fact-sync contract exactly, so a client that already speaks","-// …/brain/facts needs no new error vocabulary:","-//","-//\t200 — applied / rejected / read","-//\t409 — the proposal is no longer open (already applied or rejected): a CONFLICT","-//\t      about the QUEUE's state, which re-reading the queue resolves","-//\t412 — the branch head moved off the proposal's base: a PRECONDITION failure about","-//\t      the FACT-SET's state, identical in meaning to the CAS 412 the advance","-//\t      endpoint returns; the proposer re-bases and re-proposes","-//\t404 — unknown repo (fail closed) or unknown proposal","-//\t503 — hosted brain not configured (nil store), exactly like the other surfaces","-//","-// Branch identity: a branch name can contain '/', which one Huma path segment cannot","-// carry, so the list takes it as a query param and the create in the JSON body —","-// matching brain_facts.go. Proposal ids are hex-safe by construction (prop-<sha256>),","-// so they DO ride in a path segment.","+// Paths sit under the fact-set family (/brain/facts/proposals) because the set IS the","+// fact set's review queue, and the client addresses it there."," ","-// maxOpenProposals caps a single list page. The queue is a review surface, not a","-// history feed; an unbounded page would let one repo's backlog dominate a response.","-const maxOpenProposals = 200","-","-// BrainProposal is one queue entry on the wire. It carries pointers and attribution","-// only — the proposed facts themselves are fetched with the single-proposal read.","-type BrainProposal struct {","-  ID             string    `json:\"id\"`","-  Branch         string    `json:\"branch\"`","-  BaseRef        string    `json:\"baseRef,omitempty\"`","-  ContentRef     string    `json:\"contentRef\"`","-  Status         string    `json:\"status\"`","-  ProposedBy     string    `json:\"proposedBy,omitempty\"`","-  Summary        string    `json:\"summary,omitempty\"`","-  Reason         string    `json:\"reason,omitempty\"`","-  AppliedRef     string    `json:\"appliedRef,omitempty\"`","-  AppliedVersion int64     `json:\"appliedVersion,omitempty\"`","-  CreatedAt      time.Time `json:\"createdAt\"`","-  UpdatedAt      time.Time `json:\"updatedAt\"`","+// brainProposal is one entry in the set. The server treats Proposal as opaque JSON:","+// only the client derives or interprets it, so a newer client may add fields without","+// a server change.","+type brainProposal struct {","+  ID       string          `json:\"id\"`","+  Proposal json.RawMessage `json:\"proposal\"`"," }"," ","-// wireProposal renders a domain proposal for the wire.","-func wireProposal(p brainbuild.Proposal) BrainProposal {","-  return BrainProposal{","-    ID:             p.ID,","-    Branch:         p.Branch,","-    BaseRef:        p.BaseRef,","-    ContentRef:     p.ContentRef,","-    Status:         p.Status,","-    ProposedBy:     p.ProposedBy,","-    Summary:        p.Summary,","-    Reason:         p.Reason,","-    AppliedRef:     p.AppliedRef,","-    AppliedVersion: p.AppliedVersion,","-    CreatedAt:      p.CreatedAt,","-    UpdatedAt:      p.UpdatedAt,","-  }","-}","-","-// BrainProposalsListInput is GET /repos/{repo_id}/brain/proposals?branch=&limit=","+// BrainProposalsListInput is GET /repos/{repo_id}/brain/facts/proposals?branch="," type BrainProposalsListInput struct {","   RepoID string `path:\"repo_id\"`","-  Branch string `query:\"branch\" doc:\"Optional branch filter (exact ref; may contain '/'). Empty means every branch.\"`","-  Limit  int    `query:\"limit\" default:\"50\" doc:\"Page size, clamped to 1..200\"`","+  Branch string `query:\"branch\"`"," }"," ","-// BrainProposalsListOutput is the open set, oldest first.","+// BrainProposalsListOutput is the branch's open set at the ref it was read at. Found","+// is false — with an empty list, not an error — when the branch has no set yet: a","+// branch with no cross-member conflict simply has nothing to review."," type BrainProposalsListOutput struct {","   Body struct {","-    Proposals []BrainProposal `json:\"proposals\"`","+    Found     bool            `json:\"found\"`","+    Ref       string          `json:\"ref\"`","+    Version   int64           `json:\"version\"`","+    Proposals []brainProposal `json:\"proposals\"`","   }"," }"," ","-// BrainProposalGetInput is GET /repos/{repo_id}/brain/proposals/{proposal_id}","+// BrainProposalGetInput is GET /repos/{repo_id}/brain/facts/proposals/{proposal_id}"," type BrainProposalGetInput struct {","   RepoID     string `path:\"repo_id\"`","   ProposalID string `path:\"proposal_id\"`","+  Branch     string `query:\"branch\"`"," }"," ","-// BrainProposalGetOutput is one proposal plus the DECRYPTED plaintext NDJSON it","-// proposes (base64 on the wire, as huma encodes []byte). Data is omitted for a","-// rejected proposal, whose blob was crypto-shredded on rejection.","+// BrainProposalGetOutput carries the entry when present. found=false is a normal","+// answer (settled by someone else meanwhile), not a 404, so a client reconciling its","+// local queue can tell \"gone\" from \"the request failed\"."," type BrainProposalGetOutput struct {","   Body struct {","-    Proposal BrainProposal `json:\"proposal\"`","-    Data     []byte        `json:\"data,omitempty\"`","+    Found    bool           `json:\"found\"`","+    Ref      string         `json:\"ref\"`","+    Proposal *brainProposal `json:\"proposal\"`","   }"," }"," ","-// BrainProposalOpenInput is POST /repos/{repo_id}/brain/proposals. BaseRef is the","-// head the proposer merged against (empty for a create); Data is the proposed","-// plaintext NDJSON (base64 on the wire).","-type BrainProposalOpenInput struct {","+// BrainProposalsPublishInput is POST /repos/{repo_id}/brain/facts/proposals — replace","+// the whole set under CAS. OldRef is the ref the caller read; empty means \"no set","+// yet\" (a create).","+type BrainProposalsPublishInput struct {","   RepoID string `path:\"repo_id\"`","   Body   struct {","-    Branch     string `json:\"branch\"`","-    BaseRef    string `json:\"baseRef\"`","-    Summary    string `json:\"summary,omitempty\"`","-    ProposedBy string `json:\"proposedBy,omitempty\"`","-    Data       []byte `json:\"data\"`","+    Branch    string          `json:\"branch\"`","+    OldRef    string          `json:\"oldRef\"`","+    Proposals []brainProposal `json:\"proposals\"`","   }"," }"," ","-// BrainProposalOpenOutput reports the queued proposal. Opening the byte-identical","-// contribution twice returns the same proposal (the id is deterministic).","-type BrainProposalOpenOutput struct {","+// BrainProposalsPublishOutput reports the new head. Changed is false when the set was","+// byte-identical to the current one, in which case Ref/Version echo the head that","+// already existed — a no-op, not a failure, so a republish is idempotent.","+type BrainProposalsPublishOutput struct {","   Body struct {","-    Proposal BrainProposal `json:\"proposal\"`","+    Ref     string `json:\"ref\"`","+    Version int64  `json:\"version\"`","+    Changed bool   `json:\"changed\"`","   }"," }"," ","-// BrainProposalApplyInput is POST /repos/{repo_id}/brain/proposals/{proposal_id}/apply","-type BrainProposalApplyInput struct {","+// BrainProposalResolveInput is POST .../proposals/{proposal_id}/resolve: the runner's","+// computed settlement, compare-and-swapping BOTH heads from the refs it read.","+type BrainProposalResolveInput struct {","   RepoID     string `path:\"repo_id\"`","   ProposalID string `path:\"proposal_id\"`","+  Body       struct {","+    Branch      string `json:\"branch\"`","+    Decision    string `json:\"decision\"`","+    FactsOldRef string `json:\"factsOldRef\"`","+    Data        []byte `json:\"data\"`","+    // FactsUnchanged settles WITHOUT touching the fact head. It is how an orphaned","+    // proposal — one whose facts are gone entirely — is pruned: it cannot be","+    // accepted, and reject changes no facts, so the only write it needs is the set.","+    // Valid only with decision=reject; Data is then empty and must NOT be read as","+    // \"empty the fact set\".","+    FactsUnchanged  bool            `json:\"factsUnchanged\"`","+    ProposalsOldRef string          `json:\"proposalsOldRef\"`","+    Proposals       []brainProposal `json:\"proposals\"`","+  }"," }"," ","-// BrainProposalApplyOutput reports the closed proposal and the resulting head.","-// Changed is false when the head already carried exactly this content (the proposal","-// still closes as applied).","-type BrainProposalApplyOutput struct {","+// BrainProposalResolveOutput reports where both heads landed.","+type BrainProposalResolveOutput struct {","   Body struct {","-    Proposal BrainProposal `json:\"proposal\"`","-    HeadRef  string        `json:\"headRef\"`","-    Version  int64         `json:\"version\"`","-    Changed  bool          `json:\"changed,omitempty\"`","+    FactsRef     string `json:\"factsRef\"`","+    ProposalsRef string `json:\"proposalsRef\"`","+    Changed      bool   `json:\"changed\"`","   }"," }"," ","-// BrainProposalRejectInput is POST /repos/{repo_id}/brain/proposals/{proposal_id}/reject","-type BrainProposalRejectInput struct {","-  RepoID     string `path:\"repo_id\"`","-  ProposalID string `path:\"proposal_id\"`","-  Body       struct {","-    Reason string `json:\"reason,omitempty\"`","+// decodeProposalSet reads a stored set blob. An empty blob is an empty set.","+func decodeProposalSet(plaintext []byte) ([]brainProposal, error) {","+  if len(plaintext) == 0 {","+    return nil, nil","   }","-}","-","-// BrainProposalRejectOutput reports the closed proposal.","-type BrainProposalRejectOutput struct {","-  Body struct {","-    Proposal BrainProposal `json:\"proposal\"`","+  var out []brainProposal","+  if err := json.Unmarshal(plaintext, &out); err != nil {","+    return nil, err","   }","+  return out, nil"," }"," ","-// proposalStoreError maps the store sentinels shared by every proposal handler to","-// HTTP, so the four endpoints cannot drift on the contract. It returns nil when err","-// is not one of them (the caller then decides its own default).","-func proposalStoreError(err error) error {","-  switch {","-  case errors.Is(err, brainbuild.ErrUnresolvedRepo):","-    return huma.Error404NotFound(\"repo not found\")","-  case errors.Is(err, brainbuild.ErrProposalNotFound):","-    return huma.Error404NotFound(\"proposal not found\")","-  case errors.Is(err, brainbuild.ErrProposalNotOpen):","-    return huma.Error409Conflict(\"proposal is no longer open; re-read the proposal set\")","-  case errors.Is(err, brainbuild.ErrFactRefConflict):","-    return huma.Error412PreconditionFailed(\"fact-set head advanced past this proposal's base; re-base and re-propose\")","-  case errors.Is(err, brainbuild.ErrProposalInvalid):","-    return huma.Error400BadRequest(err.Error())","-  default:","-    return nil","+// encodeProposalSet renders a set for storage. An explicit empty array is stored","+// rather than null so the last resolution CLEARS the set with content a head can","+// point at (a head always points at content).","+func encodeProposalSet(in []brainProposal) ([]byte, error) {","+  if in == nil {","+    in = []brainProposal{}","   }","+  return json.Marshal(in)"," }"," ","-// listBrainProposals returns the repo's open proposals (repo pull).","+// listBrainProposals returns the branch's open set (repo pull)."," func listBrainProposals(ctx context.Context, deps *RepoActivityDeps, in *BrainProposalsListInput) (*BrainProposalsListOutput, error) {","   if deps.Proposals == nil {","-    return nil, huma.Error503ServiceUnavailable(\"brain proposals not configured\")","+    return nil, huma.Error503ServiceUnavailable(\"brain proposal queue not configured\")","   }","-  limit := in.Limit","-  if limit <= 0 {","-    limit = 50","+  branch := strings.TrimSpace(in.Branch)","+  if branch == \"\" {","+    return nil, huma.Error400BadRequest(\"branch is required\")","   }","-  if limit > maxOpenProposals {","-    limit = maxOpenProposals","-  }","-  found, err := deps.Proposals.ListOpen(ctx, in.RepoID, in.Branch, limit)","+  ref, version, plaintext, found, err := deps.Proposals.Current(ctx, in.RepoID, branch)","   if err != nil {","-    if mapped := proposalStoreError(err); mapped != nil {","-      return nil, mapped","-    }","-    return nil, huma.Error500InternalServerError(\"brain: list open proposals\", err)","+    return nil, brainProposalStoreError(err)","   }","   out := &BrainProposalsListOutput{}","-  out.Body.Proposals = make([]BrainProposal, 0, len(found))","-  for _, p := range found {","-    out.Body.Proposals = append(out.Body.Proposals, wireProposal(p))","+  out.Body.Found = found","+  out.Body.Ref = ref","+  out.Body.Version = version","+  out.Body.Proposals = []brainProposal{}","+  if found {","+    set, decErr := decodeProposalSet(plaintext)","+    if decErr != nil {","+      return nil, huma.Error500InternalServerError(\"stored proposal set is unreadable\")","+    }","+    if set != nil {","+      out.Body.Proposals = set","+    }","   }","   return out, nil"," }"," ","-// getBrainProposal returns one proposal + its decrypted plaintext (repo pull).","+// getBrainProposal returns one entry by id. Absent is found=false, not 404 — see","+// BrainProposalGetOutput."," func getBrainProposal(ctx context.Context, deps *RepoActivityDeps, in *BrainProposalGetInput) (*BrainProposalGetOutput, error) {","   if deps.Proposals == nil {","-    return nil, huma.Error503ServiceUnavailable(\"brain proposals not configured\")","+    return nil, huma.Error503ServiceUnavailable(\"brain proposal queue not configured\")","   }","-  if in.ProposalID == \"\" {","+  branch := strings.TrimSpace(in.Branch)","+  if branch == \"\" {","+    return nil, huma.Error400BadRequest(\"branch is required\")","+  }","+  id := strings.TrimSpace(in.ProposalID)","+  if id == \"\" {","     return nil, huma.Error400BadRequest(\"proposal_id is required\")","   }","-  p, data, err := deps.Proposals.Get(ctx, in.RepoID, in.ProposalID)","+  ref, _, plaintext, found, err := deps.Proposals.Current(ctx, in.RepoID, branch)","   if err != nil {","-    if mapped := proposalStoreError(err); mapped != nil {","-      return nil, mapped","-    }","-    return nil, huma.Error500InternalServerError(\"brain: read proposal\", err)","+    return nil, brainProposalStoreError(err)","   }","   out := &BrainProposalGetOutput{}","-  out.Body.Proposal = wireProposal(p)","-  out.Body.Data = data","-  return out, nil","-}","-","-// openBrainProposal queues a contribution (repo push).","-func openBrainProposal(ctx context.Context, deps *RepoActivityDeps, in *BrainProposalOpenInput) (*BrainProposalOpenOutput, error) {","-  if deps.Proposals == nil {","-    return nil, huma.Error503ServiceUnavailable(\"brain proposals not configured\")","+  out.Body.Ref = ref","+  if !found {","+    return out, nil","   }","-  if in.Body.Branch == \"\" {","-    return nil, huma.Error400BadRequest(\"branch is required\")","+  set, decErr := decodeProposalSet(plaintext)","+  if decErr != nil {","+    return nil, huma.Error500InternalServerError(\"stored proposal set is unreadable\")","   }","-  if len(in.Body.Data) == 0 {","-    return nil, huma.Error400BadRequest(\"data is required (a proposal always carries content)\")","-  }","-  p, err := deps.Proposals.Open(ctx, in.RepoID, brainbuild.OpenProposalRequest{","-    Branch:     in.Body.Branch,","-    BaseRef:    in.Body.BaseRef,","-    ProposedBy: in.Body.ProposedBy,","-    Summary:    in.Body.Summary,","-    Plaintext:  in.Body.Data,","-  })","-  if err != nil {","-    if mapped := proposalStoreError(err); mapped != nil {","-      return nil, mapped","+  for i := range set {","+    if set[i].ID == id {","+      out.Body.Found = true","+      out.Body.Proposal = &set[i]","+      break","     }","-    return nil, huma.Error500InternalServerError(\"brain: open proposal\", err)","   }","-  out := &BrainProposalOpenOutput{}","-  out.Body.Proposal = wireProposal(p)","   return out, nil"," }"," ","-// applyBrainProposal merges an open proposal into its branch head (repo push).","-// A moved head is 412 (re-base), an already-closed proposal 409.","-func applyBrainProposal(ctx context.Context, deps *RepoActivityDeps, in *BrainProposalApplyInput) (*BrainProposalApplyOutput, error) {","+// publishBrainProposals replaces the whole set under CAS (repo push).","+func publishBrainProposals(ctx context.Context, deps *RepoActivityDeps, in *BrainProposalsPublishInput) (*BrainProposalsPublishOutput, error) {","   if deps.Proposals == nil {","-    return nil, huma.Error503ServiceUnavailable(\"brain proposals not configured\")","+    return nil, huma.Error503ServiceUnavailable(\"brain proposal queue not configured\")","   }","-  if in.ProposalID == \"\" {","-    return nil, huma.Error400BadRequest(\"proposal_id is required\")","+  branch := strings.TrimSpace(in.Body.Branch)","+  if branch == \"\" {","+    return nil, huma.Error400BadRequest(\"branch is required\")","   }","-  p, headRef, version, changed, err := deps.Proposals.Apply(ctx, in.RepoID, in.ProposalID)","+  plaintext, err := encodeProposalSet(in.Body.Proposals)","   if err != nil {","-    if mapped := proposalStoreError(err); mapped != nil {","-      return nil, mapped","+    return nil, huma.Error400BadRequest(\"proposals could not be encoded\")","+  }","+  newRef, version, err := deps.Proposals.Advance(ctx, in.RepoID, branch, in.Body.OldRef, plaintext)","+  out := &BrainProposalsPublishOutput{}","+  switch {","+  case err == nil:","+    out.Body.Ref = newRef","+    out.Body.Version = version","+    out.Body.Changed = true","+    return out, nil","+  case errors.Is(err, brainbuild.ErrNoFactSetChange):","+    // Byte-identical to the current set: idempotent republish. Echo the head.","+    ref, v, _, _, curErr := deps.Proposals.Current(ctx, in.RepoID, branch)","+    if curErr != nil {","+      return nil, brainProposalStoreError(curErr)","     }","-    return nil, huma.Error500InternalServerError(\"brain: apply proposal\", err)","+    out.Body.Ref = ref","+    out.Body.Version = v","+    out.Body.Changed = false","+    return out, nil","+  default:","+    return nil, brainProposalStoreError(err)","   }","-  out := &BrainProposalApplyOutput{}","-  out.Body.Proposal = wireProposal(p)","-  out.Body.HeadRef = headRef","-  out.Body.Version = version","-  out.Body.Changed = changed","-  return out, nil"," }"," ","-// rejectBrainProposal refuses an open proposal (repo push). The head is untouched.","-func rejectBrainProposal(ctx context.Context, deps *RepoActivityDeps, in *BrainProposalRejectInput) (*BrainProposalRejectOutput, error) {","-  if deps.Proposals == nil {","-    return nil, huma.Error503ServiceUnavailable(\"brain proposals not configured\")","+// resolveBrainProposal applies the runner's settlement: swap the fact head (unless","+// the settlement touches no facts) and the proposal set, each from the ref the runner","+// read. Either CAS losing is a 412 — the runner re-reads and re-resolves.","+func resolveBrainProposal(ctx context.Context, deps *RepoActivityDeps, in *BrainProposalResolveInput) (*BrainProposalResolveOutput, error) {","+  if deps.Proposals == nil || deps.Facts == nil {","+    return nil, huma.Error503ServiceUnavailable(\"brain proposal queue not configured\")","   }","-  if in.ProposalID == \"\" {","+  branch := strings.TrimSpace(in.Body.Branch)","+  if branch == \"\" {","+    return nil, huma.Error400BadRequest(\"branch is required\")","+  }","+  if strings.TrimSpace(in.ProposalID) == \"\" {","     return nil, huma.Error400BadRequest(\"proposal_id is required\")","   }","-  p, err := deps.Proposals.Reject(ctx, in.RepoID, in.ProposalID, in.Body.Reason)","+  decision := strings.TrimSpace(in.Body.Decision)","+  if decision != \"accept\" && decision != \"reject\" {","+    return nil, huma.Error400BadRequest(\"decision must be accept or reject\")","+  }","+  if in.Body.FactsUnchanged && decision != \"reject\" {","+    // Guard the prune path at the boundary: skipping the fact write on an accept","+    // would retire the proposal while silently dropping its merge result.","+    return nil, huma.Error400BadRequest(\"factsUnchanged is only valid with decision=reject\")","+  }","+  if !in.Body.FactsUnchanged && len(in.Body.Data) == 0 {","+    return nil, huma.Error400BadRequest(\"data is required (a fact-set head always points at content)\")","+  }","+","+  // FACTS FIRST. A settlement that advances facts but loses the proposal-set CAS","+  // leaves a settled fact set with the entry still queued — the runner re-reads and","+  // re-resolves, and re-applying the same settlement is a no-op. The reverse order","+  // could drop the entry while the facts never moved, losing the settlement.","+  factsRef := in.Body.FactsOldRef","+  if !in.Body.FactsUnchanged {","+    newFactsRef, _, err := deps.Facts.Advance(ctx, in.RepoID, branch, in.Body.FactsOldRef, in.Body.Data)","+    switch {","+    case err == nil:","+      factsRef = newFactsRef","+    case errors.Is(err, brainbuild.ErrNoFactSetChange):","+      // The resolution produced the current content: keep the head as-is.","+    default:","+      return nil, brainProposalStoreError(err)","+    }","+  }","+","+  remaining, err := encodeProposalSet(in.Body.Proposals)","   if err != nil {","-    if mapped := proposalStoreError(err); mapped != nil {","-      return nil, mapped","+    return nil, huma.Error400BadRequest(\"proposals could not be encoded\")","+  }","+  out := &BrainProposalResolveOutput{}","+  out.Body.FactsRef = factsRef","+  newSetRef, _, err := deps.Proposals.Advance(ctx, in.RepoID, branch, in.Body.ProposalsOldRef, remaining)","+  switch {","+  case err == nil:","+    out.Body.ProposalsRef = newSetRef","+    out.Body.Changed = true","+    return out, nil","+  case errors.Is(err, brainbuild.ErrNoFactSetChange):","+    ref, _, _, _, curErr := deps.Proposals.Current(ctx, in.RepoID, branch)","+    if curErr != nil {","+      return nil, brainProposalStoreError(curErr)","     }","-    return nil, huma.Error500InternalServerError(\"brain: reject proposal\", err)","+    out.Body.ProposalsRef = ref","+    out.Body.Changed = false","+    return out, nil","+  default:","+    return nil, brainProposalStoreError(err)","   }","-  out := &BrainProposalRejectOutput{}","-  out.Body.Proposal = wireProposal(p)","-  return out, nil"," }"," ","-// registerBrainProposals wires the open-proposal-set endpoints on the repo-activity","-// router. Reads gate on repo pull (the queue is shared team memory under review);","-// open/apply/reject gate on repo push (they mutate the queue or the head), matching","-// registerBrainFacts. The open op carries the same generous body cap the publish and","-// advance ops use, since a proposed fact-set arrives base64-encoded.","-func registerBrainProposals(api huma.API, deps *RepoActivityDeps) {","-  readGate := []opMiddleware{requireAuth(api, &deps.baseDeps), requireRepoAccess(api, deps)}","-  writeGate := []opMiddleware{requireAuth(api, &deps.baseDeps), requireRepoPush(api, deps)}","-","-  listOp := teamOp(\"repoBrainProposalsList\", http.MethodGet, \"/repos/{repo_id}/brain/proposals\",","-    \"List the open brain fact-set proposals (requires repo pull access)\", \"brain\", readGate)","-  declareErrors(&listOp, http.StatusNotFound)","-  huma.Register(api, listOp,","-    func(ctx context.Context, in *BrainProposalsListInput) (*BrainProposalsListOutput, error) {","-      return listBrainProposals(ctx, deps, in)","-    })","-","-  getOp := teamOp(\"repoBrainProposalGet\", http.MethodGet, \"/repos/{repo_id}/brain/proposals/{proposal_id}\",","-    \"Read one brain fact-set proposal and its proposed content (requires repo pull access)\", \"brain\", readGate)","-  declareErrors(&getOp, http.StatusNotFound)","-  huma.Register(api, getOp,","-    func(ctx context.Context, in *BrainProposalGetInput) (*BrainProposalGetOutput, error) {","-      return getBrainProposal(ctx, deps, in)","-    })","-","-  openOp := teamOp(\"repoBrainProposalOpen\", http.MethodPost, \"/repos/{repo_id}/brain/proposals\",","-    \"Open a brain fact-set proposal for review (requires repo push access)\", \"brain\", writeGate)","-  openOp.MaxBodyBytes = maxBrainArtifactBytes","-  // 409 when this exact contribution was already applied or rejected; 404 on an","-  // unresolved repo. Both are outside teamOp's stdErrors.","-  declareErrors(&openOp, http.StatusConflict, http.StatusNotFound)","-  huma.Register(api, openOp,","-    func(ctx context.Context, in *BrainProposalOpenInput) (*BrainProposalOpenOutput, error) {","-      return openBrainProposal(ctx, deps, in)","-    })","-","-  applyOp := teamOp(\"repoBrainProposalApply\", http.MethodPost, \"/repos/{repo_id}/brain/proposals/{proposal_id}/apply\",","-    \"Apply a brain fact-set proposal to its branch head (requires repo push access)\", \"brain\", writeGate)","-  // Three statuses beyond stdErrors: 409 (no longer open), 412 (head moved past the","-  // proposal's base — re-base), 404 (unknown repo or proposal).","-  declareErrors(&applyOp, http.StatusConflict, http.StatusPreconditionFailed, http.StatusNotFound)","-  huma.Register(api, applyOp,","-    func(ctx context.Context, in *BrainProposalApplyInput) (*BrainProposalApplyOutput, error) {","-      return applyBrainProposal(ctx, deps, in)","-    })","-","-  rejectOp := teamOp(\"repoBrainProposalReject\", http.MethodPost, \"/repos/{repo_id}/brain/proposals/{proposal_id}/reject\",","-    \"Reject a brain fact-set proposal (requires repo push access)\", \"brain\", writeGate)","-  declareErrors(&rejectOp, http.StatusConflict, http.StatusNotFound)","-  huma.Register(api, rejectOp,","-    func(ctx context.Context, in *BrainProposalRejectInput) (*BrainProposalRejectOutput, error) {","-      return rejectBrainProposal(ctx, deps, in)","-    })","+// brainProposalStoreError maps store faults to the status codes the runner's retry","+// loop is written against: a lost CAS is 412 (re-read and re-resolve), an","+// unresolvable repo is 404 (fail closed), anything else is 500.","+func brainProposalStoreError(err error) error {","+  switch {","+  case errors.Is(err, brainbuild.ErrFactRefConflict):","+    return huma.Error412PreconditionFailed(\"proposal set advanced concurrently; re-read and re-resolve\")","+  case errors.Is(err, brainbuild.ErrRepoNotFound):","+    return huma.NewError(http.StatusNotFound, \"repo not found\")","+  default:","+    return huma.Error500InternalServerError(\"brain proposal store unavailable\")","+  }"," }"]}],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"d3be1099-aa0a-433c-aa65-93ec4a0856c1","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/p0p1/p1-new","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
