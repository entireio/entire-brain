{"type":"last-prompt","lastPrompt":"epxlain to me eahc p of the brain","leafUuid":"effee8b0-5388-4e98-ae6b-860537131c9f","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af"}
