{"parentUuid":"aa9a0334-b177-48fe-a8eb-8dcec3a968f6","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/suhaan/devenv/p0p1/api-242/internal/httpapi/brain_roundtrip_test.go","snippet":"1\tpackage httpapi\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"net/http/httptest\"\n7\t\t\"os\"\n8\t\t\"os/exec\"\n9\t\t\"path/filepath\"\n10\t\t\"strings\"\n11\t\t\"testing\"\n12\t\t\"time\"\n13\t)\n14\t\n15\t// The LIVE cross-repo round trip: the real entire-brain binary driving this service's\n16\t// real router over real HTTP.\n17\t//\n18\t// This is the check PR #64 deferred and nobody had run. Everything on both sides was\n19\t// proven against fakes, and both sides' unit suites were green while the two disagreed\n20\t// on THREE things at once — paths, settle verb, and proposal-id derivation — because\n21\t// no test crossed the boundary. A contract test pins the JSON shapes; only this proves\n22\t// the client's URLs, auth headers, status handling and CAS loop actually work against\n23\t// the handlers as registered.\n24\t//\n25\t// It runs only when ENTIRE_BRAIN_BIN points at a built brain binary, so the normal\n26\t// suite is unaffected:\n27\t//\n28\t//\tcd <entire-brain> && go build -o /tmp/entire-brain ./cmd/entire-brain\n29\t//\tENTIRE_BRAIN_BIN=/tmp/entire-brain go test ./internal/httpapi/ -run TestBrainRoundTrip -v\n30\tfunc TestBrainRoundTripAgainstRealClient(t *testing.T) {\n31\t\tbin := strings.TrimSpace(os.Getenv(\"ENTIRE_BRAIN_BIN\"))\n32\t\tif bin == \"\" {\n33\t\t\tt.Skip(\"set ENTIRE_BRAIN_BIN to a built entire-brain binary to run the live round trip\")\n34\t\t}\n35\t\tif _, err := os.Stat(bin); err != nil {\n36\t\t\tt.Fatalf(\"ENTIRE_BRAIN_BIN=%s: %v\", bin, err)\n37\t\t}\n38\t\n39\t\t// A real router with a push-capable caller: the brain client both reads and\n40\t\t// advances, so a pull-only gate would fail for the wrong reason.\n41\t\tauthn, mint := jwksAuth(t)\n42\t\tbase := baseDeps{\n43\t\t\tAuthenticator: authn,\n44\t\t\tReader:        fakeReaderRW([]string{factsRepoID}, []string{factsRepoID}, nil, false),\n45\t\t}\n46\t\tdeps := newProposalsTest()\n47\t\tdeps.baseDeps = base\n48\t\tr := NewActivityAPIRouter(deps, &UserActivityDeps{baseDeps: base, Store: fakeUserReader{}})\n49\t\n50\t\tsrv := httptest.NewServer(r.HTTPHandler())\n51\t\tt.Cleanup(srv.Close)\n52\t\ttoken := mint(routeULID(\"acc1\"))\n53\t\n54\t\t// A git repo for the brain to attach to, plus isolated config/cache so the run\n55\t\t// cannot touch the developer's real brain.\n56\t\trepoDir := t.TempDir()\n57\t\thome := t.TempDir()\n58\t\trunGit := func(args ...string) {\n59\t\t\tt.Helper()\n60\t\t\tcmd := exec.Command(\"git\", args...)\n61\t\t\tcmd.Dir = repoDir\n62\t\t\tif out, err := cmd.CombinedOutput(); err != nil {\n63\t\t\t\tt.Fatalf(\"git %s: %v\\n%s\", strings.Join(args, \" \"), err, out)\n64\t\t\t}\n65\t\t}\n66\t\trunGit(\"init\", \"-q\", \"-b\", \"main\")\n67\t\trunGit(\"config\", \"user.email\", \"member-a@example.com\")\n68\t\trunGit(\"config\", \"user.name\", \"Member A\")\n69\t\tif err := os.WriteFile(filepath.Join(repoDir, \"README.md\"), []byte(\"# roundtrip\\n\"), 0o644); err != nil {\n70\t\t\tt.Fatal(err)\n71\t\t}\n72\t\trunGit(\"add\", \"-A\")\n73\t\trunGit(\"commit\", \"-q\", \"-m\", \"seed\")\n74\t\n75\t\tbrain := func(t *testing.T, args ...string) (string, error) {\n76\t\t\tt.Helper()\n77\t\t\tctx, cancel := context.WithTimeout(t.Context(), 90*time.Second)\n78\t\t\tdefer cancel()\n79\t\t\tcmd := exec.CommandContext(ctx, bin, args...)\n80\t\t\tcmd.Dir = repoDir\n81\t\t\tcmd.Env = append(os.Environ(),\n82\t\t\t\t\"HOME=\"+home,\n83\t\t\t\t\"XDG_CONFIG_HOME=\"+filepath.Join(home, \".config\"),\n84\t\t\t\t\"XDG_CACHE_HOME=\"+filepath.Join(home, \".cache\"),\n85\t\t\t\t\"ENTIRE_BRAIN_ALLOW_HOSTED=1\",\n86\t\t\t\t\"ENTIRE_BRAIN_NO_EGRESS=\",\n87\t\t\t\t\"ENTIRE_BRAIN_LOCAL_ONLY=\",\n88\t\t\t\t\"ENTIRE_API_URL=\"+srv.URL,\n89\t\t\t\t\"ENTIRE_API_TOKEN=\"+token,\n90\t\t\t\t\"ENTIRE_REPO_ID=\"+factsRepoID,\n91\t\t\t)\n92\t\t\tout, err := cmd.CombinedOutput()\n93\t\t\treturn string(out), err\n94\t\t}\n95\t\n96\t\t// 1. SYNC against the hosted backend. This is the whole client path: resolve the\n97\t\t//    backend, GET the fact head, keep-both merge, CAS it back, then read and\n98\t\t//    reconcile the proposal queue.\n99\t\tout, err := brain(t, \"facts\", \"sync\", \"--facts-backend\", \"http\", \"--member\", \"member-A\", \"--json\")\n100\t\tif err != nil {\n101\t\t\tt.Fatalf(\"facts sync against the live server failed: %v\\n%s\", err, out)\n102\t\t}\n103\t\tvar synced map[string]any\n104\t\tif jsonErr := json.Unmarshal([]byte(lastJSONLine(out)), &synced); jsonErr != nil {\n105\t\t\tt.Fatalf(\"sync did not emit JSON: %v\\n%s\", jsonErr, out)\n106\t\t}\n107\t\tif synced[\"backend\"] != \"http\" {\n108\t\t\tt.Fatalf(\"sync did not use the hosted backend: %v\", synced[\"backend\"])\n109\t\t}\n110\t\t// The queue must have been REACHED, not reported unsupported: an unsupported\n111\t\t// queue is exactly what a path or status mismatch looks like from the client.\n112\t\tif msg, ok := synced[\"proposals_share_error\"]; ok {\n113\t\t\tt.Fatalf(\"client could not reach the hosted proposal queue: %v\\n%s\", msg, out)\n114\t\t}\n115\t\n116\t\t// 2. The proposal surface must answer over the wire, with no error and no\n117\t\t//    \"unsupported\" degrade.\n118\t\tout, err = brain(t, \"facts\", \"proposals\", \"list\", \"--branch\", \"main\", \"--json\")\n119\t\tif err != nil {\n120\t\t\tt.Fatalf(\"facts proposals list against the live server failed: %v\\n%s\", err, out)\n121\t\t}\n122\t\tif strings.Contains(out, \"unsupported\") || strings.Contains(out, \"no shared review queue\") {\n123\t\t\tt.Fatalf(\"client read the live queue as absent — path or status mismatch:\\n%s\", out)\n124\t\t}\n125\t\n126\t\t// 3. And the server agrees about what it stored: the head the client advanced is\n127\t\t//    readable through this service's own handler.\n128\t\tcur, err := currentBrainFacts(t.Context(), deps, currentInput(\"main\"))\n129\t\tif err != nil {\n130\t\t\tt.Fatalf(\"server-side read of the head the client advanced: %v\", err)\n131\t\t}\n132\t\tif !cur.Body.Found || cur.Body.Ref == \"\" {\n133\t\t\tt.Fatalf(\"client sync did not leave a fact head on the server: %+v\", cur.Body)\n134\t\t}\n135\t}\n136\t\n137\t// lastJSONLine returns the final line that looks like a JSON object, so warnings\n138\t// printed to stderr before the payload do not break parsing.\n139\tfunc lastJSONLine(out string) string {\n140\t\tlines := strings.Split(strings.TrimSpace(out), \"\\n\")\n141\t\tfor i := len(lines) - 1; i >= 0; i-- {\n142\t\t\tl := strings.TrimSpace(lines[i])\n143\t\t\tif strings.HasPrefix(l, \"{\") && strings.HasSuffix(l, \"}\") {\n144\t\t\t\treturn l\n145\t\t\t}\n146\t\t}\n147\t\treturn \"{}\"\n148\t}"},"type":"attachment","uuid":"1afc4949-c6fe-4029-a462-5e6f0f7f90ce","timestamp":"2026-08-17T17:47:08.268Z","session_id":"f507d58c-285f-4d11-b1d0-201f2a5e172d","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/p0p1/api-242","sessionId":"de272aad-c620-4d71-bbdd-27dd2d3dc8af","version":"2.1.233","gitBranch":"main","slug":"quizzical-sniffing-quasar"}
