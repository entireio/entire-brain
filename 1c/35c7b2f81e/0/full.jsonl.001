tePacks, report.CandidatePacksIfUncached, distillCandidatePackMaxRenderedBytesV2, distillCandidatePackMaxMembersV2)\ninternal/cli/distill_cmd.go:1732:func distillMaxChunkBytes(distillOpts distillCommandOptions) int {\ninternal/cli/distill_cmd.go:1840:\t\tif pipeline == distillPipelineCandidates && plan.CandidateBytes > int64(distillCandidateMaxPreflightBytes) {\ninternal/cli/distill_cmd.go:1841:\t\t\treturn distillPlan{}, fmt.Errorf(\"candidate preflight input exceeds %d bytes\", distillCandidateMaxPreflightBytes)\ninternal/cli/distill_cmd.go:2070:\t\t\tif allowMinified && len(messages) >= distillCandidateMaxTurns {\ninternal/cli/distill_cmd.go:2084:\t\t\tif allowMinified && len(rawMessage) > distillCandidateMaxRecordBytes {\ninternal/cli/distill_cmd.go:2098:\t\t\t\tif len(*msg.Parts) > distillCandidateMaxMessageParts || totalParts > distillCandidateMaxDocumentParts {\ninternal/cli/distill_cmd.go:2286:\tcards, overflow := selectDistillCandidateCardsLimitedV1(normalized, distillCandidateMaxCards)\ninternal/cli/distill_cmd.go:2288:\t\treturn preparedDistillSessionInput{Err: fmt.Errorf(\"candidate pipeline selected more than %d cards for %s\", distillCandidateMaxCards, filepath.ToSlash(session.TranscriptPath))}\ninternal/cli/distill_cmd.go:2294:\t\tcardLimit = distillCandidatePackMaxRenderedBytesV2\ninternal/cli/distill_cmd.go:2301:\tfingerprint := sha256.New()\ninternal/cli/distill_cmd.go:2306:\t\tif candidateBytes > distillCandidateMaxInputBytes {\ninternal/cli/distill_cmd.go:2307:\t\t\treturn preparedDistillSessionInput{Err: fmt.Errorf(\"candidate pipeline rendered input for %s exceeds %d bytes\", filepath.ToSlash(session.TranscriptPath), distillCandidateMaxInputBytes)}\ninternal/cli/distill_cmd.go:2316:\t\tFingerprintMaterial: \"sha256:\" + hex.EncodeToString(fingerprint.Sum(nil)),\ninternal/cli/distill_cmd.go:2407:\tcontentSum := sha256.Sum256([]byte(content))\ninternal/cli/distill_cmd.go:2408:\tsum := sha256.Sum256([]byte(strings.Join([]string{\ninternal/cli/distill_cmd.go:2415:\treturn \"sha256:\" + hex.EncodeToString(sum[:])\ninternal/cli/distill_cmd.go:2424:\tcontentSum := sha256.Sum256([]byte(content))\ninternal/cli/distill_cmd.go:2425:\tsum := sha256.Sum256([]byte(strings.Join([]string{\ninternal/cli/distill_cmd.go:2432:\treturn \"sha256:\" + hex.EncodeToString(sum[:])\ninternal/cli/distill_cmd.go:2536:\tsum := sha256.Sum256(data)\ninternal/cli/distill_cmd.go:2537:\treturn \"sha256:\" + hex.EncodeToString(sum[:])\ninternal/cli/distill_cmd.go:2843:\tstderr := newCappedDistillBuffer(distillMaxOutputBytes)\ninternal/cli/distill_cmd.go:2878:\tif len(decodedOutput) > distillMaxOutputBytes {\ninternal/cli/distill_cmd.go:2879:\t\treturn \"\", fmt.Errorf(\"agent result exceeds %d bytes\", distillMaxOutputBytes)\ninternal/cli/distill_cmd.go:2986:\tdata, err := io.ReadAll(io.LimitReader(resp.Body, distillMaxOutputBytes+1))\ninternal/cli/distill_cmd.go:2990:\tif len(data) > distillMaxOutputBytes {\ninternal/cli/distill_cmd.go:2991:\t\treturn \"\", fmt.Errorf(\"ollama output exceeds %d bytes\", distillMaxOutputBytes)\ninternal/cli/distill_cache_v2.go:6:\t\"crypto/sha256\"\ninternal/cli/distill_cache_v2.go:22:\tdistillCandidateResultCacheV2MaxBytes   = 8 << 20\ninternal/cli/distill_cache_v2.go:23:\tdistillCandidateResultCacheV2MaxEntries = 4096\ninternal/cli/distill_cache_v2.go:24:\tdistillCandidateResultCacheV2MaxLine    = 32 << 10\ninternal/cli/distill_cache_v2.go:25:\tdistillCandidateResultCacheV2MaxField   = 4096\ninternal/cli/distill_cache_v2.go:29:\t// CardDigest is SHA-256 over the redacted, rendered card. It intentionally\ninternal/cli/distill_cache_v2.go:84:\tsum := sha256.Sum256([]byte(\"distill-candidate-owner-v2\\x00\" + strings.TrimSpace(sessionID)))\ninternal/cli/distill_cache_v2.go:85:\treturn \"sha256:\" + hex.EncodeToString(sum[:])\ninternal/cli/distill_cache_v2.go:89:\tsum := sha256.Sum256([]byte(value))\ninternal/cli/distill_cache_v2.go:90:\treturn \"sha256:\" + hex.EncodeToString(sum[:])\ninternal/cli/distill_cache_v2.go:123:\tif _, exists := cache.entries[entry.CandidateID]; !exists && len(cache.entries) >= distillCandidateResultCacheV2MaxEntries {\ninternal/cli/distill_cache_v2.go:124:\t\treturn fmt.Errorf(\"candidate result cache exceeds %d entries\", distillCandidateResultCacheV2MaxEntries)\ninternal/cli/distill_cache_v2.go:132:\tdata, present, err := readMemoryStateFile(brainDir, distillCandidateResultCacheV2Path, \"candidate result cache\", distillCandidateResultCacheV2MaxBytes)\ninternal/cli/distill_cache_v2.go:155:\tif len(cache.entries) > distillCandidateResultCacheV2MaxEntries {\ninternal/cli/distill_cache_v2.go:156:\t\treturn nil, fmt.Errorf(\"candidate result cache exceeds %d entries\", distillCandidateResultCacheV2MaxEntries)\ninternal/cli/distill_cache_v2.go:164:\t\tif len(data) > distillCandidateResultCacheV2MaxLine {\ninternal/cli/distill_cache_v2.go:165:\t\t\treturn fmt.Errorf(\"candidate result cache record exceeds %d bytes\", distillCandidateResultCacheV2MaxLine)\ninternal/cli/distill_cache_v2.go:191:\tif out.Len() > distillCandidateResultCacheV2MaxBytes {\ninternal/cli/distill_cache_v2.go:192:\t\treturn nil, fmt.Errorf(\"candidate result cache exceeds %d bytes\", distillCandidateResultCacheV2MaxBytes)\ninternal/cli/distill_cache_v2.go:199:\tif len(data) == 0 || len(data) > distillCandidateResultCacheV2MaxBytes {\ninternal/cli/distill_cache_v2.go:203:\tscanner.Buffer(make([]byte, 1024), distillCandidateResultCacheV2MaxLine+1)\ninternal/cli/distill_cache_v2.go:212:\t\tif len(line) > distillCandidateResultCacheV2MaxLine {\ninternal/cli/distill_cache_v2.go:213:\t\t\treturn cache, fmt.Errorf(\"line %d exceeds %d bytes\", lineNo, distillCandidateResultCacheV2MaxLine)\ninternal/cli/distill_cache_v2.go:249:\t\t\tif len(cache.entries) >= distillCandidateResultCacheV2MaxEntries {\ninternal/cli/distill_cache_v2.go:250:\t\t\t\treturn cache, fmt.Errorf(\"cache exceeds %d entries\", distillCandidateResultCacheV2MaxEntries)\ninternal/cli/distill_cache_v2.go:273:\tif !