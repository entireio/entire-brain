ry).\n250-func sortedTaxonomyTopLevels(taxonomy factTaxonomy) []string {\n251-\tcats := make([]string, 0, len(taxonomy.Categories))\n252-\tfor category := range taxonomy.Categories {\n253-\t\tcats = append(cats, category)\n254-\t}\n255-\tsort.Strings(cats)\n256-\treturn cats\n257-}\n258-\n259-// factPathKnownTopLevel reports whether path's top-level category exists in the\n260-// taxonomy. This is the conservative drift check: a fact keeps its assigned\n226:// writeFactTaxonomy persists the active taxonomy snapshot.\n227:func writeFactTaxonomy(brainDir string, taxonomy factTaxonomy) error {\ninternal/cli/brain.go:125:\tdata, present, err := readMemoryStateFile(outputDir, exportManifestFileName, \"brain manifest\", maxManifestBytes)\ninternal/cli/brain.go:336:func writeBrainRelativeFileAtomic(brainDir, rel string, data []byte, perm os.FileMode) error {\ninternal/cli/distill_cache_v2.go:132:\tdata, present, err := readMemoryStateFile(brainDir, distillCandidateResultCacheV2Path, \"candidate result cache\", distillCandidateResultCacheV2MaxBytes)\ninternal/cli/distill_cmd.go:2676:\tdata, present, err := readMemoryStateFile(brainDir, filepath.ToSlash(rel), \"derived Brain state\", defaultMaxReadBytes)\ninternal/cli/distill_cmd.go:2691:\tdata, present, err := readMemoryStateFile(brainDir, distillCachePath, \"distill cache\", maxManifestBytes)\ninternal/cli/history.go:1116:\tdata, present, err := readMemoryStateFile(outputDir, filepath.ToSlash(rel), \"history projection input\", limit)\ninternal/cli/memory_abstract.go:144:\tdata, present, err := readMemoryStateFile(brainDir, memoryConfigRel, \"memory config\", maxManifestBytes)\ninternal/cli/memory_abstract.go:299:\tdata, present, err := readMemoryStateFileExpected(brainDir, rel, \"abstract egress receipt\", maxManifestBytes, expected)\ninternal/cli/memory_abstract.go:1040:\tdata, present, err := readMemoryStateFile(brainDir, rel, \"session abstract\", abstractArtifactReadMax)\ninternal/cli/memory_abstract.go:1193:\t\tdata,