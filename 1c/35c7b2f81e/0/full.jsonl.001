first and last word plus all major words capitalized.\\\"\\\"\\\"\\n    text, saved = mask_phrases(text)\\n    toks = split_tokens(text)\\n    word_idx = [i for i, t in enumerate(toks) if re.match(r\\\"[A-Za-z]\\\", t) and not t.startswith(\\\"`\\\") and not t.startswith(\\\"[\\\")]\\n    if not word_idx:\\n        return unmask_phrases(text, saved)\",\"originalFile\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Chicago-style heading pass for Entire docs.\\n\\nTitles (frontmatter title/sidebarTitle, and H1 in bare .md files) -> CMOS 8.159\\nheadline style. Subheads (H2-H6, plus H1 in .mdx where frontmatter supplies the\\ntitle) -> CMOS 8.158 sentence style.\\n\\nProtected: fenced code blocks, inline code spans, links' target URLs, acronyms,\\nCamelCase identifiers, flags, filenames, and the proper-noun lexicon below.\\n\\\"\\\"\\\"\\nimport re\\nimport sys\\nimport pathlib\\n\\n# --- lexicon -----------------------------------------------------------------\\n# Proper nouns that keep their capitalization in sentence-style subheads.\\nPROPER = {\\n    # Entire and its surfaces\\n    \\\"Entire\\\", \\\"Entire.io\\\", \\\"ForgeMark\\\", \\\"Betterleaks\\\", \\\"Graph\\\", \\\"Skill\\\", \\\"Skills\\\",\\n    # agents and vendors\\n    \\\"Claude\\\", \\\"Codex\\\", \\\"Copilot\\\", \\\"Cursor\\\", \\\"Factory\\\", \\\"Gemini\\\",\\n    \\\"OpenCode\\\", \\\"Pi\\\", \\\"Anthropic\\\", \\\"Google\\\", \\\"GitHub\\\", \\\"GitLab\\\", \\\"Bitbucket\\\",\\n    \\\"Git\\\", \\\"Homebrew\\\", \\\"Scoop\\\", \\\"Mintlify\\\", \\\"Vite\\\", \\\"Slack\\\", \\\"Discord\\\", \\\"Twilio\\\",\\n    \\\"Stripe\\\", \\\"Postgres\\\", \\\"PostgreSQL\\\", \\\"MySQL\\\", \\\"MariaDB\\\", \\\"MongoDB\\\",\\n    \\\"Redis\\\", \\\"Docker\\\", \\\"Zscaler\\\", \\\"Cloudflare\\\",\\n    # platforms and languages\\n    \\\"macOS\\\", \\\"Linux\\\", \\\"Windows\\\", \\\"Unix\\\", \\\"Go\\\", \\\"Python\\\", \\\"TypeScript\\\",\\n    \\\"JavaScript\\\", \\\"Markdown\\\", \\\"YAML\\\", \\\"JSON\\\", \\\"Shannon\\\",\\n    # tools of art that are capitalized in the prose\\n    \\\"Chicago\\\",\\n}\\n# Words that stay lowercase in headline style: articles, coordinating\\n# conjunctions, prepositions (CMOS 8.159), and infinitival \\\"to\\\".\\nHEADLINE_LOWER = {\\n    \\\"a\\\", \\\"an\\\", \\\"the\\\",\\n    \\\"and\\\", \\\"but\\\", \\\"or\\\", \\\"nor\\\", \\\"for\\\", \\\"so\\\", \\\"yet\\\",\\n    \\\"about\\\", \\\"above\\\", \\\"across\\\", \\\"after\\\", \\\"against\\\", \\\"along\\\", \\\"among\\\", \\\"around\\\",\\n    \\\"as\\\", \\\"at\\\", \\\"before\\\", \\\"behind\\\", \\\"below\\\", \\\"beneath\\\", \\\"beside\\\", \\\"between\\\",\\n    \\\"beyond\\\", \\\"by\\\", \\\"despite\\\", \\\"down\\\", \\\"during\\\", \\\"except\\\", \\\"from\\\", \\\"in\\\",\\n    \\\"inside\\\", \\\"into\\\", \\\"like\\\", \\\"near\\\", \\\"of\\\", \\\"off\\\", \\\"on\\\", \\\"onto\\\", \\\"out\\\",\\n    \\\"outside\\\", \\\"over\\\", \\\"per\\\", \\\"since\\\", \\\"than\\\", \\\"through\\\", \\\"throughout\\\",\\n    \\\"to\\\", \\\"toward\\\", \\\"under\\\", \\\"until\\\", \\\"up\\\", \\\"upon\\\", \\\"via\\\", \\\"with\\\", \\\"within\\\",\\n    \\\"without\\\",\\n}\\n# Particles that stay capitalized when they belong to a phrasal verb.\\nPHRASAL_VERBS = {\\n    \\\"set\\\", \\\"turn\\\", \\\"log\\\", \\\"sign\\\", \\\"back\\\", \\\"check\\\", \\\"clean\\\", \\\"hand\\\", \\\"look\\\",\\n    \\\"pick\\\", \\\"roll\\\", \\\"shut\\\", \\\"start\\\", \\\"opt\\\", \\\"fill\\\", \\\"bring\\\", \\\"hold\\\", \\\"keep\\\",\\n    \\\"push\\\", \\\"pull\\\", \\\"drop\\\", \\\"break\\\", \\\"carry\\\", \\\"catch\\\", \\\"clear\\\", \\\"cut\\\", \\\"figure\\\",\\n}\\nPARTICLES = {\\\"up\\\", \\\"on\\\", \\\"off\\\", \\\"out\\\", \\\"in\\\", \\\"down\\\", \\\"over\\\", \\\"through\\\", \\\"away\\\", \\\"back\\\"}\\n\\n# Multiword proper nouns keep their internal capitalization as a unit, so that\\n# \\\"Claude Code\\\" does not protect a bare \\\"Code\\\" and \\\"GitHub App\\\" keeps its \\\"App\\\".\\nPHRASES = [\\n    \\\"Claude Code\\\", \\\"Copilot CLI\\\", \\\"Gemini CLI\\\", \\\"Factory Droid\\\", \\\"GitHub App\\\",\\n    \\\"GitHub Actions\\\", \\\"GitHub CLI\\\", \\\"Entire CLI\\\", \\\"Entire Graph\\\", \\\"Entire Brain\\\",\\n    \\\"Git LFS\\\", \\\"Agent Skills\\\", \\\"Code Search\\\", \\\"Pull Request\\\", \\\"Data Model\\\",\\n]\\nPLACEHOLDER = re.compile(r\\\"\\\\x01(\\\\d+)\\\\x01\\\")\\nTOKEN = re.compile(r\\\"\\\\x01\\\\d+\\\\x01|`[^`]*`|\\\\[[^\\\\]]*\\\\]\\\\([^)]*\\\\)|[A-Za-z][A-Za-z0-9''\\\\.\\\\-/]*|[^A-Za-z`\\\\[\\\\x01]+\\\")\\n\\n\\ndef mask_phrases(text):\\n    saved = []\\n    for phrase in PHRASES:\\n        pat = re.compile(r\\\"\\\\b\\\" + re.escape(phrase).replace(r\\\"\\\\ \\\", r\\\"\\\\s+\\\") + r\\\"\\\\b\\\", re.I)\\n\\n        def sub(m):\\n            saved.append(phrase)\\n            return f\\\"\\\\x01{len(saved) - 1}\\\\x01\\\"\\n\\n        text = pat.sub(sub, text)\\n    return text, saved\\n\\n\\ndef unmask_phrases(text, saved):\\n    return PLACEHOLDER.sub(lambda m: saved[int(m.group(1))], text)\\n\\n\\ndef is_protected_word(w):\\n    \\\"\\\"\\\"Acronyms, identifiers, flags, filenames, versions keep their shape.\\\"\\\"\\\"\\n    core = w.strip(\\\"()[],.:;\\\\\\\"'\\\")\\n    if not core:\\n        return True\\n    if core in PROPER:\\n        return True\\n    if core.startswith(\\\"-\\\"):            # --flag\\n        return True\\n    if core.upper() == core and len(core) > 1 and any(c.isalpha() for c in core):\\n        return True                     # CLI, API, PII, JSON, LFS, ID\\n    if any(c.isupper() for c in core[1:]):\\n        return True                     # CamelCase, Entire.io, macOS, NDJSON\\n    if \\\".\\\" in core or \\\"/\\\" in core or \\\"_\\\" in core:\\n        return True                     # filenames, paths, snake_case\\n    if any(c.isdigit() for c in core):\\n        return True\\n    return False\\n\\n\\ndef split_tokens(text):\\n    return TOKEN.findall(text)\\n\\n\\ndef sentence_case(text):\\n    \\\"\\\"\\\"CMOS 8.158: capitalize the first word and proper nouns only.\\\"\\\"\\\"\\n    text, saved = mask_phrases(text)\\n    out = []\\n    seen_word = False\\n    for tok in split_tokens(text):\\n        if PLACEHOLDER.fullmatch(tok):\\n            out.append(tok)\\n            seen_word = True\\n            continue\\n        if tok.startswith(\\\"`\\\") or tok.startswith(\\\"[\\\"):\\n            out.append(tok)\\n            if tok.startswith(\\\"`\\\"):\\n                seen_word = True\\n            continue\\n        if not re.match(r\\\"[A-Za-z]\\\", tok):\\n            out.append(tok)\\n            continue\\n        core = tok\\n        if is_protected_word(core):\\n            out.append(core)\\n            seen_word = True\\n            continue\\n        if not seen_word:\\n            out.append(core[0].upper() + core[1:].lower())\\n        else:\\n            out.append(core.lower())\\n        seen_word = True\\n    return \\\"\\\".join(out)\\n\\n\\ndef headline_case(text):\\n    \\\"\\\"\\\"CMOS 8.159: first and last word plus all major words capitalized.\\\"\\\"\\\"\\n    toks = split_tokens(text)\\n    word_idx = [i for i, t in enumerate(toks) if re.match(r\\\"[A-Za-z]\\\", t) and not t.startswith(\\\"`\\\") and not t.startswith(\\\"[\\\")]\\n    if not word_idx:\\n        return text\\n    first, last = word_idx[0], word_idx[-1]\\n    out = list(toks)\\n    prev_word = None\\n    for i in word_idx:\\n        tok = toks[i]\\n        if is_protected_word(tok):\\n            prev_word = tok.lower()\\n            continue\\n        low = tok.lower()\\n        cap = True\\n        if low in HEADLINE_LOWER and i not in (first, last):\\n            cap = False\\n            # phrasal-verb particles stay capitalized: \\\"Set Up\\\", \\\"Turn On\\\"\\n            if low in PARTICLES and prev_word in PHRASAL_VERBS:\\n                cap = True\\n        out[i] = (tok[0].upper() + tok[1:]) if cap else low\\n        prev_word = low\\n    return \\\"\\\".join(out)\\n\\n\\nFENCE = re.compile(r\\\"^\\\\s*(```|~~~)\\\")\\n\\n\\ndef process(path, apply=False):\\n    src = pathlib.Path(path).read_text()\\n    lines = src.split(\\\"\\\\n\\\")\\n    is_mdx = path.endswith(\\\".mdx\\\")\\n    out = []\\n    in_fence = False\\n    in_fm = False\\n    fm_done = False\\n    changes = []\\n    seen_h1 = False\\n    for n, line in enumerate(lines):\\n        new = line\\n        if n == 0 and line.strip() == \\\"---\\\" and not fm_done:\\n            in_fm = True\\n            out.append(line)\\n            continue\\n        if in_fm:\\n            if line.strip() == \\\"---\\\":\\n                in_fm = False\\n                fm_done = True\\n                out.append(line)\\n                continue\\n            m = re.match(r\\\"^(title|sidebarTitle):\\\\s*(.*)$\\\", line)\\n            if m:\\n                key, val = m.group(1), m.group(2).strip()\\n                quote = \\\"\\\"\\n                if val[:1] in \\\"\\\\\\\"'\\\" and val[-1:] == val[:1] and len(val) > 1:\\n                    quote, val = val[0], val[1:-1]\\n                fixed = headline_case(val)\\n                if fixed != val:\\n                    new = f\\\"{key}: {quote}{fixed}{quote}\\\"\\n            out.append(new)\\n            if new != line:\\n                changes.append((n + 1, line, new))\\n            continue\\n        if FENCE.match(line):\\n            in_fence = not in_fence\\n            out.append(line)\\n            continue\\n        if in_fence:\\n            out.append(line)\\n            continue\\n        m = re.match(r\\\"^(#{1,6})\\\\s+(.*?)\\\\s*$\\\", line)\\n        if m:\\n            hashes, text = m.group(1), m.group(2)\\n            level = len(hashes)\\n            if level == 1 and not is_mdx and not seen_h1:\\n                fixed = headline_case(text)   # bare .md H1 is the doc title\\n                seen_h1 = True\\n            else:\\n                fixed = sentence_case(text)\\n            if fixed != text:\\n                new = f\\\"{hashes} {fixed}\\\"\\n        out.append(new)\\n        if new != line:\\n            changes.append((n + 1, line, new))\\n    if apply and changes:\\n        pathlib.Path(path).write_text(\\\"\\\\n\\\".join(out))\\n    return changes\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    apply = \\\"--apply\\\" in sys.argv\\n    paths = [a for a in sys.argv[1:] if not a.startswith(\\\"--\\\")]\\n    total = 0\\n    for p in paths:\\n        ch = process(p, apply)\\n        if ch:\\n            print(f\\\"\\\\n=== {p}\\\")\\n            for n, old, new in ch:\\n                print(f\\\"  {n}: - {old}\\\")\\n                print(f\\\"  {n}: + {new}\\\")\\n            total += len(ch)\\n    print(f\\\"\\\\n{total} heading/title lines {'changed' if apply else 'would change'} across {len(paths)} files\\\")\\n\",\"structuredPatch\":[{\"oldStart\":130,\"oldLines\":15,\"newStart\":130,\"newLines\":16,\"lines\":[\"         else:\",\"             out.append(core.lower())\",\"         seen_word = True\",\"-    return \\\"\\\".join(out)\",\"+    return unmask_phrases(\\\"\\\".join(out), saved)\",\" \",\" \",\" def headline_case(text):\",\"     \\\"\\\"\\\"CMOS 8.159: first and last word plus all major words capitalized.\\\"\\\"\\\"\",\"+    text, saved = mask_phrases(text)\",\"     toks = split_tokens(text)\",\"     word_idx = [i for i, t in enumerate(toks) if re.match(r\\\"[A-Za-z]\\\", t) and not t.startswith(\\\"`\\\") and not t.startswith(\\\"[\\\")]\",\"     if not word_idx:\",\"-        return text\",\"+        return unmask_phrases(text, saved)\",\"     first, last = word_idx[0], word_idx[-1]\",\"     out = list(toks)\",\"     prev_word = None\"]}],\"userModified\":false,\"replaceAll\":false},\"sourceToolAssistantUUID\":\"7467f83e-a85d-4fcc-973a-6431481c4287\",\"session_id\":\"286bdfa8-11e7-4200-9658-cb6d4ad68b10\",\"userType\":\"external\",\"entrypoint\":\"cli\",\"cwd\":\"/Users/lizzies