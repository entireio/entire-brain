 {"," \t\tt.Fatalf(\"read %d bytes, must stop near the %d ceiling rather than following the stream\",","-=======","-\t// served counts what the server wrote, not what the client read: after","-\t// the client stops at the ceiling, kernel socket buffers on both ends","-\t// keep accepting writes, and tuned hosts buffer several MiB. The slack","-\t// only needs to separate \"stopped at the ceiling\" from \"followed the","-\t// stream to the 64 MiB overshoot\".","-\tif got := served.Load(); got > int64(distillOllamaMaxEnvelopeBytes)+(32<<20) {","-\t\tt.Fatalf(\"served %d bytes, must stop near the %d ceiling rather than following the stream\",","->>>>>>> origin/main"," \t\t\tgot, distillOllamaMaxEnvelopeBytes)"," \t}"," }"]}]},{"filePath":"/Users/suhaan/devenv/brain-followable/internal/cli/publish.go","hunks":[{"oldStart":168,"oldLines":18,"newStart":168,"newLines":7,"lines":[" "," \t// The master kill switch always wins over the hosted opt-in."," \tif brainNoEgressMode() {","-<<<<<<< HEAD","-\t\treturn fmt.Errorf(\"no_egress: hosted brain publish is disabled while ENTIRE_BRAIN_NO_EGRESS or ENTIRE_BRAIN_LOCAL_ONLY is set; unset it to publish\")","-\t}","-\t// Gate 2: the explicit hosted opt-in must be truthy. Unset/empty/false refuses","-\t// with no network call — the client-side no-implicit-egress guarantee. This is","-\t// deliberately NOT securityToggleEnabled (which fails a garbage value ON): a","-\t// publish opt-in must fail CLOSED, so anything not clearly truthy stays local.","-\tif !envBool(envBrainAllowHosted) {","-\t\treturn fmt.Errorf(\"hosted_publish_disabled: hosted brain publishing is opt-in and off by default; nothing was sent. Set %s=1 and re-run '\"+brainInvocation(os.LookupEnv, \"publish\")+\"' to enable it\", envBrainAllowHosted)","-======="," \t\treturn fmt.Errorf(\"no_egress: hosted brain publish is disabled while %s is set; unset it to publish\", noEgressToggleName())","->>>>>>> origin/main"," \t}"," "," \t// Locate the on-disk brain for this repo