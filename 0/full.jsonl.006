n true\n\t}\n\treturn agents.Installed && (agents.HookChanged || len(agents.Changed) > 0)\n}\n\n'''\ns = s.replace(anchor, helper + anchor, 1)\np.write_text(s); print(\"condition extracted to setupAgentsPhaseDidWork\")\nPY\ngofmt -w internal/cli/setup.go; env -u FORCE_COLOR GOMAXPROCS=2 go build ./... 2>&1|head -3; echo \"build=$?\"","description":"Extract the phase-work condition","timeout":400000},"caller":{"type":"direct"}}]}}
