cess"},{"name":"test (windows-latest) / shard 1","conclusion":"success"},{"name":"test (windows-latest) / shard 4","conclusion":"success"},{"name":"test (windows-latest) / shard 2","conclusion":"success"},{"name":"test (windows-latest) / shard 7","conclusion":"success"},{"name":"test (windows-latest) / shard 3","conclusion":"success"},{"name":"test (windows-latest) / shard 5","conclusion":"success"},{"name":"test (windows-latest) / shard 0","conclusion":"success"},{"name":"test (windows-latest) / non-heavy packages","conclusion":"success"},{"name":"release-evidence","conclusion":"skipped"},{"name":"build (linux, arm64)","conclusion":"success"},{"name":"phase1-semantic (macos-latest)","conclusion":"success"},{"name":"test-cgo (macos-latest)","conclusion":"success"},{"name":"test (windows-latest) / vet","conclusion":"success"},{"name":"test-cgo (ubuntu-latest)","conclusion":"success"},{"name":"test (ubuntu-latest)","conclusion":"success"},{"name":"benchmark-corpus","conclusion":"success"},{"name":"phase1-semantic (windows-latest)","conclusion":"success"},{"name":"build (linux, amd64)","conclusion":"success"},{"name":"build (darwin, amd64)","conclusion":"success"},{"name":"phase1-semantic (ubuntu-latest)","conclusion":"success"},{"name":"build","conclusion":"success"},{"name":"build (windows, amd64)","conclusion":"success"},{"name":"build (darwin, arm64)","conclusion":"success"},{"name":"lint","conclusion":"success"},{"name":"test (windows-latest) / compile and plan","conclusion":"success"},{"name":"benchmark-real-components","conclusion":"success"},{"name":"browser-smoke","conclusion":"success"},{"name":"regression-mutations","conclusion":"success"}]},"expectedRunnerIds":["trail-confidence","trail-drift","trail-risk","trail-security","trail-summary"],"startedRunnerIds":[],"terminalRunners":{},"mainReviewRunnerId":"trail-review","trailActivityObserved":true,"runnerPlanPending":false,"consecutiveGithubFailures":0,"consecutiveEntireFailures":0,"lastGithubSuccessAt":17921