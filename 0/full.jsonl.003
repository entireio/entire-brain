q.add(c['context'])\n  if c.get('app_id') is not None: apps.setdefault(c['context'],set()).add(c['app_id'])\nfor r in rules:\n if r['type']=='required_status_checks':\n  for c in r['parameters'].get('required_status_checks',[]):\n   if c['context'] not in excluded:\n    req.add(c['context'])\n    if c.get('integration_id') is not None: apps.setdefault(c['context'],set()).add(c['integration_id'])\nassert req\nchecks=load('checks.json'); runs=load('runs.json'); selected=[]\nfor name in sorted(req):\n matches=[c for c in checks if c['name']==name and c['head_sha']==sha and (name not in apps or c['app_id'] in apps[name])]\n assert matches,('missing',name)\n c=dict(max(matches,key=lambda x:x['id']))\n assert c['status']=='completed' and c['conclusion']=='success',(name,c)\n assert c['details_url'] and c['id']\n m=re.search(r'/actions/runs/(\\d+)',c['details_url'])\n c['workflow_run_id_from_url']=int(m.group(1)) if m else None\n if m: assert any(r['id']==int(m.group(1)) and r['head_sha']==sha and r['head_branch']=='main' and r['status']=='completed' and r['conclusion']=='success' for r in runs),name\n selected.append(c)\nassert not [c for c in checks if c['conclusion'] in {'failure','cancelled','timed_out','action_required'}]\nassert any(c['name']=='test-cgo (macos-latest)' and c['id']==116742130239 for c in selected)\nreceipt={'repository':s['nameWithOwner'],'default_branch':'main','actual_merge_sha':sha,'merged_at':s['setup']['mergedAt'],'observed_default_head':s['defaultBranchRef']['target']['oid'],'observed_at':(p/'observed-at.txt').read_text().strip(),'required_check_selection':'required_names','inventory_sources':{'classic':'success-observation/classic-required.json','rules':'success-observation/rules.json','both_successfully_fetched':True},'required_names':sorted(req),'required_check_count':len(req),'checks':selected,'workflow_runs':runs,'parent_verified_success':True,'post_merge_watch_id':'entireio/entire-brain#356','controlled_rerun':'one job-only debug repeat; new MacCGO check116742130239 passed on identical872; workflow attempt2 confirmed','root_cause_status':'Underlying Git fixture HEAD/ref/object condition remains unexplained; passing rerun is not a code fix','original_failure_evidence':'failure-receipt.json; owner-diagnosis.md; checks-observed.json'}\n(p.parent/'success-receipt.json').write_text(json.dumps(receipt,indent=2)+'\\n')\nprint(json.dumps({k:receipt[k] for k in ['actual_merge_sha','observed_default_head','observed_at','required_check_count','parent_verified_success','root_cause_status']},indent=2))\nPY","timeout":30}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":4757,"output":1724,"cacheRead":497920,"cacheWrite":0,"reasoning":665,"totalTokens":504401,"cost":{"input":0.019028,"output":0.02586,"cacheRead":0.099584,"cacheWrite":0,"total":0.144472}},"stopReason":"toolUse","timestamp":1792110194845,"responseId":"resp_0b16ddefcb78f265016ad16e74588481919522a7e54ca0e6e7","rawStopReason":"completed","durationMs":35537,"thinkingLevel":"medium"}}
