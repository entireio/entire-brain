7/verify-azure-static.mjs","content":"import fs from 'node:fs';\nimport crypto from 'node:crypto';\nimport {execFileSync} from 'node:child_process';\nconst out = '/Users/alex/.local/state/herdr/orchestrations/security-followups-20261017';\nconst lock = JSON.parse(fs.readFileSync('/private/tmp/cor2145static/actions-setup-go-b7ad1da/package-lock.json', 'utf8'));\nfor (const name of ['@azure/core-client', '@azure/storage-blob']) {\n  const entry = lock.packages['node_modules/' + name];\n  const version = entry.version;\n  const response = await fetch('https://registry.npmjs.org/' + name + '/' + version);\n  if (!response.ok) throw Error('metadata HTTP ' + response.status);\n  const meta = await response.json();\n  const url = new URL(meta.dist.tarball);\n  if (url.protocol !== 'https:' || url.hostname !== 'registry.npmjs.org') throw Error('Unexpected static data origin');\n  const archive = await fetch(url);\n  if (!archive.ok) throw Error('archive HTTP ' + archive.status);\n  const data = Buffer.from(await archive.arrayBuffer());\n  const integrity = 'sha512-' + crypto.createHash('sha512').update(data).digest('base64');\n  if (integrity !== entry.integrity) throw Error('Archive does not match action lock: ' + name);\n  const filename = out + '/' + name.split('/')[1] + '.tgz';\n  fs.writeFileSync(filename, data, {mode:0o600});\n  fs.writeFileSync(filename + '.files.txt', execFileSync('tar',['-tzf',filename]), {mode:0o600});\n  console.log(JSON.stringify({name,version,integrity_matches:true,filename}));\n}\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":2703,"output":2142,"cacheRead":115200,"cacheWrite":0,"reasoning":1617,"totalTokens":120045,"cost":{"input":0.005405999999999999,"output":0.02142,"cacheRead":0.01152,"cacheWrite":0,"total":0.038346000000000005}},"stopReason":"toolUse","timestamp":1792212563416,"responseId":"resp_0b16ddefcb78f265016ad2fe5413388191a7dd21f4e3e1d8e2","rawStopReason":"completed","durationMs