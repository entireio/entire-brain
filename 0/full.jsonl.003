43a30930a726ca5c5818741caec/check-runs?per_page=100' | jq '[.[].check_runs[]|select(.name!=\"Partial Gates\" and .name!=\"Entire Gates\" and .name!=\"Cursor Bugbot\")|{id,name,head_sha,status,conclusion,details_url,app_id:.app.id}]' > \"$D/checks.json\"\ngh api --paginate --slurp 'repos/entireio/entire-brain/actions/runs?head_sha=358e74a0384e543a30930a726ca5c5818741caec&branch=main&per_page=100' | jq '[.[].workflow_runs[]|{id,name,run_attempt,event,head_sha,head_branch,status,conclusion,html_url}]' > \"$D/runs.json\"\ngh api repos/entireio/entire-brain/branches/main/protection/required_status_checks > \"$D/classic-required.json\"\ngh api repos/entireio/entire-brain/rules/branches/main > \"$D/rules.json\"\ndate -u +%Y-%m-%dT%H:%M:%SZ > \"$D/observed-at.txt\"\n/usr/bin/python3 /Users/alex/.local/state/herdr/orchestrations/dependency-followups-20261015/python314-incident/assert-runtime.py\n/usr/bin/python3 -B - <<'PY'\nimport json,pathlib,re\np=pathlib.Path('/Users/alex/.local/state/herdr/orchestrations/dependency-followups-20261015/postmerge-354')\ndef load(n): return json.loads((p/n).read_text())\nsha='358e74a0384e543a30930a726ca5c5818741caec';s=load('github-state.json')['data']['repository'];c=load('classic-required.json');rs=load('rules.json')\nassert s['nameWithOwner']=='entireio/entire-brain' and s['defaultBranchRef']['name']=='main'\nassert s['change']['state']=='MERGED' and s['change']['mergeCommit']['oid']==sha\nassert isinstance(rs,list) and 'contexts' in c\nexcluded={'Partial Gates','Entire Gates','Cursor Bugbot'};req={x for x in c['contexts'] if x not in excluded};apps={}\nfor x in c.get('checks',[]):\n if x['context'] not in excluded:\n  req.add(x['context'])\n  if x.get('app_id') is not None: apps.setdefault(x['context'],set()).add(x['app_id'])\nfor r in rs:\n if r['type']=='required_status_checks':\n  for x in r['parameters'].get('required_status_checks',[]):\n   if x['context'] not in excluded:\n    req.add(x['context'])\n    if x.get('integration_id') is not None: apps.setdefault(x['context'],set()).add(x['integration_id'])\nassert req;checks=load('checks.json');runs=load('runs.json');selected=[]\nfor name in sorted(req):\n xs=[x for x in checks if x['name']==name and x['head_sha']==sha and (name not in apps or x['app_id'] in apps[name])];assert xs,name\n x=dict(max(xs,key=lambda z:z['id']));assert x['status']=='completed' and x['conclusion']=='success',x;assert x['id'] and x['details_url']\n m=re.search(r'/actions/runs/(\\d+)',x['details_url']);x['workflow_run_id_from_url']=int(m.group(1)) if m else None\n if m: assert any(r['id']==int(m.group(1)) and r['head_sha']==sha and r['head_branch']=='main' and r['status']=='completed' and r['conclusion']=='success' for r in runs),name\n selected.append(x)\nassert not [x for x in checks if x['conclusion'] in {'failure','cancelled','timed_out','action_required'}]\nv={'repository':s['nameWithOwner'],'default_branch':'main','actual_merge_sha':sha,'merged_at':s['change']['mergedAt'],'observed_default_head':s['defaultBranchRef']['target']['oid'],'observed_at':(p/'observed-at.txt').read_text().strip(),'required_check_selection':'required_names','inventory_sources':['classic-required.json','rules.json'],'required_names':sorted(req),'required_check_count':len(req),'checks':selected,'workflow_runs':runs,'parent_verified_success':True,'post_merge_watch_id':'entireio/entire-brain#354','owned_workspace_cleanup':'none created for this normal server-update candidate; parent orchestration workspace intentionally retained','scope':'Build verification only; package release/provenance/usage assessment remained bounded/incomplete, not security certification'}\n(p/'success-receipt.json').write_text(json.dumps(v,indent=2)+'\\n');print(json.dumps({k:v[k] for k in ['actual_merge_sha','observed_default_head','observed_at','required_check_count','parent_verified_success']},indent=2))\nPY","timeout":60}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"inp