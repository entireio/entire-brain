:"unsupported","forkContext":false,"extensionBindings":false}},"tools":{"ambient":true,"names":[],"mcpDirectTools":[]},"model":{"value":"openai-codex/gpt-6-luna","thinking":"medium"},"execution":{"defaultAsync":true},"acceptance":{"role":"writer"}},{"name":"delegate","description":"Lightweight subagent that inherits the parent model with no default reads","source":"builtin","executable":true,"runner":{"type":"pi"},"tools":{"ambient":false,"names":["read","grep","find","ls","bash","edit","write","contact_supervisor"],"mcpDirectTools":[]},"model":{"value":"openai-codex/gpt-6-luna","thinking":"medium"},"extensions":{"skills":["entire-graph"]}},{"name":"evidence-auditor","description":"Independent evidence reviewer for checking whether important research claims are supported by their sources","source":"builtin","executable":true,"runner":{"type":"pi"},"tools":{"ambient":false,"names":["read","web_search","fetch_content","get_search_content","source_check"],"mcpDirectTools":[]},"model":{"value":"openai-codex/gpt-6-luna","thinking":"high"}},{"name":"oracle","description":"High-context decision-consistency oracle that protects inherited state and prevents drift","source":"builtin","executable":true,"aliases":["advisor"],"runner":{"type":"pi"},"tools":{"ambient":false,"names":["read","grep","find","ls","bash"],"mcpDirectTools":[]},"model":{"value":"openai-codex/gpt-6.1-sol","thinking":"high"}},{"name":"review-steward","description":"Owns one bounded review-feedback wave for exactly one open PR—fetching GitHub review threads, Trail findings, CI failures, and Trail monitor receipts; triaging, batch-fixing, verifying, pushing, resolving, and reporting direct-fetch counts. Use one steward per PR and keep it the single writer in that PR's checkout.","source":"user","executable":true,"runner":{"type":"pi"},"tools":{"ambient":false,"names":["read","write","edit","bash","grep","find","ls"],"mcpDirectTools":[]},"model":{"value":"openai-codex/gpt-6.1-sol","thinking":"high"},"executio