TMGTiURnqmt_M8MmGIsetCuglZimypvNRNfEYIizffGSFYifiBFu7U2TXhNKbrw4B8q2wMQ2l3uoKeQWWMmbNghduws8192XMYbB7nXgTQI5_hiql0KAmI5nMXTRzrQYUgbsj0csx\"}"},{"type":"toolCall","id":"call_020ba1ee4ec0456f853c8449932558ae|fc_0b16ddefcb78f265016ad5409e5eb48191b7038463342b7b71","name":"read","arguments":{"path":"/Users/alex/.pi/agent/extensions/herdr-agent-monitor/index.ts","offset":1,"limit":280}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":1275,"output":57,"cacheRead":278784,"cacheWrite":0,"reasoning":16,"totalTokens":280116,"cost":{"input":0.0050999999999999995,"output":0.0008550000000000001,"cacheRead":0.0557568,"cacheWrite":0,"total":0.061711800000000004}},"stopReason":"toolUse","timestamp":1792360602913,"responseId":"resp_0b16ddefcb78f265016ad5409b8e548191ab46ee2b77031101","rawStopReason":"completed","durationMs":3643,"thinkingLevel":"medium"}}
{"type":"message","id":"eb7faef9","parentId":"6bf6994c","timestamp":"2026-10-18T21:56:46.621Z","message":{"role":"toolResult","toolCallId":"call_020ba1ee4ec0456f853c8449932558ae|fc_0b16ddefcb78f265016ad5409e5eb48191b7038463342b7b71","toolName":"read","content":[{"type":"text","text":"import { spawn as nodeSpawn } from \"node:child_process\";\nimport { StringEnum } from \"@earendil-works/pi-ai\";\nimport type { ExtensionAPI } from \"@earendil-works/pi-coding-agent\";\nimport { Type } from \"typebox\";\nimport { inspectWatchGate, validateOrchestrationLedger, type LedgerOwner } from \"./ledger.ts\";\nimport { createHerdrAgentMonitorRuntime, type HerdrAgentMonitorRuntime, type HerdrAgentMonitorState, type HerdrAgentWaitStatus, type SpawnedChild } from \"./runtime.ts\";\nimport { localWorktreeCreateCount, parseWorktreeCreationReceipt } from \"../session-trail-footer/ownership-receipts.ts\";\n\ninterface ExtensionOptions {\n  runtime?: HerdrAgentMonitorRuntime;\n  owner?: LedgerOwner;\n}\n\ntype PendingCreation = { workspaceId: string; paneId: string } | { error: string };\n\nexport default function herdrAgentMonitor(pi: ExtensionAPI, options: ExtensionOptions = {}): void {\n  const owner = options.owner ?? {\n    workspaceId: process.env.HERDR_WORKSPACE_ID ?? \"\",\n    paneId: process.env.HERDR_PANE_ID ?? \"\",\n  };\n  const runtime = options.runtime ?? createHerdrAgentMonitorRuntime({\n    spawn: (command, args, spawnOptions) => nodeSpawn(command, args, spawnOptions) as unknown as SpawnedChild,\n    exec: (command, args) => pi.exec(command, args).then(({ stdout, stderr, code }) => ({ stdout, stderr, code })),\n    send: (message, sendOptions) => pi.sendMessage(message, sendOptions),\n  });\n  let ledgerPath: string | undefined;\n  let pending: PendingCreation | undefined;\n\n  pi.on(\"tool_call\", async (event) => {\n    if (ledgerPath === undefined || event.toolName !== \"bash\") return;\n    const command = commandInput(event.input);\n    const creations = localWorktreeCreateCount(command);\n    if (creations === 0) return;\n    if (creations !== 1) return { block: true, reason: \"Explicit orchestration permits one herdr worktree create per Bash call so its watch receipt can be verified.\" };\n    const failure = await pendingFailure(ledgerPath, owner, pending, runtime);\n    return failure === undefined ? undefined : { block: true, reason: failure };\n  });\n\n  pi.on(\"tool_result\", (event) => {\n    if (ledgerPath === undefined || event.toolName !== \"bash\" || localWorktreeCreateCount(commandInput(event.input)) !== 1) return;\n    const structured = event.structuredContent as { exit_code?: number; truncated?: boolean } | undefined;\n    const details = event.details as { truncation?: { truncated?: boolean } } | undefined;\n    if (event.isError || (structured?.exit_code !== undefined && structured.exit_code !== 0)) return;\n    if (structured?.truncated === true || details?.truncation?.truncated === true) {\n      pending = { error: \"The successful Herdr worktree creation receipt was truncated; record and verify the created workspace before further dispatch.\" };\n      return;\n    }\n    const output = event.content.filter((item) => item.type === \"text\").map((item) => item.text).join(\"\\n\");\n    pending = parseWorktreeCreationReceipt(output)\n      ?? { error: \"The successful Herdr worktree creation receipt was ambiguous; record and verify the created workspace before further dispatch.\" };\n  });\n\n  pi.on(\"session_shutdown\", () => {\n    runtime.shutdown();\n    ledgerPath = undefined;\n    pending = undefined;\n  });\n\n  pi.registerTool({\n    name: \"herdr_agent_monitor\",\n    label: \"Herdr Agent Monitor\",\n    description: \"Run one parent-owned event-driven Herdr agent wait, retain its receipt/result, and guard explicitly registered orchestration against unwatched next launches.\",\n    executionMode: \"sequential\",\n    parameters: Type.Object({\n      action: StringEnum([\"begin\", \"add\", \"list\", \"status\", \"ack\", \"stop\", \"end\"] as const),\n      ledger: Type.Optional(Type.String()),\n      agent: Type.Optional(Type.String()),\n      timeoutMs: Type.Optional(Type.Integer({ minimum: 1_000, maximum: 86_400_000 })),\n      until: Type.Optional(Type.Array(StringEnum([\"idle\", \"working\", \"blocked\", \"done\"] as const), { minItems: 1, uniqueItems: true })),\n      id: Type.Optional(Type.String()),\n      classification: Type.Optional(StringEnum([\"complete\"] as const)),\n    }),\n    async execute(_toolCallId, params) {\n      try {\n        if (params.action === \"begin\") {\n          if (ledgerPath !== undefined) throw new Error(`orchestration guard is already active for ${ledgerPath}`);\n          if (!params.ledger) throw new Error(\"begin requires ledger\");\n          requireOwner(owner);\n          const ledger = await validateOrchestrationLedger(params.ledger, owner);\n          ledgerPath = ledger.path;\n          pending = undefined;\n          return result(`orchestration watch guard active for ${ledger.path}`);\n        }\n        if (params.action === \"add\") {\n          if (!params.agent || params.timeoutMs === undefined) throw new Error(\"add requires agent and timeoutMs\");\n          return result(formatState(await runtime.add({ agent: params.agent, timeoutMs: params.timeoutMs, until: params.until as HerdrAgentWaitStatus[] | undefined })));\n        }\n        if (params.action === \"list\") {\n          const states = runtime.list();\n          return result(states.length === 0 ? \"no Herdr agent monitors\" : states.map(formatState).join(\"\\n\"));\n        }\n        if (params.action === \"status\") {\n          if (!params.id) throw new Error(\"status requires id\");\n          const state = runtime.status(params.id);\n          if (!state) throw new Error(`monitor not found: ${params.id}`);\n          return result(formatState(state, true));\n        }\n        if (params.action === \"ack\") {\n          if (!params.id || params.classification !== \"complete\") throw new Error(\"ack requires id and classification=complete\");\n          return result(formatState(await runtime.ack(params.id, { classification: params.classification })));\n        }\n        if (params.action === \"stop\") {\n          if (!params.id) throw new Error(\"stop requires id\");\n          return result(runtime.stop(params.id) ? `monitor stopped: ${params.id}` : `monitor not found: ${params.id}`);\n        }\n        if (params.action === \"end\") {\n          if (ledgerPath === undefined) return result(\"orchestration watch guard is not active\");\n          const failure = await pendingFailure(ledgerPath, owner, pending, runtime);\n          if (failure !== undefined) throw new Error(failure);\n          const ended = ledgerPath;\n          ledgerPath = undefined;\n          pending = undefined;\n          return result(`orchestration watch guard ended for ${ended}`);\n        }\n        throw new Error(\"invalid action\");\n      } catch (error) {\n        return { ...result(errorMessage(error)), isError: true };\n      }\n    },\n  });\n}\n\nasync function pendingFailure(path: string, owner: LedgerOwner, pending: PendingCreation | undefined, runtime: HerdrAgentMonitorRuntime): Promise<string | undefined> {\n  if (pending === undefined) return undefined;\n  if (\"error\" in pending) return pending.error;\n  const gate = await inspectWatchGate(path, owner, pending, (id) => runtime.status(id));\n  return gate.ok ? undefined : `Dispatch blocked: ${gate.reason}. Record the monitor receipt before another launch.`;\n}\n\nfunction formatState(state: HerdrAgentMonitorState, verbose = false): string {\n  const summary = `${state.id} agent=${state.agent} phase=${state.phase} armed_at=${state.armedAt} timeout_ms=${state.timeoutMs} until=${state.until.join(\"|\")} classification=${state.inspection?.classification ?? \"uninspected\"}`;\n  if (!verbose) return summary;\n  return `${summary} completed_at=${state.completedAt ?? \"none\"} exit=${state.exitCode ?? \"none\"} signal=${state.signal ?? \"none\"} error=${state.error ?? \"none\"}\\nstdout:\\n${state.stdout || \"<empty>\"}\\nstderr:\\n${state.stderr || \"<empty>\"}`;\n}\n\nfunction requireOwner(owner: LedgerOwner): void {\n  if (!/^[A-Za-z0-9_-]+$/.test(owner.workspaceId) || !owner.paneId.startsWith(`${owner.workspaceId}:`)) {\n    throw new Error(\"begin requires a valid current Herdr workspace and pane\");\n  }\n}\n\nfunction commandInput(input: unknown): string {\n  return typeof input === \"object\" && input !== null && typeof (input as { command?: unknown }).command === \"string\"\n    ? (input as { command: string }).command\n    : \"\";\n}\n\nfunction result(text: string) {\n  return { content: [{ type: \"text\" as const, text }], details: undefined };\n}\n\nfunction errorMessage(error: unknown): string {\n  return error instanceof Error ? error.message : String(error);\n}\n"}],"isError":false,"durationMs":62,"timestamp":1792360606621}}
