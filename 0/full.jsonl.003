ventory-fetch.json')\nassert fetch=={'classic_exit':0,'rules_exit':0},fetch\nassert s['nameWithOwner']=='entireio/entire-brain'\nassert s['defaultBranchRef']['name']=='main'\nassert s['billy']['state']=='MERGED' and s['billy']['mergeCommit']['oid']==sha\nclassic=load('classic-required.json'); rules=load('rules.json')\nexcluded={'Partial Gates','Entire Gates','Cursor Bugbot'}\nrequirements={n for n in classic.get('contexts',[]) if n not in excluded}\nexpected_apps={}\nfor c in classic.get('checks',[]):\n if c['context'] not in excluded:\n  requirements.add(c['context'])\n  if c.get('app_id') is not None: expected_apps.setdefault(c['context'],set()).add(c['app_id'])\nfor rule in rules:\n if rule['type']=='required_status_checks':\n  for c in rule['parameters'].get('required_status_checks',[]):\n   if c['context'] not in excluded:\n    requirements.add(c['context'])\n    if c.get('integration_id') is not None: expected_apps.setdefault(c['context'],set()).add(c['integration_id'])\nassert requirements,'No complete nonempty inventory'\nchecks=load('checks.json'); runs=load('runs.json'); selected=[]\nfor name in sorted(requirements):\n matches=[c for c in checks if c['name']==name and c['head_sha']==sha and (name not in expected_apps or c['app_id'] in expected_apps[name])]\n assert matches,('missing required',name)\n c=max(matches,key=lambda c:c['id'])\n assert c['status']=='completed' and c['conclusion']=='success',(name,c)\n assert c['id'] and c['details_url']\n c=dict(c)\n m=re.search(r'/actions/runs/(\\d+)',c['details_url'])\n c['workflow_run_id_from_url']=int(m.group(1)) if m else None\n if m:\n  assert any(r['id']==int(m.group(1)) and r['head_sha']==sha and r['head_branch']=='main' and r['status']=='completed' and r['conclusion']=='success' for r in runs),('run mismatch',name)\n selected.append(c)\nbad=[c['name'] for c in checks if c['conclusion'] in {'failure','cancelled','timed_out','action_required'}]\nassert not bad,('other ordinary failures',bad)\nreceipt={'repository':s['nameWithOwner'],'default_branch':'main','actual_merge_sha':sha,'merged_at':s['billy']['mergedAt'],'observed_default_head':s['defaultBranchRef']['target']['oid'],'observed_at':(p/'observed-at.txt').read_text().strip(),'required_check_selection':'required_names','inventory_sources':{'classic':'classic-required.json','rules':'rules.json','both_fetch_exit_zero':True},'required_names':sorted(requirements),'required_check_count':len(requirements),'checks':selected,'workflow_runs':runs,'other_ordinary_failures':bad,'parent_verified_success':True,'post_merge_watch_id':'entireio/entire-brain#361','watch_terminal_receipt':'native post_merge_success notification; tool status subsequently not found is not used as success proof'}\n(p/'success-receipt.json').write_text(json.dumps(receipt,indent=2)+'\\n')\nprint(json.dumps({k:receipt[k] for k in ['repository','default_branch','actual_merge_sha','observed_default_head','observed_at','required_check_count','parent_verified_success']},indent=2))\nPY","timeout":30}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-6.1-sol","usage":{"input":1765,"output":3992,"cacheRead":365440,"cacheWrite":0,"reasoning":3025,"totalTokens":371197,"cost":{"input":0.0070599999999999994,"output":0.05988,"cacheRead":0.073088,"cacheWrite":0,"total":0.14002799999999999}},"stopReason":"toolUse","timestamp":1792105348984,"responseId":"resp_0b16ddefcb78f265016ad15b865ba481918b217c0cce9813c2","rawStopReason":"completed","durationMs":94433,"thinkingLevel":"medium"}}
