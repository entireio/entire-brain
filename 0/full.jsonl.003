rse(fs.readFileSync(root+'/'+n,'utf8'));\nconst classic=load('current-required-classic.json');\nconst rules=load('current-required-rules.json');\nconst observed=load('current-head-checks.json');\nconst head='0a7266858c6b08e6384d94111395f26baf5dce6b';\nconst requirements=[...(classic.contexts??[]).map(name=>({name,app:null})),...(classic.checks??[]).map(x=>({name:x.context,app:x.app_id})),...rules.filter(x=>x.type==='required_status_checks').flatMap(x=>(x.parameters?.required_status_checks??[]).map(v=>({name:v.context,app:v.integration_id})))].filter(x=>x.name!=='Partial Gates');\nif(!requirements.length||observed.total_count>100) throw Error('Incomplete/nonempty inventory or check pagination');\nfor(const r of requirements){if(!observed.check_runs.some(c=>c.name===r.name&&c.head_sha===head&&c.status==='completed'&&c.conclusion==='success'&&(!(r.app>0)||c.app_id===r.app)))throw Error('Required success/app missing: '+r.name);}\nconst names=[...new Set(requirements.map(x=>x.name))].sort();\nconst checks=observed.check_runs.filter(x=>names.includes(x.name));\nconst bot=observed.check_runs.find(x=>x.name==='Cursor Bugbot'&&x.head_sha===head&&x.status==='completed'&&x.conclusion==='success');\nif(!bot)throw Error('Current Bugbot success missing');\nconst receipt={repository:'entireio/entire-brain',trail:'https://entire.io/gh/entireio/entire-brain/trails/317',trail_state:'open',head_sha:head,disposition:'automated work complete; human approval handoff, NOT merged/Done',compiled_at:new Date().toISOString(),required_count:names.length,required_names:names,required_inventory_sources:['current-required-classic.json','current-required-rules.json'],required_app_constraints:requirements,required_checks:checks,bugbot:bot,github_mergeable:'MERGEABLE',unresolved_threads:0,open_trail_findings:0,main_review:{runner_id:'trail-review',state:'evaluated',outcome:'passed',evaluated_at_sha:head,source:'Owner final authenticated same-head aggregate, corroborated by native review-monitor curr