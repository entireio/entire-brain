: \"not distilled; the brain is queryable now, start later: \" + resume, Why: ConsentReasonDeclined, Prompted: prompted}\n158\t}\n159\t\n160\t// writePrompt paints the block the operator is answering. It uses the same\n161\t// gutter as every phase line, with the glyph column left blank: a question is\n162\t// not an outcome and must not wear an outcome's tick.\n163\tfunc writePrompt(out io.Writer, r *Renderer, req ConsentRequest) {\n164\t\tif out == nil {\n165\t\t\treturn\n166\t\t}\n167\t\tbullet := \" \" + r.Bullet() + \" \"\n168\t\tagent := \"Agent: \" + req.Agent\n169\t\tif req.Model != \"\" {\n170\t\t\tagent += bullet + \"model: \" + req.Model\n171\t\t}\n172\t\tif req.Effort != \"\" {\n173\t\t\tagent += bullet + \"effort: \" + req.Effort\n174\t\t}\n175\t\tlines := []Line{\n176\t\t\t{Title: PhaseFacts.Title(), Text: plural(req.Sessions, \"session\") + \" can be distilled into durable facts.\", Accent: PhaseFacts.Accent()},\n177\t\t\t{Text: agent, Accent: PhaseFacts.Accent()},\n178\t\t\t{Text: \"Estimated: ~\" + plural(req.Sessions, \"agent call\") + \", newest first, resumable.\", Accent: PhaseFacts.Accent()},\n179\t\t\t{Blank: true},\n180\t\t}\n181\t\tfor _, line := range lines {\n182\t\t\tfmt.Fprintln(out, r.Line(line))\n183\t\t}\n184\t}\n185\t\n186\t// question is the prompt itself. \"[y/N]\" is not decoration: the capital is the\n187\t// default, and it is the default.\n188\tconst question = \"Distill now? [y/N]\"\n189\t\n190\t// askTwice reads an answer, re-asking ONCE on something unrecognisable and\n191\t// defaulting to No after that. Two chances is the whole budget: a loop here is\n192\t// a different way of blocking a pipeline.\n193\tfunc askTwice(in io.Reader, out io.Writer, r *Renderer) (bool, bool) {\n194\t\tif in == nil {\n195\t\t\treturn false, false\n196\t\t}\n197\t\treader := bufio.NewReader(in)\n198\t\tfor attempt := 0; attempt < 2; attempt++ {\n199\t\t\t// Printed with a trailing space Line would have trimmed: the cursor has to\n200\t\t\t// sit clear of the \"]\" or the answer reads as part of the question.\n201\t\t\tfmt.Fprint(out, r.Line(Line{Text: question, Accent: PhaseFacts.Accent()})+\" \")\n202\t\t\tline, err := reader.ReadString('\\n')\n203\t\t\tanswer := strings.ToLower(strings.TrimSpace(line))\n204\t\t\tif err != nil && answer == \"\" {\n205\t\t\t\t// EOF, a closed stdin, an interrupt that shut the pipe: No, with a\n206\t\t\t\t// newline so the next line does not land beside the prompt.\n207\t\t\t\tfmt.Fprintln(out)\n208\t\t\t\treturn false, true\n209\t\t\t}\n210\t\t\tswitch answer {\n211\t\t\tcase \"y\", \"yes\":\n212\t\t\t\treturn true, true\n213\t\t\tcase \"\", \"n\", \"no\":\n214\t\t\t\treturn false, true\n215\t\t\t}\n216\t\t\tif attempt == 0 {\n217\t\t\t\tfmt.Fprintln(out, r.Line(Line{Text: \"Please answer y or n.\", Accent: PhaseFacts.Accent()}))\n218\t\t\t}\n219\t\t\tif err != nil {\n220\t\t\t\tfmt.Fprintln(out)\n221\t\t\t\treturn false, true\n222\t\t\t}\n223\t\t}\n224\t\treturn false, true\n225\t}\n226\t\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/brain-rebase","sessionId":"93ae8948-c612-4072-8e70-2750e80df9ce","version":"2.1.301","gitBranch":"main","slug":"floofy-discovering-bachman"}
