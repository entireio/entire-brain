ose %q should yield no locus, got %v\", text, got)","+\t\t}","+\t}","+}","+","+// TestLocusTokenIsFilePathSeesHyphenatedPaths closes the loop on drift: the","+// fragments were invisible to factLocusDrift (\"website/scripts/pre\" has no","+// extension, \"build.ts\" has no slash), so a hyphenated file could never be","+// reported as drifted no matter how long ago it was deleted.","+func TestLocusTokenIsFilePathSeesHyphenatedPaths(t *testing.T) {","+\tif !locusTokenIsFilePath(\"website/scripts/pre-build.ts\") {","+\t\tt.Error(\"a hyphenated path with a real extension must count as a file path\")","+\t}","+\tif locusTokenIsFilePath(\"website/scripts/pre\") {","+\t\tt.Error(\"an extensionless fragment must not count as a file path\")","+\t}","+}"]}]}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/brain-locus-anchors/internal/cli/facts_locus_test.go"]}},"serverClassifierContext":{"request":"8cc2fb3a-fec9-4e82-b84d-70998a7839b7","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-locus-anchors","root":"/Users/suhaan/devenv/brain-locus-anchors","branch":"fix/locus-hyphenated-paths","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},"push_remote":"origin","remotes":[{"name":"entireio","host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"name":"origin","host":"github.com","remote":"entireio/entire-brain","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entireio/entire-graph","visibility":"public"},{"host":"github.com","remote":"entireio/cli","visibility":"public"}]}},"live_cwd":"/Users/suhaan/devenv/brain-locus-anchors","platform":"macos"}},"sourceToolAssistantUUID"