r the repository has a\n// promisor remote. The answer is a local config read and cannot change during\n// an export.\nvar promisorRemoteAnswers sync.Map","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"7a9405a5-daf9-4be2-85fd-186222a50504","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-vanished","root":"/Users/suhaan/devenv/brain-vanished","branch":"fix/export-skips-vanished-checkpoints","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},"push_remote":"origin","remotes":[{"name":"entireio","host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"name":"origin","host":"github.com","remote":"entireio/entire-brain","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entireio/entire-graph","visibility":"public"},{"host":"github.com","remote":"entirehq/entiredb","visibility":"private"},{"host":"github.com","remote":"entireio/cli","visibility":"public"},{"host":"github.com","remote":"entirehq/entire.io","visibility":"private"}]}},"live_cwd":"/Users/suhaan/devenv/brain-vanished","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"3adca842-c1b3-4dc1-8c66-6e7e9e081f04","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"80327498-7bd2-42a4-985a-9acba8ccaf85","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/brain-vanished","sessionId":"93ae8948-c612-4072-8e70-2750e80df9ce","version":"2.1.310","gitBranch":"main","slug":"floofy-discovering-bachman"}
