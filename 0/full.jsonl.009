 )'''.split(\"\\n\")\nlines[i+2:i+2]=block\nopen(p,\"w\").write(\"\\n\".join(lines))\nprint(\"v2 projection updated\")\nPY\npython3 -B -m pytest benchmarks/agent-brain/test_packet_format_v2_ab.py benchmarks/agent-brain/test_packet_format_ab.py -q 2>&1 | grep -E \"^(FAILED|SUBFAILED)|passed|failed\" | tail -5","description":"Add staleness to the v2 projection and run both suites"},"caller":{"type":"direct"}}]}}
