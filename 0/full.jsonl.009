t, new_struct)\n\nold_write = \"\"\"func (w *watchLogPrefixWriter) Write(p []byte) (int, error) {\n\tif len(p) == 0 {\n\t\treturn 0, nil\n\t}\n\tstamp := w.prefix()\"\"\"\nnew_write = \"\"\"func (w *watchLogPrefixWriter) Write(p []byte) (int, error) {\n\tif len(p) == 0 {\n\t\treturn 0, nil\n\t}\n\t// Held across the sink write as well as the state update: releasing before\n\t// w.out.Write would keep midLine consistent while still letting two\n\t// writers' bytes interleave inside one line.\n\tw.mu.Lock()\n\tdefer w.mu.Unlock()\n\tstamp := w.prefix()\"\"\"\nassert s.count(old_write)==1\ns = s.replace(old_write, new_write)\n\nassert '\"sync\"' not in s\ns = s.replace('\\t\"strconv\"', '\\t\"strconv\"\\n\\t\"sync\"', 1)\nopen(p,\"w\").write(s)\nprint(\"patched\")\nPY\n\"$(go env GOROOT)/bin/gofmt\" -w internal/cli/watch_log_prefix.go && go build ./... 2>&1|head -5; echo \"build-exit=$?\"","description":"Add the mutex and document the contract"},"caller":{"type":"direct"}}]}}
