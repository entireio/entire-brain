{"type":"api-request-blob","sessionId":"93ae8948-c612-4072-8e70-2750e80df9ce","hash":"09694cc7ddb6dd52d1ca2670ba0ce3c5c06bd2a285dbdecd23ccc25399336982","message":{"role":"user","content":[{"tool_use_id":"toolu_01ATezG2JNvjnEmPTHVHSpnY","type":"tool_result","content":"296\t// reads an empty buffer and reports the symptom (EOF / broken pipe) instead of\n297\t// the cause, which is the one thing this whole check exists to do.\n298\tfunc TestMCPProbeWaitsForAServersLateReason(t *testing.T) {\n299\t\tt.Parallel()\n300\t\tserver := mcpFakeServer(t, \"exec 1>&-\\nsleep 0.4\\necho 'the brain store is locked by another process' >&2\\nexit 9\\n\")\n301\t\t_, err := probeMCPToolSurface(context.Background(), server, 10*time.Second)\n302\t\tif err == nil {\n303\t\t\tt.Fatal(\"a server that closed stdout and exited 9 must not probe clean\")\n304\t\t}\n305\t\tif !strings.Contains(err.Error(), \"the brain store is locked by another process\") {\n306\t\t\tt.Fatalf(\"the server's reason arrived after its stdout closed and was lost; got: %v\", err)\n307\t\t}\n308\t}\n309\t\n310\t// TestFakeServerDrainKeepsStdinOpen asserts the SHELL PROPERTY the fakes\n311\t// depend on, not the probe, because the probe end of it is a race that depends\n312\t// on machine load and cannot be made to fail on demand.\n313\t//\n314\t// POSIX gives a background job's stdin /dev/null before any explicit\n315\t// redirection. So `cat >/dev/null &` drains nothing, exits at once, and the\n316\t// following `wait` returns immediately -- the fake dies regardless of the\n317\t// drain, and the probe's write then hits EPIPE. `exec 3<&0` plus `cat <&3`\n318\t// gives the background reader an explicit redirection from the real stdin,\n319\t// which overrides that default.\n320\t//\n321\t// This is asserted against dash as well as /bin/sh, because the two disagree:"}]}}
