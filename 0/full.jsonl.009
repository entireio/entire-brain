\n\tif localOnly {\n\t\treturn runCheckpointGitLocal(ctx, runner, repoDir, args...)\n\t}\n\treturn runner.Run(ctx, repoDir, \"git\", args...)\n}\n\nfunc pathsUnderCheckpointRoot(paths map[string]struct{}, root string) map[string]struct{} {\n\tsubset := make(map[string]struct{})\n\tprefix := strings.Trim(root, \"/\") + \"/\"\n\tfor candidate := range paths {\n\t\tif strings.HasPrefix(candidate, prefix) {\n\t\t\tsubset[candidate] = struct{}{}\n\t\t}\n\t}\n\treturn subset\n}\n\nfunc oidsUnderCheckpointRoot(oids map[string]string, root string) map[string]string {\n\tsubset := make(map[string]string)\n\tprefix := strings.Trim(root, \"/\") + \"/\"\n\tfor candidate, oid := range oids {\n\t\tif strings.HasPrefix(candidate, prefix) {\n\t\t\tsubset[candidate] = oid\n\t\t}\n\t}\n\treturn subset\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"a2aa12ba-7720-4b65-8636-73383afaa5ae","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-vanished","root":"/Users/suhaan/devenv/brain-vanished","branch":"fix/export-skips-vanished-checkpoints","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},"push_remote":"origin","remotes":[{"name":"entireio","host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"name":"origin","host":"github.com","remote":"entireio/entire-brain","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entireio/entire-graph","visibility":"public"},{"host":"github.com","remote":"entirehq/entiredb","visibility":"private"},{"host":"github.com","remote":"entireio/cli","visibility":"public"},{"host":"github.com","re