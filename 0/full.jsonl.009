use an empty unreliable list is\n// the common case for an incomplete answer: the ancestor store has already\n// dropped the records for changed files, so nothing RETURNED is tainted while\n// records are still missing. A count omitted at zero would be indistinguishable\n// from a renderer that does not report it at all.\nfunc TestDefaultTextOutputPrintsExcludedRecordsEvenAtZero(t *testing.T) {\n\tt.Parallel()\n\treport := stalenessCompactReport()\n\treport.Semantic.Staleness.Unreliable = nil\n\treport.Semantic.Staleness.ExcludedRecords = 0\n\n\tcmd := &cobra.Command{}\n\tvar out bytes.Buffer\n\tcmd.SetOut(&out)\n\tcmd.SetErr(&out)\n\tif err := emitBrainBriefReport(cmd, report, false); err != nil {\n\t\tt.Fatalf(\"emit text report: %v\", err)\n\t}\n\tif !strings.Contains(out.String(), \"unreliable=0 excluded_records=0\") {\n\t\tt.Fatalf(\"an incomplete answer with nothing tainted must still say so:\\n%s\", out.String())\n\t}\n}\nGOTEST\nhead -20 internal/cli/graph_context_staleness_test.go | grep -n \"import\" -A10","description":"Add the default-output tests"}},"wireIngestContext":{"toolu_01HSVQKykSBQnkVjZztic3Yb":{"cwd":"/Users/suhaan/devenv/brain-b2-staleness"}},"serverClassifierRequest":"bb529f68-2c94-4d1e-93f2-2f8682a2947e","apiBlockIndex":0,"requestId":"req_011CgPGjsKG6989YJPvK7ZUy","requestRef":"cc98a1eb-6620-4e88-84a0-ab5b40237085","requestedModel":"claude-opus-5[1m]","type":"assistant","uuid":"085e3f7a-ebba-4e9d-8aec-cbab01545397","timestamp":"2026-10-25T16:29:34.366Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":null,"session_id":"80327498-7bd2-42a4-985a-9acba8ccaf85","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/brain-b2-staleness","sessionId":"93ae8948-c612-4072-8e70-2750e80df9ce","version":"2.1.310","gitBranch":"main","slug":"floofy-discovering-bachman"}
