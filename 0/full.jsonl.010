   32\t\tsettings := map[string]any{}\n    33\t\texisting, err := readBoundedRootFile(root, name, maxClaudeSettingsBytes)\n    34\t\tswitch {\n    35\t\tcase err == nil:\n    36\t\t\tif len(strings.TrimSpace(string(existing))) > 0 {\n    37\t\t\t\tif err := json.Unmarshal(existing, &settings); err != nil {\n    38\t\t\t\t\treturn path, false, fmt.Errorf(\"%s: %w\", path, err)\n    39\t\t\t\t}\n    40\t\t\t}\n    41\t\tcase errors.Is(err, os.ErrNotExist):\n    42\t\t\t// A repository with no Claude settings is the common first run.\n    43\t\tdefault:\n    44\t\t\treturn path, false, fmt.Errorf(\"%s: %w\", path, err)\n    45\t\t}\n    46\t\n    47\t\thooks, err := settingsObject(settings, \"hooks\")\n    48\t\tif err != nil {\n    49\t\t\treturn path, false, fmt.Errorf(\"%s: hooks: %w\", path, err)\n    50\t\t}\n    51\t\tentries, err := settingsArray(hooks, \"PreToolUse\")\n    52\t\tif err != nil {\n    53\t\t\treturn path, false, fmt.Errorf(\"%s: hooks.PreToolUse: %w\", path, err)\n    54\t\t}\n    55\t\tif preToolUseInvokesPreEdit(entries) {\n    56\t\t\treturn path, false, nil\n    57\t\t}\n    58\t\tentries = append(entries, map[string]any{\n    59\t\t\t\"matcher\": preEditHookMatcher,\n    60\t\t\t\"hooks\": []any{map[string]any{","is_error":false}]},"uuid":"90ef26e7-b253-4a58-a487-af6421ada5dd","timestamp":"2026-11-17T21:27:12.191Z","toolUseResult":{"stdout":"     1\t// the host documents. Refusing is the point: the alternative is overwriting a\n     2\t// structure we did not understand.\n     3\tvar errSettingsShape = errors.New(\"unexpected shape\")\n     4\t\n     5\t// installPreEditHook merges one PreToolUse entry into the repository's\n     6\t// .claude/settings.json, preserving every other key byte-for-value.\n     7\t//\n     8\t// The merge is a map round-trip, NOT an unmarshal into a typed struct: the\n     9\t// settings file is the reader's, it carries keys this binary has never heard\n    10\t// of (env, permissions, model, statusLine, other to