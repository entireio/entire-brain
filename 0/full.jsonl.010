ch_vercel_url","mcp__claude_ai_Vercel__write_session_files","mcp__claude_ai_Zapier__authenticate","mcp__claude_ai_Zapier__complete_authentication","mcp__claude_ai_composio__COMPOSIO_GET_TOOL_SCHEMAS","mcp__claude_ai_composio__COMPOSIO_MANAGE_CONNECTIONS","mcp__claude_ai_composio__COMPOSIO_MANAGE_SKILL","mcp__claude_ai_composio__COMPOSIO_MULTI_EXECUTE_TOOL","mcp__claude_ai_composio__COMPOSIO_PROXY_EXECUTE","mcp__claude_ai_composio__COMPOSIO_REMOTE_BASH_TOOL","mcp__claude_ai_composio__COMPOSIO_REMOTE_WORKBENCH","mcp__claude_ai_composio__COMPOSIO_SEARCH_SKILLS","mcp__claude_ai_composio__COMPOSIO_SEARCH_TOOLS","mcp__claude_ai_composio__COMPOSIO_SUBMIT_FEEDBACK","mcp__claude_ai_composio__COMPOSIO_USE_SKILL","mcp__claude_ai_composio__COMPOSIO_WAIT_FOR_CONNECTIONS","mcp__claude_ai_entire-prod-us__authenticate","mcp__claude_ai_entire-prod-us__complete_authentication","mcp__claude_ai_entire-staging-eu__authenticate","mcp__claude_ai_entire-staging-eu__complete_authentication","mcp__claude_ai_entire-staging-us__authenticate","mcp__claude_ai_entire-staging-us__complete_authentication","mcp__claude_ai_incident_io__authenticate","mcp__claude_ai_incident_io__complete_authentication","mcp__claude_ai_monday_com__authenticate","mcp__claude_ai_monday_com__complete_authentication","mcp__context7__query-docs","mcp__context7__resolve-library-id","mcp__onshape__authenticate","mcp__onshape__complete_authentication","mcp__plugin_vercel_vercel__authenticate","mcp__plugin_vercel_vercel__complete_authentication"],"removedNames":[],"wireHiddenNames":[],"readdedNames":[],"surfacedNames":["ShareOnboardingGuide","mcp__claude_ai_Claude_Docs__batch","mcp__claude_ai_Claude_Docs__guide","mcp__claude_ai_Claude_Docs__update"],"surfacedDefinitions":[{"name":"mcp__claude_ai_Claude_Docs__batch","listing":"b18caec4513bd82d","definition":{"name":"mcp__claude_ai_Claude_Docs__batch","description":"Create a doc, or apply several operations to one doc atomically.","input_schema":{"type":"object","properties":{"batch":{"type":"array"},"container":{"type":"object","properties":{"kind":{"type":"string"},"id":{"type":"string"},"create":{"type":"object"}},"required":["kind"]},"verbose":{"type":"boolean"},"opId":{"type":"string"}}},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Claude_Docs__guide","listing":"1f2c30a590811b06","definition":{"name":"mcp__claude_ai_Claude_Docs__guide","description":"Docs guides: topic.instructions repeats the server instructions. Read it only if your client dropped them. Also topic.<name>, refusal.<code>. After a doc's birth → [\"topic.index\"].","input_schema":{"type":"object","properties":{"items":{"type":"array","description":"topic.<name> (instructions, index, editing, tabs, comments, charts, chart-definition, diagram, uploads, sharing, skill) or refusal.<code>; several per call is fine."}}},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Claude_Docs__update","listing":"b1347b8d2c5727e2","definition":{"name":"mcp__claude_ai_Claude_Docs__update","description":"Edit a tab's contents, rename a doc or tab, or change a stored value.","input_schema":{"type":"object","properties":{"ref":{"type":"object","properties":{"object":{"type":"string","enum":["project","file","node","utterance","enum"]},"id":{"type":"string"}},"required":["object","id"]},"engine":{"type":"string"},"payload":{"anyOf":[{"type":"object"},{"type":"string"}]},"container":{"type":"object","properties":{"kind":{"type":"string"},"id":{"type":"string"},"version":{"type":"string"}},"required":["kind","id"]},"verbose":{"type":"boolean"},"opId":{"type":"string"},"answering":{"type":"string","maxLength":64}},"required":["ref","payload"]},"eager_input_streaming":true}},{"name":"ShareOnboardingGuide","listing":"55965e8926f2e35b","definition":{"name":"ShareOnboardingGuide","description":"Upload the ONBOARDING.md in the current directory and return a share link teammates can open in Claude Code. Call this after the user has confirmed the final content.\n\nWhen called with the default mode='check': if a local ONBOARDING.md is present, uploads it to the most-recently-updated org guide (or creates one if none exist) and returns a fresh link. If no local file is present, returns the existing link without uploading (status: has_existing).","input_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"mode":{"description":"'check' (default): if ONBOARDING.md is present locally, uploads it to the most-recent guide (creates one if none exist); otherwise reports the existing link without uploading. 'update': upload to a specific guide by short_code. 'create': always make a new link. 'delete': remove the guide named by short_code; with no short_code, nothing is deleted and the user's guides are listed.","default":"check","type":"string","enum":["check","update","create","delete"]},"short_code":{"description":"Short code of one guide, from an earlier call's result. Required by delete. With check or update, targets that guide instead of the most recently updated one.","type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"}},"required":["mode"],"additionalProperties":false},"eager_input_streaming":true}}],"textAfterToolBlocks":true},"type":"attachment","uuid":"858be4b9-e193-457a-a209-f5187b5b4a42","timestamp":"2026-11-18T00:52:03.044Z","rendered":[{"content":"<system-reminder>\nThe following tools just became available and are ready to use:\nShareOnboardingGuide\nmcp__claude_ai_Claude_Docs__batch\nmcp__claude_ai_Claude_Docs__guide\nmcp__claude_ai_Claude_Docs__update\n\nThe following deferred tools are now available via ToolSearch. Their schemas are NOT loaded — calling them directly will fail with InputValidationError. Use ToolSearch with query \"select:<name>[,<name>...]\" to load tool schemas before calling them:\nArtifactComments\nArtifactData\nCronCreate\nCronDelete\nCronList\nDesignSync\nEndConversation\nEnterPlanMode\nEnterWorktree\nExitPlanMode\nExitWorktree\nLSP\nListMcpResourcesTool\nMonitor\nNotebookEdit\n