ion instead of agreeing with the host or with the home fallback.","+func TestWindowsPluginDataRootDiscardsRelativeLocalAppData(t *testing.T) {","+\thome := t.TempDir()","+","+\tgot, err := windowsPluginDataRoot(filepath.Join(\"relative\", \"appdata\"), home)","+\tif err != nil {","+\t\tt.Fatalf(\"relative LOCALAPPDATA: %v\", err)","+\t}","+\tif want := filepath.Join(home, \"AppData\", \"Local\", XDGRootDir); got != want {","+\t\tt.Fatalf(\"relative LOCALAPPDATA: got %q, want %q\", got, want)","+\t}","+","+\tif _, err := windowsPluginDataRoot(\"\", \"\"); err == nil {","+\t\tt.Fatal(\"no LOCALAPPDATA and no home: want an error, got nil\")","+\t}","+}","+","+// The dispatched path must be unaffected on every OS: when the host sets","+// ENTIRE_PLUGIN_DATA_DIR, that value wins outright and neither XDG nor","+// LOCALAPPDATA is consulted.","+func TestResolvePluginDataRootPrefersTheHostSuppliedDir(t *testing.T) {","+\thostDir := t.TempDir()","+\tt.Setenv(EnvLocalAppData, t.TempDir())","+\tt.Setenv(XDGDataHome, t.TempDir())","+","+\tfor _, goos := range []string{windowsGOOS, \"linux\", \"darwin\"} {","+\t\tgot, err := resolvePluginDataRoot(hostDir, goos)","+\t\tif err != nil {","+\t\t\tt.Fatalf(\"goos %s: %v\", goos, err)","+\t\t}","+\t\tif got != hostDir {","+\t\t\tt.Fatalf(\"goos %s: got %q, want the host-supplied %q\", goos, got, hostDir)","+\t\t}","+\t}","+}","+","+// The divergence itself: with no host-supplied dir, Windows must follow","+// LOCALAPPDATA and ignore XDG_DATA_HOME, while every other OS keeps the XDG","+// rule untouched.","+func TestResolvePluginDataRootIgnoresXDGOnWindowsOnly(t *testing.T) {","+\tlocalAppData := t.TempDir()","+\txdgData := t.TempDir()","+\tt.Setenv(EnvLocalAppData, localAppData)","+\tt.Setenv(XDGDataHome, xdgData)","+","+\tgot, err := resolvePluginDataRoot(\"\", windowsGOOS)","+\tif err != nil {","+\t\tt.Fatalf(\"windows: %v\", err)","+\t}","+\tif want := filepath.Join(localAppData, XDGRootDir); got != want {","+\t\tt.Fatalf(\"windows: got %q, want %q (XDG_DATA_HOME must be ignored)\", got, want)","+\t}","+","+\tfor _, goos := range []string{\"linux\", \"darwin\"} {","+\t\tgot, err := resolvePluginDataRoot(\"\", goos)","+\t\tif err != nil {","+\t\t\tt.Fatalf(\"goos %s: %v\", goos, err)","+\t\t}","+\t\tif want := filepath.Join(xdgData, XDGRootDir); got != want {","+\t\t\tt.Fatalf(\"goos %s: got %q, want %q (XDG rule must be unchanged)\", goos, got, want)","+\t\t}","+\t}","+}"]}]}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/brain-windows/internal/cli/internal/base/env_test.go"]}},"serverClassifierContext":{"request":"d90b65c1-d146-4e8b-93f7-f8c0ae7a6b7f","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-windows","root":"/Users/suhaan/devenv/brain-windows","branch":"win/full-support","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":2,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},"push_remote":"origin","remotes":[{"name":"entireio","host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"name":"origin","host":"github.com","remote":"entireio/entire-brain","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-graph","visibility":"public"},{"host":"github.com","remote":"entireio/cli","visibility":"public"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"}]}},"live_cwd":"/Users/suhaan/devenv/brain-windows","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"8c2a294a-70ea-44a1-a84e-036c823bb1d0","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"338a84d2-8297-4418-9431-614af31d9617","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/brain-windows","sessionId":"93ae8948-c612-4072-8e70-2750e80df9ce",