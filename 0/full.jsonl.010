{"parentUuid":"7367f605-66e8-4a3a-bd02-bac48c4ee76e","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/suhaan/devenv/brain-windows/internal/cli/internal/base/env_test.go","snippet":"72\t\t}\n73\t\tif dirs.State != filepath.Join(xdg, \"state\", \"entire\") {\n74\t\t\tt.Fatalf(\"State = %q\", dirs.State)\n75\t\t}\n76\t\tif dirs.Cache != filepath.Join(xdg, \"cache\", \"entire\") {\n77\t\t\tt.Fatalf(\"Cache = %q\", dirs.Cache)\n78\t\t}\n79\t}\n80\t\n81\t// The brain and the host CLI must resolve the same plugin data root, or a\n82\t// standalone brain reads an empty store and reports \"no brain built for this\n83\t// repository\" — a confident wrong answer rather than an error. On Unix both\n84\t// sides already use XDG then ~/.local/share; Windows is where they diverged.\n85\t//\n86\t// These exercise the Windows rule from any machine by passing the target OS\n87\t// explicitly, the same way planBrainWatchDaemon is golden-tested for darwin and\n88\t// linux from one host. One caveat they cannot escape: filepath.IsAbs is\n89\t// host-dependent, so a literal \"C:\\\\...\" is not absolute on darwin. The inputs\n90\t// below are therefore host-absolute temp dirs, and the genuinely Windows-shaped\n91\t// paths are covered by this same code running on the Windows CI leg.\n92\t\n93\tfunc TestWindowsPluginDataRootMirrorsTheHostLayout(t *testing.T) {\n94\t\tlocalAppData := t.TempDir()\n95\t\thome := t.TempDir()\n96\t\n97\t\tgot, err := windowsPluginDataRoot(localAppData, home)\n98\t\tif err != nil {\n99\t\t\tt.Fatalf(\"with LOCALAPPDATA: %v\", err)\n100\t\t}\n101\t\tif want := filepath.Join(localAppData, XDGRootDir); got != want {\n102\t\t\tt.Fatalf(\"with LOCALAPPDATA: got %q, want %q\", got, want)\n103\t\t}\n104\t\n105\t\tgot, err = windowsPluginDataRoot(\"\", home)\n106\t\tif err != nil {\n107\t\t\tt.Fatalf(\"without LOCALAPPDATA: %v\", err)\n108\t\t}\n109\t\tif want := filepath.Join(home, \"AppData\", \"Local\", XDGRootDir); got != want {\n110\t\t\tt.Fatalf(\"without LOCALAPPDATA: got %q, want %q\", got, want)\n111\t\t}\n112\t}\n113\t\n114\t// A relative %LOCALAPPDATA% is discarded rather than joined. The host requires\n115\t// an absolute one, so honouring a relative value here would invent a third\n116\t// location instead of agreeing with the host or with the home fallback.\n117\tfunc TestWindowsPluginDataRootDiscardsRelativeLocalAppData(t *testing.T) {\n118\t\thome := t.TempDir()\n119\t\n120\t\tgot, err := windowsPluginDataRoot(filepath.Join(\"relative\", \"appdata\"), home)\n121\t\tif err != nil {\n122\t\t\tt.Fatalf(\"relative LOCALAPPDATA: %v\", err)\n123\t\t}\n124\t\tif want := filepath.Join(home, \"AppData\", \"Local\", XDGRootDir); got != want {\n125\t\t\tt.Fatalf(\"relative LOCALAPPDATA: got %q, want %q\", got, want)\n126\t\t}\n127\t\n128\t\tif _, err := windowsPluginDataRoot(\"\", \"\"); err == nil {\n129\t\t\tt.Fatal(\"no LOCALAPPDATA and no home: want an error, got nil\")\n130\t\t}\n131\t}\n132\t\n133\t// The dispatched path must be unaffected on every OS: when the host sets\n134\t// ENTIRE_PLUGIN_DATA_DIR, that value wins outright and neither XDG nor\n135\t// LOCALAPPDATA is consulted.\n136\tfunc TestResolvePluginDataRootPrefersTheHostSuppliedDir(t *testing.T) {\n137\t\thostDir := t.TempDir()\n138\t\tt.Setenv(EnvLocalAppData, t.TempDir())\n139\t\tt.Setenv(XDGDataHome, t.TempDir())\n140\t\n141\t\tfor _, goos := range []string{windowsGOOS, \"linux\", \"darwin\"} {\n142\t\t\tgot, err := resolvePluginDataRoot(hostDir, goos)\n143\t\t\tif err != nil {\n144\t\t\t\tt.Fatalf(\"goos %s: %v\", goos, err)\n145\t\t\t}\n146\t\t\tif got != hostDir {\n147\t\t\t\tt.Fatalf(\"goos %s: got %q, want the host-supplied %q\", goos, got, hostDir)\n148\t\t\t}\n149\t\t}\n150\t}\n151\t\n152\t// The divergence itself: with no host-supplied dir, Windows must follow\n153\t// LOCALAPPDATA and ignore XDG_DATA_HOME, while every other OS keeps the XDG\n154\t// rule untouched.\n155\tfunc TestResolvePluginDataRootIgnoresXDGOnWindowsOnly(t *testing.T) {\n156\t\tlocalAppData := t.TempDir()\n157\t\txdgData := t.TempDir()\n158\t\tt.Setenv(EnvLocalAppData, localAppData)\n159\t\tt.Setenv(XDGDataHome, xdgData)\n160\t\n161\t\tgot, err := resolvePluginDataRoot(\"\", windowsGOOS)\n162\t\tif err != nil {\n163\t\t\tt.Fatalf(\"windows: %v\", err)\n164\t\t}\n165\t\tif want := filepath.Join(localAppData, XDGRootDir); got != want {\n166\t\t\tt.Fatalf(\"windows: got %q, want %q (XDG_DATA_HOME must be ignored)\", got, want)\n167\t\t}\n168\t\n169\t\tfor _, goos := range []string{\"linux\", \"darwin\"} {\n170\t\t\tgot, err := resolvePluginDataRoot(\"\", goos)\n171\t\t\tif err != nil {\n172\t\t\t\tt.Fatalf(\"goos %s: %v\", goos, err)\n173\t\t\t}\n174\t\t\tif want := filepath.Join(xdgData, XDGRootDir); got != want {\n175\t\t\t\tt.Fatalf(\"goos %s: got %q, want %q (XDG rule must be unchanged)\", goos, got, want)\n176\t\t\t}\n177\t\t}\n178\t}","rereadEntry":{"timestamp":1794414865573,"contentHash":"3echzpc9bxtym","contentLength":6367}},"type":"attachment","uuid":"eb25c70f-5a27-41f3-9812-35f453a43790","timestamp":"2026-11-11T16:34:26.351Z","rendered":[{"content":"<system-reminder>\nNote: /Users/suhaan/devenv/brain-windows/internal/cli/internal/base/env_test.go changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n72\t\t}\n73\t\tif dirs.State != filepath.Join(xdg, \"state\", \"entire\") {\n74\t\t\tt.Fatalf(\"State = %q\", dirs.State)\n75\t\t}\n76\t\tif dirs.Cache != filepath.Join(xdg, \"cache\", \"entire\") {\n77\t\t\tt.Fatalf(\"Cache = %q\", dirs.Cache)\n78\t\t}\n79\t}\n80\t\n81\t// The brain and the host CLI must resolve the same plugin data root, or a\n82\t// standalone brain reads an empty store and reports \"no brain built for this\n83\t// repository\" — a confident wrong answer rath