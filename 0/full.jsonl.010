ines":3,"newStart":58,"newLines":41,"lines":[" \t}"," \treturn errors.Is(err, os.ErrPermission)"," }","+","+// The classifier decides skip-versus-fail, and on a POSIX machine no real call","+// ever hands it the Windows errno — so without this it would ship untested on","+// the one platform it exists for. os.Symlink wraps its errno in *os.LinkError,","+// which is the shape errors.As has to see through.","+func TestIsSymlinkPrivilegeError(t *testing.T) {","+\tt.Parallel()","+","+\tconst privilegeNotHeld = syscall.Errno(1314) // Windows ERROR_PRIVILEGE_NOT_HELD","+","+\tcases := []struct {","+\t\tname string","+\t\terr  error","+\t\twant bool","+\t}{","+\t\t{","+\t\t\tname: \"windows privilege refusal, wrapped as os.Symlink returns it\",","+\t\t\terr:  &os.LinkError{Op: \"symlink\", Old: \"target\", New: \"link\", Err: privilegeNotHeld},","+\t\t\twant: true,","+\t\t},","+\t\t{\"bare windows errno\", privilegeNotHeld, true},","+\t\t{\"posix permission denied\", &os.LinkError{Op: \"symlink\", Err: syscall.EACCES}, true},","+\t\t{\"posix operation not permitted\", &os.LinkError{Op: \"symlink\", Err: syscall.EPERM}, true},","+\t\t// A broken fixture must still fail loudly rather than vanish into a skip.","+\t\t{\"file exists\", &os.LinkError{Op: \"symlink\", Err: syscall.EEXIST}, false},","+\t\t{\"no such file\", &os.LinkError{Op: \"symlink\", Err: syscall.ENOENT}, false},","+\t\t{\"not a syscall error at all\", errors.New(\"some other failure\"), false},","+\t\t{\"nil\", nil, false},","+\t}","+\tfor _, tc := range cases {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+\t\t\tif got := isSymlinkPrivilegeError(tc.err); got != tc.want {","+\t\t\t\tt.Fatalf(\"isSymlinkPrivilegeError(%v) = %v, want %v\", tc.err, got, tc.want)","+\t\t\t}","+\t\t})","+\t}","+}"]}]}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/brain-windows/internal/cli/symlink_test.go"]}},"serverClassifierContext":{"request":"02ed5be5-95e2-4a29-9905-b4d7e5e17b7e","context":{"git_st