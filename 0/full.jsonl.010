aultStoreFallbackStaysInsideTheSandbox is what actually asserts it.\n\tt.Setenv(base.EnvLocalAppData, filepath.Join(dir, \"AppData\", \"Local\"))\n\tgot, err := os.UserHomeDir()'''\nassert old in s\ns = s.replace(old, new)\n\ns = s.replace('''import (\n\t\"os\"\n\t\"runtime\"\n\t\"testing\"\n\n\t\"github.com/entireio/entire-brain/internal/cli/internal/base\"\n)''', '''import (\n\t\"os\"\n\t\"path/filepath\"\n\t\"runtime\"\n\t\"testing\"\n\n\t\"github.com/entireio/entire-brain/internal/cli/internal/base\"\n)''')\n\n# Strengthen the sandbox test: name LOCALAPPDATA alongside HOME/USERPROFILE.\nold_loop = '''\tfor _, key := range []string{\"HOME\", \"USERPROFILE\"} {\n\t\tif got := os.Getenv(key); got != home {\n\t\t\tt.Errorf(\"%s = %q, want the redirected home %q; os.UserHomeDir reads this \"+\n\t\t\t\t\"variable on at least one supported platform\", key, got, home)\n\t\t}\n\t}'''\nnew_loop = '''\tfor _, key := range []string{\"HOME\", \"USERPROFILE\"} {\n\t\tif got := os.Getenv(key); got != home {\n\t\t\tt.Errorf(\"%s = %q, want the redirected home %q; os.UserHomeDir reads this \"+\n\t\t\t\t\"variable on at least one supported platform\", key, got, home)\n\t\t}\n\t}\n\n\t// LOCALAPPDATA is checked separately because it is not a home variable: it\n\t// must point INSIDE the redirected home, not at it. The Windows data-root\n\t// rule prefers it over the %USERPROFILE%\\\\AppData\\\\Local fallback, so leaving\n\t// it at the machine's real value is an escape that no POSIX shard can see.\n\tif got := os.Getenv(base.EnvLocalAppData); !base.PathInside(home, got) {\n\t\tt.Errorf(\"%s = %q, want a path inside the redirected home %q; the Windows \"+\n\t\t\t\"data-root rule reads this before falling back to the home directory\",\n\t\t\tbase.EnvLocalAppData, got, home)\n\t}'''\nassert old_loop in s\ns = s.replace(old_loop, new_loop)\np.write_text(s)\nprint(\"testhome_test updated\")\nPY\ngofmt -l internal/cli/testhome_test.go && echo \"gofmt clean\"\ngo test ./internal/cli -run 'TestDefaultStoreFallbackStaysInsideTheSandbox' -count=1 2>&1 | tail -3","description":"Redirect LOCALAPPDATA in the home sandbox helper"}},"serverClassifierRequest":"c866cd16-0b94-4e77-a53c-6c1498fc1a8a","apiBlockIndex":1,"requestId":"req_011Ch9CbKngCHm4SxUp5jPxS","requestRef":"e763af18-35ee-4671-bb6e-845499c98d3b","requestedModel":"claude-opus-5","promptCacheRequested":"1h","type":"assistant","uuid":"e23ce87e-c7b1-4789-9c8a-8617da2e12c1","timestamp":"2026-11-17T21:21:26.232Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":null,"session_id":"1041b1a0-c015-41c2-a29f-4f2db2f6e0cb","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/brain-windows","sessionId":"93ae8948-c612-4072-8e70-2750e80df9ce","version":"2.1.323","gitBranch":"main","slug":"floofy-discovering-bachman"}
