reatedAt\":\"2026-11-03T02:18:51Z\",\"deletions\":23,\"headRefName\":\"fix/distill-oversize-transcript\",\"isDraft\":true,\"mergeable\":\"UNKNOWN\",\"number\":591,\"title\":\"fix(distill): let one over-cap transcript cost its own session, not the pass\",\"url\":\"https://github.com/entireio/entire-brain/pull/591\"}]","is_error":false}]},"uuid":"b667e703-74ee-49a8-a8db-01eb8fef7625","timestamp":"2026-11-19T01:17:38.551Z","toolUseResult":{"stdout":"[{\"additions\":1560,\"changedFiles\":37,\"createdAt\":\"2026-11-18T23:16:58Z\",\"deletions\":115,\"headRefName\":\"win/full-support\",\"isDraft\":true,\"mergeable\":\"MERGEABLE\",\"number\":654,\"title\":\"fix(windows): make the brain work on a real Windows machine\",\"url\":\"https://github.com/entireio/entire-brain/pull/654\"},{\"additions\":2658,\"changedFiles\":15,\"createdAt\":\"2026-11-03T02:20:23Z\",\"deletions\":13,\"headRefName\":\"rc/m1-record-schema\",\"isDraft\":true,\"mergeable\":\"UNKNOWN\",\"number\":595,\"title\":\"feat(memories): typed records, review write-back, and a provenance walk\",\"url\":\"https://github.com/entireio/entire-brain/pull/595\"},{\"additions\":2679,\"changedFiles\":21,\"createdAt\":\"2026-11-03T02:19:59Z\",\"deletions\":114,\"headRefName\":\"rc/m05-surface-fixes\",\"isDraft\":true,\"mergeable\":\"UNKNOWN\",\"number\":594,\"title\":\"feat(memories): deliver memories unprompted, and make reuse measurable\",\"url\":\"https://github.com/entireio/entire-brain/pull/594\"},{\"additions\":490,\"changedFiles\":5,\"createdAt\":\"2026-11-03T02:19:39Z\",\"deletions\":10,\"headRefName\":\"fix/entity-delta-disclosure\",\"isDraft\":true,\"mergeable\":\"UNKNOWN\",\"number\":593,\"title\":\"fix(entities): disclose what the entity index cannot answer\",\"url\":\"https://github.com/entireio/entire-brain/pull/593\"},{\"additions\":415,\"changedFiles\":3,\"createdAt\":\"2026-11-03T02:19:20Z\",\"deletions\":4,\"headRefName\":\"fix/migrate-warning-relevance\",\"isDraft\":true,\"mergeable\":\"UNKNOWN\",\"numbe