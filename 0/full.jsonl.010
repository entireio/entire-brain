{"type":"pr-link","sessionId":"93ae8948-c612-4072-8e70-2750e80df9ce","prNumber":499,"prUrl":"https://github.com/entireio/entire-brain/pull/499","prRepository":"entireio/entire-brain","timestamp":"2026-11-17T21:14:58.794Z"}
