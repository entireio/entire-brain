eSourceAvoidsFilepath(t *testing.T) {","+\tt.Parallel()","+","+\tconst file = \"doctor_synced_store.go\"","+\tparsed, err := parser.ParseFile(token.NewFileSet(), file, nil, parser.ImportsOnly)","+\tif err != nil {","+\t\tt.Fatalf(\"parse %s: %v\", file, err)","+\t}","+\tfor _, spec := range parsed.Imports {","+\t\tif spec.Path.Value == `\"path/filepath\"` {","+\t\t\tt.Fatalf(\"%s imports path/filepath; its separator handling is OS-dependent, \"+","+\t\t\t\t\"which made the OneDrive warning unreachable on Windows. Use package path.\", file)","+\t\t}","+\t}","+}"]}]}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/brain-windows/internal/cli/doctor_synced_store_test.go"]}},"serverClassifierContext":{"request":"7847b060-4315-4551-b5ae-2dc536f3e012","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-windows","root":"/Users/suhaan/devenv/brain-windows","branch":"win/full-support","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},"push_remote":"origin","remotes":[{"name":"entireio","host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"name":"origin","host":"github.com","remote":"entireio/entire-brain","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"}]}},"live_cwd":"/Users/suhaan/devenv/brain-windows","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"4e17499a-68af-40a0-82ff-1c160d2883f7","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"1041b1a0-c015-41c2-a29f-4f2db2f6e0cb","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/brain-windows","sessionId":"93ae8948-c612-4072-8e70-2750e80df9ce","version":"2.1.323","gitB