= redirectHomeDir(t)","+\trepo := filepath.Join(home, \"projects\", \"app\")","+\tif err := os.MkdirAll(repo, 0o755); err != nil {","+\t\tt.Fatal(err)","+\t}","+","+\tpath, changed, err := installPreEditHook(repo)","+\tif err != nil {","+\t\tt.Fatalf(\"a repository below the home directory must still be wired: %v\", err)","+\t}","+\tif !changed {","+\t\tt.Error(\"a fresh repository should have gained the hook\")","+\t}","+\tif _, err := os.Stat(path); err != nil {","+\t\tt.Errorf(\"settings file not written at %s: %v\", path, err)","+\t}","+}","+","+func TestIsUserHomeDir(t *testing.T) {","+\tt.Parallel()","+","+\tcases := []struct {","+\t\tname    string","+\t\trepoDir string","+\t\thomeDir string","+\t\twant    bool","+\t}{","+\t\t{\"identical\", \"/Users/sam\", \"/Users/sam\", true},","+\t\t{\"child is not the home\", \"/Users/sam/code\", \"/Users/sam\", false},","+\t\t{\"parent is not the home\", \"/Users\", \"/Users/sam\", false},","+\t\t{\"trailing separator\", \"/Users/sam/\", \"/Users/sam\", true},","+\t\t// Windows hands back whatever casing the profile was created with, and","+\t\t// a repo root can arrive with either separator.","+\t\t{\"windows casing differs\", `C:\\Users\\Sam`, `c:\\users\\sam`, true},","+\t\t{\"windows mixed separators\", \"C:/Users/Sam\", `C:\\Users\\Sam`, true},","+\t\t{\"windows sibling\", `C:\\Users\\Sam2`, `C:\\Users\\Sam`, false},","+\t\t{\"empty repo dir\", \"\", \"/Users/sam\", false},","+\t\t{\"empty home dir\", \"/Users/sam\", \"\", false},","+\t}","+\tfor _, tc := range cases {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+\t\t\tif got := isUserHomeDir(tc.repoDir, tc.homeDir); got != tc.want {","+\t\t\t\tt.Fatalf(\"isUserHomeDir(%q, %q) = %v, want %v\", tc.repoDir, tc.homeDir, got, tc.want)","+\t\t\t}","+\t\t})","+\t}","+}"]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/brain-windows/internal/cli/agent_wiring_home_guard_test.go"]}},"serverClassifierContext":{"request":"4a9cb7f0-9e93-4723-ab16-f1287ba57628","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-windows","root":"/Users/suhaan/devenv/brain-windows","branch":"win/full-support","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":22,"untracked":null,"untracked_normal":2},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},"push_remote":"origin","remotes":[{"name":"entireio","host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"name":"origin","host":"github.com","remote":"entireio/entire-brain","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"}]}},"live_cwd":"/Users/suhaan/devenv/brain-windows","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"b7d3408c-05bf-4a45-a499-6936b101be1f","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"1041b1a0-c015-41c2-a29f-4f2db2f6e0cb","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/brain-windows","sessionId":"93ae8948-c612-4072-8e70-2750e80df9ce","version":"2.1.323","gitBranch":"main","slug":"floofy-discovering-bachman"}
