t.Fatal(err)\n \t}\n-\tif err := os.Symlink(elsewhere, filepath.Join(dataDir, base.RepoStoreDirName)); err != nil {\n-\t\tt.Fatal(err)\n-\t}\n+\tsymlinkForTest(t, elsewhere, filepath.Join(dataDir, base.RepoStoreDirName))\n \n \tcmd := NewRootCommand(Options{\n \t\tVersion: \"test-version\",\n@@ -146,9 +144,7 @@ func TestHeadPathForKeyAppliesTheSameGuardsAsBrainDirForKey(t *testing.T) {\n \n \t// A symlinked component must be refused, exactly as brainDirForKey refuses it.\n \tlinked := filepath.Join(stateDir, base.RepoStoreDirName, \"linked\")\n-\tif err := os.Symlink(t.TempDir(), linked); err != nil {\n-\t\tt.Fatal(err)\n-\t}\n+\tsymlinkForTest(t, t.TempDir(), linked)\n \tif head, err := base.HeadPathForKey(env, \"linked/acme/repo\"); err == nil {\n \t\tt.Fatalf(\"headPathForKey followed a symlinked component to %s\", head)\n \t}","is_error":false}]},"uuid":"8c1b4c97-5990-49f8-bfee-1bc46a6d5c11","timestamp":"2026-11-17T21:33:55.607Z","toolUseResult":{"stdout":"=== agentsetup symlinkForTest ===\ndiff --git a/internal/agentsetup/agents_test.go b/internal/agentsetup/agents_test.go\nindex ae357046..0c69b452 100644\n--- a/internal/agentsetup/agents_test.go\n+++ b/internal/agentsetup/agents_test.go\n@@ -9,6 +9,7 @@ import (\n \t\"path/filepath\"\n \t\"runtime\"\n \t\"strings\"\n+\t\"syscall\"\n \t\"testing\"\n )\n \n@@ -1719,8 +1720,23 @@ func writeFileForTest(t *testing.T, path, content string) {\n func symlinkForTest(t *testing.T, target, link string) {\n \tt.Helper()\n \tif err := os.Symlink(target, link); err != nil {\n-\t\tt.Fatal(err)\n+\t\tif isSymlinkPrivilegeError(err) {\n+\t\t\tt.Skipf(\"symlinks unavailable on this host: %v\", err)\n+\t\t}\n+\t\tt.Fatalf(\"symlink %s -> %s: %v\", link, target, err)\n+\t}\n+}\n+\n+// isSymlinkPrivilegeError reports the host refusing the privilege (Windows\n+// ERROR_PRIVILEGE_NOT_HELD, 1314) rather than an ordinary failure. The code is\n+// numeric so this compiles on every platform.\n+func isSymlinkPrivilegeError(err error) bool {\n+\tconst windowsErrorPrivilegeNotHeld = syscall.Errno(1314)\n+\tvar errno syscall.Errno\n+\tif errors.As(err, &errno) && errno == windowsErrorPrivilegeNotHeld {\n+\t\treturn true\n \t}\n+\treturn errors.Is(err, os.ErrPermission)\n }\n \n // TestInstructionReadsAreConfinedToRepository drives the read helpers directly, which is the only\n=== one cli conversion sample ===\ndiff --git a/internal/cli/repo_key_guard_test.go b/internal/cli/repo_key_guard_test.go\nindex 8852ab21..51adfe65 100644\n--- a/internal/cli/repo_key_guard_test.go\n+++ b/internal/cli/repo_key_guard_test.go\n@@ -98,9 +98,7 @@ func TestPathRefusesSymlinkedStoreRoot(t *testing.T) {\n \tif err := os.MkdirAll(elsewhere, 0o700); err != nil {\n \t\tt.Fatal(err)\n \t}\n-\tif err := os.Symlink(elsewhere, filepath.Join(dataDir, base.RepoStoreDirName)); err != nil {\n-\t\tt.Fatal(err)\n-\t}\n+\tsymlinkForTest(t, elsewhere, filepath.Join(dataDir, base.RepoStoreDirName))\n \n \tcmd := NewRootCommand(Options{\n \t\tVersion: \"test-version\",\n@@ -146,9 +144,7 @@ func TestHeadPathForKeyAppliesTheSameGuardsAsBrainDirForKey(t *testing.T) {\n \n \t// A symlinked component must be refused, exactly as brainDirForKey refuses it.\n \tlinked := filepath.Join(stateDir, base.RepoStoreDirName, \"linked\")\n-\tif err := os.Symlink(t.TempDir(), linked); err != nil {\n-\t\tt.Fatal(err)\n-\t}\n+\tsymlinkForTest(t, t.TempDir(), linked)\n \tif head, err := base.HeadPathForKey(env, \"linked/acme/repo\"); err == nil {\n \t\tt.Fatalf(\"headPathForKey followed a symlinked component to %s\", head)\n \t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"20f87b32-951d-4f94-9327-1d0f8f2025e6","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-windows","root":"/Users/suhaan/devenv/brain-windows","branch":"win/full-support","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":24,"untracked":null,"untracked_normal":3},"porcelain":null,"truncate