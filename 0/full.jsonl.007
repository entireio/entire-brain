Key(name, \"--version\")] = fakeCommandResponse{stdout: \"available\"}","-\t}","-\tvar out, diagnostic bytes.Buffer","-\tcmd := NewRootCommand(opts)","-\tcmd.SetOut(&out)","-\tcmd.SetErr(&diagnostic)","-\tcmd.SetArgs([]string{\"distill\", \"--agent\", \"auto\", \"--dry-run\"})","-\tif err := cmd.Execute(); err != nil {","-\t\tt.Fatal(err)","-\t}","-\tfor _, want := range []string{\"ollama\", \"--model\", \"codex\"} {","-\t\tif !strings.Contains(diagnostic.String(), want) {","-\t\t\tt.Errorf(\"fallback diagnostic lacks %q: %s\", want, diagnostic.String())","-\t\t}","-\t}","-}","-","-type fakeWhichRunner struct{ present map[string]bool }","-","-func (f fakeWhichRunner) Run(ctx context.Context, dir, name string, args ...string) ([]byte, []byte, error) {","-\tif len(args) > 0 && f.present[args[0]] {","-\t\treturn []byte(\"/usr/local/bin/\" + args[0] + \"\\n\"), nil, nil","-\t}","-\tif f.present[name] {","-\t\treturn []byte(\"ok\\n\"), nil, nil","-\t}","-\treturn nil, nil, context.Canceled","-}","-","-// `auto` used to resolve to ollama whenever the binary was on PATH, but","-// execOllamaDistillAgent hard-errors with \"--agent ollama requires --model\"","-// and auto has no model to give: the distill path reads it from --model alone,","-// and ENTIRE_BRAIN_OLLAMA_MODEL is the EMBEDDING path's variable, not this one.","-//","-// So merely installing ollama broke distill, refresh, watch --distill,","-// remember without --path, and recall --expand. `ollama --version` succeeds","-// with no server and no models pulled, so installation alone was enough.","-func TestAutoNeverResolvesToOllama(t *testing.T) {","-\tt.Parallel()","-","-\tctx := context.Background()","-\tall := fakeWhichRunner{present: map[string]bool{\"ollama\": true, \"codex\": true, \"claude\": true}}","-\tif got := defaultRefreshAgent(ctx, all, t.TempDir()); got == \"ollama\" {","-\t\tt.Error(\"auto must not choose ollama: it cannot supply the --model ollama requires\")","-\t}","-","-\t// It still chooses a working agent rather than giving up.","-\tif got := defaultRefreshAgent(ctx, all, t.TempDir()); got != \"codex\" {","-\t\tt.Errorf(\"auto should fall through to the next usable agent, got %q\", got)","-\t}","-\tonlyClaude := fakeWhichRunner{present: map[string]bool{\"ollama\": true, \"claude\": true}}","-\tif got := defaultRefreshAgent(ctx, onlyClaude, t.TempDir()); got != \"claude-code\" {","-\t\tt.Errorf(\"with only claude beside ollama, want claude-code, got %q\", got)","-\t}","-\t// Nothing usable is still \"none\", not ollama.","-\tonlyOllama := fakeWhichRunner{present: map[string]bool{\"ollama\": true}}","-\tif got := defaultRefreshAgent(ctx, onlyOllama, t.TempDir()); got != \"none\" {","-\t\tt.Errorf(\"ollama alone cannot distill automatically, want none, got %q\", got)","-\t}","-}","-","-// Falling through must not be silent: a user who installed ollama for privacy","-// needs to know a cloud agent ran instead, and how to get the local one.","-func TestFallingBackFromOllamaIsDisclosed(t *testing.T) {","-\tt.Parallel()","-","-\tctx := context.Background()","-\tall := fakeWhichRunner{present: map[string]bool{\"ollama\": true, \"codex\": true}}","-","-\twarn := ollamaModelMissingWarning(ctx, all, t.TempDir(), \"codex\")","-\tfor _, want := range []string{\"ollama\", \"--model\", \"codex\"} {","-\t\tif !strings.Contains(warn, want) {","-\t\t\tt.Errorf(\"the warning must mention %q: %q\", want, warn)","-\t\t}","-\t}","-","-\t// No warning when ollama was actually used, when nothing ran, or when","-\t// ollama is not installed at all -- otherwise it is noise.","-\tif got := ollamaModelMissingWarning(ctx, all, t.TempDir(), \"ollama\"); got != \"\" {","-\t\tt.Errorf(\"no warning when ollama was chosen: %q\", got)","-\t}","-\tif got := ollamaModelMissingWarning(ctx, all, t.TempDir(), \"none\"); got != \"\" {","-\t\tt.Errorf(\"no warning when no agent ran: %q\", got)","-\t}","-\tnoOllama := fakeWhichRunner{present: map[string]bool{\"codex\": true}}","-\tif got := ollamaModelMissingWarning(ctx, noOllama, t.TempDir(), \"codex\"); got != \"\" {","-\t\tt.Errorf(\"no warning when ollama is not installed: %q\", got)","-\t}","-}"]}],"deleted":true}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/brain-v1-retrieval/internal/cli/refresh_ollama_auto_test.go"]}},"serverClassifierContext":{"request":"d8f77c5d-7b53-4fa8-a272-9b4300813e44","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-v1-retrieval","root":"/Users/suhaan/devenv/brain-v1-retrieval","branch":"fix/retrieval-output-correctness","default_branch":null,"status":{"clean":false,"counts":{"staged":181,"modified":11,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},"push_remote":"origin","remotes":[{"name":"entireio","host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"name":"origin","host":"github.com","remote":"entireio/entire-brain","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entireio/entire-graph","visibility":"public"},{"host":"github.com","remote":"entireio/cli","visibility":"public"}]}},"live_cwd":"/Users/suhaan/devenv/brain-v1-retrieval","platform":"macos"}},"sourceToolAssistantUUID":"c8cc0c2f-20dc-4e89-8002-2ae1fc38652c","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"60a744a6-1b89-494f-a7de-f94ff9566958","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/brain-v1-retrieval","sessionId":"93ae8948-c612-4072-8e70-2750e80df9ce","version":"2.1.301","gitBranch":"main","slug":"floofy-discovering-bachman"}
