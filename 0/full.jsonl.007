{"type":"api-request-blob","sessionId":"93ae8948-c612-4072-8e70-2750e80df9ce","hash":"80ca2ad528f7a82dfc8ad55f3c87e5bf7de9cb38f42d5534cce231bc219b992b","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"text","text":"Main's contract is better than the one #329 asserts: silence is gated on `--claude-hook` (the real hook invocation), while a hand-run stays loud \"so hand-testing stays debuggable\". Aligning both tests:"},{"type":"tool_use","id":"toolu_01Twgq3SHcSbbrEyHQGZ1MsM","name":"Bash","input":{"command":"cd /Users/suhaan/devenv/brain-v1-retrieval && python3 - <<'PY'\nimport pathlib\np = pathlib.Path(\"internal/cli/hook_payload_test.go\"); s = p.read_text()\n\nold = s[s.index('''\t// Driven through a REAL pipe.'''):s.index('''\t\tt.Errorf(\"an unrecognised payload must be silence, got: %v\", err)\n\t}\n}''') + len('''\t\tt.Errorf(\"an unrecognised payload must be silence, got: %v\", err)\n\t}\n}''')]\nnew = '''\t// Silence is gated on --claude-hook, which is how the REAL hook invokes\n\t// this verb. That is a better contract than the unconditional silence this\n\t// test used to assert: the hook must never break an agent's edit over a\n\t// payload it cannot read, and a human hand-running the verb must still be\n\t// told what they got wrong.\n\trunHook := func(stdin string) error {\n\t\tvar out bytes.Buffer\n\t\tcmd := NewRootCommand(f.opts)\n\t\tcmd.SetIn(strings.NewReader(stdin))\n\t\tcmd.SetOut(&out)\n\t\tcmd.SetErr(&out)\n\t\tcmd.SetArgs([]string{\"hook\", \"pre-edit\", \"--claude-hook\"})\n\t\treturn cmd.Execute()\n\t}\n\tif err := runHook(\"not a hook payload at all\"); err != nil {\n\t\tt.Errorf(\"the real hook must stay silent on a payload it cannot read, got: %v\", err)\n\t}\n\tif err := run(\"not a hook payload at all\"); err == nil {\n\t\tt.Error(\"a hand-run with no --file must still say so, or the verb is undebuggable by hand\")\n\t}\n}'''\ns = s.replace(old, new, 1)\n\nstart = s.index(\"// The call site must actually gate the read.\")\nend = s.index(\"\\n}\\n\", s.index(\"func TestTheHookCallSiteGuardsTheStdinRead\", start)) + len(\"\\n}\\n\")\ns = s[:start] + '''// The call site must gate the read on whether stdin is actually readable.\n//\n// Asserted through the predicate and the fast-fail path, not by grepping\n// hook_cmd.go for an identifier: that earlier form pinned a NAME, and when the\n// predicate was renamed and inverted the guard went red on correct code.\n//\n// A terminal is a character device, so it is not a pipe and must never be\n// read; a pipe is the harness and must be. The hang this prevents is reading\n// the first, not the second.\nfunc TestTheHookCallSiteGuardsTheStdinRead(t *testing.T) {\n\tt.Parallel()\n\n\tpr, pw, err := os.Pipe()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Cleanup(func() { _ = pw.Close(); _ = pr.Close() })\n\tif !stdinIsPipe(pr) {\n\t\tt.Error(\"a pipe is the harness handing over a payload; it must be read\")\n\t}\n\n\t// The fast-fail path: --claude-hook with no --file and nothing pipeable\n\t// must return promptly rather than read a stream that never EOFs.\n\tf := newVerifyFixture(t)\n\tdone := make(chan error, 1)\n\tgo func() {\n\t\tvar out bytes.Buffer\n\t\tcmd := NewRootCommand(f.opts)\n\t\tcmd.SetIn(neverEOFReader{})\n\t\tcmd.SetOut(&out)\n\t\tcmd.SetErr(&out)\n\t\tcmd.SetArgs([]string{\"hook\", \"pre-edit\", \"--file\", \"internal/cli/hook_cmd.go\", \"--claude-hook\"})\n\t\tdone <- cmd.Execute()\n\t}()\n\tselect {\n\tcase <-done:\n\tcase <-time.After(10 * time.Second):\n\t\tt.Fatal(\"`hook pre-edit --file ... --claude-hook` read stdin it was never meant to touch\")\n\t}\n}\n\n// neverEOFReader stands in for a terminal: a read that never returns.\ntype neverEOFReader struct{}\n\nfunc (neverEOFReader) Read([]byte) (int, error) { select {} }\n''' + s[end:]\np.write_text(s); print(\"both hook tests aligned to the --claude-hook contract\")\nPY\ngofmt -w internal/cli/hook_payload_test.go; env -u FORCE_COLOR GOMAXPROCS=2 go test ./internal/cli/ -run 'TestPreEditCommandDistinguishesMisuseFromAnUnreadablePayload|TestTheHookCallSiteGuardsTheStdinRead' -p 1 -parallel 1 -count=1 2>&1 | grep -E \"_test.go:|ok |FAIL\" | head -4","description":"Align the hook tests to main's contract","timeout":400000},"caller":{"type":"direct"}}]}}
