{"type":"api-request-blob","sessionId":"93ae8948-c612-4072-8e70-2750e80df9ce","hash":"c779c848f6230589bc505cb8b808873939de075d7d80939b899954f7c015df23","message":{"role":"user","content":[{"tool_use_id":"toolu_01EKUaDQ3BJS6KSbMXGYwSaB","type":"tool_result","content":"##### publish.go\n<<<<<<< HEAD\n\t\treturn fmt.Errorf(\"no_egress: hosted brain publish is disabled while ENTIRE_BRAIN_NO_EGRESS or ENTIRE_BRAIN_LOCAL_ONLY is set; unset it to publish\")\n\t}\n\t// Gate 2: the explicit hosted opt-in must be truthy. Unset/empty/false refuses\n\t// with no network call — the client-side no-implicit-egress guarantee. This is\n\t// deliberately NOT securityToggleEnabled (which fails a garbage value ON): a\n\t// publish opt-in must fail CLOSED, so anything not clearly truthy stays local.\n\tif !envBool(envBrainAllowHosted) {\n\t\treturn fmt.Errorf(\"hosted_publish_disabled: hosted brain publishing is opt-in and off by default; nothing was sent. Set %s=1 and re-run '\"+brainInvocation(os.LookupEnv, \"publish\")+\"' to enable it\", envBrainAllowHosted)\n=======\n\t\treturn fmt.Errorf(\"no_egress: hosted brain publish is disabled while %s is set; unset it to publish\", noEgressToggleName())\n>>>>>>> origin/main\n\n##### ollama test (2 hunks)\n<<<<<<< HEAD\n\t\tfor served.Load() < int64(distillOllamaMaxEnvelopeBytes)+ollamaEnvelopeStreamHeadroom {\n=======\n\t\tfor served.Load() < int64(distillOllamaMaxEnvelopeBytes)+(64<<20) {\n>>>>>>> origin/main\n<<<<<<< HEAD\n\t// What this counts is what the SERVER WROTE, which runs ahead of what the\n\t// client read by however much the connection will buffer. The tolerance\n\t// used to be 4MiB while the handler stopped at 8MiB, so the assertion sat\n\t// INSIDE the server's own bound: it was measuring goroutine scheduling, and\n\t// it failed on main at 38797312 bytes with nothing wrong with the client.\n\t//\n\t// The handler now offers far more than any correct client would take, and\n\t// the bound is set above the buffering overshoot but far below the offer.\n\t// A client that follows the stream still fails; one that stops at the\n\t// ceiling passes regardless of how far the writer ran ahead.\n\tif got := served.Load(); got > int64(distillOllamaMaxEnvelopeBytes)+ollamaEnvelopeStopTolerance {\n\t\tt.Fatalf(\"read %d bytes, must stop near the %d ceiling rather than following the stream\",\n=======\n\t// served counts what the server wrote, not what the client read: after\n\t// the client stops at the ceiling, kernel socket buffers on both ends\n\t// keep accepting writes, and tuned hosts buffer several MiB. The slack\n\t// only needs to separate \"stopped at the ceiling\" from \"followed the\n\t// stream to the 64 MiB overshoot\".\n\tif got := served.Load(); got > int64(distillOllamaMaxEnvelopeBytes)+(32<<20) {\n\t\tt.Fatalf(\"served %d bytes, must stop near the %d ceiling rather than following the stream\",\n>>>>>>> origin/main","is_error":false}]}}
