hrough memoryWorkerLaunch, so the tests that stub it would spawn real processes\")\n\t}\n\tif strings.Contains(source, \"os.Executable()\") && strings.Contains(source, \"memoryWorkerSettle\") {\n\t\tt.Error(\"the settle path re-execs the binary again; it must wait on the lock, not the process\")\n\t}\n}\nEOF\ngofmt -w internal/cli/watch_worker_lock_race_test.go && env -u FORCE_COLOR GOMAXPROCS=2 go test ./internal/cli/ -race -run 'TestWatchSettles|TestLockSettle|TestOnlyWatchWaits' -p 1 -parallel 1 -count=1 2>&1 | grep -E \"FAIL:|_test.go:|ok |DATA RACE\" | head -5","description":"Rewrite the 2175 tests for the lock settle","timeout":500000},"caller":{"type":"direct"}}]}}
