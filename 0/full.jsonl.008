rts","+// first and holds it 11-16s; refresh's timeout is shorter, so the tick logged","+// brain_locked, skipped ALL agent work including distill, and did not advance","+// its cursor. 368 of 369 observed brain_locked failures followed a"," // reconciliation queued in the same tick.","-//","-// The ordering is the fix, so the ordering is what is asserted. A test that","-// only checked \"refresh succeeded\" would pass on a lucky schedule.","-func TestWatchWaitsForItsOwnWorkerBeforeRefresh(t *testing.T) {","-\tvar order []string","-\tvar workerRunning atomic.Bool","-\tvar sawOverlap atomic.Bool","+func TestWatchSettlesTheLockBeforeRefresh(t *testing.T) {","+\tdir := t.TempDir()"," ","-\trestore := memoryWorkerRunInline","-\tmemoryWorkerRunInline = func(ctx context.Context, repoDir string) error {","-\t\tworkerRunning.Store(true)","-\t\torder = append(order, \"worker\")","-\t\tworkerRunning.Store(false)","-\t\treturn nil","+\t// Hold the lock, as the worker would.","+\tunlock, err := acquireBrainWriteLockTimeout(dir, time.Second)","+\tif err != nil {","+\t\tt.Fatalf(\"seed the held lock: %v\", err)"," \t}","-\tt.Cleanup(func() { memoryWorkerRunInline = restore })","+\treleased := make(chan struct{})","+\tgo func() {","+\t\ttime.Sleep(300 * time.Millisecond)","+\t\tunlock()","+\t\tclose(released)","+\t}()","+","+\tstart := time.Now()","+\tmemoryWorkerSettle(context.Background(), dir, 5*time.Second)","+\t<-released"," ","-\trefresh := func() {","-\t\tif workerRunning.Load() {","-\t\t\tsawOverlap.Store(true)","-\t\t}","-\t\torder = append(order, \"refresh\")","+\tif elapsed := time.Since(start); elapsed < 250*time.Millisecond {","+\t\tt.Fatalf(\"settle returned in %v while the lock was still held; refresh would hit brain_locked\", elapsed)","+\t}","+\t// And it must actually be free afterwards, not merely waited out.","+\tagain, err := acquireBrainWriteLockTimeout(dir, time.Second)","+\tif err != nil {","+\t\tt.Fatalf(\"the lock is still held after settle: %v\", err)"," \t}","+\tagain()","+}"," ","-\t// Drive the shape the tick has: reconcile (which runs the worker), then","-\t// refresh. With the detached launch these overlapped; inline they cannot.","-\tif err := memoryWorkerRunInline(context.Background(), t.TempDir()); err != nil {","-\t\tt.Fatalf(\"worker: %v\", err)","+// The wait is BOUNDED: a pathological hold must not stall the tick forever.","+// One observed hold ran 2m15s, so the budget has to expire rather than block.","+func TestLockSettleGivesUpWithinItsBudget(t *testing.T) {","+\tdir := t.TempDir()","+\tunlock, err := acquireBrainWriteLockTimeout(dir, time.Second)","+\tif err != nil {","+\t\tt.Fatalf(\"seed the held lock: %v\", err)"," \t}","-\trefresh()","+\tt.Cleanup(unlock)"," ","-\tif sawOverlap.Load() {","-\t\tt.Fatal(\"refresh began while the worker still held the write lock; this is the brain_locked race\")","+\tstart := time.Now()","+\tmemoryWorkerSettle(context.Background(), dir, 600*time.Millisecond)","+\telapsed := time.Since(start)","+\tif elapsed > 5*time.Second {","+\t\tt.Fatalf(\"settle did not respect its budget: waited %v on a lock that is never released\", elapsed)"," \t}","-\tif got := strings.Join(order, \",\"); got != \"worker,refresh\" {","-\t\tt.Fatalf(\"the tick must finish its worker before refresh, got %q\", got)","+}","+","+// A cancelled tick must abandon the wait immediately.","+func TestLockSettleStopsOnContextCancel(t *testing.T) {","+\tdir := t.TempDir()","+\tunlock, err := acquireBrainWriteLockTimeout(dir, time.Second)","+\tif err != nil {","+\t\tt.Fatalf(\"seed the held lock: %v\", err)","+\t}","+\tt.Cleanup(unlock)","+","+\tctx, cancel := context.WithCancel(context.Background())","+\tcancel()","+\tstart := time.Now()","+\tmemoryWorkerSettle(ctx, dir, time.Minute)","+\tif elapsed := time.Since(start); elapsed > 3*time.Second {","+\t\tt.Fatalf(\"a cancelled tick kept waiting for %v\", elapsed)"," \t}"," }"," ","-// TestOnlyWatchWaitsForTheWorker guards the other side: notify and the"