1242-// and a user edit against that blank baseline can overwrite a description they\ncmd/entire/cli/trail_cmd.go-1243-// never saw. Best-effort: on a failed detail fetch it returns the list body\ncmd/entire/cli/trail_cmd.go-1244-// (and no etag) plus the error so the caller can warn (mirroring\ncmd/entire/cli/trail_cmd.go-1245-// runTrailShow); an empty detail body (older/partial server) falls back to the\ncmd/entire/cli/trail_cmd.go-1246-// list body with no error.\ncmd/entire/cli/trail_cmd.go-1247-func resolveTrailUpdateBodyAtPath(ctx context.Context, client *api.Client, basePath string, found *api.TrailResource) (body, etag string, err error) {\ncmd/entire/cli/trail_cmd.go-1248-\tbody = found.Body\ncmd/entire/cli/trail_cmd.go-1249-\tif found.Number > 0 {\ncmd/entire/cli/trail_cmd.go-1250-\t\tbt, et, ferr := fetchTrailDescriptionAtPath(ctx, client, basePath, found.Number)\ncmd/entire/cli/trail_cmd.go-1251-\t\tif ferr != nil {\ncmd/entire/cli/trail_cmd.go-1252-\t\t\treturn body, \"\", ferr\ncmd/entire/cli/trail_cmd.go-1253-\t\t}\ncmd/entire/cli/trail_cmd.go-1254-\t\t// fetchTrailDescription already trims; a non-empty result supersedes\ncmd/entire/cli/trail_cmd.go-1255-\t\t// the list body, an empty one (older/partial server) leaves it intact.\ncmd/entire/cli/trail_cmd.go-1256-\t\t// The etag is kept either way — it describes the document read, not\ncmd/entire/cli/trail_cmd.go-1257-\t\t// the text, so it's valid even when the description is legitimately\ncmd/entire/cli/trail_cmd.go-1258-\t\t// empty (avoids a redundant refetch below).\ncmd/entire/cli/trail_cmd.go-1259-\t\tetag = et","is_error":false}]}}
