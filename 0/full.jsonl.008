"+\tfor i, line := range strings.Split(strings.TrimSuffix(got, \"\\n\"), \"\\n\") {","+\t\tif !strings.HasPrefix(line, \"2026-10-24T09:30:15Z gh/entireio/entire-brain \") {","+\t\t\tt.Fatalf(\"line %d unattributed: %q\", i, line)","+\t\t}","+\t}","+}","+","+// TestWatchLogPrefixReportsCallerLength: a short count makes io.Copy and","+// fmt.Fprintf treat the write as failed, so the prefix must not be counted.","+func TestWatchLogPrefixReportsCallerLength(t *testing.T) {","+\tt.Parallel()","+\tvar buf bytes.Buffer","+\tw := newWatchLogPrefixWriter(&buf, \"repo\", fixedClock(time.Unix(0, 0).UTC()))","+\tpayload := []byte(\"[watch] line\\n\")","+\tn, err := w.Write(payload)","+\tif err != nil {","+\t\tt.Fatalf(\"write: %v\", err)","+\t}","+\tif n != len(payload) {","+\t\tt.Fatalf(\"Write returned %d, want caller length %d\", n, len(payload))","+\t}","+\tif _, err := fmt.Fprintf(w, \"[watch] %s\\n\", \"second\"); err != nil {","+\t\tt.Fatalf(\"Fprintf saw a short write: %v\", err)","+\t}","+}","+","+// TestWatchLogPrefixNoBarePrefixOnTrailingNewline: a newline-terminated write","+// must not emit a stamp with nothing after it.","+func TestWatchLogPrefixNoBarePrefixOnTrailingNewline(t *testing.T) {","+\tt.Parallel()","+\tvar buf bytes.Buffer","+\tw := newWatchLogPrefixWriter(&buf, \"repo\", fixedClock(time.Unix(0, 0).UTC()))","+\tfmt.Fprint(w, \"[watch] only line\\n\")","+\tif got, want := buf.String(), \"1970-01-01T00:00:00Z repo [watch] only line\\n\"; got != want {","+\t\tt.Fatalf(\"got %q want %q\", got, want)","+\t}","+}","+","+// TestWatchLogPrefixDoesNotSplitAPartialLine: a write that ends mid-line is","+// continued, not re-stamped in its middle.","+func TestWatchLogPrefixDoesNotSplitAPartialLine(t *testing.T) {","+\tt.Parallel()","+\tvar buf bytes.Buffer","+\tw := newWatchLogPrefixWriter(&buf, \"repo\", fixedClock(time.Unix(0, 0).UTC()))","+\tfmt.Fprint(w, \"[watch] half\")","+\tfmt.Fprint(w, \" and half\\n\")","+\tfmt.Fprint(w, \"[watch] next\\n\")","+\twant := \"1970-01-01T00:00:00Z repo [watch] half and half\\n\" +","+\t\t\"1970-01-01T00:00:00Z repo [watch] next\\n\"","+\tif got := buf.String(); got != want {","+\t\tt.Fatalf(\"got %q want %q\", got, want)","+\t}","+}","+","+// TestWatchLogPrefixOmitsEmptyRepo: workspace-level lines belong to no repo","+// and must carry the clock alone, with no double space where a key would be.","+func TestWatchLogPrefixOmitsEmptyRepo(t *testing.T) {","+\tt.Parallel()","+\tvar buf bytes.Buffer","+\tw := newWatchLogPrefixWriter(&buf, \"\", fixedClock(time.Unix(0, 0).UTC()))","+\tfmt.Fprint(w, \"[watch] workspace ws — 3 repos\\n\")","+\tif got, want := buf.String(), \"1970-01-01T00:00:00Z [watch] workspace ws — 3 repos\\n\"; got != want {","+\t\tt.Fatalf(\"got %q want %q\", got, want)","+\t}","+}","+","+// TestWatchLogPrefixAdvancesTheClock: the stamp is taken per write, so two","+// writes a minute apart are distinguishable in the log.","+func TestWatchLogPrefixAdvancesTheClock(t *testing.T) {","+\tt.Parallel()","+\tvar buf bytes.Buffer","+\tcur := time.Date(2026, 10, 24, 9, 0, 0, 0, time.UTC)","+\tw := newWatchLogPrefixWriter(&buf, \"repo\", func() time.Time {","+\t\tat := cur","+\t\tcur = cur.Add(time.Minute)","+\t\treturn at","+\t})","+\tfmt.Fprint(w, \"[watch] first\\n\")","+\tfmt.Fprint(w, \"[watch] second\\n\")","+\twant := \"2026-10-24T09:00:00Z repo [watch] first\\n\" +","+\t\t\"2026-10-24T09:01:00Z repo [watch] second\\n\"","+\tif got := buf.String(); got != want {","+\t\tt.Fatalf(\"got %q want %q\", got, want)","+\t}","+}"]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/brain-dp2/internal/cli/watch_log_prefix_test.go"]}},"serverClassifierContext":{"request":"dbee76e6-2f60-4e31-a565-99972b2ac5d6","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-dp2","root":"/Users/suhaan/devenv/brain-dp2","branch":"fix/distill-pipeline-v2","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":4,"untracked":null,"untracked_normal":1},"porce