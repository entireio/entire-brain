 byte count. Returning the prefixed\n// length makes io.Copy and fmt think more was written than was asked for;\n// returning less makes them think the write failed.\nfunc TestWatchLogWriterReportsTheCallersLength(t *testing.T) {\n\tt.Parallel()\n\tvar buf bytes.Buffer\n\tw := newWatchLogPrefixWriter(&buf, \"repo\", fixedNow())\n\tpayload := []byte(\"[watch] tick\\n\")\n\tn, err := w.Write(payload)\n\tif err != nil {\n\t\tt.Fatalf(\"write: %v\", err)\n\t}\n\tif n != len(payload) {\n\t\tt.Fatalf(\"reported %d bytes for a %d-byte write; short counts read as failures\", n, len(payload))\n\t}\n}\nEOF\ngofmt -w internal/cli/watch_log_prefix_test.go && env -u FORCE_COLOR GOMAXPROCS=2 go test ./internal/cli/ -run 'TestWatchLog' -p 1 -parallel 1 -count=1 2>&1 | grep -E \"FAIL:|_test.go:|ok \" | head -5","description":"Test the log prefixer","timeout":400000}},"wireIngestContext":{"toolu_012twq97V8qTtaafTMq5AvxW":{"cwd":"/Users/suhaan/devenv/brain-distill-fix"}},"serverClassifierRequest":"dc9e1567-d413-48d1-9191-bb1b9be0c6f7","apiBlockIndex":0,"requestId":"req_011CgG7KkQ3XiXstgnrwN9P6","requestRef":"4ed3801e-88bf-410f-984a-1465ec463035","requestedModel":"claude-opus-5[1m]","type":"assistant","uuid":"42083bc5-3caa-4ce4-bc28-e21c983fc19c","timestamp":"2026-10-21T21:41:59.635Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":null,"session_id":"60a744a6-1b89-494f-a7de-f94ff9566958","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/brain-distill-fix","sessionId":"93ae8948-c612-4072-8e70-2750e80df9ce","version":"2.1.301","gitBranch":"main","slug":"floofy-discovering-bachman"}
