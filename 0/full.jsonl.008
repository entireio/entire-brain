e\n50-\t\t}\n51-\t\tdata, err := os.ReadFile(name)\n52-\t\tif err != nil {\n53-\t\t\tt.Fatal(err)\n54-\t\t}\n55-\t\tfor number, line := range strings.Split(string(data), \"\\n\") {\n56-\t\t\tscanned++\n57-\t\t\thelperSites += strings.Count(line, \"brainInvocation(\")\n58-\t\t\ttrimmed := strings.TrimSpace(line)\n59-\t\t\tif strings.HasPrefix(trimmed, \"//\") || !hardcodedBrainVerb.MatchString(line) {\n63:\t\t\tfor _, a := range deliberatelyHardcoded {\n64-\t\t\t\tif a.file == name && strings.Contains(line, a.contains) {\n65-\t\t\t\t\tok = true\n66-\t\t\t\t\tallowed++\n67-\t\t\t\t}\n68-\t\t\t}\n69-\t\t\tif !ok {\n70-\t\t\t\tt.Errorf(\"%s:%d hardcodes `entire brain <verb>`; render it with brainInvocation(os.LookupEnv, verb) \"+\n71:\t\t\t\t\t\"or add a reasoned entry to deliberatelyHardcoded: %s\", name, number+1, trimmed)\n72-\t\t\t}\n73-\t\t}\n74-\t}","is_error":false}]}}
