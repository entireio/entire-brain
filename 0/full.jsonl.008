{"parentUuid":"bade2847-4305-4e26-bc1f-6cd3cf73589d","isSidechain":false,"attachment":{"type":"deferred_tools_record","entries":[{"name":"mcp__claude_ai_Linear__list_comments","description":"List comments on a Linear issue, project, initiative, document, project milestone, or project/initiative status update. Provide exactly one of `issueId`, `projectId`, `initiativeId`, `documentId`, `milestoneId`, or `statusUpdateId`. `statusUpdateType` applies only to `statusUpdateId`; omit it for every other parent. For issues, projects, and initiatives this returns both top-level discussion threads and inline description comments. Inline (anchored) comments carry a non-null `quotedText` set to the snippet of description text they reference. Returned comments include `author` and nullable `onBehalfOf`; when set, `onBehalfOf` identifies the user the agent author acted for. Files uploaded in comment bodies are returned in `attachments` with titles and download URLs, not issue attachment IDs. Signed upload URLs expire after five minutes; call list_comments again to refresh them. Download documents using these URLs and process them with your own file tools.","input_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"limit":{"default":50,"description":"Maximum number of results to return per page","type":"number","maximum":250},"cursor":{"description":"Omit for the first page. To continue, pass the previous response's cursor when hasNextPage is true","type":"string"},"orderBy":{"default":"updatedAt","description":"Timestamp to sort results by: creation time or last update time","type":"string","enum":["createdAt","updatedAt"]},"issueId":{"description":"Issue ID or identifier (e.g., LIN-123). P-prefixed identifiers (e.g., P-ENG-123) are projects, not issues (provide exactly one parent)","type":"string"},"projectId":{"description":"Project name, ID, identifier (e.g., P-ENG-123), or slug (provide exactly one parent)","type":"string"},"initiativeId":{"description":"Initiative name, ID, identifier (e.g., I-123), or slug (provide exactly one parent)","type":"string"},"documentId":{"description":"Document ID or slug (provide exactly one parent)","type":"string"},"milestoneId":{"description":"Milestone UUID (provide exactly one parent). Resolve milestone names via `list_milestones` first.","type":"string"},"statusUpdateId":{"description":"Status update UUID (provide exactly one parent). Resolve status updates via `get_status_updates` first.","type":"string"},"statusUpdateType":{"description":"Set only together with `statusUpdateId`; omit for issue, project, initiative, document, and milestone comments. Type of status update named by `statusUpdateId`, as returned by `get_status_updates`. Omit to check both project and initiative status updates.","type":"string","enum":["project","initiative"]}},"additionalProperties":false},"eager_input_streaming":true,"defer_loading":true}]},"type":"attachment","uuid":"5acca2d9-5309-4c8a-8089-b6e9a62edb72","timestamp":"2026-10-24T15:04:23.437Z","session_id":"80327498-7bd2-42a4-985a-9acba8ccaf85","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv","sessionId":"93ae8948-c612-4072-8e70-2750e80df9ce","version":"2.1.310","gitBranch":"main","slug":"floofy-discovering-bachman"}
