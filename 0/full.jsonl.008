{"type":"api-request-blob","sessionId":"93ae8948-c612-4072-8e70-2750e80df9ce","hash":"ec5b8a3993905de9e2c8a2ee628f7fbe5951c3c3364dda483b8cae8f8e20eb83","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"text","text":"Tee guard fired; the queryability guard didn't — it only shows in `--verbose`, so no test reaches it. Extracting it so it's testable rather than claiming unverified coverage:"},{"type":"tool_use","id":"toolu_0131GQ1AZcnB1sNqm75iiWsy","name":"Bash","input":{"command":"cd /Users/suhaan/devenv/brain-ux-a-output && python3 - <<'PY'\nimport pathlib\np = pathlib.Path(\"internal/cli/setup.go\"); s = p.read_text()\nold = '''\tqueryability := \"the brain is queryable now\"\n\tif unavailable := setupUnqueryableCore(components); len(unavailable) > 0 {\n\t\tqueryability = \"no \" + strings.Join(unavailable, \" and no \") + \", so queries have nothing to read for this repo yet\"\n\t}\n'''\nnew = '''\tqueryability := setupQueryabilityClause(components)\n'''\nassert old in s\ns = s.replace(old, new, 1)\n\nanchor = \"func setupUnqueryableCore(\"\nassert anchor in s\nhelper = '''// setupQueryabilityClause is the tail of the Build phase line, and it must\n// never assert queryability this brain does not have.\n//\n// The phase line is `--verbose` output, so it is the one surface that still\n// names the missing SOURCES rather than the lost capability. A brain with no\n// index and no baseline answers nothing about this repository, and saying\n// \"the brain is queryable now\" over it is the sentence this guard removes.\nfunc setupQueryabilityClause(components []setupComponent) string {\n\tunavailable := setupUnqueryableCore(components)\n\tif len(unavailable) == 0 {\n\t\treturn \"the brain is queryable now\"\n\t}\n\treturn \"no \" + strings.Join(unavailable, \" and no \") + \", so queries have nothing to read for this repo yet\"\n}\n\n'''\ns = s.replace(anchor, helper + anchor, 1)\np.write_text(s); print(\"extracted setupQueryabilityClause\")\nPY\ncat >> internal/cli/setup_status_output_truth_test.go <<'EOF'\n\n// TestQueryabilityClauseNeverOverclaims covers the --verbose phase line, which\n// no other test in this file reaches: renderSetupSummaryPlain derives\n// queryability itself, and the whole-run test asserts on the error. Removing\n// the guard left both green, so it is asserted directly here.\nfunc TestQueryabilityClauseNeverOverclaims(t *testing.T) {\n\tt.Parallel()\n\tok := []setupComponent{{Name: brainComponentSeed, State: \"ok\"}, {Name: brainComponentSemantic, State: \"ok\"}}\n\tif got := setupQueryabilityClause(ok); !strings.Contains(got, \"queryable now\") {\n\t\tt.Fatalf(\"a built core is queryable: %q\", got)\n\t}\n\tnone := []setupComponent{\n\t\t{Name: brainComponentSeed, State: \"failed\", Detail: \"dirty_worktree\"},\n\t\t{Name: brainComponentSemantic, State: \"failed\", Detail: \"dirty_worktree\"},\n\t}\n\tgot := setupQueryabilityClause(none)\n\tif strings.Contains(got, \"queryable now\") {\n\t\tt.Fatalf(\"no index and no baseline is not queryable: %q\", got)\n\t}\n\tfor _, want := range []string{\"semantic index\", \"seed baseline\"} {\n\t\tif !strings.Contains(got, \"no \"+want) {\n\t\t\tt.Fatalf(\"the clause must name what is unavailable (%q): %q\", want, got)\n\t\t}\n\t}\n}\nEOF\ngofmt -w internal/cli/ 2>/dev/null; env -u FORCE_COLOR GOMAXPROCS=2 go test ./internal/cli/ -run 'TestQueryabilityClauseNeverOverclaims' -p 1 -parallel 1 -count=1 2>&1 | tail -2","description":"Extract and cover the queryability clause","timeout":400000},"caller":{"type":"direct"}}]}}
