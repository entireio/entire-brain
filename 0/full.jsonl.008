{"type":"api-request-blob","sessionId":"93ae8948-c612-4072-8e70-2750e80df9ce","hash":"cbe946e011685afb4ee9d3f7476b1d431a82f15a8acd09e325d691f46b466b76","message":{"role":"user","content":[{"tool_use_id":"toolu_01VcQVw12vBM3mxTP1r3yYMF","type":"tool_result","content":"origin/main:internal/cli/setup_ui.go:598:func setupNextSteps(brainCmd string, daemonInstalled bool, pendingSessions int, offerConnect bool) []setupui.NextStep {\n---\n598:func setupNextSteps(brainCmd string, daemonInstalled bool, pendingSessions int, offerConnect bool) []setupui.NextStep {\n599-\tcmd := setupBrainCommand(brainCmd)\n600-\tnext := []setupui.NextStep{\n601-\t\t{Command: cmd + \" overview\", Why: \"what this project is\"},\n602-\t\t{Command: cmd + ` brief \"<task>\"`, Why: \"task-shaped context\"},\n603-\t\t{Command: cmd + \" status\", Why: \"backfill progress and daemon health\"},\n604-\t}\n605-\tif pendingSessions > 0 {\n606-\t\tnext = append(next, setupui.NextStep{\n607-\t\t\tCommand: cmd + \" distill\",\n608-\t\t\tWhy:     \"turn \" + strconv.Itoa(pendingSessions) + \" pending session(s) into facts (spends tokens)\",\n609-\t\t})\n610-\t}\n611-\tif offerConnect {\n612-\t\tnext = append(next, setupui.NextStep{\n613-\t\t\tCommand: cmd + \" connect\",\n614-\t\t\tWhy:     \"sync memories with your team (off by default)\",\n615-\t\t})\n616-\t}\n617-\tif daemonInstalled {\n618-\t\tnext = append(next, setupui.NextStep{\n619-\t\t\tCommand: cmd + \" setup --uninstall-daemon\",\n620-\t\t\tWhy:     \"stop and remove the background watcher\",\n621-\t\t})\n622-\t}\n623-\treturn next\n624-}\n625-\n626-// setupConsentOverride maps the flags onto the consent gate. --no-backfill and\n627-// --yes both suppress the prompt; they are the only two ways to answer it\n628-// without a terminal, and --yes is the only one that can answer it YES.\n629-func setupConsentOverride(setupOpts setupCommandOptions) setupui.Override {\n630-\tswitch {\n631-\tcase setupOpts.noBackfill:\n632-\t\treturn setupui.OverrideNo\n633-\tcase setupOpts.yes:\n634-\t\treturn setupui.OverrideYes\n635-\tdefault:\n636-\t\treturn setupui.OverrideNone\n637-\t}\n638-}","is_error":false}]}}
