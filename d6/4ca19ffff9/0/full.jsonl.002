ion']=='admission': votes[v['packet_id']].append(s['raw_score']['should_admit'])\nstats=collections.Counter(); examples={}\nfor pid, admitted in pack.items():\n vs=votes[pid]; c=collections.Counter(x for x in vs if x in ('yes','no'))\n maj='tie' if c['yes']==c['no'] else ('yes' if c['yes']>c['no'] else 'no')\n corr=None if maj=='tie' else ((maj=='yes')==admitted)\n key=(len(vs), tuple(sorted(vs)), maj, corr)\n stats[key]+=1; examples.setdefault(key,pid)\nfor k,n in sorted(stats.items(), key=lambda x:(-x[1],str(x[0]))): print(n,k)\nPY"}],"source":"unified_exec_startup","status":"completed","stdout":"452 (3, ('no', 'no', 'no'), 'no', True)\n68 (3, ('no', 'no', 'yes'), 'no', False)\n44 (3, ('no', 'no', 'no'), 'no', False)\n40 (3, ('no', 'yes', 'yes'), 'yes', True)\n25 (2, ('no', 'no'), 'no', True)\n23 (3, ('yes', 'yes', 'yes'), 'yes', True)\n20 (3, ('no', 'no', 'unclear'), 'no', False)\n15 (3, ('no', 'unclear', 'yes'), 'tie', None)\n12 (3, ('no', 'no', 'yes'), 'no', True)\n8 (3, ('no', 'no', 'unclear'), 'no', True)\n4 (2, ('no', 'no'), 'no', False)\n4 (3, ('unclear', 'yes', 'yes'), 'yes', True)\n2 (2, ('yes', 'yes'), 'yes', True)\n1 (2, ('no', 'unclear'), 'no', False)\n1 (3, ('no', 'yes', 'yes'), 'yes', False)\n","stderr":"","aggregated_output":"452 (3, ('no', 'no', 'no'), 'no', True)\n68 (3, ('no', 'no', 'yes'), 'no', False)\n44 (3, ('no', 'no', 'no'), 'no', False)\n40 (3, ('no', 'yes', 'yes'), 'yes', True)\n25 (2, ('no', 'no'), 'no', True)\n23 (3, ('yes', 'yes', 'yes'), 'yes', True)\n20 (3, ('no', 'no', 'unclear'), 'no', False)\n15 (3, ('no', 'unclear', 'yes'), 'tie', None)\n12 (3, ('no', 'no', 'yes'), 'no', True)\n8 (3, ('no', 'no', 'unclear'), 'no', True)\n4 (2, ('no', 'no'), 'no', False)\n4 (3, ('unclear', 'yes', 'yes'), 'yes', True)\n2 (2, ('yes', 'yes'), 'yes', True)\n1 (2, ('no', 'unclear'), 'no', False)\n1 (3, ('no', 'yes', 'yes'), 'yes', False)\n","exit_code":0,"duration":{"secs":0,"nanos":29621875},"formatted_output":"452 (3, ('no', 'no', 'no'), 'no', True)\