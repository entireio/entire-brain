on batch in a full-screen terminal workspace. It isolates the exact statement the automatic filter judged, shows that statement first, and keeps surrounding conversation hidden unless you press `c`. Copilot, Cursor, and Claude appear as compact advisory answers with no human choice preselected. For each statement, answer whether it is potential long-term project knowledge, whether it has human authority, and whether its source is safe; use `y`, `n`, or `u`. Scroll with `j`/`k` or the arrow keys, use `p` for extra judge explanations, `x` to skip, `q` to stop, and `?` for help. A decision is written only after the confirmation step; every confirmed answer is saved immediately and the same command resumes without repeating it. Use `--plain` for the line-oriented accessibility or non-TTY fallback.\\n\\n\")\n+\tout.WriteString(\"The default is a balanced 20-item calibration batch in a full-screen terminal workspace. It isolates the exact statement the automatic filter judged, shows that statement first, and keeps surrounding conversation hidden unless you press `c`. Copilot, Cursor, and Claude appear as compact advisory answers with no human choice preselected. For each statement, answer whether it should be remembered for future project work, whether the user said or explicitly approved it, and whether it is safe evidence rather than one-off or generated material. Use `y`, `n`, or `u` directly, or choose with left/right and submit with Enter. Up/down scrolls; `p` shows extra judge explanations, `x` skips, `q` stops, and `?` opens help. A decision is written only after the confirmation step; every confirmed answer is saved immediately and the same command resumes without repeating it. Use `--plain` for the line-oriented accessibility or non-TTY fallback.\\n\\n\")\n \tfmt.Fprintf(&out, \"Run `%s` contains %d packets: %d critical, %d with judge disagreement, %d with invalid judge output, and %d with missing judges. These are attention-routing counts, not human error labels.\\n\\n\", manifest.RunID, result.Packets, result.Critical, result.Disagreement, result.Invalid, result.MissingJudges)\n \tout.WriteString(\"After calibration, continue in bounded sessions with `--queue critical|invalid|disagreement|clean|all --limit 1..100`. Model consensus never supplies a default decision.\\n\\n\")\n \tout.WriteString(\"The exhaustive evidence trail is in [`human-review-audit.md`](human-review-audit.md). It exists for audit and spot-checking; it is not a linear review task.\\n\")\ndiff --git a/internal/tui/quality_review.go b/internal/tui/quality_review.go\nindex d61c6bec..104badfa 100644\n--- a/internal/tui/quality_review.go\n+++ b/internal/tui/quality_review.go\n@@ -173,6 +173,7 @@ type QualityReviewModel struct {\n \thelp     bool\n \tcontext  bool\n \tdetails  bool\n+\tanswer   int\n \n \tviewport      viewport.Model\n \trationale     textinput.Model\n@@ -192,6 +193,7 @@ func NewQualityReviewModel(review QualityReview, theme Theme, save QualityReview\n \t\treview:    review,\n \t\ttheme:     theme,\n \t\tsave:      save,\n+\t\tanswer:    -1,\n \t\tviewport:  viewport.New(70, 20),\n \t\trationale: ti,\n \t\twidth:     100,\n@@ -258,10 +260,8 @@ func (m QualityReviewModel) Update(msg tea.Msg) (tea.Model, tea.Cmd) {\n \t\t\tm.advanceSkipped()\n \t\t\treturn m, nil\n \t\t}\n-\t\tif isQualityScroll(msg) {\n-\t\t\tvar cmd tea.Cmd\n-\t\t\tm.viewport, cmd = m.viewport.Update(msg)\n-\t\t\treturn m, cmd\n+\t\tif applyQualityScroll(&m.viewport, msg) {\n+\t\t\treturn m, nil\n \t\t}\n \t\treturn m.updateDecision(msg)\n \t}\n@@ -290,18 +290,43 @@ func (m QualityReviewModel) updateRationale(msg tea.KeyMsg) (tea.Model, tea.Cmd)\n \n func (m QualityReviewModel) updateDecision(msg tea.KeyMsg) (tea.Model, tea.Cmd) {\n \tkey := msg.String()\n+\tif m.stage == qualityReviewAdmission || m.stage == qualityReviewAuthority || m.stage == qualityReviewSafety {\n+\t\tswitch msg.Type {\n+\t\tcase tea.KeyLeft:\n+\t\t\tif m.answer < 0 {\n+\t\t\t\tm.answer = 2\n+\t\t\t} else {\n+\t\t\t\tm.answer = (m.answer + 2) % 3\n+\t\t\t}\n+\t\t\treturn m, nil\n+\t\tcase tea.KeyRight:\n+\t\t\tif m.answer < 0 {\n+\t\t\t\tm.answer = 0\n+\t\t\t} else {\n+\t\t\t\tm.answer = (m.answer + 1) % 3\n+\t\t\t}\n+\t\t\treturn m, nil\n+\t\tcase tea.KeyEnter:\n+\t\t\tif m.answer >= 0 {\n+\t\t\t\tkey = []string{\"y\", \"n\", \"u\"}[m.answer]\n+\t\t\t}\n+\t\t}\n+\t}\n \tswitch m.stage {\n \tcase qualityReviewAdmission:\n \t\tif answer, ok := qualityAnswerForKey(key); ok {\n \t\t\tm.decision.Admission, m.stage = answer, qualityReviewAuthority\n+\t\t\tm.answer = -1\n \t\t}\n \tcase qualityReviewAuthority:\n \t\tif answer, ok := qualityAnswerForKey(key); ok {\n \t\t\tm.decision.Authority, m.stage = answer, qualityReviewSafety\n+\t\t\tm.answer = -1\n \t\t}\n \tcase qualityReviewSafety:\n \t\tif answer, ok := qualityAnswerForKey(key); ok {\n \t\t\tm.decision.Safety, m.stage = answer, qualityReviewRationaleChoice\n+\t\t\tm.answer = -1\n \t\t}\n \tcase qualityReviewRationaleChoice:\n \t\tswitch {\n@@ -370,6 +395,7 @@ func (m *QualityReviewModel) resetDecision() {\n \tm.rationale.SetValue(\"\")\n \tm.context = false\n \tm.details = false\n+\tm.answer = -1\n \tm.viewport.GotoTop()\n \tif m.position >= len(m.review.Items) {\n \t\tm.stage = qualityReviewDone\n@@ -386,9 +412,21 @@ func (m QualityReviewModel) current() QualityReviewItem {\n \treturn QualityReviewItem{}\n }\n \n-func isQualityScroll(msg tea.KeyMsg) bool {\n-\tkey := msg.String()\n-\tif key != \"up\" && key != \"k\" && key != \"down\" && key != \"j\" && key != \"pgup\" && key != \"pgdown\" && key != \"home\" && key != \"end\" {\n+func applyQualityScroll(model *viewport.Model, msg tea.KeyMsg) bool {\n+\tswitch msg.String() {\n+\tcase \"up\", \"k\":\n+\t\tmodel.LineUp(1)\n+\tcase \"down\", \"j\":\n+\t\tmodel.LineDown(1)\n+\tcase \"pgup\":\n+\t\tmodel.ViewUp()\n+\tcase \"pgdown\", \" \":\n+\t\tmodel.ViewDown()\n+\tcase \"home\":\n+\t\tmodel.GotoTop()\n+\tcase \"end\":\n+\t\tmodel.GotoBottom()\n+\tdefault:\n \t\tretu