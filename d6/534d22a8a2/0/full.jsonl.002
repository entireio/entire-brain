{"timestamp":"2026-09-19T17:38:40.330Z","ordinal":7462,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","item":{"type":"CommandExecution","id":"exec-08a3ed34-4a69-4d5f-8320-39e2d491e98d","process_id":"88491","command":["/bin/zsh","-lc","sed -n '471,970p' benchmarks/agent-brain/confirmatory/offline_relevance_eval.py"],"cwd":"file:///Users/thomi/.codex/worktrees/5d33/entire-brain","parsed_cmd":[{"type":"read","cmd":"sed -n '471,970p' benchmarks/agent-brain/confirmatory/offline_relevance_eval.py","name":"offline_relevance_eval.py","path":"benchmarks/agent-brain/confirmatory/offline_relevance_eval.py"}],"source":"unified_exec_startup","status":"completed","stdout":"            raise EvaluationError(\"fixture null_query must be boolean\")\n        cutoff_text, cutoff = _timestamp(\n            item.get(\"temporal_cutoff\"), f\"fixture item[{index}].temporal_cutoff\"\n        )\n        excluded_raw = _array(\n            item.get(\"exclude_session_ids\"), f\"fixture item[{index}].exclude_session_ids\"\n        )\n        excluded = [\n            _safe_id(value, f\"fixture item[{index}] excluded session\")\n            for value in excluded_raw\n        ]\n        if excluded != sorted(set(excluded)):\n            raise EvaluationError(\"fixture excluded session IDs are not canonical\")\n        by_id[query_id] = {\n            \"query_id\": query_id,\n            \"task_id\": _safe_id(item.get(\"task_id\"), f\"fixture item[{index}].task_id\"),\n            \"query_source\": source,\n            \"null_query\": item[\"null_query\"],\n            \"temporal_cutoff\": cutoff_text,\n            \"cutoff\": cutoff,\n            \"exclude_session_ids\": excluded,\n        }\n        order.append(query_id)\n    if not order:\n        raise EvaluationError(\"fixture must contain queries\")\n    return by_id, order\n\n\ndef _validate_dataset(value: Any, fixture_index: dict[str, Any], fixture_order: list[str]) -> dict[str, Any]:\n    dataset = _object(value, \"dataset\")\n    if dataset.get(\"schema_version\") != 2:\n        raise EvaluationError(\"dataset schema_version must be 2\")\n    _safe_id(dataset.get(\"dataset_id\"), \"dataset_id\")\n    development = _object(dataset.get(\"development\"), \"dataset development\")\n    items = _array(development.get(\"items\"), \"dataset development items\")\n    by_id: dict[str, dict[str, Any]] = {}\n    order: list[str] = []\n    product_answerable = product_null = oracle = 0\n    for index, raw in enumerate(items):\n        item = _object(raw, f\"dataset item[{index}]\")\n        query_id = _safe_id(item.get(\"query_id\"), f\"dataset item[{index}].query_id\")\n        if query_id in by_id:\n            raise EvaluationError(\"dataset contains duplicate query IDs\")\n        fixture_item = fixture_index.get(query_id)\n        if fixture_item is None:\n            raise EvaluationError(\"dataset query set differs from fixture\")\n        task_id = _safe_id(item.get(\"task_id\"), f\"dataset item[{index}].task_id\")\n        source = item.get(\"query_source\")\n        null_query = item.get(\"null_query\")\n        if source not in QUERY_SOURCES or not isinstance(null_query, bool):\n            raise EvaluationError(\"dataset query metadata is malformed\")\n        if (\n            task_id != fixture_item[\"task_id\"]\n            or source != fixture_item[\"query_source\"]\n            or null_query != fixture_item[\"null_query\"]\n        ):\n            raise EvaluationError(\"dataset query metadata differs from fixture\")\n        judgments_raw = _array(item.get(\"judgments\"), f\"dataset item[{index}].judgments\")\n        judgments: dict[str, dict[str, Any]] = {}\n        positives: set[str] = set()\n        for judgment_index, raw_judgment in enumerate(judgments_raw):\n            judgment = _object(\n                raw_judgment, f\"dataset item[{index}].judgment[{judgment_index}]\"\n            )\n            fact_id = _safe_id(\n                judgment.get(\"fact_id\"),\n                f\"dataset item[{index}].judgment[{judgment_index}].fact_id\",\n            )\n            if fact_id in judgments:\n                raise EvaluationError(\"dataset contains duplicate judgment fact IDs\")\n            grade = judgment.get(\"grade\")\n            if grade not in GRADE_WEIGHTS:\n                raise EvaluationError(\"dataset contains an unknown relevance grade\")\n            normalized = {\n                \"fact_id\": fact_id,\n                \"fact_sha256\": _external_sha256(\n                    judgment.get(\"fact_sha256\"),\n                    f\"dataset item[{index}].judgment[{judgment_index}].fact_sha256\",\n                ),\n                \"grade\": grade,\n                \"kind\": _safe_id(\n                    judgment.get(\"kind\"),\n                    f\"dataset item[{index}].judgment[{judgment_index}].kind\",\n                ),\n                \"cluster_id\": _safe_id(\n                    judgment.get(\"cluster_id\"),\n                    f\"dataset item[{index}].judgment[{judgment_index}].cluster_id\",\n                ),\n            }\n            judgments[fact_id] = normalized\n            if grade in POSITIVE_GRADES:\n                positives.add(fact_id)\n        if null_query and positives:\n            raise EvaluationError(\"null query contains a positive judgment\")\n        if not null_query and not positives:\n            raise EvaluationError(\"answerable query contains no positive judgment\")\n        if source == \"user_prompt_derived\":\n            if null_query:\n                product_null += 1\n            else:\n                product_answerable += 1\n        else:\n            oracle += 1\n        by_id[query_id] = {\n            \"query_id\": query_id,\n            \"task_id\": task_id,\n            \"query_source\": source,\n            \"null_query\": null_query,\n            \"judgments\": judgments,\n            \"positive_ids\": positives,\n        }\n        order.append(query_id)\n    if order != fixture_order:\n        raise EvaluationError(\"dataset query order differs from fixture\")\n    if product_answerable == 0 or product_null == 0 or oracle == 0:\n        raise EvaluationError(\n            \"dataset must contain answerable product, corpus-closed product-null, and oracle queries\"\n        )\n    return {\"items\": by_id, \"order\": order}\n\n\ndef _eligible(\n    fact: dict[str, Any], fixture_item: dict[str, Any], session_dates: dict[str, int]\n) -> bool:\n    if fact[\"status\"] != \"active\" or not fact[\"provenance_session_ids\"]:\n        return False\n    excluded = set(fixture_item[\"exclude_session_ids\"])\n    cutoff = fixture_item[\"cutoff\"]\n    for session_id in fact[\"provenance_session_ids\"]:\n        if session_id in excluded:\n            return False\n        created = session_dates.get(session_id)\n        if created is None or not created < cutoff:\n            return False\n    return True\n\n\ndef _validate_judgment_eligibility(\n    dataset: dict[str, Any],\n    fixture_index: dict[str, Any],\n    membership: dict[str, Any],\n) -> None:\n    for query_id in dataset[\"order\"]:\n        fixture_item = fixture_index[query_id]\n        for fact_id in dataset[\"items\"][query_id][\"judgments\"]:\n            judgment = dataset[\"items\"][query_id][\"judgments\"][fact_id]\n            fact = membership[\"fact_index\"].get(fact_id)\n            if fact is None:\n                raise EvaluationError(\"dataset judgment is absent from source membership\")\n            if judgment[\"fact_sha256\"] != fact[\"fact_sha256\"]:\n                raise EvaluationError(\n                    \"dataset judgment fact SHA-256 differs from source membership\"\n                )\n            if not _eligible(fact, fixture_item, membership[\"session_dates\"]):\n                raise EvaluationError(\n                    \"dataset judgment is outside authenticated temporal eligibility\"\n                )\n\n\ndef _build_input_bindings(\n    engine_matrix_raw: bytes,\n    engine_matrix: dict[str, Any],\n    engine_pins_raw: bytes,\n    engine_pins: dict[str, Any],\n    producer_identity_raw: bytes,\n    producer_identity: dict[str, Any],\n    fixture: dict[str, Any],\n    dataset_raw: bytes,\n    dataset: dict[str, Any],\n    membership_raw: bytes,\n    membership: dict[str, Any],\n) -> dict[str, Any]:\n    return {\n        \"engine_matrix_sha256\": sha256_bytes(engine_matrix_raw),\n        \"matrix_id\": _safe_id(engine_matrix.get(\"matrix_id\"), \"matrix_id\"),\n        \"engine_pins_sha256\": sha256_bytes(engine_pins_raw),\n        \"pin_set_id\": _safe_id(engine_pins.get(\"pin_set_id\"), \"pin_set_id\"),\n        \"fixture_sha256\": _sha256(fixture.get(\"fixture_sha256\"), \"fixture_sha256\"),\n        \"fixture_id\": _safe_id(fixture.get(\"fixture_id\"), \"fixture_id\"),\n        \"dataset_sha256\": sha256_bytes(dataset_raw),\n        \"dataset_id\": _safe_id(dataset.get(\"dataset_id\"), \"dataset_id\"),\n        \"source_membership_sha256\": sha256_bytes(membership_raw),\n        \"eligibility_membership_root_sha256\": _sha256(\n            membership.get(\"eligibility_membership_root_sha256\"),\n            \"eligibility membership root\",\n        ),\n        \"producer_identity_file_sha256\": sha256_bytes(producer_identity_raw),\n        \"producer_identity_sha256\": producer_identity[\"producer_identity_sha256\"],\n        \"k_candidates\": list(K_CANDIDATES),\n    }\n\n\ndef _validate_input_bindings(value: Any) -> dict[str, Any]:\n    bindings = _object(value, \"ranked run input bindings\")\n    _exact_fields(bindings, INPUT_BINDING_FIELDS, \"ranked run input bindings\")\n    for field in INPUT_BINDING_SHA_FIELDS:\n        _external_sha256(bindings.get(field), f\"ranked run input binding {field}\")\n    for field in INPUT_BINDING_SELF_HASH_FIELDS:\n        _sha256(bindings.get(field), f\"ranked run input binding {field}\")\n    for field in (\"matrix_id\", \"pin_set_id\", \"fixture_id\", \"dataset_id\"):\n        _safe_id(bindings.get(field), f\"ranked run input binding {field}\")\n    if bindings.get(\"k_candidates\") != list(K_CANDIDATES):\n        raise EvaluationError(\"ranked run input binding K candidates differ\")\n    return copy.deepcopy(bindings)\n\n\ndef _validate_producer_identity(value: Any) -> dict[str, Any]:\n    identity = _object(value, \"producer identity\")\n    _exact_fields(identity, PRODUCER_IDENTITY_FIELDS, \"producer identity\")\n    if (\n        identity.get(\"schema_version\") != SCHEMA_VERSION\n        or identity.get(\"schema\") != PRODUCER_IDENTITY_SCHEMA\n    ):\n        raise EvaluationError(\"producer identity schema is invalid\")\n    _safe_id(identity.get(\"producer_id\"), \"producer identity producer_id\")\n    for field in (\"runner_sha256\", \"producer_code_sha256\"):\n        _external_sha256(identity.get(field), f\"producer identity {field}\")\n    for policy in (\"ranking_result_metadata\", \"token_estimation\", \"serialization\"):\n        _safe_id(\n            identity.get(f\"{policy}_policy_id\"),\n            f\"producer identity {policy}_policy_id\",\n        )\n        _external_sha256(\n            identity.get(f\"{policy}_policy_sha256\"),\n            f\"producer identity {policy}_policy_sha256\",\n        )\n    supplied_hash = _sha256(\n        identity.get(\"producer_identity_sha256\"), \"producer identity self-hash\"\n    )\n    if _self_hash(identity, \"producer_identity_sha256\") != supplied_hash:\n        raise EvaluationError(\"producer identity self-hash mismatch\")\n    return copy.deepcopy(identity)\n\n\ndef _engine_arms(engine_matrix: dict[str, Any]) -> tuple[list[str], dict[str, dict[str, Any]]]:\n    arms_value = _array(engine_matrix.get(\"arms\"), \"engine matrix arms\")\n    order: list[str] = []\n    by_id: dict[str, dict[str, Any]] = {}\n    for index, raw in enumerate(arms_value):\n        arm = _object(raw, f\"engine matrix arm[{index}]\")\n        arm_id = _safe_id(arm.get(\"id\"), f\"engine matrix arm[{index}].id\")\n        if arm_id in by_id:\n            raise EvaluationError(\"engine matrix contains duplicate arm IDs\")\n        semantic = arm.get(\"semantic\")\n        if not isinstance(semantic, bool):\n            raise EvaluationError(\"engine matrix arm semantic must be boolean\")\n        by_id[arm_id] = {\n            \"id\": arm_id,\n            \"semantic\": semantic,\n            \"effective_engine_required\": _safe_id(\n                arm.get(\"effective_engine_required\"), \"effective engine requirement\"\n            ),\n            \"namespace\": _safe_id(arm.get(\"namespace\"), \"engine namespace\"),\n        }\n        order.append(arm_id)\n    if not order:\n        raise EvaluationError(\"engine matrix must contain arms\")\n    return order, by_id\n\n\ndef _validate_engine_identity(\n    value: Any,\n    arm_contracts: dict[str, dict[str, Any]],\n    engine_pins: dict[str, Any],\n) -> dict[str, Any]:\n    identity = _object(value, \"engine identity\")\n    _exact_fields(identity, ENGINE_IDENTITY_FIELDS, \"engine identity\")\n    arm_id = _safe_id(identity.get(\"arm_id\"), \"engine identity arm_id\")\n    contract = arm_contracts.get(arm_id)\n    if contract is None:\n        raise EvaluationError(\"engine identity arm is absent from the matrix\")\n    if identity.get(\"effective_engine\") != contract[\"effective_engine_required\"]:\n        raise EvaluationError(\"effective engine differs from matrix\")\n    if identity.get(\"semantic\") is not contract[\"semantic\"]:\n        raise EvaluationError(\"semantic identity differs from matrix\")\n    if identity.get(\"vector_namespace\") != contract[\"namespace\"]:\n        raise EvaluationError(\"vector namespace differs from matrix\")\n    if identity.get(\"fallback_used\") is not False:\n        raise EvaluationError(\"engine fallback invalidates the ranked run\")\n    binary = _object(engine_pins.get(\"binary\"), \"engine pins binary\")\n    identity_binary_sha256 = _external_sha256(\n        identity.get(\"binary_sha256\"), \"engine identity binary_sha256\"\n    )\n    if identity_binary_sha256 != _external_sha256(\n        binary.get(\"binary_sha256\"), \"pinned binary\"\n    ):\n        raise EvaluationError(\"binary identity differs from engine pins\")\n    if identity.get(\"binary_size_bytes\") != _positive_int(\n        binary.get(\"binary_size_bytes\"), \"pinned binary size\"\n    ):\n        raise EvaluationError(\"binary size differs from engine pins\")\n    engines = _object(engine_pins.get(\"engines\"), \"engine pins engines\")\n    pinned_engine = _object(engines.get(arm_id), \"pinned engine identity\")\n    dimension = pinned_engine.get(\"dimension\")\n    if contract[\"semantic\"]:\n        _external_sha256(\n            identity.get(\"vector_artifact_sha256\"), \"vector artifact SHA-256\"\n        )\n        _positive_int(identity.get(\"vector_artifact_size_bytes\"), \"vector artifact size\")\n        if identity.get(\"embedding_dimension\") != _positive_int(\n            dimension, \"pinned embedding dimension\"\n        ):\n            raise EvaluationError(\"embedding dimension differs from engine pins\")\n    elif any(\n        identity.get(field) is not None\n        for field in (\n            \"vector_artifact_sha256\",\n            \"vector_artifact_size_bytes\",\n            \"embedding_dimension\",\n        )\n    ):\n        raise EvaluationError(\"lexical engine must not claim a vector artifact\")\n    return copy.deepcopy(identity)\n\n\ndef _validate_telemetry(\n    value: Any,\n    *,\n    active_count: int,\n    eligible_count: int,\n    delivered_count: int,\n) -> dict[str, Any]:\n    telemetry = _object(value, \"query telemetry\")\n    _exact_fields(telemetry, TELEMETRY_FIELDS, \"query telemetry\")\n    if _nonnegative_int(telemetry.get(\"active_fact_count\"), \"active_fact_count\") != active_count:\n        raise EvaluationError(\"query active_fact_count differs from membership\")\n    if (\n        _nonnegative_int(telemetry.get(\"eligible_fact_count\"), \"eligible_fact_count\")\n        != eligible_count\n    ):\n        raise EvaluationError(\"query eligible_fact_count differs from temporal policy\")\n    if (\n        _nonnegative_int(\n            telemetry.get(\"temporal_exclusion_count\"), \"temporal_exclusion_count\"\n        )\n        != active_count - eligible_count\n    ):\n        raise EvaluationError(\"query temporal exclusion count differs\")\n    if (\n        _nonnegative_int(telemetry.get(\"delivered_count\"), \"delivered_count\")\n        != delivered_count\n    ):\n        raise EvaluationError(\"query delivered_count differs from ordered results\")\n    latency = _finite_nonnegative(telemetry.get(\"ranking_latency_ms\"), \"ranking_latency_ms\")\n    result = copy.deepcopy(telemetry)\n    result[\"ranking_latency_ms\"] = latency\n    return result\n\n\ndef _validate_run(\n    value: Any,\n    *,\n    expected_bindings: dict[str, Any],\n    expected_producer_identity: dict[str, Any],\n    engine_matrix: dict[str, Any],\n    engine_pins: dict[str, Any],\n    fixture_index: dict[str, Any],\n    fixture_order: list[str],\n    dataset_index: dict[str, Any],\n    membership: dict[str, Any],\n) -> dict[str, Any]:\n    run = _object(value, \"ranked run\")\n    _exact_fields(run, RUN_FIELDS, \"ranked run\")\n    if run.get(\"schema_version\") != SCHEMA_VERSION or run.get(\"schema\") != RANKED_RUN_SCHEMA:\n        raise EvaluationError(\"ranked run schema identity is invalid\")\n    run_id = _safe_id(run.get(\"run_id\"), \"run_id\")\n    _timestamp(run.get(\"created_at\"), \"ranked run created_at\")\n    supplied_hash = _sha256(run.get(\"run_sha256\"), \"run_sha256\")\n    if _self_hash(run, \"run_sha256\") != supplied_hash:\n        raise EvaluationError(\"ranked run self-hash mismatch\")\n    bindings = _validate_input_bindings(run.get(\"input_bindings\"))\n    if bindings != expected_bindings:\n        raise EvaluationError(\"ranked run input bindings differ from authenticated inputs\")\n    if run.get(\"k_candidates\") != list(K_CANDIDATES):\n        raise EvaluationError(\"ranked run K candidates differ from the frozen contract\")\n    aggregation = run.get(\"aggregation_rule\")\n    if aggregation not in AGGREGATION_CANDIDATES:\n        raise EvaluationError(\"ranked run aggregation rule is unsupported\")\n    producer_identity = _validate_producer_identity(run.get(\"producer_identity\"))\n    if producer_identity != expected_producer_identity:\n        raise EvaluationError(\n            \"ranked run producer identity differs from bound producer contract\"\n        )\n    _, arm_contracts = _engine_arms(engine_matrix)\n    identity = _validate_engine_identity(run.get(\"engine_identity\"), arm_contracts, engine_pins)\n    query_values = _array(run.get(\"queries\"), \"ranked run queries\")\n    if len(query_values) != len(fixture_order):\n        raise EvaluationError(\"ranked run query count differs from fixture\")\n    queries: list[dict[str, Any]] = []\n    seen_queries: set[str] = set()\n    membership_index = membership[\"fact_index\"]\n    for index, raw in enumerate(query_values):\n        query = _object(raw, f\"ranked run query[{index}]\")\n        _exact_fields(query, QUERY_FIELDS, f\"ranked run query[{index}]\")\n        query_id = _safe_id(query.get(\"query_id\"), f\"ranked run query[{index}].query_id\")\n        if query_id in seen_queries:\n            raise EvaluationError(\"ranked run contains duplicate query IDs\")\n        seen_queries.add(query_id)\n        if query_id != fixture_order[index]:\n            raise EvaluationError(\"ranked run query order differs from fixture\")\n        fixture_item = fixture_index[query_id]\n        dataset_item = dataset_index[query_id]\n        if (\n            query.get(\"task_id\") != fixture_item[\"task_id\"]\n            or query.get(\"query_source\") != fixture_item[\"query_source\"]\n            or query.get(\"null_query\") is not fixture_item[\"null_query\"]\n        ):\n            raise EvaluationError(\"ranked run query metadata differs from fixture\")\n        eligible_ids = {\n            fact[\"fact_id\"]\n            for fact in membership[\"facts\"]\n            if _eligible(fact, fixture_item, membership[\"session_dates\"])\n        }\n        results_raw = _array(query.get(\"ordered_results\"), \"ordered results\")\n        if len(results_raw) > max(K_CANDIDATES):\n            raise EvaluationError(\"ranked run retains more results than the maximum K\")\n        results: list[dict[str, Any]] = []\n        seen_facts: set[str] = set()\n        for result_index, raw_result in enumerate(results_raw):\n            result = _object(raw_result, f\"ordered result[{result_index}]\")\n            _exact_fields(result, RESULT_FIELDS, f\"ordered result[{result_index}]\")\n            fact_id = _safe_id(result.get(\"fact_id\"), f\"ordered result[{result_index}].fact_id\")\n            if fact_id in seen_facts:\n                raise EvaluationError(\"ranked run contains duplicate result fact IDs\")\n            seen_facts.add(fact_id)\n            fact = membership_index.get(fact_id)\n            if fact is None:\n                raise EvaluationError(\"ranked run result is absent from source membership\")\n            fact_sha256 = _external_sha256(\n                result.get(\"fact_sha256\"),\n                f\"ordered result[{result_index}].fact_sha256\",\n            )\n            if fact_sha256 != fact[\"fact_sha256\"]:\n                raise EvaluationError(\n                    \"ranked result fact SHA-256 differs from source membership\"\n                )\n            derived_eligible = fact_id in eligible_ids\n            if result.get(\"eligible\") is not derived_eligible:\n                raise EvaluationError(\"ranked result eligibility differs from authenticated policy\")\n            if not derived_eligible:\n                raise EvaluationError(\"ranked run contains temporal leakage\")\n            kind = _safe_id(result.get(\"kind\"), f\"ordered result[{result_index}].kind\")\n            cluster_id = _safe_id(\n                result.get(\"cluster_id\"), f\"ordered result[{result_index}].cluster_id\"\n            )\n            judgment = dataset_item[\"judgments\"].get(fact_id)\n            if judgment is not None and (\n                judgment[\"kind\"] != kind or judgment[\"cluster_id\"] != cluster_id\n            ):\n                raise EvaluationError(\"ranked result metadata differs from reviewed judgment\")\n            results.append(\n                {\n                    \"fact_id\": fact_id,\n                    \"fact_sha256\": fact_sha256,\n                    \"kind\": kind,\n                    \"cluster_id\": cluster_id,\n                    \"eligible\": True,\n                    \"estimated_tokens\": _positive_int(\n                        result.get(\"estimated_tokens\"),\n                        f\"ordered result[{result_index}].estimated_tokens\",\n                    ),\n                }\n            )\n        telemetry = _validate_telemetry(\n            query.get(\"telemetry\"),\n            active_count=membership[\"active_fact_count\"],\n            eligible_count=len(eligible_ids),\n            delivered_count=len(results),\n        )\n        queries.append(\n            {\n                \"query_id\": query_id,\n                \"task_id\": fixture_item[\"task_id\"],\n                \"query_source\": fixture_item[\"query_source\"],\n                \"null_query\": fixture_item[\"null_query\"],\n                \"telemetry\": telemetry,\n                \"ordered_results\": results,\n            }\n        )\n    return {\n        \"schema_version\": SCHEMA_VERSION,\n        \"schema\": RANKED_RUN_SCHEMA,\n        \"run_id\": run_id,\n        \"created_at\": run[\"created_at\"],\n        \"input_bindings\": copy.deepcopy(bindings),\n        \"producer_identity\": producer_identity,\n        \"engine_identity\": identity,\n        \"aggregation_rule\": aggregation,\n        \"k_candidates\": list(K_CANDIDATES),\n        \"queries\": queries,\n        \"run_sha256\": supplied_hash,\n    }\n\n\ndef _recall(results: list[dict[str, Any]], positives: set[str], cutoff: int) -> float:\n    if not positives:\n        return 0.0\n    hits = {result[\"fact_id\"] for result in results[:cutoff]} & positives\n    return _ratio(len(hits), len(positives))\n\n","stderr":"","aggregated_output":"            raise EvaluationError(\"fixture null_query must be boolean\")\n        cutoff_text, cutoff = _timestamp(\n            item.get(\"temporal_cutoff\"), f\"fixture item[{index}].temporal_cutoff\"\n        )\n        excluded_raw = _array(\n            item.get(\"exclude_session_ids\"), f\"fixture item[{index}].exclude_session_ids\"\n        )\n        excluded = [\n            _safe_id(value, f\"fixture item[{index}] excluded session\")\n            for value in excluded_raw\n        ]\n        if excluded != sorted(set(excluded)):\n            raise EvaluationError(\"fixture excluded session IDs are not canonical\")\n        by_id[query_id] = {\n            \"query_id\": query_id,\n            \"task_id\": _safe_id(item.get(\"task_id\"), f\"fixture item[{index}].task_id\"),\n            \"query_source\": source,\n            \"null_query\": item[\"null_query\"],\n            \"temporal_cutoff\": cutoff_text,\n            \"cutoff\": cutoff,\n            \"exclude_session_ids\": excluded,\n        }\n        order.append(query_id)\n    if not order:\n        raise EvaluationError(\"fixture must contain queries\")\n    return by_id, order\n\n\ndef _validate_dataset(value: Any, fixture_index: dict[str, Any], fixture_order: list[str]) -> dict[str, Any]:\n    dataset = _object(value, \"dataset\")\n    if dataset.get(\"schema_version\") != 2:\n        raise EvaluationError(\"dataset schema_version must be 2\")\n    _safe_id(dataset.get(\"dataset_id\"), \"dataset_id\")\n    development = _object(dataset.get(\"development\"), \"dataset development\")\n    items = _array(development.get(\"items\"), \"dataset development items\")\n    by_id: dict[str, dict[str, Any]] = {}\n    order: list[str] = []\n    product_answerable = product_null = oracle = 0\n    for index, raw in enumerate(items):\n        item = _object(raw, f\"dataset item[{index}]\")\n        query_id = _safe_id(item.get(\"query_id\"), f\"dataset item[{index}].query_id\")\n        if query_id in by_id:\n            raise EvaluationError(\"dataset contains duplicate query IDs\")\n        fixture_item = fixture_index.get(query_id)\n        if fixture_item is None:\n            raise EvaluationError(\"dataset query set differs from fixture\")\n        task_id = _safe_id(item.get(\"task_id\"), f\"dataset item[{index}].task_id\")\n        source = item.get(\"query_source\")\n        null_query = item.get(\"null_query\")\n        if source not in QUERY_SOURCES or not isinstance(null_query, bool):\n            raise EvaluationError(\"dataset query metadata is malformed\")\n        if (\n            task_id != fixture_item[\"task_id\"]\n            or source != fixture_item[\"query_source\"]\n            or null_query != fixture_item[\"null_query\"]\n        ):\n            raise EvaluationError(\"dataset query metadata differs from fixture\")\n        judgments_raw = _array(item.get(\"judgments\"), f\"dataset item[{index}].judgments\")\n        judgments: dict[str, dict[str, Any]] = {}\n        positives: set[str] = set()\n        for judgment_index, raw_judgment in enumerate(judgments_raw):\n            judgment = _object(\n                raw_judgment, f\"dataset item[{index}].judgment[{judgment_index}]\"\n            )\n            fact_id = _safe_id(\n                judgment.get(\"fact_id\"),\n                f\"dataset item[{index}].judgment[{judgment_index}].fact_id\",\n            )\n            if fact_id in judgments:\n                raise EvaluationError(\"dataset contains duplicate judgment fact IDs\")\n            grade = judgment.get(\"grade\")\n            if grade not in GRADE_WEIGHTS:\n                raise EvaluationError(\"dataset contains an unknown relevance grade\")\n            normalized = {\n                \"fact_id\": fact_id,\n                \"fact_sha256\": _external_sha256(\n                    judgment.get(\"fact_sha256\"),\n                    f\"dataset item[{index}].judgment[{judgment_index}].fact_sha256\",\n                ),\n                \"grade\": grade,\n                \"kind\": _safe_id(\n                    judgment.get(\"kind\"),\n                    f\"dataset item[{index}].judgment[{judgment_index}].kind\",\n                ),\n                \"cluster_id\": _safe_id(\n                    judgment.get(\"cluster_id\"),\n                    f\"dataset item[{index}].judgment[{judgment_index}].cluster_id\",\n                ),\n            }\n            judgments[fact_id] = normalized\n            if grade in POSITIVE_GRADES:\n                positives.add(fact_id)\n        if null_query and positives:\n            raise EvaluationError(\"null query contains a positive judgment\")\n        if not null_query and not positives:\n            raise EvaluationError(\"answerable query contains no positive judgment\")\n        if source == \"user_prompt_derived\":\n            if null_query:\n                product_null += 1\n            else:\n                product_answerable += 1\n        else:\n            oracle += 1\n        by_id[query_id] = {\n            \"query_id\": query_id,\n            \"task_id\": task_id,\n            \"query_source\": source,\n            \"null_query\": null_query,\n            \"judgments\": judgments,\n            \"positive_ids\": positives,\n        }\n        order.append(query_id)\n    if order != fixture_order:\n        raise EvaluationError(\"dataset query order differs from fixture\")\n    if product_answerable == 0 or product_null == 0 or oracle == 0:\n        raise EvaluationError(\n            \"dataset must contain answerable product, corpus-closed product-null, and oracle queries\"\n        )\n    return {\"items\": by_id, \"order\": order}\n\n\ndef _eligible(\n    fact: dict[str, Any], fixture_item: dict[str, Any], session_dates: dict[str, int]\n) -> bool:\n    if fact[\"status\"] != \"active\" or not fact[\"provenance_session_ids\"]:\n        return False\n    excluded = set(fixture_item[\"exclude_session_ids\"])\n    cutoff = fixture_item[\"cutoff\"]\n    for session_id in fact[\"provenance_session_ids\"]:\n        if session_id in excluded:\n            return False\n        created = session_dates.get(session_id)\n        if created is None or not created < cutoff:\n            return False\n    return True\n\n\ndef _validate_judgment_eligibility(\n    dataset: dict[str, Any],\n    fixture_index: dict[str, Any],\n    membership: dict[str, Any],\n) -> None:\n    for query_id in dataset[\"order\"]:\n        fixture_item = fixture_index[query_id]\n        for fact_id in dataset[\"items\"][query_id][\"judgments\"]:\n            judgment = dataset[\"items\"][query_id][\"judgments\"][fact_id]\n            fact = membership[\"fact_index\"].get(fact_id)\n            if fact is None:\n                raise EvaluationError(\"dataset judgment is absent from source membership\")\n            if judgment[\"fact_sha256\"] != fact[\"fact_sha256\"]:\n                raise EvaluationError(\n                    \"dataset judgment fact SHA-256 differs from source membership\"\n                )\n            if not _eligible(fact, fixture_item, membership[\"session_dates\"]):\n                raise EvaluationError(\n                    \"dataset judgment is outside authenticated temporal eligibility\"\n                )\n\n\ndef _build_input_bindings(\n    engine_matrix_raw: bytes,\n    engine_matrix: dict[str, Any],\n    engine_pins_raw: bytes,\n    engine_pins: dict[str, Any],\n    producer_identity_raw: bytes,\n    producer_identity: dict[str, Any],\n    fixture: dict[str, Any],\n    dataset_raw: bytes,\n    dataset: dict[str, Any],\n    membership_raw: bytes,\n    membership: dict[str, Any],\n) -> dict[str, Any]:\n    return {\n        \"engine_matrix_sha256\": sha256_bytes(engine_matrix_raw),\n        \"matrix_id\": _safe_id(engine_matrix.get(\"matrix_id\"), \"matrix_id\"),\n        \"engine_pins_sha256\": sha256_bytes(engine_pins_raw),\n        \"pin_set_id\": _safe_id(engine_pins.get(\"pin_set_id\"), \"pin_set_id\"),\n        \"fixture_sha256\": _sha256(fixture.get(\"fixture_sha256\"), \"fixture_sha256\"),\n        \"fixture_id\": _safe_id(fixture.get(\"fixture_id\"), \"fixture_id\"),\n        \"dataset_sha256\": sha256_bytes(dataset_raw),\n        \"dataset_id\": _safe_id(dataset.get(\"dataset_id\"), \"dataset_id\"),\n        \"source_membership_sha256\": sha256_bytes(membership_raw),\n        \"eligibility_membership_root_sha256\": _sha256(\n            membership.get(\"eligibility_membership_root_sha256\"),\n            \"eligibility membership root\",\n        ),\n        \"producer_identity_file_sha256\": sha256_bytes(producer_identity_raw),\n        \"producer_identity_sha256\": producer_identity[\"producer_identity_sha256\"],\n        \"k_candidates\": list(K_CANDIDATES),\n    }\n\n\ndef _validate_input_bindings(value: Any) -> dict[str, Any]:\n    bindings = _object(value, \"ranked run input bindings\")\n    _exact_fields(bindings, INPUT_BINDING_FIELDS, \"ranked run input bindings\")\n    for field in INPUT_BINDING_SHA_FIELDS:\n        _external_sha256(bindings.get(field), f\"ranked run input binding {field}\")\n    for field in INPUT_BINDING_SELF_HASH_FIELDS:\n        _sha256(bindings.get(field), f\"ranked run input binding {field}\")\n    for field in (\"matrix_id\", \"pin_set_id\", \"fixture_id\", \"dataset_id\"):\n        _safe_id(bindings.get(field), f\"ranked run input binding {field}\")\n    if bindings.get(\"k_candidates\") != list(K_CANDIDATES):\n        raise EvaluationError(\"ranked run input binding K candidates differ\")\n    return copy.deepcopy(bindings)\n\n\ndef _validate_producer_identity(value: Any) -> dict[str, Any]:\n    identity = _object(value, \"producer identity\")\n    _exact_fields(identity, PRODUCER_IDENTITY_FIELDS, \"producer identity\")\n    if (\n        identity.get(\"schema_version\") != SCHEMA_VERSION\n        or identity.get(\"schema\") != PRODUCER_IDENTITY_SCHEMA\n    ):\n        raise EvaluationError(\"producer identity schema is invalid\")\n    _safe_id(identity.get(\"producer_id\"), \"producer identity producer_id\")\n    for field in (\"runner_sha256\", \"producer_code_sha256\"):\n        _external_sha256(identity.get(field), f\"producer identity {field}\")\n    for policy in (\"ranking_result_metadata\", \"token_estimation\", \"serialization\"):\n        _safe_id(\n            identity.get(f\"{policy}_policy_id\"),\n            f\"producer identity {policy}_policy_id\",\n        )\n        _external_sha256(\n            identity.get(f\"{policy}_policy_sha256\"),\n            f\"producer identity {policy}_policy_sha256\",\n        )\n    supplied_hash = _sha256(\n        identity.get(\"producer_identity_sha256\"), \"producer identity self-hash\"\n    )\n    if _self_hash(identity, \"producer_identity_sha256\") != supplied_hash:\n        raise EvaluationError(\"producer identity self-hash mismatch\")\n    return copy.deepcopy(identity)\n\n\ndef _engine_arms(engine_matrix: dict[str, Any]) -> tuple[list[str], dict[str, dict[str, Any]]]:\n    arms_value = _array(engine_matrix.get(\"arms\"), \"engine matrix arms\")\n    order: list[str] = []\n    by_id: dict[str, dict[str, Any]] = {}\n    for index, raw in enumerate(arms_value):\n        arm = _object(raw, f\"engine matrix arm[{index}]\")\n        arm_id = _safe_id(arm.get(\"id\"), f\"engine matrix arm[{index}].id\")\n        if arm_id in by_id:\n            raise EvaluationError(\"engine matrix contains duplicate arm IDs\")\n        semantic = arm.get(\"semantic\")\n        if not isinstance(semantic, bool):\n            raise EvaluationError(\"engine matrix arm semantic must be boolean\")\n        by_id[arm_id] = {\n            \"id\": arm_id,\n            \"semantic\": semantic,\n            \"effective_engine_required\": _safe_id(\n                arm.get(\"effective_engine_required\"), \"effective engine requirement\"\n            ),\n            \"namespace\": _safe_id(arm.get(\"namespace\"), \"engine namespace\"),\n        }\n        order.append(arm_id)\n    if not order:\n        raise EvaluationError(\"engine matrix must contain arms\")\n    return order, by_id\n\n\ndef _validate_engine_identity(\n    value: Any,\n    arm_contracts: dict[str, dict[str, Any]],\n    engine_pins: dict[str, Any],\n) -> dict[str, Any]:\n    identity = _object(value, \"engine identity\")\n    _exact_fields(identity, ENGINE_IDENTITY_FIELDS, \"engine identity\")\n    arm_id = _safe_id(identity.get(\"arm_id\"), \"engine identity arm_id\")\n    contract = arm_contracts.get(arm_id)\n    if contract is None:\n        raise EvaluationError(\"engine identity arm is absent from the matrix\")\n    if identity.get(\"effective_engine\") != contract[\"effective_engine_required\"]:\n        raise EvaluationError(\"effective engine differs from matrix\")\n    if identity.get(\"semantic\") is not contract[\"semantic\"]:\n        raise EvaluationError(\"semantic identity differs from matrix\")\n    if identity.get(\"vector_namespace\") != contract[\"namespace\"]:\n        raise EvaluationError(\"vector namespace differs from matrix\")\n    if identity.get(\"fallback_used\") is not False:\n        raise EvaluationError(\"engine fallback invalidates the ranked run\")\n    binary = _object(engine_pins.get(\"binary\"), \"engine pins binary\")\n    identity_binary_sha256 = _external_sha256(\n        identity.get(\"binary_sha256\"), \"engine identity binary_sha256\"\n    )\n    if identity_binary_sha256 != _external_sha256(\n        binary.get(\"binary_sha256\"), \"pinned binary\"\n    ):\n        raise EvaluationError(\"binary identity differs from engine pins\")\n    if identity.get(\"binary_size_bytes\") != _positive_int(\n        binary.get(\"binary_size_bytes\"), \"pinned binary size\"\n    ):\n        raise EvaluationError(\"binary size differs from engine pins\")\n    engines = _object(engine_pins.get(\"engines\"), \"engine pins engines\")\n    pinned_engine = _object(engines.get(arm_id), \"pinned engine identity\")\n    dimension = pinned_engine.get(\"dimension\")\n    if contract[\"semantic\"]:\n        _external_sha256(\n            identity.get(\"vector_artifact_sha256\"), \"vector artifact SHA-256\"\n        )\n        _positive_int(identity.get(\"vector_artifact_size_bytes\"), \"vector artifact size\")\n        if identity.get(\"embedding_dimension\") != _positive_int(\n            dimension, \"pinned embedding dimension\"\n        ):\n            raise EvaluationError(\"embedding dimension differs from engine pins\")\n    elif any(\n        identity.get(field) is not None\n        for field in (\n            \"vector_artifact_sha256\",\n            \"vector_artifact_size_bytes\",\n            \"embedding_dimension\",\n        )\n    ):\n        raise EvaluationError(\"lexical engine must not claim a vector artifact\")\n    return copy.deepcopy(identity)\n\n\ndef _validate_telemetry(\n    value: Any,\n    *,\n    active_count: int,\n    eligible_count: int,\n    delivered_count: int,\n) -> dict[str, Any]:\n    telemetry = _object(value, \"query telemetry\")\n    _exact_fields(telemetry, TELEMETRY_FIELDS, \"query telemetry\")\n    if _nonnegative_int(telemetry.get(\"active_fact_count\"), \"active_fact_count\") != active_count:\n        raise EvaluationError(\"query active_fact_count differs from membership\")\n    if (\n        _nonnegative_int(telemetry.get(\"eligible_fact_count\"), \"eligible_fact_count\")\n        != eligible_count\n    ):\n        raise EvaluationError(\"query eligible_fact_count differs from temporal policy\")\n    if (\n        _nonnegative_int(\n            telemetry.get(\"temporal_exclusion_count\"), \"temporal_exclusion_count\"\n        )\n        != active_count - eligible_count\n    ):\n        raise EvaluationError(\"query temporal exclusion count differs\")\n    if (\n        _nonnegative_int(telemetry.get(\"delivered_count\"), \"delivered_count\")\n        != delivered_count\n    ):\n        raise EvaluationError(\"query delivered_count differs from ordered results\")\n    latency = _finite_nonnegative(telemetry.get(\"ranking_latency_ms\"), \"ranking_latency_ms\")\n    result = copy.deepcopy(telemetry)\n    result[\"ranking_latency_ms\"] = latency\n    return result\n\n\ndef _validate_run(\n    value: Any,\n    *,\n    expected_bindings: dict[str, Any],\n    expected_producer_identity: dict[str, Any],\n    engine_matrix: dict[str, Any],\n    engine_pins: dict[str, Any],\n    fixture_index: dict[str, Any],\n    fixture_order: list[str],\n    dataset_index: dict[str, Any],\n    membership: dict[str, Any],\n) -> dict[str, Any]:\n    run = _object(value, \"ranked run\")\n    _exact_fields(run, RUN_FIELDS, \"ranked run\")\n    if run.get(\"schema_version\") != SCHEMA_VERSION or run.get(\"schema\") != RANKED_RUN_SCHEMA:\n        raise EvaluationError(\"ranked run schema identity is invalid\")\n    run_id = _safe_id(run.get(\"run_id\"), \"run_id\")\n    _timestamp(run.get(\"created_at\"), \"ranked run created_at\")\n    supplied_hash = _sha256(run.get(\"run_sha256\"), \"run_sha256\")\n    if _self_hash(run, \"run_sha256\") != supplied_hash:\n        raise EvaluationError(\"ranked run self-hash mismatch\")\n    bindings = _validate_input_bindings(run.get(\"input_bindings\"))\n    if bindings != expected_bindings:\n        raise EvaluationError(\"ranked run input bindings differ from authenticated inputs\")\n    if run.get(\"k_candidates\") != list(K_CANDIDATES):\n        raise EvaluationError(\"ranked run K candidates differ from the frozen contract\")\n    aggregation = run.get(\"aggregation_rule\")\n    if aggregation not in AGGREGATION_CANDIDATES:\n        raise EvaluationError(\"ranked run aggregation rule is unsupported\")\n    producer_identity = _validate_producer_identity(run.get(\"producer_identity\"))\n    if producer_identity != expected_producer_identity:\n        raise EvaluationError(\n            \"ranked run producer identity differs from bound producer contract\"\n        )\n    _, arm_contracts = _engine_arms(engine_matrix)\n    identity = _validate_engine_identity(run.get(\"engine_identity\"), arm_contracts, engine_pins)\n    query_values = _array(run.get(\"queries\"), \"ranked run queries\")\n    if len(query_values) != len(fixture_order):\n        raise EvaluationError(\"ranked run query count differs from fixture\")\n    queries: list[dict[str, Any]] = []\n    seen_queries: set[str] = set()\n    membership_index = membership[\"fact_index\"]\n    for index, raw in enumerate(query_values):\n        query = _object(raw, f\"ranked run query[{index}]\")\n        _exact_fields(query, QUERY_FIELDS, f\"ranked run query[{index}]\")\n        query_id = _safe_id(query.get(\"query_id\"), f\"ranked run query[{index}].query_id\")\n        if query_id in seen_queries:\n            raise EvaluationError(\"ranked run contains duplicate query IDs\")\n        seen_queries.add(query_id)\n        if query_id != fixture_order[index]:\n            raise EvaluationError(\"ranked run query order differs from fixture\")\n        fixture_item = fixture_index[query_id]\n        dataset_item = dataset_index[query_id]\n        if (\n            query.get(\"task_id\") != fixture_item[\"task_id\"]\n            or query.get(\"query_source\") != fixture_item[\"query_source\"]\n            or query.get(\"null_query\") is not fixture_item[\"null_query\"]\n        ):\n            raise EvaluationError(\"ranked run query metadata differs from fixture\")\n        eligible_ids = {\n            fact[\"fact_id\"]\n            for fact in membership[\"facts\"]\n            if _eligible(fact, fixture_item, membership[\"session_dates\"])\n        }\n        results_raw = _array(query.get(\"ordered_results\"), \"ordered results\")\n        if len(results_raw) > max(K_CANDIDATES):\n            raise EvaluationError(\"ranked run retains more results than the maximum K\")\n        results: list[dict[str, Any]] = []\n        seen_facts: set[str] = set()\n        for result_index, raw_result in enumerate(results_raw):\n            result = _object(raw_result, f\"ordered result[{result_index}]\")\n            _exact_fields(result, RESULT_FIELDS, f\"ordered result[{result_index}]\")\n            fact_id = _safe_id(result.get(\"fact_id\"), f\"ordered result[{result_index}].fact_id\")\n            if fact_id in seen_facts:\n                raise EvaluationError(\"ranked run contains duplicate result fact IDs\")\n            seen_facts.add(fact_id)\n            fact = membership_index.get(fact_id)\n            if fact is None:\n                raise EvaluationError(\"ranked run result is absent from source membership\")\n            fact_sha256 = _external_sha256(\n                result.get(\"fact_sha256\"),\n                f\"ordered result[{result_index}].fact_sha256\",\n            )\n            if fact_sha256 != fact[\"fact_sha256\"]:\n                raise EvaluationError(\n                    \"ranked result fact SHA-256 differs from source membership\"\n                )\n            derived_eligible = fact_id in eligible_ids\n            if result.get(\"eligible\") is not derived_eligible:\n                raise EvaluationError(\"ranked result eligibility differs from authenticated policy\")\n            if not derived_eligible:\n                raise EvaluationError(\"ranked run contains temporal leakage\")\n            kind = _safe_id(result.get(\"kind\"), f\"ordered result[{result_index}].kind\")\n            cluster_id = _safe_id(\n                result.get(\"cluster_id\"), f\"ordered result[{result_index}].cluster_id\"\n            )\n            judgment = dataset_item[\"judgments\"].get(fact_id)\n            if judgment is not None and (\n                judgment[\"kind\"] != kind or judgment[\"cluster_id\"] != cluster_id\n            ):\n                raise EvaluationError(\"ranked result metadata differs from reviewed judgment\")\n            results.append(\n                {\n                    \"fact_id\": fact_id,\n                    \"fact_sha256\": fact_sha256,\n                    \"kind\": kind,\n                    \"cluster_id\": cluster_id,\n                    \"eligible\": True,\n                    \"estimated_tokens\": _positive_int(\n                        result.get(\"estimated_tokens\"),\n                        f\"ordered result[{result_index}].estimated_tokens\",\n                    ),\n                }\n            )\n        telemetry = _validate_telemetry(\n            query.get(\"telemetry\"),\n            active_count=membership[\"active_fact_count\"],\n            eligible_count=len(eligible_ids),\n            delivered_count=len(results),\n        )\n        queries.append(\n            {\n                \"query_id\": query_id,\n                \"task_id\": fixture_item[\"task_id\"],\n                \"query_source\": fixture_item[\"query_source\"],\n                \"null_query\": fixture_item[\"null_query\"],\n                \"telemetry\": telemetry,\n                \"ordered_results\": results,\n            }\n        )\n    return {\n        \"schema_version\": SCHEMA_VERSION,\n        \"schema\": RANKED_RUN_SCHEMA,\n        \"run_id\": run_id,\n        \"created_at\": run[\"created_at\"],\n        \"input_bindings\": copy.deepcopy(bindings),\n        \"producer_identity\": producer_identity,\n        \"engine_identity\": identity,\n        \"aggregation_rule\": aggregation,\n        \"k_candidates\": list(K_CANDIDATES),\n        \"queries\": queries,\n        \"run_sha256\": supplied_hash,\n    }\n\n\ndef _recall(results: list[dict[str, Any]], positives: set[str], cutoff: int) -> float:\n    if not positives:\n        return 0.0\n    hits = {result[\"fact_id\"] for result in results[:cutoff]} & positives\n    return _ratio(len(hits), len(positives))\n\n","exit_code":0,"duration":{"secs":0,"nanos":2875},"formatted_output":"            raise EvaluationError(\"fixture null_query must be boolean\")\n        cutoff_text, cutoff = _timestamp(\n            item.get(\"temporal_cutoff\"), f\"fixture item[{index}].temporal_cutoff\"\n        )\n        excluded_raw = _array(\n            item.get(\"exclude_session_ids\"), f\"fixture item[{index}].exclude_session_ids\"\n        )\n        excluded = [\n            _safe_id(value, f\"fixture item[{index}] excluded session\")\n            for value in excluded_raw\n        ]\n        if excluded != sorted(set(excluded)):\n            raise EvaluationError(\"fixture excluded session IDs are not canonical\")\n        by_id[query_id] = {\n            \"query_id\": query_id,\n            \"task_id\": _safe_id(item.get(\"task_id\"), f\"fixture item[{index}].task_id\"),\n            \"query_source\": source,\n            \"null_query\": item[\"null_query\"],\n            \"temporal_cutoff\": cutoff_text,\n            \"cutoff\": cutoff,\n            \"exclude_session_ids\": excluded,\n        }\n        order.append(query_id)\n    if not order:\n        raise EvaluationError(\"fixture must contain queries\")\n    return by_id, order\n\n\ndef _validate_dataset(value: Any, fixture_index: dict[str, Any], fixture_order: list[str]) -> dict[str, Any]:\n    dataset = _object(value, \"dataset\")\n    if dataset.get(\"schema_version\") != 2:\n        raise EvaluationError(\"dataset schema_version must be 2\")\n    _safe_id(dataset.get(\"dataset_id\"), \"dataset_id\")\n    development = _object(dataset.get(\"development\"), \"dataset development\")\n    items = _array(development.get(\"items\"), \"dataset development items\")\n    by_id: dict[str, dict[str, Any]] = {}\n    order: list[str] = []\n    product_answerable = product_null = oracle = 0\n    for index, raw in enumerate(items):\n        item = _object(raw, f\"dataset item[{index}]\")\n        query_id = _safe_id(item.get(\"query_id\"), f\"dataset item[{index}].query_id\")\n        if query_id in by_id:\n            raise EvaluationError(\"dataset contains duplicate query IDs\")\n        fixture_item = fixture_index.get(query_id)\n        if fixture_item is None:\n            raise EvaluationError(\"dataset query set differs from fixture\")\n        task_id = _safe_id(item.get(\"task_id\"), f\"dataset item[{index}].task_id\")\n        source = item.get(\"query_source\")\n        null_query = item.get(\"null_query\")\n        if source not in QUERY_SOURCES or not isinstance(null_query, bool):\n            raise EvaluationError(\"dataset query metadata is malformed\")\n        if (\n            task_id != fixture_item[\"task_id\"]\n            or source != fixture_item[\"query_source\"]\n            or null_query != fixture_item[\"null_query\"]\n        ):\n            raise EvaluationError(\"dataset query metadata differs from fixture\")\n        judgments_raw = _array(item.get(\"judgments\"), f\"dataset item[{index}].judgments\")\n        judgments: dict[str, dict[str, Any]] = {}\n        positives: set[str] = set()\n        for judgment_index, raw_judgment in enumerate(judgments_raw):\n            judgment = _object(\n                raw_judgment, f\"dataset item[{index}].judgment[{judgment_index}]\"\n            )\n            fact_id = _safe_id(\n                judgment.get(\"fact_id\"),\n                f\"dataset item[{index}].judgment[{judgment_index}].fact_id\",\n            )\n            if fact_id in judgments:\n                raise EvaluationError(\"dataset contains duplicate judgment fact IDs\")\n            grade = judgment.get(\"grade\")\n            if grade not in GRADE_WEIGHTS:\n                raise EvaluationError(\"dataset contains an unknown relevance grade\")\n            normalized = {\n                \"fact_id\": fact_id,\n                \"fact_sha256\": _external_sha256(\n                    judgment.get(\"fact_sha256\"),\n                    f\"dataset item[{index}].judgment[{judgment_index}].fact_sha256\",\n                ),\n                \"grade\": grade,\n                \"kind\": _safe_id(\n                    judgment.get(\"kind\"),\n                    f\"dataset item[{index}].judgment[{judgment_index}].kind\",\n                ),\n                \"cluster_id\": _safe_id(\n                    judgment.get(\"cluster_id\"),\n                    f\"dataset item[{index}].judgment[{judgment_index}].cluster_id\",\n                ),\n            }\n            judgments[fact_id] = normalized\n            if grade in POSITIVE_GRADES:\n                positives.add(fact_id)\n        if null_query and positives:\n            raise EvaluationError(\"null query contains a positive judgment\")\n        if not null_query and not positives:\n            raise EvaluationError(\"answerable query contains no positive judgment\")\n        if source == \"user_prompt_derived\":\n            if null_query:\n                product_null += 1\n            else:\n                product_answerable += 1\n        else:\n            oracle += 1\n        by_id[query_id] = {\n            \"query_id\": query_id,\n            \"task_id\": task_id,\n            \"query_source\": source,\n            \"null_query\": null_query,\n            \"judgments\": judgments,\n            \"positive_ids\": positives,\n        }\n        order.append(query_id)\n    if order != fixture_order:\n        raise EvaluationError(\"dataset query order differs from fixture\")\n    if product_answerable == 0 or product_null == 0 or oracle == 0:\n        raise EvaluationError(\n            \"dataset must contain answerable product, corpus-closed product-null, and oracle queries\"\n        )\n    return {\"items\": by_id, \"order\": order}\n\n\ndef _eligible(\n    fact: dict[str, Any], fixture_item: dict[str, Any], session_dates: dict[str, int]\n) -> bool:\n    if fact[\"status\"] != \"active\" or not fact[\"provenance_session_ids\"]:\n        return False\n    excluded = set(fixture_item[\"exclude_session_ids\"])\n    cutoff = fixture_item[\"cutoff\"]\n    for session_id in fact[\"provenance_session_ids\"]:\n        if session_id in excluded:\n            return False\n        created = session_dates.get(session_id)\n        if created is None or not created < cutoff:\n            return False\n    return True\n\n\ndef _validate_judgment_eligibility(\n    dataset: dict[str, Any],\n    fixture_index: dict[str, Any],\n    membership: dict[str, Any],\n) -> None:\n    for query_id in dataset[\"order\"]:\n        fixture_item = fixture_index[query_id]\n        for fact_id in dataset[\"items\"][query_id][\"judgments\"]:\n            judgment = dataset[\"items\"][query_id][\"judgments\"][fact_id]\n            fact = membership[\"fact_index\"].get(fact_id)\n            if fact is None:\n                raise EvaluationError(\"dataset judgment is absent from source membership\")\n            if judgment[\"fact_sha256\"] != fact[\"fact_sha256\"]:\n                raise EvaluationError(\n                    \"dataset judgment fact SHA-256 differs from source membership\"\n                )\n            if not _eligible(fact, fixture_item, membership[\"session_dates\"]):\n                raise EvaluationError(\n                    \"dataset judgment is outside authenticated temporal eligibility\"\n                )\n\n\ndef _build_input_bindings(\n    engine_matrix_raw: bytes,\n    engine_matrix: dict[str, Any],\n    engine_pins_raw: bytes,\n    engine_pins: dict[str, Any],\n    producer_identity_raw: bytes,\n    producer_identity: dict[str, Any],\n    fixture: dict[str, Any],\n    dataset_raw: bytes,\n    dataset: dict[str, Any],\n    membership_raw: bytes,\n    membership: dict[str, Any],\n) -> dict[str, Any]:\n    return {\n        \"engine_matrix_sha256\": sha256_bytes(engine_matrix_raw),\n        \"matrix_id\": _safe_id(engine_matrix.get(\"matrix_id\"), \"matrix_id\"),\n        \"engine_pins_sha256\": sha256_bytes(engine_pins_raw),\n        \"pin_set_id\": _safe_id(engine_pins.get(\"pin_set_id\"), \"pin_set_id\"),\n        \"fixture_sha256\": _sha256(fixture.get(\"fixture_sha256\"), \"fixture_sha256\"),\n        \"fixture_id\": _safe_id(fixture.get(\"fixture_id\"), \"fixture_id\"),\n        \"dataset_sha256\": sha256_bytes(dataset_raw),\n        \"dataset_id\": _safe_id(dataset.get(\"dataset_id\"), \"dataset_id\"),\n        \"source_membership_sha256\": sha256_bytes(membership_raw),\n        \"eligibility_membership_root_sha256\": _sha256(\n            membership.get(\"eligibility_membership_root_sha256\"),\n            \"eligibility membership root\",\n        ),\n        \"producer_identity_file_sha256\": sha256_bytes(producer_identity_raw),\n        \"producer_identity_sha256\": producer_identity[\"producer_identity_sha256\"],\n        \"k_candidates\": list(K_CANDIDATES),\n    }\n\n\ndef _validate_input_bindings(value: Any) -> dict[str, Any]:\n    bindings = _object(value, \"ranked run input bindings\")\n    _exact_fields(bindings, INPUT_BINDING_FIELDS, \"ranked run input bindings\")\n    for field in INPUT_BINDING_SHA_FIELDS:\n        _external_sha256(bindings.get(field), f\"ranked run input binding {field}\")\n    for field in INPUT_BINDING_SELF_HASH_FIELDS:\n        _sha256(bindings.get(field), f\"ranked run input binding {field}\")\n    for field in (\"matrix_id\", \"pin_set_id\", \"fixture_id\", \"dataset_id\"):\n        _safe_id(bindings.get(field), f\"ranked run input binding {field}\")\n    if bindings.get(\"k_candidates\") != list(K_CANDIDATES):\n        raise EvaluationError(\"ranked run input binding K candidates differ\")\n    return copy.deepcopy(bindings)\n\n\ndef _validate_producer_identity(value: Any) -> dict[str, Any]:\n    identity = _object(value, \"producer identity\")\n    _exact_fields(identity, PRODUCER_IDENTITY_FIELDS, \"producer identity\")\n    if (\n        identity.get(\"schema_version\") != SCHEMA_VERSION\n        or identity.get(\"schema\") != PRODUCER_IDENTITY_SCHEMA\n    ):\n        raise EvaluationError(\"producer identity schema is invalid\")\n    _safe_id(identity.get(\"producer_id\"), \"producer identity producer_id\")\n    for field in (\"runner_sha256\", \"producer_code_sha256\"):\n        _external_sha256(identity.get(field), f\"producer identity {field}\")\n    for policy in (\"ranking_result_metadata\", \"token_estimation\", \"serialization\"):\n        _safe_id(\n            identity.get(f\"{policy}_policy_id\"),\n            f\"producer identity {policy}_policy_id\",\n        )\n        _external_sha256(\n            identity.get(f\"{policy}_policy_sha256\"),\n            f\"producer identity {policy}_policy_sha256\",\n        )\n    supplied_hash = _sha256(\n        identity.get(\"producer_identity_sha256\"), \"producer identity self-hash\"\n    )\n    if _self_hash(identity, \"producer_identity_sha256\") != supplied_hash:\n        raise EvaluationError(\"producer identity self-hash mismatch\")\n    return copy.deepcopy(identity)\n\n\ndef _engine_arms(engine_matrix: dict[str, Any]) -> tuple[list[str], dict[str, dict[str, Any]]]:\n    arms_value = _array(engine_matrix.get(\"arms\"), \"engine matrix arms\")\n    order: list[str] = []\n    by_id: dict[str, dict[str, Any]] = {}\n    for index, raw in enumerate(arms_value):\n        arm = _object(raw, f\"engine matrix arm[{index}]\")\n        arm_id = _safe_id(arm.get(\"id\"), f\"engine matrix arm[{index}].id\")\n        if arm_id in by_id:\n            raise EvaluationError(\"engine matrix contains duplicate arm IDs\")\n        semantic = arm.get(\"semantic\")\n        if not isinstance(semantic, bool):\n            raise EvaluationError(\"engine matrix arm semantic must be boolean\")\n        by_id[arm_id] = {\n            \"id\": arm_id,\n            \"semantic\": semantic,\n            \"effective_engine_required\": _safe_id(\n                arm.get(\"effective_engine_required\"), \"effective engine requirement\"\n            ),\n            \"namespace\": _safe_id(arm.get(\"namespace\"), \"engine namespace\"),\n        }\n        order.append(arm_id)\n    if not order:\n        raise EvaluationError(\"engine matrix must contain arms\")\n    return order, by_id\n\n\ndef _validate_engine_identity(\n    value: Any,\n    arm_contracts: dict[str, dict[str, Any]],\n    engine_pins: dict[str, Any],\n) -> dict[str, Any]:\n    identity = _object(value, \"engine identity\")\n    _exact_fields(identity, ENGINE_IDENTITY_FIELDS, \"engine identity\")\n    arm_id = _safe_id(identity.get(\"arm_id\"), \"engine identity arm_id\")\n    contract = arm_contracts.get(arm_id)\n    if contract is None:\n        raise EvaluationError(\"engine identity arm is absent from the matrix\")\n    if identity.get(\"effective_engine\") != contract[\"effective_engine_required\"]:\n        raise EvaluationError(\"effective engine differs from matrix\")\n    if identity.get(\"semantic\") is not contract[\"semantic\"]:\n        raise EvaluationError(\"semantic identity differs from matrix\")\n    if identity.get(\"vector_namespace\") != contract[\"namespace\"]:\n        raise EvaluationError(\"vector namespace differs from matrix\")\n    if identity.get(\"fallback_used\") is not False:\n        raise EvaluationError(\"engine fallback invalidates the ranked run\")\n    binary = _object(engine_pins.get(\"binary\"), \"engine pins binary\")\n    identity_binary_sha256 = _external_sha256(\n        identity.get(\"binary_sha256\"), \"engine identity binary_sha256\"\n    )\n    if identity_binary_sha256 != _external_sha256(\n        binary.get(\"binary_sha256\"), \"pinned binary\"\n    ):\n        raise EvaluationError(\"binary identity differs from engine pins\")\n    if identity.get(\"binary_size_bytes\") != _positive_int(\n        binary.get(\"binary_size_bytes\"), \"pinned binary size\"\n    ):\n        raise EvaluationError(\"binary size differs from engine pins\")\n    engines = _object(engine_pins.get(\"engines\"), \"engine pins engines\")\n    pinned_engine = _object(engines.get(arm_id), \"pinned engine identity\")\n    dimension = pinned_engine.get(\"dimension\")\n    if contract[\"semantic\"]:\n        _external_sha256(\n            identity.get(\"vector_artifact_sha256\"), \"vector artifact SHA-256\"\n        )\n        _positive_int(identity.get(\"vector_artifact_size_bytes\"), \"vector artifact size\")\n        if identity.get(\"embedding_dimension\") != _positive_int(\n            dimension, \"pinned embedding dimension\"\n        ):\n            raise EvaluationError(\"embedding dimension differs from engine pins\")\n    elif any(\n        identity.get(field) is not None\n        for field in (\n            \"vector_artifact_sha256\",\n            \"vector_artifact_size_bytes\",\n            \"embedding_dimension\",\n        )\n    ):\n        raise EvaluationError(\"lexical engine must not claim a vector artifact\")\n    return copy.deepcopy(identity)\n\n\ndef _validate_telemetry(\n    value: Any,\n    *,\n    active_count: int,\n    eligible_count: int,\n    delivered_count: int,\n) -> dict[str, Any]:\n    telemetry = _object(value, \"query telemetry\")\n    _exact_fields(telemetry, TELEMETRY_FIELDS, \"query telemetry\")\n    if _nonnegative_int(telemetry.get(\"active_fact_count\"), \"active_fact_count\") != active_count:\n        raise EvaluationError(\"query active_fact_count differs from membership\")\n    if (\n        _nonnegative_int(telemetry.get(\"eligible_fact_count\"), \"eligible_fact_count\")\n        != eligible_count\n    ):\n        raise EvaluationError(\"query eligible_fact_count differs from temporal policy\")\n    if (\n        _nonnegative_int(\n            telemetry.get(\"temporal_exclusion_count\"), \"temporal_exclusion_count\"\n        )\n        != active_count - eligible_count\n    ):\n        raise EvaluationError(\"query temporal exclusion count differs\")\n    if (\n        _nonnegative_int(telemetry.get(\"delivered_count\"), \"delivered_count\")\n        != delivered_count\n    ):\n        raise EvaluationError(\"query delivered_count differs from ordered results\")\n    latency = _finite_nonnegative(telemetry.get(\"ranking_latency_ms\"), \"ranking_latency_ms\")\n    result = copy.deepcopy(telemetry)\n    result[\"ranking_latency_ms\"] = latency\n    return result\n\n\ndef _validate_run(\n    value: Any,\n    *,\n    expected_bindings: dict[str, Any],\n    expected_producer_identity: dict[str, Any],\n    engine_matrix: dict[str, Any],\n    engine_pins: dict[str, Any],\n    fixture_index: dict[str, Any],\n    fixture_order: list[str],\n    dataset_index: dict[str, Any],\n    membership: dict[str, Any],\n) -> dict[str, Any]:\n    run = _object(value, \"ranked run\")\n    _exact_fields(run, RUN_FIELDS, \"ranked run\")\n    if run.get(\"schema_version\") != SCHEMA_VERSION or run.get(\"schema\") != RANKED_RUN_SCHEMA:\n        raise EvaluationError(\"ranked run schema identity is invalid\")\n    run_id = _safe_id(run.get(\"run_id\"), \"run_id\")\n    _timestamp(run.get(\"created_at\"), \"ranked run created_at\")\n    supplied_hash = _sha256(run.get(\"run_sha256\"), \"run_sha256\")\n    if _self_hash(run, \"run_sha256\") != supplied_hash:\n        raise EvaluationError(\"ranked run self-hash mismatch\")\n    bindings = _validate_input_bindings(run.get(\"input_bindings\"))\n    if bindings != expected_bindings:\n        raise EvaluationError(\"ranked run input bindings differ from authenticated inputs\")\n    if run.get(\"k_candidates\") != list(K_CANDIDATES):\n        raise EvaluationError(\"ranked run K candidates differ from the frozen contract\")\n    aggregation = run.get(\"aggregation_rule\")\n    if aggregation not in AGGREGATION_CANDIDATES:\n        raise EvaluationError(\"ranked run aggregation rule is unsupported\")\n    producer_identity = _validate_producer_identity(run.get(\"producer_identity\"))\n    if producer_identity != expected_producer_identity:\n        raise EvaluationError(\n            \"ranked run producer identity differs from bound producer contract\"\n        )\n    _, arm_contracts = _engine_arms(engine_matrix)\n    identity = _validate_engine_identity(run.get(\"engine_identity\"), arm_contracts, engine_pins)\n    query_values = _array(run.get(\"queries\"), \"ranked run queries\")\n    if len(query_values) != len(fixture_order):\n        raise EvaluationError(\"ranked run query count differs from fixture\")\n    queries: list[dict[str, Any]] = []\n    seen_queries: set[str] = set()\n    membership_index = membership[\"fact_index\"]\n    for index, raw in enumerate(query_values):\n        query = _object(raw, f\"ranked run query[{index}]\")\n        _exact_fields(query, QUERY_FIELDS, f\"ranked run query[{index}]\")\n        query_id = _safe_id(query.get(\"query_id\"), f\"ranked run query[{index}].query_id\")\n        if query_id in seen_queries:\n            raise EvaluationError(\"ranked run contains duplicate query IDs\")\n        seen_queries.add(query_id)\n        if query_id != fixture_order[index]:\n            raise EvaluationError(\"ranked run query order differs from fixture\")\n        fixture_item = fixture_index[query_id]\n        dataset_item = dataset_index[query_id]\n        if (\n            query.get(\"task_id\") != fixture_item[\"task_id\"]\n            or query.get(\"query_source\") != fixture_item[\"query_source\"]\n            or query.get(\"null_query\") is not fixture_item[\"null_query\"]\n        ):\n            raise EvaluationError(\"ranked run query metadata differs from fixture\")\n        eligible_ids = {\n            fact[\"fact_id\"]\n            for fact in membership[\"facts\"]\n            if _eligible(fact, fixture_item, membership[\"session_dates\"])\n        }\n        results_raw = _array(query.get(\"ordered_results\"), \"ordered results\")\n        if len(results_raw) > max(K_CANDIDATES):\n            raise EvaluationError(\"ranked run retains more results than the maximum K\")\n        results: list[dict[str, Any]] = []\n        seen_facts: set[str] = set()\n        for result_index, raw_result in enumerate(results_raw):\n            result = _object(raw_result, f\"ordered result[{result_index}]\")\n            _exact_fields(result, RESULT_FIELDS, f\"ordered result[{result_index}]\")\n            fact_id = _safe_id(result.get(\"fact_id\"), f\"ordered result[{result_index}].fact_id\")\n            if fact_id in seen_facts:\n                raise EvaluationError(\"ranked run contains duplicate result fact IDs\")\n            seen_facts.add(fact_id)\n            fact = membership_index.get(fact_id)\n            if fact is None:\n                raise EvaluationError(\"ranked run result is absent from source membership\")\n            fact_sha256 = _external_sha256(\n                result.get(\"fact_sha256\"),\n                f\"ordered result[{result_index}].fact_sha256\",\n            )\n            if fact_sha256 != fact[\"fact_sha256\"]:\n                raise EvaluationError(\n                    \"ranked result fact SHA-256 differs from source membership\"\n                )\n            derived_eligible = fact_id in eligible_ids\n            if result.get(\"eligible\") is not derived_eligible:\n                raise EvaluationError(\"ranked result eligibility differs from authenticated policy\")\n            if not derived_eligible:\n                raise EvaluationError(\"ranked run contains temporal leakage\")\n            kind = _safe_id(result.get(\"kind\"), f\"ordered result[{result_index}].kind\")\n            cluster_id = _safe_id(\n                result.get(\"cluster_id\"), f\"ordered result[{result_index}].cluster_id\"\n            )\n            judgment = dataset_item[\"judgments\"].get(fact_id)\n            if judgment is not None and (\n                judgment[\"kind\"] != kind or judgment[\"cluster_id\"] != cluster_id\n            ):\n                raise EvaluationError(\"ranked result metadata differs from reviewed judgment\")\n            results.append(\n                {\n                    \"fact_id\": fact_id,\n                    \"fact_sha256\": fact_sha256,\n                    \"kind\": kind,\n                    \"cluster_id\": cluster_id,\n                    \"eligible\": True,\n                    \"estimated_tokens\": _positive_int(\n                        result.get(\"estimated_tokens\"),\n                        f\"ordered result[{result_index}].estimated_tokens\",\n                    ),\n                }\n            )\n        telemetry = _validate_telemetry(\n            query.get(\"telemetry\"),\n            active_count=membership[\"active_fact_count\"],\n            eligible_count=len(eligible_ids),\n            delivered_count=len(results),\n        )\n        queries.append(\n            {\n                \"query_id\": query_id,\n                \"task_id\": fixture_item[\"task_id\"],\n                \"query_source\": fixture_item[\"query_source\"],\n                \"null_query\": fixture_item[\"null_query\"],\n                \"telemetry\": telemetry,\n                \"ordered_results\": results,\n            }\n        )\n    return {\n        \"schema_version\": SCHEMA_VERSION,\n        \"schema\": RANKED_RUN_SCHEMA,\n        \"run_id\": run_id,\n        \"created_at\": run[\"created_at\"],\n        \"input_bindings\": copy.deepcopy(bindings),\n        \"producer_identity\": producer_identity,\n        \"engine_identity\": identity,\n        \"aggregation_rule\": aggregation,\n        \"k_candidates\": list(K_CANDIDATES),\n        \"queries\": queries,\n        \"run_sha256\": supplied_hash,\n    }\n\n\ndef _recall(results: list[dict[str, Any]], positives: set[str], cutoff: int) -> float:\n    if not positives:\n        return 0.0\n    hits = {result[\"fact_id\"] for result in results[:cutoff]} & positives\n    return _ratio(len(hits), len(positives))\n\n"},"started_at_ms":1789839520329,"completed_at_ms":1789839520329}}
{"timestamp":"2026-09-19T17:38:40.385Z","ordinal":7463,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0babf-b281-7421-9df2-2ec7dd6c84f3","call_id":"call_5N1AqygbNrlPRNdAQD4qVz52","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"dcecef\",\"wall_time_seconds\":0.000002875,\"exit_code\":0,\"original_token_count\":5655,\"output\":\"            raise EvaluationError(\\\"fixture null_query must be boolean\\\")\\n        cutoff_text, cutoff = _timestamp(\\n            item.get(\\\"temporal_cutoff\\\"), f\\\"fixture item[{index}].temporal_cutoff\\\"\\n        )\\n        excluded_raw = _array(\\n            item.get(\\\"exclude_session_ids\\\"), f\\\"fixture item[{index}].exclude_session_ids\\\"\\n        )\\n        excluded = [\\n            _safe_id(value, f\\\"fixture item[{index}] excluded session\\\")\\n            for value in excluded_raw\\n        ]\\n        if excluded != sorted(set(excluded)):\\n            raise EvaluationError(\\\"fixture excluded session IDs are not canonical\\\")\\n        by_id[query_id] = {\\n            \\\"query_id\\\": query_id,\\n            \\\"task_id\\\": _safe_id(item.get(\\\"task_id\\\"), f\\\"fixture item[{index}].task_id\\\"),\\n            \\\"query_source\\\": source,\\n            \\\"null_query\\\": item[\\\"null_query\\\"],\\n            \\\"temporal_cutoff\\\": cutoff_text,\\n            \\\"cutoff\\\": cutoff,\\n            \\\"exclude_session_ids\\\": excluded,\\n        }\\n        order.append(query_id)\\n    if not order:\\n        raise EvaluationError(\\\"fixture must contain queries\\\")\\n    return by_id, order\\n\\n\\ndef _validate_dataset(value: Any, fixture_index: dict[str, Any], fixture_order: list[str]) -> dict[str, Any]:\\n    dataset = _object(value, \\\"dataset\\\")\\n    if dataset.get(\\\"schema_version\\\") != 2:\\n        raise EvaluationError(\\\"dataset schema_version must be 2\\\")\\n    _safe_id(dataset.get(\\\"dataset_id\\\"), \\\"dataset_id\\\")\\n    development = _object(dataset.get(\\\"development\\\"), \\\"dataset development\\\")\\n    items = _array(development.get(\\\"items\\\"), \\\"dataset development items\\\")\\n    by_id: dict[str, dict[str, Any]] = {}\\n    order: list[str] = []\\n    product_answerable = product_null = oracle = 0\\n    for index, raw in enumerate(items):\\n        item = _object(raw, f\\\"dataset item[{index}]\\\")\\n        query_id = _safe_id(item.get(\\\"query_id\\\"), f\\\"dataset item[{index}].query_id\\\")\\n        if query_id in by_id:\\n            raise EvaluationError(\\\"dataset contains duplicate query IDs\\\")\\n        fixture_item = fixture_index.get(query_id)\\n        if fixture_item is None:\\n            raise EvaluationError(\\\"dataset query set differs from fixture\\\")\\n        task_id = _safe_id(item.get(\\\"task_id\\\"), f\\\"dataset item[{index}].task_id\\\")\\n        source = item.get(\\\"query_source\\\")\\n        null_query = item.get(\\\"null_query\\\")\\n        if source not in QUERY_SOURCES or not isinstance(null_query, bool):\\n            raise EvaluationError(\\\"dataset query metadata is malformed\\\")\\n        if (\\n            task_id != fixture_item[\\\"task_id\\\"]\\n            or source != fixture_item[\\\"query_source\\\"]\\n            or null_query != fixture_item[\\\"null_query\\\"]\\n        ):\\n            raise EvaluationError(\\\"dataset query metadata differs from fixture\\\")\\n        judgments_raw = _array(item.get(\\\"judgments\\\"), f\\\"dataset item[{index}].judgments\\\")\\n        judgments: dict[str, dict[str, Any]] = {}\\n        positives: set[str] = set()\\n        for judgment_index, raw_judgment in enumerate(judgments_raw):\\n            judgment = _object(\\n                raw_judgment, f\\\"dataset item[{index}].judgment[{judgment_index}]\\\"\\n            )\\n            fact_id = _safe_id(\\n                judgment.get(\\\"fact_id\\\"),\\n                f\\\"dataset item[{index}].judgment[{judgment_index}].fact_id\\\",\\n            )\\n            if fact_id in judgments:\\n                raise EvaluationError(\\\"dataset contains duplicate judgment fact IDs\\\")\\n            grade = judgment.get(\\\"grade\\\")\\n            if grade not in GRADE_WEIGHTS:\\n                raise EvaluationError(\\\"dataset contains an unknown relevance grade\\\")\\n            normalized = {\\n                \\\"fact_id\\\": fact_id,\\n                \\\"fact_sha256\\\": _external_sha256(\\n                    judgment.get(\\\"fact_sha256\\\"),\\n                    f\\\"dataset item[{index}].judgment[{judgment_index}].fact_sha256\\\",\\n                ),\\n                \\\"grade\\\": grade,\\n                \\\"kind\\\": _safe_id(\\n                    judgment.get(\\\"kind\\\"),\\n                    f\\\"dataset item[{index}].judgment[{judgment_index}].kind\\\",\\n                ),\\n                \\\"cluster_id\\\": _safe_id(\\n                    judgment.get(\\\"cluster_id\\\"),\\n                    f\\\"dataset item[{index}].judgment[{judgment_index}].cluster_id\\\",\\n                ),\\n            }\\n            judgments[fact_id] = normalized\\n            if grade in POSITIVE_GRADES:\\n                positives.add(fact_id)\\n        if null_query and positives:\\n            raise EvaluationError(\\\"null query contains a positive judgment\\\")\\n        if not null_query and not positives:\\n            raise EvaluationError(\\\"answerable query contains no positive judgment\\\")\\n        if source == \\\"user_prompt_derived\\\":\\n            if null_query:\\n                product_null += 1\\n            else:\\n                product_answerable += 1\\n        else:\\n            oracle += 1\\n        by_id[query_id] = {\\n            \\\"query_id\\\": query_id,\\n            \\\"task_id\\\": task_id,\\n            \\\"query_source\\\": source,\\n            \\\"null_query\\\": null_query,\\n            \\\"judgments\\\": judgments,\\n            \\\"positive_ids\\\": positives,\\n        }\\n        order.append(query_id)\\n    if order != fixture_order:\\n        raise EvaluationError(\\\"dataset query order differs from fixture\\\")\\n    if product_answerable == 0 or product_null == 0 or oracle == 0:\\n        raise EvaluationError(\\n            \\\"dataset must contain answerable product, corpus-closed product-null, and oracle queries\\\"\\n        )\\n    return {\\\"items\\\": by_id, \\\"order\\\": order}\\n\\n\\ndef _eligible(\\n    fact: dict[str, Any], fixture_item: dict[str, Any], session_dates: dict[str, int]\\n) -> bool:\\n    if fact[\\\"status\\\"] != \\\"active\\\" or not fact[\\\"provenance_session_ids\\\"]:\\n        return False\\n    excluded = set(fixture_item[\\\"exclude_session_ids\\\"])\\n    cutoff = fixture_item[\\\"cutoff\\\"]\\n    for session_id in fact[\\\"provenance_session_ids\\\"]:\\n        if session_id in excluded:\\n            return False\\n        created = session_dates.get(session_id)\\n        if created is None or not created < cutoff:\\n            return False\\n    return True\\n\\n\\ndef _validate_judgment_eligibility(\\n    dataset: dict[str, Any],\\n    fixture_index: dict[str, Any],\\n    membership: dict[str, Any],\\n) -> None:\\n    for query_id in dataset[\\\"order\\\"]:\\n        fixture_item = fixture_index[query_id]\\n        for fact_id in dataset[\\\"items\\\"][query_id][\\\"judgments\\\"]:\\n            judgment = dataset[\\\"items\\\"][query_id][\\\"judgments\\\"][fact_id]\\n            fact = membership[\\\"fact_index\\\"].get(fact_id)\\n            if fact is None:\\n                raise EvaluationError(\\\"dataset judgment is absent from source membership\\\")\\n            if judgment[\\\"fact_sha256\\\"] != fact[\\\"fact_sha256\\\"]:\\n                raise EvaluationError(\\n                    \\\"dataset judgment fact SHA-256 differs from source membership\\\"\\n                )\\n            if not _eligible(fact, fixture_item, membership[\\\"session_dates\\\"]):\\n                raise EvaluationError(\\n                    \\\"dataset judgment is outside authenticated temporal eligibility\\\"\\n                )\\n\\n\\ndef _build_input_bindings(\\n    engine_matrix_raw: bytes,\\n    engine_matrix: dict[str, Any],\\n    engine_pins_raw: bytes,\\n    engine_pins: dict[str, Any],\\n    producer_identity_raw: bytes,\\n    producer_identity: dict[str, Any],\\n    fixture: dict[str, Any],\\n    dataset_raw: bytes,\\n    dataset: dict[str, Any],\\n    membership_raw: bytes,\\n    membership: dict[str, Any],\\n) -> dict[str, Any]:\\n    return {\\n        \\\"engine_matrix_sha256\\\": sha256_bytes(engine_matrix_raw),\\n        \\\"matrix_id\\\": _safe_id(engine_matrix.get(\\\"matrix_id\\\"), \\\"matrix_id\\\"),\\n        \\\"engine_pins_sha256\\\": sha256_bytes(engine_pins_raw),\\n        \\\"pin_set_id\\\": _safe_id(engine_pins.get(\\\"pin_set_id\\\"), \\\"pin_set_id\\\"),\\n        \\\"fixture_sha256\\\": _sha256(fixture.get(\\\"fixture_sha256\\\"), \\\"fixture_sha256\\\"),\\n        \\\"fixture_id\\\": _safe_id(fixture.get(\\\"fixture_id\\\"), \\\"fixture_id\\\"),\\n        \\\"dataset_sha256\\\": sha256_bytes(dataset_raw),\\n        \\\"dataset_id\\\": _safe_id(dataset.get(\\\"dataset_id\\\"), \\\"dataset_id\\\"),\\n        \\\"source_membership_sha256\\\": sha256_bytes(membership_raw),\\n        \\\"eligibility_membership_root_sha256\\\": _sha256(\\n            membership.get(\\\"eligibility_membership_root_sha256\\\"),\\n            \\\"eligibility membership root\\\",\\n        ),\\n        \\\"producer_identity_file_sha256\\\": sha256_bytes(producer_identity_raw),\\n        \\\"producer_identity_sha256\\\": producer_identity[\\\"producer_identity_sha256\\\"],\\n        \\\"k_candidates\\\": list(K_CANDIDATES),\\n    }\\n\\n\\ndef _validate_input_bindings(value: Any) -> dict[str, Any]:\\n    bindings = _object(value, \\\"ranked run input bindings\\\")\\n    _exact_fields(bindings, INPUT_BINDING_FIELDS, \\\"ranked run input bindings\\\")\\n    for field in INPUT_BINDING_SHA_FIELDS:\\n        _external_sha256(bindings.get(field), f\\\"ranked run input binding {field}\\\")\\n    for field in INPUT_BINDING_SELF_HASH_FIELDS:\\n        _sha256(bindings.get(field), f\\\"ranked run input binding {field}\\\")\\n    for field in (\\\"matrix_id\\\", \\\"pin_set_id\\\", \\\"fixture_id\\\", \\\"dataset_id\\\"):\\n        _safe_id(bindings.get(field), f\\\"ranked run input binding {field}\\\")\\n    if bindings.get(\\\"k_candidates\\\") != list(K_CANDIDATES):\\n        raise EvaluationError(\\\"ranked run input binding K candidates differ\\\")\\n    return copy.deepcopy(bindings)\\n\\n\\ndef _validate_producer_identity(value: Any) -> dict[str, Any]:\\n    identity = _object(value, \\\"producer identity\\\")\\n    _exact_fields(identity, PRODUCER_IDENTITY_FIELDS, \\\"producer identity\\\")\\n    if (\\n        identity.get(\\\"schema_version\\\") != SCHEMA_VERSION\\n        or identity.get(\\\"schema\\\") != PRODUCER_IDENTITY_SCHEMA\\n    ):\\n        raise EvaluationError(\\\"producer identity schema is invalid\\\")\\n    _safe_id(identity.get(\\\"producer_id\\\"), \\\"producer identity producer_id\\\")\\n    for field in (\\\"runner_sha256\\\", \\\"producer_code_sha256\\\"):\\n        _external_sha256(identity.get(field), f\\\"producer identity {field}\\\")\\n    for policy in (\\\"ranking_result_metadata\\\", \\\"token_estimation\\\", \\\"serialization\\\"):\\n        _safe_id(\\n            identity.get(f\\\"{policy}_policy_id\\\"),\\n            f\\\"producer identity {policy}_policy_id\\\",\\n        )\\n        _external_sha256(\\n            identity.get(f\\\"{policy}_policy_sha256\\\"),\\n            f\\\"producer identity {policy}_policy_sha256\\\",\\n        )\\n    supplied_hash = _sha256(\\n        identity.get(\\\"producer_identity_sha256\\\"), \\\"producer identity self-hash\\\"\\n    )\\n    if _self_hash(identity, \\\"producer_identity_sha256\\\") != supplied_hash:\\n        raise EvaluationError(\\\"producer identity self-hash mismatch\\\")\\n    return copy.deepcopy(identity)\\n\\n\\ndef _engine_arms(engine_matrix: dict[str, Any]) -> tuple[list[str], dict[str, dict[str, Any]]]:\\n    arms_value = _array(engine_matrix.get(\\\"arms\\\"), \\\"engine matrix arms\\\")\\n    order: list[str] = []\\n    by_id: dict[str, dict[str, Any]] = {}\\n    for index, raw in enumerate(arms_value):\\n        arm = _object(raw, f\\\"engine matrix arm[{index}]\\\")\\n        arm_id = _safe_id(arm.get(\\\"id\\\"), f\\\"engine matrix arm[{index}].id\\\")\\n        if arm_id in by_id:\\n            raise EvaluationError(\\\"engine matrix contains duplicate arm IDs\\\")\\n        semantic = arm.get(\\\"semantic\\\")\\n        if not isinstance(semantic, bool):\\n            raise EvaluationError(\\\"engine matrix arm semantic must be boolean\\\")\\n        by_id[arm_id] = {\\n            \\\"id\\\": arm_id,\\n            \\\"semantic\\\": semantic,\\n            \\\"effective_engine_required\\\": _safe_id(\\n                arm.get(\\\"effective_engine_required\\\"), \\\"effective engine requirement\\\"\\n            ),\\n            \\\"namespace\\\": _safe_id(arm.get(\\\"namespace\\\"), \\\"engine namespace\\\"),\\n        }\\n        order.append(arm_id)\\n    if not order:\\n        raise EvaluationError(\\\"engine matrix must contain arms\\\")\\n    return order, by_id\\n\\n\\ndef _validate_engine_identity(\\n    value: Any,\\n    arm_contracts: dict[str, dict[str, Any]],\\n    engine_pins: dict[str, Any],\\n) -> dict[str, Any]:\\n    identity = _object(value, \\\"engine identity\\\")\\n    _exact_fields(identity, ENGINE_IDENTITY_FIELDS, \\\"engine identity\\\")\\n    arm_id = _safe_id(identity.get(\\\"arm_id\\\"), \\\"engine identity arm_id\\\")\\n    contract = arm_contracts.get(arm_id)\\n    if contract is None:\\n        raise EvaluationError(\\\"engine identity arm is absent from the matrix\\\")\\n    if identity.get(\\\"effective_engine\\\") != contract[\\\"effective_engine_required\\\"]:\\n        raise EvaluationError(\\\"effective engine differs from matrix\\\")\\n    if identity.get(\\\"semantic\\\") is not contract[\\\"semantic\\\"]:\\n        raise EvaluationError(\\\"semantic identity differs from matrix\\\")\\n    if identity.get(\\\"vector_namespace\\\") != contract[\\\"namespace\\\"]:\\n        raise EvaluationError(\\\"vector namespace differs from matrix\\\")\\n    if identity.get(\\\"fallback_used\\\") is not False:\\n        raise EvaluationError(\\\"engine fallback invalidates the ranked run\\\")\\n    binary = _object(engine_pins.get(\\\"binary\\\"), \\\"engine pins binary\\\")\\n    identity_binary_sha256 = _external_sha256(\\n        identity.get(\\\"binary_sha256\\\"), \\\"engine identity binary_sha256\\\"\\n    )\\n    if identity_binary_sha256 != _external_sha256(\\n        binary.get(\\\"binary_sha256\\\"), \\\"pinned binary\\\"\\n    ):\\n        raise EvaluationError(\\\"binary identity differs from engine pins\\\")\\n    if identity.get(\\\"binary_size_bytes\\\") != _positive_int(\\n        binary.get(\\\"binary_size_bytes\\\"), \\\"pinned binary size\\\"\\n    ):\\n        raise EvaluationError(\\\"binary size differs from engine pins\\\")\\n    engines = _object(engine_pins.get(\\\"engines\\\"), \\\"engine pins engines\\\")\\n    pinned_engine = _object(engines.get(arm_id), \\\"pinned engine identity\\\")\\n    dimension = pinned_engine.get(\\\"dimension\\\")\\n    if contract[\\\"semantic\\\"]:\\n        _external_sha256(\\n            identity.get(\\\"vector_artifact_sha256\\\"), \\\"vector artifact SHA-256\\\"\\n        )\\n        _positive_int(identity.get(\\\"vector_artifact_size_bytes\\\"), \\\"vector artifact size\\\")\\n        if identity.get(\\\"embedding_dimension\\\") != _positive_int(\\n            dimension, \\\"pinned embedding dimension\\\"\\n        ):\\n            raise EvaluationError(\\\"embedding dimension differs from engine pins\\\")\\n    elif any(\\n        identity.get(field) is not None\\n        for field in (\\n            \\\"vector_artifact_sha256\\\",\\n            \\\"vector_artifact_size_bytes\\\",\\n            \\\"embedding_dimension\\\",\\n        )\\n    ):\\n        raise EvaluationError(\\\"lexical engine must not claim a vector artifact\\\")\\n    return copy.deepcopy(identity)\\n\\n\\ndef _validate_telemetry(\\n    value: Any,\\n    *,\\n    active_count: int,\\n    eligible_count: int,\\n    delivered_count: int,\\n) -> dict[str, Any]:\\n    telemetry = _object(value, \\\"query telemetry\\\")\\n    _exact_fields(telemetry, TELEMETRY_FIELDS, \\\"query telemetry\\\")\\n    if _nonnegative_int(telemetry.get(\\\"active_fact_count\\\"), \\\"active_fact_count\\\") != active_count:\\n        raise EvaluationError(\\\"query active_fact_count differs from membership\\\")\\n    if (\\n        _nonnegative_int(telemetry.get(\\\"eligible_fact_count\\\"), \\\"eligible_fact_count\\\")\\n        != eligible_count\\n    ):\\n        raise EvaluationError(\\\"query eligible_fact_count differs from temporal policy\\\")\\n    if (\\n        _nonnegative_int(\\n            telemetry.get(\\\"temporal_exclusion_count\\\"), \\\"temporal_exclusion_count\\\"\\n        )\\n        != active_count - eligible_count\\n    ):\\n        raise EvaluationError(\\\"query temporal exclusion count differs\\\")\\n    if (\\n        _nonnegative_int(telemetry.get(\\\"delivered_count\\\"), \\\"delivered_count\\\")\\n        != delivered_count\\n    ):\\n        raise EvaluationError(\\\"query delivered_count differs from ordered results\\\")\\n    latency = _finite_nonnegative(telemetry.get(\\\"ranking_latency_ms\\\"), \\\"ranking_latency_ms\\\")\\n    result = copy.deepcopy(telemetry)\\n    result[\\\"ranking_latency_ms\\\"] = latency\\n    return result\\n\\n\\ndef _validate_run(\\n    value: Any,\\n    *,\\n    expected_bindings: dict[str, Any],\\n    expected_producer_identity: dict[str, Any],\\n    engine_matrix: dict[str, Any],\\n    engine_pins: dict[str, Any],\\n    fixture_index: dict[str, Any],\\n    fixture_order: list[str],\\n    dataset_index: dict[str, Any],\\n    membership: dict[str, Any],\\n) -> dict[str, Any]:\\n    run = _object(value, \\\"ranked run\\\")\\n    _exact_fields(run, RUN_FIELDS, \\\"ranked run\\\")\\n    if run.get(\\\"schema_version\\\") != SCHEMA_VERSION or run.get(\\\"schema\\\") != RANKED_RUN_SCHEMA:\\n        raise EvaluationError(\\\"ranked run schema identity is invalid\\\")\\n    run_id = _safe_id(run.get(\\\"run_id\\\"), \\\"run_id\\\")\\n    _timestamp(run.get(\\\"created_at\\\"), \\\"ranked run created_at\\\")\\n    supplied_hash = _sha256(run.get(\\\"run_sha256\\\"), \\\"run_sha256\\\")\\n    if _self_hash(run, \\\"run_sha256\\\") != supplied_hash:\\n        raise EvaluationError(\\\"ranked run self-hash mismatch\\\")\\n    bindings = _validate_input_bindings(run.get(\\\"input_bindings\\\"))\\n    if bindings != expected_bindings:\\n        raise EvaluationError(\\\"ranked run input bindings differ from authenticated inputs\\\")\\n    if run.get(\\\"k_candidates\\\") != list(K_CANDIDATES):\\n        raise EvaluationError(\\\"ranked run K candidates differ from the frozen contract\\\")\\n    aggregation = run.get(\\\"aggregation_rule\\\")\\n    if aggregation not in AGGREGATION_CANDIDATES:\\n        raise EvaluationError(\\\"ranked run aggregation rule is unsupported\\\")\\n    producer_identity = _validate_producer_identity(run.get(\\\"producer_identity\\\"))\\n    if producer_identity != expected_producer_identity:\\n        raise EvaluationError(\\n            \\\"ranked run producer identity differs from bound producer contract\\\"\\n        )\\n    _, arm_contracts = _engine_arms(engine_matrix)\\n    identity = _validate_engine_identity(run.get(\\\"engine_identity\\\"), arm_contracts, engine_pins)\\n    query_values = _array(run.get(\\\"queries\\\"), \\\"ranked run queries\\\")\\n    if len(query_values) != len(fixture_order):\\n        raise EvaluationError(\\\"ranked run query count differs from fixture\\\")\\n    queries: list[dict[str, Any]] = []\\n    seen_queries: set[str] = set()\\n    membership_index = membership[\\\"fact_index\\\"]\\n    for index, raw in enumerate(query_values):\\n        query = _object(raw, f\\\"ranked run query[{index}]\\\")\\n        _exact_fields(query, QUERY_FIELDS, f\\\"ranked run query[{index}]\\\")\\n        query_id = _safe_id(query.get(\\\"query_id\\\"), f\\\"ranked run query[{index}].query_id\\\")\\n        if query_id in seen_queries:\\n            raise EvaluationError(\\\"ranked run contains duplicate query IDs\\\")\\n        seen_queries.add(query_id)\\n        if query_id != fixture_order[index]:\\n            raise EvaluationError(\\\"ranked run query order differs from fixture\\\")\\n        fixture_item = fixture_index[query_id]\\n        dataset_item = dataset_index[query_id]\\n        if (\\n            query.get(\\\"task_id\\\") != fixture_item[\\\"task_id\\\"]\\n            or query.get(\\\"query_source\\\") != fixture_item[\\\"query_source\\\"]\\n            or query.get(\\\"null_query\\\") is not fixture_item[\\\"null_query\\\"]\\n        ):\\n            raise EvaluationError(\\\"ranked run query metadata differs from fixture\\\")\\n        eligible_ids = {\\n            fact[\\\"fact_id\\\"]\\n            for fact in membership[\\\"facts\\\"]\\n            if _eligible(fact, fixture_item, membership[\\\"session_dates\\\"])\\n        }\\n        results_raw = _array(query.get(\\\"ordered_results\\\"), \\\"ordered results\\\")\\n        if len(results_raw) > max(K_CANDIDATES):\\n            raise EvaluationError(\\\"ranked run retains more results than the maximum K\\\")\\n        results: list[dict[str, Any]] = []\\n        seen_facts: set[str] = set()\\n        for result_index, raw_result in enumerate(results_raw):\\n            result = _object(raw_result, f\\\"ordered result[{result_index}]\\\")\\n            _exact_fields(result, RESULT_FIELDS, f\\\"ordered result[{result_index}]\\\")\\n            fact_id = _safe_id(result.get(\\\"fact_id\\\"), f\\\"ordered result[{result_index}].fact_id\\\")\\n            if fact_id in seen_facts:\\n                raise EvaluationError(\\\"ranked run contains duplicate result fact IDs\\\")\\n            seen_facts.add(fact_id)\\n            fact = membership_index.get(fact_id)\\n            if fact is None:\\n                raise EvaluationError(\\\"ranked run result is absent from source membership\\\")\\n            fact_sha256 = _external_sha256(\\n                result.get(\\\"fact_sha256\\\"),\\n                f\\\"ordered result[{result_index}].fact_sha256\\\",\\n            )\\n            if fact_sha256 != fact[\\\"fact_sha256\\\"]:\\n                raise EvaluationError(\\n                    \\\"ranked result fact SHA-256 differs from source membership\\\"\\n                )\\n            derived_eligible = fact_id in eligible_ids\\n            if result.get(\\\"eligible\\\") is not derived_eligible:\\n                raise EvaluationError(\\\"ranked result eligibility differs from authenticated policy\\\")\\n            if not derived_eligible:\\n                raise EvaluationError(\\\"ranked run contains temporal leakage\\\")\\n            kind = _safe_id(result.get(\\\"kind\\\"), f\\\"ordered result[{result_index}].kind\\\")\\n            cluster_id = _safe_id(\\n                result.get(\\\"cluster_id\\\"), f\\\"ordered result[{result_index}].cluster_id\\\"\\n            )\\n            judgment = dataset_item[\\\"judgments\\\"].get(fact_id)\\n            if judgment is not None and (\\n                judgment[\\\"kind\\\"] != kind or judgment[\\\"cluster_id\\\"] != cluster_id\\n            ):\\n                raise EvaluationError(\\\"ranked result metadata differs from reviewed judgment\\\")\\n            results.append(\\n                {\\n                    \\\"fact_id\\\": fact_id,\\n                    \\\"fact_sha256\\\": fact_sha256,\\n                    \\\"kind\\\": kind,\\n                    \\\"cluster_id\\\": cluster_id,\\n                    \\\"eligible\\\": True,\\n                    \\\"estimated_tokens\\\": _positive_int(\\n                        result.get(\\\"estimated_tokens\\\"),\\n                        f\\\"ordered result[{result_index}].estimated_tokens\\\",\\n                    ),\\n                }\\n            )\\n        telemetry = _validate_telemetry(\\n            query.get(\\\"telemetry\\\"),\\n            active_count=membership[\\\"active_fact_count\\\"],\\n            eligible_count=len(eligible_ids),\\n            delivered_count=len(results),\\n        )\\n        queries.append(\\n            {\\n                \\\"query_id\\\": query_id,\\n                \\\"task_id\\\": fixture_item[\\\"task_id\\\"],\\n                \\\"query_source\\\": fixture_item[\\\"query_source\\\"],\\n                \\\"null_query\\\": fixture_item[\\\"null_query\\\"],\\n                \\\"telemetry\\\": telemetry,\\n                \\\"ordered_results\\\": results,\\n            }\\n        )\\n    return {\\n        \\\"schema_version\\\": SCHEMA_VERSION,\\n        \\\"schema\\\": RANKED_RUN_SCHEMA,\\n        \\\"run_id\\\": run_id,\\n        \\\"created_at\\\": run[\\\"created_at\\\"],\\n        \\\"input_bindings\\\": copy.deepcopy(bindings),\\n        \\\"producer_identity\\\": producer_identity,\\n        \\\"engine_identity\\\": identity,\\n        \\\"aggregation_rule\\\": aggregation,\\n        \\\"k_candidates\\\": list(K_CANDIDATES),\\n        \\\"queries\\\": queries,\\n        \\\"run_sha256\\\": supplied_hash,\\n    }\\n\\n\\ndef _recall(results: list[dict[str, Any]], positives: set[str], cutoff: int) -> float:\\n    if not positives:\\n        return 0.0\\n    hits = {result[\\\"fact_id\\\"] for result in results[:cutoff]} & positives\\n    return _ratio(len(hits), len(positives))\\n\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839520.38548}}}
