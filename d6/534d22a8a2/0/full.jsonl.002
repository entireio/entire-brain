{"timestamp":"2026-09-19T17:34:41.914Z","ordinal":7388,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","item":{"type":"CommandExecution","id":"exec-267a4b66-de8d-44d5-9f3d-a597b5f8ac67","process_id":"54842","command":["/bin/zsh","-lc","sed -n '481,920p' benchmarks/agent-brain/confirmatory/test_negative_control_cache_archive_v1.py; sed -n '1,280p' benchmarks/agent-brain/confirmatory/negative_control_cache_bundle_v2.py"],"cwd":"file:///Users/thomi/.codex/worktrees/5d33/entire-brain","parsed_cmd":[{"type":"read","cmd":"sed -n '481,920p' benchmarks/agent-brain/confirmatory/test_negative_control_cache_archive_v1.py","name":"test_negative_control_cache_archive_v1.py","path":"benchmarks/agent-brain/confirmatory/test_negative_control_cache_archive_v1.py"},{"type":"read","cmd":"sed -n '1,280p' benchmarks/agent-brain/confirmatory/negative_control_cache_bundle_v2.py","name":"negative_control_cache_bundle_v2.py","path":"benchmarks/agent-brain/confirmatory/negative_control_cache_bundle_v2.py"}],"source":"unified_exec_startup","status":"completed","stdout":"            self.archive_path.write_bytes(self.archive_raw)\n\n    def test_archive_path_rejects_symlink_hardlink_fifo_and_race(self) -> None:\n        target = self.root / \"alternate-archive-source.opaque\"\n        target.write_bytes(self.archive_raw)\n\n        self.archive_path.unlink()\n        self.archive_path.symlink_to(target)\n        with self.assertRaises(cache.CacheArchiveVerificationError):\n            self.verify()\n        self.archive_path.unlink()\n\n        os.link(target, self.archive_path)\n        with self.assertRaisesRegex(\n            cache.CacheArchiveVerificationError,\n            \"link\",\n        ):\n            self.verify()\n        self.archive_path.unlink()\n        target.unlink()\n\n        os.mkfifo(self.archive_path)\n        with self.assertRaisesRegex(\n            cache.CacheArchiveVerificationError,\n            \"regular file\",\n        ):\n            self.verify()\n        self.archive_path.unlink()\n        self.archive_path.write_bytes(self.archive_raw)\n\n        original_read = cache.os.read\n        archive_identity = self.archive_path.stat()\n        replacement = b\"x\" * len(self.archive_raw)\n        changed = False\n\n        def mutate_archive_after_read(descriptor: int, byte_count: int) -> bytes:\n            nonlocal changed\n            chunk = original_read(descriptor, byte_count)\n            metadata = os.fstat(descriptor)\n            if (\n                chunk\n                and not changed\n                and metadata.st_dev == archive_identity.st_dev\n                and metadata.st_ino == archive_identity.st_ino\n            ):\n                changed = True\n                self.archive_path.write_bytes(replacement)\n            return chunk\n\n        with (\n            mock.patch.object(\n                cache.os,\n                \"read\",\n                side_effect=mutate_archive_after_read,\n            ),\n            self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError,\n                \"changed while being read\",\n            ),\n        ):\n            self.verify()\n\n    def test_noncanonical_manifest_bytes_fail_even_when_material_binds_them(self) -> None:\n        noncanonical = cache._canonical_bytes(self.manifest)\n        self.manifest_path.write_bytes(noncanonical)\n        dependencies, contract = self.rebind_manifest(\n            self.manifest,\n            noncanonical,\n        )\n        with self.assertRaisesRegex(\n            cache.CacheArchiveVerificationError,\n            \"canonical\",\n        ):\n            self.verify(dependencies=dependencies, contract=contract)\n\n    def test_manifest_self_inventory_count_and_plan_bindings_fail_closed(self) -> None:\n        cases: list[\n            tuple[\n                str,\n                Callable[[dict[str, Any]], None],\n                bool,\n            ]\n        ] = [\n            (\n                \"self-hash\",\n                _mutate_manifest_without_resealing,\n                True,\n            ),\n            (\n                \"inventory\",\n                _mutate_manifest_inventory,\n                True,\n            ),\n            (\n                \"count\",\n                _mutate_manifest_count,\n                False,\n            ),\n            (\n                \"plan\",\n                _mutate_manifest_plan_binding,\n                True,\n            ),\n        ]\n        for label, mutate, copy_content_fields in cases:\n            changed = copy.deepcopy(self.manifest)\n            mutate(changed)\n            raw = gate._render(changed)\n            self.manifest_path.write_bytes(raw)\n            dependencies, contract = self.rebind_manifest(\n                changed,\n                raw,\n                copy_content_fields=copy_content_fields,\n            )\n            with self.subTest(label=label), self.assertRaises(\n                cache.CacheArchiveVerificationError\n            ):\n                self.verify(dependencies=dependencies, contract=contract)\n            self.manifest_path.write_bytes(self.manifest_raw)\n\n\nclass RawFileIdentityPrimitiveTest(unittest.TestCase):\n    def test_stream_identity_rejects_size_symlink_fifo_and_in_place_race(self) -> None:\n        with tempfile.TemporaryDirectory() as temporary_name:\n            root = pathlib.Path(temporary_name).resolve(strict=True)\n            regular = root / \"archive.opaque\"\n            before = b\"before-opaque-cache-bytes\"\n            after = b\"after--opaque-cache-bytes\"\n            self.assertEqual(len(before), len(after))\n            regular.write_bytes(before)\n\n            self.assertEqual(\n                cache._stream_identity(\n                    regular, maximum=len(before), label=\"fixture archive\"\n                ),\n                {\"byte_count\": len(before), \"sha256\": cache._sha256(before)},\n            )\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError, \"outside the byte ceiling\"\n            ):\n                cache._stream_identity(\n                    regular, maximum=len(before) - 1, label=\"fixture archive\"\n                )\n\n            symlink = root / \"archive-link.opaque\"\n            symlink.symlink_to(regular)\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError, \"cannot open\"\n            ):\n                cache._stream_identity(\n                    symlink, maximum=len(before), label=\"fixture symlink\"\n                )\n\n            hardlink = root / \"archive-hardlink.opaque\"\n            os.link(regular, hardlink)\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError, \"link\"\n            ):\n                cache._stream_identity(\n                    hardlink, maximum=len(before), label=\"fixture hardlink\"\n                )\n            hardlink.unlink()\n\n            fifo = root / \"archive-fifo.opaque\"\n            os.mkfifo(fifo)\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError, \"not a regular file\"\n            ):\n                cache._stream_identity(\n                    fifo, maximum=len(before), label=\"fixture FIFO\"\n                )\n\n            original_read = cache.os.read\n            changed = False\n\n            def mutate_after_read(descriptor: int, byte_count: int) -> bytes:\n                nonlocal changed\n                chunk = original_read(descriptor, byte_count)\n                if chunk and not changed:\n                    changed = True\n                    regular.write_bytes(after)\n                return chunk\n\n            regular.write_bytes(before)\n            with (\n                mock.patch.object(cache.os, \"read\", side_effect=mutate_after_read),\n                self.assertRaisesRegex(\n                    cache.CacheArchiveVerificationError,\n                    \"changed while being read\",\n                ),\n            ):\n                cache._stream_identity(\n                    regular, maximum=len(before), label=\"raced fixture archive\"\n                )\n\n    def test_descriptor_relative_open_rejects_or_outlives_ancestor_symlinks(self) -> None:\n        with tempfile.TemporaryDirectory() as temporary_name:\n            root = pathlib.Path(temporary_name).resolve(strict=True)\n            outside = root / \"outside\"\n            outside.mkdir()\n            (outside / \"archive.opaque\").write_bytes(b\"outside bytes\")\n            (outside / \"nested\").mkdir()\n            (outside / \"nested\" / \"archive.opaque\").write_bytes(\n                b\"outside swapped bytes\"\n            )\n\n            linked_parent = root / \"linked-parent\"\n            linked_parent.symlink_to(outside, target_is_directory=True)\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError,\n                \"cannot open\",\n            ):\n                cache._stream_identity(\n                    linked_parent / \"archive.opaque\",\n                    maximum=1024,\n                    label=\"ancestor symlink fixture\",\n                )\n\n            victim_parent = root / \"victim-parent\"\n            nested = victim_parent / \"nested\"\n            nested.mkdir(parents=True)\n            inside_raw = b\"descriptor-bound inside bytes\"\n            (nested / \"archive.opaque\").write_bytes(inside_raw)\n            attacked_path = victim_parent / \"nested\" / \"archive.opaque\"\n            held_parent = root / \"held-original-parent\"\n            original_open = cache.os.open\n            swapped = False\n\n            def swap_after_parent_open(\n                path: Any,\n                flags: int,\n                mode: int = 0o777,\n                *,\n                dir_fd: int | None = None,\n            ) -> int:\n                nonlocal swapped\n                descriptor = original_open(path, flags, mode, dir_fd=dir_fd)\n                if path == \"victim-parent\" and not swapped:\n                    swapped = True\n                    victim_parent.rename(held_parent)\n                    victim_parent.symlink_to(outside, target_is_directory=True)\n                return descriptor\n\n            supported_dir_fd = set(cache.os.supports_dir_fd)\n            supported_dir_fd.add(swap_after_parent_open)\n            with (\n                mock.patch.object(cache.os, \"open\", new=swap_after_parent_open),\n                mock.patch.object(\n                    cache.os,\n                    \"supports_dir_fd\",\n                    supported_dir_fd,\n                ),\n            ):\n                observed = cache._stream_identity(\n                    attacked_path,\n                    maximum=1024,\n                    label=\"ancestor swap fixture\",\n                )\n            self.assertTrue(swapped)\n            self.assertEqual(\n                observed,\n                {\n                    \"byte_count\": len(inside_raw),\n                    \"sha256\": cache._sha256(inside_raw),\n                },\n            )\n\n    def test_bounded_json_rejects_oversize_duplicate_keys_and_floats(self) -> None:\n        with tempfile.TemporaryDirectory() as temporary_name:\n            root = pathlib.Path(temporary_name).resolve(strict=True)\n            oversized = root / \"oversized.json\"\n            oversized.write_bytes(b\"{}\")\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError,\n                \"exceeds the byte ceiling\",\n            ):\n                cache._read_bounded(\n                    oversized,\n                    maximum=1,\n                    label=\"oversized JSON fixture\",\n                )\n\n            duplicate = root / \"duplicate.json\"\n            duplicate.write_bytes(b'{\"profile\":\"a\",\"profile\":\"b\"}')\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError,\n                \"duplicate object key\",\n            ):\n                cache._read_json(\n                    duplicate,\n                    maximum=1024,\n                    label=\"duplicate JSON fixture\",\n                )\n\n            floating = root / \"floating.json\"\n            floating.write_bytes(b'{\"value\":1.5}')\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError,\n                \"floating-point\",\n            ):\n                cache._read_json(\n                    floating,\n                    maximum=1024,\n                    label=\"floating JSON fixture\",\n                )\n\n\nclass SourceOnlyDependencyTest(unittest.TestCase):\n    def test_forged_timestamp_valid_validator_bytecode_is_ignored(self) -> None:\n        with tempfile.TemporaryDirectory() as temporary_name:\n            root = pathlib.Path(temporary_name).resolve(strict=True)\n            source = root / \"draft202012.py\"\n            raw = cache.DRAFT202012_PATH.read_bytes()\n            source.write_bytes(raw)\n            fixed_mtime = 1_700_000_000\n            os.utime(source, (fixed_mtime, fixed_mtime))\n            metadata = source.stat()\n\n            forged_code = compile(\n                \"MARKER = 'forged-timestamp-cache-loaded'\\n\",\n                str(source),\n                \"exec\",\n            )\n            bytecode = pathlib.Path(importlib.util.cache_from_source(str(source)))\n            bytecode.parent.mkdir()\n            bytecode.write_bytes(\n                importlib.util.MAGIC_NUMBER\n                + struct.pack(\"<III\", 0, int(metadata.st_mtime), metadata.st_size)\n                + marshal.dumps(forged_code)\n            )\n\n            control = subprocess.run(\n                [\n                    sys.executable,\n                    \"-c\",\n                    \"import draft202012; print(draft202012.MARKER)\",\n                ],\n                check=True,\n                cwd=root,\n                env={\n                    \"LANG\": \"C\",\n                    \"LC_ALL\": \"C\",\n                    \"PATH\": \"/usr/bin:/bin\",\n                    \"PYTHONDONTWRITEBYTECODE\": \"1\",\n                    \"PYTHONPATH\": str(root),\n                },\n                stdout=subprocess.PIPE,\n                stderr=subprocess.PIPE,\n                text=True,\n            )\n            self.assertEqual(\n                control.stdout.strip(),\n                \"forged-timestamp-cache-loaded\",\n            )\n\n            with (\n                mock.patch.object(cache, \"DRAFT202012_PATH\", source),\n                mock.patch.object(\n                    cache,\n                    \"CHECKED_DRAFT202012_SHA256\",\n                    cache._sha256(raw),\n                ),\n                mock.patch.object(cache, \"CHECKED_DRAFT202012_SIZE\", len(raw)),\n                mock.patch.object(cache, \"_CHECKED_DRAFT_VALIDATOR\", None),\n            ):\n                checked = cache._checked_draft_validator()\n            self.assertFalse(hasattr(checked, \"MARKER\"))\n            self.assertEqual(\n                checked.DIALECT,\n                \"https://json-schema.org/draft/2020-12/schema\",\n            )\n\n\nclass ProhibitedSurfaceTest(unittest.TestCase):\n    def test_source_has_no_archive_parser_extractor_network_or_process_surface(self) -> None:\n        source = pathlib.Path(cache.__file__).read_text(encoding=\"utf-8\")\n        tree = ast.parse(source)\n        imported_roots: set[str] = set()\n        called_names: set[str] = set()\n        for node in ast.walk(tree):\n            if isinstance(node, ast.Import):\n                imported_roots.update(alias.name.split(\".\", 1)[0] for alias in node.names)\n            elif isinstance(node, ast.ImportFrom) and node.module:\n                imported_roots.add(node.module.split(\".\", 1)[0])\n            elif isinstance(node, ast.Call):\n                if isinstance(node.func, ast.Name):\n                    called_names.add(node.func.id)\n                elif isinstance(node.func, ast.Attribute):\n                    called_names.add(node.func.attr)\n\n        self.assertTrue(\n            imported_roots.isdisjoint(\n                {\n                    \"compression\",\n                    \"http\",\n                    \"requests\",\n                    \"shutil\",\n                    \"socket\",\n                    \"subprocess\",\n                    \"tarfile\",\n                    \"urllib\",\n                    \"zstandard\",\n                }\n            ),\n            imported_roots,\n        )\n        self.assertTrue(\n            called_names.isdisjoint(\n                {\n                    \"Popen\",\n                    \"create_connection\",\n                    \"extract\",\n                    \"extractall\",\n                    \"posix_spawn\",\n                    \"run\",\n                    \"system\",\n                    \"unpack_archive\",\n                    \"urlopen\",\n                }\n            ),\n            called_names,\n        )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n#!/usr/bin/env python3\n\"\"\"Verify the frozen regular-file-only cache bundle without staging it.\n\nThe checked v1 material declaration is pending, so production ``verify``\ncurrently fails before opening either caller locator.  A future reviewed v1\nmaterial identity may enable two read-only passes over the same bundle file:\nraw identity first, then bounded structure and content verification.  This\nmodule cannot create a bundle or extract, stage, reserve, authorize, or execute\ncache material.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport copy\nimport hashlib\nimport json\nimport os\nimport pathlib\nimport stat\nimport struct\nimport sys\nimport tempfile\nimport types\nfrom collections.abc import Mapping, Sequence\nfrom typing import Any, cast\n\n\nROOT = pathlib.Path(__file__).parent\nV1_SOURCE_PATH = ROOT / \"negative_control_cache_archive_v1.py\"\nFORMAT_PATH = ROOT / \"negative-control-cache-bundle-format-v2.json\"\nVERIFIER_CONTRACT_PATH = ROOT / \"negative-control-cache-bundle-verifier-contract-v2.json\"\nFORMAT_SCHEMA_PATH = ROOT / \"schemas\" / \"negative-control-cache-bundle-format-v2.schema.json\"\nREPORT_SCHEMA_PATH = ROOT / \"schemas\" / \"negative-control-cache-bundle-verification-report-v2.schema.json\"\nVERIFIER_SCHEMA_PATH = ROOT / \"schemas\" / \"negative-control-cache-bundle-verifier-contract-v2.schema.json\"\n\nSCHEMA_VERSION = 2\nFORMAT_PROFILE = \"agent_brain_negative_control_cache_bundle_format_v2\"\nVERIFIER_PROFILE = \"agent_brain_negative_control_cache_bundle_verifier_contract_v2\"\nREPORT_PROFILE = \"agent_brain_negative_control_cache_bundle_verification_report_v2\"\nFORMAT_STATUS = \"wire_format_frozen_no_material_no_authority\"\nPENDING_STATUS = \"verifier_compiled_raw_material_source_review_pending_bundle_access_forbidden\"\nAPPROVED_STATUS = \"verifier_compiled_raw_material_source_reviewed_bundle_content_verification_only\"\nREPORT_STATUS = (\n    \"bundle_v2_same_descriptor_raw_identity_structure_manifest_bijection_and_\"\n    \"all_file_contents_verified_extraction_staging_execution_forbidden\"\n)\n\nCHECKED_V1_SOURCE_SHA256 = \"2f21da09c28cf2de62f808a6362f74fbc7aead07a04cfef96c15c93584540b94\"\nCHECKED_V1_SOURCE_SIZE = 68_195\n\n# Root fills these reviewed identities after the concurrently authored format\n# and schemas settle, before creating the checked verifier contract.\nCHECKED_FORMAT_FILE_SHA256 = \"970669197065a563fa0a09c281f671f5a3cd63061d6ff8f52da64926fa5ac406\"\nCHECKED_FORMAT_SHA256 = \"e2231e7fae7dfdad054c770d928b549bb996b4c452169cb22abea7f8f6f0ee59\"\nCHECKED_FORMAT_SCHEMA_SHA256 = \"95712ba76c36107f583a195167e6dea9d90ba81729fba10fa211096d277617d8\"\nCHECKED_REPORT_SCHEMA_SHA256 = \"3afd8fec9da54a8b7358b497031633bfeaf8c5df1f595347424769d4a30ec4ad\"\nCHECKED_VERIFIER_SCHEMA_SHA256 = \"eca24ad3f0a50f4a9dcbd9e106715db8fee449d4735eaeee87912a95e7c564bd\"\n\nHEADER_BYTES = 232\nRECORD_FIXED_BYTES = 52\nTRAILER_BYTES = 104\nHEADER_MAGIC = b\"ENTIRECACHEBND2\\0\"\nRECORD_MAGIC = b\"FILE\"\nTRAILER_MAGIC = b\"ENTIRECACHEEND2\\0\"\nFORMAT_VERSION = 2\nMAX_BUNDLE_BYTES = 2 * 1024 * 1024 * 1024\nMAX_UNPACKED_BYTES = 2 * 1024 * 1024 * 1024\nMAX_FILE_COUNT = 250_000\nMAX_PATH_BYTES = 1_024\nMIN_BUNDLE_BYTES = HEADER_BYTES + TRAILER_BYTES + 3 * (RECORD_FIXED_BYTES + 1 + 1)\nREAD_CHUNK_BYTES = 1_048_576\nREPOSITORY_ORDER = (\"entire-brain\", \"entire-db\", \"entire-graph\")\nREPOSITORY_IDS = {key: index for index, key in enumerate(REPOSITORY_ORDER)}\n\nMANIFEST_PROJECTION_DOMAIN = b\"entire-brain/cache-bundle-manifest-projection/v2\\0\"\nRECORDS_DOMAIN = b\"entire-brain/cache-bundle-records/v2\\0\"\nPREFIX_DOMAIN = b\"entire-brain/cache-bundle-prefix/v2\\0\"\n\nV1_PENDING_MATERIAL_STATUS = \"pending_source_review\"\nV1_APPROVED_MATERIAL_STATUS = \"approved_source_review_identity_only\"\nV1_PENDING_VERIFIER_STATUS = \"verifier_compiled_material_source_review_pending_execution_forbidden\"\nV1_APPROVED_VERIFIER_STATUS = (\n    \"verifier_compiled_material_source_reviewed_identity_only_execution_forbidden\"\n)\nV1_VERIFIER_CONTRACT_PATH = ROOT / \"negative-control-cache-archive-verifier-contract-v1.json\"\nMAX_FIXED_JSON_BYTES = 128 * 1024 * 1024\nMAX_SOURCE_BYTES = 4 * 1024 * 1024\nMAX_VERIFIER_CONTRACT_BYTES = 4 * 1024 * 1024\n\nAUTHORITY = {\n    \"atomic_consumption\": False,\n    \"benchmark_execution\": \"forbidden\",\n    \"bundle_creation\": \"forbidden\",\n    \"bundle_extraction\": \"forbidden\",\n    \"bundle_staging\": \"forbidden\",\n    \"candidate_execution\": \"forbidden\",\n    \"e0_runtime_binding\": False,\n    \"execution_authority\": False,\n    \"model_provider_execution\": \"forbidden\",\n    \"network_access\": \"forbidden\",\n    \"owner_approval\": False,\n    \"paid_execution\": \"forbidden\",\n}\n\nREPORT_AUTHORITY = {\n    \"atomic_consumption\": False,\n    \"benchmark_execution\": \"forbidden\",\n    \"candidate_execution\": \"forbidden\",\n    \"execution_authority\": False,\n    \"model_provider_execution\": \"forbidden\",\n    \"network_access\": \"forbidden\",\n    \"owner_approval\": False,\n    \"paid_execution\": \"forbidden\",\n}\n\nREPORT_SAFETY = {\n    \"bundle_creation\": False,\n    \"e0_runtime_binding\": False,\n    \"extraction\": False,\n    \"staged_tree_created\": False,\n    \"staging\": False,\n}\n\nREPORT_STRUCTURE = {\n    \"canonical_record_order\": True,\n    \"compression\": False,\n    \"exact_eof\": True,\n    \"header_verified\": True,\n    \"path_policy_verified\": True,\n    \"record_kind\": \"nonempty_regular_file_only\",\n    \"structurally_unrepresentable_verified\": [\n        \"explicit_directories\",\n        \"symlinks\",\n        \"hardlinks_or_inode_identity\",\n        \"fifos\",\n        \"sockets\",\n        \"block_devices\",\n        \"character_devices\",\n        \"other_devices\",\n        \"whiteouts\",\n        \"sparse_metadata\",\n        \"alternate_data_streams\",\n        \"resource_forks\",\n        \"compression\",\n        \"encryption\",\n        \"signatures\",\n        \"padding\",\n        \"concatenated_members\",\n        \"acls\",\n        \"extended_attributes\",\n        \"uid_gid\",\n        \"timestamps\",\n        \"mode_bits\",\n        \"executable_setuid_setgid_sticky_bits\",\n    ],\n    \"trailer_verified\": True,\n}\n\nFORMAT_BINDING = {\n    \"artifact_file\": FORMAT_PATH.name,\n    \"artifact_sha256\": CHECKED_FORMAT_FILE_SHA256,\n    \"format_contract_sha256\": CHECKED_FORMAT_SHA256,\n    \"profile\": FORMAT_PROFILE,\n    \"schema_file\": FORMAT_SCHEMA_PATH.name,\n    \"schema_sha256\": CHECKED_FORMAT_SCHEMA_SHA256,\n    \"schema_version\": SCHEMA_VERSION,\n    \"status\": FORMAT_STATUS,\n}\n\nMANIFEST_BINDING = {\n    \"manifest_profile\": \"content_addressed_offline_go_cache_seed_manifest_v1\",\n    \"manifest_schema_sha256\": \"37d3839411b2e30a99fdd7e93784d56f5fd525c0472717a24cc7b92213b98999\",\n    \"repository_key_semantics\": \"deterministic_ownership_and_provenance_only_not_destination_namespace\",\n    \"run_plan_artifact_sha256\": \"f55b6e22a25daf8016305304adf3b7ac8d31675281d97cfc9bb78cc76b619790\",\n    \"run_plan_sha256\": \"a47311fa1f4553f8085ebea6e8ddd003a4ea5d0b2d269d91bbcdd414134a248e\",\n    \"run_plan_schema_sha256\": \"294f77f165676bec6053e9637578ca22f048a887d2a978bbf8b8e300f21a2dad\",\n    \"shared_seed_semantics\": \"one_shared_union_seed_copied_unchanged_to_every_arm\",\n    \"toolchain_bindings_sha256\": \"e8240c5af77530079643593a7484cb0062408829bab76690b7f55d12176fc87c\",\n}\n\nRESIDUAL_GATES = [\n    \"successful_v2_bundle_content_verification_report\",\n    \"separate_safe_stager_with_go_cache_behavior_validation\",\n    \"trusted_apfs_observer_and_atomic_capacity_reservation\",\n    \"clean_detached_worktree_executor_and_first_parent_reversal_proof\",\n    \"attested_attempt_producer_and_classifier_integration\",\n    \"private_log_executor_integration_retention_and_aggregate_accounting\",\n    \"fail_closed_cleanup_interruption_attestation_and_no_receipt_guarantee\",\n    \"atomic_single_use_approval_consumption_and_execution_binding\",\n]\n\nRUNTIME_BINDINGS = {\n    \"actual_bundle_sha256\": None,\n    \"actual_manifest_sha256\": None,\n    \"bundle_verification_report_sha256\": None,\n    \"consumption_run_sha256\": None,\n    \"owner_approval_verification_report_sha256\": None,\n    \"raw_identity_report_sha256\": None,\n    \"staged_tree_sha256\": None,\n}\n\nVERIFICATION_POLICY = {\n    \"bundle_byte_count_formula\": \"232 + 104 + 52*N + sum(path_utf8_byte_count) + unpacked_byte_count\",\n    \"bundle_byte_count_max\": MAX_BUNDLE_BYTES,\n    \"bundle_descriptor\": \"one_held_single_link_stable_regular_file_descriptor_never_reopened\",\n    \"cli\": {\n        \"build\": \"build --output CONTRACT\",\n        \"check\": \"check\",\n        \"verify\": \"verify MANIFEST BUNDLE\",\n    },\n    \"file_count_max\": MAX_FILE_COUNT,\n    \"file_count_min\": 3,\n    \"json_depth_max\": 64,\n    \"json_nodes_max\": 1_270_000,\n    \"manifest_byte_count_max\": MAX_FIXED_JSON_BYTES,\n    \"no_payload_sized_allocations\": True,\n    \"pass_1\": \"raw_bundle_size_and_sha256_against_source_reviewed_v1_material_before_interpretation_then_fstat\",\n    \"pass_2\": \"rewind_same_descriptor_then_bounded_parse_stream_hash_manifest_bijection_exact_eof_then_fstat\",\n    \"production_commands_absent\": [\"pack\", \"extract\", \"stage\"],\n    \"report_persistence\": \"forbidden_stdout_only\",\n    \"stream_chunk_byte_count\": READ_CHUNK_BYTES,\n    \"successful_claim\": \"raw_identity_structure_manifest_bijection_and_every_regular_file_payload_sha256_only_not_staging_or_execution\",\n    \"unpacked_byte_count_max\": MAX_UNPACKED_BYTES,\n}\n\n_V1_MODULE: types.ModuleType | None = None\n\n\nclass CacheBundleVerificationError(RuntimeError):\n    \"\"\"Raised when a checked bundle identity or structural claim differs.\"\"\"\n\n\ndef _require(condition: bool, message: str) -> None:\n    if not condition:\n        raise CacheBundleVerificationError(message)\n\n\ndef _sha256(raw: bytes) -> str:\n    _require(type(raw) is bytes, \"SHA-256 input must be exact bytes\")\n    return hashlib.sha256(raw).hexdigest()\n\n\ndef _open_source_descriptor(path: pathlib.Path, *, label: str) -> tuple[int, list[int]]:\n    components = path.parts[1:] if path.is_absolute() else path.parts\n    _require(bool(components), f\"{label} path has no file component\")\n    _require(\n        all(component not in {\"\", \".\", \"..\"} and \"\\0\" not in component for component in components),\n        f\"{label} path contains traversal\",\n    )\n    _require(os.open in os.supports_dir_fd, \"descriptor-relative open is unavailable\")\n    file_flags = os.O_RDONLY\n    directory_flags = os.O_RDONLY\n    for name in (\"O_CLOEXEC\", \"O_NOFOLLOW\", \"O_NONBLOCK\"):\n        flag = getattr(os, name, None)\n        _require(type(flag) is int and flag != 0, f\"secure open flag {name} is unavailable\")\n        file_flags |= cast(int, flag)\n        directory_flags |= cast(int, flag)\n    directory = getattr(os, \"O_DIRECTORY\", None)\n    _require(type(directory) is int and directory != 0, \"O_DIRECTORY is unavailable\")\n    directory_flags |= cast(int, directory)\n    directories: list[int] = []\n    descriptor = -1\n    try:\n        current = os.open(\"/\" if path.is_absolute() else \".\", directory_flags)\n        directories.append(current)\n        for component in components[:-1]:\n            current = os.open(component, directory_flags, dir_fd=current)\n            directories.append(current)\n            _require(stat.S_ISDIR(os.fstat(current).st_mode), f\"{label} ancestor is not a directory\")\n        descriptor = os.open(components[-1], file_flags, dir_fd=current)\n        _require(stat.S_ISREG(os.fstat(descriptor).st_mode), f\"{label} is not a regular file\")\n        return descriptor, directories\n    except CacheBundleVerificationError:\n        if descriptor >= 0:\n            os.close(descriptor)\n        for current in reversed(directories):\n            os.close(current)\n        raise\n    except OSError as exc:\n","stderr":"","aggregated_output":"            self.archive_path.write_bytes(self.archive_raw)\n\n    def test_archive_path_rejects_symlink_hardlink_fifo_and_race(self) -> None:\n        target = self.root / \"alternate-archive-source.opaque\"\n        target.write_bytes(self.archive_raw)\n\n        self.archive_path.unlink()\n        self.archive_path.symlink_to(target)\n        with self.assertRaises(cache.CacheArchiveVerificationError):\n            self.verify()\n        self.archive_path.unlink()\n\n        os.link(target, self.archive_path)\n        with self.assertRaisesRegex(\n            cache.CacheArchiveVerificationError,\n            \"link\",\n        ):\n            self.verify()\n        self.archive_path.unlink()\n        target.unlink()\n\n        os.mkfifo(self.archive_path)\n        with self.assertRaisesRegex(\n            cache.CacheArchiveVerificationError,\n            \"regular file\",\n        ):\n            self.verify()\n        self.archive_path.unlink()\n        self.archive_path.write_bytes(self.archive_raw)\n\n        original_read = cache.os.read\n        archive_identity = self.archive_path.stat()\n        replacement = b\"x\" * len(self.archive_raw)\n        changed = False\n\n        def mutate_archive_after_read(descriptor: int, byte_count: int) -> bytes:\n            nonlocal changed\n            chunk = original_read(descriptor, byte_count)\n            metadata = os.fstat(descriptor)\n            if (\n                chunk\n                and not changed\n                and metadata.st_dev == archive_identity.st_dev\n                and metadata.st_ino == archive_identity.st_ino\n            ):\n                changed = True\n                self.archive_path.write_bytes(replacement)\n            return chunk\n\n        with (\n            mock.patch.object(\n                cache.os,\n                \"read\",\n                side_effect=mutate_archive_after_read,\n            ),\n            self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError,\n                \"changed while being read\",\n            ),\n        ):\n            self.verify()\n\n    def test_noncanonical_manifest_bytes_fail_even_when_material_binds_them(self) -> None:\n        noncanonical = cache._canonical_bytes(self.manifest)\n        self.manifest_path.write_bytes(noncanonical)\n        dependencies, contract = self.rebind_manifest(\n            self.manifest,\n            noncanonical,\n        )\n        with self.assertRaisesRegex(\n            cache.CacheArchiveVerificationError,\n            \"canonical\",\n        ):\n            self.verify(dependencies=dependencies, contract=contract)\n\n    def test_manifest_self_inventory_count_and_plan_bindings_fail_closed(self) -> None:\n        cases: list[\n            tuple[\n                str,\n                Callable[[dict[str, Any]], None],\n                bool,\n            ]\n        ] = [\n            (\n                \"self-hash\",\n                _mutate_manifest_without_resealing,\n                True,\n            ),\n            (\n                \"inventory\",\n                _mutate_manifest_inventory,\n                True,\n            ),\n            (\n                \"count\",\n                _mutate_manifest_count,\n                False,\n            ),\n            (\n                \"plan\",\n                _mutate_manifest_plan_binding,\n                True,\n            ),\n        ]\n        for label, mutate, copy_content_fields in cases:\n            changed = copy.deepcopy(self.manifest)\n            mutate(changed)\n            raw = gate._render(changed)\n            self.manifest_path.write_bytes(raw)\n            dependencies, contract = self.rebind_manifest(\n                changed,\n                raw,\n                copy_content_fields=copy_content_fields,\n            )\n            with self.subTest(label=label), self.assertRaises(\n                cache.CacheArchiveVerificationError\n            ):\n                self.verify(dependencies=dependencies, contract=contract)\n            self.manifest_path.write_bytes(self.manifest_raw)\n\n\nclass RawFileIdentityPrimitiveTest(unittest.TestCase):\n    def test_stream_identity_rejects_size_symlink_fifo_and_in_place_race(self) -> None:\n        with tempfile.TemporaryDirectory() as temporary_name:\n            root = pathlib.Path(temporary_name).resolve(strict=True)\n            regular = root / \"archive.opaque\"\n            before = b\"before-opaque-cache-bytes\"\n            after = b\"after--opaque-cache-bytes\"\n            self.assertEqual(len(before), len(after))\n            regular.write_bytes(before)\n\n            self.assertEqual(\n                cache._stream_identity(\n                    regular, maximum=len(before), label=\"fixture archive\"\n                ),\n                {\"byte_count\": len(before), \"sha256\": cache._sha256(before)},\n            )\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError, \"outside the byte ceiling\"\n            ):\n                cache._stream_identity(\n                    regular, maximum=len(before) - 1, label=\"fixture archive\"\n                )\n\n            symlink = root / \"archive-link.opaque\"\n            symlink.symlink_to(regular)\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError, \"cannot open\"\n            ):\n                cache._stream_identity(\n                    symlink, maximum=len(before), label=\"fixture symlink\"\n                )\n\n            hardlink = root / \"archive-hardlink.opaque\"\n            os.link(regular, hardlink)\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError, \"link\"\n            ):\n                cache._stream_identity(\n                    hardlink, maximum=len(before), label=\"fixture hardlink\"\n                )\n            hardlink.unlink()\n\n            fifo = root / \"archive-fifo.opaque\"\n            os.mkfifo(fifo)\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError, \"not a regular file\"\n            ):\n                cache._stream_identity(\n                    fifo, maximum=len(before), label=\"fixture FIFO\"\n                )\n\n            original_read = cache.os.read\n            changed = False\n\n            def mutate_after_read(descriptor: int, byte_count: int) -> bytes:\n                nonlocal changed\n                chunk = original_read(descriptor, byte_count)\n                if chunk and not changed:\n                    changed = True\n                    regular.write_bytes(after)\n                return chunk\n\n            regular.write_bytes(before)\n            with (\n                mock.patch.object(cache.os, \"read\", side_effect=mutate_after_read),\n                self.assertRaisesRegex(\n                    cache.CacheArchiveVerificationError,\n                    \"changed while being read\",\n                ),\n            ):\n                cache._stream_identity(\n                    regular, maximum=len(before), label=\"raced fixture archive\"\n                )\n\n    def test_descriptor_relative_open_rejects_or_outlives_ancestor_symlinks(self) -> None:\n        with tempfile.TemporaryDirectory() as temporary_name:\n            root = pathlib.Path(temporary_name).resolve(strict=True)\n            outside = root / \"outside\"\n            outside.mkdir()\n            (outside / \"archive.opaque\").write_bytes(b\"outside bytes\")\n            (outside / \"nested\").mkdir()\n            (outside / \"nested\" / \"archive.opaque\").write_bytes(\n                b\"outside swapped bytes\"\n            )\n\n            linked_parent = root / \"linked-parent\"\n            linked_parent.symlink_to(outside, target_is_directory=True)\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError,\n                \"cannot open\",\n            ):\n                cache._stream_identity(\n                    linked_parent / \"archive.opaque\",\n                    maximum=1024,\n                    label=\"ancestor symlink fixture\",\n                )\n\n            victim_parent = root / \"victim-parent\"\n            nested = victim_parent / \"nested\"\n            nested.mkdir(parents=True)\n            inside_raw = b\"descriptor-bound inside bytes\"\n            (nested / \"archive.opaque\").write_bytes(inside_raw)\n            attacked_path = victim_parent / \"nested\" / \"archive.opaque\"\n            held_parent = root / \"held-original-parent\"\n            original_open = cache.os.open\n            swapped = False\n\n            def swap_after_parent_open(\n                path: Any,\n                flags: int,\n                mode: int = 0o777,\n                *,\n                dir_fd: int | None = None,\n            ) -> int:\n                nonlocal swapped\n                descriptor = original_open(path, flags, mode, dir_fd=dir_fd)\n                if path == \"victim-parent\" and not swapped:\n                    swapped = True\n                    victim_parent.rename(held_parent)\n                    victim_parent.symlink_to(outside, target_is_directory=True)\n                return descriptor\n\n            supported_dir_fd = set(cache.os.supports_dir_fd)\n            supported_dir_fd.add(swap_after_parent_open)\n            with (\n                mock.patch.object(cache.os, \"open\", new=swap_after_parent_open),\n                mock.patch.object(\n                    cache.os,\n                    \"supports_dir_fd\",\n                    supported_dir_fd,\n                ),\n            ):\n                observed = cache._stream_identity(\n                    attacked_path,\n                    maximum=1024,\n                    label=\"ancestor swap fixture\",\n                )\n            self.assertTrue(swapped)\n            self.assertEqual(\n                observed,\n                {\n                    \"byte_count\": len(inside_raw),\n                    \"sha256\": cache._sha256(inside_raw),\n                },\n            )\n\n    def test_bounded_json_rejects_oversize_duplicate_keys_and_floats(self) -> None:\n        with tempfile.TemporaryDirectory() as temporary_name:\n            root = pathlib.Path(temporary_name).resolve(strict=True)\n            oversized = root / \"oversized.json\"\n            oversized.write_bytes(b\"{}\")\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError,\n                \"exceeds the byte ceiling\",\n            ):\n                cache._read_bounded(\n                    oversized,\n                    maximum=1,\n                    label=\"oversized JSON fixture\",\n                )\n\n            duplicate = root / \"duplicate.json\"\n            duplicate.write_bytes(b'{\"profile\":\"a\",\"profile\":\"b\"}')\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError,\n                \"duplicate object key\",\n            ):\n                cache._read_json(\n                    duplicate,\n                    maximum=1024,\n                    label=\"duplicate JSON fixture\",\n                )\n\n            floating = root / \"floating.json\"\n            floating.write_bytes(b'{\"value\":1.5}')\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError,\n                \"floating-point\",\n            ):\n                cache._read_json(\n                    floating,\n                    maximum=1024,\n                    label=\"floating JSON fixture\",\n                )\n\n\nclass SourceOnlyDependencyTest(unittest.TestCase):\n    def test_forged_timestamp_valid_validator_bytecode_is_ignored(self) -> None:\n        with tempfile.TemporaryDirectory() as temporary_name:\n            root = pathlib.Path(temporary_name).resolve(strict=True)\n            source = root / \"draft202012.py\"\n            raw = cache.DRAFT202012_PATH.read_bytes()\n            source.write_bytes(raw)\n            fixed_mtime = 1_700_000_000\n            os.utime(source, (fixed_mtime, fixed_mtime))\n            metadata = source.stat()\n\n            forged_code = compile(\n                \"MARKER = 'forged-timestamp-cache-loaded'\\n\",\n                str(source),\n                \"exec\",\n            )\n            bytecode = pathlib.Path(importlib.util.cache_from_source(str(source)))\n            bytecode.parent.mkdir()\n            bytecode.write_bytes(\n                importlib.util.MAGIC_NUMBER\n                + struct.pack(\"<III\", 0, int(metadata.st_mtime), metadata.st_size)\n                + marshal.dumps(forged_code)\n            )\n\n            control = subprocess.run(\n                [\n                    sys.executable,\n                    \"-c\",\n                    \"import draft202012; print(draft202012.MARKER)\",\n                ],\n                check=True,\n                cwd=root,\n                env={\n                    \"LANG\": \"C\",\n                    \"LC_ALL\": \"C\",\n                    \"PATH\": \"/usr/bin:/bin\",\n                    \"PYTHONDONTWRITEBYTECODE\": \"1\",\n                    \"PYTHONPATH\": str(root),\n                },\n                stdout=subprocess.PIPE,\n                stderr=subprocess.PIPE,\n                text=True,\n            )\n            self.assertEqual(\n                control.stdout.strip(),\n                \"forged-timestamp-cache-loaded\",\n            )\n\n            with (\n                mock.patch.object(cache, \"DRAFT202012_PATH\", source),\n                mock.patch.object(\n                    cache,\n                    \"CHECKED_DRAFT202012_SHA256\",\n                    cache._sha256(raw),\n                ),\n                mock.patch.object(cache, \"CHECKED_DRAFT202012_SIZE\", len(raw)),\n                mock.patch.object(cache, \"_CHECKED_DRAFT_VALIDATOR\", None),\n            ):\n                checked = cache._checked_draft_validator()\n            self.assertFalse(hasattr(checked, \"MARKER\"))\n            self.assertEqual(\n                checked.DIALECT,\n                \"https://json-schema.org/draft/2020-12/schema\",\n            )\n\n\nclass ProhibitedSurfaceTest(unittest.TestCase):\n    def test_source_has_no_archive_parser_extractor_network_or_process_surface(self) -> None:\n        source = pathlib.Path(cache.__file__).read_text(encoding=\"utf-8\")\n        tree = ast.parse(source)\n        imported_roots: set[str] = set()\n        called_names: set[str] = set()\n        for node in ast.walk(tree):\n            if isinstance(node, ast.Import):\n                imported_roots.update(alias.name.split(\".\", 1)[0] for alias in node.names)\n            elif isinstance(node, ast.ImportFrom) and node.module:\n                imported_roots.add(node.module.split(\".\", 1)[0])\n            elif isinstance(node, ast.Call):\n                if isinstance(node.func, ast.Name):\n                    called_names.add(node.func.id)\n                elif isinstance(node.func, ast.Attribute):\n                    called_names.add(node.func.attr)\n\n        self.assertTrue(\n            imported_roots.isdisjoint(\n                {\n                    \"compression\",\n                    \"http\",\n                    \"requests\",\n                    \"shutil\",\n                    \"socket\",\n                    \"subprocess\",\n                    \"tarfile\",\n                    \"urllib\",\n                    \"zstandard\",\n                }\n            ),\n            imported_roots,\n        )\n        self.assertTrue(\n            called_names.isdisjoint(\n                {\n                    \"Popen\",\n                    \"create_connection\",\n                    \"extract\",\n                    \"extractall\",\n                    \"posix_spawn\",\n                    \"run\",\n                    \"system\",\n                    \"unpack_archive\",\n                    \"urlopen\",\n                }\n            ),\n            called_names,\n        )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n#!/usr/bin/env python3\n\"\"\"Verify the frozen regular-file-only cache bundle without staging it.\n\nThe checked v1 material declaration is pending, so production ``verify``\ncurrently fails before opening either caller locator.  A future reviewed v1\nmaterial identity may enable two read-only passes over the same bundle file:\nraw identity first, then bounded structure and content verification.  This\nmodule cannot create a bundle or extract, stage, reserve, authorize, or execute\ncache material.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport copy\nimport hashlib\nimport json\nimport os\nimport pathlib\nimport stat\nimport struct\nimport sys\nimport tempfile\nimport types\nfrom collections.abc import Mapping, Sequence\nfrom typing import Any, cast\n\n\nROOT = pathlib.Path(__file__).parent\nV1_SOURCE_PATH = ROOT / \"negative_control_cache_archive_v1.py\"\nFORMAT_PATH = ROOT / \"negative-control-cache-bundle-format-v2.json\"\nVERIFIER_CONTRACT_PATH = ROOT / \"negative-control-cache-bundle-verifier-contract-v2.json\"\nFORMAT_SCHEMA_PATH = ROOT / \"schemas\" / \"negative-control-cache-bundle-format-v2.schema.json\"\nREPORT_SCHEMA_PATH = ROOT / \"schemas\" / \"negative-control-cache-bundle-verification-report-v2.schema.json\"\nVERIFIER_SCHEMA_PATH = ROOT / \"schemas\" / \"negative-control-cache-bundle-verifier-contract-v2.schema.json\"\n\nSCHEMA_VERSION = 2\nFORMAT_PROFILE = \"agent_brain_negative_control_cache_bundle_format_v2\"\nVERIFIER_PROFILE = \"agent_brain_negative_control_cache_bundle_verifier_contract_v2\"\nREPORT_PROFILE = \"agent_brain_negative_control_cache_bundle_verification_report_v2\"\nFORMAT_STATUS = \"wire_format_frozen_no_material_no_authority\"\nPENDING_STATUS = \"verifier_compiled_raw_material_source_review_pending_bundle_access_forbidden\"\nAPPROVED_STATUS = \"verifier_compiled_raw_material_source_reviewed_bundle_content_verification_only\"\nREPORT_STATUS = (\n    \"bundle_v2_same_descriptor_raw_identity_structure_manifest_bijection_and_\"\n    \"all_file_contents_verified_extraction_staging_execution_forbidden\"\n)\n\nCHECKED_V1_SOURCE_SHA256 = \"2f21da09c28cf2de62f808a6362f74fbc7aead07a04cfef96c15c93584540b94\"\nCHECKED_V1_SOURCE_SIZE = 68_195\n\n# Root fills these reviewed identities after the concurrently authored format\n# and schemas settle, before creating the checked verifier contract.\nCHECKED_FORMAT_FILE_SHA256 = \"970669197065a563fa0a09c281f671f5a3cd63061d6ff8f52da64926fa5ac406\"\nCHECKED_FORMAT_SHA256 = \"e2231e7fae7dfdad054c770d928b549bb996b4c452169cb22abea7f8f6f0ee59\"\nCHECKED_FORMAT_SCHEMA_SHA256 = \"95712ba76c36107f583a195167e6dea9d90ba81729fba10fa211096d277617d8\"\nCHECKED_REPORT_SCHEMA_SHA256 = \"3afd8fec9da54a8b7358b497031633bfeaf8c5df1f595347424769d4a30ec4ad\"\nCHECKED_VERIFIER_SCHEMA_SHA256 = \"eca24ad3f0a50f4a9dcbd9e106715db8fee449d4735eaeee87912a95e7c564bd\"\n\nHEADER_BYTES = 232\nRECORD_FIXED_BYTES = 52\nTRAILER_BYTES = 104\nHEADER_MAGIC = b\"ENTIRECACHEBND2\\0\"\nRECORD_MAGIC = b\"FILE\"\nTRAILER_MAGIC = b\"ENTIRECACHEEND2\\0\"\nFORMAT_VERSION = 2\nMAX_BUNDLE_BYTES = 2 * 1024 * 1024 * 1024\nMAX_UNPACKED_BYTES = 2 * 1024 * 1024 * 1024\nMAX_FILE_COUNT = 250_000\nMAX_PATH_BYTES = 1_024\nMIN_BUNDLE_BYTES = HEADER_BYTES + TRAILER_BYTES + 3 * (RECORD_FIXED_BYTES + 1 + 1)\nREAD_CHUNK_BYTES = 1_048_576\nREPOSITORY_ORDER = (\"entire-brain\", \"entire-db\", \"entire-graph\")\nREPOSITORY_IDS = {key: index for index, key in enumerate(REPOSITORY_ORDER)}\n\nMANIFEST_PROJECTION_DOMAIN = b\"entire-brain/cache-bundle-manifest-projection/v2\\0\"\nRECORDS_DOMAIN = b\"entire-brain/cache-bundle-records/v2\\0\"\nPREFIX_DOMAIN = b\"entire-brain/cache-bundle-prefix/v2\\0\"\n\nV1_PENDING_MATERIAL_STATUS = \"pending_source_review\"\nV1_APPROVED_MATERIAL_STATUS = \"approved_source_review_identity_only\"\nV1_PENDING_VERIFIER_STATUS = \"verifier_compiled_material_source_review_pending_execution_forbidden\"\nV1_APPROVED_VERIFIER_STATUS = (\n    \"verifier_compiled_material_source_reviewed_identity_only_execution_forbidden\"\n)\nV1_VERIFIER_CONTRACT_PATH = ROOT / \"negative-control-cache-archive-verifier-contract-v1.json\"\nMAX_FIXED_JSON_BYTES = 128 * 1024 * 1024\nMAX_SOURCE_BYTES = 4 * 1024 * 1024\nMAX_VERIFIER_CONTRACT_BYTES = 4 * 1024 * 1024\n\nAUTHORITY = {\n    \"atomic_consumption\": False,\n    \"benchmark_execution\": \"forbidden\",\n    \"bundle_creation\": \"forbidden\",\n    \"bundle_extraction\": \"forbidden\",\n    \"bundle_staging\": \"forbidden\",\n    \"candidate_execution\": \"forbidden\",\n    \"e0_runtime_binding\": False,\n    \"execution_authority\": False,\n    \"model_provider_execution\": \"forbidden\",\n    \"network_access\": \"forbidden\",\n    \"owner_approval\": False,\n    \"paid_execution\": \"forbidden\",\n}\n\nREPORT_AUTHORITY = {\n    \"atomic_consumption\": False,\n    \"benchmark_execution\": \"forbidden\",\n    \"candidate_execution\": \"forbidden\",\n    \"execution_authority\": False,\n    \"model_provider_execution\": \"forbidden\",\n    \"network_access\": \"forbidden\",\n    \"owner_approval\": False,\n    \"paid_execution\": \"forbidden\",\n}\n\nREPORT_SAFETY = {\n    \"bundle_creation\": False,\n    \"e0_runtime_binding\": False,\n    \"extraction\": False,\n    \"staged_tree_created\": False,\n    \"staging\": False,\n}\n\nREPORT_STRUCTURE = {\n    \"canonical_record_order\": True,\n    \"compression\": False,\n    \"exact_eof\": True,\n    \"header_verified\": True,\n    \"path_policy_verified\": True,\n    \"record_kind\": \"nonempty_regular_file_only\",\n    \"structurally_unrepresentable_verified\": [\n        \"explicit_directories\",\n        \"symlinks\",\n        \"hardlinks_or_inode_identity\",\n        \"fifos\",\n        \"sockets\",\n        \"block_devices\",\n        \"character_devices\",\n        \"other_devices\",\n        \"whiteouts\",\n        \"sparse_metadata\",\n        \"alternate_data_streams\",\n        \"resource_forks\",\n        \"compression\",\n        \"encryption\",\n        \"signatures\",\n        \"padding\",\n        \"concatenated_members\",\n        \"acls\",\n        \"extended_attributes\",\n        \"uid_gid\",\n        \"timestamps\",\n        \"mode_bits\",\n        \"executable_setuid_setgid_sticky_bits\",\n    ],\n    \"trailer_verified\": True,\n}\n\nFORMAT_BINDING = {\n    \"artifact_file\": FORMAT_PATH.name,\n    \"artifact_sha256\": CHECKED_FORMAT_FILE_SHA256,\n    \"format_contract_sha256\": CHECKED_FORMAT_SHA256,\n    \"profile\": FORMAT_PROFILE,\n    \"schema_file\": FORMAT_SCHEMA_PATH.name,\n    \"schema_sha256\": CHECKED_FORMAT_SCHEMA_SHA256,\n    \"schema_version\": SCHEMA_VERSION,\n    \"status\": FORMAT_STATUS,\n}\n\nMANIFEST_BINDING = {\n    \"manifest_profile\": \"content_addressed_offline_go_cache_seed_manifest_v1\",\n    \"manifest_schema_sha256\": \"37d3839411b2e30a99fdd7e93784d56f5fd525c0472717a24cc7b92213b98999\",\n    \"repository_key_semantics\": \"deterministic_ownership_and_provenance_only_not_destination_namespace\",\n    \"run_plan_artifact_sha256\": \"f55b6e22a25daf8016305304adf3b7ac8d31675281d97cfc9bb78cc76b619790\",\n    \"run_plan_sha256\": \"a47311fa1f4553f8085ebea6e8ddd003a4ea5d0b2d269d91bbcdd414134a248e\",\n    \"run_plan_schema_sha256\": \"294f77f165676bec6053e9637578ca22f048a887d2a978bbf8b8e300f21a2dad\",\n    \"shared_seed_semantics\": \"one_shared_union_seed_copied_unchanged_to_every_arm\",\n    \"toolchain_bindings_sha256\": \"e8240c5af77530079643593a7484cb0062408829bab76690b7f55d12176fc87c\",\n}\n\nRESIDUAL_GATES = [\n    \"successful_v2_bundle_content_verification_report\",\n    \"separate_safe_stager_with_go_cache_behavior_validation\",\n    \"trusted_apfs_observer_and_atomic_capacity_reservation\",\n    \"clean_detached_worktree_executor_and_first_parent_reversal_proof\",\n    \"attested_attempt_producer_and_classifier_integration\",\n    \"private_log_executor_integration_retention_and_aggregate_accounting\",\n    \"fail_closed_cleanup_interruption_attestation_and_no_receipt_guarantee\",\n    \"atomic_single_use_approval_consumption_and_execution_binding\",\n]\n\nRUNTIME_BINDINGS = {\n    \"actual_bundle_sha256\": None,\n    \"actual_manifest_sha256\": None,\n    \"bundle_verification_report_sha256\": None,\n    \"consumption_run_sha256\": None,\n    \"owner_approval_verification_report_sha256\": None,\n    \"raw_identity_report_sha256\": None,\n    \"staged_tree_sha256\": None,\n}\n\nVERIFICATION_POLICY = {\n    \"bundle_byte_count_formula\": \"232 + 104 + 52*N + sum(path_utf8_byte_count) + unpacked_byte_count\",\n    \"bundle_byte_count_max\": MAX_BUNDLE_BYTES,\n    \"bundle_descriptor\": \"one_held_single_link_stable_regular_file_descriptor_never_reopened\",\n    \"cli\": {\n        \"build\": \"build --output CONTRACT\",\n        \"check\": \"check\",\n        \"verify\": \"verify MANIFEST BUNDLE\",\n    },\n    \"file_count_max\": MAX_FILE_COUNT,\n    \"file_count_min\": 3,\n    \"json_depth_max\": 64,\n    \"json_nodes_max\": 1_270_000,\n    \"manifest_byte_count_max\": MAX_FIXED_JSON_BYTES,\n    \"no_payload_sized_allocations\": True,\n    \"pass_1\": \"raw_bundle_size_and_sha256_against_source_reviewed_v1_material_before_interpretation_then_fstat\",\n    \"pass_2\": \"rewind_same_descriptor_then_bounded_parse_stream_hash_manifest_bijection_exact_eof_then_fstat\",\n    \"production_commands_absent\": [\"pack\", \"extract\", \"stage\"],\n    \"report_persistence\": \"forbidden_stdout_only\",\n    \"stream_chunk_byte_count\": READ_CHUNK_BYTES,\n    \"successful_claim\": \"raw_identity_structure_manifest_bijection_and_every_regular_file_payload_sha256_only_not_staging_or_execution\",\n    \"unpacked_byte_count_max\": MAX_UNPACKED_BYTES,\n}\n\n_V1_MODULE: types.ModuleType | None = None\n\n\nclass CacheBundleVerificationError(RuntimeError):\n    \"\"\"Raised when a checked bundle identity or structural claim differs.\"\"\"\n\n\ndef _require(condition: bool, message: str) -> None:\n    if not condition:\n        raise CacheBundleVerificationError(message)\n\n\ndef _sha256(raw: bytes) -> str:\n    _require(type(raw) is bytes, \"SHA-256 input must be exact bytes\")\n    return hashlib.sha256(raw).hexdigest()\n\n\ndef _open_source_descriptor(path: pathlib.Path, *, label: str) -> tuple[int, list[int]]:\n    components = path.parts[1:] if path.is_absolute() else path.parts\n    _require(bool(components), f\"{label} path has no file component\")\n    _require(\n        all(component not in {\"\", \".\", \"..\"} and \"\\0\" not in component for component in components),\n        f\"{label} path contains traversal\",\n    )\n    _require(os.open in os.supports_dir_fd, \"descriptor-relative open is unavailable\")\n    file_flags = os.O_RDONLY\n    directory_flags = os.O_RDONLY\n    for name in (\"O_CLOEXEC\", \"O_NOFOLLOW\", \"O_NONBLOCK\"):\n        flag = getattr(os, name, None)\n        _require(type(flag) is int and flag != 0, f\"secure open flag {name} is unavailable\")\n        file_flags |= cast(int, flag)\n        directory_flags |= cast(int, flag)\n    directory = getattr(os, \"O_DIRECTORY\", None)\n    _require(type(directory) is int and directory != 0, \"O_DIRECTORY is unavailable\")\n    directory_flags |= cast(int, directory)\n    directories: list[int] = []\n    descriptor = -1\n    try:\n        current = os.open(\"/\" if path.is_absolute() else \".\", directory_flags)\n        directories.append(current)\n        for component in components[:-1]:\n            current = os.open(component, directory_flags, dir_fd=current)\n            directories.append(current)\n            _require(stat.S_ISDIR(os.fstat(current).st_mode), f\"{label} ancestor is not a directory\")\n        descriptor = os.open(components[-1], file_flags, dir_fd=current)\n        _require(stat.S_ISREG(os.fstat(descriptor).st_mode), f\"{label} is not a regular file\")\n        return descriptor, directories\n    except CacheBundleVerificationError:\n        if descriptor >= 0:\n            os.close(descriptor)\n        for current in reversed(directories):\n            os.close(current)\n        raise\n    except OSError as exc:\n","exit_code":0,"duration":{"secs":0,"nanos":2708},"formatted_output":"            self.archive_path.write_bytes(self.archive_raw)\n\n    def test_archive_path_rejects_symlink_hardlink_fifo_and_race(self) -> None:\n        target = self.root / \"alternate-archive-source.opaque\"\n        target.write_bytes(self.archive_raw)\n\n        self.archive_path.unlink()\n        self.archive_path.symlink_to(target)\n        with self.assertRaises(cache.CacheArchiveVerificationError):\n            self.verify()\n        self.archive_path.unlink()\n\n        os.link(target, self.archive_path)\n        with self.assertRaisesRegex(\n            cache.CacheArchiveVerificationError,\n            \"link\",\n        ):\n            self.verify()\n        self.archive_path.unlink()\n        target.unlink()\n\n        os.mkfifo(self.archive_path)\n        with self.assertRaisesRegex(\n            cache.CacheArchiveVerificationError,\n            \"regular file\",\n        ):\n            self.verify()\n        self.archive_path.unlink()\n        self.archive_path.write_bytes(self.archive_raw)\n\n        original_read = cache.os.read\n        archive_identity = self.archive_path.stat()\n        replacement = b\"x\" * len(self.archive_raw)\n        changed = False\n\n        def mutate_archive_after_read(descriptor: int, byte_count: int) -> bytes:\n            nonlocal changed\n            chunk = original_read(descriptor, byte_count)\n            metadata = os.fstat(descriptor)\n            if (\n                chunk\n                and not changed\n                and metadata.st_dev == archive_identity.st_dev\n                and metadata.st_ino == archive_identity.st_ino\n            ):\n                changed = True\n                self.archive_path.write_bytes(replacement)\n            return chunk\n\n        with (\n            mock.patch.object(\n                cache.os,\n                \"read\",\n                side_effect=mutate_archive_after_read,\n            ),\n            self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError,\n                \"changed while being read\",\n            ),\n        ):\n            self.verify()\n\n    def test_noncanonical_manifest_bytes_fail_even_when_material_binds_them(self) -> None:\n        noncanonical = cache._canonical_bytes(self.manifest)\n        self.manifest_path.write_bytes(noncanonical)\n        dependencies, contract = self.rebind_manifest(\n            self.manifest,\n            noncanonical,\n        )\n        with self.assertRaisesRegex(\n            cache.CacheArchiveVerificationError,\n            \"canonical\",\n        ):\n            self.verify(dependencies=dependencies, contract=contract)\n\n    def test_manifest_self_inventory_count_and_plan_bindings_fail_closed(self) -> None:\n        cases: list[\n            tuple[\n                str,\n                Callable[[dict[str, Any]], None],\n                bool,\n            ]\n        ] = [\n            (\n                \"self-hash\",\n                _mutate_manifest_without_resealing,\n                True,\n            ),\n            (\n                \"inventory\",\n                _mutate_manifest_inventory,\n                True,\n            ),\n            (\n                \"count\",\n                _mutate_manifest_count,\n                False,\n            ),\n            (\n                \"plan\",\n                _mutate_manifest_plan_binding,\n                True,\n            ),\n        ]\n        for label, mutate, copy_content_fields in cases:\n            changed = copy.deepcopy(self.manifest)\n            mutate(changed)\n            raw = gate._render(changed)\n            self.manifest_path.write_bytes(raw)\n            dependencies, contract = self.rebind_manifest(\n                changed,\n                raw,\n                copy_content_fields=copy_content_fields,\n            )\n            with self.subTest(label=label), self.assertRaises(\n                cache.CacheArchiveVerificationError\n            ):\n                self.verify(dependencies=dependencies, contract=contract)\n            self.manifest_path.write_bytes(self.manifest_raw)\n\n\nclass RawFileIdentityPrimitiveTest(unittest.TestCase):\n    def test_stream_identity_rejects_size_symlink_fifo_and_in_place_race(self) -> None:\n        with tempfile.TemporaryDirectory() as temporary_name:\n            root = pathlib.Path(temporary_name).resolve(strict=True)\n            regular = root / \"archive.opaque\"\n            before = b\"before-opaque-cache-bytes\"\n            after = b\"after--opaque-cache-bytes\"\n            self.assertEqual(len(before), len(after))\n            regular.write_bytes(before)\n\n            self.assertEqual(\n                cache._stream_identity(\n                    regular, maximum=len(before), label=\"fixture archive\"\n                ),\n                {\"byte_count\": len(before), \"sha256\": cache._sha256(before)},\n            )\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError, \"outside the byte ceiling\"\n            ):\n                cache._stream_identity(\n                    regular, maximum=len(before) - 1, label=\"fixture archive\"\n                )\n\n            symlink = root / \"archive-link.opaque\"\n            symlink.symlink_to(regular)\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError, \"cannot open\"\n            ):\n                cache._stream_identity(\n                    symlink, maximum=len(before), label=\"fixture symlink\"\n                )\n\n            hardlink = root / \"archive-hardlink.opaque\"\n            os.link(regular, hardlink)\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError, \"link\"\n            ):\n                cache._stream_identity(\n                    hardlink, maximum=len(before), label=\"fixture hardlink\"\n                )\n            hardlink.unlink()\n\n            fifo = root / \"archive-fifo.opaque\"\n            os.mkfifo(fifo)\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError, \"not a regular file\"\n            ):\n                cache._stream_identity(\n                    fifo, maximum=len(before), label=\"fixture FIFO\"\n                )\n\n            original_read = cache.os.read\n            changed = False\n\n            def mutate_after_read(descriptor: int, byte_count: int) -> bytes:\n                nonlocal changed\n                chunk = original_read(descriptor, byte_count)\n                if chunk and not changed:\n                    changed = True\n                    regular.write_bytes(after)\n                return chunk\n\n            regular.write_bytes(before)\n            with (\n                mock.patch.object(cache.os, \"read\", side_effect=mutate_after_read),\n                self.assertRaisesRegex(\n                    cache.CacheArchiveVerificationError,\n                    \"changed while being read\",\n                ),\n            ):\n                cache._stream_identity(\n                    regular, maximum=len(before), label=\"raced fixture archive\"\n                )\n\n    def test_descriptor_relative_open_rejects_or_outlives_ancestor_symlinks(self) -> None:\n        with tempfile.TemporaryDirectory() as temporary_name:\n            root = pathlib.Path(temporary_name).resolve(strict=True)\n            outside = root / \"outside\"\n            outside.mkdir()\n            (outside / \"archive.opaque\").write_bytes(b\"outside bytes\")\n            (outside / \"nested\").mkdir()\n            (outside / \"nested\" / \"archive.opaque\").write_bytes(\n                b\"outside swapped bytes\"\n            )\n\n            linked_parent = root / \"linked-parent\"\n            linked_parent.symlink_to(outside, target_is_directory=True)\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError,\n                \"cannot open\",\n            ):\n                cache._stream_identity(\n                    linked_parent / \"archive.opaque\",\n                    maximum=1024,\n                    label=\"ancestor symlink fixture\",\n                )\n\n            victim_parent = root / \"victim-parent\"\n            nested = victim_parent / \"nested\"\n            nested.mkdir(parents=True)\n            inside_raw = b\"descriptor-bound inside bytes\"\n            (nested / \"archive.opaque\").write_bytes(inside_raw)\n            attacked_path = victim_parent / \"nested\" / \"archive.opaque\"\n            held_parent = root / \"held-original-parent\"\n            original_open = cache.os.open\n            swapped = False\n\n            def swap_after_parent_open(\n                path: Any,\n                flags: int,\n                mode: int = 0o777,\n                *,\n                dir_fd: int | None = None,\n            ) -> int:\n                nonlocal swapped\n                descriptor = original_open(path, flags, mode, dir_fd=dir_fd)\n                if path == \"victim-parent\" and not swapped:\n                    swapped = True\n                    victim_parent.rename(held_parent)\n                    victim_parent.symlink_to(outside, target_is_directory=True)\n                return descriptor\n\n            supported_dir_fd = set(cache.os.supports_dir_fd)\n            supported_dir_fd.add(swap_after_parent_open)\n            with (\n                mock.patch.object(cache.os, \"open\", new=swap_after_parent_open),\n                mock.patch.object(\n                    cache.os,\n                    \"supports_dir_fd\",\n                    supported_dir_fd,\n                ),\n            ):\n                observed = cache._stream_identity(\n                    attacked_path,\n                    maximum=1024,\n                    label=\"ancestor swap fixture\",\n                )\n            self.assertTrue(swapped)\n            self.assertEqual(\n                observed,\n                {\n                    \"byte_count\": len(inside_raw),\n                    \"sha256\": cache._sha256(inside_raw),\n                },\n            )\n\n    def test_bounded_json_rejects_oversize_duplicate_keys_and_floats(self) -> None:\n        with tempfile.TemporaryDirectory() as temporary_name:\n            root = pathlib.Path(temporary_name).resolve(strict=True)\n            oversized = root / \"oversized.json\"\n            oversized.write_bytes(b\"{}\")\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError,\n                \"exceeds the byte ceiling\",\n            ):\n                cache._read_bounded(\n                    oversized,\n                    maximum=1,\n                    label=\"oversized JSON fixture\",\n                )\n\n            duplicate = root / \"duplicate.json\"\n            duplicate.write_bytes(b'{\"profile\":\"a\",\"profile\":\"b\"}')\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError,\n                \"duplicate object key\",\n            ):\n                cache._read_json(\n                    duplicate,\n                    maximum=1024,\n                    label=\"duplicate JSON fixture\",\n                )\n\n            floating = root / \"floating.json\"\n            floating.write_bytes(b'{\"value\":1.5}')\n            with self.assertRaisesRegex(\n                cache.CacheArchiveVerificationError,\n                \"floating-point\",\n            ):\n                cache._read_json(\n                    floating,\n                    maximum=1024,\n                    label=\"floating JSON fixture\",\n                )\n\n\nclass SourceOnlyDependencyTest(unittest.TestCase):\n    def test_forged_timestamp_valid_validator_bytecode_is_ignored(self) -> None:\n        with tempfile.TemporaryDirectory() as temporary_name:\n            root = pathlib.Path(temporary_name).resolve(strict=True)\n            source = root / \"draft202012.py\"\n            raw = cache.DRAFT202012_PATH.read_bytes()\n            source.write_bytes(raw)\n            fixed_mtime = 1_700_000_000\n            os.utime(source, (fixed_mtime, fixed_mtime))\n            metadata = source.stat()\n\n            forged_code = compile(\n                \"MARKER = 'forged-timestamp-cache-loaded'\\n\",\n                str(source),\n                \"exec\",\n            )\n            bytecode = pathlib.Path(importlib.util.cache_from_source(str(source)))\n            bytecode.parent.mkdir()\n            bytecode.write_bytes(\n                importlib.util.MAGIC_NUMBER\n                + struct.pack(\"<III\", 0, int(metadata.st_mtime), metadata.st_size)\n                + marshal.dumps(forged_code)\n            )\n\n            control = subprocess.run(\n                [\n                    sys.executable,\n                    \"-c\",\n                    \"import draft202012; print(draft202012.MARKER)\",\n                ],\n                check=True,\n                cwd=root,\n                env={\n                    \"LANG\": \"C\",\n                    \"LC_ALL\": \"C\",\n                    \"PATH\": \"/usr/bin:/bin\",\n                    \"PYTHONDONTWRITEBYTECODE\": \"1\",\n                    \"PYTHONPATH\": str(root),\n                },\n                stdout=subprocess.PIPE,\n                stderr=subprocess.PIPE,\n                text=True,\n            )\n            self.assertEqual(\n                control.stdout.strip(),\n                \"forged-timestamp-cache-loaded\",\n            )\n\n            with (\n                mock.patch.object(cache, \"DRAFT202012_PATH\", source),\n                mock.patch.object(\n                    cache,\n                    \"CHECKED_DRAFT202012_SHA256\",\n                    cache._sha256(raw),\n                ),\n                mock.patch.object(cache, \"CHECKED_DRAFT202012_SIZE\", len(raw)),\n                mock.patch.object(cache, \"_CHECKED_DRAFT_VALIDATOR\", None),\n            ):\n                checked = cache._checked_draft_validator()\n            self.assertFalse(hasattr(checked, \"MARKER\"))\n            self.assertEqual(\n                checked.DIALECT,\n                \"https://json-schema.org/draft/2020-12/schema\",\n            )\n\n\nclass ProhibitedSurfaceTest(unittest.TestCase):\n    def test_source_has_no_archive_parser_extractor_network_or_process_surface(self) -> None:\n        source = pathlib.Path(cache.__file__).read_text(encoding=\"utf-8\")\n        tree = ast.parse(source)\n        imported_roots: set[str] = set()\n        called_names: set[str] = set()\n        for node in ast.walk(tree):\n            if isinstance(node, ast.Import):\n                imported_roots.update(alias.name.split(\".\", 1)[0] for alias in node.names)\n            elif isinstance(node, ast.ImportFrom) and node.module:\n                imported_roots.add(node.module.split(\".\", 1)[0])\n            elif isinstance(node, ast.Call):\n                if isinstance(node.func, ast.Name):\n                    called_names.add(node.func.id)\n                elif isinstance(node.func, ast.Attribute):\n                    called_names.add(node.func.attr)\n\n        self.assertTrue(\n            imported_roots.isdisjoint(\n                {\n                    \"compression\",\n                    \"http\",\n                    \"requests\",\n                    \"shutil\",\n                    \"socket\",\n                    \"subprocess\",\n                    \"tarfile\",\n                    \"urllib\",\n                    \"zstandard\",\n                }\n            ),\n            imported_roots,\n        )\n        self.assertTrue(\n            called_names.isdisjoint(\n                {\n                    \"Popen\",\n                    \"create_connection\",\n                    \"extract\",\n                    \"extractall\",\n                    \"posix_spawn\",\n                    \"run\",\n                    \"system\",\n                    \"unpack_archive\",\n                    \"urlopen\",\n                }\n            ),\n            called_names,\n        )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n#!/usr/bin/env python3\n\"\"\"Verify the frozen regular-file-only cache bundle without staging it.\n\nThe checked v1 material declaration is pending, so production ``verify``\ncurrently fails before opening either caller locator.  A future reviewed v1\nmaterial identity may enable two read-only passes over the same bundle file:\nraw identity first, then bounded structure and content verification.  This\nmodule cannot create a bundle or extract, stage, reserve, authorize, or execute\ncache material.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport copy\nimport hashlib\nimport json\nimport os\nimport pathlib\nimport stat\nimport struct\nimport sys\nimport tempfile\nimport types\nfrom collections.abc import Mapping, Sequence\nfrom typing import Any, cast\n\n\nROOT = pathlib.Path(__file__).parent\nV1_SOURCE_PATH = ROOT / \"negative_control_cache_archive_v1.py\"\nFORMAT_PATH = ROOT / \"negative-control-cache-bundle-format-v2.json\"\nVERIFIER_CONTRACT_PATH = ROOT / \"negative-control-cache-bundle-verifier-contract-v2.json\"\nFORMAT_SCHEMA_PATH = ROOT / \"schemas\" / \"negative-control-cache-bundle-format-v2.schema.json\"\nREPORT_SCHEMA_PATH = ROOT / \"schemas\" / \"negative-control-cache-bundle-verification-report-v2.schema.json\"\nVERIFIER_SCHEMA_PATH = ROOT / \"schemas\" / \"negative-control-cache-bundle-verifier-contract-v2.schema.json\"\n\nSCHEMA_VERSION = 2\nFORMAT_PROFILE = \"agent_brain_negative_control_cache_bundle_format_v2\"\nVERIFIER_PROFILE = \"agent_brain_negative_control_cache_bundle_verifier_contract_v2\"\nREPORT_PROFILE = \"agent_brain_negative_control_cache_bundle_verification_report_v2\"\nFORMAT_STATUS = \"wire_format_frozen_no_material_no_authority\"\nPENDING_STATUS = \"verifier_compiled_raw_material_source_review_pending_bundle_access_forbidden\"\nAPPROVED_STATUS = \"verifier_compiled_raw_material_source_reviewed_bundle_content_verification_only\"\nREPORT_STATUS = (\n    \"bundle_v2_same_descriptor_raw_identity_structure_manifest_bijection_and_\"\n    \"all_file_contents_verified_extraction_staging_execution_forbidden\"\n)\n\nCHECKED_V1_SOURCE_SHA256 = \"2f21da09c28cf2de62f808a6362f74fbc7aead07a04cfef96c15c93584540b94\"\nCHECKED_V1_SOURCE_SIZE = 68_195\n\n# Root fills these reviewed identities after the concurrently authored format\n# and schemas settle, before creating the checked verifier contract.\nCHECKED_FORMAT_FILE_SHA256 = \"970669197065a563fa0a09c281f671f5a3cd63061d6ff8f52da64926fa5ac406\"\nCHECKED_FORMAT_SHA256 = \"e2231e7fae7dfdad054c770d928b549bb996b4c452169cb22abea7f8f6f0ee59\"\nCHECKED_FORMAT_SCHEMA_SHA256 = \"95712ba76c36107f583a195167e6dea9d90ba81729fba10fa211096d277617d8\"\nCHECKED_REPORT_SCHEMA_SHA256 = \"3afd8fec9da54a8b7358b497031633bfeaf8c5df1f595347424769d4a30ec4ad\"\nCHECKED_VERIFIER_SCHEMA_SHA256 = \"eca24ad3f0a50f4a9dcbd9e106715db8fee449d4735eaeee87912a95e7c564bd\"\n\nHEADER_BYTES = 232\nRECORD_FIXED_BYTES = 52\nTRAILER_BYTES = 104\nHEADER_MAGIC = b\"ENTIRECACHEBND2\\0\"\nRECORD_MAGIC = b\"FILE\"\nTRAILER_MAGIC = b\"ENTIRECACHEEND2\\0\"\nFORMAT_VERSION = 2\nMAX_BUNDLE_BYTES = 2 * 1024 * 1024 * 1024\nMAX_UNPACKED_BYTES = 2 * 1024 * 1024 * 1024\nMAX_FILE_COUNT = 250_000\nMAX_PATH_BYTES = 1_024\nMIN_BUNDLE_BYTES = HEADER_BYTES + TRAILER_BYTES + 3 * (RECORD_FIXED_BYTES + 1 + 1)\nREAD_CHUNK_BYTES = 1_048_576\nREPOSITORY_ORDER = (\"entire-brain\", \"entire-db\", \"entire-graph\")\nREPOSITORY_IDS = {key: index for index, key in enumerate(REPOSITORY_ORDER)}\n\nMANIFEST_PROJECTION_DOMAIN = b\"entire-brain/cache-bundle-manifest-projection/v2\\0\"\nRECORDS_DOMAIN = b\"entire-brain/cache-bundle-records/v2\\0\"\nPREFIX_DOMAIN = b\"entire-brain/cache-bundle-prefix/v2\\0\"\n\nV1_PENDING_MATERIAL_STATUS = \"pending_source_review\"\nV1_APPROVED_MATERIAL_STATUS = \"approved_source_review_identity_only\"\nV1_PENDING_VERIFIER_STATUS = \"verifier_compiled_material_source_review_pending_execution_forbidden\"\nV1_APPROVED_VERIFIER_STATUS = (\n    \"verifier_compiled_material_source_reviewed_identity_only_execution_forbidden\"\n)\nV1_VERIFIER_CONTRACT_PATH = ROOT / \"negative-control-cache-archive-verifier-contract-v1.json\"\nMAX_FIXED_JSON_BYTES = 128 * 1024 * 1024\nMAX_SOURCE_BYTES = 4 * 1024 * 1024\nMAX_VERIFIER_CONTRACT_BYTES = 4 * 1024 * 1024\n\nAUTHORITY = {\n    \"atomic_consumption\": False,\n    \"benchmark_execution\": \"forbidden\",\n    \"bundle_creation\": \"forbidden\",\n    \"bundle_extraction\": \"forbidden\",\n    \"bundle_staging\": \"forbidden\",\n    \"candidate_execution\": \"forbidden\",\n    \"e0_runtime_binding\": False,\n    \"execution_authority\": False,\n    \"model_provider_execution\": \"forbidden\",\n    \"network_access\": \"forbidden\",\n    \"owner_approval\": False,\n    \"paid_execution\": \"forbidden\",\n}\n\nREPORT_AUTHORITY = {\n    \"atomic_consumption\": False,\n    \"benchmark_execution\": \"forbidden\",\n    \"candidate_execution\": \"forbidden\",\n    \"execution_authority\": False,\n    \"model_provider_execution\": \"forbidden\",\n    \"network_access\": \"forbidden\",\n    \"owner_approval\": False,\n    \"paid_execution\": \"forbidden\",\n}\n\nREPORT_SAFETY = {\n    \"bundle_creation\": False,\n    \"e0_runtime_binding\": False,\n    \"extraction\": False,\n    \"staged_tree_created\": False,\n    \"staging\": False,\n}\n\nREPORT_STRUCTURE = {\n    \"canonical_record_order\": True,\n    \"compression\": False,\n    \"exact_eof\": True,\n    \"header_verified\": True,\n    \"path_policy_verified\": True,\n    \"record_kind\": \"nonempty_regular_file_only\",\n    \"structurally_unrepresentable_verified\": [\n        \"explicit_directories\",\n        \"symlinks\",\n        \"hardlinks_or_inode_identity\",\n        \"fifos\",\n        \"sockets\",\n        \"block_devices\",\n        \"character_devices\",\n        \"other_devices\",\n        \"whiteouts\",\n        \"sparse_metadata\",\n        \"alternate_data_streams\",\n        \"resource_forks\",\n        \"compression\",\n        \"encryption\",\n        \"signatures\",\n        \"padding\",\n        \"concatenated_members\",\n        \"acls\",\n        \"extended_attributes\",\n        \"uid_gid\",\n        \"timestamps\",\n        \"mode_bits\",\n        \"executable_setuid_setgid_sticky_bits\",\n    ],\n    \"trailer_verified\": True,\n}\n\nFORMAT_BINDING = {\n    \"artifact_file\": FORMAT_PATH.name,\n    \"artifact_sha256\": CHECKED_FORMAT_FILE_SHA256,\n    \"format_contract_sha256\": CHECKED_FORMAT_SHA256,\n    \"profile\": FORMAT_PROFILE,\n    \"schema_file\": FORMAT_SCHEMA_PATH.name,\n    \"schema_sha256\": CHECKED_FORMAT_SCHEMA_SHA256,\n    \"schema_version\": SCHEMA_VERSION,\n    \"status\": FORMAT_STATUS,\n}\n\nMANIFEST_BINDING = {\n    \"manifest_profile\": \"content_addressed_offline_go_cache_seed_manifest_v1\",\n    \"manifest_schema_sha256\": \"37d3839411b2e30a99fdd7e93784d56f5fd525c0472717a24cc7b92213b98999\",\n    \"repository_key_semantics\": \"deterministic_ownership_and_provenance_only_not_destination_namespace\",\n    \"run_plan_artifact_sha256\": \"f55b6e22a25daf8016305304adf3b7ac8d31675281d97cfc9bb78cc76b619790\",\n    \"run_plan_sha256\": \"a47311fa1f4553f8085ebea6e8ddd003a4ea5d0b2d269d91bbcdd414134a248e\",\n    \"run_plan_schema_sha256\": \"294f77f165676bec6053e9637578ca22f048a887d2a978bbf8b8e300f21a2dad\",\n    \"shared_seed_semantics\": \"one_shared_union_seed_copied_unchanged_to_every_arm\",\n    \"toolchain_bindings_sha256\": \"e8240c5af77530079643593a7484cb0062408829bab76690b7f55d12176fc87c\",\n}\n\nRESIDUAL_GATES = [\n    \"successful_v2_bundle_content_verification_report\",\n    \"separate_safe_stager_with_go_cache_behavior_validation\",\n    \"trusted_apfs_observer_and_atomic_capacity_reservation\",\n    \"clean_detached_worktree_executor_and_first_parent_reversal_proof\",\n    \"attested_attempt_producer_and_classifier_integration\",\n    \"private_log_executor_integration_retention_and_aggregate_accounting\",\n    \"fail_closed_cleanup_interruption_attestation_and_no_receipt_guarantee\",\n    \"atomic_single_use_approval_consumption_and_execution_binding\",\n]\n\nRUNTIME_BINDINGS = {\n    \"actual_bundle_sha256\": None,\n    \"actual_manifest_sha256\": None,\n    \"bundle_verification_report_sha256\": None,\n    \"consumption_run_sha256\": None,\n    \"owner_approval_verification_report_sha256\": None,\n    \"raw_identity_report_sha256\": None,\n    \"staged_tree_sha256\": None,\n}\n\nVERIFICATION_POLICY = {\n    \"bundle_byte_count_formula\": \"232 + 104 + 52*N + sum(path_utf8_byte_count) + unpacked_byte_count\",\n    \"bundle_byte_count_max\": MAX_BUNDLE_BYTES,\n    \"bundle_descriptor\": \"one_held_single_link_stable_regular_file_descriptor_never_reopened\",\n    \"cli\": {\n        \"build\": \"build --output CONTRACT\",\n        \"check\": \"check\",\n        \"verify\": \"verify MANIFEST BUNDLE\",\n    },\n    \"file_count_max\": MAX_FILE_COUNT,\n    \"file_count_min\": 3,\n    \"json_depth_max\": 64,\n    \"json_nodes_max\": 1_270_000,\n    \"manifest_byte_count_max\": MAX_FIXED_JSON_BYTES,\n    \"no_payload_sized_allocations\": True,\n    \"pass_1\": \"raw_bundle_size_and_sha256_against_source_reviewed_v1_material_before_interpretation_then_fstat\",\n    \"pass_2\": \"rewind_same_descriptor_then_bounded_parse_stream_hash_manifest_bijection_exact_eof_then_fstat\",\n    \"production_commands_absent\": [\"pack\", \"extract\", \"stage\"],\n    \"report_persistence\": \"forbidden_stdout_only\",\n    \"stream_chunk_byte_count\": READ_CHUNK_BYTES,\n    \"successful_claim\": \"raw_identity_structure_manifest_bijection_and_every_regular_file_payload_sha256_only_not_staging_or_execution\",\n    \"unpacked_byte_count_max\": MAX_UNPACKED_BYTES,\n}\n\n_V1_MODULE: types.ModuleType | None = None\n\n\nclass CacheBundleVerificationError(RuntimeError):\n    \"\"\"Raised when a checked bundle identity or structural claim differs.\"\"\"\n\n\ndef _require(condition: bool, message: str) -> None:\n    if not condition:\n        raise CacheBundleVerificationError(message)\n\n\ndef _sha256(raw: bytes) -> str:\n    _require(type(raw) is bytes, \"SHA-256 input must be exact bytes\")\n    return hashlib.sha256(raw).hexdigest()\n\n\ndef _open_source_descriptor(path: pathlib.Path, *, label: str) -> tuple[int, list[int]]:\n    components = path.parts[1:] if path.is_absolute() else path.parts\n    _require(bool(components), f\"{label} path has no file component\")\n    _require(\n        all(component not in {\"\", \".\", \"..\"} and \"\\0\" not in component for component in components),\n        f\"{label} path contains traversal\",\n    )\n    _require(os.open in os.supports_dir_fd, \"descriptor-relative open is unavailable\")\n    file_flags = os.O_RDONLY\n    directory_flags = os.O_RDONLY\n    for name in (\"O_CLOEXEC\", \"O_NOFOLLOW\", \"O_NONBLOCK\"):\n        flag = getattr(os, name, None)\n        _require(type(flag) is int and flag != 0, f\"secure open flag {name} is unavailable\")\n        file_flags |= cast(int, flag)\n        directory_flags |= cast(int, flag)\n    directory = getattr(os, \"O_DIRECTORY\", None)\n    _require(type(directory) is int and directory != 0, \"O_DIRECTORY is unavailable\")\n    directory_flags |= cast(int, directory)\n    directories: list[int] = []\n    descriptor = -1\n    try:\n        current = os.open(\"/\" if path.is_absolute() else \".\", directory_flags)\n        directories.append(current)\n        for component in components[:-1]:\n            current = os.open(component, directory_flags, dir_fd=current)\n            directories.append(current)\n            _require(stat.S_ISDIR(os.fstat(current).st_mode), f\"{label} ancestor is not a directory\")\n        descriptor = os.open(components[-1], file_flags, dir_fd=current)\n        _require(stat.S_ISREG(os.fstat(descriptor).st_mode), f\"{label} is not a regular file\")\n        return descriptor, directories\n    except CacheBundleVerificationError:\n        if descriptor >= 0:\n            os.close(descriptor)\n        for current in reversed(directories):\n            os.close(current)\n        raise\n    except OSError as exc:\n"},"started_at_ms":1789839281914,"completed_at_ms":1789839281914}}
{"timestamp":"2026-09-19T17:34:41.968Z","ordinal":7389,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0babc-0f30-7510-be55-935bbb89f7eb","call_id":"call_kAlVlHmAhmprzvAtbScOj2sp","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"8e2869\",\"wall_time_seconds\":0.000002708,\"exit_code\":0,\"original_token_count\":6753,\"output\":\"            self.archive_path.write_bytes(self.archive_raw)\\n\\n    def test_archive_path_rejects_symlink_hardlink_fifo_and_race(self) -> None:\\n        target = self.root / \\\"alternate-archive-source.opaque\\\"\\n        target.write_bytes(self.archive_raw)\\n\\n        self.archive_path.unlink()\\n        self.archive_path.symlink_to(target)\\n        with self.assertRaises(cache.CacheArchiveVerificationError):\\n            self.verify()\\n        self.archive_path.unlink()\\n\\n        os.link(target, self.archive_path)\\n        with self.assertRaisesRegex(\\n            cache.CacheArchiveVerificationError,\\n            \\\"link\\\",\\n        ):\\n            self.verify()\\n        self.archive_path.unlink()\\n        target.unlink()\\n\\n        os.mkfifo(self.archive_path)\\n        with self.assertRaisesRegex(\\n            cache.CacheArchiveVerificationError,\\n            \\\"regular file\\\",\\n        ):\\n            self.verify()\\n        self.archive_path.unlink()\\n        self.archive_path.write_bytes(self.archive_raw)\\n\\n        original_read = cache.os.read\\n        archive_identity = self.archive_path.stat()\\n        replacement = b\\\"x\\\" * len(self.archive_raw)\\n        changed = False\\n\\n        def mutate_archive_after_read(descriptor: int, byte_count: int) -> bytes:\\n            nonlocal changed\\n            chunk = original_read(descriptor, byte_count)\\n            metadata = os.fstat(descriptor)\\n            if (\\n                chunk\\n                and not changed\\n                and metadata.st_dev == archive_identity.st_dev\\n                and metadata.st_ino == archive_identity.st_ino\\n            ):\\n                changed = True\\n                self.archive_path.write_bytes(replacement)\\n            return chunk\\n\\n        with (\\n            mock.patch.object(\\n                cache.os,\\n                \\\"read\\\",\\n                side_effect=mutate_archive_after_read,\\n            ),\\n            self.assertRaisesRegex(\\n                cache.CacheArchiveVerificationError,\\n                \\\"changed while being read\\\",\\n            ),\\n        ):\\n            self.verify()\\n\\n    def test_noncanonical_manifest_bytes_fail_even_when_material_binds_them(self) -> None:\\n        noncanonical = cache._canonical_bytes(self.manifest)\\n        self.manifest_path.write_bytes(noncanonical)\\n        dependencies, contract = self.rebind_manifest(\\n            self.manifest,\\n            noncanonical,\\n        )\\n        with self.assertRaisesRegex(\\n            cache.CacheArchiveVerificationError,\\n            \\\"canonical\\\",\\n        ):\\n            self.verify(dependencies=dependencies, contract=contract)\\n\\n    def test_manifest_self_inventory_count_and_plan_bindings_fail_closed(self) -> None:\\n        cases: list[\\n            tuple[\\n                str,\\n                Callable[[dict[str, Any]], None],\\n                bool,\\n            ]\\n        ] = [\\n            (\\n                \\\"self-hash\\\",\\n                _mutate_manifest_without_resealing,\\n                True,\\n            ),\\n            (\\n                \\\"inventory\\\",\\n                _mutate_manifest_inventory,\\n                True,\\n            ),\\n            (\\n                \\\"count\\\",\\n                _mutate_manifest_count,\\n                False,\\n            ),\\n            (\\n                \\\"plan\\\",\\n                _mutate_manifest_plan_binding,\\n                True,\\n            ),\\n        ]\\n        for label, mutate, copy_content_fields in cases:\\n            changed = copy.deepcopy(self.manifest)\\n            mutate(changed)\\n            raw = gate._render(changed)\\n            self.manifest_path.write_bytes(raw)\\n            dependencies, contract = self.rebind_manifest(\\n                changed,\\n                raw,\\n                copy_content_fields=copy_content_fields,\\n            )\\n            with self.subTest(label=label), self.assertRaises(\\n                cache.CacheArchiveVerificationError\\n            ):\\n                self.verify(dependencies=dependencies, contract=contract)\\n            self.manifest_path.write_bytes(self.manifest_raw)\\n\\n\\nclass RawFileIdentityPrimitiveTest(unittest.TestCase):\\n    def test_stream_identity_rejects_size_symlink_fifo_and_in_place_race(self) -> None:\\n        with tempfile.TemporaryDirectory() as temporary_name:\\n            root = pathlib.Path(temporary_name).resolve(strict=True)\\n            regular = root / \\\"archive.opaque\\\"\\n            before = b\\\"before-opaque-cache-bytes\\\"\\n            after = b\\\"after--opaque-cache-bytes\\\"\\n            self.assertEqual(len(before), len(after))\\n            regular.write_bytes(before)\\n\\n            self.assertEqual(\\n                cache._stream_identity(\\n                    regular, maximum=len(before), label=\\\"fixture archive\\\"\\n                ),\\n                {\\\"byte_count\\\": len(before), \\\"sha256\\\": cache._sha256(before)},\\n            )\\n            with self.assertRaisesRegex(\\n                cache.CacheArchiveVerificationError, \\\"outside the byte ceiling\\\"\\n            ):\\n                cache._stream_identity(\\n                    regular, maximum=len(before) - 1, label=\\\"fixture archive\\\"\\n                )\\n\\n            symlink = root / \\\"archive-link.opaque\\\"\\n            symlink.symlink_to(regular)\\n            with self.assertRaisesRegex(\\n                cache.CacheArchiveVerificationError, \\\"cannot open\\\"\\n            ):\\n                cache._stream_identity(\\n                    symlink, maximum=len(before), label=\\\"fixture symlink\\\"\\n                )\\n\\n            hardlink = root / \\\"archive-hardlink.opaque\\\"\\n            os.link(regular, hardlink)\\n            with self.assertRaisesRegex(\\n                cache.CacheArchiveVerificationError, \\\"link\\\"\\n            ):\\n                cache._stream_identity(\\n                    hardlink, maximum=len(before), label=\\\"fixture hardlink\\\"\\n                )\\n            hardlink.unlink()\\n\\n            fifo = root / \\\"archive-fifo.opaque\\\"\\n            os.mkfifo(fifo)\\n            with self.assertRaisesRegex(\\n                cache.CacheArchiveVerificationError, \\\"not a regular file\\\"\\n            ):\\n                cache._stream_identity(\\n                    fifo, maximum=len(before), label=\\\"fixture FIFO\\\"\\n                )\\n\\n            original_read = cache.os.read\\n            changed = False\\n\\n            def mutate_after_read(descriptor: int, byte_count: int) -> bytes:\\n                nonlocal changed\\n                chunk = original_read(descriptor, byte_count)\\n                if chunk and not changed:\\n                    changed = True\\n                    regular.write_bytes(after)\\n                return chunk\\n\\n            regular.write_bytes(before)\\n            with (\\n                mock.patch.object(cache.os, \\\"read\\\", side_effect=mutate_after_read),\\n                self.assertRaisesRegex(\\n                    cache.CacheArchiveVerificationError,\\n                    \\\"changed while being read\\\",\\n                ),\\n            ):\\n                cache._stream_identity(\\n                    regular, maximum=len(before), label=\\\"raced fixture archive\\\"\\n                )\\n\\n    def test_descriptor_relative_open_rejects_or_outlives_ancestor_symlinks(self) -> None:\\n        with tempfile.TemporaryDirectory() as temporary_name:\\n            root = pathlib.Path(temporary_name).resolve(strict=True)\\n            outside = root / \\\"outside\\\"\\n            outside.mkdir()\\n            (outside / \\\"archive.opaque\\\").write_bytes(b\\\"outside bytes\\\")\\n            (outside / \\\"nested\\\").mkdir()\\n            (outside / \\\"nested\\\" / \\\"archive.opaque\\\").write_bytes(\\n                b\\\"outside swapped bytes\\\"\\n            )\\n\\n            linked_parent = root / \\\"linked-parent\\\"\\n            linked_parent.symlink_to(outside, target_is_directory=True)\\n            with self.assertRaisesRegex(\\n                cache.CacheArchiveVerificationError,\\n                \\\"cannot open\\\",\\n            ):\\n                cache._stream_identity(\\n                    linked_parent / \\\"archive.opaque\\\",\\n                    maximum=1024,\\n                    label=\\\"ancestor symlink fixture\\\",\\n                )\\n\\n            victim_parent = root / \\\"victim-parent\\\"\\n            nested = victim_parent / \\\"nested\\\"\\n            nested.mkdir(parents=True)\\n            inside_raw = b\\\"descriptor-bound inside bytes\\\"\\n            (nested / \\\"archive.opaque\\\").write_bytes(inside_raw)\\n            attacked_path = victim_parent / \\\"nested\\\" / \\\"archive.opaque\\\"\\n            held_parent = root / \\\"held-original-parent\\\"\\n            original_open = cache.os.open\\n            swapped = False\\n\\n            def swap_after_parent_open(\\n                path: Any,\\n                flags: int,\\n                mode: int = 0o777,\\n                *,\\n                dir_fd: int | None = None,\\n            ) -> int:\\n                nonlocal swapped\\n                descriptor = original_open(path, flags, mode, dir_fd=dir_fd)\\n                if path == \\\"victim-parent\\\" and not swapped:\\n                    swapped = True\\n                    victim_parent.rename(held_parent)\\n                    victim_parent.symlink_to(outside, target_is_directory=True)\\n                return descriptor\\n\\n            supported_dir_fd = set(cache.os.supports_dir_fd)\\n            supported_dir_fd.add(swap_after_parent_open)\\n            with (\\n                mock.patch.object(cache.os, \\\"open\\\", new=swap_after_parent_open),\\n                mock.patch.object(\\n                    cache.os,\\n                    \\\"supports_dir_fd\\\",\\n                    supported_dir_fd,\\n                ),\\n            ):\\n                observed = cache._stream_identity(\\n                    attacked_path,\\n                    maximum=1024,\\n                    label=\\\"ancestor swap fixture\\\",\\n                )\\n            self.assertTrue(swapped)\\n            self.assertEqual(\\n                observed,\\n                {\\n                    \\\"byte_count\\\": len(inside_raw),\\n                    \\\"sha256\\\": cache._sha256(inside_raw),\\n                },\\n            )\\n\\n    def test_bounded_json_rejects_oversize_duplicate_keys_and_floats(self) -> None:\\n        with tempfile.TemporaryDirectory() as temporary_name:\\n            root = pathlib.Path(temporary_name).resolve(strict=True)\\n            oversized = root / \\\"oversized.json\\\"\\n            oversized.write_bytes(b\\\"{}\\\")\\n            with self.assertRaisesRegex(\\n                cache.CacheArchiveVerificationError,\\n                \\\"exceeds the byte ceiling\\\",\\n            ):\\n                cache._read_bounded(\\n                    oversized,\\n                    maximum=1,\\n                    label=\\\"oversized JSON fixture\\\",\\n                )\\n\\n            duplicate = root / \\\"duplicate.json\\\"\\n            duplicate.write_bytes(b'{\\\"profile\\\":\\\"a\\\",\\\"profile\\\":\\\"b\\\"}')\\n            with self.assertRaisesRegex(\\n                cache.CacheArchiveVerificationError,\\n                \\\"duplicate object key\\\",\\n            ):\\n                cache._read_json(\\n                    duplicate,\\n                    maximum=1024,\\n                    label=\\\"duplicate JSON fixture\\\",\\n                )\\n\\n            floating = root / \\\"floating.json\\\"\\n            floating.write_bytes(b'{\\\"value\\\":1.5}')\\n            with self.assertRaisesRegex(\\n                cache.CacheArchiveVerificationError,\\n                \\\"floating-point\\\",\\n            ):\\n                cache._read_json(\\n                    floating,\\n                    maximum=1024,\\n                    label=\\\"floating JSON fixture\\\",\\n                )\\n\\n\\nclass SourceOnlyDependencyTest(unittest.TestCase):\\n    def test_forged_timestamp_valid_validator_bytecode_is_ignored(self) -> None:\\n        with tempfile.TemporaryDirectory() as temporary_name:\\n            root = pathlib.Path(temporary_name).resolve(strict=True)\\n            source = root / \\\"draft202012.py\\\"\\n            raw = cache.DRAFT202012_PATH.read_bytes()\\n            source.write_bytes(raw)\\n            fixed_mtime = 1_700_000_000\\n            os.utime(source, (fixed_mtime, fixed_mtime))\\n            metadata = source.stat()\\n\\n            forged_code = compile(\\n                \\\"MARKER = 'forged-timestamp-cache-loaded'\\\\n\\\",\\n                str(source),\\n                \\\"exec\\\",\\n            )\\n            bytecode = pathlib.Path(importlib.util.cache_from_source(str(source)))\\n            bytecode.parent.mkdir()\\n            bytecode.write_bytes(\\n                importlib.util.MAGIC_NUMBER\\n                + struct.pack(\\\"<III\\\", 0, int(metadata.st_mtime), metadata.st_size)\\n                + marshal.dumps(forged_code)\\n            )\\n\\n            control = subprocess.run(\\n                [\\n                    sys.executable,\\n                    \\\"-c\\\",\\n                    \\\"import draft202012; print(draft202012.MARKER)\\\",\\n                ],\\n                check=True,\\n                cwd=root,\\n                env={\\n                    \\\"LANG\\\": \\\"C\\\",\\n                    \\\"LC_ALL\\\": \\\"C\\\",\\n                    \\\"PATH\\\": \\\"/usr/bin:/bin\\\",\\n                    \\\"PYTHONDONTWRITEBYTECODE\\\": \\\"1\\\",\\n                    \\\"PYTHONPATH\\\": str(root),\\n                },\\n                stdout=subprocess.PIPE,\\n                stderr=subprocess.PIPE,\\n                text=True,\\n            )\\n            self.assertEqual(\\n                control.stdout.strip(),\\n                \\\"forged-timestamp-cache-loaded\\\",\\n            )\\n\\n            with (\\n                mock.patch.object(cache, \\\"DRAFT202012_PATH\\\", source),\\n                mock.patch.object(\\n                    cache,\\n                    \\\"CHECKED_DRAFT202012_SHA256\\\",\\n                    cache._sha256(raw),\\n                ),\\n                mock.patch.object(cache, \\\"CHECKED_DRAFT202012_SIZE\\\", len(raw)),\\n                mock.patch.object(cache, \\\"_CHECKED_DRAFT_VALIDATOR\\\", None),\\n            ):\\n                checked = cache._checked_draft_validator()\\n            self.assertFalse(hasattr(checked, \\\"MARKER\\\"))\\n            self.assertEqual(\\n                checked.DIALECT,\\n                \\\"https://json-schema.org/draft/2020-12/schema\\\",\\n            )\\n\\n\\nclass ProhibitedSurfaceTest(unittest.TestCase):\\n    def test_source_has_no_archive_parser_extractor_network_or_process_surface(self) -> None:\\n        source = pathlib.Path(cache.__file__).read_text(encoding=\\\"utf-8\\\")\\n        tree = ast.parse(source)\\n        imported_roots: set[str] = set()\\n        called_names: set[str] = set()\\n        for node in ast.walk(tree):\\n            if isinstance(node, ast.Import):\\n                imported_roots.update(alias.name.split(\\\".\\\", 1)[0] for alias in node.names)\\n            elif isinstance(node, ast.ImportFrom) and node.module:\\n                imported_roots.add(node.module.split(\\\".\\\", 1)[0])\\n            elif isinstance(node, ast.Call):\\n                if isinstance(node.func, ast.Name):\\n                    called_names.add(node.func.id)\\n                elif isinstance(node.func, ast.Attribute):\\n                    called_names.add(node.func.attr)\\n\\n        self.assertTrue(\\n            imported_roots.isdisjoint(\\n                {\\n                    \\\"compression\\\",\\n                    \\\"http\\\",\\n                    \\\"requests\\\",\\n                    \\\"shutil\\\",\\n                    \\\"socket\\\",\\n                    \\\"subprocess\\\",\\n                    \\\"tarfile\\\",\\n                    \\\"urllib\\\",\\n                    \\\"zstandard\\\",\\n                }\\n            ),\\n            imported_roots,\\n        )\\n        self.assertTrue(\\n            called_names.isdisjoint(\\n                {\\n                    \\\"Popen\\\",\\n                    \\\"create_connection\\\",\\n                    \\\"extract\\\",\\n                    \\\"extractall\\\",\\n                    \\\"posix_spawn\\\",\\n                    \\\"run\\\",\\n                    \\\"system\\\",\\n                    \\\"unpack_archive\\\",\\n                    \\\"urlopen\\\",\\n                }\\n            ),\\n            called_names,\\n        )\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    unittest.main()\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Verify the frozen regular-file-only cache bundle without staging it.\\n\\nThe checked v1 material declaration is pending, so production ``verify``\\ncurrently fails before opening either caller locator.  A future reviewed v1\\nmaterial identity may enable two read-only passes over the same bundle file:\\nraw identity first, then bounded structure and content verification.  This\\nmodule cannot create a bundle or extract, stage, reserve, authorize, or execute\\ncache material.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport copy\\nimport hashlib\\nimport json\\nimport os\\nimport pathlib\\nimport stat\\nimport struct\\nimport sys\\nimport tempfile\\nimport types\\nfrom collections.abc import Mapping, Sequence\\nfrom typing import Any, cast\\n\\n\\nROOT = pathlib.Path(__file__).parent\\nV1_SOURCE_PATH = ROOT / \\\"negative_control_cache_archive_v1.py\\\"\\nFORMAT_PATH = ROOT / \\\"negative-control-cache-bundle-format-v2.json\\\"\\nVERIFIER_CONTRACT_PATH = ROOT / \\\"negative-control-cache-bundle-verifier-contract-v2.json\\\"\\nFORMAT_SCHEMA_PATH = ROOT / \\\"schemas\\\" / \\\"negative-control-cache-bundle-format-v2.schema.json\\\"\\nREPORT_SCHEMA_PATH = ROOT / \\\"schemas\\\" / \\\"negative-control-cache-bundle-verification-report-v2.schema.json\\\"\\nVERIFIER_SCHEMA_PATH = ROOT / \\\"schemas\\\" / \\\"negative-control-cache-bundle-verifier-contract-v2.schema.json\\\"\\n\\nSCHEMA_VERSION = 2\\nFORMAT_PROFILE = \\\"agent_brain_negative_control_cache_bundle_format_v2\\\"\\nVERIFIER_PROFILE = \\\"agent_brain_negative_control_cache_bundle_verifier_contract_v2\\\"\\nREPORT_PROFILE = \\\"agent_brain_negative_control_cache_bundle_verification_report_v2\\\"\\nFORMAT_STATUS = \\\"wire_format_frozen_no_material_no_authority\\\"\\nPENDING_STATUS = \\\"verifier_compiled_raw_material_source_review_pending_bundle_access_forbidden\\\"\\nAPPROVED_STATUS = \\\"verifier_compiled_raw_material_source_reviewed_bundle_content_verification_only\\\"\\nREPORT_STATUS = (\\n    \\\"bundle_v2_same_descriptor_raw_identity_structure_manifest_bijection_and_\\\"\\n    \\\"all_file_contents_verified_extraction_staging_execution_forbidden\\\"\\n)\\n\\nCHECKED_V1_SOURCE_SHA256 = \\\"2f21da09c28cf2de62f808a6362f74fbc7aead07a04cfef96c15c93584540b94\\\"\\nCHECKED_V1_SOURCE_SIZE = 68_195\\n\\n# Root fills these reviewed identities after the concurrently authored format\\n# and schemas settle, before creating the checked verifier contract.\\nCHECKED_FORMAT_FILE_SHA256 = \\\"970669197065a563fa0a09c281f671f5a3cd63061d6ff8f52da64926fa5ac406\\\"\\nCHECKED_FORMAT_SHA256 = \\\"e2231e7fae7dfdad054c770d928b549bb996b4c452169cb22abea7f8f6f0ee59\\\"\\nCHECKED_FORMAT_SCHEMA_SHA256 = \\\"95712ba76c36107f583a195167e6dea9d90ba81729fba10fa211096d277617d8\\\"\\nCHECKED_REPORT_SCHEMA_SHA256 = \\\"3afd8fec9da54a8b7358b497031633bfeaf8c5df1f595347424769d4a30ec4ad\\\"\\nCHECKED_VERIFIER_SCHEMA_SHA256 = \\\"eca24ad3f0a50f4a9dcbd9e106715db8fee449d4735eaeee87912a95e7c564bd\\\"\\n\\nHEADER_BYTES = 232\\nRECORD_FIXED_BYTES = 52\\nTRAILER_BYTES = 104\\nHEADER_MAGIC = b\\\"ENTIRECACHEBND2\\\\0\\\"\\nRECORD_MAGIC = b\\\"FILE\\\"\\nTRAILER_MAGIC = b\\\"ENTIRECACHEEND2\\\\0\\\"\\nFORMAT_VERSION = 2\\nMAX_BUNDLE_BYTES = 2 * 1024 * 1024 * 1024\\nMAX_UNPACKED_BYTES = 2 * 1024 * 1024 * 1024\\nMAX_FILE_COUNT = 250_000\\nMAX_PATH_BYTES = 1_024\\nMIN_BUNDLE_BYTES = HEADER_BYTES + TRAILER_BYTES + 3 * (RECORD_FIXED_BYTES + 1 + 1)\\nREAD_CHUNK_BYTES = 1_048_576\\nREPOSITORY_ORDER = (\\\"entire-brain\\\", \\\"entire-db\\\", \\\"entire-graph\\\")\\nREPOSITORY_IDS = {key: index for index, key in enumerate(REPOSITORY_ORDER)}\\n\\nMANIFEST_PROJECTION_DOMAIN = b\\\"entire-brain/cache-bundle-manifest-projection/v2\\\\0\\\"\\nRECORDS_DOMAIN = b\\\"entire-brain/cache-bundle-records/v2\\\\0\\\"\\nPREFIX_DOMAIN = b\\\"entire-brain/cache-bundle-prefix/v2\\\\0\\\"\\n\\nV1_PENDING_MATERIAL_STATUS = \\\"pending_source_review\\\"\\nV1_APPROVED_MATERIAL_STATUS = \\\"approved_source_review_identity_only\\\"\\nV1_PENDING_VERIFIER_STATUS = \\\"verifier_compiled_material_source_review_pending_execution_forbidden\\\"\\nV1_APPROVED_VERIFIER_STATUS = (\\n    \\\"verifier_compiled_material_source_reviewed_identity_only_execution_forbidden\\\"\\n)\\nV1_VERIFIER_CONTRACT_PATH = ROOT / \\\"negative-control-cache-archive-verifier-contract-v1.json\\\"\\nMAX_FIXED_JSON_BYTES = 128 * 1024 * 1024\\nMAX_SOURCE_BYTES = 4 * 1024 * 1024\\nMAX_VERIFIER_CONTRACT_BYTES = 4 * 1024 * 1024\\n\\nAUTHORITY = {\\n    \\\"atomic_consumption\\\": False,\\n    \\\"benchmark_execution\\\": \\\"forbidden\\\",\\n    \\\"bundle_creation\\\": \\\"forbidden\\\",\\n    \\\"bundle_extraction\\\": \\\"forbidden\\\",\\n    \\\"bundle_staging\\\": \\\"forbidden\\\",\\n    \\\"candidate_execution\\\": \\\"forbidden\\\",\\n    \\\"e0_runtime_binding\\\": False,\\n    \\\"execution_authority\\\": False,\\n    \\\"model_provider_execution\\\": \\\"forbidden\\\",\\n    \\\"network_access\\\": \\\"forbidden\\\",\\n    \\\"owner_approval\\\": False,\\n    \\\"paid_execution\\\": \\\"forbidden\\\",\\n}\\n\\nREPORT_AUTHORITY = {\\n    \\\"atomic_consumption\\\": False,\\n    \\\"benchmark_execution\\\": \\\"forbidden\\\",\\n    \\\"candidate_execution\\\": \\\"forbidden\\\",\\n    \\\"execution_authority\\\": False,\\n    \\\"model_provider_execution\\\": \\\"forbidden\\\",\\n    \\\"network_access\\\": \\\"forbidden\\\",\\n    \\\"owner_approval\\\": False,\\n    \\\"paid_execution\\\": \\\"forbidden\\\",\\n}\\n\\nREPORT_SAFETY = {\\n    \\\"bundle_creation\\\": False,\\n    \\\"e0_runtime_binding\\\": False,\\n    \\\"extraction\\\": False,\\n    \\\"staged_tree_created\\\": False,\\n    \\\"staging\\\": False,\\n}\\n\\nREPORT_STRUCTURE = {\\n    \\\"canonical_record_order\\\": True,\\n    \\\"compression\\\": False,\\n    \\\"exact_eof\\\": True,\\n    \\\"header_verified\\\": True,\\n    \\\"path_policy_verified\\\": True,\\n    \\\"record_kind\\\": \\\"nonempty_regular_file_only\\\",\\n    \\\"structurally_unrepresentable_verified\\\": [\\n        \\\"explicit_directories\\\",\\n        \\\"symlinks\\\",\\n        \\\"hardlinks_or_inode_identity\\\",\\n        \\\"fifos\\\",\\n        \\\"sockets\\\",\\n        \\\"block_devices\\\",\\n        \\\"character_devices\\\",\\n        \\\"other_devices\\\",\\n        \\\"whiteouts\\\",\\n        \\\"sparse_metadata\\\",\\n        \\\"alternate_data_streams\\\",\\n        \\\"resource_forks\\\",\\n        \\\"compression\\\",\\n        \\\"encryption\\\",\\n        \\\"signatures\\\",\\n        \\\"padding\\\",\\n        \\\"concatenated_members\\\",\\n        \\\"acls\\\",\\n        \\\"extended_attributes\\\",\\n        \\\"uid_gid\\\",\\n        \\\"timestamps\\\",\\n        \\\"mode_bits\\\",\\n        \\\"executable_setuid_setgid_sticky_bits\\\",\\n    ],\\n    \\\"trailer_verified\\\": True,\\n}\\n\\nFORMAT_BINDING = {\\n    \\\"artifact_file\\\": FORMAT_PATH.name,\\n    \\\"artifact_sha256\\\": CHECKED_FORMAT_FILE_SHA256,\\n    \\\"format_contract_sha256\\\": CHECKED_FORMAT_SHA256,\\n    \\\"profile\\\": FORMAT_PROFILE,\\n    \\\"schema_file\\\": FORMAT_SCHEMA_PATH.name,\\n    \\\"schema_sha256\\\": CHECKED_FORMAT_SCHEMA_SHA256,\\n    \\\"schema_version\\\": SCHEMA_VERSION,\\n    \\\"status\\\": FORMAT_STATUS,\\n}\\n\\nMANIFEST_BINDING = {\\n    \\\"manifest_profile\\\": \\\"content_addressed_offline_go_cache_seed_manifest_v1\\\",\\n    \\\"manifest_schema_sha256\\\": \\\"37d3839411b2e30a99fdd7e93784d56f5fd525c0472717a24cc7b92213b98999\\\",\\n    \\\"repository_key_semantics\\\": \\\"deterministic_ownership_and_provenance_only_not_destination_namespace\\\",\\n    \\\"run_plan_artifact_sha256\\\": \\\"f55b6e22a25daf8016305304adf3b7ac8d31675281d97cfc9bb78cc76b619790\\\",\\n    \\\"run_plan_sha256\\\": \\\"a47311fa1f4553f8085ebea6e8ddd003a4ea5d0b2d269d91bbcdd414134a248e\\\",\\n    \\\"run_plan_schema_sha256\\\": \\\"294f77f165676bec6053e9637578ca22f048a887d2a978bbf8b8e300f21a2dad\\\",\\n    \\\"shared_seed_semantics\\\": \\\"one_shared_union_seed_copied_unchanged_to_every_arm\\\",\\n    \\\"toolchain_bindings_sha256\\\": \\\"e8240c5af77530079643593a7484cb0062408829bab76690b7f55d12176fc87c\\\",\\n}\\n\\nRESIDUAL_GATES = [\\n    \\\"successful_v2_bundle_content_verification_report\\\",\\n    \\\"separate_safe_stager_with_go_cache_behavior_validation\\\",\\n    \\\"trusted_apfs_observer_and_atomic_capacity_reservation\\\",\\n    \\\"clean_detached_worktree_executor_and_first_parent_reversal_proof\\\",\\n    \\\"attested_attempt_producer_and_classifier_integration\\\",\\n    \\\"private_log_executor_integration_retention_and_aggregate_accounting\\\",\\n    \\\"fail_closed_cleanup_interruption_attestation_and_no_receipt_guarantee\\\",\\n    \\\"atomic_single_use_approval_consumption_and_execution_binding\\\",\\n]\\n\\nRUNTIME_BINDINGS = {\\n    \\\"actual_bundle_sha256\\\": None,\\n    \\\"actual_manifest_sha256\\\": None,\\n    \\\"bundle_verification_report_sha256\\\": None,\\n    \\\"consumption_run_sha256\\\": None,\\n    \\\"owner_approval_verification_report_sha256\\\": None,\\n    \\\"raw_identity_report_sha256\\\": None,\\n    \\\"staged_tree_sha256\\\": None,\\n}\\n\\nVERIFICATION_POLICY = {\\n    \\\"bundle_byte_count_formula\\\": \\\"232 + 104 + 52*N + sum(path_utf8_byte_count) + unpacked_byte_count\\\",\\n    \\\"bundle_byte_count_max\\\": MAX_BUNDLE_BYTES,\\n    \\\"bundle_descriptor\\\": \\\"one_held_single_link_stable_regular_file_descriptor_never_reopened\\\",\\n    \\\"cli\\\": {\\n        \\\"build\\\": \\\"build --output CONTRACT\\\",\\n        \\\"check\\\": \\\"check\\\",\\n        \\\"verify\\\": \\\"verify MANIFEST BUNDLE\\\",\\n    },\\n    \\\"file_count_max\\\": MAX_FILE_COUNT,\\n    \\\"file_count_min\\\": 3,\\n    \\\"json_depth_max\\\": 64,\\n    \\\"json_nodes_max\\\": 1_270_000,\\n    \\\"manifest_byte_count_max\\\": MAX_FIXED_JSON_BYTES,\\n    \\\"no_payload_sized_allocations\\\": True,\\n    \\\"pass_1\\\": \\\"raw_bundle_size_and_sha256_against_source_reviewed_v1_material_before_interpretation_then_fstat\\\",\\n    \\\"pass_2\\\": \\\"rewind_same_descriptor_then_bounded_parse_stream_hash_manifest_bijection_exact_eof_then_fstat\\\",\\n    \\\"production_commands_absent\\\": [\\\"pack\\\", \\\"extract\\\", \\\"stage\\\"],\\n    \\\"report_persistence\\\": \\\"forbidden_stdout_only\\\",\\n    \\\"stream_chunk_byte_count\\\": READ_CHUNK_BYTES,\\n    \\\"successful_claim\\\": \\\"raw_identity_structure_manifest_bijection_and_every_regular_file_payload_sha256_only_not_staging_or_execution\\\",\\n    \\\"unpacked_byte_count_max\\\": MAX_UNPACKED_BYTES,\\n}\\n\\n_V1_MODULE: types.ModuleType | None = None\\n\\n\\nclass CacheBundleVerificationError(RuntimeError):\\n    \\\"\\\"\\\"Raised when a checked bundle identity or structural claim differs.\\\"\\\"\\\"\\n\\n\\ndef _require(condition: bool, message: str) -> None:\\n    if not condition:\\n        raise CacheBundleVerificationError(message)\\n\\n\\ndef _sha256(raw: bytes) -> str:\\n    _require(type(raw) is bytes, \\\"SHA-256 input must be exact bytes\\\")\\n    return hashlib.sha256(raw).hexdigest()\\n\\n\\ndef _open_source_descriptor(path: pathlib.Path, *, label: str) -> tuple[int, list[int]]:\\n    components = path.parts[1:] if path.is_absolute() else path.parts\\n    _require(bool(components), f\\\"{label} path has no file component\\\")\\n    _require(\\n        all(component not in {\\\"\\\", \\\".\\\", \\\"..\\\"} and \\\"\\\\0\\\" not in component for component in components),\\n        f\\\"{label} path contains traversal\\\",\\n    )\\n    _require(os.open in os.supports_dir_fd, \\\"descriptor-relative open is unavailable\\\")\\n    file_flags = os.O_RDONLY\\n    directory_flags = os.O_RDONLY\\n    for name in (\\\"O_CLOEXEC\\\", \\\"O_NOFOLLOW\\\", \\\"O_NONBLOCK\\\"):\\n        flag = getattr(os, name, None)\\n        _require(type(flag) is int and flag != 0, f\\\"secure open flag {name} is unavailable\\\")\\n        file_flags |= cast(int, flag)\\n        directory_flags |= cast(int, flag)\\n    directory = getattr(os, \\\"O_DIRECTORY\\\", None)\\n    _require(type(directory) is int and directory != 0, \\\"O_DIRECTORY is unavailable\\\")\\n    directory_flags |= cast(int, directory)\\n    directories: list[int] = []\\n    descriptor = -1\\n    try:\\n        current = os.open(\\\"/\\\" if path.is_absolute() else \\\".\\\", directory_flags)\\n        directories.append(current)\\n        for component in components[:-1]:\\n            current = os.open(component, directory_flags, dir_fd=current)\\n            directories.append(current)\\n            _require(stat.S_ISDIR(os.fstat(current).st_mode), f\\\"{label} ancestor is not a directory\\\")\\n        descriptor = os.open(components[-1], file_flags, dir_fd=current)\\n        _require(stat.S_ISREG(os.fstat(descriptor).st_mode), f\\\"{label} is not a regular file\\\")\\n        return descriptor, directories\\n    except CacheBundleVerificationError:\\n        if descriptor >= 0:\\n            os.close(descriptor)\\n        for current in reversed(directories):\\n            os.close(current)\\n        raise\\n    except OSError as exc:\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839281.968588}}}
