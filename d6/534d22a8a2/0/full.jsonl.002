{"timestamp":"2026-09-19T17:34:50.129Z","ordinal":7397,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","item":{"type":"CommandExecution","id":"exec-5c99ef6f-90aa-4f96-a452-f0a310556d74","process_id":"1247","command":["/bin/zsh","-lc","sed -n '281,850p' benchmarks/agent-brain/confirmatory/negative_control_cache_bundle_v2.py"],"cwd":"file:///Users/thomi/.codex/worktrees/5d33/entire-brain","parsed_cmd":[{"type":"read","cmd":"sed -n '281,850p' benchmarks/agent-brain/confirmatory/negative_control_cache_bundle_v2.py","name":"negative_control_cache_bundle_v2.py","path":"benchmarks/agent-brain/confirmatory/negative_control_cache_bundle_v2.py"}],"source":"unified_exec_startup","status":"completed","stdout":"        if descriptor >= 0:\n            os.close(descriptor)\n        for current in reversed(directories):\n            os.close(current)\n        raise CacheBundleVerificationError(f\"cannot open {label}\") from exc\n\n\ndef _stat_identity(value: os.stat_result) -> tuple[int, ...]:\n    return (\n        value.st_dev,\n        value.st_ino,\n        value.st_mode,\n        value.st_uid,\n        value.st_gid,\n        value.st_nlink,\n        value.st_size,\n        value.st_mtime_ns,\n        value.st_ctime_ns,\n    )\n\n\ndef _read_checked_v1_source() -> bytes:\n    descriptor, directories = _open_source_descriptor(V1_SOURCE_PATH, label=\"v1 raw verifier source\")\n    try:\n        before = os.fstat(descriptor)\n        _require(before.st_size == CHECKED_V1_SOURCE_SIZE, \"v1 raw verifier source size differs\")\n        chunks: list[bytes] = []\n        remaining = CHECKED_V1_SOURCE_SIZE + 1\n        while remaining:\n            chunk = os.read(descriptor, min(READ_CHUNK_BYTES, remaining))\n            if not chunk:\n                break\n            chunks.append(chunk)\n            remaining -= len(chunk)\n        raw = b\"\".join(chunks)\n        after = os.fstat(descriptor)\n        _require(\n            len(raw) == CHECKED_V1_SOURCE_SIZE\n            and _stat_identity(before) == _stat_identity(after),\n            \"v1 raw verifier source changed while reading\",\n        )\n        _require(_sha256(raw) == CHECKED_V1_SOURCE_SHA256, \"v1 raw verifier source hash differs\")\n        return raw\n    finally:\n        os.close(descriptor)\n        for current in reversed(directories):\n            os.close(current)\n\n\ndef _checked_v1() -> types.ModuleType:\n    global _V1_MODULE\n\n    raw = _read_checked_v1_source()\n    if _V1_MODULE is not None:\n        return _V1_MODULE\n    module_name = \"_entire_brain_checked_negative_control_cache_archive_v1\"\n    module = types.ModuleType(module_name)\n    module.__file__ = str(V1_SOURCE_PATH)\n    previous = sys.modules.get(module_name)\n    try:\n        code = compile(raw, str(V1_SOURCE_PATH), \"exec\", dont_inherit=True)\n        sys.modules[module_name] = module\n        exec(code, module.__dict__)\n    except Exception as exc:\n        raise CacheBundleVerificationError(\"checked v1 raw verifier source cannot be loaded\") from exc\n    finally:\n        if previous is None:\n            sys.modules.pop(module_name, None)\n        else:\n            sys.modules[module_name] = previous\n    required = (\n        \"_audit_schema\",\n        \"_read_bounded\",\n        \"_load_fixed_dependencies\",\n        \"_load_schema\",\n        \"_read_json\",\n        \"_render\",\n        \"_canonical_bytes\",\n        \"_field_self_hash\",\n        \"_validate_schema\",\n        \"_validate_manifest_identity\",\n        \"_open_regular_descriptor\",\n        \"_stable_stat_identity\",\n        \"check_verifier_contract\",\n        \"CacheArchiveVerificationError\",\n    )\n    _require(all(hasattr(module, name) for name in required), \"checked v1 raw verifier API differs\")\n    _V1_MODULE = module\n    return module\n\n\ndef _manifest_projection_sha256(manifest: Mapping[str, Any]) -> str:\n    v1 = _checked_v1()\n    projected = copy.deepcopy(dict(manifest))\n    archive = projected.get(\"archive\")\n    _require(type(archive) is dict, \"manifest archive projection differs\")\n    archive_map = cast(dict[str, Any], archive)\n    archive_map[\"byte_count\"] = None\n    archive_map[\"sha256\"] = None\n    _require(\"manifest_sha256\" in projected, \"manifest self hash is absent\")\n    projected[\"manifest_sha256\"] = None\n    try:\n        canonical = v1._canonical_bytes(projected)\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    return hashlib.sha256(MANIFEST_PROJECTION_DOMAIN + canonical).hexdigest()\n\n\ndef _validate_bundle_path_policy(manifest: Mapping[str, Any]) -> None:\n    \"\"\"Reject APFS named/resource-fork pseudo-components before byte parsing.\"\"\"\n\n    contents_value = manifest.get(\"contents\")\n    _require(type(contents_value) is dict, \"manifest contents differ\")\n    contents = cast(dict[str, Any], contents_value)\n    entries_value = contents.get(\"entries\")\n    _require(type(entries_value) is list, \"manifest entries differ\")\n    for index, entry_value in enumerate(cast(list[Any], entries_value)):\n        _require(type(entry_value) is dict, f\"manifest entry[{index}] differs\")\n        entry = cast(dict[str, Any], entry_value)\n        path_value = entry.get(\"path\")\n        _require(type(path_value) is str, f\"manifest entry[{index}] path differs\")\n        path = cast(str, path_value)\n        _require(\n            all(component.casefold() != \"..namedfork\" for component in path.split(\"/\")),\n            f\"manifest entry[{index}] APFS ..namedfork component is forbidden\",\n        )\n\n\nclass _BundleReader:\n    \"\"\"Checked-subtraction reader and domain-separated pass-two hash feeder.\"\"\"\n\n    def __init__(self, descriptor: int, bundle_bytes: int) -> None:\n        _require(\n            type(bundle_bytes) is int\n            and MIN_BUNDLE_BYTES <= bundle_bytes <= MAX_BUNDLE_BYTES,\n            \"bundle byte count is outside the frozen ceiling\",\n        )\n        self.descriptor = descriptor\n        self.bundle_bytes = bundle_bytes\n        self.remaining = bundle_bytes\n        self.offset = 0\n        self.trailer_offset = bundle_bytes - TRAILER_BYTES\n        self.prefix_limit = bundle_bytes - 32\n        self.records_digest = hashlib.sha256(RECORDS_DOMAIN)\n        self.prefix_digest = hashlib.sha256(PREFIX_DOMAIN)\n\n    def _feed(self, raw: bytes, start: int) -> None:\n        end = start + len(raw)\n        prefix_end = min(end, self.prefix_limit)\n        if start < prefix_end:\n            self.prefix_digest.update(raw[: prefix_end - start])\n        records_start = max(start, HEADER_BYTES)\n        records_end = min(end, self.trailer_offset)\n        if records_start < records_end:\n            left = records_start - start\n            self.records_digest.update(raw[left : left + records_end - records_start])\n\n    def read_exact(self, count: int, *, label: str, tail_reserve: int = 0) -> bytes:\n        _require(type(count) is int and count >= 0, f\"{label} byte count is invalid\")\n        _require(\n            type(tail_reserve) is int\n            and tail_reserve >= 0\n            and tail_reserve <= self.remaining\n            and count <= self.remaining - tail_reserve,\n            f\"{label} exceeds the remaining bundle bytes\",\n        )\n        chunks: list[bytes] = []\n        needed = count\n        start = self.offset\n        while needed:\n            try:\n                chunk = os.read(self.descriptor, min(READ_CHUNK_BYTES, needed))\n            except OSError as exc:\n                raise CacheBundleVerificationError(f\"cannot read {label}\") from exc\n            _require(bool(chunk), f\"{label} is truncated\")\n            chunks.append(chunk)\n            needed -= len(chunk)\n        raw = b\"\".join(chunks)\n        self._feed(raw, start)\n        self.offset += count\n        self.remaining -= count\n        return raw\n\n    def hash_content(\n        self,\n        count: int,\n        *,\n        expected_sha256: str,\n        label: str,\n        tail_reserve: int,\n    ) -> None:\n        _require(\n            type(count) is int\n            and count >= 1\n            and tail_reserve <= self.remaining\n            and count <= self.remaining - tail_reserve,\n            f\"{label} exceeds the remaining bundle bytes\",\n        )\n        digest = hashlib.sha256()\n        needed = count\n        while needed:\n            chunk_count = min(READ_CHUNK_BYTES, needed)\n            chunk = self.read_exact(\n                chunk_count,\n                label=label,\n                tail_reserve=tail_reserve,\n            )\n            digest.update(chunk)\n            needed -= len(chunk)\n        _require(digest.hexdigest() == expected_sha256, f\"{label} SHA-256 differs\")\n\n\ndef _raw_identity_pass(\n    descriptor: int,\n    *,\n    expected_byte_count: int,\n    expected_sha256: str,\n) -> tuple[dict[str, Any], os.stat_result]:\n    before = os.fstat(descriptor)\n    _require(stat.S_ISREG(before.st_mode), \"cache bundle is not a regular file\")\n    _require(before.st_nlink == 1, \"cache bundle must not be hard-linked\")\n    _require(\n        before.st_size == expected_byte_count\n        and MIN_BUNDLE_BYTES <= before.st_size <= MAX_BUNDLE_BYTES,\n        \"cache bundle byte count differs\",\n    )\n    try:\n        _require(os.lseek(descriptor, 0, os.SEEK_CUR) == 0, \"cache bundle initial offset differs\")\n    except OSError as exc:\n        raise CacheBundleVerificationError(\"cache bundle offset is unavailable\") from exc\n    digest = hashlib.sha256()\n    byte_count = 0\n    while True:\n        try:\n            chunk = os.read(descriptor, READ_CHUNK_BYTES)\n        except OSError as exc:\n            raise CacheBundleVerificationError(\"cannot read cache bundle raw identity\") from exc\n        if not chunk:\n            break\n        byte_count += len(chunk)\n        _require(byte_count <= expected_byte_count, \"cache bundle exceeds its reviewed byte count\")\n        digest.update(chunk)\n    after = os.fstat(descriptor)\n    _require(\n        byte_count == expected_byte_count\n        and _stat_identity(before) == _stat_identity(after),\n        \"cache bundle changed during raw identity verification\",\n    )\n    identity = {\"byte_count\": byte_count, \"sha256\": digest.hexdigest()}\n    _require(\n        identity == {\"byte_count\": expected_byte_count, \"sha256\": expected_sha256},\n        \"cache bundle raw identity differs from reviewed v1 material\",\n    )\n    try:\n        position = os.lseek(descriptor, 0, os.SEEK_SET)\n    except OSError as exc:\n        raise CacheBundleVerificationError(\"cache bundle cannot be rewound\") from exc\n    _require(position == 0, \"cache bundle rewind differs\")\n    return identity, before\n\n\ndef _parse_content_pass(\n    descriptor: int,\n    *,\n    bundle_stat: os.stat_result,\n    manifest: Mapping[str, Any],\n    format_contract: Mapping[str, Any],\n) -> dict[str, Any]:\n    _validate_bundle_path_policy(manifest)\n    contents = manifest.get(\"contents\")\n    _require(type(contents) is dict, \"manifest contents differ\")\n    contents_map = cast(dict[str, Any], contents)\n    entries_value = contents_map.get(\"entries\")\n    _require(type(entries_value) is list, \"manifest entries differ\")\n    entries = cast(list[Any], entries_value)\n    file_count_value = contents_map.get(\"file_count\")\n    unpacked_bytes_value = contents_map.get(\"unpacked_byte_count\")\n    repository_counts_value = contents_map.get(\"repository_file_counts\")\n    _require(\n        type(file_count_value) is int\n        and 3 <= file_count_value <= MAX_FILE_COUNT\n        and file_count_value == len(entries),\n        \"manifest file count differs\",\n    )\n    file_count = cast(int, file_count_value)\n    _require(\n        type(unpacked_bytes_value) is int\n        and 1 <= unpacked_bytes_value <= MAX_UNPACKED_BYTES,\n        \"manifest unpacked byte count differs\",\n    )\n    unpacked_bytes = cast(int, unpacked_bytes_value)\n    _require(\n        type(repository_counts_value) is dict\n        and set(repository_counts_value) == set(REPOSITORY_ORDER),\n        \"manifest repository counts differ\",\n    )\n    repository_counts_map = cast(dict[str, Any], repository_counts_value)\n    _require(\n        all(\n            type(repository_counts_map[key]) is int\n            and cast(int, repository_counts_map[key]) >= 1\n            for key in REPOSITORY_ORDER\n        ),\n        \"manifest repository counts are outside the frozen limits\",\n    )\n    repository_counts = {\n        key: cast(int, repository_counts_map[key]) for key in REPOSITORY_ORDER\n    }\n    _require(\n        sum(repository_counts.values()) == file_count,\n        \"manifest repository counts do not sum to the file count\",\n    )\n    path_total = 0\n    for index, entry in enumerate(entries):\n        _require(type(entry) is dict, f\"manifest entry[{index}] differs\")\n        entry_map = cast(dict[str, Any], entry)\n        path_value = entry_map.get(\"path\")\n        _require(type(path_value) is str, f\"manifest entry[{index}] path differs\")\n        path_total += len(cast(str, path_value).encode(\"utf-8\"))\n        _require(path_total <= MAX_BUNDLE_BYTES, \"manifest path bytes exceed the bundle ceiling\")\n    expected_bundle_bytes = (\n        HEADER_BYTES\n        + TRAILER_BYTES\n        + RECORD_FIXED_BYTES * file_count\n        + path_total\n        + unpacked_bytes\n    )\n    _require(\n        expected_bundle_bytes == bundle_stat.st_size\n        and expected_bundle_bytes <= MAX_BUNDLE_BYTES,\n        \"cache bundle exact byte-count formula differs\",\n    )\n\n    reader = _BundleReader(descriptor, bundle_stat.st_size)\n    header_raw = reader.read_exact(HEADER_BYTES, label=\"cache bundle header\", tail_reserve=TRAILER_BYTES)\n    try:\n        header = struct.unpack(\">16sHHIQQQQQQ32s32s32s32s32s\", header_raw)\n    except struct.error as exc:\n        raise CacheBundleVerificationError(\"cache bundle header layout differs\") from exc\n    (\n        magic,\n        version,\n        header_bytes,\n        flags,\n        declared_bundle_bytes,\n        declared_file_count,\n        declared_unpacked_bytes,\n        brain_count,\n        db_count,\n        graph_count,\n        format_sha,\n        manifest_projection_sha,\n        inventory_sha,\n        plan_sha,\n        toolchain_sha,\n    ) = header\n    expected_format_sha = format_contract.get(\"format_contract_sha256\")\n    _require(\n        magic == HEADER_MAGIC\n        and version == FORMAT_VERSION\n        and header_bytes == HEADER_BYTES\n        and flags == 0,\n        \"cache bundle header identity differs\",\n    )\n    _require(\n        declared_bundle_bytes == bundle_stat.st_size\n        and declared_file_count == file_count\n        and declared_unpacked_bytes == unpacked_bytes\n        and (brain_count, db_count, graph_count)\n        == tuple(repository_counts[key] for key in REPOSITORY_ORDER),\n        \"cache bundle header counts differ from manifest\",\n    )\n    run_plan_value = manifest.get(\"run_plan\")\n    _require(type(run_plan_value) is dict, \"manifest run-plan binding differs\")\n    run_plan = cast(dict[str, Any], run_plan_value)\n    _require(\n        type(expected_format_sha) is str\n        and format_sha.hex() == expected_format_sha\n        and manifest_projection_sha.hex() == _manifest_projection_sha256(manifest)\n        and inventory_sha.hex() == contents_map.get(\"inventory_sha256\")\n        and plan_sha.hex() == run_plan.get(\"plan_sha256\")\n        and toolchain_sha.hex()\n        == run_plan.get(\"toolchain_bindings_sha256\"),\n        \"cache bundle header bindings differ\",\n    )\n\n    unpacked_total = 0\n    observed_counts = {key: 0 for key in REPOSITORY_ORDER}\n    for ordinal, entry in enumerate(entries):\n        _require(type(entry) is dict, f\"manifest entry[{ordinal}] differs\")\n        remaining_records = file_count - ordinal - 1\n        minimum_tail = TRAILER_BYTES + remaining_records * (RECORD_FIXED_BYTES + 1 + 1)\n        fixed = reader.read_exact(\n            RECORD_FIXED_BYTES,\n            label=f\"cache bundle record[{ordinal}] header\",\n            tail_reserve=minimum_tail,\n        )\n        try:\n            record_magic, repository_id, record_flags, path_bytes, record_ordinal, content_bytes, content_sha = struct.unpack(\n                \">4sBBHIQ32s\", fixed\n            )\n        except struct.error as exc:\n            raise CacheBundleVerificationError(f\"cache bundle record[{ordinal}] layout differs\") from exc\n        _require(\n            record_magic == RECORD_MAGIC\n            and record_flags == 0\n            and record_ordinal == ordinal,\n            f\"cache bundle record[{ordinal}] identity differs\",\n        )\n        repository_key = entry.get(\"repository_key\")\n        _require(\n            repository_key in REPOSITORY_IDS\n            and repository_id == REPOSITORY_IDS[cast(str, repository_key)],\n            f\"cache bundle record[{ordinal}] repository differs\",\n        )\n        _require(1 <= path_bytes <= MAX_PATH_BYTES, f\"cache bundle record[{ordinal}] path length differs\")\n        path_raw = reader.read_exact(\n            path_bytes,\n            label=f\"cache bundle record[{ordinal}] path\",\n            tail_reserve=minimum_tail + content_bytes,\n        )\n        try:\n            path = path_raw.decode(\"utf-8\")\n        except UnicodeError as exc:\n            raise CacheBundleVerificationError(f\"cache bundle record[{ordinal}] path is not UTF-8\") from exc\n        _require(\n            path == entry.get(\"path\")\n            and path_raw == cast(str, entry.get(\"path\")).encode(\"utf-8\"),\n            f\"cache bundle record[{ordinal}] path differs from manifest\",\n        )\n        _require(\n            type(content_bytes) is int\n            and content_bytes == entry.get(\"byte_count\")\n            and 1 <= content_bytes <= MAX_UNPACKED_BYTES\n            and content_sha.hex() == entry.get(\"sha256\"),\n            f\"cache bundle record[{ordinal}] content declaration differs\",\n        )\n        unpacked_total += content_bytes\n        _require(unpacked_total <= MAX_UNPACKED_BYTES, \"cache bundle unpacked bytes exceed the ceiling\")\n        reader.hash_content(\n            content_bytes,\n            expected_sha256=content_sha.hex(),\n            label=f\"cache bundle record[{ordinal}] content\",\n            tail_reserve=minimum_tail,\n        )\n        observed_counts[cast(str, repository_key)] += 1\n\n    trailer_raw = reader.read_exact(TRAILER_BYTES, label=\"cache bundle trailer\")\n    try:\n        trailer = struct.unpack(\">16sQQQ32s32s\", trailer_raw)\n    except struct.error as exc:\n        raise CacheBundleVerificationError(\"cache bundle trailer layout differs\") from exc\n    trailer_magic, trailer_bundle_bytes, trailer_file_count, trailer_unpacked, records_sha, prefix_sha = trailer\n    _require(\n        trailer_magic == TRAILER_MAGIC\n        and trailer_bundle_bytes == bundle_stat.st_size\n        and trailer_file_count == file_count\n        and trailer_unpacked == unpacked_bytes,\n        \"cache bundle trailer counts differ\",\n    )\n    _require(reader.remaining == 0 and reader.offset == bundle_stat.st_size, \"cache bundle has trailing bytes\")\n    _require(unpacked_total == unpacked_bytes, \"cache bundle content byte total differs\")\n    _require(observed_counts == repository_counts, \"cache bundle repository totals differ\")\n    _require(records_sha == reader.records_digest.digest(), \"cache bundle records digest differs\")\n    _require(prefix_sha == reader.prefix_digest.digest(), \"cache bundle prefix digest differs\")\n    try:\n        _require(os.read(descriptor, 1) == b\"\", \"cache bundle exact EOF differs\")\n    except OSError as exc:\n        raise CacheBundleVerificationError(\"cannot verify cache bundle EOF\") from exc\n    after = os.fstat(descriptor)\n    _require(\n        _stat_identity(after) == _stat_identity(bundle_stat),\n        \"cache bundle changed during content verification\",\n    )\n    return {\n        \"bundle_byte_count\": bundle_stat.st_size,\n        \"file_count\": file_count,\n        \"records_sha256\": records_sha.hex(),\n        \"prefix_sha256\": prefix_sha.hex(),\n        \"repository_file_counts\": copy.deepcopy(repository_counts),\n        \"unpacked_byte_count\": unpacked_bytes,\n    }\n\n\ndef _file_binding(path: pathlib.Path, raw: bytes) -> dict[str, str]:\n    return {\"artifact_file\": path.name, \"artifact_sha256\": _sha256(raw)}\n\n\ndef _validate_format_contract(\n    value: Mapping[str, Any],\n    *,\n    schema: Mapping[str, Any],\n    v1: types.ModuleType,\n) -> dict[str, Any]:\n    try:\n        v1._validate_schema(\n            value,\n            schema,\n            schema_name=FORMAT_SCHEMA_PATH.name,\n            label=\"cache bundle format contract\",\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    expected_fields = {\n        \"authority\",\n        \"canonical_json_profile\",\n        \"digests\",\n        \"format_contract_sha256\",\n        \"header\",\n        \"integer_encoding\",\n        \"limits\",\n        \"manifest_projection\",\n        \"ordering\",\n        \"profile\",\n        \"record\",\n        \"representability\",\n        \"schema_version\",\n        \"status\",\n        \"trailer\",\n    }\n    _require(type(value) is dict and set(value) == expected_fields, \"format-contract fields differ\")\n    _require(\n        value[\"profile\"] == FORMAT_PROFILE\n        and value[\"schema_version\"] == SCHEMA_VERSION\n        and value[\"status\"] == FORMAT_STATUS,\n        \"format-contract identity differs\",\n    )\n    try:\n        self_hash = v1._field_self_hash(value, \"format_contract_sha256\")\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    _require(\n        value[\"format_contract_sha256\"] == CHECKED_FORMAT_SHA256\n        and value[\"format_contract_sha256\"] == self_hash,\n        \"format-contract self hash differs\",\n    )\n    return copy.deepcopy(dict(value))\n\n\ndef _load_fixed_dependencies() -> dict[str, Any]:\n    v1 = _checked_v1()\n    try:\n        v1_dependencies = v1._load_fixed_dependencies()\n        v1_verifier_contract = v1.check_verifier_contract()\n        v1_verifier_contract_read, v1_verifier_contract_raw = v1._read_json(\n            V1_VERIFIER_CONTRACT_PATH,\n            maximum=MAX_VERIFIER_CONTRACT_BYTES,\n            label=\"v1 cache archive verifier contract\",\n            canonical=True,\n            require_single_link=True,\n        )\n        _require(\n            v1_verifier_contract_read == v1_verifier_contract\n            and v1_verifier_contract_raw == v1._render(v1_verifier_contract),\n            \"v1 cache archive verifier contract differs\",\n        )\n        format_schema, format_schema_raw = v1._load_schema(\n            FORMAT_SCHEMA_PATH,\n            REDACTED,\n            label=\"cache bundle format schema\",\n        )\n        report_schema, report_schema_raw = v1._load_schema(\n            REPORT_SCHEMA_PATH,\n            expected_sha256=CHECKED_REPORT_SCHEMA_SHA256,\n            label=\"cache bundle report schema\",\n        )\n        verifier_schema, verifier_schema_raw = v1._load_schema(\n            VERIFIER_SCHEMA_PATH,\n            expected_sha256=CHECKED_VERIFIER_SCHEMA_SHA256,\n            label=\"cache bundle verifier schema\",\n","stderr":"","aggregated_output":"        if descriptor >= 0:\n            os.close(descriptor)\n        for current in reversed(directories):\n            os.close(current)\n        raise CacheBundleVerificationError(f\"cannot open {label}\") from exc\n\n\ndef _stat_identity(value: os.stat_result) -> tuple[int, ...]:\n    return (\n        value.st_dev,\n        value.st_ino,\n        value.st_mode,\n        value.st_uid,\n        value.st_gid,\n        value.st_nlink,\n        value.st_size,\n        value.st_mtime_ns,\n        value.st_ctime_ns,\n    )\n\n\ndef _read_checked_v1_source() -> bytes:\n    descriptor, directories = _open_source_descriptor(V1_SOURCE_PATH, label=\"v1 raw verifier source\")\n    try:\n        before = os.fstat(descriptor)\n        _require(before.st_size == CHECKED_V1_SOURCE_SIZE, \"v1 raw verifier source size differs\")\n        chunks: list[bytes] = []\n        remaining = CHECKED_V1_SOURCE_SIZE + 1\n        while remaining:\n            chunk = os.read(descriptor, min(READ_CHUNK_BYTES, remaining))\n            if not chunk:\n                break\n            chunks.append(chunk)\n            remaining -= len(chunk)\n        raw = b\"\".join(chunks)\n        after = os.fstat(descriptor)\n        _require(\n            len(raw) == CHECKED_V1_SOURCE_SIZE\n            and _stat_identity(before) == _stat_identity(after),\n            \"v1 raw verifier source changed while reading\",\n        )\n        _require(_sha256(raw) == CHECKED_V1_SOURCE_SHA256, \"v1 raw verifier source hash differs\")\n        return raw\n    finally:\n        os.close(descriptor)\n        for current in reversed(directories):\n            os.close(current)\n\n\ndef _checked_v1() -> types.ModuleType:\n    global _V1_MODULE\n\n    raw = _read_checked_v1_source()\n    if _V1_MODULE is not None:\n        return _V1_MODULE\n    module_name = \"_entire_brain_checked_negative_control_cache_archive_v1\"\n    module = types.ModuleType(module_name)\n    module.__file__ = str(V1_SOURCE_PATH)\n    previous = sys.modules.get(module_name)\n    try:\n        code = compile(raw, str(V1_SOURCE_PATH), \"exec\", dont_inherit=True)\n        sys.modules[module_name] = module\n        exec(code, module.__dict__)\n    except Exception as exc:\n        raise CacheBundleVerificationError(\"checked v1 raw verifier source cannot be loaded\") from exc\n    finally:\n        if previous is None:\n            sys.modules.pop(module_name, None)\n        else:\n            sys.modules[module_name] = previous\n    required = (\n        \"_audit_schema\",\n        \"_read_bounded\",\n        \"_load_fixed_dependencies\",\n        \"_load_schema\",\n        \"_read_json\",\n        \"_render\",\n        \"_canonical_bytes\",\n        \"_field_self_hash\",\n        \"_validate_schema\",\n        \"_validate_manifest_identity\",\n        \"_open_regular_descriptor\",\n        \"_stable_stat_identity\",\n        \"check_verifier_contract\",\n        \"CacheArchiveVerificationError\",\n    )\n    _require(all(hasattr(module, name) for name in required), \"checked v1 raw verifier API differs\")\n    _V1_MODULE = module\n    return module\n\n\ndef _manifest_projection_sha256(manifest: Mapping[str, Any]) -> str:\n    v1 = _checked_v1()\n    projected = copy.deepcopy(dict(manifest))\n    archive = projected.get(\"archive\")\n    _require(type(archive) is dict, \"manifest archive projection differs\")\n    archive_map = cast(dict[str, Any], archive)\n    archive_map[\"byte_count\"] = None\n    archive_map[\"sha256\"] = None\n    _require(\"manifest_sha256\" in projected, \"manifest self hash is absent\")\n    projected[\"manifest_sha256\"] = None\n    try:\n        canonical = v1._canonical_bytes(projected)\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    return hashlib.sha256(MANIFEST_PROJECTION_DOMAIN + canonical).hexdigest()\n\n\ndef _validate_bundle_path_policy(manifest: Mapping[str, Any]) -> None:\n    \"\"\"Reject APFS named/resource-fork pseudo-components before byte parsing.\"\"\"\n\n    contents_value = manifest.get(\"contents\")\n    _require(type(contents_value) is dict, \"manifest contents differ\")\n    contents = cast(dict[str, Any], contents_value)\n    entries_value = contents.get(\"entries\")\n    _require(type(entries_value) is list, \"manifest entries differ\")\n    for index, entry_value in enumerate(cast(list[Any], entries_value)):\n        _require(type(entry_value) is dict, f\"manifest entry[{index}] differs\")\n        entry = cast(dict[str, Any], entry_value)\n        path_value = entry.get(\"path\")\n        _require(type(path_value) is str, f\"manifest entry[{index}] path differs\")\n        path = cast(str, path_value)\n        _require(\n            all(component.casefold() != \"..namedfork\" for component in path.split(\"/\")),\n            f\"manifest entry[{index}] APFS ..namedfork component is forbidden\",\n        )\n\n\nclass _BundleReader:\n    \"\"\"Checked-subtraction reader and domain-separated pass-two hash feeder.\"\"\"\n\n    def __init__(self, descriptor: int, bundle_bytes: int) -> None:\n        _require(\n            type(bundle_bytes) is int\n            and MIN_BUNDLE_BYTES <= bundle_bytes <= MAX_BUNDLE_BYTES,\n            \"bundle byte count is outside the frozen ceiling\",\n        )\n        self.descriptor = descriptor\n        self.bundle_bytes = bundle_bytes\n        self.remaining = bundle_bytes\n        self.offset = 0\n        self.trailer_offset = bundle_bytes - TRAILER_BYTES\n        self.prefix_limit = bundle_bytes - 32\n        self.records_digest = hashlib.sha256(RECORDS_DOMAIN)\n        self.prefix_digest = hashlib.sha256(PREFIX_DOMAIN)\n\n    def _feed(self, raw: bytes, start: int) -> None:\n        end = start + len(raw)\n        prefix_end = min(end, self.prefix_limit)\n        if start < prefix_end:\n            self.prefix_digest.update(raw[: prefix_end - start])\n        records_start = max(start, HEADER_BYTES)\n        records_end = min(end, self.trailer_offset)\n        if records_start < records_end:\n            left = records_start - start\n            self.records_digest.update(raw[left : left + records_end - records_start])\n\n    def read_exact(self, count: int, *, label: str, tail_reserve: int = 0) -> bytes:\n        _require(type(count) is int and count >= 0, f\"{label} byte count is invalid\")\n        _require(\n            type(tail_reserve) is int\n            and tail_reserve >= 0\n            and tail_reserve <= self.remaining\n            and count <= self.remaining - tail_reserve,\n            f\"{label} exceeds the remaining bundle bytes\",\n        )\n        chunks: list[bytes] = []\n        needed = count\n        start = self.offset\n        while needed:\n            try:\n                chunk = os.read(self.descriptor, min(READ_CHUNK_BYTES, needed))\n            except OSError as exc:\n                raise CacheBundleVerificationError(f\"cannot read {label}\") from exc\n            _require(bool(chunk), f\"{label} is truncated\")\n            chunks.append(chunk)\n            needed -= len(chunk)\n        raw = b\"\".join(chunks)\n        self._feed(raw, start)\n        self.offset += count\n        self.remaining -= count\n        return raw\n\n    def hash_content(\n        self,\n        count: int,\n        *,\n        expected_sha256: str,\n        label: str,\n        tail_reserve: int,\n    ) -> None:\n        _require(\n            type(count) is int\n            and count >= 1\n            and tail_reserve <= self.remaining\n            and count <= self.remaining - tail_reserve,\n            f\"{label} exceeds the remaining bundle bytes\",\n        )\n        digest = hashlib.sha256()\n        needed = count\n        while needed:\n            chunk_count = min(READ_CHUNK_BYTES, needed)\n            chunk = self.read_exact(\n                chunk_count,\n                label=label,\n                tail_reserve=tail_reserve,\n            )\n            digest.update(chunk)\n            needed -= len(chunk)\n        _require(digest.hexdigest() == expected_sha256, f\"{label} SHA-256 differs\")\n\n\ndef _raw_identity_pass(\n    descriptor: int,\n    *,\n    expected_byte_count: int,\n    expected_sha256: str,\n) -> tuple[dict[str, Any], os.stat_result]:\n    before = os.fstat(descriptor)\n    _require(stat.S_ISREG(before.st_mode), \"cache bundle is not a regular file\")\n    _require(before.st_nlink == 1, \"cache bundle must not be hard-linked\")\n    _require(\n        before.st_size == expected_byte_count\n        and MIN_BUNDLE_BYTES <= before.st_size <= MAX_BUNDLE_BYTES,\n        \"cache bundle byte count differs\",\n    )\n    try:\n        _require(os.lseek(descriptor, 0, os.SEEK_CUR) == 0, \"cache bundle initial offset differs\")\n    except OSError as exc:\n        raise CacheBundleVerificationError(\"cache bundle offset is unavailable\") from exc\n    digest = hashlib.sha256()\n    byte_count = 0\n    while True:\n        try:\n            chunk = os.read(descriptor, READ_CHUNK_BYTES)\n        except OSError as exc:\n            raise CacheBundleVerificationError(\"cannot read cache bundle raw identity\") from exc\n        if not chunk:\n            break\n        byte_count += len(chunk)\n        _require(byte_count <= expected_byte_count, \"cache bundle exceeds its reviewed byte count\")\n        digest.update(chunk)\n    after = os.fstat(descriptor)\n    _require(\n        byte_count == expected_byte_count\n        and _stat_identity(before) == _stat_identity(after),\n        \"cache bundle changed during raw identity verification\",\n    )\n    identity = {\"byte_count\": byte_count, \"sha256\": digest.hexdigest()}\n    _require(\n        identity == {\"byte_count\": expected_byte_count, \"sha256\": expected_sha256},\n        \"cache bundle raw identity differs from reviewed v1 material\",\n    )\n    try:\n        position = os.lseek(descriptor, 0, os.SEEK_SET)\n    except OSError as exc:\n        raise CacheBundleVerificationError(\"cache bundle cannot be rewound\") from exc\n    _require(position == 0, \"cache bundle rewind differs\")\n    return identity, before\n\n\ndef _parse_content_pass(\n    descriptor: int,\n    *,\n    bundle_stat: os.stat_result,\n    manifest: Mapping[str, Any],\n    format_contract: Mapping[str, Any],\n) -> dict[str, Any]:\n    _validate_bundle_path_policy(manifest)\n    contents = manifest.get(\"contents\")\n    _require(type(contents) is dict, \"manifest contents differ\")\n    contents_map = cast(dict[str, Any], contents)\n    entries_value = contents_map.get(\"entries\")\n    _require(type(entries_value) is list, \"manifest entries differ\")\n    entries = cast(list[Any], entries_value)\n    file_count_value = contents_map.get(\"file_count\")\n    unpacked_bytes_value = contents_map.get(\"unpacked_byte_count\")\n    repository_counts_value = contents_map.get(\"repository_file_counts\")\n    _require(\n        type(file_count_value) is int\n        and 3 <= file_count_value <= MAX_FILE_COUNT\n        and file_count_value == len(entries),\n        \"manifest file count differs\",\n    )\n    file_count = cast(int, file_count_value)\n    _require(\n        type(unpacked_bytes_value) is int\n        and 1 <= unpacked_bytes_value <= MAX_UNPACKED_BYTES,\n        \"manifest unpacked byte count differs\",\n    )\n    unpacked_bytes = cast(int, unpacked_bytes_value)\n    _require(\n        type(repository_counts_value) is dict\n        and set(repository_counts_value) == set(REPOSITORY_ORDER),\n        \"manifest repository counts differ\",\n    )\n    repository_counts_map = cast(dict[str, Any], repository_counts_value)\n    _require(\n        all(\n            type(repository_counts_map[key]) is int\n            and cast(int, repository_counts_map[key]) >= 1\n            for key in REPOSITORY_ORDER\n        ),\n        \"manifest repository counts are outside the frozen limits\",\n    )\n    repository_counts = {\n        key: cast(int, repository_counts_map[key]) for key in REPOSITORY_ORDER\n    }\n    _require(\n        sum(repository_counts.values()) == file_count,\n        \"manifest repository counts do not sum to the file count\",\n    )\n    path_total = 0\n    for index, entry in enumerate(entries):\n        _require(type(entry) is dict, f\"manifest entry[{index}] differs\")\n        entry_map = cast(dict[str, Any], entry)\n        path_value = entry_map.get(\"path\")\n        _require(type(path_value) is str, f\"manifest entry[{index}] path differs\")\n        path_total += len(cast(str, path_value).encode(\"utf-8\"))\n        _require(path_total <= MAX_BUNDLE_BYTES, \"manifest path bytes exceed the bundle ceiling\")\n    expected_bundle_bytes = (\n        HEADER_BYTES\n        + TRAILER_BYTES\n        + RECORD_FIXED_BYTES * file_count\n        + path_total\n        + unpacked_bytes\n    )\n    _require(\n        expected_bundle_bytes == bundle_stat.st_size\n        and expected_bundle_bytes <= MAX_BUNDLE_BYTES,\n        \"cache bundle exact byte-count formula differs\",\n    )\n\n    reader = _BundleReader(descriptor, bundle_stat.st_size)\n    header_raw = reader.read_exact(HEADER_BYTES, label=\"cache bundle header\", tail_reserve=TRAILER_BYTES)\n    try:\n        header = struct.unpack(\">16sHHIQQQQQQ32s32s32s32s32s\", header_raw)\n    except struct.error as exc:\n        raise CacheBundleVerificationError(\"cache bundle header layout differs\") from exc\n    (\n        magic,\n        version,\n        header_bytes,\n        flags,\n        declared_bundle_bytes,\n        declared_file_count,\n        declared_unpacked_bytes,\n        brain_count,\n        db_count,\n        graph_count,\n        format_sha,\n        manifest_projection_sha,\n        inventory_sha,\n        plan_sha,\n        toolchain_sha,\n    ) = header\n    expected_format_sha = format_contract.get(\"format_contract_sha256\")\n    _require(\n        magic == HEADER_MAGIC\n        and version == FORMAT_VERSION\n        and header_bytes == HEADER_BYTES\n        and flags == 0,\n        \"cache bundle header identity differs\",\n    )\n    _require(\n        declared_bundle_bytes == bundle_stat.st_size\n        and declared_file_count == file_count\n        and declared_unpacked_bytes == unpacked_bytes\n        and (brain_count, db_count, graph_count)\n        == tuple(repository_counts[key] for key in REPOSITORY_ORDER),\n        \"cache bundle header counts differ from manifest\",\n    )\n    run_plan_value = manifest.get(\"run_plan\")\n    _require(type(run_plan_value) is dict, \"manifest run-plan binding differs\")\n    run_plan = cast(dict[str, Any], run_plan_value)\n    _require(\n        type(expected_format_sha) is str\n        and format_sha.hex() == expected_format_sha\n        and manifest_projection_sha.hex() == _manifest_projection_sha256(manifest)\n        and inventory_sha.hex() == contents_map.get(\"inventory_sha256\")\n        and plan_sha.hex() == run_plan.get(\"plan_sha256\")\n        and toolchain_sha.hex()\n        == run_plan.get(\"toolchain_bindings_sha256\"),\n        \"cache bundle header bindings differ\",\n    )\n\n    unpacked_total = 0\n    observed_counts = {key: 0 for key in REPOSITORY_ORDER}\n    for ordinal, entry in enumerate(entries):\n        _require(type(entry) is dict, f\"manifest entry[{ordinal}] differs\")\n        remaining_records = file_count - ordinal - 1\n        minimum_tail = TRAILER_BYTES + remaining_records * (RECORD_FIXED_BYTES + 1 + 1)\n        fixed = reader.read_exact(\n            RECORD_FIXED_BYTES,\n            label=f\"cache bundle record[{ordinal}] header\",\n            tail_reserve=minimum_tail,\n        )\n        try:\n            record_magic, repository_id, record_flags, path_bytes, record_ordinal, content_bytes, content_sha = struct.unpack(\n                \">4sBBHIQ32s\", fixed\n            )\n        except struct.error as exc:\n            raise CacheBundleVerificationError(f\"cache bundle record[{ordinal}] layout differs\") from exc\n        _require(\n            record_magic == RECORD_MAGIC\n            and record_flags == 0\n            and record_ordinal == ordinal,\n            f\"cache bundle record[{ordinal}] identity differs\",\n        )\n        repository_key = entry.get(\"repository_key\")\n        _require(\n            repository_key in REPOSITORY_IDS\n            and repository_id == REPOSITORY_IDS[cast(str, repository_key)],\n            f\"cache bundle record[{ordinal}] repository differs\",\n        )\n        _require(1 <= path_bytes <= MAX_PATH_BYTES, f\"cache bundle record[{ordinal}] path length differs\")\n        path_raw = reader.read_exact(\n            path_bytes,\n            label=f\"cache bundle record[{ordinal}] path\",\n            tail_reserve=minimum_tail + content_bytes,\n        )\n        try:\n            path = path_raw.decode(\"utf-8\")\n        except UnicodeError as exc:\n            raise CacheBundleVerificationError(f\"cache bundle record[{ordinal}] path is not UTF-8\") from exc\n        _require(\n            path == entry.get(\"path\")\n            and path_raw == cast(str, entry.get(\"path\")).encode(\"utf-8\"),\n            f\"cache bundle record[{ordinal}] path differs from manifest\",\n        )\n        _require(\n            type(content_bytes) is int\n            and content_bytes == entry.get(\"byte_count\")\n            and 1 <= content_bytes <= MAX_UNPACKED_BYTES\n            and content_sha.hex() == entry.get(\"sha256\"),\n            f\"cache bundle record[{ordinal}] content declaration differs\",\n        )\n        unpacked_total += content_bytes\n        _require(unpacked_total <= MAX_UNPACKED_BYTES, \"cache bundle unpacked bytes exceed the ceiling\")\n        reader.hash_content(\n            content_bytes,\n            expected_sha256=content_sha.hex(),\n            label=f\"cache bundle record[{ordinal}] content\",\n            tail_reserve=minimum_tail,\n        )\n        observed_counts[cast(str, repository_key)] += 1\n\n    trailer_raw = reader.read_exact(TRAILER_BYTES, label=\"cache bundle trailer\")\n    try:\n        trailer = struct.unpack(\">16sQQQ32s32s\", trailer_raw)\n    except struct.error as exc:\n        raise CacheBundleVerificationError(\"cache bundle trailer layout differs\") from exc\n    trailer_magic, trailer_bundle_bytes, trailer_file_count, trailer_unpacked, records_sha, prefix_sha = trailer\n    _require(\n        trailer_magic == TRAILER_MAGIC\n        and trailer_bundle_bytes == bundle_stat.st_size\n        and trailer_file_count == file_count\n        and trailer_unpacked == unpacked_bytes,\n        \"cache bundle trailer counts differ\",\n    )\n    _require(reader.remaining == 0 and reader.offset == bundle_stat.st_size, \"cache bundle has trailing bytes\")\n    _require(unpacked_total == unpacked_bytes, \"cache bundle content byte total differs\")\n    _require(observed_counts == repository_counts, \"cache bundle repository totals differ\")\n    _require(records_sha == reader.records_digest.digest(), \"cache bundle records digest differs\")\n    _require(prefix_sha == reader.prefix_digest.digest(), \"cache bundle prefix digest differs\")\n    try:\n        _require(os.read(descriptor, 1) == b\"\", \"cache bundle exact EOF differs\")\n    except OSError as exc:\n        raise CacheBundleVerificationError(\"cannot verify cache bundle EOF\") from exc\n    after = os.fstat(descriptor)\n    _require(\n        _stat_identity(after) == _stat_identity(bundle_stat),\n        \"cache bundle changed during content verification\",\n    )\n    return {\n        \"bundle_byte_count\": bundle_stat.st_size,\n        \"file_count\": file_count,\n        \"records_sha256\": records_sha.hex(),\n        \"prefix_sha256\": prefix_sha.hex(),\n        \"repository_file_counts\": copy.deepcopy(repository_counts),\n        \"unpacked_byte_count\": unpacked_bytes,\n    }\n\n\ndef _file_binding(path: pathlib.Path, raw: bytes) -> dict[str, str]:\n    return {\"artifact_file\": path.name, \"artifact_sha256\": _sha256(raw)}\n\n\ndef _validate_format_contract(\n    value: Mapping[str, Any],\n    *,\n    schema: Mapping[str, Any],\n    v1: types.ModuleType,\n) -> dict[str, Any]:\n    try:\n        v1._validate_schema(\n            value,\n            schema,\n            schema_name=FORMAT_SCHEMA_PATH.name,\n            label=\"cache bundle format contract\",\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    expected_fields = {\n        \"authority\",\n        \"canonical_json_profile\",\n        \"digests\",\n        \"format_contract_sha256\",\n        \"header\",\n        \"integer_encoding\",\n        \"limits\",\n        \"manifest_projection\",\n        \"ordering\",\n        \"profile\",\n        \"record\",\n        \"representability\",\n        \"schema_version\",\n        \"status\",\n        \"trailer\",\n    }\n    _require(type(value) is dict and set(value) == expected_fields, \"format-contract fields differ\")\n    _require(\n        value[\"profile\"] == FORMAT_PROFILE\n        and value[\"schema_version\"] == SCHEMA_VERSION\n        and value[\"status\"] == FORMAT_STATUS,\n        \"format-contract identity differs\",\n    )\n    try:\n        self_hash = v1._field_self_hash(value, \"format_contract_sha256\")\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    _require(\n        value[\"format_contract_sha256\"] == CHECKED_FORMAT_SHA256\n        and value[\"format_contract_sha256\"] == self_hash,\n        \"format-contract self hash differs\",\n    )\n    return copy.deepcopy(dict(value))\n\n\ndef _load_fixed_dependencies() -> dict[str, Any]:\n    v1 = _checked_v1()\n    try:\n        v1_dependencies = v1._load_fixed_dependencies()\n        v1_verifier_contract = v1.check_verifier_contract()\n        v1_verifier_contract_read, v1_verifier_contract_raw = v1._read_json(\n            V1_VERIFIER_CONTRACT_PATH,\n            maximum=MAX_VERIFIER_CONTRACT_BYTES,\n            label=\"v1 cache archive verifier contract\",\n            canonical=True,\n            require_single_link=True,\n        )\n        _require(\n            v1_verifier_contract_read == v1_verifier_contract\n            and v1_verifier_contract_raw == v1._render(v1_verifier_contract),\n            \"v1 cache archive verifier contract differs\",\n        )\n        format_schema, format_schema_raw = v1._load_schema(\n            FORMAT_SCHEMA_PATH,\n            REDACTED,\n            label=\"cache bundle format schema\",\n        )\n        report_schema, report_schema_raw = v1._load_schema(\n            REPORT_SCHEMA_PATH,\n            expected_sha256=CHECKED_REPORT_SCHEMA_SHA256,\n            label=\"cache bundle report schema\",\n        )\n        verifier_schema, verifier_schema_raw = v1._load_schema(\n            VERIFIER_SCHEMA_PATH,\n            expected_sha256=CHECKED_VERIFIER_SCHEMA_SHA256,\n            label=\"cache bundle verifier schema\",\n","exit_code":0,"duration":{"secs":0,"nanos":6833},"formatted_output":"        if descriptor >= 0:\n            os.close(descriptor)\n        for current in reversed(directories):\n            os.close(current)\n        raise CacheBundleVerificationError(f\"cannot open {label}\") from exc\n\n\ndef _stat_identity(value: os.stat_result) -> tuple[int, ...]:\n    return (\n        value.st_dev,\n        value.st_ino,\n        value.st_mode,\n        value.st_uid,\n        value.st_gid,\n        value.st_nlink,\n        value.st_size,\n        value.st_mtime_ns,\n        value.st_ctime_ns,\n    )\n\n\ndef _read_checked_v1_source() -> bytes:\n    descriptor, directories = _open_source_descriptor(V1_SOURCE_PATH, label=\"v1 raw verifier source\")\n    try:\n        before = os.fstat(descriptor)\n        _require(before.st_size == CHECKED_V1_SOURCE_SIZE, \"v1 raw verifier source size differs\")\n        chunks: list[bytes] = []\n        remaining = CHECKED_V1_SOURCE_SIZE + 1\n        while remaining:\n            chunk = os.read(descriptor, min(READ_CHUNK_BYTES, remaining))\n            if not chunk:\n                break\n            chunks.append(chunk)\n            remaining -= len(chunk)\n        raw = b\"\".join(chunks)\n        after = os.fstat(descriptor)\n        _require(\n            len(raw) == CHECKED_V1_SOURCE_SIZE\n            and _stat_identity(before) == _stat_identity(after),\n            \"v1 raw verifier source changed while reading\",\n        )\n        _require(_sha256(raw) == CHECKED_V1_SOURCE_SHA256, \"v1 raw verifier source hash differs\")\n        return raw\n    finally:\n        os.close(descriptor)\n        for current in reversed(directories):\n            os.close(current)\n\n\ndef _checked_v1() -> types.ModuleType:\n    global _V1_MODULE\n\n    raw = _read_checked_v1_source()\n    if _V1_MODULE is not None:\n        return _V1_MODULE\n    module_name = \"_entire_brain_checked_negative_control_cache_archive_v1\"\n    module = types.ModuleType(module_name)\n    module.__file__ = str(V1_SOURCE_PATH)\n    previous = sys.modules.get(module_name)\n    try:\n        code = compile(raw, str(V1_SOURCE_PATH), \"exec\", dont_inherit=True)\n        sys.modules[module_name] = module\n        exec(code, module.__dict__)\n    except Exception as exc:\n        raise CacheBundleVerificationError(\"checked v1 raw verifier source cannot be loaded\") from exc\n    finally:\n        if previous is None:\n            sys.modules.pop(module_name, None)\n        else:\n            sys.modules[module_name] = previous\n    required = (\n        \"_audit_schema\",\n        \"_read_bounded\",\n        \"_load_fixed_dependencies\",\n        \"_load_schema\",\n        \"_read_json\",\n        \"_render\",\n        \"_canonical_bytes\",\n        \"_field_self_hash\",\n        \"_validate_schema\",\n        \"_validate_manifest_identity\",\n        \"_open_regular_descriptor\",\n        \"_stable_stat_identity\",\n        \"check_verifier_contract\",\n        \"CacheArchiveVerificationError\",\n    )\n    _require(all(hasattr(module, name) for name in required), \"checked v1 raw verifier API differs\")\n    _V1_MODULE = module\n    return module\n\n\ndef _manifest_projection_sha256(manifest: Mapping[str, Any]) -> str:\n    v1 = _checked_v1()\n    projected = copy.deepcopy(dict(manifest))\n    archive = projected.get(\"archive\")\n    _require(type(archive) is dict, \"manifest archive projection differs\")\n    archive_map = cast(dict[str, Any], archive)\n    archive_map[\"byte_count\"] = None\n    archive_map[\"sha256\"] = None\n    _require(\"manifest_sha256\" in projected, \"manifest self hash is absent\")\n    projected[\"manifest_sha256\"] = None\n    try:\n        canonical = v1._canonical_bytes(projected)\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    return hashlib.sha256(MANIFEST_PROJECTION_DOMAIN + canonical).hexdigest()\n\n\ndef _validate_bundle_path_policy(manifest: Mapping[str, Any]) -> None:\n    \"\"\"Reject APFS named/resource-fork pseudo-components before byte parsing.\"\"\"\n\n    contents_value = manifest.get(\"contents\")\n    _require(type(contents_value) is dict, \"manifest contents differ\")\n    contents = cast(dict[str, Any], contents_value)\n    entries_value = contents.get(\"entries\")\n    _require(type(entries_value) is list, \"manifest entries differ\")\n    for index, entry_value in enumerate(cast(list[Any], entries_value)):\n        _require(type(entry_value) is dict, f\"manifest entry[{index}] differs\")\n        entry = cast(dict[str, Any], entry_value)\n        path_value = entry.get(\"path\")\n        _require(type(path_value) is str, f\"manifest entry[{index}] path differs\")\n        path = cast(str, path_value)\n        _require(\n            all(component.casefold() != \"..namedfork\" for component in path.split(\"/\")),\n            f\"manifest entry[{index}] APFS ..namedfork component is forbidden\",\n        )\n\n\nclass _BundleReader:\n    \"\"\"Checked-subtraction reader and domain-separated pass-two hash feeder.\"\"\"\n\n    def __init__(self, descriptor: int, bundle_bytes: int) -> None:\n        _require(\n            type(bundle_bytes) is int\n            and MIN_BUNDLE_BYTES <= bundle_bytes <= MAX_BUNDLE_BYTES,\n            \"bundle byte count is outside the frozen ceiling\",\n        )\n        self.descriptor = descriptor\n        self.bundle_bytes = bundle_bytes\n        self.remaining = bundle_bytes\n        self.offset = 0\n        self.trailer_offset = bundle_bytes - TRAILER_BYTES\n        self.prefix_limit = bundle_bytes - 32\n        self.records_digest = hashlib.sha256(RECORDS_DOMAIN)\n        self.prefix_digest = hashlib.sha256(PREFIX_DOMAIN)\n\n    def _feed(self, raw: bytes, start: int) -> None:\n        end = start + len(raw)\n        prefix_end = min(end, self.prefix_limit)\n        if start < prefix_end:\n            self.prefix_digest.update(raw[: prefix_end - start])\n        records_start = max(start, HEADER_BYTES)\n        records_end = min(end, self.trailer_offset)\n        if records_start < records_end:\n            left = records_start - start\n            self.records_digest.update(raw[left : left + records_end - records_start])\n\n    def read_exact(self, count: int, *, label: str, tail_reserve: int = 0) -> bytes:\n        _require(type(count) is int and count >= 0, f\"{label} byte count is invalid\")\n        _require(\n            type(tail_reserve) is int\n            and tail_reserve >= 0\n            and tail_reserve <= self.remaining\n            and count <= self.remaining - tail_reserve,\n            f\"{label} exceeds the remaining bundle bytes\",\n        )\n        chunks: list[bytes] = []\n        needed = count\n        start = self.offset\n        while needed:\n            try:\n                chunk = os.read(self.descriptor, min(READ_CHUNK_BYTES, needed))\n            except OSError as exc:\n                raise CacheBundleVerificationError(f\"cannot read {label}\") from exc\n            _require(bool(chunk), f\"{label} is truncated\")\n            chunks.append(chunk)\n            needed -= len(chunk)\n        raw = b\"\".join(chunks)\n        self._feed(raw, start)\n        self.offset += count\n        self.remaining -= count\n        return raw\n\n    def hash_content(\n        self,\n        count: int,\n        *,\n        expected_sha256: str,\n        label: str,\n        tail_reserve: int,\n    ) -> None:\n        _require(\n            type(count) is int\n            and count >= 1\n            and tail_reserve <= self.remaining\n            and count <= self.remaining - tail_reserve,\n            f\"{label} exceeds the remaining bundle bytes\",\n        )\n        digest = hashlib.sha256()\n        needed = count\n        while needed:\n            chunk_count = min(READ_CHUNK_BYTES, needed)\n            chunk = self.read_exact(\n                chunk_count,\n                label=label,\n                tail_reserve=tail_reserve,\n            )\n            digest.update(chunk)\n            needed -= len(chunk)\n        _require(digest.hexdigest() == expected_sha256, f\"{label} SHA-256 differs\")\n\n\ndef _raw_identity_pass(\n    descriptor: int,\n    *,\n    expected_byte_count: int,\n    expected_sha256: str,\n) -> tuple[dict[str, Any], os.stat_result]:\n    before = os.fstat(descriptor)\n    _require(stat.S_ISREG(before.st_mode), \"cache bundle is not a regular file\")\n    _require(before.st_nlink == 1, \"cache bundle must not be hard-linked\")\n    _require(\n        before.st_size == expected_byte_count\n        and MIN_BUNDLE_BYTES <= before.st_size <= MAX_BUNDLE_BYTES,\n        \"cache bundle byte count differs\",\n    )\n    try:\n        _require(os.lseek(descriptor, 0, os.SEEK_CUR) == 0, \"cache bundle initial offset differs\")\n    except OSError as exc:\n        raise CacheBundleVerificationError(\"cache bundle offset is unavailable\") from exc\n    digest = hashlib.sha256()\n    byte_count = 0\n    while True:\n        try:\n            chunk = os.read(descriptor, READ_CHUNK_BYTES)\n        except OSError as exc:\n            raise CacheBundleVerificationError(\"cannot read cache bundle raw identity\") from exc\n        if not chunk:\n            break\n        byte_count += len(chunk)\n        _require(byte_count <= expected_byte_count, \"cache bundle exceeds its reviewed byte count\")\n        digest.update(chunk)\n    after = os.fstat(descriptor)\n    _require(\n        byte_count == expected_byte_count\n        and _stat_identity(before) == _stat_identity(after),\n        \"cache bundle changed during raw identity verification\",\n    )\n    identity = {\"byte_count\": byte_count, \"sha256\": digest.hexdigest()}\n    _require(\n        identity == {\"byte_count\": expected_byte_count, \"sha256\": expected_sha256},\n        \"cache bundle raw identity differs from reviewed v1 material\",\n    )\n    try:\n        position = os.lseek(descriptor, 0, os.SEEK_SET)\n    except OSError as exc:\n        raise CacheBundleVerificationError(\"cache bundle cannot be rewound\") from exc\n    _require(position == 0, \"cache bundle rewind differs\")\n    return identity, before\n\n\ndef _parse_content_pass(\n    descriptor: int,\n    *,\n    bundle_stat: os.stat_result,\n    manifest: Mapping[str, Any],\n    format_contract: Mapping[str, Any],\n) -> dict[str, Any]:\n    _validate_bundle_path_policy(manifest)\n    contents = manifest.get(\"contents\")\n    _require(type(contents) is dict, \"manifest contents differ\")\n    contents_map = cast(dict[str, Any], contents)\n    entries_value = contents_map.get(\"entries\")\n    _require(type(entries_value) is list, \"manifest entries differ\")\n    entries = cast(list[Any], entries_value)\n    file_count_value = contents_map.get(\"file_count\")\n    unpacked_bytes_value = contents_map.get(\"unpacked_byte_count\")\n    repository_counts_value = contents_map.get(\"repository_file_counts\")\n    _require(\n        type(file_count_value) is int\n        and 3 <= file_count_value <= MAX_FILE_COUNT\n        and file_count_value == len(entries),\n        \"manifest file count differs\",\n    )\n    file_count = cast(int, file_count_value)\n    _require(\n        type(unpacked_bytes_value) is int\n        and 1 <= unpacked_bytes_value <= MAX_UNPACKED_BYTES,\n        \"manifest unpacked byte count differs\",\n    )\n    unpacked_bytes = cast(int, unpacked_bytes_value)\n    _require(\n        type(repository_counts_value) is dict\n        and set(repository_counts_value) == set(REPOSITORY_ORDER),\n        \"manifest repository counts differ\",\n    )\n    repository_counts_map = cast(dict[str, Any], repository_counts_value)\n    _require(\n        all(\n            type(repository_counts_map[key]) is int\n            and cast(int, repository_counts_map[key]) >= 1\n            for key in REPOSITORY_ORDER\n        ),\n        \"manifest repository counts are outside the frozen limits\",\n    )\n    repository_counts = {\n        key: cast(int, repository_counts_map[key]) for key in REPOSITORY_ORDER\n    }\n    _require(\n        sum(repository_counts.values()) == file_count,\n        \"manifest repository counts do not sum to the file count\",\n    )\n    path_total = 0\n    for index, entry in enumerate(entries):\n        _require(type(entry) is dict, f\"manifest entry[{index}] differs\")\n        entry_map = cast(dict[str, Any], entry)\n        path_value = entry_map.get(\"path\")\n        _require(type(path_value) is str, f\"manifest entry[{index}] path differs\")\n        path_total += len(cast(str, path_value).encode(\"utf-8\"))\n        _require(path_total <= MAX_BUNDLE_BYTES, \"manifest path bytes exceed the bundle ceiling\")\n    expected_bundle_bytes = (\n        HEADER_BYTES\n        + TRAILER_BYTES\n        + RECORD_FIXED_BYTES * file_count\n        + path_total\n        + unpacked_bytes\n    )\n    _require(\n        expected_bundle_bytes == bundle_stat.st_size\n        and expected_bundle_bytes <= MAX_BUNDLE_BYTES,\n        \"cache bundle exact byte-count formula differs\",\n    )\n\n    reader = _BundleReader(descriptor, bundle_stat.st_size)\n    header_raw = reader.read_exact(HEADER_BYTES, label=\"cache bundle header\", tail_reserve=TRAILER_BYTES)\n    try:\n        header = struct.unpack(\">16sHHIQQQQQQ32s32s32s32s32s\", header_raw)\n    except struct.error as exc:\n        raise CacheBundleVerificationError(\"cache bundle header layout differs\") from exc\n    (\n        magic,\n        version,\n        header_bytes,\n        flags,\n        declared_bundle_bytes,\n        declared_file_count,\n        declared_unpacked_bytes,\n        brain_count,\n        db_count,\n        graph_count,\n        format_sha,\n        manifest_projection_sha,\n        inventory_sha,\n        plan_sha,\n        toolchain_sha,\n    ) = header\n    expected_format_sha = format_contract.get(\"format_contract_sha256\")\n    _require(\n        magic == HEADER_MAGIC\n        and version == FORMAT_VERSION\n        and header_bytes == HEADER_BYTES\n        and flags == 0,\n        \"cache bundle header identity differs\",\n    )\n    _require(\n        declared_bundle_bytes == bundle_stat.st_size\n        and declared_file_count == file_count\n        and declared_unpacked_bytes == unpacked_bytes\n        and (brain_count, db_count, graph_count)\n        == tuple(repository_counts[key] for key in REPOSITORY_ORDER),\n        \"cache bundle header counts differ from manifest\",\n    )\n    run_plan_value = manifest.get(\"run_plan\")\n    _require(type(run_plan_value) is dict, \"manifest run-plan binding differs\")\n    run_plan = cast(dict[str, Any], run_plan_value)\n    _require(\n        type(expected_format_sha) is str\n        and format_sha.hex() == expected_format_sha\n        and manifest_projection_sha.hex() == _manifest_projection_sha256(manifest)\n        and inventory_sha.hex() == contents_map.get(\"inventory_sha256\")\n        and plan_sha.hex() == run_plan.get(\"plan_sha256\")\n        and toolchain_sha.hex()\n        == run_plan.get(\"toolchain_bindings_sha256\"),\n        \"cache bundle header bindings differ\",\n    )\n\n    unpacked_total = 0\n    observed_counts = {key: 0 for key in REPOSITORY_ORDER}\n    for ordinal, entry in enumerate(entries):\n        _require(type(entry) is dict, f\"manifest entry[{ordinal}] differs\")\n        remaining_records = file_count - ordinal - 1\n        minimum_tail = TRAILER_BYTES + remaining_records * (RECORD_FIXED_BYTES + 1 + 1)\n        fixed = reader.read_exact(\n            RECORD_FIXED_BYTES,\n            label=f\"cache bundle record[{ordinal}] header\",\n            tail_reserve=minimum_tail,\n        )\n        try:\n            record_magic, repository_id, record_flags, path_bytes, record_ordinal, content_bytes, content_sha = struct.unpack(\n                \">4sBBHIQ32s\", fixed\n            )\n        except struct.error as exc:\n            raise CacheBundleVerificationError(f\"cache bundle record[{ordinal}] layout differs\") from exc\n        _require(\n            record_magic == RECORD_MAGIC\n            and record_flags == 0\n            and record_ordinal == ordinal,\n            f\"cache bundle record[{ordinal}] identity differs\",\n        )\n        repository_key = entry.get(\"repository_key\")\n        _require(\n            repository_key in REPOSITORY_IDS\n            and repository_id == REPOSITORY_IDS[cast(str, repository_key)],\n            f\"cache bundle record[{ordinal}] repository differs\",\n        )\n        _require(1 <= path_bytes <= MAX_PATH_BYTES, f\"cache bundle record[{ordinal}] path length differs\")\n        path_raw = reader.read_exact(\n            path_bytes,\n            label=f\"cache bundle record[{ordinal}] path\",\n            tail_reserve=minimum_tail + content_bytes,\n        )\n        try:\n            path = path_raw.decode(\"utf-8\")\n        except UnicodeError as exc:\n            raise CacheBundleVerificationError(f\"cache bundle record[{ordinal}] path is not UTF-8\") from exc\n        _require(\n            path == entry.get(\"path\")\n            and path_raw == cast(str, entry.get(\"path\")).encode(\"utf-8\"),\n            f\"cache bundle record[{ordinal}] path differs from manifest\",\n        )\n        _require(\n            type(content_bytes) is int\n            and content_bytes == entry.get(\"byte_count\")\n            and 1 <= content_bytes <= MAX_UNPACKED_BYTES\n            and content_sha.hex() == entry.get(\"sha256\"),\n            f\"cache bundle record[{ordinal}] content declaration differs\",\n        )\n        unpacked_total += content_bytes\n        _require(unpacked_total <= MAX_UNPACKED_BYTES, \"cache bundle unpacked bytes exceed the ceiling\")\n        reader.hash_content(\n            content_bytes,\n            expected_sha256=content_sha.hex(),\n            label=f\"cache bundle record[{ordinal}] content\",\n            tail_reserve=minimum_tail,\n        )\n        observed_counts[cast(str, repository_key)] += 1\n\n    trailer_raw = reader.read_exact(TRAILER_BYTES, label=\"cache bundle trailer\")\n    try:\n        trailer = struct.unpack(\">16sQQQ32s32s\", trailer_raw)\n    except struct.error as exc:\n        raise CacheBundleVerificationError(\"cache bundle trailer layout differs\") from exc\n    trailer_magic, trailer_bundle_bytes, trailer_file_count, trailer_unpacked, records_sha, prefix_sha = trailer\n    _require(\n        trailer_magic == TRAILER_MAGIC\n        and trailer_bundle_bytes == bundle_stat.st_size\n        and trailer_file_count == file_count\n        and trailer_unpacked == unpacked_bytes,\n        \"cache bundle trailer counts differ\",\n    )\n    _require(reader.remaining == 0 and reader.offset == bundle_stat.st_size, \"cache bundle has trailing bytes\")\n    _require(unpacked_total == unpacked_bytes, \"cache bundle content byte total differs\")\n    _require(observed_counts == repository_counts, \"cache bundle repository totals differ\")\n    _require(records_sha == reader.records_digest.digest(), \"cache bundle records digest differs\")\n    _require(prefix_sha == reader.prefix_digest.digest(), \"cache bundle prefix digest differs\")\n    try:\n        _require(os.read(descriptor, 1) == b\"\", \"cache bundle exact EOF differs\")\n    except OSError as exc:\n        raise CacheBundleVerificationError(\"cannot verify cache bundle EOF\") from exc\n    after = os.fstat(descriptor)\n    _require(\n        _stat_identity(after) == _stat_identity(bundle_stat),\n        \"cache bundle changed during content verification\",\n    )\n    return {\n        \"bundle_byte_count\": bundle_stat.st_size,\n        \"file_count\": file_count,\n        \"records_sha256\": records_sha.hex(),\n        \"prefix_sha256\": prefix_sha.hex(),\n        \"repository_file_counts\": copy.deepcopy(repository_counts),\n        \"unpacked_byte_count\": unpacked_bytes,\n    }\n\n\ndef _file_binding(path: pathlib.Path, raw: bytes) -> dict[str, str]:\n    return {\"artifact_file\": path.name, \"artifact_sha256\": _sha256(raw)}\n\n\ndef _validate_format_contract(\n    value: Mapping[str, Any],\n    *,\n    schema: Mapping[str, Any],\n    v1: types.ModuleType,\n) -> dict[str, Any]:\n    try:\n        v1._validate_schema(\n            value,\n            schema,\n            schema_name=FORMAT_SCHEMA_PATH.name,\n            label=\"cache bundle format contract\",\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    expected_fields = {\n        \"authority\",\n        \"canonical_json_profile\",\n        \"digests\",\n        \"format_contract_sha256\",\n        \"header\",\n        \"integer_encoding\",\n        \"limits\",\n        \"manifest_projection\",\n        \"ordering\",\n        \"profile\",\n        \"record\",\n        \"representability\",\n        \"schema_version\",\n        \"status\",\n        \"trailer\",\n    }\n    _require(type(value) is dict and set(value) == expected_fields, \"format-contract fields differ\")\n    _require(\n        value[\"profile\"] == FORMAT_PROFILE\n        and value[\"schema_version\"] == SCHEMA_VERSION\n        and value[\"status\"] == FORMAT_STATUS,\n        \"format-contract identity differs\",\n    )\n    try:\n        self_hash = v1._field_self_hash(value, \"format_contract_sha256\")\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    _require(\n        value[\"format_contract_sha256\"] == CHECKED_FORMAT_SHA256\n        and value[\"format_contract_sha256\"] == self_hash,\n        \"format-contract self hash differs\",\n    )\n    return copy.deepcopy(dict(value))\n\n\ndef _load_fixed_dependencies() -> dict[str, Any]:\n    v1 = _checked_v1()\n    try:\n        v1_dependencies = v1._load_fixed_dependencies()\n        v1_verifier_contract = v1.check_verifier_contract()\n        v1_verifier_contract_read, v1_verifier_contract_raw = v1._read_json(\n            V1_VERIFIER_CONTRACT_PATH,\n            maximum=MAX_VERIFIER_CONTRACT_BYTES,\n            label=\"v1 cache archive verifier contract\",\n            canonical=True,\n            require_single_link=True,\n        )\n        _require(\n            v1_verifier_contract_read == v1_verifier_contract\n            and v1_verifier_contract_raw == v1._render(v1_verifier_contract),\n            \"v1 cache archive verifier contract differs\",\n        )\n        format_schema, format_schema_raw = v1._load_schema(\n            FORMAT_SCHEMA_PATH,\n            REDACTED,\n            label=\"cache bundle format schema\",\n        )\n        report_schema, report_schema_raw = v1._load_schema(\n            REPORT_SCHEMA_PATH,\n            expected_sha256=CHECKED_REPORT_SCHEMA_SHA256,\n            label=\"cache bundle report schema\",\n        )\n        verifier_schema, verifier_schema_raw = v1._load_schema(\n            VERIFIER_SCHEMA_PATH,\n            expected_sha256=CHECKED_VERIFIER_SCHEMA_SHA256,\n            label=\"cache bundle verifier schema\",\n"},"started_at_ms":1789839290128,"completed_at_ms":1789839290129}}
{"timestamp":"2026-09-19T17:34:50.183Z","ordinal":7398,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0babc-2f47-7d53-bc5f-7668eda706e9","call_id":"call_Twa2O7mbdYOHwR7kq3hNQ7U5","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"b56e98\",\"wall_time_seconds\":0.000006833,\"exit_code\":0,\"original_token_count\":5550,\"output\":\"        if descriptor >= 0:\\n            os.close(descriptor)\\n        for current in reversed(directories):\\n            os.close(current)\\n        raise CacheBundleVerificationError(f\\\"cannot open {label}\\\") from exc\\n\\n\\ndef _stat_identity(value: os.stat_result) -> tuple[int, ...]:\\n    return (\\n        value.st_dev,\\n        value.st_ino,\\n        value.st_mode,\\n        value.st_uid,\\n        value.st_gid,\\n        value.st_nlink,\\n        value.st_size,\\n        value.st_mtime_ns,\\n        value.st_ctime_ns,\\n    )\\n\\n\\ndef _read_checked_v1_source() -> bytes:\\n    descriptor, directories = _open_source_descriptor(V1_SOURCE_PATH, label=\\\"v1 raw verifier source\\\")\\n    try:\\n        before = os.fstat(descriptor)\\n        _require(before.st_size == CHECKED_V1_SOURCE_SIZE, \\\"v1 raw verifier source size differs\\\")\\n        chunks: list[bytes] = []\\n        remaining = CHECKED_V1_SOURCE_SIZE + 1\\n        while remaining:\\n            chunk = os.read(descriptor, min(READ_CHUNK_BYTES, remaining))\\n            if not chunk:\\n                break\\n            chunks.append(chunk)\\n            remaining -= len(chunk)\\n        raw = b\\\"\\\".join(chunks)\\n        after = os.fstat(descriptor)\\n        _require(\\n            len(raw) == CHECKED_V1_SOURCE_SIZE\\n            and _stat_identity(before) == _stat_identity(after),\\n            \\\"v1 raw verifier source changed while reading\\\",\\n        )\\n        _require(_sha256(raw) == CHECKED_V1_SOURCE_SHA256, \\\"v1 raw verifier source hash differs\\\")\\n        return raw\\n    finally:\\n        os.close(descriptor)\\n        for current in reversed(directories):\\n            os.close(current)\\n\\n\\ndef _checked_v1() -> types.ModuleType:\\n    global _V1_MODULE\\n\\n    raw = _read_checked_v1_source()\\n    if _V1_MODULE is not None:\\n        return _V1_MODULE\\n    module_name = \\\"_entire_brain_checked_negative_control_cache_archive_v1\\\"\\n    module = types.ModuleType(module_name)\\n    module.__file__ = str(V1_SOURCE_PATH)\\n    previous = sys.modules.get(module_name)\\n    try:\\n        code = compile(raw, str(V1_SOURCE_PATH), \\\"exec\\\", dont_inherit=True)\\n        sys.modules[module_name] = module\\n        exec(code, module.__dict__)\\n    except Exception as exc:\\n        raise CacheBundleVerificationError(\\\"checked v1 raw verifier source cannot be loaded\\\") from exc\\n    finally:\\n        if previous is None:\\n            sys.modules.pop(module_name, None)\\n        else:\\n            sys.modules[module_name] = previous\\n    required = (\\n        \\\"_audit_schema\\\",\\n        \\\"_read_bounded\\\",\\n        \\\"_load_fixed_dependencies\\\",\\n        \\\"_load_schema\\\",\\n        \\\"_read_json\\\",\\n        \\\"_render\\\",\\n        \\\"_canonical_bytes\\\",\\n        \\\"_field_self_hash\\\",\\n        \\\"_validate_schema\\\",\\n        \\\"_validate_manifest_identity\\\",\\n        \\\"_open_regular_descriptor\\\",\\n        \\\"_stable_stat_identity\\\",\\n        \\\"check_verifier_contract\\\",\\n        \\\"CacheArchiveVerificationError\\\",\\n    )\\n    _require(all(hasattr(module, name) for name in required), \\\"checked v1 raw verifier API differs\\\")\\n    _V1_MODULE = module\\n    return module\\n\\n\\ndef _manifest_projection_sha256(manifest: Mapping[str, Any]) -> str:\\n    v1 = _checked_v1()\\n    projected = copy.deepcopy(dict(manifest))\\n    archive = projected.get(\\\"archive\\\")\\n    _require(type(archive) is dict, \\\"manifest archive projection differs\\\")\\n    archive_map = cast(dict[str, Any], archive)\\n    archive_map[\\\"byte_count\\\"] = None\\n    archive_map[\\\"sha256\\\"] = None\\n    _require(\\\"manifest_sha256\\\" in projected, \\\"manifest self hash is absent\\\")\\n    projected[\\\"manifest_sha256\\\"] = None\\n    try:\\n        canonical = v1._canonical_bytes(projected)\\n    except v1.CacheArchiveVerificationError as exc:\\n        raise CacheBundleVerificationError(str(exc)) from exc\\n    return hashlib.sha256(MANIFEST_PROJECTION_DOMAIN + canonical).hexdigest()\\n\\n\\ndef _validate_bundle_path_policy(manifest: Mapping[str, Any]) -> None:\\n    \\\"\\\"\\\"Reject APFS named/resource-fork pseudo-components before byte parsing.\\\"\\\"\\\"\\n\\n    contents_value = manifest.get(\\\"contents\\\")\\n    _require(type(contents_value) is dict, \\\"manifest contents differ\\\")\\n    contents = cast(dict[str, Any], contents_value)\\n    entries_value = contents.get(\\\"entries\\\")\\n    _require(type(entries_value) is list, \\\"manifest entries differ\\\")\\n    for index, entry_value in enumerate(cast(list[Any], entries_value)):\\n        _require(type(entry_value) is dict, f\\\"manifest entry[{index}] differs\\\")\\n        entry = cast(dict[str, Any], entry_value)\\n        path_value = entry.get(\\\"path\\\")\\n        _require(type(path_value) is str, f\\\"manifest entry[{index}] path differs\\\")\\n        path = cast(str, path_value)\\n        _require(\\n            all(component.casefold() != \\\"..namedfork\\\" for component in path.split(\\\"/\\\")),\\n            f\\\"manifest entry[{index}] APFS ..namedfork component is forbidden\\\",\\n        )\\n\\n\\nclass _BundleReader:\\n    \\\"\\\"\\\"Checked-subtraction reader and domain-separated pass-two hash feeder.\\\"\\\"\\\"\\n\\n    def __init__(self, descriptor: int, bundle_bytes: int) -> None:\\n        _require(\\n            type(bundle_bytes) is int\\n            and MIN_BUNDLE_BYTES <= bundle_bytes <= MAX_BUNDLE_BYTES,\\n            \\\"bundle byte count is outside the frozen ceiling\\\",\\n        )\\n        self.descriptor = descriptor\\n        self.bundle_bytes = bundle_bytes\\n        self.remaining = bundle_bytes\\n        self.offset = 0\\n        self.trailer_offset = bundle_bytes - TRAILER_BYTES\\n        self.prefix_limit = bundle_bytes - 32\\n        self.records_digest = hashlib.sha256(RECORDS_DOMAIN)\\n        self.prefix_digest = hashlib.sha256(PREFIX_DOMAIN)\\n\\n    def _feed(self, raw: bytes, start: int) -> None:\\n        end = start + len(raw)\\n        prefix_end = min(end, self.prefix_limit)\\n        if start < prefix_end:\\n            self.prefix_digest.update(raw[: prefix_end - start])\\n        records_start = max(start, HEADER_BYTES)\\n        records_end = min(end, self.trailer_offset)\\n        if records_start < records_end:\\n            left = records_start - start\\n            self.records_digest.update(raw[left : left + records_end - records_start])\\n\\n    def read_exact(self, count: int, *, label: str, tail_reserve: int = 0) -> bytes:\\n        _require(type(count) is int and count >= 0, f\\\"{label} byte count is invalid\\\")\\n        _require(\\n            type(tail_reserve) is int\\n            and tail_reserve >= 0\\n            and tail_reserve <= self.remaining\\n            and count <= self.remaining - tail_reserve,\\n            f\\\"{label} exceeds the remaining bundle bytes\\\",\\n        )\\n        chunks: list[bytes] = []\\n        needed = count\\n        start = self.offset\\n        while needed:\\n            try:\\n                chunk = os.read(self.descriptor, min(READ_CHUNK_BYTES, needed))\\n            except OSError as exc:\\n                raise CacheBundleVerificationError(f\\\"cannot read {label}\\\") from exc\\n            _require(bool(chunk), f\\\"{label} is truncated\\\")\\n            chunks.append(chunk)\\n            needed -= len(chunk)\\n        raw = b\\\"\\\".join(chunks)\\n        self._feed(raw, start)\\n        self.offset += count\\n        self.remaining -= count\\n        return raw\\n\\n    def hash_content(\\n        self,\\n        count: int,\\n        *,\\n        expected_sha256: str,\\n        label: str,\\n        tail_reserve: int,\\n    ) -> None:\\n        _require(\\n            type(count) is int\\n            and count >= 1\\n            and tail_reserve <= self.remaining\\n            and count <= self.remaining - tail_reserve,\\n            f\\\"{label} exceeds the remaining bundle bytes\\\",\\n        )\\n        digest = hashlib.sha256()\\n        needed = count\\n        while needed:\\n            chunk_count = min(READ_CHUNK_BYTES, needed)\\n            chunk = self.read_exact(\\n                chunk_count,\\n                label=label,\\n                tail_reserve=tail_reserve,\\n            )\\n            digest.update(chunk)\\n            needed -= len(chunk)\\n        _require(digest.hexdigest() == expected_sha256, f\\\"{label} SHA-256 differs\\\")\\n\\n\\ndef _raw_identity_pass(\\n    descriptor: int,\\n    *,\\n    expected_byte_count: int,\\n    expected_sha256: str,\\n) -> tuple[dict[str, Any], os.stat_result]:\\n    before = os.fstat(descriptor)\\n    _require(stat.S_ISREG(before.st_mode), \\\"cache bundle is not a regular file\\\")\\n    _require(before.st_nlink == 1, \\\"cache bundle must not be hard-linked\\\")\\n    _require(\\n        before.st_size == expected_byte_count\\n        and MIN_BUNDLE_BYTES <= before.st_size <= MAX_BUNDLE_BYTES,\\n        \\\"cache bundle byte count differs\\\",\\n    )\\n    try:\\n        _require(os.lseek(descriptor, 0, os.SEEK_CUR) == 0, \\\"cache bundle initial offset differs\\\")\\n    except OSError as exc:\\n        raise CacheBundleVerificationError(\\\"cache bundle offset is unavailable\\\") from exc\\n    digest = hashlib.sha256()\\n    byte_count = 0\\n    while True:\\n        try:\\n            chunk = os.read(descriptor, READ_CHUNK_BYTES)\\n        except OSError as exc:\\n            raise CacheBundleVerificationError(\\\"cannot read cache bundle raw identity\\\") from exc\\n        if not chunk:\\n            break\\n        byte_count += len(chunk)\\n        _require(byte_count <= expected_byte_count, \\\"cache bundle exceeds its reviewed byte count\\\")\\n        digest.update(chunk)\\n    after = os.fstat(descriptor)\\n    _require(\\n        byte_count == expected_byte_count\\n        and _stat_identity(before) == _stat_identity(after),\\n        \\\"cache bundle changed during raw identity verification\\\",\\n    )\\n    identity = {\\\"byte_count\\\": byte_count, \\\"sha256\\\": digest.hexdigest()}\\n    _require(\\n        identity == {\\\"byte_count\\\": expected_byte_count, \\\"sha256\\\": expected_sha256},\\n        \\\"cache bundle raw identity differs from reviewed v1 material\\\",\\n    )\\n    try:\\n        position = os.lseek(descriptor, 0, os.SEEK_SET)\\n    except OSError as exc:\\n        raise CacheBundleVerificationError(\\\"cache bundle cannot be rewound\\\") from exc\\n    _require(position == 0, \\\"cache bundle rewind differs\\\")\\n    return identity, before\\n\\n\\ndef _parse_content_pass(\\n    descriptor: int,\\n    *,\\n    bundle_stat: os.stat_result,\\n    manifest: Mapping[str, Any],\\n    format_contract: Mapping[str, Any],\\n) -> dict[str, Any]:\\n    _validate_bundle_path_policy(manifest)\\n    contents = manifest.get(\\\"contents\\\")\\n    _require(type(contents) is dict, \\\"manifest contents differ\\\")\\n    contents_map = cast(dict[str, Any], contents)\\n    entries_value = contents_map.get(\\\"entries\\\")\\n    _require(type(entries_value) is list, \\\"manifest entries differ\\\")\\n    entries = cast(list[Any], entries_value)\\n    file_count_value = contents_map.get(\\\"file_count\\\")\\n    unpacked_bytes_value = contents_map.get(\\\"unpacked_byte_count\\\")\\n    repository_counts_value = contents_map.get(\\\"repository_file_counts\\\")\\n    _require(\\n        type(file_count_value) is int\\n        and 3 <= file_count_value <= MAX_FILE_COUNT\\n        and file_count_value == len(entries),\\n        \\\"manifest file count differs\\\",\\n    )\\n    file_count = cast(int, file_count_value)\\n    _require(\\n        type(unpacked_bytes_value) is int\\n        and 1 <= unpacked_bytes_value <= MAX_UNPACKED_BYTES,\\n        \\\"manifest unpacked byte count differs\\\",\\n    )\\n    unpacked_bytes = cast(int, unpacked_bytes_value)\\n    _require(\\n        type(repository_counts_value) is dict\\n        and set(repository_counts_value) == set(REPOSITORY_ORDER),\\n        \\\"manifest repository counts differ\\\",\\n    )\\n    repository_counts_map = cast(dict[str, Any], repository_counts_value)\\n    _require(\\n        all(\\n            type(repository_counts_map[key]) is int\\n            and cast(int, repository_counts_map[key]) >= 1\\n            for key in REPOSITORY_ORDER\\n        ),\\n        \\\"manifest repository counts are outside the frozen limits\\\",\\n    )\\n    repository_counts = {\\n        key: cast(int, repository_counts_map[key]) for key in REPOSITORY_ORDER\\n    }\\n    _require(\\n        sum(repository_counts.values()) == file_count,\\n        \\\"manifest repository counts do not sum to the file count\\\",\\n    )\\n    path_total = 0\\n    for index, entry in enumerate(entries):\\n        _require(type(entry) is dict, f\\\"manifest entry[{index}] differs\\\")\\n        entry_map = cast(dict[str, Any], entry)\\n        path_value = entry_map.get(\\\"path\\\")\\n        _require(type(path_value) is str, f\\\"manifest entry[{index}] path differs\\\")\\n        path_total += len(cast(str, path_value).encode(\\\"utf-8\\\"))\\n        _require(path_total <= MAX_BUNDLE_BYTES, \\\"manifest path bytes exceed the bundle ceiling\\\")\\n    expected_bundle_bytes = (\\n        HEADER_BYTES\\n        + TRAILER_BYTES\\n        + RECORD_FIXED_BYTES * file_count\\n        + path_total\\n        + unpacked_bytes\\n    )\\n    _require(\\n        expected_bundle_bytes == bundle_stat.st_size\\n        and expected_bundle_bytes <= MAX_BUNDLE_BYTES,\\n        \\\"cache bundle exact byte-count formula differs\\\",\\n    )\\n\\n    reader = _BundleReader(descriptor, bundle_stat.st_size)\\n    header_raw = reader.read_exact(HEADER_BYTES, label=\\\"cache bundle header\\\", tail_reserve=TRAILER_BYTES)\\n    try:\\n        header = struct.unpack(\\\">16sHHIQQQQQQ32s32s32s32s32s\\\", header_raw)\\n    except struct.error as exc:\\n        raise CacheBundleVerificationError(\\\"cache bundle header layout differs\\\") from exc\\n    (\\n        magic,\\n        version,\\n        header_bytes,\\n        flags,\\n        declared_bundle_bytes,\\n        declared_file_count,\\n        declared_unpacked_bytes,\\n        brain_count,\\n        db_count,\\n        graph_count,\\n        format_sha,\\n        manifest_projection_sha,\\n        inventory_sha,\\n        plan_sha,\\n        toolchain_sha,\\n    ) = header\\n    expected_format_sha = format_contract.get(\\\"format_contract_sha256\\\")\\n    _require(\\n        magic == HEADER_MAGIC\\n        and version == FORMAT_VERSION\\n        and header_bytes == HEADER_BYTES\\n        and flags == 0,\\n        \\\"cache bundle header identity differs\\\",\\n    )\\n    _require(\\n        declared_bundle_bytes == bundle_stat.st_size\\n        and declared_file_count == file_count\\n        and declared_unpacked_bytes == unpacked_bytes\\n        and (brain_count, db_count, graph_count)\\n        == tuple(repository_counts[key] for key in REPOSITORY_ORDER),\\n        \\\"cache bundle header counts differ from manifest\\\",\\n    )\\n    run_plan_value = manifest.get(\\\"run_plan\\\")\\n    _require(type(run_plan_value) is dict, \\\"manifest run-plan binding differs\\\")\\n    run_plan = cast(dict[str, Any], run_plan_value)\\n    _require(\\n        type(expected_format_sha) is str\\n        and format_sha.hex() == expected_format_sha\\n        and manifest_projection_sha.hex() == _manifest_projection_sha256(manifest)\\n        and inventory_sha.hex() == contents_map.get(\\\"inventory_sha256\\\")\\n        and plan_sha.hex() == run_plan.get(\\\"plan_sha256\\\")\\n        and toolchain_sha.hex()\\n        == run_plan.get(\\\"toolchain_bindings_sha256\\\"),\\n        \\\"cache bundle header bindings differ\\\",\\n    )\\n\\n    unpacked_total = 0\\n    observed_counts = {key: 0 for key in REPOSITORY_ORDER}\\n    for ordinal, entry in enumerate(entries):\\n        _require(type(entry) is dict, f\\\"manifest entry[{ordinal}] differs\\\")\\n        remaining_records = file_count - ordinal - 1\\n        minimum_tail = TRAILER_BYTES + remaining_records * (RECORD_FIXED_BYTES + 1 + 1)\\n        fixed = reader.read_exact(\\n            RECORD_FIXED_BYTES,\\n            label=f\\\"cache bundle record[{ordinal}] header\\\",\\n            tail_reserve=minimum_tail,\\n        )\\n        try:\\n            record_magic, repository_id, record_flags, path_bytes, record_ordinal, content_bytes, content_sha = struct.unpack(\\n                \\\">4sBBHIQ32s\\\", fixed\\n            )\\n        except struct.error as exc:\\n            raise CacheBundleVerificationError(f\\\"cache bundle record[{ordinal}] layout differs\\\") from exc\\n        _require(\\n            record_magic == RECORD_MAGIC\\n            and record_flags == 0\\n            and record_ordinal == ordinal,\\n            f\\\"cache bundle record[{ordinal}] identity differs\\\",\\n        )\\n        repository_key = entry.get(\\\"repository_key\\\")\\n        _require(\\n            repository_key in REPOSITORY_IDS\\n            and repository_id == REPOSITORY_IDS[cast(str, repository_key)],\\n            f\\\"cache bundle record[{ordinal}] repository differs\\\",\\n        )\\n        _require(1 <= path_bytes <= MAX_PATH_BYTES, f\\\"cache bundle record[{ordinal}] path length differs\\\")\\n        path_raw = reader.read_exact(\\n            path_bytes,\\n            label=f\\\"cache bundle record[{ordinal}] path\\\",\\n            tail_reserve=minimum_tail + content_bytes,\\n        )\\n        try:\\n            path = path_raw.decode(\\\"utf-8\\\")\\n        except UnicodeError as exc:\\n            raise CacheBundleVerificationError(f\\\"cache bundle record[{ordinal}] path is not UTF-8\\\") from exc\\n        _require(\\n            path == entry.get(\\\"path\\\")\\n            and path_raw == cast(str, entry.get(\\\"path\\\")).encode(\\\"utf-8\\\"),\\n            f\\\"cache bundle record[{ordinal}] path differs from manifest\\\",\\n        )\\n        _require(\\n            type(content_bytes) is int\\n            and content_bytes == entry.get(\\\"byte_count\\\")\\n            and 1 <= content_bytes <= MAX_UNPACKED_BYTES\\n            and content_sha.hex() == entry.get(\\\"sha256\\\"),\\n            f\\\"cache bundle record[{ordinal}] content declaration differs\\\",\\n        )\\n        unpacked_total += content_bytes\\n        _require(unpacked_total <= MAX_UNPACKED_BYTES, \\\"cache bundle unpacked bytes exceed the ceiling\\\")\\n        reader.hash_content(\\n            content_bytes,\\n            expected_sha256=content_sha.hex(),\\n            label=f\\\"cache bundle record[{ordinal}] content\\\",\\n            tail_reserve=minimum_tail,\\n        )\\n        observed_counts[cast(str, repository_key)] += 1\\n\\n    trailer_raw = reader.read_exact(TRAILER_BYTES, label=\\\"cache bundle trailer\\\")\\n    try:\\n        trailer = struct.unpack(\\\">16sQQQ32s32s\\\", trailer_raw)\\n    except struct.error as exc:\\n        raise CacheBundleVerificationError(\\\"cache bundle trailer layout differs\\\") from exc\\n    trailer_magic, trailer_bundle_bytes, trailer_file_count, trailer_unpacked, records_sha, prefix_sha = trailer\\n    _require(\\n        trailer_magic == TRAILER_MAGIC\\n        and trailer_bundle_bytes == bundle_stat.st_size\\n        and trailer_file_count == file_count\\n        and trailer_unpacked == unpacked_bytes,\\n        \\\"cache bundle trailer counts differ\\\",\\n    )\\n    _require(reader.remaining == 0 and reader.offset == bundle_stat.st_size, \\\"cache bundle has trailing bytes\\\")\\n    _require(unpacked_total == unpacked_bytes, \\\"cache bundle content byte total differs\\\")\\n    _require(observed_counts == repository_counts, \\\"cache bundle repository totals differ\\\")\\n    _require(records_sha == reader.records_digest.digest(), \\\"cache bundle records digest differs\\\")\\n    _require(prefix_sha == reader.prefix_digest.digest(), \\\"cache bundle prefix digest differs\\\")\\n    try:\\n        _require(os.read(descriptor, 1) == b\\\"\\\", \\\"cache bundle exact EOF differs\\\")\\n    except OSError as exc:\\n        raise CacheBundleVerificationError(\\\"cannot verify cache bundle EOF\\\") from exc\\n    after = os.fstat(descriptor)\\n    _require(\\n        _stat_identity(after) == _stat_identity(bundle_stat),\\n        \\\"cache bundle changed during content verification\\\",\\n    )\\n    return {\\n        \\\"bundle_byte_count\\\": bundle_stat.st_size,\\n        \\\"file_count\\\": file_count,\\n        \\\"records_sha256\\\": records_sha.hex(),\\n        \\\"prefix_sha256\\\": prefix_sha.hex(),\\n        \\\"repository_file_counts\\\": copy.deepcopy(repository_counts),\\n        \\\"unpacked_byte_count\\\": unpacked_bytes,\\n    }\\n\\n\\ndef _file_binding(path: pathlib.Path, raw: bytes) -> dict[str, str]:\\n    return {\\\"artifact_file\\\": path.name, \\\"artifact_sha256\\\": _sha256(raw)}\\n\\n\\ndef _validate_format_contract(\\n    value: Mapping[str, Any],\\n    *,\\n    schema: Mapping[str, Any],\\n    v1: types.ModuleType,\\n) -> dict[str, Any]:\\n    try:\\n        v1._validate_schema(\\n            value,\\n            schema,\\n            schema_name=FORMAT_SCHEMA_PATH.name,\\n            label=\\\"cache bundle format contract\\\",\\n        )\\n    except v1.CacheArchiveVerificationError as exc:\\n        raise CacheBundleVerificationError(str(exc)) from exc\\n    expected_fields = {\\n        \\\"authority\\\",\\n        \\\"canonical_json_profile\\\",\\n        \\\"digests\\\",\\n        \\\"format_contract_sha256\\\",\\n        \\\"header\\\",\\n        \\\"integer_encoding\\\",\\n        \\\"limits\\\",\\n        \\\"manifest_projection\\\",\\n        \\\"ordering\\\",\\n        \\\"profile\\\",\\n        \\\"record\\\",\\n        \\\"representability\\\",\\n        \\\"schema_version\\\",\\n        \\\"status\\\",\\n        \\\"trailer\\\",\\n    }\\n    _require(type(value) is dict and set(value) == expected_fields, \\\"format-contract fields differ\\\")\\n    _require(\\n        value[\\\"profile\\\"] == FORMAT_PROFILE\\n        and value[\\\"schema_version\\\"] == SCHEMA_VERSION\\n        and value[\\\"status\\\"] == FORMAT_STATUS,\\n        \\\"format-contract identity differs\\\",\\n    )\\n    try:\\n        self_hash = v1._field_self_hash(value, \\\"format_contract_sha256\\\")\\n    except v1.CacheArchiveVerificationError as exc:\\n        raise CacheBundleVerificationError(str(exc)) from exc\\n    _require(\\n        value[\\\"format_contract_sha256\\\"] == CHECKED_FORMAT_SHA256\\n        and value[\\\"format_contract_sha256\\\"] == self_hash,\\n        \\\"format-contract self hash differs\\\",\\n    )\\n    return copy.deepcopy(dict(value))\\n\\n\\ndef _load_fixed_dependencies() -> dict[str, Any]:\\n    v1 = _checked_v1()\\n    try:\\n        v1_dependencies = v1._load_fixed_dependencies()\\n        v1_verifier_contract = v1.check_verifier_contract()\\n        v1_verifier_contract_read, v1_verifier_contract_raw = v1._read_json(\\n            V1_VERIFIER_CONTRACT_PATH,\\n            maximum=MAX_VERIFIER_CONTRACT_BYTES,\\n            label=\\\"v1 cache archive verifier contract\\\",\\n            canonical=True,\\n            require_single_link=True,\\n        )\\n        _require(\\n            v1_verifier_contract_read == v1_verifier_contract\\n            and v1_verifier_contract_raw == v1._render(v1_verifier_contract),\\n            \\\"v1 cache archive verifier contract differs\\\",\\n        )\\n        format_schema, format_schema_raw = v1._load_schema(\\n            FORMAT_SCHEMA_PATH,\\n            REDACTED,\\n            label=\\\"cache bundle format schema\\\",\\n        )\\n        report_schema, report_schema_raw = v1._load_schema(\\n            REPORT_SCHEMA_PATH,\\n            expected_sha256=CHECKED_REPORT_SCHEMA_SHA256,\\n            label=\\\"cache bundle report schema\\\",\\n        )\\n        verifier_schema, verifier_schema_raw = v1._load_schema(\\n            VERIFIER_SCHEMA_PATH,\\n            expected_sha256=CHECKED_VERIFIER_SCHEMA_SHA256,\\n            label=\\\"cache bundle verifier schema\\\",\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839290.183339}}}
