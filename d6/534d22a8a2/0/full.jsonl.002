6\\\": bundle.assignment_receipt.sha256,\\n                \\\"overlap_receipt_file_sha256\\\": bundle.overlap_receipt.sha256,\\n                \\\"execution_contract_sha256\\\": execution_contract[\\\"identity_sha256\\\"],\\n                \\\"v4_implementation_lock_sha256\\\": implementation_lock[\\n                    \\\"identity_sha256\\\"\\n                ],\\n                \\\"identity_sha256\\\": digest(\\\"plan-unsealed\\\"),\\n            }\\n        )\\n\\n    def _build(\\n        self,\\n        *,\\n        homogeneous: bool,\\n        structural_zero: bool,\\n        duplicate_task_hash: bool,\\n        related_calibration_pair: bool,\\n        shared_fix_pair: bool,\\n        shared_session_pair: bool,\\n        excluded_bridge: bool,\\n    ) -> None:\\n        product = FIX.product_cycle_fixture(\\n            evidence_class=self.evidence_class,\\n            homogeneous=homogeneous,\\n            structural_zero=structural_zero,\\n            duplicate_task_hash=duplicate_task_hash,\\n        )\\n        population, ledger = self._population(\\n            related_calibration_pair=related_calibration_pair,\\n            shared_fix_pair=shared_fix_pair,\\n            shared_session_pair=shared_session_pair,\\n            excluded_bridge=excluded_bridge,\\n        )\\n        self.write(\\\"product\\\", product)\\n        self.write(\\\"population\\\", population)\\n        self.write(\\\"ledger\\\", ledger)\\n        placeholder_candidate = sealed(\\n            {\\n                \\\"schema\\\": \\\"agent-brain-candidate-lock-receipt/v1\\\",\\n                \\\"status\\\": \\\"locked_before_calibration_opening\\\",\\n                \\\"complete_plan_sha256\\\": digest(\\\"placeholder-plan\\\"),\\n                \\\"candidate_product_identity_sha256\\\": digest(\\\"placeholder-candidate\\\"),\\n                \\\"task_population_file_sha256\\\": digest(\\\"placeholder-population\\\"),\\n                \\\"issuer\\\": \\\"fixture-owner\\\",\\n                \\\"locked_at\\\": \\\"2026-07-16T00:00:00Z\\\",\\n                \\\"authentication_status\\\": V4.NO_TRUST_ANCHOR,\\n                \\\"identity_sha256\\\": digest(\\\"candidate-receipt-unsealed\\\"),\\n            }\\n        )\\n        self.write(\\\"candidate\\\", placeholder_candidate)\\n        provisional = self.reload_bundle()\\n        population_binding, _, _ = V4._derive_population_binding(\\n            bundle=provisional, product_root=product\\n        )\\n        implementation_lock = V4._expected_implementation_lock(provisional)\\n        execution_contract = self._execution_contract(product)\\n        execution_attestations = self._execution_attestations(\\n            product, execution_contract\\n        )\\n        planning = self._planning(\\n            product=product,\\n            population_binding=population_binding,\\n            bundle=provisional,\\n            execution_contract=execution_contract,\\n            implementation_lock=implementation_lock,\\n        )\\n        candidate_receipt = sealed(\\n            {\\n                \\\"schema\\\": \\\"agent-brain-candidate-lock-receipt/v1\\\",\\n                \\\"status\\\": \\\"locked_before_calibration_opening\\\",\\n                \\\"complete_plan_sha256\\\": planning[\\\"identity_sha256\\\"],\\n                \\\"candidate_product_identity_sha256\\\": product[\\n                    \\\"product_identities\\\"\\n                ][\\\"candidate\\\"][\\\"identity_sha256\\\"],\\n                \\\"task_population_file_sha256\\\": provisional.task_population.sha256,\\n                \\\"issuer\\\": \\\"fixture-owner\\\",\\n                \\\"locked_at\\\": \\\"2026-07-16T00:00:00Z\\\",\\n                \\\"authentication_status\\\": V4.NO_TRUST_ANCHOR,\\n                \\\"identity_sha256\\\": digest(\\\"candidate-receipt-unsealed\\\"),\\n            }\\n        )\\n        self.write(\\\"candidate\\\", candidate_receipt)\\n        bundle = self.reload_bundle()\\n        if self.state == \\\"frozen\\\":\\n            owner_receipt = sealed(\\n                {\\n                    \\\"schema\\\": \\\"agent-brain-owner-approval-receipt/v1\\\",\\n                    \\\"status\\\": \\\"structurally_approved_not_authenticated\\\",\\n                    \\\"complete_plan_sha256\\\": planning[\\\"identity_sha256\\\"],\\n                    \\\"candidate_lock_receipt_file_sha256\\\": bundle.candidate_lock_receipt.sha256,\\n                    \\\"approver\\\": \\\"fixture-owner\\\",\\n                    \\\"approved_at\\\": \\\"2026-07-16T00:00:00Z\\\",\\n                    \\\"authentication_status\\\": V4.NO_TRUST_ANCHOR,\\n                    \\\"identity_sha256\\\": digest(\\\"owner-receipt-unsealed\\\"),\\n                }\\n            )\\n            self.owner_path = self.write(\\\"owner\\\", owner_receipt)\\n            bundle = self.reload_bundle()\\n        candidate_lock = sealed(\\n            {\\n                \\\"status\\\": \\\"structurally_locked_before_development_calibration\\\",\\n                \\\"candidate_product_identity_sha256\\\": product[\\n                    \\\"product_identities\\\"\\n                ][\\\"candidate\\\"][\\\"identity_sha256\\\"],\\n                \\\"complete_plan_sha256\\\": planning[\\\"identity_sha256\\\"],\\n                \\\"task_population_contract_sha256\\\": population_binding[\\n                    \\\"population_sha256\\\"\\n                ],\\n                \\\"task_population_file_sha256\\\": bundle.task_population.sha256,\\n                \\\"lock_receipt_file_sha256\\\": bundle.candidate_lock_receipt.sha256,\\n                \\\"authentication_status\\\": V4.NO_TRUST_ANCHOR,\\n                \\\"identity_sha256\\\": digest(\\\"candidate-lock-unsealed\\\"),\\n            }\\n        )\\n        source_bindings = sealed(\\n            {\\n                \\\"product_cycle_file_sha256\\\": bundle.product_cycle.sha256,\\n                \\\"product_cycle_schema_file_sha256\\\": bundle.schemas[\\n                    \\\"product_cycle\\\"\\n                ].sha256,\\n                \\\"product_cycle_contract_sha256\\\": product[\\\"manifest_sha256\\\"],\\n                \\\"product_cycle_evidence_canonical_bytes_sha256\\\": PRODUCT.value_sha256(\\n                    product\\n                ),\\n                \\\"task_population_schema_file_sha256\\\": bundle.schemas[\\n                    \\\"task_population\\\"\\n                ].sha256,\\n                \\\"task_population_contract_file_sha256\\\": bundle.task_population.sha256,\\n                \\\"task_population_contract_sha256\\\": population_binding[\\n                    \\\"population_sha256\\\"\\n                ],\\n                \\\"task_population_binding_canonical_bytes_sha256\\\": PRODUCT.value_sha256(\\n                    population_binding\\n                ),\\n                \\\"review_ledger_schema_file_sha256\\\": bundle.schemas[\\n                    \\\"review_ledger\\\"\\n                ].sha256,\\n                \\\"review_ledger_file_sha256\\\": bundle.review_ledger.sha256,\\n                \\\"review_ledger_sha256\\\": ledger[\\\"ledger_sha256\\\"],\\n                \\\"selection_receipt_file_sha256\\\": bundle.selection_receipt.sha256,\\n                \\\"assignment_receipt_file_sha256\\\": bundle.assignment_receipt.sha256,\\n                \\\"overlap_receipt_file_sha256\\\": bundle.overlap_receipt.sha256,\\n                \\\"candidate_lock_receipt_file_sha256\\\": bundle.candidate_lock_receipt.sha256,\\n                \\\"owner_approval_receipt_file_sha256\\\": (\\n                    bundle.owner_approval_receipt.sha256\\n                    if bundle.owner_approval_receipt is not None\\n                    else None\\n                ),\\n                \\\"v4_implementation_lock_sha256\\\": implementation_lock[\\n                    \\\"identity_sha256\\\"\\n                ],\\n                \\\"execution_attestations_sha256\\\": PRODUCT.value_sha256(\\n                    execution_attestations\\n                ),\\n                \\\"identity_sha256\\\": digest(\\\"source-bindings-unsealed\\\"),\\n            }\\n        )\\n        shared = product[\\\"shared_execution\\\"]\\n        candidate = product[\\\"product_identities\\\"][\\\"candidate\\\"]\\n        locked_identities = sealed(\\n            {\\n                \\\"product_cycle_schema_sha256\\\": bundle.schemas[\\\"product_cycle\\\"].sha256,\\n                \\\"product_cycle_file_sha256\\\": bundle.product_cycle.sha256,\\n                \\\"product_cycle_contract_sha256\\\": product[\\\"manifest_sha256\\\"],\\n                \\\"product_cycle_evidence_canonical_bytes_sha256\\\": PRODUCT.value_sha256(\\n                    product\\n                ),\\n                \\\"task_population_schema_sha256\\\": bundle.schemas[\\n                    \\\"task_population\\\"\\n                ].sha256,\\n                \\\"task_population_sha256\\\": population_binding[\\\"population_sha256\\\"],\\n                \\\"task_population_file_sha256\\\": bundle.task_population.sha256,\\n                \\\"review_ledger_file_sha256\\\": bundle.review_ledger.sha256,\\n                \\\"candidate_product_identity_sha256\\\": candidate[\\\"identity_sha256\\\"],\\n                \\\"candidate_packet_format_sha256\\\": candidate[\\\"packet_format\\\"][\\\"sha256\\\"],\\n                \\\"corpus_sha256\\\": shared[\\\"corpus_sha256\\\"],\\n                \\\"engine_sha256\\\": shared[\\\"engine_sha256\\\"],\\n                \\\"prompt_template_sha256\\\": shared[\\\"prompt_template_sha256\\\"],\\n                \\\"prompt_parity_algorithm\\\": shared[\\\"prompt_parity_algorithm\\\"],\\n                \\\"cache_policy_sha256\\\": shared[\\\"cache_policy_sha256\\\"],\\n                \\\"runner_sha256\\\": shared[\\\"runner_sha256\\\"],\\n                \\\"model_id\\\": shared[\\\"model_id\\\"],\\n                \\\"provider_id\\\": execution_contract[\\\"provider_id\\\"],\\n                \\\"agent_cli_id\\\": execution_contract[\\\"agent_cli_id\\\"],\\n                \\\"agent_cli_version\\\": execution_contract[\\\"agent_cli_version\\\"],\\n                \\\"requested_model_id\\\": execution_contract[\\\"requested_model_id\\\"],\\n                \\\"resolved_model_id\\\": execution_contract[\\\"resolved_model_id\\\"],\\n                \\\"effort\\\": shared[\\\"effort\\\"],\\n                \\\"timeout_policy_sha256\\\": execution_contract[\\n                    \\\"timeout_policy_sha256\\\"\\n                ],\\n                \\\"agent_timeout_limit_seconds\\\": execution_contract[\\n                    \\\"agent_timeout_limit_seconds\\\"\\n                ],\\n                \\\"timeout_component_limit_seconds\\\": execution_contract[\\n                    \\\"timeout_component_limit_seconds\\\"\\n                ],\\n                \\\"schedule_sha256\\\": shared[\\\"schedule_sha256\\\"],\\n                \\\"price_quote_sha256\\\": shared[\\\"price_quote_sha256\\\"],\\n                \\\"pricing_policy_sha256\\\": shared[\\\"pricing_policy_sha256\\\"],\\n                \\\"execution_contract_sha256\\\": execution_contract[\\\"identity_sha256\\\"],\\n                \\\"v4_implementation_lock_sha256\\\": implementation_lock[\\n                    \\\"identity_sha256\\\"\\n                ],\\n                \\\"identity_sha256\\\": digest(\\\"locked-identities-unsealed\\\"),\\n            }\\n        )\\n        self.calibration = sealed(\\n            {\\n                \\\"schema\\\": V4.CALIBRATION_SCHEMA,\\n                \\\"evidence_class\\\": self.evidence_class,\\n                \\\"state\\\": self.state,\\n                \\\"owner_approval_receipt_sha256\\\": (\\n                    bundle.owner_approval_receipt.sha256\\n                    if bundle.owner_approval_receipt is not None\\n                    else None\\n                ),\\n                \\\"candidate_lock\\\": candidate_lock,\\n                \\\"v4_implementation_lock\\\": implementation_lock,\\n                \\\"execution_contract\\\": execution_contract,\\n                \\\"execution_attestations\\\": execution_attestations,\\n                \\\"source_byte_bindings\\\": source_bindings,\\n                \\\"locked_identities\\\": locked_identities,\\n                \\\"task_population_binding\\\": population_binding,\\n                \\\"product_cycle_evidence\\\": product,\\n                \\\"planning\\\": planning,\\n                \\\"identity_sha256\\\": digest(\\\"calibration-unsealed\\\"),\\n            }\\n        )\\n        self.bundle = bundle\\n        self.product = product\\n        self.population = population\\n        self.ledger = ledger\\n        self.write(\\\"calibration\\\", self.calibration)\\n\\n\\ndef reseal_calibration(calibration: dict, nested: str | None = None) -> None:\\n    if nested is not None:\\n        calibration[nested][\\\"identity_sha256\\\"] = PRODUCT.self_sha256(\\n            calibration[nested]\\n        )\\n    calibration[\\\"identity_sha256\\\"] = PRODUCT.self_sha256(calibration)\\n\\n\\ndef reseal_report(report: dict) -> None:\\n    report[\\\"report_sha256\\\"] = PRODUCT.self_sha256(report, \\\"report_sha256\\\")\\n\\n\\nclass PowerAnalysisV4RawContractTest(unittest.TestCase):\\n    def test_raw_preflight_and_cli_validate_complete_artifact_graph(self) -> None:\\n        with CalibrationCase() as case:\\n            receipt = V4.preflight_calibration(case.calibration, case.bundle)\\n            self.assertEqual(receipt[\\\"status\\\"], \\\"valid\\\")\\n            self.assertEqual(receipt[\\\"independent_active_task_clusters\\\"], 12)\\n            self.assertEqual(receipt[\\\"active_calibration_tasks\\\"], 12)\\n            self.assertEqual(receipt[\\\"calibration_validated_cells\\\"], 96)\\n            self.assertTrue(receipt[\\\"raw_artifacts_and_schemas_validated\\\"])\\n            self.assertFalse(receipt[\\\"owner_approval_authenticated\\\"])\\n\\n            arguments = [\\n                \\\"preflight\\\",\\n                str(case.paths[\\\"calibration\\\"]),\\n                \\\"--product-cycle\\\",\\n                str(case.paths[\\\"product\\\"]),\\n                \\\"--task-population\\\",\\n                str(case.paths[\\\"population\\\"]),\\n                \\\"--review-ledger\\\",\\n                str(case.paths[\\\"ledger\\\"]),\\n                \\\"--selection-receipt\\\",\\n                str(case.paths[\\\"selection\\\"]),\\n                \\\"--assignment-receipt\\\",\\n                str(case.paths[\\\"assignment\\\"]),\\n                \\\"--overlap-receipt\\\",\\n                str(case.paths[\\\"overlap\\\"]),\\n                \\\"--candidate-lock-receipt\\\",\\n                str(case.paths[\\\"candidate\\\"]),\\n            ]\\n            output = io.StringIO()\\n            with contextlib.redirect_stdout(output):\\n                self.assertEqual(V4.main(arguments), 0)\\n            self.assertEqual(json.loads(output.getvalue())[\\\"status\\\"], \\\"valid\\\")\\n\\n    def test_synthetic_analysis_is_deterministic_but_never_decision_eligible(self) -> None:\\n        with CalibrationCase() as case:\\n            first = V4.analyze_calibration(case.calibration, case.bundle)\\n            second = V4.analyze_calibration(\\n                copy.deepcopy(case.calibration), case.bundle\\n            )\\n            self.assertEqual(first, second)\\n            self.assertEqual(first[\\\"status\\\"], \\\"evaluated\\\")\\n            for key in (\\\"benchmark_power_decision\\\", \\\"product_improvement_gate\\\"):\\n                self.assertFalse(first[key][\\\"eligible_evidence\\\"])\\n                self.assertFalse(first[key][\\\"passed\\\"])\\n                self.assertEqual(\\n                    first[key][\\\"reason\\\"],\\n                    \\\"synthetic_fixture_not_decision_eligible\\\",\\n                )\\n            self.assertFalse(\\n                first[\\\"product_improvement_gate\\\"][\\n                    \\\"alters_benchmark_primary_verdict\\\"\\n                ]\\n            )\\n            checked = V4.check_power_report(case.calibration, first, case.bundle)\\n            self.assertEqual(checked[\\\"status\\\"], \\\"valid\\\")\\n\\n    def test_pending_plan_is_complete_while_results_remain_null(self) -> None:\\n        with CalibrationCase(state=\\\"pending\\\") as case:\\n            self.assertIsInstance(\\n                case.calibration[\\\"planning\\\"][\\\"planning_alternatives\\\"], dict\\n            )\\n            report = V4.analyze_calibration(case.calibration, case.bundle)\\n            self.assertEqual(report[\\\"status\\\"], \\\"pending\\\")\\n            self.assertEqual(\\n                report[\\\"complete_plan\\\"][\\\"identity_sha256\\\"],\\n                report[\\\"planning_sha256\\\"],\\n            )\\n            for row in report[\\\"power_candidates\\\"]:\\n                self.assertIsNone(row[\\\"primary\\\"])\\n                self.assertIsNone(row[\\\"product_diagnostic\\\"])\\n\\n    def test_production_plan_is_exact_and_no_trust_anchor_keeps_frozen_nonpassing(self) -> None:\\n        with CalibrationCase(\\n            state=\\\"frozen\\\", evidence_class=\\\"development_measurement\\\"\\n        ) as case:\\n            receipt = V4.preflight_calibration(case.calibration, case.bundle)\\n            plan = case.calibration[\\\"planning\\\"]\\n            self.assertEqual(plan[\\\"resamples\\\"], 10_000)\\n            self.assertEqual(plan[\\\"seed\\\"], V4.PRODUCTION_SEED)\\n            self.assertEqual(\\n                plan[\\\"candidate_task_clusters\\\"], list(V4.PRODUCTION_CANDIDATE_GRID)\\n            )\\n            self.assertFalse(receipt[\\\"owner_approval_authenticated\\\"])\\n            fake_rows = [\\n                {\\n                    \\\"task_clusters\\\": 12,\\n                    \\\"primary\\\": {\\\"statistical_gate_met\\\": True},\\n                }\\n            ]\\n            decision = V4._decision(\\n                rows=fake_rows,\\n                result_key=\\\"primary\\\",\\n                comparison=V4.PRIMARY_COMPARISON,\\n                role=\\\"benchmark_primary_power_gate\\\",\\n                state=\\\"frozen\\\",\\n                evidence_class=\\\"development_measurement\\\",\\n                authenticated_owner_approval=False,\\n            )\\n            self.assertTrue(decision[\\\"statistical_gate_met\\\"])\\n            self.assertFalse(decision[\\\"eligible_evidence\\\"])\\n            self.assertFalse(decision[\\\"passed\\\"])\\n            self.assertEqual(\\n                decision[\\\"reason\\\"],\\n                \\\"no_authenticated_owner_approval_trust_anchor\\\",\\n            )\\n\\n    def test_development_plan_mutations_fail_schema_and_code(self) -> None:\\n        mutations = (\\n            (\\\"resamples\\\", 9_999),\\n            (\\\"seed\\\", V4.PRODUCTION_SEED + 1),\\n            (\\\"candidate_task_clusters\\\", [12, 24]),\\n        )\\n        with CalibrationCase(evidence_class=\\\"development_measurement\\\") as case:\\n            for field, replacement in mutations:\\n                with self.subTest(field=field):\\n                    calibration = copy.deepcopy(case.calibration)\\n                    calibration[\\\"planning\\\"][field] = replacement\\n                    reseal_calibration(calibration, \\\"planning\\\")\\n                    with self.assertRaises(V4.PowerV4Error):\\n                        V4.preflight_calibration(calibration, case.bundle)\\n\\n    def test_any_post_lock_plan_change_is_rejected(self) -> None:\\n        changes = (\\n            lambda plan: plan.__setitem__(\\\"seed\\\", plan[\\\"seed\\\"] + 1),\\n            lambda plan: plan.__setitem__(\\\"resamples\\\", 101),\\n            lambda plan: plan.__setitem__(\\\"candidate_task_clusters\\\", [12, 24]),\\n            lambda plan: plan[\\\"planning_alternatives\\\"][\\\"primary\\\"][\\n                \\\"elapsed_time\\\"\\n            ].__setitem__(\\\"planning_alternative_ratio\\\", 0.61),\\n        )\\n        with CalibrationCase() as case:\\n            for mutate in changes:\\n                calibration = copy.deepcopy(case.calibration)\\n                mutate(calibration[\\\"planning\\\"])\\n                reseal_calibration(calibration, \\\"planning\\\")\\n                with self.assertRaises(V4.PowerV4Error):\\n                    V4.preflight_calibration(calibration, case.bundle)\\n\\n    def test_raw_whitespace_changes_are_detected_even_when_json_value_is_same(self) -> None:\\n        for artifact in (\\\"product\\\", \\\"population\\\", \\\"ledger\\\"):\\n            with self.subTest(artifact=artifact), CalibrationCase() as case:\\n                path = case.paths[artifact]\\n                path.write_bytes(path.read_bytes() + b\\\"\\\\n\\\")\\n                bundle = case.reload_bundle()\\n                with self.assertRaises(V4.PowerV4Error):\\n                    V4.preflight_calibration(case.calibration, bundle)\\n\\n    def test_full_task_population_validator_runs_on_loaded_raw_files(self) -> None:\\n        with CalibrationCase() as case:\\n            ledger = copy.deepcopy(case.ledger)\\n            ledger[\\\"reviews\\\"][0][\\\"checks\\\"][\\\"symptom_only\\\"] = False\\n            case.write(\\\"ledger\\\", ledger)\\n            with self.assertRaisesRegex(\\n                V4.PowerV4Error, \\\"task-population validation failed\\\"\\n            ):\\n                case.reload_bundle()\\n\\n    def test_receipt_subject_and_raw_hash_are_both_enforced(self) -> None:\\n        with CalibrationCase() as case:\\n            receipt = json.loads(case.paths[\\\"selection\\\"].read_text())\\n            receipt[\\\"verification_subject_sha256\\\"] = digest(\\\"wrong-subject\\\")\\n            sealed(receipt)\\n            case.write(\\\"selection\\\", receipt)\\n            bundle = case.reload_bundle()\\n            with self.assertRaises(V4.PowerV4Error):\\n                V4.preflight_calibration(case.calibration, bundle)\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839638.711496}}}
{"timestamp":"2026-09-19T17:40:38.712Z","ordinal":7582,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":70858633,"cached_input_tokens":67617408,"cache_write_input_tokens":0,"output_tokens":101387,"reasoning_output_tokens":14632,"total_tokens":70960020},"last_token_usage":{"input_tokens":170122,"cached_input_tokens":165888,"cache_write_input_tokens":0,"output_tokens":52,"reasoning_output_tokens":0,"total_tokens":170174},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":15.0,"window_minutes":10080,"resets_at":1790414255},"secondary":null,"credits":{"has_credits":true,"unlimited":false,"balance":"1118.8998305000"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
{"timestamp":"2026-09-19T17:40:42.465Z","ordinal":7583,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0cb48b2b18d09e75016aaec919164087d2bc52d7e528233759","status":"completed","call_id":"call_FkNmzY3e2r8WXsfeebnNO1Xd","name":"exec","input":"text(await tools.exec_command({cmd:\"sed -n '881,1253p' benchmarks/agent-brain/confirmatory/test_power_analysis_v4_hardening.py\",\"max_output_tokens\":8000}));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839639.227001}}}
{"timestamp":"2026-09-19T17:40:42.555Z","ordinal":7584,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","item":{"type":"CommandExecution","id":"exec-bd4105db-046c-409d-b6fe-8fec565061f7","process_id":"81527","command":["/bin/zsh","-lc","sed -n '881,1253p' benchmarks/agent-brain/confirmatory/test_power_analysis_v4_hardening.py"],"cwd":"file:///Users/thomi/.codex/worktrees/5d33/entire-brain","parsed_cmd":[{"type":"read","cmd":"sed -n '881,1253p' benchmarks/agent-brain/confirmatory/test_power_analysis_v4_hardening.py","name":"test_power_analysis_v4_hardening.py","path":"benchmarks/agent-brain/confirmatory/test_power_analysis_v4_hardening.py"}],"source":"unified_exec_startup","status":"completed","stdout":"\n    def test_population_receipts_bind_selection_assignment_and_overlap_outputs(self) -> None:\n        def assert_subject_rejects(\n            case: CalibrationCase, population: dict, ledger: dict\n        ) -> None:\n            sealed_ledger = TASK.seal_review_ledger(ledger)\n            sealed_population = TASK.seal_population(population, sealed_ledger)\n            case.write(\"ledger\", sealed_ledger)\n            case.write(\"population\", sealed_population)\n            bundle = case.reload_bundle()\n            with self.assertRaisesRegex(V4.PowerV4Error, \"receipt subject drift\"):\n                V4.preflight_calibration(case.calibration, bundle)\n\n        with CalibrationCase() as case:\n            population = copy.deepcopy(case.population)\n            ledger = copy.deepcopy(case.ledger)\n            calibration_member = next(\n                member\n                for member in population[\"members\"]\n                if member[\"membership\"] == \"development_calibration\"\n            )\n            old_ref = calibration_member[\"member_ref\"]\n            new_ref = digest(\"replacement-selected-member-ref\")\n            calibration_member[\"member_ref\"] = new_ref\n            ledger_review = next(\n                row for row in ledger[\"reviews\"] if row[\"member_ref\"] == old_ref\n            )\n            ledger_review[\"member_ref\"] = new_ref\n            assert_subject_rejects(case, population, ledger)\n\n        with CalibrationCase() as case:\n            population = copy.deepcopy(case.population)\n            ledger = copy.deepcopy(case.ledger)\n            optimization = next(\n                member\n                for member in population[\"members\"]\n                if member[\"membership\"] == \"development_optimization\"\n                and member[\"contamination_state\"] != \"excluded\"\n            )\n            calibration_member = next(\n                member\n                for member in population[\"members\"]\n                if member[\"membership\"] == \"development_calibration\"\n            )\n            optimization[\"membership\"] = \"development_calibration\"\n            calibration_member[\"membership\"] = \"development_optimization\"\n            assert_subject_rejects(case, population, ledger)\n\n        with CalibrationCase() as case:\n            population = copy.deepcopy(case.population)\n            ledger = copy.deepcopy(case.ledger)\n            calibration_member = next(\n                member\n                for member in population[\"members\"]\n                if member[\"membership\"] == \"development_calibration\"\n            )\n            calibration_member[\"task_overlap_commitment_sha256\"] = digest(\n                \"changed-overlap-output\"\n            )\n            assert_subject_rejects(case, population, ledger)\n\n    def test_actual_artifact_schemas_reject_extra_fields_dates_and_oneof_drift(self) -> None:\n        with CalibrationCase() as case:\n            calibration = copy.deepcopy(case.calibration)\n            calibration[\"unexpected\"] = True\n            reseal_calibration(calibration)\n            with self.assertRaisesRegex(V4.PowerV4Error, \"additional property\"):\n                V4.preflight_calibration(calibration, case.bundle)\n\n        with CalibrationCase() as case:\n            receipt = json.loads(case.paths[\"selection\"].read_text())\n            receipt[\"verified_at\"] = \"not-a-date\"\n            sealed(receipt)\n            case.write(\"selection\", receipt)\n            with self.assertRaisesRegex(V4.PowerV4Error, \"RFC3339\"):\n                case.reload_bundle()\n\n        with CalibrationCase() as case:\n            population = copy.deepcopy(case.population)\n            holdout = next(\n                member\n                for member in population[\"members\"]\n                if member[\"membership\"] == \"confirmatory_holdout\"\n            )\n            holdout[\"attributes\"] = attributes(\"forbidden-holdout-plaintext\")\n            case.write(\"population\", population)\n            with self.assertRaises(V4.PowerV4Error):\n                case.reload_bundle()\n\n    def test_duplicate_product_task_hashes_and_related_tasks_do_not_count_as_independent(self) -> None:\n        with self.assertRaisesRegex(V4.PowerV4Error, \"task hashes must be unique\"):\n            CalibrationCase(duplicate_task_hash=True)\n        with self.assertRaisesRegex(\n            V4.PowerV4Error, \"at least 12 derived|one mutually independent\"\n        ):\n            CalibrationCase(related_calibration_pair=True)\n        with self.assertRaisesRegex(\n            V4.PowerV4Error, \"at least 12 derived|one mutually independent\"\n        ):\n            CalibrationCase(shared_fix_pair=True)\n        with self.assertRaisesRegex(\n            V4.PowerV4Error, \"at least 12 derived|one mutually independent\"\n        ):\n            CalibrationCase(shared_session_pair=True)\n        with self.assertRaisesRegex(\n            V4.PowerV4Error, \"at least 12 derived|one mutually independent\"\n        ):\n            CalibrationCase(excluded_bridge=True)\n\n    def test_execution_provider_cli_model_and_timeout_attestations_require_cell_parity(self) -> None:\n        mutations = {\n            \"provider_id\": \"other-provider\",\n            \"agent_cli_id\": \"other-cli\",\n            \"agent_cli_version\": \"other-cli-version\",\n            \"requested_model_id\": \"other-requested-model\",\n            \"resolved_model_id\": \"other-model\",\n            \"timeout_policy_sha256\": digest(\"other-timeout-policy\"),\n            \"agent_timeout_limit_seconds\": 901,\n            \"timeout_component_limit_seconds\": 60,\n        }\n        with CalibrationCase() as case:\n            for field, replacement in mutations.items():\n                with self.subTest(field=field):\n                    calibration = copy.deepcopy(case.calibration)\n                    calibration[\"execution_attestations\"][0][field] = replacement\n                    sealed(calibration[\"execution_attestations\"][0])\n                    reseal_calibration(calibration)\n                    with self.assertRaisesRegex(V4.PowerV4Error, \"drift\"):\n                        V4.preflight_calibration(calibration, case.bundle)\n\n    def test_analyzer_and_every_schema_are_bound_by_dedicated_v4_lock(self) -> None:\n        with CalibrationCase() as case:\n            expected = V4._expected_implementation_lock(case.bundle)\n            self.assertEqual(\n                case.calibration[\"v4_implementation_lock\"], expected\n            )\n            calibration = copy.deepcopy(case.calibration)\n            calibration[\"v4_implementation_lock\"][\n                \"analyzer_file_sha256\"\n            ] = digest(\"different-analyzer\")\n            reseal_calibration(calibration, \"v4_implementation_lock\")\n            with self.assertRaisesRegex(\n                V4.PowerV4Error, \"v4 implementation lock drift\"\n            ):\n                V4.preflight_calibration(calibration, case.bundle)\n\n    def test_natural_cost_estimand_supports_zero_numerators_and_zero_denominator_draws(self) -> None:\n        vectors = [\n            {\n                \"independence_cluster_sha256\": digest(\"cluster-zero\"),\n                \"task_ids\": [\"zero\"],\n                \"task_weight\": 1,\n                \"elapsed_log_ratio\": math.log(0.8),\n                \"cost_numerator_mean\": 0.2,\n                \"cost_denominator_mean\": 0.0,\n                \"quality_difference\": 0.2,\n            },\n            {\n                \"independence_cluster_sha256\": digest(\"cluster-positive\"),\n                \"task_ids\": [\"positive\"],\n                \"task_weight\": 1,\n                \"elapsed_log_ratio\": math.log(0.8),\n                \"cost_numerator_mean\": 0.4,\n                \"cost_denominator_mean\": 1.0,\n                \"quality_difference\": 0.2,\n            },\n        ]\n        draws = [(0,), (1,)]\n        statistics, parameters = V4._draw_statistics(\n            vectors, draws, alternative=None\n        )\n        self.assertIsNone(statistics[0][\"normalized_cost\"])\n        self.assertEqual(statistics[1][\"normalized_cost\"], 0.4)\n        self.assertAlmostEqual(\n            parameters[\"cost_numerator_mean\"]\n            / parameters[\"cost_denominator_mean\"],\n            0.6,\n        )\n        _, zero_draws = V4._ci_offsets(vectors, draws)\n        self.assertEqual(zero_draws, 1)\n        power = V4._power_for_contrast(\n            vectors,\n            FIX.alternatives()[\"primary\"],\n            draws,\n            task_clusters=1,\n            resampling_sha256=digest(\"resampling\"),\n        )\n        self.assertEqual(power[\"zero_denominator_draws\"], 1)\n        self.assertEqual(\n            power[\"zero_denominator_resample_policy\"],\n            \"automatic_cost_and_joint_failure_excluded_from_ci_quantile_v1\",\n        )\n        self.assertLessEqual(\n            power[\"joint_all_endpoint_power\"],\n            power[\"marginal_power\"][\"normalized_cost\"],\n        )\n\n    def test_frozen_equal_task_estimands_remain_unchanged(self) -> None:\n        with CalibrationCase(homogeneous=False) as case:\n            report = V4.analyze_calibration(case.calibration, case.bundle)\n            primary = report[\"calibration_estimates\"][\"primary\"]\n            self.assertAlmostEqual(\n                primary[\"elapsed_time\"][\"paired_task_geometric_mean_ratio\"],\n                math.sqrt(0.4 * 0.8),\n                places=11,\n            )\n            self.assertAlmostEqual(\n                primary[\"normalized_cost\"][\"equal_task_weighted_mean_ratio\"],\n                82.0 / 110.0,\n                places=11,\n            )\n            self.assertFalse(\n                primary[\"normalized_cost\"][\"geometric_mean_task_ratios_used\"]\n            )\n            self.assertAlmostEqual(\n                primary[\"code_quality\"][\"paired_task_mean_difference\"],\n                0.30,\n                places=11,\n            )\n\n    def test_structural_zero_treatment_costs_are_supported_without_logs(self) -> None:\n        with CalibrationCase(structural_zero=True) as case:\n            report = V4.analyze_calibration(case.calibration, case.bundle)\n            for key in (\"primary\", \"product_diagnostic\"):\n                cost = report[\"calibration_estimates\"][key][\"normalized_cost\"]\n                self.assertEqual(cost[\"equal_task_weighted_mean_ratio\"], 0.0)\n                self.assertTrue(cost[\"structural_zero_treatment_cost_supported\"])\n                self.assertFalse(cost[\"geometric_mean_task_ratios_used\"])\n\n    def test_report_schema_and_recomputation_reject_auditor_mutations(self) -> None:\n        with CalibrationCase() as case:\n            report = V4.analyze_calibration(case.calibration, case.bundle)\n            mutations = []\n            extra = copy.deepcopy(report)\n            extra[\"unexpected\"] = True\n            reseal_report(extra)\n            mutations.append(extra)\n            passed = copy.deepcopy(report)\n            passed[\"benchmark_power_decision\"][\"passed\"] = True\n            reseal_report(passed)\n            mutations.append(passed)\n            lock = copy.deepcopy(report)\n            lock[\"integrity\"][\"v4_implementation_lock_sha256\"] = digest(\n                \"other-v4-lock\"\n            )\n            reseal_report(lock)\n            mutations.append(lock)\n            probability = copy.deepcopy(report)\n            probability[\"power_candidates\"][0][\"primary\"][\"marginal_power\"][\n                \"elapsed_time\"\n            ] = 1.1\n            reseal_report(probability)\n            mutations.append(probability)\n            for mutation in mutations:\n                with self.assertRaises(V4.PowerV4Error):\n                    V4.validate_power_report(mutation, case.bundle)\n\n            recomputation = copy.deepcopy(report)\n            recomputation[\"power_candidates\"][0][\"primary\"][\"marginal_power\"][\n                \"elapsed_time\"\n            ] = 0.99\n            reseal_report(recomputation)\n            V4.validate_power_report(recomputation, case.bundle)\n            with self.assertRaisesRegex(V4.PowerV4Error, \"recomputation\"):\n                V4.check_power_report(\n                    case.calibration, recomputation, case.bundle\n                )\n\n    def test_strict_loader_rejects_duplicate_keys_and_non_json_numbers(self) -> None:\n        with tempfile.TemporaryDirectory() as temporary:\n            duplicate = pathlib.Path(temporary) / \"duplicate.json\"\n            duplicate.write_text('{\"schema\":\"a\",\"schema\":\"b\"}', encoding=\"utf-8\")\n            with self.assertRaisesRegex(V4.PowerV4Error, \"duplicate object key\"):\n                V4.load_calibration(duplicate)\n            for constant in (\"NaN\", \"Infinity\", \"-Infinity\"):\n                path = pathlib.Path(temporary) / f\"{constant}.json\"\n                path.write_text('{\"value\":' + constant + \"}\", encoding=\"utf-8\")\n                with self.assertRaisesRegex(V4.PowerV4Error, \"non-JSON numeric\"):\n                    V4.load_calibration(path)\n\n    def test_draft_2020_12_validator_audits_dormant_branches_and_numeric_uniqueness(self) -> None:\n        dialect = \"https://json-schema.org/draft/2020-12/schema\"\n        with self.assertRaisesRegex(DRAFT.SchemaError, \"unsupported schema\"):\n            DRAFT.Validator(\n                [\n                    DRAFT.SchemaDocument(\n                        \"bad.json\",\n                        {\n                            \"$schema\": dialect,\n                            \"type\": \"object\",\n                            \"$defs\": {\"dormant\": {\"madeUpAssertion\": True}},\n                        },\n                    )\n                ]\n            )\n        validator = DRAFT.Validator(\n            [\n                DRAFT.SchemaDocument(\n                    \"unique.json\",\n                    {\n                        \"$schema\": dialect,\n                        \"type\": \"array\",\n                        \"uniqueItems\": True,\n                    },\n                )\n            ]\n        )\n        with self.assertRaisesRegex(DRAFT.SchemaError, \"uniqueItems\"):\n            validator.validate([1, 1.0], \"unique.json\", label=\"numeric array\")\n\n        registry = DRAFT.Validator(\n            [\n                DRAFT.SchemaDocument(\n                    \"leaf.json\",\n                    {\n                        \"$schema\": dialect,\n                        \"$id\": \"https://example.test/leaf.json\",\n                        \"type\": \"string\",\n                        \"pattern\": \"^ok$\",\n                    },\n                ),\n                DRAFT.SchemaDocument(\n                    \"root.json\",\n                    {\n                        \"$schema\": dialect,\n                        \"type\": \"object\",\n                        \"required\": [\"value\"],\n                        \"properties\": {\n                            \"value\": {\"$ref\": \"leaf.json\"}\n                        },\n                        \"additionalProperties\": False,\n                    },\n                ),\n            ]\n        )\n        registry.validate({\"value\": \"ok\"}, \"root.json\", label=\"cross ref\")\n        with self.assertRaises(DRAFT.SchemaError):\n            registry.validate(\n                {\"value\": \"no\", \"extra\": True}, \"root.json\", label=\"cross ref\"\n            )\n\n    def test_shared_resampling_is_exact_and_joint_is_same_draw_frequency(self) -> None:\n        first, first_sha = V4.shared_cluster_resamples(\n            source_clusters=12, target_clusters=24, resamples=100, seed=41\n        )\n        second, second_sha = V4.shared_cluster_resamples(\n            source_clusters=12, target_clusters=24, resamples=100, seed=41\n        )\n        changed, changed_sha = V4.shared_cluster_resamples(\n            source_clusters=12, target_clusters=24, resamples=100, seed=42\n        )\n        self.assertEqual(first, second)\n        self.assertEqual(first_sha, second_sha)\n        self.assertNotEqual(first, changed)\n        self.assertNotEqual(first_sha, changed_sha)\n        with CalibrationCase() as case:\n            report = V4.analyze_calibration(case.calibration, case.bundle)\n            for row in report[\"power_candidates\"]:\n                self.assertEqual(\n                    row[\"primary\"][\"shared_resampling_sha256\"],\n                    row[\"product_diagnostic\"][\"shared_resampling_sha256\"],\n                )\n                for key in (\"primary\", \"product_diagnostic\"):\n                    result = row[key]\n                    self.assertLessEqual(\n                        result[\"joint_all_endpoint_power\"],\n                        min(result[\"marginal_power\"].values()),\n                    )\n                    self.assertFalse(result[\"independence_shortcut_used\"])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","stderr":"","aggregated_output":"\n    def test_population_receipts_bind_selection_assignment_and_overlap_outputs(self) -> None:\n        def assert_subject_rejects(\n            case: CalibrationCase, population: dict, ledger: dict\n        ) -> None:\n            sealed_ledger = TASK.seal_review_ledger(ledger)\n            sealed_population = TASK.seal_population(population, sealed_ledger)\n            case.write(\"ledger\", sealed_ledger)\n            case.write(\"population\", sealed_population)\n            bundle = case.reload_bundle()\n            with self.assertRaisesRegex(V4.PowerV4Error, \"receipt subject drift\"):\n                V4.preflight_calibration(case.calibration, bundle)\n\n        with CalibrationCase() as case:\n            population = copy.deepcopy(case.population)\n            ledger = copy.deepcopy(case.ledger)\n            calibration_member = next(\n                member\n                for member in population[\"members\"]\n                if member[\"membership\"] == \"development_calibration\"\n            )\n            old_ref = calibration_member[\"member_ref\"]\n            new_ref = digest(\"replacement-selected-member-ref\")\n            calibration_member[\"member_ref\"] = new_ref\n            ledger_review = next(\n                row for row in ledger[\"reviews\"] if row[\"member_ref\"] == old_ref\n            )\n            ledger_review[\"member_ref\"] = new_ref\n            assert_subject_rejects(case, population, ledger)\n\n        with CalibrationCase() as case:\n            population = copy.deepcopy(case.population)\n            ledger = copy.deepcopy(case.ledger)\n            optimization = next(\n                member\n                for member in population[\"members\"]\n                if member[\"membership\"] == \"development_optimization\"\n                and member[\"contamination_state\"] != \"excluded\"\n            )\n            calibration_member = next(\n                member\n                for member in population[\"members\"]\n                if member[\"membership\"] == \"development_calibration\"\n            )\n            optimization[\"membership\"] = \"development_calibration\"\n            calibration_member[\"membership\"] = \"development_optimization\"\n            assert_subject_rejects(case, population, ledger)\n\n        with CalibrationCase() as case:\n            population = copy.deepcopy(case.population)\n            ledger = copy.deepcopy(case.ledger)\n            calibration_member = next(\n                member\n                for member in population[\"members\"]\n                if member[\"membership\"] == \"development_calibration\"\n            )\n            calibration_member[\"task_overlap_commitment_sha256\"] = digest(\n                \"changed-overlap-output\"\n            )\n            assert_subject_rejects(case, population, ledger)\n\n    def test_actual_artifact_schemas_reject_extra_fields_dates_and_oneof_drift(self) -> None:\n        with CalibrationCase() as case:\n            calibration = copy.deepcopy(case.calibration)\n            calibration[\"unexpected\"] = True\n            reseal_calibration(calibration)\n            with self.assertRaisesRegex(V4.PowerV4Error, \"additional property\"):\n                V4.preflight_calibration(calibration, case.bundle)\n\n        with CalibrationCase() as case:\n            receipt = json.loads(case.paths[\"selection\"].read_text())\n            receipt[\"verified_at\"] = \"not-a-date\"\n            sealed(receipt)\n            case.write(\"selection\", receipt)\n            with self.assertRaisesRegex(V4.PowerV4Error, \"RFC3339\"):\n                case.reload_bundle()\n\n        with CalibrationCase() as case:\n            population = copy.deepcopy(case.population)\n            holdout = next(\n                member\n                for member in population[\"members\"]\n                if member[\"membership\"] == \"confirmatory_holdout\"\n            )\n            holdout[\"attributes\"] = attributes(\"forbidden-holdout-plaintext\")\n            case.write(\"population\", population)\n            with self.assertRaises(V4.PowerV4Error):\n                case.reload_bundle()\n\n    def test_duplicate_product_task_hashes_and_related_tasks_do_not_count_as_independent(self) -> None:\n        with self.assertRaisesRegex(V4.PowerV4Error, \"task hashes must be unique\"):\n            CalibrationCase(duplicate_task_hash=True)\n        with self.assertRaisesRegex(\n            V4.PowerV4Error, \"at least 12 derived|one mutually independent\"\n        ):\n            CalibrationCase(related_calibration_pair=True)\n        with self.assertRaisesRegex(\n            V4.PowerV4Error, \"at least 12 derived|one mutually independent\"\n        ):\n            CalibrationCase(shared_fix_pair=True)\n        with self.assertRaisesRegex(\n            V4.PowerV4Error, \"at least 12 derived|one mutually independent\"\n        ):\n            CalibrationCase(shared_session_pair=True)\n        with self.assertRaisesRegex(\n            V4.PowerV4Error, \"at least 12 derived|one mutually independent\"\n        ):\n            CalibrationCase(excluded_bridge=True)\n\n    def test_execution_provider_cli_model_and_timeout_attestations_require_cell_parity(self) -> None:\n        mutations = {\n            \"provider_id\": \"other-provider\",\n            \"agent_cli_id\": \"other-cli\",\n            \"agent_cli_version\": \"other-cli-version\",\n            \"requested_model_id\": \"other-requested-model\",\n            \"resolved_model_id\": \"other-model\",\n            \"timeout_policy_sha256\": digest(\"other-timeout-policy\"),\n            \"agent_timeout_limit_seconds\": 901,\n            \"timeout_component_limit_seconds\": 60,\n        }\n        with CalibrationCase() as case:\n            for field, replacement in mutations.items():\n                with self.subTest(field=field):\n                    calibration = copy.deepcopy(case.calibration)\n                    calibration[\"execution_attestations\"][0][field] = replacement\n                    sealed(calibration[\"execution_attestations\"][0])\n                    reseal_calibration(calibration)\n                    with self.assertRaisesRegex(V4.PowerV4Error, \"drift\"):\n                        V4.preflight_calibration(calibration, case.bundle)\n\n    def test_analyzer_and_every_schema_are_bound_by_dedicated_v4_lock(self) -> None:\n        with CalibrationCase() as case:\n            expected = V4._expected_implementation_lock(case.bundle)\n            self.assertEqual(\n                case.calibration[\"v4_implementation_lock\"], expected\n            )\n            calibration = copy.deepcopy(case.calibration)\n            calibration[\"v4_implementation_lock\"][\n                \"analyzer_file_sha256\"\n            ] = digest(\"different-analyzer\")\n            reseal_calibration(calibration, \"v4_implementation_lock\")\n            with self.assertRaisesRegex(\n                V4.PowerV4Error, \"v4 implementation lock drift\"\n            ):\n                V4.preflight_calibration(calibration, case.bundle)\n\n    def test_natural_cost_estimand_supports_zero_numerators_and_zero_denominator_draws(self) -> None:\n        vectors = [\n            {\n                \"independence_cluster_sha256\": digest(\"cluster-zero\"),\n                \"task_ids\": [\"zero\"],\n                \"task_weight\": 1,\n                \"elapsed_log_ratio\": math.log(0.8),\n                \"cost_numerator_mean\": 0.2,\n                \"cost_denominator_mean\": 0.0,\n                \"quality_difference\": 0.2,\n            },\n            {\n                \"independence_cluster_sha256\": digest(\"cluster-positive\"),\n                \"task_ids\": [\"positive\"],\n                \"task_weight\": 1,\n                \"elapsed_log_ratio\": math.log(0.8),\n                \"cost_numerator_mean\": 0.4,\n                \"cost_denominator_mean\": 1.0,\n                \"quality_difference\": 0.2,\n            },\n        ]\n        draws = [(0,), (1,)]\n        statistics, parameters = V4._draw_statistics(\n            vectors, draws, alternative=None\n        )\n        self.assertIsNone(statistics[0][\"normalized_cost\"])\n        self.assertEqual(statistics[1][\"normalized_cost\"], 0.4)\n        self.assertAlmostEqual(\n            parameters[\"cost_numerator_mean\"]\n            / parameters[\"cost_denominator_mean\"],\n            0.6,\n        )\n        _, zero_draws = V4._ci_offsets(vectors, draws)\n        self.assertEqual(zero_draws, 1)\n        power = V4._power_for_contrast(\n            vectors,\n            FIX.alternatives()[\"primary\"],\n            draws,\n            task_clusters=1,\n            resampling_sha256=digest(\"resampling\"),\n        )\n        self.assertEqual(power[\"zero_denominator_draws\"], 1)\n        self.assertEqual(\n            power[\"zero_denominator_resample_policy\"],\n            \"automatic_cost_and_joint_failure_excluded_from_ci_quantile_v1\",\n        )\n        self.assertLessEqual(\n            power[\"joint_all_endpoint_power\"],\n            power[\"marginal_power\"][\"normalized_cost\"],\n        )\n\n    def test_frozen_equal_task_estimands_remain_unchanged(self) -> None:\n        with CalibrationCase(homogeneous=False) as case:\n            report = V4.analyze_calibration(case.calibration, case.bundle)\n            primary = report[\"calibration_estimates\"][\"primary\"]\n            self.assertAlmostEqual(\n                primary[\"elapsed_time\"][\"paired_task_geometric_mean_ratio\"],\n                math.sqrt(0.4 * 0.8),\n                places=11,\n            )\n            self.assertAlmostEqual(\n                primary[\"normalized_cost\"][\"equal_task_weighted_mean_ratio\"],\n                82.0 / 110.0,\n                places=11,\n            )\n            self.assertFalse(\n                primary[\"normalized_cost\"][\"geometric_mean_task_ratios_used\"]\n            )\n            self.assertAlmostEqual(\n                primary[\"code_quality\"][\"paired_task_mean_difference\"],\n                0.30,\n                places=11,\n            )\n\n    def test_structural_zero_treatment_costs_are_supported_without_logs(self) -> None:\n        with CalibrationCase(structural_zero=True) as case:\n            report = V4.analyze_calibration(case.calibration, case.bundle)\n            for key in (\"primary\", \"product_diagnostic\"):\n                cost = report[\"calibration_estimates\"][key][\"normalized_cost\"]\n                self.assertEqual(cost[\"equal_task_weighted_mean_ratio\"], 0.0)\n                self.assertTrue(cost[\"structural_zero_treatment_cost_supported\"])\n                self.assertFalse(cost[\"geometric_mean_task_ratios_used\"])\n\n    def test_report_schema_and_recomputation_reject_auditor_mutations(self) -> None:\n        with CalibrationCase() as case:\n            report = V4.analyze_calibration(case.calibration, case.bundle)\n            mutations = []\n            extra = copy.deepcopy(report)\n            extra[\"unexpected\"] = True\n            reseal_report(extra)\n            mutations.append(extra)\n            passed = copy.deepcopy(report)\n            passed[\"benchmark_power_decision\"][\"passed\"] = True\n            reseal_report(passed)\n            mutations.append(passed)\n            lock = copy.deepcopy(report)\n            lock[\"integrity\"][\"v4_implementation_lock_sha256\"] = digest(\n                \"other-v4-lock\"\n            )\n            reseal_report(lock)\n            mutations.append(lock)\n            probability = copy.deepcopy(report)\n            probability[\"power_candidates\"][0][\"primary\"][\"marginal_power\"][\n                \"elapsed_time\"\n            ] = 1.1\n            reseal_report(probability)\n            mutations.append(probability)\n            for mutation in mutations:\n                with self.assertRaises(V4.PowerV4Error):\n                    V4.validate_power_report(mutation, case.bundle)\n\n            recomputation = copy.deepcopy(report)\n            recomputation[\"power_candidates\"][0][\"primary\"][\"marginal_power\"][\n                \"elapsed_time\"\n            ] = 0.99\n            reseal_report(recomputation)\n            V4.validate_power_report(recomputation, case.bundle)\n            with self.assertRaisesRegex(V4.PowerV4Error, \"recomputation\"):\n                V4.check_power_report(\n                    case.calibration, recomputation, case.bundle\n                )\n\n    def test_strict_loader_rejects_duplicate_keys_and_non_json_numbers(self) -> None:\n        with tempfile.TemporaryDirectory() as temporary:\n            duplicate = pathlib.Path(temporary) / \"duplicate.json\"\n            duplicate.write_text('{\"schema\":\"a\",\"schema\":\"b\"}', encoding=\"utf-8\")\n            with self.assertRaisesRegex(V4.PowerV4Error, \"duplicate object key\"):\n                V4.load_calibration(duplicate)\n            for constant in (\"NaN\", \"Infinity\", \"-Infinity\"):\n                path = pathlib.Path(temporary) / f\"{constant}.json\"\n                path.write_text('{\"value\":' + constant + \"}\", encoding=\"utf-8\")\n                with self.assertRaisesRegex(V4.PowerV4Error, \"non-JSON numeric\"):\n                    V4.load_calibration(path)\n\n    def test_draft_2020_12_validator_audits_dormant_branches_and_numeric_uniqueness(self) -> None:\n        dialect = \"https://json-schema.org/draft/2020-12/schema\"\n        with self.assertRaisesRegex(DRAFT.SchemaError, \"unsupported schema\"):\n            DRAFT.Validator(\n                [\n                    DRAFT.SchemaDocument(\n                        \"bad.json\",\n                        {\n                            \"$schema\": dialect,\n                            \"type\": \"object\",\n                            \"$defs\": {\"dormant\": {\"madeUpAssertion\": True}},\n                        },\n                    )\n                ]\n            )\n        validator = DRAFT.Validator(\n            [\n                DRAFT.SchemaDocument(\n                    \"unique.json\",\n                    {\n                        \"$schema\": dialect,\n                        \"type\": \"array\",\n                        \"uniqueItems\": True,\n                    },\n                )\n            ]\n        )\n        with self.assertRaisesRegex(DRAFT.SchemaError, \"uniqueItems\"):\n            validator.validate([1, 1.0], \"unique.json\", label=\"numeric array\")\n\n        registry = DRAFT.Validator(\n            [\n                DRAFT.SchemaDocument(\n                    \"leaf.json\",\n                    {\n                        \"$schema\": dialect,\n                        \"$id\": \"https://example.test/leaf.json\",\n                        \"type\": \"string\",\n                        \"pattern\": \"^ok$\",\n                    },\n                ),\n                DRAFT.SchemaDocument(\n                    \"root.json\",\n                    {\n                        \"$schema\": dialect,\n                        \"type\": \"object\",\n                        \"required\": [\"value\"],\n                        \"properties\": {\n                            \"value\": {\"$ref\": \"leaf.json\"}\n                        },\n                        \"additionalProperties\": False,\n                    },\n                ),\n            ]\n        )\n        registry.validate({\"value\": \"ok\"}, \"root.json\", label=\"cross ref\")\n        with self.assertRaises(DRAFT.SchemaError):\n            registry.validate(\n                {\"value\": \"no\", \"extra\": True}, \"root.json\", label=\"cross ref\"\n            )\n\n    def test_shared_resampling_is_exact_and_joint_is_same_draw_frequency(self) -> None:\n        first, first_sha = V4.shared_cluster_resamples(\n            source_clusters=12, target_clusters=24, resamples=100, seed=41\n        )\n        second, second_sha = V4.shared_cluster_resamples(\n            source_clusters=12, target_clusters=24, resamples=100, seed=41\n        )\n        changed, changed_sha = V4.shared_cluster_resamples(\n            source_clusters=12, target_clusters=24, resamples=100, seed=42\n        )\n        self.assertEqual(first, second)\n        self.assertEqual(first_sha, second_sha)\n        self.assertNotEqual(first, changed)\n        self.assertNotEqual(first_sha, changed_sha)\n        with CalibrationCase() as case:\n            report = V4.analyze_calibration(case.calibration, case.bundle)\n            for row in report[\"power_candidates\"]:\n                self.assertEqual(\n                    row[\"primary\"][\"shared_resampling_sha256\"],\n                    row[\"product_diagnostic\"][\"shared_resampling_sha256\"],\n                )\n                for key in (\"primary\", \"product_diagnostic\"):\n                    result = row[key]\n                    self.assertLessEqual(\n                        result[\"joint_all_endpoint_power\"],\n                        min(result[\"marginal_power\"].values()),\n                    )\n                    self.assertFalse(result[\"independence_shortcut_used\"])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"duration":{"secs":0,"nanos":3042},"formatted_output":"\n    def test_population_receipts_bind_selection_assignment_and_overlap_outputs(self) -> None:\n        def assert_subject_rejects(\n            case: CalibrationCase, population: dict, ledger: dict\n        ) -> None:\n            sealed_ledger = TASK.seal_review_ledger(ledger)\n            sealed_population = TASK.seal_population(population, sealed_ledger)\n            case.write(\"ledger\", sealed_ledger)\n            case.write(\"population\", sealed_population)\n            bundle = case.reload_bundle()\n            with self.assertRaisesRegex(V4.PowerV4Error, \"receipt subject drift\"):\n                V4.preflight_calibration(case.calibration, bundle)\n\n        with CalibrationCase() as case:\n            population = copy.deepcopy(case.population)\n            ledger = copy.deepcopy(case.ledger)\n            calibration_member = next(\n                member\n                for member in population[\"members\"]\n                if member[\"membership\"] == \"development_calibration\"\n            )\n            old_ref = calibration_member[\"member_ref\"]\n            new_ref = digest(\"replacement-selected-member-ref\")\n            calibration_member[\"member_ref\"] = new_ref\n            ledger_review = next(\n                row for row in ledger[\"reviews\"] if row[\"member_ref\"] == old_ref\n            )\n            ledger_review[\"member_ref\"] = new_ref\n            assert_subject_rejects(case, population, ledger)\n\n        with CalibrationCase() as case:\n            population = copy.deepcopy(case.population)\n            ledger = copy.deepcopy(case.ledger)\n            optimization = next(\n                member\n                for member in population[\"members\"]\n                if member[\"membership\"] == \"development_optimization\"\n                and member[\"contamination_state\"] != \"excluded\"\n            )\n            calibration_member = next(\n                member\n                for member in population[\"members\"]\n                if member[\"membership\"] == \"development_calibration\"\n            )\n            optimization[\"membership\"] = \"development_calibration\"\n            calibration_member[\"membership\"] = \"development_optimization\"\n            assert_subject_rejects(case, population, ledger)\n\n        with CalibrationCase() as case:\n            population = copy.deepcopy(case.population)\n            ledger = copy.deepcopy(case.ledger)\n            calibration_member = next(\n                member\n                for member in population[\"members\"]\n                if member[\"membership\"] == \"development_calibration\"\n            )\n            calibration_member[\"task_overlap_commitment_sha256\"] = digest(\n                \"changed-overlap-output\"\n            )\n            assert_subject_rejects(case, population, ledger)\n\n    def test_actual_artifact_schemas_reject_extra_fields_dates_and_oneof_drift(self) -> None:\n        with CalibrationCase() as case:\n            calibration = copy.deepcopy(case.calibration)\n            calibration[\"unexpected\"] = True\n            reseal_calibration(calibration)\n            with self.assertRaisesRegex(V4.PowerV4Error, \"additional property\"):\n                V4.preflight_calibration(calibration, case.bundle)\n\n        with CalibrationCase() as case:\n            receipt = json.loads(case.paths[\"selection\"].read_text())\n            receipt[\"verified_at\"] = \"not-a-date\"\n            sealed(receipt)\n            case.write(\"selection\", receipt)\n            with self.assertRaisesRegex(V4.PowerV4Error, \"RFC3339\"):\n                case.reload_bundle()\n\n        with CalibrationCase() as case:\n            population = copy.deepcopy(case.population)\n            holdout = next(\n                member\n                for member in population[\"members\"]\n                if member[\"membership\"] == \"confirmatory_holdout\"\n            )\n            holdout[\"attributes\"] = attributes(\"forbidden-holdout-plaintext\")\n            case.write(\"population\", population)\n            with self.assertRaises(V4.PowerV4Error):\n                case.reload_bundle()\n\n    def test_duplicate_product_task_hashes_and_related_tasks_do_not_count_as_independent(self) -> None:\n        with self.assertRaisesRegex(V4.PowerV4Error, \"task hashes must be unique\"):\n            CalibrationCase(duplicate_task_hash=True)\n        with self.assertRaisesRegex(\n            V4.PowerV4Error, \"at least 12 derived|one mutually independent\"\n        ):\n            CalibrationCase(related_calibration_pair=True)\n        with self.assertRaisesRegex(\n            V4.PowerV4Error, \"at least 12 derived|one mutually independent\"\n        ):\n            CalibrationCase(shared_fix_pair=True)\n        with self.assertRaisesRegex(\n            V4.PowerV4Error, \"at least 12 derived|one mutually independent\"\n        ):\n            CalibrationCase(shared_session_pair=True)\n        with self.assertRaisesRegex(\n            V4.PowerV4Error, \"at least 12 derived|one mutually independent\"\n        ):\n            CalibrationCase(excluded_bridge=True)\n\n    def test_execution_provider_cli_model_and_timeout_attestations_require_cell_parity(self) -> None:\n        mutations = {\n            \"provider_id\": \"other-provider\",\n            \"agent_cli_id\": \"other-cli\",\n            \"agent_cli_version\": \"other-cli-version\",\n            \"requested_model_id\": \"other-requested-model\",\n            \"resolved_model_id\": \"other-model\",\n            \"timeout_policy_sha256\": digest(\"other-timeout-policy\"),\n            \"agent_timeout_limit_seconds\": 901,\n            \"timeout_component_limit_seconds\": 60,\n        }\n        with CalibrationCase() as case:\n            for field, replacement in mutations.items():\n                with self.subTest(field=field):\n                    calibration = copy.deepcopy(case.calibration)\n                    calibration[\"execution_attestations\"][0][field] = replacement\n                    sealed(calibration[\"execution_attestations\"][0])\n                    reseal_calibration(calibration)\n                    with self.assertRaisesRegex(V4.PowerV4Error, \"drift\"):\n                        V4.preflight_calibration(calibration, case.bundle)\n\n    def test_analyzer_and_every_schema_are_bound_by_dedicated_v4_lock(self) -> None:\n        with CalibrationCase() as case:\n            expected = V4._expected_implementation_lock(case.bundle)\n            self.assertEqual(\n                case.calibration[\"v4_implementation_lock\"], expected\n            )\n            calibration = copy.deepcopy(case.calibration)\n            calibration[\"v4_implementation_lock\"][\n                \"analyzer_file_sha256\"\n            ] = digest(\"different-analyzer\")\n            reseal_calibration(calibration, \"v4_implementation_lock\")\n            with self.assertRaisesRegex(\n                V4.PowerV4Error, \"v4 implementation lock drift\"\n            ):\n                V4.preflight_calibration(calibration, case.bundle)\n\n    def test_natural_cost_estimand_supports_zero_numerators_and_zero_denominator_draws(self) -> None:\n        vectors = [\n            {\n                \"independence_cluster_sha256\": digest(\"cluster-zero\"),\n                \"task_ids\": [\"zero\"],\n                \"task_weight\": 1,\n                \"elapsed_log_ratio\": math.log(0.8),\n                \"cost_numerator_mean\": 0.2,\n                \"cost_denominator_mean\": 0.0,\n                \"quality_difference\": 0.2,\n            },\n            {\n                \"independence_cluster_sha256\": digest(\"cluster-positive\"),\n                \"task_ids\": [\"positive\"],\n                \"task_weight\": 1,\n                \"elapsed_log_ratio\": math.log(0.8),\n                \"cost_numerator_mean\": 0.4,\n                \"cost_denominator_mean\": 1.0,\n                \"quality_difference\": 0.2,\n            },\n        ]\n        draws = [(0,), (1,)]\n        statistics, parameters = V4._draw_statistics(\n            vectors, draws, alternative=None\n        )\n        self.assertIsNone(statistics[0][\"normalized_cost\"])\n        self.assertEqual(statistics[1][\"normalized_cost\"], 0.4)\n        self.assertAlmostEqual(\n            parameters[\"cost_numerator_mean\"]\n            / parameters[\"cost_denominator_mean\"],\n            0.6,\n        )\n        _, zero_draws = V4._ci_offsets(vectors, draws)\n        self.assertEqual(zero_draws, 1)\n        power = V4._power_for_contrast(\n            vectors,\n            FIX.alternatives()[\"primary\"],\n            draws,\n            task_clusters=1,\n            resampling_sha256=digest(\"resampling\"),\n        )\n        self.assertEqual(power[\"zero_denominator_draws\"], 1)\n        self.assertEqual(\n            power[\"zero_denominator_resample_policy\"],\n            \"automatic_cost_and_joint_failure_excluded_from_ci_quantile_v1\",\n        )\n        self.assertLessEqual(\n            power[\"joint_all_endpoint_power\"],\n            power[\"marginal_power\"][\"normalized_cost\"],\n        )\n\n    def test_frozen_equal_task_estimands_remain_unchanged(self) -> None:\n        with CalibrationCase(homogeneous=False) as case:\n            report = V4.analyze_calibration(case.calibration, case.bundle)\n            primary = report[\"calibration_estimates\"][\"primary\"]\n            self.assertAlmostEqual(\n                primary[\"elapsed_time\"][\"paired_task_geometric_mean_ratio\"],\n                math.sqrt(0.4 * 0.8),\n                places=11,\n            )\n            self.assertAlmostEqual(\n                primary[\"normalized_cost\"][\"equal_task_weighted_mean_ratio\"],\n                82.0 / 110.0,\n                places=11,\n            )\n            self.assertFalse(\n                primary[\"normalized_cost\"][\"geometric_mean_task_ratios_used\"]\n            )\n            self.assertAlmostEqual(\n                primary[\"code_quality\"][\"paired_task_mean_difference\"],\n                0.30,\n                places=11,\n            )\n\n    def test_structural_zero_treatment_costs_are_supported_without_logs(self) -> None:\n        with CalibrationCase(structural_zero=True) as case:\n            report = V4.analyze_calibration(case.calibration, case.bundle)\n            for key in (\"primary\", \"product_diagnostic\"):\n                cost = report[\"calibration_estimates\"][key][\"normalized_cost\"]\n                self.assertEqual(cost[\"equal_task_weighted_mean_ratio\"], 0.0)\n                self.assertTrue(cost[\"structural_zero_treatment_cost_supported\"])\n                self.assertFalse(cost[\"geometric_mean_task_ratios_used\"])\n\n    def test_report_schema_and_recomputation_reject_auditor_mutations(self) -> None:\n        with CalibrationCase() as case:\n            report = V4.analyze_calibration(case.calibration, case.bundle)\n            mutations = []\n            extra = copy.deepcopy(report)\n            extra[\"unexpected\"] = True\n            reseal_report(extra)\n            mutations.append(extra)\n            passed = copy.deepcopy(report)\n            passed[\"benchmark_power_decision\"][\"passed\"] = True\n            reseal_report(passed)\n            mutations.append(passed)\n            lock = copy.deepcopy(report)\n            lock[\"integrity\"][\"v4_implementation_lock_sha256\"] = digest(\n                \"other-v4-lock\"\n            )\n            reseal_report(lock)\n            mutations.append(lock)\n            probability = copy.deepcopy(report)\n            probability[\"power_candidates\"][0][\"primary\"][\"marginal_power\"][\n                \"elapsed_time\"\n            ] = 1.1\n            reseal_report(probability)\n            mutations.append(probability)\n            for mutation in mutations:\n                with self.assertRaises(V4.PowerV4Error):\n                    V4.validate_power_report(mutation, case.bundle)\n\n            recomputation = copy.deepcopy(report)\n            recomputation[\"power_candidates\"][0][\"primary\"][\"marginal_power\"][\n                \"elapsed_time\"\n            ] = 0.99\n            reseal_report(recomputation)\n            V4.validate_power_report(recomputation, case.bundle)\n            with self.assertRaisesRegex(V4.PowerV4Error, \"recomputation\"):\n                V4.check_power_report(\n                    case.calibration, recomputation, case.bundle\n                )\n\n    def test_strict_loader_rejects_duplicate_keys_and_non_json_numbers(self) -> None:\n        with tempfile.TemporaryDirectory() as temporary:\n            duplicate = pathlib.Path(temporary) / \"duplicate.json\"\n            duplicate.write_text('{\"schema\":\"a\",\"schema\":\"b\"}', encoding=\"utf-8\")\n            with self.assertRaisesRegex(V4.PowerV4Error, \"duplicate object key\"):\n                V4.load_calibration(duplicate)\n            for constant in (\"NaN\", \"Infinity\", \"-Infinity\"):\n                path = pathlib.Path(temporary) / f\"{constant}.json\"\n                path.write_text('{\"value\":' + constant + \"}\", encoding=\"utf-8\")\n                with self.assertRaisesRegex(V4.PowerV4Error, \"non-JSON numeric\"):\n                    V4.load_calibration(path)\n\n    def test_draft_2020_12_validator_audits_dormant_branches_and_numeric_uniqueness(self) -> None:\n        dialect = \"https://json-schema.org/draft/2020-12/schema\"\n        with self.assertRaisesRegex(DRAFT.SchemaError, \"unsupported schema\"):\n            DRAFT.Validator(\n                [\n                    DRAFT.SchemaDocument(\n                        \"bad.json\",\n                        {\n                            \"$schema\": dialect,\n                            \"type\": \"object\",\n                            \"$defs\": {\"dormant\": {\"madeUpAssertion\": True}},\n                        },\n                    )\n                ]\n            )\n        validator = DRAFT.Validator(\n            [\n                DRAFT.SchemaDocument(\n                    \"unique.json\",\n                    {\n                        \"$schema\": dialect,\n                        \"type\": \"array\",\n                        \"uniqueItems\": True,\n                    },\n                )\n            ]\n        )\n        with self.assertRaisesRegex(DRAFT.SchemaError, \"uniqueItems\"):\n            validator.validate([1, 1.0], \"unique.json\", label=\"numeric array\")\n\n        registry = DRAFT.Validator(\n            [\n                DRAFT.SchemaDocument(\n                    \"leaf.json\",\n                    {\n                        \"$schema\": dialect,\n                        \"$id\": \"https://example.test/leaf.json\",\n                        \"type\": \"string\",\n                        \"pattern\": \"^ok$\",\n                    },\n                ),\n                DRAFT.SchemaDocument(\n                    \"root.json\",\n                    {\n                        \"$schema\": dialect,\n                        \"type\": \"object\",\n                        \"required\": [\"value\"],\n                        \"properties\": {\n                            \"value\": {\"$ref\": \"leaf.json\"}\n                        },\n                        \"additionalProperties\": False,\n                    },\n                ),\n            ]\n        )\n        registry.validate({\"value\": \"ok\"}, \"root.json\", label=\"cross ref\")\n        with self.assertRaises(DRAFT.SchemaError):\n            registry.validate(\n                {\"value\": \"no\", \"extra\": True}, \"root.json\", label=\"cross ref\"\n            )\n\n    def test_shared_resampling_is_exact_and_joint_is_same_draw_frequency(self) -> None:\n        first, first_sha = V4.shared_cluster_resamples(\n            source_clusters=12, target_clusters=24, resamples=100, seed=41\n        )\n        second, second_sha = V4.shared_cluster_resamples(\n            source_clusters=12, target_clusters=24, resamples=100, seed=41\n        )\n        changed, changed_sha = V4.shared_cluster_resamples(\n            source_clusters=12, target_clusters=24, resamples=100, seed=42\n        )\n        self.assertEqual(first, second)\n        self.assertEqual(first_sha, second_sha)\n        self.assertNotEqual(first, changed)\n        self.assertNotEqual(first_sha, changed_sha)\n        with CalibrationCase() as case:\n            report = V4.analyze_calibration(case.calibration, case.bundle)\n            for row in report[\"power_candidates\"]:\n                self.assertEqual(\n                    row[\"primary\"][\"shared_resampling_sha256\"],\n                    row[\"product_diagnostic\"][\"shared_resampling_sha256\"],\n                )\n                for key in (\"primary\", \"product_diagnostic\"):\n                    result = row[key]\n                    self.assertLessEqual(\n                        result[\"joint_all_endpoint_power\"],\n                        min(result[\"marginal_power\"].values()),\n                    )\n                    self.assertFalse(result[\"independence_shortcut_used\"])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"},"started_at_ms":1789839642555,"completed_at_ms":1789839642555}}
{"timestamp":"2026-09-19T17:40:42.575Z","ordinal":7585,"type":"token_usage_record","payload":{"thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","session_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","root_turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","response_id":"resp_0cb48b2b18d09e75016aaec917059c87d2a251dd63a57cc716","usage":{"input_tokens":174981,"cached_input_tokens":169984,"cache_write_input_tokens":0,"output_tokens":53,"reasoning_output_tokens":0,"total_tokens":175034},"turn_token_usage":{"input_tokens":74012685,"cached_input_tokens":70822528,"cache_write_input_tokens":0,"output_tokens":172236,"reasoning_output_tokens":14615,"total_tokens":74184921},"thread_token_usage":{"input_tokens":139897704,"cached_input_tokens":133394560,"cache_write_input_tokens":0,"output_tokens":357035,"reasoning_output_tokens":35992,"total_tokens":140254739}}}
{"timestamp":"2026-09-19T17:40:42.612Z","ordinal":7586,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0bac1-8ff4-7fd3-ae5a-d8fe36d3ebac","call_id":"call_FkNmzY3e2r8WXsfeebnNO1Xd","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"0c6660\",\"wall_time_seconds\":0.000003042,\"exit_code\":0,\"original_token_count\":4121,\"output\":\"\\n    def test_population_receipts_bind_selection_assignment_and_overlap_outputs(self) -> None:\\n        def assert_subject_rejects(\\n            case: CalibrationCase, population: dict, ledger: dict\\n        ) -> None:\\n            sealed_ledger = TASK.seal_review_ledger(ledger)\\n            sealed_population = TASK.seal_population(population, sealed_ledger)\\n            case.write(\\\"ledger\\\", sealed_ledger)\\n            case.write(\\\"population\\\", sealed_population)\\n            bundle = case.reload_bundle()\\n            with self.assertRaisesRegex(V4.PowerV4Error, \\\"receipt subject drift\\\"):\\n                V4.preflight_calibration(case.calibration, bundle)\\n\\n        with CalibrationCase() as case:\\n            population = copy.deepcopy(case.population)\\n            ledger = copy.deepcopy(case.ledger)\\n            calibration_member = next(\\n                member\\n                for member in population[\\\"members\\\"]\\n                if member[\\\"membership\\\"] == \\\"development_calibration\\\"\\n            )\\n            old_ref = calibration_member[\\\"member_ref\\\"]\\n            new_ref = digest(\\\"replacement-selected-member-ref\\\")\\n            calibration_member[\\\"member_ref\\\"] = new_ref\\n            ledger_review = next(\\n                row for row in ledger[\\\"reviews\\\"] if row[\\\"member_ref\\\"] == old_ref\\n            )\\n            ledger_review[\\\"member_ref\\\"] = new_ref\\n            assert_subject_rejects(case, population, ledger)\\n\\n        with CalibrationCase() as case:\\n            population = copy.deepcopy(case.population)\\n            ledger = copy.deepcopy(case.ledger)\\n            optimization = next(\\n                member\\n                for member in population[\\\"members\\\"]\\n                if member[\\\"membership\\\"] == \\\"development_optimization\\\"\\n                and member[\\\"contamination_state\\\"] != \\\"excluded\\\"\\n            )\\n            calibration_member = next(\\n                member\\n                for member in population[\\\"members\\\"]\\n                if member[\\\"membership\\\"] == \\\"development_calibration\\\"\\n            )\\n            optimization[\\\"membership\\\"] = \\\"development_calibration\\\"\\n            calibration_member[\\\"membership\\\"] = \\\"development_optimization\\\"\\n            assert_subject_rejects(case, population, ledger)\\n\\n        with CalibrationCase() as case:\\n            population = copy.deepcopy(case.population)\\n            ledger = copy.deepcopy(case.ledger)\\n            calibration_member = next(\\n                member\\n                for member in population[\\\"members\\\"]\\n                if member[\\\"membership\\\"] == \\\"development_calibration\\\"\\n            )\\n            calibration_member[\\\"task_overlap_commitment_sha256\\\"] = digest(\\n                \\\"changed-overlap-output\\\"\\n            )\\n            assert_subject_rejects(case, population, ledger)\\n\\n    def test_actual_artifact_schemas_reject_extra_fields_dates_and_oneof_drift(self) -> None:\\n        with CalibrationCase() as case:\\n            calibration = copy.deepcopy(case.calibration)\\n            calibration[\\\"unexpected\\\"] = True\\n            reseal_calibration(calibration)\\n            with self.assertRaisesRegex(V4.PowerV4Error, \\\"additional property\\\"):\\n                V4.preflight_calibration(calibration, case.bundle)\\n\\n        with CalibrationCase() as case:\\n            receipt = json.loads(case.paths[\\\"selection\\\"].read_text())\\n            receipt[\\\"verified_at\\\"] = \\\"not-a-date\\\"\\n            sealed(receipt)\\n            case.write(\\\"selection\\\", receipt)\\n            with self.assertRaisesRegex(V4.PowerV4Error, \\\"RFC3339\\\"):\\n                case.reload_bundle()\\n\\n        with CalibrationCase() as case:\\n            population = copy.deepcopy(case.population)\\n            holdout = next(\\n                member\\n                for member in population[\\\"members\\\"]\\n                if member[\\\"membership\\\"] == \\\"confirmatory_holdout\\\"\\n            )\\n            holdout[\\\"attributes\\\"] = attributes(\\\"forbidden-holdout-plaintext\\\")\\n            case.write(\\\"population\\\", population)\\n            with self.assertRaises(V4.PowerV4Error):\\n                case.reload_bundle()\\n\\n    def test_duplicate_product_task_hashes_and_related_tasks_do_not_count_as_independent(self) -> None:\\n        with self.assertRaisesRegex(V4.PowerV4Error, \\\"task hashes must be unique\\\"):\\n            CalibrationCase(duplicate_task_hash=True)\\n        with self.assertRaisesRegex(\\n            V4.PowerV4Error, \\\"at least 12 derived|one mutually independent\\\"\\n        ):\\n            CalibrationCase(related_calibration_pair=True)\\n        with self.assertRaisesRegex(\\n            V4.PowerV4Error, \\\"at least 12 derived|one mutually independent\\\"\\n        ):\\n            CalibrationCase(shared_fix_pair=True)\\n        with self.assertRaisesRegex(\\n            V4.PowerV4Error, \\\"at least 12 derived|one mutually independent\\\"\\n        ):\\n            CalibrationCase(shared_session_pair=True)\\n        with self.assertRaisesRegex(\\n            V4.PowerV4Error, \\\"at least 12 derived|one mutually independent\\\"\\n        ):\\n            CalibrationCase(excluded_bridge=True)\\n\\n    def test_execution_provider_cli_model_and_timeout_attestations_require_cell_parity(self) -> None:\\n        mutations = {\\n            \\\"provider_id\\\": \\\"other-provider\\\",\\n            \\\"agent_cli_id\\\": \\\"other-cli\\\",\\n            \\\"agent_cli_version\\\": \\\"other-cli-version\\\",\\n            \\\"requested_model_id\\\": \\\"other-requested-model\\\",\\n            \\\"resolved_model_id\\\": \\\"other-model\\\",\\n            \\\"timeout_policy_sha256\\\": digest(\\\"other-timeout-policy\\\"),\\n            \\\"agent_timeout_limit_seconds\\\": 901,\\n            \\\"timeout_component_limit_seconds\\\": 60,\\n        }\\n        with CalibrationCase() as case:\\n            for field, replacement in mutations.items():\\n                with self.subTest(field=field):\\n                    calibration = copy.deepcopy(case.calibration)\\n                    calibration[\\\"execution_attestations\\\"][0][field] = replacement\\n                    sealed(calibration[\\\"execution_attestations\\\"][0])\\n                    reseal_calibration(calibration)\\n                    with self.assertRaisesRegex(V4.PowerV4Error, \\\"drift\\\"):\\n                        V4.preflight_calibration(calibration, case.bundle)\\n\\n    def test_analyzer_and_every_schema_are_bound_by_dedicated_v4_lock(self) -> None:\\n        with CalibrationCase() as case:\\n            expected = V4._expected_implementation_lock(case.bundle)\\n            self.assertEqual(\\n                case.calibration[\\\"v4_implementation_lock\\\"], expected\\n            )\\n            calibration = copy.deepcopy(case.calibration)\\n            calibration[\\\"v4_implementation_lock\\\"][\\n                \\\"analyzer_file_sha256\\\"\\n            ] = digest(\\\"different-analyzer\\\")\\n            reseal_calibration(calibration, \\\"v4_implementation_lock\\\")\\n            with self.assertRaisesRegex(\\n                V4.PowerV4Error, \\\"v4 implementation lock drift\\\"\\n            ):\\n                V4.preflight_calibration(calibration, case.bundle)\\n\\n    def test_natural_cost_estimand_supports_zero_numerators_and_zero_denominator_draws(self) -> None:\\n        vectors = [\\n            {\\n                \\\"independence_cluster_sha256\\\": digest(\\\"cluster-zero\\\"),\\n                \\\"task_ids\\\": [\\\"zero\\\"],\\n                \\\"task_weight\\\": 1,\\n                \\\"elapsed_log_ratio\\\": math.log(0.8),\\n                \\\"cost_numerator_mean\\\": 0.2,\\n                \\\"cost_denominator_mean\\\": 0.0,\\n                \\\"quality_difference\\\": 0.2,\\n            },\\n            {\\n                \\\"independence_cluster_sha256\\\": digest(\\\"cluster-positive\\\"),\\n                \\\"task_ids\\\": [\\\"positive\\\"],\\n                \\\"task_weight\\\": 1,\\n                \\\"elapsed_log_ratio\\\": math.log(0.8),\\n                \\\"cost_numerator_mean\\\": 0.4,\\n                \\\"cost_denominator_mean\\\": 1.0,\\n                \\\"quality_difference\\\": 0.2,\\n            },\\n        ]\\n        draws = [(0,), (1,)]\\n        statistics, parameters = V4._draw_statistics(\\n            vectors, draws, alternative=None\\n        )\\n        self.assertIsNone(statistics[0][\\\"normalized_cost\\\"])\\n        self.assertEqual(statistics[1][\\\"normalized_cost\\\"], 0.4)\\n        self.assertAlmostEqual(\\n            parameters[\\\"cost_numerator_mean\\\"]\\n            / parameters[\\\"cost_denominator_mean\\\"],\\n            0.6,\\n        )\\n        _, zero_draws = V4._ci_offsets(vectors, draws)\\n        self.assertEqual(zero_draws, 1)\\n        power = V4._power_for_contrast(\\n            vectors,\\n            FIX.alternatives()[\\\"primary\\\"],\\n            draws,\\n            task_clusters=1,\\n            resampling_sha256=digest(\\\"resampling\\\"),\\n        )\\n        self.assertEqual(power[\\\"zero_denominator_draws\\\"], 1)\\n        self.assertEqual(\\n            power[\\\"zero_denominator_resample_policy\\\"],\\n            \\\"automatic_cost_and_joint_failure_excluded_from_ci_quantile_v1\\\",\\n        )\\n        self.assertLessEqual(\\n            power[\\\"joint_all_endpoint_power\\\"],\\n            power[\\\"marginal_power\\\"][\\\"normalized_cost\\\"],\\n        )\\n\\n    def test_frozen_equal_task_estimands_remain_unchanged(self) -> None:\\n        with CalibrationCase(homogeneous=False) as case:\\n            report = V4.analyze_calibration(case.calibration, case.bundle)\\n            primary = report[\\\"calibration_estimates\\\"][\\\"primary\\\"]\\n            self.assertAlmostEqual(\\n                primary[\\\"elapsed_time\\\"][\\\"paired_task_geometric_mean_ratio\\\"],\\n                math.sqrt(0.4 * 0.8),\\n                places=11,\\n            )\\n            self.assertAlmostEqual(\\n                primary[\\\"normalized_cost\\\"][\\\"equal_task_weighted_mean_ratio\\\"],\\n                82.0 / 110.0,\\n                places=11,\\n            )\\n            self.assertFalse(\\n                primary[\\\"normalized_cost\\\"][\\\"geometric_mean_task_ratios_used\\\"]\\n            )\\n            self.assertAlmostEqual(\\n                primary[\\\"code_quality\\\"][\\\"paired_task_mean_difference\\\"],\\n                0.30,\\n                places=11,\\n            )\\n\\n    def test_structural_zero_treatment_costs_are_supported_without_logs(self) -> None:\\n        with CalibrationCase(structural_zero=True) as case:\\n            report = V4.analyze_calibration(case.calibration, case.bundle)\\n            for key in (\\\"primary\\\", \\\"product_diagnostic\\\"):\\n                cost = report[\\\"calibration_estimates\\\"][key][\\\"normalized_cost\\\"]\\n                self.assertEqual(cost[\\\"equal_task_weighted_mean_ratio\\\"], 0.0)\\n                self.assertTrue(cost[\\\"structural_zero_treatment_cost_supported\\\"])\\n                self.assertFalse(cost[\\\"geometric_mean_task_ratios_used\\\"])\\n\\n    def test_report_schema_and_recomputation_reject_auditor_mutations(self) -> None:\\n        with CalibrationCase() as case:\\n            report = V4.analyze_calibration(case.calibration, case.bundle)\\n            mutations = []\\n            extra = copy.deepcopy(report)\\n            extra[\\\"unexpected\\\"] = True\\n            reseal_report(extra)\\n            mutations.append(extra)\\n            passed = copy.deepcopy(report)\\n            passed[\\\"benchmark_power_decision\\\"][\\\"passed\\\"] = True\\n            reseal_report(passed)\\n            mutations.append(passed)\\n            lock = copy.deepcopy(report)\\n            lock[\\\"integrity\\\"][\\\"v4_implementation_lock_sha256\\\"] = digest(\\n                \\\"other-v4-lock\\\"\\n            )\\n            reseal_report(lock)\\n            mutations.append(lock)\\n            probability = copy.deepcopy(report)\\n            probability[\\\"power_candidates\\\"][0][\\\"primary\\\"][\\\"marginal_power\\\"][\\n                \\\"elapsed_time\\\"\\n            ] = 1.1\\n            reseal_report(probability)\\n            mutations.append(probability)\\n            for mutation in mutations:\\n                with self.assertRaises(V4.PowerV4Error):\\n                    V4.validate_power_report(mutation, case.bundle)\\n\\n            recomputation = copy.deepcopy(report)\\n            recomputation[\\\"power_candidates\\\"][0][\\\"primary\\\"][\\\"marginal_power\\\"][\\n                \\\"elapsed_time\\\"\\n            ] = 0.99\\n            reseal_report(recomputation)\\n            V4.validate_power_report(recomputation, case.bundle)\\n            with self.assertRaisesRegex(V4.PowerV4Error, \\\"recomputation\\\"):\\n                V4.check_power_report(\\n                    case.calibration, recomputation, case.bundle\\n                )\\n\\n    def test_strict_loader_rejects_duplicate_keys_and_non_json_numbers(self) -> None:\\n        with tempfile.TemporaryDirectory() as temporary:\\n            duplicate = pathlib.Path(temporary) / \\\"duplicate.json\\\"\\n            duplicate.write_text('{\\\"schema\\\":\\\"a\\\",\\\"schema\\\":\\\"b\\\"}', encoding=\\\"utf-8\\\")\\n            with self.assertRaisesRegex(V4.PowerV4Error, \\\"duplicate object key\\\"):\\n                V4.load_calibration(duplicate)\\n            for constant in (\\\"NaN\\\", \\\"Infinity\\\", \\\"-Infinity\\\"):\\n                path = pathlib.Path(temporary) / f\\\"{constant}.json\\\"\\n                path.write_text('{\\\"value\\\":' + constant + \\\"}\\\", encoding=\\\"utf-8\\\")\\n                with self.assertRaisesRegex(V4.PowerV4Error, \\\"non-JSON numeric\\\"):\\n                    V4.load_calibration(path)\\n\\n    def test_draft_2020_12_validator_audits_dormant_branches_and_numeric_uniqueness(self) -> None:\\n        dialect = \\\"https://json-schema.org/draft/2020-12/schema\\\"\\n        with self.assertRaisesRegex(DRAFT.SchemaError, \\\"unsupported schema\\\"):\\n            DRAFT.Validator(\\n                [\\n                    DRAFT.SchemaDocument(\\n                        \\\"bad.json\\\",\\n                        {\\n                            \\\"$schema\\\": dialect,\\n                            \\\"type\\\": \\\"object\\\",\\n                            \\\"$defs\\\": {\\\"dormant\\\": {\\\"madeUpAssertion\\\": True}},\\n                        },\\n                    )\\n                ]\\n            )\\n        validator = DRAFT.Validator(\\n            [\\n                DRAFT.SchemaDocument(\\n                    \\\"unique.json\\\",\\n                    {\\n                        \\\"$schema\\\": dialect,\\n                        \\\"type\\\": \\\"array\\\",\\n                        \\\"uniqueItems\\\": True,\\n                    },\\n                )\\n            ]\\n        )\\n        with self.assertRaisesRegex(DRAFT.SchemaError, \\\"uniqueItems\\\"):\\n            validator.validate([1, 1.0], \\\"unique.json\\\", label=\\\"numeric array\\\")\\n\\n        registry = DRAFT.Validator(\\n            [\\n                DRAFT.SchemaDocument(\\n                    \\\"leaf.json\\\",\\n                    {\\n                        \\\"$schema\\\": dialect,\\n                        \\\"$id\\\": \\\"https://example.test/leaf.json\\\",\\n                        \\\"type\\\": \\\"string\\\",\\n                        \\\"pattern\\\": \\\"^ok$\\\",\\n                    },\\n                ),\\n                DRAFT.SchemaDocument(\\n                    \\\"root.json\\\",\\n                    {\\n                        \\\"$schema\\\": dialect,\\n                        \\\"type\\\": \\\"object\\\",\\n                        \\\"required\\\": [\\\"value\\\"],\\n                        \\\"properties\\\": {\\n                            \\\"value\\\": {\\\"$ref\\\": \\\"leaf.json\\\"}\\n                        },\\n                        \\\"additionalProperties\\\": False,\\n                    },\\n                ),\\n            ]\\n        )\\n        registry.validate({\\\"value\\\": \\\"ok\\\"}, \\\"root.json\\\", label=\\\"cross ref\\\")\\n        with self.assertRaises(DRAFT.SchemaError):\\n            registry.validate(\\n                {\\\"value\\\": \\\"no\\\", \\\"extra\\\": True}, \\\"root.json\\\", label=\\\"cross ref\\\"\\n            )\\n\\n    def test_shared_resampling_is_exact_and_joint_is_same_draw_frequency(self) -> None:\\n        first, first_sha = V4.shared_cluster_resamples(\\n            source_clusters=12, target_clusters=24, resamples=100, seed=41\\n        )\\n        second, second_sha = V4.shared_cluster_resamples(\\n            source_clusters=12, target_clusters=24, resamples=100, seed=41\\n        )\\n        changed, changed_sha = V4.shared_cluster_resamples(\\n            source_clusters=12, target_clusters=24, resamples=100, seed=42\\n        )\\n        self.assertEqual(first, second)\\n        self.assertEqual(first_sha, second_sha)\\n        self.assertNotEqual(first, changed)\\n        self.assertNotEqual(first_sha, changed_sha)\\n        with CalibrationCase() as case:\\n            report = V4.analyze_calibration(case.calibration, case.bundle)\\n            for row in report[\\\"power_candidates\\\"]:\\n                self.assertEqual(\\n                    row[\\\"primary\\\"][\\\"shared_resampling_sha256\\\"],\\n                    row[\\\"product_diagnostic\\\"][\\\"shared_resampling_sha256\\\"],\\n                )\\n                for key in (\\\"primary\\\", \\\"product_diagnostic\\\"):\\n                    result = row[key]\\n                    self.assertLessEqual(\\n                        result[\\\"joint_all_endpoint_power\\\"],\\n                        min(result[\\\"marginal_power\\\"].values()),\\n                    )\\n                    self.assertFalse(result[\\\"independence_shortcut_used\\\"])\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    unittest.main()\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839642.612289}}}
