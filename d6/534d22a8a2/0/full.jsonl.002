 validHistoryGenerationArtifactPath(rel, fileName string) bool', 'signals': ['body', 'symbol-name', 'graph:callers', 'complete-symbol'], 'snippet': 'func validHistoryGenerationArtifactPath(rel, fileName string) bool {\\n\\tparts := strings.Split(rel, \"/\")\\n\\tif len(parts) != 4 || parts[0] != historyDirName || parts[1] != \"generations\" || parts[3] != fileName || len(parts[2]) != 40 {\\n\\t\\treturn false\\n\\t}\\n\\t_, err := hex.DecodeString(parts[2])\\n\\treturn err == nil\\n}'}, {'rank': 5, 'score': 21.1773, 'file_path': 'internal/cli/session_privacy.go', 'start_line': 1380, 'end_line': 1459, 'focus_line': 1380, 'snippet_start_line': 1380, 'snippet_end_line': 1385, 'symbol_start_line': 1380, 'symbol_end_line': 1558, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/session_privacy.go:function:privacyDerivedStoreArtifacts', 'symbol_name': 'privacyDerivedStoreArtifacts', 'qualified_name': 'privacyDerivedStoreArtifacts', 'signature': 'func privacyDerivedStoreArtifacts(brainDir string) ([]string, error)', 'signals': ['graph:calls', 'graph:incoming', 'graph:callers'], 'snippet': 'func privacyDerivedStoreArtifacts(brainDir string) ([]string, error) {\\n\\trels := privacyDerivedStoreRels()\\n\\tpublication, _, publicationPresent, err := loadPatternCorpusPublicationForPrivacy(brainDir)\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}'}, {'rank': 6, 'score': 21.1719, 'file_path': 'internal/cli/semantic_graph.go', 'start_line': 166, 'end_line': 216, 'focus_line': 214, 'snippet_start_line': 213, 'snippet_end_line': 214, 'symbol_start_line': 166, 'symbol_end_line': 216, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/semantic_graph.go:function:runSemanticGraphSchema', 'symbol_name': 'runSemanticGraphSchema', 'qualified_name': 'runSemanticGraphSchema', 'signature': 'func runSemanticGraphSchema(cmd *cobra.Command, opts Options, graphOpts semanticGraphSchemaOptions) error', 'signals': ['body', 'symbol-name', 'graph:callers'], 'snippet': '\\tfmt.Fprintf(cmd.OutOrStdout(), \"hotspots: %s\\\\n\", graphRanksText(report.Metrics.Hotspots))\\n\\tfmt.Fprintf(cmd.OutOrStdout(), \"entry_points: %s\\\\n\", graphRanksText(report.Metrics.EntryPoints))'}, {'rank': 7, 'score': 20.5805, 'file_path': 'benchmarks/agent-brain/confirmatory/schemas/negative-control-cache-bundle-verifier-contract-v2.schema.json', 'start_line': 74, 'end_line': 74, 'focus_line': 74, 'snippet_start_line': 74, 'snippet_end_line': 74, 'symbol_start_line': 74, 'symbol_end_line': 74, 'language': 'JSON', 'kind': 'section', 'symbol_id': 'gh/entireio/entire-brain:JSON:benchmarks/agent-brain/confirmatory/schemas/negative-control-cache-bundle-verifier-contract-v2.schema.json:section:format_artifact', 'symbol_name': 'format_artifact', 'qualified_name': 'format_artifact', 'signature': 'json key format_artifact', 'signals': ['path', 'body', 'symbol-name'], 'snippet': '        \"format_artifact\": {'}, {'rank': 8, 'score': 20.5564, 'file_path': 'benchmarks/agent-brain/confirmatory/schemas/negative-control-cache-bundle-verification-report-v2.schema.json', 'start_line': 50, 'end_line': 50, 'focus_line': 50, 'snippet_start_line': 50, 'snippet_end_line': 50, 'symbol_start_line': 50, 'symbol_end_line': 50, 'language': 'JSON', 'kind': 'section', 'symbol_id': 'gh/entireio/entire-brain:JSON:benchmarks/agent-brain/confirmatory/schemas/negative-control-cache-bundle-verification-report-v2.schema.json:section:format_artifact_sha256', 'symbol_name': 'format_artifact_sha256', 'qualified_name': 'format_artifact_sha256', 'signature': 'json key format_artifact_sha256', 'signals': ['path', 'body', 'symbol-name'], 'snippet': '        \"format_artifact_sha256\": {'}, {'rank': 9, 'score': 20.3037, 'file_path': 'internal/cli/mcp.go', 'start_line': 2228, 'end_line': 2233, 'focus_line': 2228, 'snippet_start_line': 2228, 'snippet_end_line': 2229, 'symbol_start_line': 2228, 'symbol_end_line': 2233, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/mcp.go:function:mcpGraphBinary', 'symbol_name': 'mcpGraphBinary', 'qualified_name': 'mcpGraphBinary', 'signature': 'func mcpGraphBinary() string', 'signals': ['body', 'symbol-name', 'graph:callers'], 'snippet': 'func mcpGraphBinary() string {\\n\\tif v := strings.TrimSpace(os.Getenv(\"ENTIRE_BRAIN_GRAPH_BINARY\")); v != \"\" {'}, {'rank': 10, 'score': 20.265, 'file_path': 'internal/cli/entities_provenance.go', 'start_line': 250, 'end_line': 269, 'focus_line': 258, 'snippet_start_line': 257, 'snippet_end_line': 258, 'symbol_start_line': 258, 'symbol_end_line': 269, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/entities_provenance.go:function:betterProvenance', 'symbol_name': 'betterProvenance', 'qualified_name': 'betterProvenance', 'signature': 'func betterProvenance(current, candidate entityProvenanceCandidate) bool', 'signals': ['path', 'body', 'symbol-name', 'graph:callers'], 'snippet': '// run. Two candidates that tie all four ways are the same candidate.\\nfunc betterProvenance(current, candidate entityProvenanceCandidate) bool {'}, {'rank': 11, 'score': 0, 'file_path': 'internal/cli/distill_test.go', 'start_line': 373, 'end_line': 409, 'focus_line': 407, 'snippet_start_line': 406, 'snippet_end_line': 409, 'kind': 'function', 'qualified_name': 'TestInjectAgentModel', 'signals': ['related:covering-test'], 'section': 'covering-test', 'snippet': '\\tif !slices.Equal(injectAgentModel(cmd, \"command\", \"x\"), cmd) {\\n\\t\\tt.Errorf(\"command agent should be a no-op for model injection\")\\n\\t}\\n}'}]\nsymbols \nmatches \n# Darwin capacity observation v1\n\nThis diagnostic closes one measurement ambiguity without authorizing execution. On APFS, `df /`\ncombines a shared container ceiling, sealed System-volume usage, and shared immediately unallocated\nblocks. It does not report the same capacity macOS exposes to important work after reclaiming\npurgeable data.\n\n`negative_control_darwin_capacity_v1.swift` reads four documented Foundation volume-capacity values\nfor one caller-supplied absolute volume path:\n\n- total capacity;\n- immediately available capacity;\n- capacity available for important usage;\n- capacity available for opportunistic usage.\n\nThe path is never emitted. Output is compact, sorted-key UTF-8 JSON with one LF and validates against\n`schemas/negative-control-darwin-capacity-observation-v1.schema.json`. The exact planning threshold is\n16 GiB (`17,179,869,184` bytes). Both raw-free and important-usage comparisons are reported so one\ncannot be silently substituted for the other.\n\nThe observation is deliberately `live_unattested_capacity_observation_execution_forbidden`. It has\nno signing, subprocess, Git, Go, worktree, candidate, model, network, private-log, or reservation\nsurface. Even a passing important-usage comparison leaves execution forbidden because this slice\ndoes not authenticate the observer, reserve capacity, enforce the staging ceiling, or attest cleanup.\n\nOn 2026-07-17, the same Foundation API reported about 191.9 GB available for important usage on the\nData volume, matching System Settings. That live value is not checked in because it changes over\ntime. The earlier report that treated roughly 13 GB of immediately unallocated blocks as total usable\ncapacity was incorrect and is withdrawn.\n\n## Local diagnostic\n\nCompile and observe the Data volume without writing an artifact into the repository:\n\n```bash\n/usr/bin/xcrun swiftc \\\n  benchmarks/agent-brain/confirmatory/negative_control_darwin_capacity_v1.swift \\\n  -o /tmp/negative-control-darwin-capacity-v1\n/tmp/negative-control-darwin-capacity-v1 /System/Volumes/Data\n```\n\nRun the focused synthetic/live-observation checks from the confirmatory directory:\n\n```bash\npython3 -m unittest test_negative_control_darwin_capacity_v1.py\n```\n\nBefore any scheduled attempt, a later gate must pin and authenticate the observer, atomically reserve\nbounded staging capacity, enforce the 8 GiB staging ceiling plus 8 GiB reserve, and attest cleanup.\n# Negative-control private raw-log primitive v1\n\nStatus: synthetic-tested storage primitive only. It does not authorize or perform candidate, Git,\nGo, worktree, network, model/provider, private-data, holdout, benchmark, or paid execution.\n\n`negative_control_private_log.py` implements the private content-addressed raw-log writer and checker\nrequired by the pending multi-repository negative-control plan. It deliberately has no CLI, executor,\nretention-deletion function, or public-receipt writer. The library returns canonical receipt bytes\nonly after a raw content file is fully published and reverified, so an interrupted call cannot emit a\npartial public receipt.\n\n## Private storage contract\n\nThe caller supplies an already-existing dedicated private root. The root must both be and resolve to\nthe same current-user, non-symlink directory with exact mode `0700`. The primitive creates exactly:\n\n- `.negative-control-private-log.lock`, a current-user regular, non-symlink, non-hardlink file with\n  exact mode `0600`; and\n- `sha256/`, a current-user non-symlink directory with exact mode `0700`.\n\nThe lock is acquired exclusively and nonblocking. All store enumeration, size/count accounting,\nwriting, publication, checking, and future cleanup by cooperating same-UID processes **must** occur\nwhile it is held. A busy or malformed lock fails immediately. This owner-only advisory lock is the\nrequired coordination boundary; it cannot stop a noncooperating process with the same UID from\nmutating a pathname after the final check. Such a process can always race an advisory-lock protocol,\nso no stronger OS-isolation claim is made.\n\nEach final raw log is `sha256/<sha256-of-exact-raw-bytes>`. Final files must be current-user regular,\nnon-symlink, non-hardlink files with exact mode `0600`. Untrusted regular-file opens use\n`O_NOFOLLOW`, `O_NONBLOCK`, and descriptor-relative paths. Before a write, the pinned `sha256`\ndirectory is incrementally enumerated through its open descriptor and every entry's type, owner,\nmode, link count, and size contributes to the actual total. Enumeration stops at the final-file\nlimit plus one without first materializing an unbounded name list. Caller-reported accounting is not\naccepted.\n\nInput is streamed into an exclusive `0600` temporary file while SHA-256 and byte count are computed.\nOnly after the file is complete and synchronized does descriptor-relative `link(2)` publish the digest\nname without replacement. The temporary name is then removed, the final link count must be one, and\nthe final bytes are streamed and hashed again. After hashing, a descriptor-relative, non-following\npathname stat must prove the digest name still resolves to the opened inode with the complete expected\nmetadata. A pre-existing exact digest is deduplicated and never overwritten; a pre-existing digest\nname with different bytes fails closed.\n\nThe exact frozen ceilings are 16 MiB per arm, 2 GiB total stored raw-log content, and 4,096 final\ncontent files. The frozen plan has 62 candidates × 2 arms × 2 repetitions = 248 planned arm logs;\n4,096 provides more than 16× headroom while keeping enumeration and in-memory inventory bounded.\nTests may inject only smaller positive ceilings. The total is the secure sum of actual final files\nunder the exclusive lock. Admission for a new digest happens after hashing; therefore an exact\nduplicate adds zero stored bytes and remains valid when the byte or file-count store is at its\nceiling, while a new digest is rejected.\n\n## Public receipt contract\n\nThe public receipt contains exactly two fields and one trailing LF:\n\n```json\n{\"raw_log_byte_count\":9,\"raw_log_sha256\":\"<64 lowercase hex>\"}\n```\n\nThe schema is `schemas/negative-control-private-log-receipt-v1.schema.json`. The runtime checker\nrejects duplicate keys, extra/missing fields, floats and booleans as byte counts, invalid UTF-8 or\nJSON, noncanonical key order/spacing, extra newlines, out-of-range counts, missing content addresses,\nand byte/hash drift.\n\nNo raw content, filesystem path, host identity, secret, command, or redaction status is included.\nRaw logs may contain secrets. This primitive makes **no redaction claim**; privacy comes from the\nprivate root and exact file controls, not from content transformation. `PrivateLogError` failures\ncreated by the primitive use fixed descriptions and never interpolate raw input or a private path.\nCaller-originated `BaseException` instances, including cancellation such as `KeyboardInterrupt`, are\npropagated unchanged to preserve cancellation semantics and are outside that non-leaking claim.\n\n## Interruption and residual gates\n\nDirectory synchronization fails closed on every `OSError`; unsupported/error returns are not treated\nas durable success. Before publication, normal exception cleanup removes the temporary file and leaves\nno final digest or returned receipt. After the atomic link, an exception can leave a complete final\ncontent file without a receipt. If both temporary cleanup and digest rollback unlink fail—or a process\nis killed in the brief publication interval—the complete temporary and digest names may remain as a\ntwo-link inode. No receipt is returned, and later exact enumeration rejects the temporary name/link\ncount until a separately audited cleanup mechanism repairs it.\n\nThis slice intentionally does not implement:\n\n- retention deletion or enforcement of the plan's seven-day expiry;\n- orphan cleanup or interruption attestation;\n- a global byte-hash scrub of unrelated pre-existing digest names (every bounded entry is metadata-checked,\n  and the receipt target is exact-byte checked);\n- receipt-file publication or aggregate receipt accounting;\n- classification, executor, reversal, worktree, cache-seed, resource-preflight, owner-approval, or\n  trust mechanisms; or\n- any update that makes the frozen pending plan executable.\n\nThose remain residual gates. The primitive alone cannot authorize a negative-control run.\n\n## Synthetic verification\n\nFrom `benchmarks/agent-brain/confirmatory`:\n\n```bash\npython3 -m unittest test_negative_control_private_log.py -v\n```\n\nThe focused tests use only temporary roots and in-memory synthetic byte streams. Tightened limits\nexercise the 16 MiB/2 GiB arithmetic without allocating large fixtures. They also cover symlinks,\nhardlinks, wrong modes, FIFOs and nonregular entries, a busy lock, strict directory synchronization,\nbounded file-count admission, no-overwrite behavior, exact deduplication at a full store, deterministic\npathname replacement, mutation, canonical receipts, fixed `PrivateLogError` messages, cancellation,\nand interruption before and after atomic publication—including the rejected two-link residual state.\n# Negative-control gate primitives v1\n\nThis slice implements two pure, unpaid prerequisites for the pending multi-repository negative-control\nplan: an exact offline Go cache-seed identity manifest and deterministic injected resource arithmetic.\nIt does not supply an actual cache archive, inspect an archive, observe host free space, reserve disk,\ncreate a worktree, invoke a candidate, run Git or Go, contact a provider, or authorize execution.\n\n`task_negative_control_gate_v1.py` has exactly two CLI lanes: `check-manifest` checks a cache manifest\nagainst the pending plan and manifest schema, while `check-receipt` additionally checks a canonical\nprimitive receipt against that exact plan, manifest, and both schemas. The CLI only reads JSON and\nschema/module bytes. There is deliberately no build, extract, fetch, filesystem-probe, executor, or\nreceipt-writing command.\n\nBoth lanes are pinned to the checked plan self-hash\n`a47311fa1f4553f8085ebea6e8ddd003a4ea5d0b2d269d91bbcdd414134a248e` and exact rendered-file\nSHA-256 `f55b6e22a25daf8016305304adf3b7ac8d31675281d97cfc9bb78cc76b619790`. The API also rebuilds the\nplan through `verify_plan_dependencies` from the checked repository contract, eligibility schema,\nthree v2 ledgers, run-plan schema, overlap registry, and registry schema. A self-resealed plan with a\ndifferent candidate, ledger, registry, eligibility, builder, schema, or Go/native/Git toolchain\nidentity is therefore rejected.\n\n## Cache identity primitive\n\nA manifest built through the Python API binds:\n\n- the exact checked plan and each repository's complete Go, native compiler, and Git toolchain\n  projection;\n- the gate builder, run-plan builder, schema validator, all transitively used local verifier source\n  files, and manifest schema bytes;\n- the Python implementation, Python version, resolved interpreter executable SHA-256, and\n  `unicodedata.unidata_version` that define parsing and case-fold behavior;\n- a basename-only, NFC-normalized archive name plus its declared SHA-256 and byte count;\n- a sorted file inventory under only `gocache/` or `gomodcache/`, with globally unique canonical\n  archive paths, repository ownership, exact file byte counts, and file SHA-256 values; and\n- the frozen 2 GiB compressed and unpacked cache-seed ceilings.\n\nEvery repository must have at least one cache entry and every entry must declare at least one byte.\nExact NFC paths must also be unique under the per-component portable key\n`NFC(casefold(NFC(component)))`; duplicates and ancestor prefixes are rejected globally regardless\nof repository or input order. This closes ASCII case, Unicode fold (including `ß`/`ss`), and\ncanonical-composition aliases before a future extractor chooses host paths.\n\nThe v1 profile freezes a maximum of 250,000 entries and 128 MiB of canonical rendered manifest\nbytes. The JSON schema has the same `maxItems`/count/byte bounds and intentionally does not use\n`uniqueItems`; the verifier uses bounded O(n) sets for exact and portable collision checks. These are\nconservative planning ceilings intended to leave room for three substantial Go caches while bounding\nmemory and parser work. They are not a measurement of an actual seed. The future archive-preparation\nstep must prove the real inventory fits—including the non-zero-file rule—or version the profile and\nschema rather than silently raising a ceiling.\n\nHost-shared cache reuse and network dependency resolution remain `forbidden`. The checked-in pending\nplan still has null archive, manifest, source, and unpacked-size locators: this slice intentionally\ndoes not fabricate or bind an actual seed.\n\nThe manifest and receipt schema arguments are not caller-defined policy. Their raw bytes must match\nthe pinned checked-in v1 schema SHA-256 values (`37d3839411b2e30a99fdd7e93784d56f5fd525c0472717a24cc7b92213b98999`\nand `7603f755dd8429ff8c0a17114a50cda0aa23ae99c07cf2cfff9856df00c0a8e0`, respectively); an alternate\npath is accepted only when its bytes are identical. Manual fail-closed invariants remain authoritative\nand schema validation is additionally executed.\n\nThe preflight API can compare an injected archive-identity observation with a manifest, but labels that\nobservation `injected_archive_identity_unattested`. Matching declared hashes and counts is not safe\narchive verification. A future gate must traverse an actual archive fail-closed, reject unsafe paths,\nnon-regular entries, links and devices, hash every extracted file, and then bind that verified archive\ninto a separately authorized plan.\n\n## Injected resource arithmetic\n\n`evaluate_injected_resource_stats` accepts only `fragment_size_bytes` and `available_blocks`. It\nrecomputes available bytes, checks the frozen `8 GiB reserve + 8 GiB staging = 16 GiB minimum`, and\nrejects anything below the threshold. It does not call `statvfs`, identify a filesystem, reserve\ncapacity, or eliminate time-of-check/time-of-use races. A synthetic 11 GiB observation therefore\nfails deterministically without consuming disk, while an exact 16 GiB observation passes the pure\narithmetic primitive.\n\nBoth injected factors and every emitted variable resource integer have the explicit maximum\n`10^64 - 1`, the largest non-negative value admitted by the 64-digit JSON profile. This is far above\nthe frozen 16 GiB threshold, so it does not weaken the plan's lower-bound arithmetic. Multiplication\nis division-guarded (`available_blocks <= maximum // fragment_size_bytes`) before it occurs; two\nindividually valid 64-digit factors therefore cannot create an unparseable derived value. The receipt\nschema repeats the same maxima for blocks, fragment size, free bytes, and headroom.\n\nA deterministic primitive receipt binds the exact canonical plan and manifest bytes, both schemas,\nall implementation dependencies, the injected observations, and its own self-hash. Its status is\n`primitive_checks_passed_execution_forbidden`, its cache binding remains\n`external_manifest_not_bound_by_pending_plan`, and its execution status remains\n`forbidden_missing_remaining_gates`.\n\n## Bounded input profile\n\nBefore JSON parsing, the checker opens only stable regular files with mandatory close-on-exec,\nno-follow, and nonblocking flags, checks size with `fstat`, reads no more than the frozen ceiling, and\nrejects any metadata change during the read. Symlinks, FIFOs, same-size mutation races, duplicate\nkeys, floats/non-finite numbers, integers longer than 64 digits, and nesting deeper than 64 levels\nfail closed with CLI exit 2 and no traceback. Raw limits are 1 MiB for the checked plan, 128 MiB for\nthe manifest, and 4 MiB each for schemas and the primitive receipt. Validators recheck canonical\nrendered byte counts after manual shape/count/scalar bounds, so a constructed Python object cannot\nbypass the file parser or force an unbounded render before basic rejection. The same iterative\ndepth/integer/no-float validator runs on every Python-constructed and API-validated manifest and\nreceipt before self-hashing or schema validation. Consequently, any artifact successfully built and\ncanonically rendered by the Python API is accepted by the CLI parser under the same JSON profile.\n\nConstructed inputs must also be JSON trees: every `dict`, `list`, or `tuple` identity may appear only\nonce. Cycles and repeated container aliases are rejected before re-expansion; repeated immutable\nscalar values remain valid. The traversal charges one node for each container or scalar value (object\nkeys are not value nodes) and freezes a 1,260,000-node ceiling:\n`250,000 entries * (one entry object + four scalar values) + 10,000 fixed-envelope nodes`. The\n10,000-node allowance conservatively covers the manifest's fixed metadata and provenance as well as\nthe much smaller receipt, checked plan, and pinned schemas. Child counts are charged against the\nremaining budget before they are pushed, bounding the pending stack. The identity set and node\ncounter therefore make traversal linear in the visited JSON tree and prevent an alias DAG from\nexpanding exponentially. Parsed CLI JSON already has tree semantics, so valid file behavior is\nunchanged.\n\nThe constructed-input profile admits only exact built-in `dict`, `list`, `str`, `int`, `bool`, and\n`None` values. Exact built-in tuples are retained only for Python API canonicalization and render as\nJSON arrays; parsed CLI arrays remain lists. Built-in floats retain their dedicated rejection, while\nall subclasses and other custom objects are rejected by exact `type` before any attacker-overridable\nlength, truth, iteration, mapping, comparison, or encoding method can run. Object keys likewise must\nbe exact built-in strings. The manifest's root/contents/file-count envelope guards enforce those exact\ncontainer and key types before using `set`, truth, or `len`, preserving the 250,000-entry precedence\nwithout opening a subclass-dispatch path. The same boundary applies to the public manifest builder's\nentry sequence and scalar values and to injected archive-observation and filesystem-stat mappings;\nonly exact lists/tuples of exact JSON values and exact dictionaries, respectively, are accepted.\nRaw plan and manifest inputs must be exact built-in bytes before length, hashing, or equality work.\n\n## Residual hard gates\n\nThese primitives do not close:\n\n- owner execution approval and its trust mechanism;\n- binding a safely verified actual cache archive and manifest into an authorized plan;\n- safe archive traversal/type/link/device/content verification;\n- a trusted filesystem observer plus atomic capacity reservation;\n- the detached-worktree executor and first-parent source-reversal proof;\n- the classification truth table and receipt checker;\n- the private content-addressed log writer/checker; or\n- fail-closed cleanup and no-receipt-on-interruption behavior.\n\nCalibration membership, confirmatory holdout membership, model/provider execution, paid execution,\ncandidate execution, and benchmark execution remain forbidden.\n\n## Verification\n\nRun the focused static and synthetic checks from the confirmatory directory:\n\n```bash\npython3 -m unittest \\\n  test_task_negative_control_plan_v2.py \\\n  test_task_negative_control_gate_v1.py\npyright task_negative_control_gate_v1.py test_task_negative_control_gate_v1.py\n```\n\nThe tests use fabricated hashes, file inventories, and injected block counts only. They do not create\ncache archives, fill disk, create candidate worktrees, or run any of the 62 candidate tests.\n","exit_code":0,"duration":{"secs":0,"nanos":2292},"formatted_output":"bytes 28759\n['format_version', 'query', 'repo_root', 'commit', 'tree', 'profile', 'results', 'verify_command', 'coverage_note', 'stats', 'warnings', 'partial_failures', 'completeness']\nresults [{'rank': 1, 'score': 22.2773, 'file_path': 'internal/cli/seed.go', 'start_line': 670, 'end_line': 676, 'focus_line': 670, 'snippet_start_line': 670, 'snippet_end_line': 676, 'symbol_start_line': 670, 'symbol_end_line': 676, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/seed.go:function:isEntrypointPath', 'symbol_name': 'isEntrypointPath', 'qualified_name': 'isEntrypointPath', 'signature': 'func isEntrypointPath(path string) bool', 'signals': ['body', 'symbol-name', 'graph:callers', 'complete-symbol'], 'snippet': 'func isEntrypointPath(path string) bool {\\n\\tbase := filepath.Base(path)\\n\\tif base == \"main.go\" || base == \"server.js\" || base == \"index.js\" || base == \"index.ts\" || base == \"index.tsx\" || base == \"main.jsx\" || base == \"main.tsx\" || base == \"App.jsx\" || base == \"App.tsx\" {\\n\\t\\treturn true\\n\\t}\\n\\treturn strings.HasPrefix(filepath.ToSlash(path), \"bin/\")\\n}'}, {'rank': 2, 'score': 22.0595, 'file_path': 'internal/cli/memory_abstract.go', 'start_line': 1473, 'end_line': 1521, 'focus_line': 1473, 'snippet_start_line': 1473, 'snippet_end_line': 1521, 'symbol_start_line': 1473, 'symbol_end_line': 1521, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/memory_abstract.go:function:validateSessionAbstractSchema', 'symbol_name': 'validateSessionAbstractSchema', 'qualified_name': 'validateSessionAbstractSchema', 'signature': 'func validateSessionAbstractSchema(artifact sessionAbstract) error', 'signals': ['body', 'signature', 'symbol-name', 'graph:callers', 'complete-symbol'], 'snippet': 'func validateSessionAbstractSchema(artifact sessionAbstract) error {\\n\\tif !strings.HasPrefix(artifact.SessionRef, conversationSessionIDPrefix) || strings.TrimSpace(strings.TrimPrefix(artifact.SessionRef, conversationSessionIDPrefix)) == \"\" || !validSHA256Identity(artifact.SessionDigest) {\\n\\t\\treturn errors.New(\"session_ref and session_digest identities are required\")\\n\\t}\\n\\tif artifact.GeneratedAt.IsZero() {\\n\\t\\treturn errors.New(\"generated_at is required\")\\n\\t}\\n\\tif artifact.Generator.Kind != \"local\" && artifact.Generator.Kind != \"hosted\" {\\n\\t\\treturn fmt.Errorf(\"unrecognized generator kind %q\", artifact.Generator.Kind)\\n\\t}\\n\\tif strings.TrimSpace(artifact.Generator.Provider) == \"\" || strings.TrimSpace(artifact.Generator.Model) == \"\" || artifact.Generator.ContractVersion != 1 {\\n\\t\\treturn errors.New(\"generator provider, model, and contract version are required\")\\n\\t}\\n\\tswitch strings.ToLower(strings.TrimSpace(artifact.Generator.Provider)) {\\n\\tcase \"ollama\":\\n\\t\\tif artifact.Generator.Kind != \"local\" {\\n\\t\\t\\treturn errors.New(\"ollama generator must be local\")\\n\\t\\t}\\n\\tcase \"codex\", \"claude-code\":\\n\\t\\tif artifact.Generator.Kind != \"hosted\" {\\n\\t\\t\\treturn errors.New(\"codex and claude-code generators must be hosted\")\\n\\t\\t}\\n\\tdefault:\\n\\t\\treturn fmt.Errorf(\"unrecognized generator provider %q\", artifact.Generator.Provider)\\n\\t}\\n\\tif artifact.Coverage.TotalTurns < 0 || artifact.Coverage.IncludedTurns < 0 || artifact.Coverage.IncludedTurns > artifact.Coverage.TotalTurns {\\n\\t\\treturn errors.New(\"coverage counts are invalid\")\\n\\t}\\n\\tif artifact.Coverage.IncludedTurns > abstractMaxTurns {\\n\\t\\treturn fmt.Errorf(\"coverage includes more than %d turns\", abstractMaxTurns)\\n\\t}\\n\\tif artifact.Coverage.IncludedTurns < artifact.Coverage.TotalTurns && !artifact.InputTruncated {\\n\\t\\treturn errors.New(\"partial coverage must declare input_truncated\")\\n\\t}\\n\\tif len(artifact.Coverage.IncludedRanges) > abstractRangesMax {\\n\\t\\treturn fmt.Errorf(\"coverage lists more than %d ranges\", abstractRangesMax)\\n\\t}\\n\\tpreviousEnd := 0\\n\\tfor _, item := range artifact.Coverage.IncludedRanges {\\n\\t\\tif item.StartTurn < 1 || item.EndTurn < item.StartTurn || (previousEnd > 0 && item.StartTurn <= previousEnd) {\\n\\t\\t\\treturn errors.New(\"coverage ranges must be positive, ordered, and non-overlapping\")\\n\\t\\t}\\n\\t\\tpreviousEnd = item.EndTurn\\n\\t}\\n\\tif (artifact.Coverage.IncludedTurns == 0) != (len(artifact.Coverage.IncludedRanges) == 0) {\\n\\t\\treturn errors.New(\"coverage ranges and included turn count disagree\")\\n\\t}\\n\\treturn validateAbstractStatementLists(artifact, nil)\\n}'}, {'rank': 3, 'score': 21.3895, 'file_path': 'internal/cli/distill.go', 'start_line': 130, 'end_line': 157, 'focus_line': 136, 'snippet_start_line': 136, 'snippet_end_line': 157, 'symbol_start_line': 136, 'symbol_end_line': 157, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/distill.go:function:injectAgentModel', 'symbol_name': 'injectAgentModel', 'qualified_name': 'injectAgentModel', 'signature': 'func injectAgentModel(args []string, agent, model string) []string', 'signals': ['body', 'symbol-name', 'graph:callers', 'complete-symbol'], 'snippet': 'func injectAgentModel(args []string, agent, model string) []string {\\n\\tif model == \"\" {\\n\\t\\treturn args\\n\\t}\\n\\tswitch agent {\\n\\tcase \"codex\":\\n\\t\\tif len(args) >= 2 && args[0] == \"codex\" && args[1] == \"exec\" {\\n\\t\\t\\treturn append(args[:2:2], append([]string{\"--model\", model}, args[2:]...)...)\\n\\t\\t}\\n\\tcase \"claude-code\":\\n\\t\\tif len(args) >= 1 && args[0] == \"claude\" {\\n\\t\\t\\treturn append(args[:1:1], append([]string{\"--model\", model}, args[1:]...)...)\\n\\t\\t}\\n\\tcase \"ollama\":\\n\\t\\tif len(args) >= 3 && args[0] == \"ollama\" {\\n\\t\\t\\tout := append([]string(nil), args...)\\n\\t\\t\\tout[1] = model\\n\\t\\t\\treturn out\\n\\t\\t}\\n\\t}\\n\\treturn args\\n}'}, {'rank': 4, 'score': 21.1873, 'file_path': 'internal/cli/history.go', 'start_line': 3204, 'end_line': 3211, 'focus_line': 3204, 'snippet_start_line': 3204, 'snippet_end_line': 3211, 'symbol_start_line': 3204, 'symbol_end_line': 3211, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/history.go:function:validHistoryGenerationArtifactPath', 'symbol_name': 'validHistoryGenerationArtifactPath', 'qualified_name': 'validHistoryGenerationArtifactPath', 'signature': 'func validHistoryGenerationArtifactPath(rel, fileName string) bool', 'signals': ['body', 'symbol-name', 'graph:callers', 'complete-symbol'], 'snippet': 'func validHistoryGenerationArtifactPath(rel, fileName string) bool {\\n\\tparts := strings.Split(rel, \"/\")\\n\\tif len(parts) != 4 || parts[0] != historyDirName || parts[1] != \"generations\" || parts[3] != fileName || len(parts[2]) != 40 {\\n\\t\\treturn false\\n\\t}\\n\\t_, err := hex.DecodeString(parts[2])\\n\\treturn err == nil\\n}'}, {'rank': 5, 'score': 21.1773, 'file_path': 'internal/cli/session_privacy.go', 'start_line': 1380, 'end_line': 1459, 'focus_line': 1380, 'snippet_start_line': 1380, 'snippet_end_line': 1385, 'symbol_start_line': 1380, 'symbol_end_line': 1558, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/session_privacy.go:function:privacyDerivedStoreArtifacts', 'symbol_name': 'privacyDerivedStoreArtifacts', 'qualified_name': 'privacyDerivedStoreArtifacts', 'signature': 'func privacyDerivedStoreArtifacts(brainDir string) ([]string, error)', 'signals': ['graph:calls', 'graph:incoming', 'graph:callers'], 'snippet': 'func privacyDerivedStoreArtifacts(brainDir string) ([]string, error) {\\n\\trels := privacyDerivedStoreRels()\\n\\tpublication, _, publicationPresent, err := loadPatternCorpusPublicationForPrivacy(brainDir)\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}'}, {'rank': 6, 'score': 21.1719, 'file_path': 'internal/cli/semantic_graph.go', 'start_line': 166, 'end_line': 216, 'focus_line': 214, 'snippet_start_line': 213, 'snippet_end_line': 214, 'symbol_start_line': 166, 'symbol_end_line': 216, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/semantic_graph.go:function:runSemanticGraphSchema', 'symbol_name': 'runSemanticGraphSchema', 'qualified_name': 'runSemanticGraphSchema', 'signature': 'func runSemanticGraphSchema(cmd *cobra.Command, opts Options, graphOpts semanticGraphSchemaOptions) error', 'signals': ['body', 'symbol-name', 'graph:callers'], 'snippet': '\\tfmt.Fprintf(cmd.OutOrStdout(), \"hotspots: %s\\\\n\", graphRanksText(report.Metrics.Hotspots))\\n\\tfmt.Fprintf(cmd.OutOrStdout(), \"entry_points: %s\\\\n\", graphRanksText(report.Metrics.EntryPoints))'}, {'rank': 7, 'score': 20.5805, 'file_path': 'benchmarks/agent-brain/confirmatory/schemas/negative-control-cache-bundle-verifier-contract-v2.schema.json', 'start_line': 74, 'end_line': 74, 'focus_line': 74, 'snippet_start_line': 74, 'snippet_end_line': 74, 'symbol_start_line': 74, 'symbol_end_line': 74, 'language': 'JSON', 'kind': 'section', 'symbol_id': 'gh/entireio/entire-brain:JSON:benchmarks/agent-brain/confirmatory/schemas/negative-control-cache-bundle-verifier-contract-v2.schema.json:section:format_artifact', 'symbol_name': 'format_artifact', 'qualified_name': 'format_artifact', 'signature': 'json key format_artifact', 'signals': ['path', 'body', 'symbol-name'], 'snippet': '        \"format_artifact\": {'}, {'rank': 8, 'score': 20.5564, 'file_path': 'benchmarks/agent-brain/confirmatory/schemas/negative-control-cache-bundle-verification-report-v2.schema.json', 'start_line': 50, 'end_line': 50, 'focus_line': 50, 'snippet_start_line': 50, 'snippet_end_line': 50, 'symbol_start_line': 50, 'symbol_end_line': 50, 'language': 'JSON', 'kind': 'section', 'symbol_id': 'gh/entireio/entire-brain:JSON:benchmarks/agent-brain/confirmatory/schemas/negative-control-cache-bundle-verification-report-v2.schema.json:section:format_artifact_sha256', 'symbol_name': 'format_artifact_sha256', 'qualified_name': 'format_artifact_sha256', 'signature': 'json key format_artifact_sha256', 'signals': ['path', 'body', 'symbol-name'], 'snippet': '        \"format_artifact_sha256\": {'}, {'rank': 9, 'score': 20.3037, 'file_path': 'internal/cli/mcp.go', 'start_line': 2228, 'end_line': 2233, 'focus_line': 2228, 'snippet_start_line': 2228, 'snippet_end_line': 2229, 'symbol_start_line': 2228, 'symbol_end_line': 2233, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/mcp.go:function:mcpGraphBinary', 'symbol_name': 'mcpGraphBinary', 'qualified_name': 'mcpGraphBinary', 'signature': 'func mcpGraphBinary() string', 'signals': ['body', 'symbol-name', 'graph:callers'], 'snippet': 'func mcpGraphBinary() string {\\n\\tif v := strings.TrimSpace(os.Getenv(\"ENTIRE_BRAIN_GRAPH_BINARY\")); v != \"\" {'}, {'rank': 10, 'score': 20.265, 'file_path': 'internal/cli/entities_provenance.go', 'start_line': 250, 'end_line': 269, 'focus_line': 258, 'snippet_start_line': 257, 'snippet_end_line': 258, 'symbol_start_line': 258, 'symbol_end_line': 269, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/entities_provenance.go:function:betterProvenance', 'symbol_name': 'betterProvenance', 'qualified_name': 'betterProvenance', 'signature': 'func betterProvenance(current, candidate entityProvenanceCandidate) bool', 'signals': ['path', 'body', 'symbol-name', 'graph:callers'], 'snippet': '// run. Two candidates that tie all four ways are the same candidate.\\nfunc betterProvenance(current, candidate entityProvenanceCandidate) bool {'}, {'rank': 11, 'score': 0, 'file_path': 'internal/cli/distill_test.go', 'start_line': 373, 'end_line': 409, 'focus_line': 407, 'snippet_start_line': 406, 'snippet_end_line': 409, 'kind': 'function', 'qualified_name': 'TestInjectAgentModel', 'signals': ['related:covering-test'], 'section': 'covering-test', 'snippet': '\\tif !slices.Equal(injectAgentModel(cmd, \"command\", \"x\"), cmd) {\\n\\t\\tt.Errorf(\"command agent should be a no-op for model injection\")\\n\\t}\\n}'}]\nsymbols \nmatches \n# Darwin capacity observation v1\n\nThis diagnostic closes one measurement ambiguity without authorizing execution. On APFS, `df /`\ncombines a shared container ceiling, sealed System-volume usage, and shared immediately unallocated\nblocks. It does not report the same capacity macOS exposes to important work after reclaiming\npurgeable data.\n\n`negative_control_darwin_capacity_v1.swift` reads four documented Foundation volume-capacity values\nfor one caller-supplied absolute volume path:\n\n- total capacity;\n- immediately available capacity;\n- capacity available for important usage;\n- capacity available for opportunistic usage.\n\nThe path is never emitted. Output is compact, sorted-key UTF-8 JSON with one LF and validates against\n`schemas/negative-control-darwin-capacity-observation-v1.schema.json`. The exact planning threshold is\n16 GiB (`17,179,869,184` bytes). Both raw-free and important-usage comparisons are reported so one\ncannot be silently substituted for the other.\n\nThe observation is deliberately `live_unattested_capacity_observation_execution_forbidden`. It has\nno signing, subprocess, Git, Go, worktree, candidate, model, network, private-log, or reservation\nsurface. Even a passing important-usage comparison leaves execution forbidden because this slice\ndoes not authenticate the observer, reserve capacity, enforce the staging ceiling, or attest cleanup.\n\nOn 2026-07-17, the same Foundation API reported about 191.9 GB available for important usage on the\nData volume, matching System Settings. That live value is not checked in because it changes over\ntime. The earlier report that treated roughly 13 GB of immediately unallocated blocks as total usable\ncapacity was incorrect and is withdrawn.\n\n## Local diagnostic\n\nCompile and observe the Data volume without writing an artifact into the repository:\n\n```bash\n/usr/bin/xcrun swiftc \\\n  benchmarks/agent-brain/confirmatory/negative_control_darwin_capacity_v1.swift \\\n  -o /tmp/negative-control-darwin-capacity-v1\n/tmp/negative-control-darwin-capacity-v1 /System/Volumes/Data\n```\n\nRun the focused synthetic/live-observation checks from the confirmatory directory:\n\n```bash\npython3 -m unittest test_negative_control_darwin_capacity_v1.py\n```\n\nBefore any scheduled attempt, a later gate must pin and authenticate the observer, atomically reserve\nbounded staging capacity, enforce the 8 GiB staging ceiling plus 8 GiB reserve, and attest cleanup.\n# Negative-control private raw-log primitive v1\n\nStatus: synthetic-tested storage primitive only. It does not authorize or perform candidate, Git,\nGo, worktree, network, model/provider, private-data, holdout, benchmark, or paid execution.\n\n`negative_control_private_log.py` implements the private content-addressed raw-log writer and checker\nrequired by the pending multi-repository negative-control plan. It deliberately has no CLI, executor,\nretention-deletion function, or public-receipt writer. The library returns canonical receipt bytes\nonly after a raw content file is fully published and reverified, so an interrupted call cannot emit a\npartial public receipt.\n\n## Private storage contract\n\nThe caller supplies an already-existing dedicated private root. The root must both be and resolve to\nthe same current-user, non-symlink directory with exact mode `0700`. The primitive creates exactly:\n\n- `.negative-control-private-log.lock`, a current-user regular, non-symlink, non-hardlink file with\n  exact mode `0600`; and\n- `sha256/`, a current-user non-symlink directory with exact mode `0700`.\n\nThe lock is acquired exclusively and nonblocking. All store enumeration, size/count accounting,\nwriting, publication, checking, and future cleanup by cooperating same-UID processes **must** occur\nwhile it is held. A busy or malformed lock fails immediately. This owner-only advisory lock is the\nrequired coordination boundary; it cannot stop a noncooperating process with the same UID from\nmutating a pathname after the final check. Such a process can always race an advisory-lock protocol,\nso no stronger OS-isolation claim is made.\n\nEach final raw log is `sha256/<sha256-of-exact-raw-bytes>`. Final files must be current-user regular,\nnon-symlink, non-hardlink files with exact mode `0600`. Untrusted regular-file opens use\n`O_NOFOLLOW`, `O_NONBLOCK`, and descriptor-relative paths. Before a write, the pinned `sha256`\ndirectory is incrementally enumerated through its open descriptor and every entry's type, owner,\nmode, link count, and size contributes to the actual total. Enumeration stops at the final-file\nlimit plus one without first materializing an unbounded name list. Caller-reported accounting is not\naccepted.\n\nInput is streamed into an exclusive `0600` temporary file while SHA-256 and byte count are computed.\nOnly after the file is complete and synchronized does descriptor-relative `link(2)` publish the digest\nname without replacement. The temporary name is then removed, the final link count must be one, and\nthe final bytes are streamed and hashed again. After hashing, a descriptor-relative, non-following\npathname stat must prove the digest name still resolves to the opened inode with the complete expected\nmetadata. A pre-existing exact digest is deduplicated and never overwritten; a pre-existing digest\nname with different bytes fails closed.\n\nThe exact frozen ceilings are 16 MiB per arm, 2 GiB total stored raw-log content, and 4,096 final\ncontent files. The frozen plan has 62 candidates × 2 arms × 2 repetitions = 248 planned arm logs;\n4,096 provides more than 16× headroom while keeping enumeration and in-memory inventory bounded.\nTests may inject only smaller positive ceilings. The total is the secure sum of actual final files\nunder the exclusive lock. Admission for a new digest happens after hashing; therefore an exact\nduplicate adds zero stored bytes and remains valid when the byte or file-count store is at its\nceiling, while a new digest is rejected.\n\n## Public receipt contract\n\nThe public receipt contains exactly two fields and one trailing LF:\n\n```json\n{\"raw_log_byte_count\":9,\"raw_log_sha256\":\"<64 lowercase hex>\"}\n```\n\nThe schema is `schemas/negative-control-private-log-receipt-v1.schema.json`. The runtime checker\nrejects duplicate keys, extra/missing fields, floats and booleans as byte counts, invalid UTF-8 or\nJSON, noncanonical key order/spacing, extra newlines, out-of-range counts, missing content addresses,\nand byte/hash drift.\n\nNo raw content, filesystem path, host identity, secret, command, or redaction status is included.\nRaw logs may contain secrets. This primitive makes **no redaction claim**; privacy comes from the\nprivate root and exact file controls, not from content transformation. `PrivateLogError` failures\ncreated by the primitive use fixed descriptions and never interpolate raw input or a private path.\nCaller-originated `BaseException` instances, including cancellation such as `KeyboardInterrupt`, are\npropagated unchanged to preserve cancellation semantics and are outside that non-leaking claim.\n\n## Interruption and residual gates\n\nDirectory synchronization fails closed on every `OSError`; unsupported/error returns are not treated\nas durable success. Before publication, normal exception cleanup removes the temporary file and leaves\nno final digest or returned receipt. After the atomic link, an exception can leave a complete final\ncontent file without a receipt. If both temporary cleanup and digest rollback unlink fail—or a process\nis killed in the brief publication interval—the complete temporary and digest names may remain as a\ntwo-link inode. No receipt is returned, and later exact enumeration rejects the temporary name/link\ncount until a separately audited cleanup mechanism repairs it.\n\nThis slice intentionally does not implement:\n\n- retention deletion or enforcement of the plan's seven-day expiry;\n- orphan cleanup or interruption attestation;\n- a global byte-hash scrub of unrelated pre-existing digest names (every bounded entry is metadata-checked,\n  and the receipt target is exact-byte checked);\n- receipt-file publication or aggregate receipt accounting;\n- classification, executor, reversal, worktree, cache-seed, resource-preflight, owner-approval, or\n  trust mechanisms; or\n- any update that makes the frozen pending plan executable.\n\nThose remain residual gates. The primitive alone cannot authorize a negative-control run.\n\n## Synthetic verification\n\nFrom `benchmarks/agent-brain/confirmatory`:\n\n```bash\npython3 -m unittest test_negative_control_private_log.py -v\n```\n\nThe focused tests use only temporary roots and in-memory synthetic byte streams. Tightened limits\nexercise the 16 MiB/2 GiB arithmetic without allocating large fixtures. They also cover symlinks,\nhardlinks, wrong modes, FIFOs and nonregular entries, a busy lock, strict directory synchronization,\nbounded file-count admission, no-overwrite behavior, exact deduplication at a full store, deterministic\npathname replacement, mutation, canonical receipts, fixed `PrivateLogError` messages, cancellation,\nand interruption before and after atomic publication—including the rejected two-link residual state.\n# Negative-control gate primitives v1\n\nThis slice implements two pure, unpaid prerequisites for the pending multi-repository negative-control\nplan: an exact offline Go cache-seed identity manifest and deterministic injected resource arithmetic.\nIt does not supply an actual cache archive, inspect an archive, observe host free space, reserve disk,\ncreate a worktree, invoke a candidate, run Git or Go, contact a provider, or authorize execution.\n\n`task_negative_control_gate_v1.py` has exactly two CLI lanes: `check-manifest` checks a cache manifest\nagainst the pending plan and manifest schema, while `check-receipt` additionally checks a canonical\nprimitive receipt against that exact plan, manifest, and both schemas. The CLI only reads JSON and\nschema/module bytes. There is deliberately no build, extract, fetch, filesystem-probe, executor, or\nreceipt-writing command.\n\nBoth lanes are pinned to the checked plan self-hash\n`a47311fa1f4553f8085ebea6e8ddd003a4ea5d0b2d269d91bbcdd414134a248e` and exact rendered-file\nSHA-256 `f55b6e22a25daf8016305304adf3b7ac8d31675281d97cfc9bb78cc76b619790`. The API also rebuilds the\nplan through `verify_plan_dependencies` from the checked repository contract, eligibility schema,\nthree v2 ledgers, run-plan schema, overlap registry, and registry schema. A self-resealed plan with a\ndifferent candidate, ledger, registry, eligibility, builder, schema, or Go/native/Git toolchain\nidentity is therefore rejected.\n\n## Cache identity primitive\n\nA manifest built through the Python API binds:\n\n- the exact checked plan and each repository's complete Go, native compiler, and Git toolchain\n  projection;\n- the gate builder, run-plan builder, schema validator, all transitively used local verifier source\n  files, and manifest schema bytes;\n- the Python implementation, Python version, resolved interpreter executable SHA-256, and\n  `unicodedata.unidata_version` that define parsing and case-fold behavior;\n- a basename-only, NFC-normalized archive name plus its declared SHA-256 and byte count;\n- a sorted file inventory under only `gocache/` or `gomodcache/`, with globally unique canonical\n  archive paths, repository ownership, exact file byte counts, and file SHA-256 values; and\n- the frozen 2 GiB compressed and unpacked cache-seed ceilings.\n\nEvery repository must have at least one cache entry and every entry must declare at least one byte.\nExact NFC paths must also be unique under the per-component portable key\n`NFC(casefold(NFC(component)))`; duplicates and ancestor prefixes are rejected globally regardless\nof repository or input order. This closes ASCII case, Unicode fold (including `ß`/`ss`), and\ncanonical-composition aliases before a future extractor chooses host paths.\n\nThe v1 profile freezes a maximum of 250,000 entries and 128 MiB of canonical rendered manifest\nbytes. The JSON schema has the same `maxItems`/count/byte bounds and intentionally does not use\n`uniqueItems`; the verifier uses bounded O(n) sets for exact and portable collision checks. These are\nconservative planning ceilings intended to leave room for three substantial Go caches while bounding\nmemory and parser work. They are not a measurement of an actual seed. The future archive-preparation\nstep must prove the real inventory fits—including the non-zero-file rule—or version the profile and\nschema rather than silently raising a ceiling.\n\nHost-shared cache reuse and network dependency resolution remain `forbidden`. The checked-in pending\nplan still has null archive, manifest, source, and unpacked-size locators: this slice intentionally\ndoes not fabricate or bind an actual seed.\n\nThe manifest and receipt schema arguments are not caller-defined policy. Their raw bytes must match\nthe pinned checked-in v1 schema SHA-256 values (`37d3839411b2e30a99fdd7e93784d56f5fd525c0472717a24cc7b92213b98999`\nand `7603f755dd8429ff8c0a17114a50cda0aa23ae99c07cf2cfff9856df00c0a8e0`, respectively); an alternate\npath is accepted only when its bytes are identical. Manual fail-closed invariants remain authoritative\nand schema validation is additionally executed.\n\nThe preflight API can compare an injected archive-identity observation with a manifest, but labels that\nobservation `injected_archive_identity_unattested`. Matching declared hashes and counts is not safe\narchive verification. A future gate must traverse an actual archive fail-closed, reject unsafe paths,\nnon-regular entries, links and devices, hash every extracted file, and then bind that verified archive\ninto a separately authorized plan.\n\n## Injected resource arithmetic\n\n`evaluate_injected_resource_stats` accepts only `fragment_size_bytes` and `available_blocks`. It\nrecomputes available bytes, checks the frozen `8 GiB reserve + 8 GiB staging = 16 GiB minimum`, and\nrejects anything below the threshold. It does not call `statvfs`, identify a filesystem, reserve\ncapacity, or eliminate time-of-check/time-of-use races. A synthetic 11 GiB observation therefore\nfails deterministically without consuming disk, while an exact 16 GiB observation passes the pure\narithmetic primitive.\n\nBoth injected factors and every emitted variable resource integer have the explicit maximum\n`10^64 - 1`, the largest non-negative value admitted by the 64-digit JSON profile. This is far above\nthe frozen 16 GiB threshold, so it does not weaken the plan's lower-bound arithmetic. Multiplication\nis division-guarded (`available_blocks <= maximum // fragment_size_bytes`) before it occurs; two\nindividually valid 64-digit factors therefore cannot create an unparseable derived value. The receipt\nschema repeats the same maxima for blocks, fragment size, free bytes, and headroom.\n\nA deterministic primitive receipt binds the exact canonical plan and manifest bytes, both schemas,\nall implementation dependencies, the injected observations, and its own self-hash. Its status is\n`primitive_checks_passed_execution_forbidden`, its cache binding remains\n`external_manifest_not_bound_by_pending_plan`, and its execution status remains\n`forbidden_missing_remaining_gates`.\n\n## Bounded input profile\n\nBefore JSON parsing, the checker opens only stable regular files with mandatory close-on-exec,\nno-follow, and nonblocking flags, checks size with `fstat`, reads no more than the frozen ceiling, and\nrejects any metadata change during the read. Symlinks, FIFOs, same-size mutation races, duplicate\nkeys, floats/non-finite numbers, integers longer than 64 digits, and nesting deeper than 64 levels\nfail closed with CLI exit 2 and no traceback. Raw limits are 1 MiB for the checked plan, 128 MiB for\nthe manifest, and 4 MiB each for schemas and the primitive receipt. Validators recheck canonical\nrendered byte counts after manual shape/count/scalar bounds, so a constructed Python object cannot\nbypass the file parser or force an unbounded render before basic rejection. The same iterative\ndepth/integer/no-float validator runs on every Python-constructed and API-validated manifest and\nreceipt before self-hashing or schema validation. Consequently, any artifact successfully built and\ncanonically rendered by the Python API is accepted by the CLI parser under the same JSON profile.\n\nConstructed inputs must also be JSON trees: every `dict`, `list`, or `tuple` identity may appear only\nonce. Cycles and repeated container aliases are rejected before re-expansion; repeated immutable\nscalar values remain valid. The traversal charges one node for each container or scalar value (object\nkeys are not value nodes) and freezes a 1,260,000-node ceiling:\n`250,000 entries * (one entry object + four scalar values) + 10,000 fixed-envelope nodes`. The\n10,000-node allowance conservatively covers the manifest's fixed metadata and provenance as well as\nthe much smaller receipt, checked plan, and pinned schemas. Child counts are charged against the\nremaining budget before they are pushed, bounding the pending stack. The identity set and node\ncounter therefore make traversal linear in the visited JSON tree and prevent an alias DAG from\nexpanding exponentially. Parsed CLI JSON already has tree semantics, so valid file behavior is\nunchanged.\n\nThe constructed-input profile admits only exact built-in `dict`, `list`, `str`, `int`, `bool`, and\n`None` values. Exact built-in tuples are retained only for Python API canonicalization and render as\nJSON arrays; parsed CLI arrays remain lists. Built-in floats retain their dedicated rejection, while\nall subclasses and other custom objects are rejected by exact `type` before any attacker-overridable\nlength, truth, iteration, mapping, comparison, or encoding method can run. Object keys likewise must\nbe exact built-in strings. The manifest's root/contents/file-count envelope guards enforce those exact\ncontainer and key types before using `set`, truth, or `len`, preserving the 250,000-entry precedence\nwithout opening a subclass-dispatch path. The same boundary applies to the public manifest builder's\nentry sequence and scalar values and to injected archive-observation and filesystem-stat mappings;\nonly exact lists/tuples of exact JSON values and exact dictionaries, respectively, are accepted.\nRaw plan and manifest inputs must be exact built-in bytes before length, hashing, or equality work.\n\n## Residual hard gates\n\nThese primitives do not close:\n\n- owner execution approval and its trust mechanism;\n- binding a safely verified actual cache archive and manifest into an authorized plan;\n- safe archive traversal/type/link/device/content verification;\n- a trusted filesystem observer plus atomic capacity reservation;\n- the detached-worktree executor and first-parent source-reversal proof;\n- the classification truth table and receipt checker;\n- the private content-addressed log writer/checker; or\n- fail-closed cleanup and no-receipt-on-interruption behavior.\n\nCalibration membership, confirmatory holdout membership, model/provider execution, paid execution,\ncandidate execution, and benchmark execution remain forbidden.\n\n## Verification\n\nRun the focused static and synthetic checks from the confirmatory directory:\n\n```bash\npython3 -m unittest \\\n  test_task_negative_control_plan_v2.py \\\n  test_task_negative_control_gate_v1.py\npyright task_negative_control_gate_v1.py test_task_negative_control_gate_v1.py\n```\n\nThe tests use fabricated hashes, file inventories, and injected block counts only. They do not create\ncache archives, fill disk, create candidate worktrees, or run any of the 62 candidate tests.\n"},"started_at_ms":1789840285251,"completed_at_ms":1789840285251}}
{"timestamp":"2026-09-19T17:51:25.303Z","ordinal":7941,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0bacb-5e77-7241-93e8-ffb1c95cdbbf","call_id":"call_ORNSBURDwR4QC6CQGjhnsumU","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"4a914a\",\"wall_time_seconds\":0.000002292,\"exit_code\":0,\"original_token_count\":7825,\"output\":\"bytes 28759\\n['format_version', 'query', 'repo_root', 'commit', 'tree', 'profile', 'results', 'verify_command', 'coverage_note', 'stats', 'warnings', 'partial_failures', 'completeness']\\nresults [{'rank': 1, 'score': 22.2773, 'file_path': 'internal/cli/seed.go', 'start_line': 670, 'end_line': 676, 'focus_line': 670, 'snippet_start_line': 670, 'snippet_end_line': 676, 'symbol_start_line': 670, 'symbol_end_line': 676, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/seed.go:function:isEntrypointPath', 'symbol_name': 'isEntrypointPath', 'qualified_name': 'isEntrypointPath', 'signature': 'func isEntrypointPath(path string) bool', 'signals': ['body', 'symbol-name', 'graph:callers', 'complete-symbol'], 'snippet': 'func isEntrypointPath(path string) bool {\\\\n\\\\tbase := filepath.Base(path)\\\\n\\\\tif base == \\\"main.go\\\" || base == \\\"server.js\\\" || base == \\\"index.js\\\" || base == \\\"index.ts\\\" || base == \\\"index.tsx\\\" || base == \\\"main.jsx\\\" || base == \\\"main.tsx\\\" || base == \\\"App.jsx\\\" || base == \\\"App.tsx\\\" {\\\\n\\\\t\\\\treturn true\\\\n\\\\t}\\\\n\\\\treturn strings.HasPrefix(filepath.ToSlash(path), \\\"bin/\\\")\\\\n}'}, {'rank': 2, 'score': 22.0595, 'file_path': 'internal/cli/memory_abstract.go', 'start_line': 1473, 'end_line': 1521, 'focus_line': 1473, 'snippet_start_line': 1473, 'snippet_end_line': 1521, 'symbol_start_line': 1473, 'symbol_end_line': 1521, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/memory_abstract.go:function:validateSessionAbstractSchema', 'symbol_name': 'validateSessionAbstractSchema', 'qualified_name': 'validateSessionAbstractSchema', 'signature': 'func validateSessionAbstractSchema(artifact sessionAbstract) error', 'signals': ['body', 'signature', 'symbol-name', 'graph:callers', 'complete-symbol'], 'snippet': 'func validateSessionAbstractSchema(artifact sessionAbstract) error {\\\\n\\\\tif !strings.HasPrefix(artifact.SessionRef, conversationSessionIDPrefix) || strings.TrimSpace(strings.TrimPrefix(artifact.SessionRef, conversationSessionIDPrefix)) == \\\"\\\" || !validSHA256Identity(artifact.SessionDigest) {\\\\n\\\\t\\\\treturn errors.New(\\\"session_ref and session_digest identities are required\\\")\\\\n\\\\t}\\\\n\\\\tif artifact.GeneratedAt.IsZero() {\\\\n\\\\t\\\\treturn errors.New(\\\"generated_at is required\\\")\\\\n\\\\t}\\\\n\\\\tif artifact.Generator.Kind != \\\"local\\\" && artifact.Generator.Kind != \\\"hosted\\\" {\\\\n\\\\t\\\\treturn fmt.Errorf(\\\"unrecognized generator kind %q\\\", artifact.Generator.Kind)\\\\n\\\\t}\\\\n\\\\tif strings.TrimSpace(artifact.Generator.Provider) == \\\"\\\" || strings.TrimSpace(artifact.Generator.Model) == \\\"\\\" || artifact.Generator.ContractVersion != 1 {\\\\n\\\\t\\\\treturn errors.New(\\\"generator provider, model, and contract version are required\\\")\\\\n\\\\t}\\\\n\\\\tswitch strings.ToLower(strings.TrimSpace(artifact.Generator.Provider)) {\\\\n\\\\tcase \\\"ollama\\\":\\\\n\\\\t\\\\tif artifact.Generator.Kind != \\\"local\\\" {\\\\n\\\\t\\\\t\\\\treturn errors.New(\\\"ollama generator must be local\\\")\\\\n\\\\t\\\\t}\\\\n\\\\tcase \\\"codex\\\", \\\"claude-code\\\":\\\\n\\\\t\\\\tif artifact.Generator.Kind != \\\"hosted\\\" {\\\\n\\\\t\\\\t\\\\treturn errors.New(\\\"codex and claude-code generators must be hosted\\\")\\\\n\\\\t\\\\t}\\\\n\\\\tdefault:\\\\n\\\\t\\\\treturn fmt.Errorf(\\\"unrecognized generator provider %q\\\", artifact.Generator.Provider)\\\\n\\\\t}\\\\n\\\\tif artifact.Coverage.TotalTurns < 0 || artifact.Coverage.IncludedTurns < 0 || artifact.Coverage.IncludedTurns > artifact.Coverage.TotalTurns {\\\\n\\\\t\\\\treturn errors.New(\\\"coverage counts are invalid\\\")\\\\n\\\\t}\\\\n\\\\tif artifact.Coverage.IncludedTurns > abstractMaxTurns {\\\\n\\\\t\\\\treturn fmt.Errorf(\\\"coverage includes more than %d turns\\\", abstractMaxTurns)\\\\n\\\\t}\\\\n\\\\tif artifact.Coverage.IncludedTurns < artifact.Coverage.TotalTurns && !artifact.InputTruncated {\\\\n\\\\t\\\\treturn errors.New(\\\"partial coverage must declare input_truncated\\\")\\\\n\\\\t}\\\\n\\\\tif len(artifact.Coverage.IncludedRanges) > abstractRangesMax {\\\\n\\\\t\\\\treturn fmt.Errorf(\\\"coverage lists more than %d ranges\\\", abstractRangesMax)\\\\n\\\\t}\\\\n\\\\tpreviousEnd := 0\\\\n\\\\tfor _, item := range artifact.Coverage.IncludedRanges {\\\\n\\\\t\\\\tif item.StartTurn < 1 || item.EndTurn < item.StartTurn || (previousEnd > 0 && item.StartTurn <= previousEnd) {\\\\n\\\\t\\\\t\\\\treturn errors.New(\\\"coverage ranges must be positive, ordered, and non-overlapping\\\")\\\\n\\\\t\\\\t}\\\\n\\\\t\\\\tpreviousEnd = item.EndTurn\\\\n\\\\t}\\\\n\\\\tif (artifact.Coverage.IncludedTurns == 0) != (len(artifact.Coverage.IncludedRanges) == 0) {\\\\n\\\\t\\\\treturn errors.New(\\\"coverage ranges and included turn count disagree\\\")\\\\n\\\\t}\\\\n\\\\treturn validateAbstractStatementLists(artifact, nil)\\\\n}'}, {'rank': 3, 'score': 21.3895, 'file_path': 'internal/cli/distill.go', 'start_line': 130, 'end_line': 157, 'focus_line': 136, 'snippet_start_line': 136, 'snippet_end_line': 157, 'symbol_start_line': 136, 'symbol_end_line': 157, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/distill.go:function:injectAgentModel', 'symbol_name': 'injectAgentModel', 'qualified_name': 'injectAgentModel', 'signature': 'func injectAgentModel(args []string, agent, model string) []string', 'signals': ['body', 'symbol-name', 'graph:callers', 'complete-symbol'], 'snippet': 'func injectAgentModel(args []string, agent, model string) []string {\\\\n\\\\tif model == \\\"\\\" {\\\\n\\\\t\\\\treturn args\\\\n\\\\t}\\\\n\\\\tswitch agent {\\\\n\\\\tcase \\\"codex\\\":\\\\n\\\\t\\\\tif len(args) >= 2 && args[0] == \\\"codex\\\" && args[1] == \\\"exec\\\" {\\\\n\\\\t\\\\t\\\\treturn append(args[:2:2], append([]string{\\\"--model\\\", model}, args[2:]...)...)\\\\n\\\\t\\\\t}\\\\n\\\\tcase \\\"claude-code\\\":\\\\n\\\\t\\\\tif len(args) >= 1 && args[0] == \\\"claude\\\" {\\\\n\\\\t\\\\t\\\\treturn append(args[:1:1], append([]string{\\\"--model\\\", model}, args[1:]...)...)\\\\n\\\\t\\\\t}\\\\n\\\\tcase \\\"ollama\\\":\\\\n\\\\t\\\\tif len(args) >= 3 && args[0] == \\\"ollama\\\" {\\\\n\\\\t\\\\t\\\\tout := append([]string(nil), args...)\\\\n\\\\t\\\\t\\\\tout[1] = model\\\\n\\\\t\\\\t\\\\treturn out\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\treturn args\\\\n}'}, {'rank': 4, 'score': 21.1873, 'file_path': 'internal/cli/history.go', 'start_line': 3204, 'end_line': 3211, 'focus_line': 3204, 'snippet_start_line': 3204, 'snippet_end_line': 3211, 'symbol_start_line': 3204, 'symbol_end_line': 3211, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/history.go:function:validHistoryGenerationArtifactPath', 'symbol_name': 'validHistoryGenerationArtifactPath', 'qualified_name': 'validHistoryGenerationArtifactPath', 'signature': 'func validHistoryGenerationArtifactPath(rel, fileName string) bool', 'signals': ['body', 'symbol-name', 'graph:callers', 'complete-symbol'], 'snippet': 'func validHistoryGenerationArtifactPath(rel, fileName string) bool {\\\\n\\\\tparts := strings.Split(rel, \\\"/\\\")\\\\n\\\\tif len(parts) != 4 || parts[0] != historyDirName || parts[1] != \\\"generations\\\" || parts[3] != fileName || len(parts[2]) != 40 {\\\\n\\\\t\\\\treturn false\\\\n\\\\t}\\\\n\\\\t_, err := hex.DecodeString(parts[2])\\\\n\\\\treturn err == nil\\\\n}'}, {'rank': 5, 'score': 21.1773, 'file_path': 'internal/cli/session_privacy.go', 'start_line': 1380, 'end_line': 1459, 'focus_line': 1380, 'snippet_start_line': 1380, 'snippet_end_line': 1385, 'symbol_start_line': 1380, 'symbol_end_line': 1558, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/session_privacy.go:function:privacyDerivedStoreArtifacts', 'symbol_name': 'privacyDerivedStoreArtifacts', 'qualified_name': 'privacyDerivedStoreArtifacts', 'signature': 'func privacyDerivedStoreArtifacts(brainDir string) ([]string, error)', 'signals': ['graph:calls', 'graph:incoming', 'graph:callers'], 'snippet': 'func privacyDerivedStoreArtifacts(brainDir string) ([]string, error) {\\\\n\\\\trels := privacyDerivedStoreRels()\\\\n\\\\tpublication, _, publicationPresent, err := loadPatternCorpusPublicationForPrivacy(brainDir)\\\\n\\\\tif err != nil {\\\\n\\\\t\\\\treturn nil, err\\\\n\\\\t}'}, {'rank': 6, 'score': 21.1719, 'file_path': 'internal/cli/semantic_graph.go', 'start_line': 166, 'end_line': 216, 'focus_line': 214, 'snippet_start_line': 213, 'snippet_end_line': 214, 'symbol_start_line': 166, 'symbol_end_line': 216, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/semantic_graph.go:function:runSemanticGraphSchema', 'symbol_name': 'runSemanticGraphSchema', 'qualified_name': 'runSemanticGraphSchema', 'signature': 'func runSemanticGraphSchema(cmd *cobra.Command, opts Options, graphOpts semanticGraphSchemaOptions) error', 'signals': ['body', 'symbol-name', 'graph:callers'], 'snippet': '\\\\tfmt.Fprintf(cmd.OutOrStdout(), \\\"hotspots: %s\\\\\\\\n\\\", graphRanksText(report.Metrics.Hotspots))\\\\n\\\\tfmt.Fprintf(cmd.OutOrStdout(), \\\"entry_points: %s\\\\\\\\n\\\", graphRanksText(report.Metrics.EntryPoints))'}, {'rank': 7, 'score': 20.5805, 'file_path': 'benchmarks/agent-brain/confirmatory/schemas/negative-control-cache-bundle-verifier-contract-v2.schema.json', 'start_line': 74, 'end_line': 74, 'focus_line': 74, 'snippet_start_line': 74, 'snippet_end_line': 74, 'symbol_start_line': 74, 'symbol_end_line': 74, 'language': 'JSON', 'kind': 'section', 'symbol_id': 'gh/entireio/entire-brain:JSON:benchmarks/agent-brain/confirmatory/schemas/negative-control-cache-bundle-verifier-contract-v2.schema.json:section:format_artifact', 'symbol_name': 'format_artifact', 'qualified_name': 'format_artifact', 'signature': 'json key format_artifact', 'signals': ['path', 'body', 'symbol-name'], 'snippet': '        \\\"format_artifact\\\": {'}, {'rank': 8, 'score': 20.5564, 'file_path': 'benchmarks/agent-brain/confirmatory/schemas/negative-control-cache-bundle-verification-report-v2.schema.json', 'start_line': 50, 'end_line': 50, 'focus_line': 50, 'snippet_start_line': 50, 'snippet_end_line': 50, 'symbol_start_line': 50, 'symbol_end_line': 50, 'language': 'JSON', 'kind': 'section', 'symbol_id': 'gh/entireio/entire-brain:JSON:benchmarks/agent-brain/confirmatory/schemas/negative-control-cache-bundle-verification-report-v2.schema.json:section:format_artifact_sha256', 'symbol_name': 'format_artifact_sha256', 'qualified_name': 'format_artifact_sha256', 'signature': 'json key format_artifact_sha256', 'signals': ['path', 'body', 'symbol-name'], 'snippet': '        \\\"format_artifact_sha256\\\": {'}, {'rank': 9, 'score': 20.3037, 'file_path': 'internal/cli/mcp.go', 'start_line': 2228, 'end_line': 2233, 'focus_line': 2228, 'snippet_start_line': 2228, 'snippet_end_line': 2229, 'symbol_start_line': 2228, 'symbol_end_line': 2233, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/mcp.go:function:mcpGraphBinary', 'symbol_name': 'mcpGraphBinary', 'qualified_name': 'mcpGraphBinary', 'signature': 'func mcpGraphBinary() string', 'signals': ['body', 'symbol-name', 'graph:callers'], 'snippet': 'func mcpGraphBinary() string {\\\\n\\\\tif v := strings.TrimSpace(os.Getenv(\\\"ENTIRE_BRAIN_GRAPH_BINARY\\\")); v != \\\"\\\" {'}, {'rank': 10, 'score': 20.265, 'file_path': 'internal/cli/entities_provenance.go', 'start_line': 250, 'end_line': 269, 'focus_line': 258, 'snippet_start_line': 257, 'snippet_end_line': 258, 'symbol_start_line': 258, 'symbol_end_line': 269, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/entities_provenance.go:function:betterProvenance', 'symbol_name': 'betterProvenance', 'qualified_name': 'betterProvenance', 'signature': 'func betterProvenance(current, candidate entityProvenanceCandidate) bool', 'signals': ['path', 'body', 'symbol-name', 'graph:callers'], 'snippet': '// run. Two candidates that tie all four ways are the same candidate.\\\\nfunc betterProvenance(current, candidate entityProvenanceCandidate) bool {'}, {'rank': 11, 'score': 0, 'file_path': 'internal/cli/distill_test.go', 'start_line': 373, 'end_line': 409, 'focus_line': 407, 'snippet_start_line': 406, 'snippet_end_line': 409, 'kind': 'function', 'qualified_name': 'TestInjectAgentModel', 'signals': ['related:covering-test'], 'section': 'covering-test', 'snippet': '\\\\tif !slices.Equal(injectAgentModel(cmd, \\\"command\\\", \\\"x\\\"), cmd) {\\\\n\\\\t\\\\tt.Errorf(\\\"command agent should be a no-op for model injection\\\")\\\\n\\\\t}\\\\n}'}]\\nsymbols \\nmatches \\n# Darwin capacity observation v1\\n\\nThis diagnostic closes one measurement ambiguity without authorizing execution. On APFS, `df /`\\ncombines a shared container ceiling, sealed System-volume usage, and shared immediately unallocated\\nblocks. It does not report the same capacity macOS exposes to important work after reclaiming\\npurgeable data.\\n\\n`negative_control_darwin_capacity_v1.swift` reads four documented Foundation volume-capacity values\\nfor one caller-supplied absolute volume path:\\n\\n- total capacity;\\n- immediately available capacity;\\n- capacity available for important usage;\\n- capacity available for opportunistic usage.\\n\\nThe path is never emitted. Output is compact, sorted-key UTF-8 JSON with one LF and validates against\\n`schemas/negative-control-darwin-capacity-observation-v1.schema.json`. The exact planning threshold is\\n16 GiB (`17,179,869,184` bytes). Both raw-free and important-usage comparisons are reported so one\\ncannot be silently substituted for the other.\\n\\nThe observation is deliberately `live_unattested_capacity_observation_execution_forbidden`. It has\\nno signing, subprocess, Git, Go, worktree, candidate, model, network, private-log, or reservation\\nsurface. Even a passing important-usage comparison leaves execution forbidden because this slice\\ndoes not authenticate the observer, reserve capacity, enforce the staging ceiling, or attest cleanup.\\n\\nOn 2026-07-17, the same Foundation API reported about 191.9 GB available for important usage on the\\nData volume, matching System Settings. That live value is not checked in because it changes over\\ntime. The earlier report that treated roughly 13 GB of immediately unallocated blocks as total usable\\ncapacity was incorrect and is withdrawn.\\n\\n## Local diagnostic\\n\\nCompile and observe the Data volume without writing an artifact into the repository:\\n\\n```bash\\n/usr/bin/xcrun swiftc \\\\\\n  benchmarks/agent-brain/confirmatory/negative_control_darwin_capacity_v1.swift \\\\\\n  -o /tmp/negative-control-darwin-capacity-v1\\n/tmp/negative-control-darwin-capacity-v1 /System/Volumes/Data\\n```\\n\\nRun the focused synthetic/live-observation checks from the confirmatory directory:\\n\\n```bash\\npython3 -m unittest test_negative_control_darwin_capacity_v1.py\\n```\\n\\nBefore any scheduled attempt, a later gate must pin and authenticate the observer, atomically reserve\\nbounded staging capacity, enforce the 8 GiB staging ceiling plus 8 GiB reserve, and attest cleanup.\\n# Negative-control private raw-log primitive v1\\n\\nStatus: synthetic-tested storage primitive only. It does not authorize or perform candidate, Git,\\nGo, worktree, network, model/provider, private-data, holdout, benchmark, or paid execution.\\n\\n`negative_control_private_log.py` implements the private content-addressed raw-log writer and checker\\nrequired by the pending multi-repository negative-control plan. It deliberately has no CLI, executor,\\nretention-deletion function, or public-receipt writer. The library returns canonical receipt bytes\\nonly after a raw content file is fully published and reverified, so an interrupted call cannot emit a\\npartial public receipt.\\n\\n## Private storage contract\\n\\nThe caller supplies an already-existing dedicated private root. The root must both be and resolve to\\nthe same current-user, non-symlink directory with exact mode `0700`. The primitive creates exactly:\\n\\n- `.negative-control-private-log.lock`, a current-user regular, non-symlink, non-hardlink file with\\n  exact mode `0600`; and\\n- `sha256/`, a current-user non-symlink directory with exact mode `0700`.\\n\\nThe lock is acquired exclusively and nonblocking. All store enumeration, size/count accounting,\\nwriting, publication, checking, and future cleanup by cooperating same-UID processes **must** occur\\nwhile it is held. A busy or malformed lock fails immediately. This owner-only advisory lock is the\\nrequired coordination boundary; it cannot stop a noncooperating process with the same UID from\\nmutating a pathname after the final check. Such a process can always race an advisory-lock protocol,\\nso no stronger OS-isolation claim is made.\\n\\nEach final raw log is `sha256/<sha256-of-exact-raw-bytes>`. Final files must be current-user regular,\\nnon-symlink, non-hardlink files with exact mode `0600`. Untrusted regular-file opens use\\n`O_NOFOLLOW`, `O_NONBLOCK`, and descriptor-relative paths. Before a write, the pinned `sha256`\\ndirectory is incrementally enumerated through its open descriptor and every entry's type, owner,\\nmode, link count, and size contributes to the actual total. Enumeration stops at the final-file\\nlimit plus one without first materializing an unbounded name list. Caller-reported accounting is not\\naccepted.\\n\\nInput is streamed into an exclusive `0600` temporary file while SHA-256 and byte count are computed.\\nOnly after the file is complete and synchronized does descriptor-relative `link(2)` publish the digest\\nname without replacement. The temporary name is then removed, the final link count must be one, and\\nthe final bytes are streamed and hashed again. After hashing, a descriptor-relative, non-following\\npathname stat must prove the digest name still resolves to the opened inode with the complete expected\\nmetadata. A pre-existing exact digest is deduplicated and never overwritten; a pre-existing digest\\nname with different bytes fails closed.\\n\\nThe exact frozen ceilings are 16 MiB per arm, 2 GiB total stored raw-log content, and 4,096 final\\ncontent files. The frozen plan has 62 candidates × 2 arms × 2 repetitions = 248 planned arm logs;\\n4,096 provides more than 16× headroom while keeping enumeration and in-memory inventory bounded.\\nTests may inject only smaller positive ceilings. The total is the secure sum of actual final files\\nunder the exclusive lock. Admission for a new digest happens after hashing; therefore an exact\\nduplicate adds zero stored bytes and remains valid when the byte or file-count store is at its\\nceiling, while a new digest is rejected.\\n\\n## Public receipt contract\\n\\nThe public receipt contains exactly two fields and one trailing LF:\\n\\n```json\\n{\\\"raw_log_byte_count\\\":9,\\\"raw_log_sha256\\\":\\\"<64 lowercase hex>\\\"}\\n```\\n\\nThe schema is `schemas/negative-control-private-log-receipt-v1.schema.json`. The runtime checker\\nrejects duplicate keys, extra/missing fields, floats and booleans as byte counts, invalid UTF-8 or\\nJSON, noncanonical key order/spacing, extra newlines, out-of-range counts, missing content addresses,\\nand byte/hash drift.\\n\\nNo raw content, filesystem path, host identity, secret, command, or redaction status is included.\\nRaw logs may contain secrets. This primitive makes **no redaction claim**; privacy comes from the\\nprivate root and exact file controls, not from content transformation. `PrivateLogError` failures\\ncreated by the primitive use fixed descriptions and never interpolate raw input or a private path.\\nCaller-originated `BaseException` instances, including cancellation such as `KeyboardInterrupt`, are\\npropagated unchanged to preserve cancellation semantics and are outside that non-leaking claim.\\n\\n## Interruption and residual gates\\n\\nDirectory synchronization fails closed on every `OSError`; unsupported/error returns are not treated\\nas durable success. Before publication, normal exception cleanup removes the temporary file and leaves\\nno final digest or returned receipt. After the atomic link, an exception can leave a complete final\\ncontent file without a receipt. If both temporary cleanup and digest rollback unlink fail—or a process\\nis killed in the brief publication interval—the complete temporary and digest names may remain as a\\ntwo-link inode. No receipt is returned, and later exact enumeration rejects the temporary name/link\\ncount until a separately audited cleanup mechanism repairs it.\\n\\nThis slice intentionally does not implement:\\n\\n- retention deletion or enforcement of the plan's seven-day expiry;\\n- orphan cleanup or interruption attestation;\\n- a global byte-hash scrub of unrelated pre-existing digest names (every bounded entry is metadata-checked,\\n  and the receipt target is exact-byte checked);\\n- receipt-file publication or aggregate receipt accounting;\\n- classification, executor, reversal, worktree, cache-seed, resource-preflight, owner-approval, or\\n  trust mechanisms; or\\n- any update that makes the frozen pending plan executable.\\n\\nThose remain residual gates. The primitive alone cannot authorize a negative-control run.\\n\\n## Synthetic verification\\n\\nFrom `benchmarks/agent-brain/confirmatory`:\\n\\n```bash\\npython3 -m unittest test_negative_control_private_log.py -v\\n```\\n\\nThe focused tests use only temporary roots and in-memory synthetic byte streams. Tightened limits\\nexercise the 16 MiB/2 GiB arithmetic without allocating large fixtures. They also cover symlinks,\\nhardlinks, wrong modes, FIFOs and nonregular entries, a busy lock, strict directory synchronization,\\nbounded file-count admission, no-overwrite behavior, exact deduplication at a full store, deterministic\\npathname replacement, mutation, canonical receipts, fixed `PrivateLogError` messages, cancellation,\\nand interruption before and after atomic publication—including the rejected two-link residual state.\\n# Negative-control gate primitives v1\\n\\nThis slice implements two pure, unpaid prerequisites for the pending multi-repository negative-control\\nplan: an exact offline Go cache-seed identity manifest and deterministic injected resource arithmetic.\\nIt does not supply an actual cache archive, inspect an archive, observe host free space, reserve disk,\\ncreate a worktree, invoke a candidate, run Git or Go, contact a provider, or authorize execution.\\n\\n`task_negative_control_gate_v1.py` has exactly two CLI lanes: `check-manifest` checks a cache manifest\\nagainst the pending plan and manifest schema, while `check-receipt` additionally checks a canonical\\nprimitive receipt against that exact plan, manifest, and both schemas. The CLI only reads JSON and\\nschema/module bytes. There is deliberately no build, extract, fetch, filesystem-probe, executor, or\\nreceipt-writing command.\\n\\nBoth lanes are pinned to the checked plan self-hash\\n`a47311fa1f4553f8085ebea6e8ddd003a4ea5d0b2d269d91bbcdd414134a248e` and exact rendered-file\\nSHA-256 `f55b6e22a25daf8016305304adf3b7ac8d31675281d97cfc9bb78cc76b619790`. The API also rebuilds the\\nplan through `verify_plan_dependencies` from the checked repository contract, eligibility schema,\\nthree v2 ledgers, run-plan schema, overlap registry, and registry schema. A self-resealed plan with a\\ndifferent candidate, ledger, registry, eligibility, builder, schema, or Go/native/Git toolchain\\nidentity is therefore rejected.\\n\\n## Cache identity primitive\\n\\nA manifest built through the Python API binds:\\n\\n- the exact checked plan and each repository's complete Go, native compiler, and Git toolchain\\n  projection;\\n- the gate builder, run-plan builder, schema validator, all transitively used local verifier source\\n  files, and manifest schema bytes;\\n- the Python implementation, Python version, resolved interpreter executable SHA-256, and\\n  `unicodedata.unidata_version` that define parsing and case-fold behavior;\\n- a basename-only, NFC-normalized archive name plus its declared SHA-256 and byte count;\\n- a sorted file inventory under only `gocache/` or `gomodcache/`, with globally unique canonical\\n  archive paths, repository ownership, exact file byte counts, and file SHA-256 values; and\\n- the frozen 2 GiB compressed and unpacked cache-seed ceilings.\\n\\nEvery repository must have at least one cache entry and every entry must declare at least one byte.\\nExact NFC paths must also be unique under the per-component portable key\\n`NFC(casefold(NFC(component)))`; duplicates and ancestor prefixes are rejected globally regardless\\nof repository or input order. This closes ASCII case, Unicode fold (including `ß`/`ss`), and\\ncanonical-composition aliases before a future extractor chooses host paths.\\n\\nThe v1 profile freezes a maximum of 250,000 entries and 128 MiB of canonical rendered manifest\\nbytes. The JSON schema has the same `maxItems`/count/byte bounds and intentionally does not use\\n`uniqueItems`; the verifier uses bounded O(n) sets for exact and portable collision checks. These are\\nconservative planning ceilings intended to leave room for three substantial Go caches while bounding\\nmemory and parser work. They are not a measurement of an actual seed. The future archive-preparation\\nstep must prove the real inventory fits—including the non-zero-file rule—or version the profile and\\nschema rather than silently raising a ceiling.\\n\\nHost-shared cache reuse and network dependency resolution remain `forbidden`. The checked-in pending\\nplan still has null archive, manifest, source, and unpacked-size locators: this slice intentionally\\ndoes not fabricate or bind an actual seed.\\n\\nThe manifest and receipt schema arguments are not caller-defined policy. Their raw bytes must match\\nthe pinned checked-in v1 schema SHA-256 values (`37d3839411b2e30a99fdd7e93784d56f5fd525c0472717a24cc7b92213b98999`\\nand `7603f755dd8429ff8c0a17114a50cda0aa23ae99c07cf2cfff9856df00c0a8e0`, respectively); an alternate\\npath is accepted only when its bytes are identical. Manual fail-closed invariants remain authoritative\\nand schema validation is additionally executed.\\n\\nThe preflight API can compare an injected archive-identity observation with a manifest, but labels that\\nobservation `injected_archive_identity_unattested`. Matching declared hashes and counts is not safe\\narchive verification. A future gate must traverse an actual archive fail-closed, reject unsafe paths,\\nnon-regular entries, links and devices, hash every extracted file, and then bind that verified archive\\ninto a separately authorized plan.\\n\\n## Injected resource arithmetic\\n\\n`evaluate_injected_resource_stats` accepts only `fragment_size_bytes` and `available_blocks`. It\\nrecomputes available bytes, checks the frozen `8 GiB reserve + 8 GiB staging = 16 GiB minimum`, and\\nrejects anything below the threshold. It does not call `statvfs`, identify a filesystem, reserve\\ncapacity, or eliminate time-of-check/time-of-use races. A synthetic 11 GiB observation therefore\\nfails deterministically without consuming disk, while an exact 16 GiB observation passes the pure\\narithmetic primitive.\\n\\nBoth injected factors and every emitted variable resource integer have the explicit maximum\\n`10^64 - 1`, the largest non-negative value admitted by the 64-digit JSON profile. This is far above\\nthe frozen 16 GiB threshold, so it does not weaken the plan's lower-bound arithmetic. Multiplication\\nis division-guarded (`available_blocks <= maximum // fragment_size_bytes`) before it occurs; two\\nindividually valid 64-digit factors therefore cannot create an unparseable derived value. The receipt\\nschema repeats the same maxima for blocks, fragment size, free bytes, and headroom.\\n\\nA deterministic primitive receipt binds the exact canonical plan and manifest bytes, both schemas,\\nall implementation dependencies, the injected observations, and its own self-hash. Its status is\\n`primitive_checks_passed_execution_forbidden`, its cache binding remains\\n`external_manifest_not_bound_by_pending_plan`, and its execution status remains\\n`forbidden_missing_remaining_gates`.\\n\\n## Bounded input profile\\n\\nBefore JSON parsing, the checker opens only stable regular files with mandatory close-on-exec,\\nno-follow, and nonblocking flags, checks size with `fstat`, reads no more than the frozen ceiling, and\\nrejects any metadata change during the read. Symlinks, FIFOs, same-size mutation races, duplicate\\nkeys, floats/non-finite numbers, integers longer than 64 digits, and nesting deeper than 64 levels\\nfail closed with CLI exit 2 and no traceback. Raw limits are 1 MiB for the checked plan, 128 MiB for\\nthe manifest, and 4 MiB each for schemas and the primitive receipt. Validators recheck canonical\\nrendered byte counts after manual shape/count/scalar bounds, so a constructed Python object cannot\\nbypass the file parser or force an unbounded render before basic rejection. The same iterative\\ndepth/integer/no-float validator runs on every Python-constructed and API-validated manifest and\\nreceipt before self-hashing or schema validation. Consequently, any artifact successfully built and\\ncanonically rendered by the Python API is accepted by the CLI parser under the same JSON profile.\\n\\nConstructed inputs must also be JSON trees: every `dict`, `list`, or `tuple` identity may appear only\\nonce. Cycles and repeated container aliases are rejected before re-expansion; repeated immutable\\nscalar values remain valid. The traversal charges one node for each container or scalar value (object\\nkeys are not value nodes) and freezes a 1,260,000-node ceiling:\\n`250,000 entries * (one entry object + four scalar values) + 10,000 fixed-envelope nodes`. The\\n10,000-node allowance conservatively covers the manifest's fixed metadata and provenance as well as\\nthe much smaller receipt, checked plan, and pinned schemas. Child counts are charged against the\\nremaining budget before they are pushed, bounding the pending stack. The identity set and node\\ncounter therefore make traversal linear in the visited JSON tree and prevent an alias DAG from\\nexpanding exponentially. Parsed CLI JSON already has tree semantics, so valid file behavior is\\nunchanged.\\n\\nThe constructed-input profile admits only exact built-in `dict`, `list`, `str`, `int`, `bool`, and\\n`None` values. Exact built-in tuples are retained only for Python API canonicalization and render as\\nJSON arrays; parsed CLI arrays remain lists. Built-in floats retain their dedicated rejection, while\\nall subclasses and other custom objects are rejected by exact `type` before any attacker-overridable\\nlength, truth, iteration, mapping, comparison, or encoding method can run. Object keys likewise must\\nbe exact built-in strings. The manifest's root/contents/file-count envelope guards enforce those exact\\ncontainer and key types before using `set`, truth, or `len`, preserving the 250,000-entry precedence\\nwithout opening a subclass-dispatch path. The same boundary applies to the public manifest builder's\\nentry sequence and scalar values and to injected archive-observation and filesystem-stat mappings;\\nonly exact lists/tuples of exact JSON values and exact dictionaries, respectively, are accepted.\\nRaw plan and manifest inputs must be exact built-in bytes before length, hashing, or equality work.\\n\\n## Residual hard gates\\n\\nThese primitives do not close:\\n\\n- owner execution approval and its trust mechanism;\\n- binding a safely verified actual cache archive and manifest into an authorized plan;\\n- safe archive traversal/type/link/device/content verification;\\n- a trusted filesystem observer plus atomic capacity reservation;\\n- the detached-worktree executor and first-parent source-reversal proof;\\n- the classification truth table and receipt checker;\\n- the private content-addressed log writer/checker; or\\n- fail-closed cleanup and no-receipt-on-interruption behavior.\\n\\nCalibration membership, confirmatory holdout membership, model/provider execution, paid execution,\\ncandidate execution, and benchmark execution remain forbidden.\\n\\n## Verification\\n\\nRun the focused static and synthetic checks from the confirmatory directory:\\n\\n```bash\\npython3 -m unittest \\\\\\n  test_task_negative_control_plan_v2.py \\\\\\n  test_task_negative_control_gate_v1.py\\npyright task_negative_control_gate_v1.py test_task_negative_control_gate_v1.py\\n```\\n\\nThe tests use fabricated hashes, file inventories, and injected block counts only. They do not create\\ncache archives, fill disk, create candidate worktrees, or run any of the 62 candidate tests.\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789840285.303891}}}
