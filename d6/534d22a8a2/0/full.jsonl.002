{"timestamp":"2026-09-19T17:39:55.915Z","ordinal":7538,"type":"token_usage_record","payload":{"thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","session_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","root_turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","response_id":"resp_0cb48b2b18d09e75016aaec8e7760087d289a04795c97d3313","usage":{"input_tokens":134967,"cached_input_tokens":129664,"cache_write_input_tokens":0,"output_tokens":72,"reasoning_output_tokens":21,"total_tokens":135039},"turn_token_usage":{"input_tokens":72739921,"cached_input_tokens":69590400,"cache_write_input_tokens":0,"output_tokens":171752,"reasoning_output_tokens":14590,"total_tokens":72911673},"thread_token_usage":{"input_tokens":138624940,"cached_input_tokens":132162432,"cache_write_input_tokens":0,"output_tokens":356551,"reasoning_output_tokens":35967,"total_tokens":138981491}}}
{"timestamp":"2026-09-19T17:39:55.932Z","ordinal":7539,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","item":{"type":"CommandExecution","id":"exec-7f8d9478-af73-462e-b452-bb79baecd89e","process_id":"98081","command":["/bin/zsh","-lc","sed -n '421,970p' benchmarks/agent-brain/confirmatory/power_analysis_v4.py"],"cwd":"file:///Users/thomi/.codex/worktrees/5d33/entire-brain","parsed_cmd":[{"type":"read","cmd":"sed -n '421,970p' benchmarks/agent-brain/confirmatory/power_analysis_v4.py","name":"power_analysis_v4.py","path":"benchmarks/agent-brain/confirmatory/power_analysis_v4.py"}],"source":"unified_exec_startup","status":"completed","stdout":"\n    def union(left: str, right: str) -> None:\n        left_root = find(left)\n        right_root = find(right)\n        if left_root != right_root:\n            first, second = sorted((left_root, right_root))\n            parent[second] = first\n\n    for field in (\"family_commitment_sha256\",):\n        groups: dict[str, list[str]] = defaultdict(list)\n        for ref, member in refs.items():\n            groups[str(member[field])].append(ref)\n        for group in groups.values():\n            for ref in group[1:]:\n                union(group[0], ref)\n    for artifact_field in (\"fix_commitment_sha256\",):\n        groups = defaultdict(list)\n        for ref, member in refs.items():\n            groups[str(member[\"artifacts\"][artifact_field])].append(ref)\n        for group in groups.values():\n            for ref in group[1:]:\n                union(group[0], ref)\n    session_groups: dict[str, list[str]] = defaultdict(list)\n    for ref, member in refs.items():\n        for session in member[\"source_session_commitments\"]:\n            session_groups[str(session)].append(ref)\n    for group in session_groups.values():\n        for ref in group[1:]:\n            union(group[0], ref)\n    for edge in population[\"related_task_edges\"]:\n        left = str(edge[\"left_member_ref\"])\n        right = str(edge[\"right_member_ref\"])\n        if edge[\"material\"] is True and left in refs and right in refs:\n            union(left, right)\n\n    components: dict[str, list[str]] = defaultdict(list)\n    for ref in sorted(refs):\n        components[find(ref)].append(ref)\n    by_task: dict[str, str] = {}\n    cluster_rows: list[dict[str, Any]] = []\n    for member_refs in sorted(components.values()):\n        active_members = [ref for ref in member_refs if ref in active_refs]\n        if not active_members:\n            continue\n        cluster_sha = PRODUCT.value_sha256(\n            {\n                \"algorithm\": \"family_fix_session_material_edge_transitive_closure_v1\",\n                \"member_refs\": member_refs,\n            }\n        )\n        task_ids = sorted(str(refs[ref][\"task_id\"]) for ref in active_members)\n        for task_id in task_ids:\n            by_task[task_id] = cluster_sha\n        cluster_rows.append(\n            {\n                \"independence_cluster_sha256\": cluster_sha,\n                \"member_refs\": member_refs,\n                \"task_ids\": task_ids,\n            }\n        )\n    return by_task, PRODUCT.value_sha256(cluster_rows)\n\n\ndef _derive_population_binding(\n    *,\n    bundle: ArtifactBundle,\n    product_root: Mapping[str, Any],\n) -> tuple[dict[str, Any], list[str], dict[str, str]]:\n    population = bundle.task_population.value\n    selection = population[\"selection_policy\"]\n    split = population[\"split_policy\"]\n    receipt_specs = (\n        (\n            bundle.selection_receipt,\n            \"selection\",\n            selection,\n            \"selection_receipt_sha256\",\n        ),\n        (\n            bundle.assignment_receipt,\n            \"assignment\",\n            split,\n            \"assignment_receipt_sha256\",\n        ),\n        (\n            bundle.overlap_receipt,\n            \"overlap_commitment\",\n            split,\n            \"overlap_commitment_receipt_sha256\",\n        ),\n    )\n    for artifact, kind, subject, field in receipt_specs:\n        _require(subject[field] == artifact.sha256, f\"{kind} receipt raw-byte hash drift\")\n        _validate_population_receipt(\n            artifact,\n            expected_kind=kind,\n            expected_subject_sha256=_population_receipt_subject_sha256(\n                population, kind\n            ),\n        )\n\n    calibration_members = [\n        member\n        for member in population[\"members\"]\n        if member[\"membership\"] == \"development_calibration\"\n        and member[\"contamination_state\"] != \"excluded\"\n    ]\n    _require(\n        all(member[\"contamination_state\"] == \"reviewed_clear\" for member in calibration_members),\n        \"calibration population contains a non-reviewed-clear active member\",\n    )\n    cluster_by_task, closure_sha = _independence_clusters(\n        population, calibration_members\n    )\n    cluster_count = len(set(cluster_by_task.values()))\n    _require(\n        cluster_count >= MIN_CALIBRATION_CLUSTERS,\n        \"final calibration requires at least 12 derived independent clusters\",\n    )\n    _require(\n        cluster_count == len(calibration_members),\n        \"candidate sizing requires one mutually independent calibration task per derived cluster\",\n    )\n    product_tasks = {str(task[\"task_id\"]): task for task in product_root[\"tasks\"]}\n    task_ids = sorted(str(member[\"task_id\"]) for member in calibration_members)\n    _require(\n        task_ids == sorted(product_tasks),\n        \"raw product-cycle tasks do not exactly match validated calibration members\",\n    )\n    task_hashes = [str(product_tasks[task_id][\"task_sha256\"]) for task_id in task_ids]\n    _require(\n        len(task_hashes) == len(set(task_hashes)),\n        \"calibration product task hashes must be unique\",\n    )\n    projected_members: list[dict[str, Any]] = []\n    for member in sorted(calibration_members, key=lambda item: str(item[\"task_id\"])):\n        task_id = str(member[\"task_id\"])\n        projected = {\n            \"member_ref\": member[\"member_ref\"],\n            \"membership\": member[\"membership\"],\n            \"task_id\": task_id,\n            \"task_id_sha256\": member[\"task_id_sha256\"],\n            \"product_task_sha256\": product_tasks[task_id][\"task_sha256\"],\n            \"task_overlap_commitment_sha256\": member[\n                \"task_overlap_commitment_sha256\"\n            ],\n            \"family_commitment_sha256\": member[\"family_commitment_sha256\"],\n            \"fix_commitment_sha256\": member[\"artifacts\"][\"fix_commitment_sha256\"],\n            \"source_session_commitments\": sorted(member[\"source_session_commitments\"]),\n            \"contamination_state\": member[\"contamination_state\"],\n            \"review_commitment_sha256\": member[\"review_commitment_sha256\"],\n            \"independence_cluster_sha256\": cluster_by_task[task_id],\n        }\n        projected[\"identity_sha256\"] = _self_sha256(projected)\n        projected_members.append(projected)\n    binding: dict[str, Any] = {\n        \"schema_version\": 2,\n        \"profile\": TASK_POPULATION_PROFILE,\n        \"status\": population[\"status\"],\n        \"schema_file_sha256\": bundle.schemas[\"task_population\"].sha256,\n        \"population_sha256\": population[\"population_sha256\"],\n        \"source_file_sha256\": bundle.task_population.sha256,\n        \"review_ledger_sha256\": bundle.review_ledger.value[\"ledger_sha256\"],\n        \"review_ledger_file_sha256\": bundle.review_ledger.sha256,\n        \"selection_verification_status\": selection[\"selection_verification_status\"],\n        \"selection_receipt_file_sha256\": bundle.selection_receipt.sha256,\n        \"assignment_verification_status\": split[\"assignment_verification_status\"],\n        \"assignment_receipt_file_sha256\": bundle.assignment_receipt.sha256,\n        \"overlap_commitment_verification_status\": split[\n            \"overlap_commitment_verification_status\"\n        ],\n        \"overlap_commitment_receipt_file_sha256\": bundle.overlap_receipt.sha256,\n        \"calibration_min_independent_tasks\": split[\n            \"calibration_min_independent_tasks\"\n        ],\n        \"holdout_plaintext\": split[\"holdout_plaintext\"],\n        \"independence_closure_algorithm\": \"family_fix_session_material_edge_transitive_closure_v1\",\n        \"independence_cluster_count\": cluster_count,\n        \"independence_projection_sha256\": closure_sha,\n        \"calibration_members\": projected_members,\n    }\n    binding[\"identity_sha256\"] = _self_sha256(binding)\n    return binding, task_ids, cluster_by_task\n\n\ndef _validate_population_binding(\n    value: Any,\n    *,\n    bundle: ArtifactBundle,\n    product_root: Mapping[str, Any],\n) -> tuple[list[str], dict[str, dict[str, Any]], dict[str, str]]:\n    expected, task_ids, cluster_by_task = _derive_population_binding(\n        bundle=bundle, product_root=product_root\n    )\n    _require(value == expected, \"task-population projection differs from validated raw artifacts\")\n    by_task = {member[\"task_id\"]: member for member in expected[\"calibration_members\"]}\n    return task_ids, by_task, cluster_by_task\n\n\ndef _precalibration_plan_sha256(product_root: Mapping[str, Any]) -> str:\n    \"\"\"Hash only inputs that exist before any calibration outcome is opened.\"\"\"\n    design = product_root[\"design\"]\n    return PRODUCT.value_sha256(\n        {\n            \"schema\": \"agent-brain-product-cycle-precalibration-plan/v1\",\n            \"purpose\": product_root[\"purpose\"],\n            \"evidence_class\": product_root[\"evidence_class\"],\n            \"claim_scope\": product_root[\"claim_scope\"],\n            \"product_identity_binding_sha256\": product_root[\"product_identities\"][\n                \"binding_sha256\"\n            ],\n            \"task_inventory_sha256\": product_root[\"task_inventory_sha256\"],\n            \"shared_execution_identity_sha256\": product_root[\"shared_execution\"][\n                \"identity_sha256\"\n            ],\n            \"arms\": design[\"arms\"],\n            \"arm_product_roles\": design[\"arm_product_roles\"],\n            \"primary_contrast\": design[\"primary_contrast\"],\n            \"diagnostic_contrast\": design[\"diagnostic_contrast\"],\n            \"task_clusters\": design[\"task_clusters\"],\n            \"repetitions_per_arm\": design[\"repetitions_per_arm\"],\n            \"requested_cells\": design[\"requested_cells\"],\n            \"agent_retry_limit\": design[\"agent_retry_limit\"],\n            \"replacement_cell_limit\": design[\"replacement_cell_limit\"],\n            \"reserve_cell_limit\": design[\"reserve_cell_limit\"],\n            \"maximum_agent_invocations\": design[\"maximum_agent_invocations\"],\n            \"budget\": design[\"budget\"],\n            \"schedule_sha256\": product_root[\"shared_execution\"][\"schedule_sha256\"],\n        }\n    )\n\n\ndef _file_sha256(path: pathlib.Path, label: str) -> str:\n    return hashlib.sha256(_read_regular_bytes(path, label)).hexdigest()\n\n\ndef _expected_implementation_lock(bundle: ArtifactBundle) -> dict[str, Any]:\n    \"\"\"Build the exact lock for the current analyzer, validators, and schemas.\"\"\"\n    lock: dict[str, Any] = {\n        \"schema\": \"agent-brain-power-v4-implementation-lock/v1\",\n        \"analyzer_path\": \"benchmarks/agent-brain/confirmatory/power_analysis_v4.py\",\n        \"analyzer_file_sha256\": _file_sha256(\n            HERE / \"power_analysis_v4.py\", \"power-v4 analyzer\"\n        ),\n        \"draft202012_validator_file_sha256\": _file_sha256(\n            HERE / \"draft202012.py\", \"Draft 2020-12 validator\"\n        ),\n        \"product_cycle_validator_file_sha256\": _file_sha256(\n            HERE / \"product_cycle.py\", \"product-cycle validator\"\n        ),\n        \"task_population_validator_file_sha256\": _file_sha256(\n            HERE / \"task_population.py\", \"task-population validator\"\n        ),\n        \"product_cycle_schema_file_sha256\": bundle.schemas[\"product_cycle\"].sha256,\n        \"task_population_schema_file_sha256\": bundle.schemas[\"task_population\"].sha256,\n        \"review_ledger_schema_file_sha256\": bundle.schemas[\"review_ledger\"].sha256,\n        \"final_calibration_schema_file_sha256\": bundle.schemas[\n            \"final_calibration\"\n        ].sha256,\n        \"power_report_schema_file_sha256\": bundle.schemas[\"power_report\"].sha256,\n        \"population_receipt_schema_file_sha256\": bundle.schemas[\n            \"population_receipt\"\n        ].sha256,\n        \"candidate_lock_receipt_schema_file_sha256\": bundle.schemas[\n            \"candidate_lock_receipt\"\n        ].sha256,\n        \"owner_approval_receipt_schema_file_sha256\": bundle.schemas[\n            \"owner_approval_receipt\"\n        ].sha256,\n    }\n    lock[\"identity_sha256\"] = _self_sha256(lock)\n    return lock\n\n\ndef _validate_implementation_lock(\n    value: Any, *, bundle: ArtifactBundle\n) -> dict[str, Any]:\n    lock = _exact_keys(\n        value,\n        {\n            \"schema\",\n            \"analyzer_path\",\n            \"analyzer_file_sha256\",\n            \"draft202012_validator_file_sha256\",\n            \"product_cycle_validator_file_sha256\",\n            \"task_population_validator_file_sha256\",\n            \"product_cycle_schema_file_sha256\",\n            \"task_population_schema_file_sha256\",\n            \"review_ledger_schema_file_sha256\",\n            \"final_calibration_schema_file_sha256\",\n            \"power_report_schema_file_sha256\",\n            \"population_receipt_schema_file_sha256\",\n            \"candidate_lock_receipt_schema_file_sha256\",\n            \"owner_approval_receipt_schema_file_sha256\",\n            \"identity_sha256\",\n        },\n        \"v4_implementation_lock\",\n    )\n    expected = _expected_implementation_lock(bundle)\n    for field, expected_value in expected.items():\n        _require(lock[field] == expected_value, f\"v4 implementation lock drift: {field}\")\n    _require(\n        lock[\"identity_sha256\"] == _self_sha256(lock),\n        \"v4 implementation lock identity hash mismatch\",\n    )\n    return lock\n\n\ndef _validate_execution_contract(\n    value: Any, *, product_root: Mapping[str, Any]\n) -> dict[str, Any]:\n    contract = _exact_keys(\n        value,\n        {\n            \"schema\",\n            \"status\",\n            \"provider_id\",\n            \"agent_cli_id\",\n            \"agent_cli_version\",\n            \"requested_model_id\",\n            \"resolved_model_id\",\n            \"effort\",\n            \"runner_sha256\",\n            \"timeout_policy_sha256\",\n            \"agent_timeout_limit_seconds\",\n            \"timeout_component_limit_seconds\",\n            \"identity_sha256\",\n        },\n        \"execution_contract\",\n    )\n    _require(contract[\"schema\"] == \"agent-brain-power-v4-execution-contract/v1\", \"execution contract schema changed\")\n    _require(contract[\"status\"] == \"locked_before_calibration_opening\", \"execution contract was not locked before calibration\")\n    for field in (\n        \"provider_id\",\n        \"agent_cli_id\",\n        \"agent_cli_version\",\n        \"requested_model_id\",\n        \"resolved_model_id\",\n        \"effort\",\n    ):\n        _nonempty(contract[field], f\"execution_contract.{field}\")\n    shared = product_root[\"shared_execution\"]\n    _require(contract[\"resolved_model_id\"] == shared[\"model_id\"], \"resolved model identity drift\")\n    _require(contract[\"effort\"] == shared[\"effort\"], \"execution effort drift\")\n    _require(contract[\"runner_sha256\"] == shared[\"runner_sha256\"], \"execution runner drift\")\n    _sha256(contract[\"timeout_policy_sha256\"], \"execution_contract.timeout_policy_sha256\")\n    _positive_int(\n        contract[\"agent_timeout_limit_seconds\"],\n        \"execution_contract.agent_timeout_limit_seconds\",\n    )\n    component_limit = contract[\"timeout_component_limit_seconds\"]\n    _require(\n        component_limit is None or (type(component_limit) is int and component_limit > 0),\n        \"execution_contract.timeout_component_limit_seconds is invalid\",\n    )\n    _require(\n        contract[\"identity_sha256\"] == _self_sha256(contract),\n        \"execution contract identity hash mismatch\",\n    )\n    return contract\n\n\ndef _validate_execution_attestations(\n    value: Any,\n    *,\n    product_root: Mapping[str, Any],\n    execution_contract: Mapping[str, Any],\n) -> str:\n    _require(isinstance(value, list), \"execution_attestations must be a list\")\n    cells = {str(cell[\"run_id\"]): cell for cell in product_root[\"cells\"]}\n    _require(len(value) == len(cells), \"execution attestation count differs from product cells\")\n    expected_shared = {\n        \"provider_id\": execution_contract[\"provider_id\"],\n        \"agent_cli_id\": execution_contract[\"agent_cli_id\"],\n        \"agent_cli_version\": execution_contract[\"agent_cli_version\"],\n        \"requested_model_id\": execution_contract[\"requested_model_id\"],\n        \"resolved_model_id\": execution_contract[\"resolved_model_id\"],\n        \"effort\": execution_contract[\"effort\"],\n        \"runner_sha256\": execution_contract[\"runner_sha256\"],\n        \"timeout_policy_sha256\": execution_contract[\"timeout_policy_sha256\"],\n        \"agent_timeout_limit_seconds\": execution_contract[\n            \"agent_timeout_limit_seconds\"\n        ],\n        \"timeout_component_limit_seconds\": execution_contract[\n            \"timeout_component_limit_seconds\"\n        ],\n    }\n    seen: set[str] = set()\n    for index, raw in enumerate(value):\n        label = f\"execution_attestations[{index}]\"\n        attestation = _exact_keys(\n            raw,\n            {\n                \"run_id\",\n                \"cell_identity_sha256\",\n                *expected_shared.keys(),\n                \"identity_sha256\",\n            },\n            label,\n        )\n        run_id = _nonempty(attestation[\"run_id\"], f\"{label}.run_id\")\n        _require(run_id in cells and run_id not in seen, f\"{label} run identity drift\")\n        seen.add(run_id)\n        cell = cells[run_id]\n        _require(\n            attestation[\"cell_identity_sha256\"] == cell[\"identity_sha256\"],\n            f\"{label} cell identity drift\",\n        )\n        for field, expected_value in expected_shared.items():\n            _require(attestation[field] == expected_value, f\"{label}.{field} parity drift\")\n        execution = cell[\"execution_identity\"]\n        timing = cell[\"outcome\"][\"timing\"]\n        _require(attestation[\"runner_sha256\"] == execution[\"runner_sha256\"], f\"{label} runner/cell drift\")\n        _require(attestation[\"resolved_model_id\"] == execution[\"model_id\"], f\"{label} resolved-model/cell drift\")\n        _require(attestation[\"effort\"] == execution[\"effort\"], f\"{label} effort/cell drift\")\n        _require(\n            attestation[\"agent_timeout_limit_seconds\"]\n            == timing[\"agent_timeout_limit_seconds\"],\n            f\"{label} agent-timeout/cell drift\",\n        )\n        _require(\n            attestation[\"timeout_component_limit_seconds\"]\n            == timing[\"timeout_component_limit_seconds\"],\n            f\"{label} component-timeout/cell drift\",\n        )\n        _require(\n            attestation[\"identity_sha256\"] == _self_sha256(attestation),\n            f\"{label} identity hash mismatch\",\n        )\n    _require([row[\"run_id\"] for row in value] == sorted(seen), \"execution attestations must be ordered by run_id\")\n    return PRODUCT.value_sha256(value)\n\n\ndef _validate_candidate_lock(\n    value: Any,\n    *,\n    bundle: ArtifactBundle,\n    product_root: Mapping[str, Any],\n    population_binding: Mapping[str, Any],\n    complete_plan_sha256: str,\n) -> dict[str, Any]:\n    lock = _exact_keys(\n        value,\n        {\n            \"status\",\n            \"candidate_product_identity_sha256\",\n            \"complete_plan_sha256\",\n            \"task_population_contract_sha256\",\n            \"task_population_file_sha256\",\n            \"lock_receipt_file_sha256\",\n            \"authentication_status\",\n            \"identity_sha256\",\n        },\n        \"candidate_lock\",\n    )\n    _require(\n        lock[\"status\"] == \"structurally_locked_before_development_calibration\",\n        \"candidate lock must precede development calibration\",\n    )\n    candidate_sha = _sha256(\n        lock[\"candidate_product_identity_sha256\"],\n        \"candidate_lock.candidate_product_identity_sha256\",\n    )\n    _require(\n        candidate_sha\n        == product_root[\"product_identities\"][\"candidate\"][\"identity_sha256\"],\n        \"candidate lock product identity drift\",\n    )\n    _require(\n        lock[\"complete_plan_sha256\"] == complete_plan_sha256,\n        \"candidate lock complete-plan drift\",\n    )\n    population_sha = _sha256(\n        lock[\"task_population_contract_sha256\"],\n        \"candidate_lock.task_population_contract_sha256\",\n    )\n    _require(\n        population_sha == population_binding[\"population_sha256\"],\n        \"candidate lock task-population contract drift\",\n    )\n    _require(\n        lock[\"task_population_file_sha256\"] == bundle.task_population.sha256,\n        \"candidate lock task-population raw bytes drift\",\n    )\n    _require(\n        lock[\"lock_receipt_file_sha256\"] == bundle.candidate_lock_receipt.sha256,\n        \"candidate-lock receipt raw bytes drift\",\n    )\n    _require(\n        lock[\"authentication_status\"] == NO_TRUST_ANCHOR,\n        \"candidate-lock authentication status drift\",\n    )\n    receipt = bundle.candidate_lock_receipt.value\n    expected_receipt = {\n        \"complete_plan_sha256\": complete_plan_sha256,\n        \"candidate_product_identity_sha256\": candidate_sha,\n        \"task_population_file_sha256\": bundle.task_population.sha256,\n        \"authentication_status\": NO_TRUST_ANCHOR,\n    }\n    for field, expected_value in expected_receipt.items():\n        _require(receipt[field] == expected_value, f\"candidate-lock receipt drift: {field}\")\n    _require(\n        receipt[\"identity_sha256\"] == _self_sha256(receipt),\n        \"candidate-lock receipt identity hash mismatch\",\n    )\n    digest = _sha256(lock[\"identity_sha256\"], \"candidate_lock.identity_sha256\")\n    _require(digest == _self_sha256(lock), \"candidate lock identity hash mismatch\")\n    return lock\n\n\ndef _validate_source_byte_bindings(\n    value: Any,\n    *,\n    bundle: ArtifactBundle,\n    product_root: Mapping[str, Any],\n    population_binding: Mapping[str, Any],\n    implementation_lock_sha256: str,\n    execution_attestations_sha256: str,\n) -> dict[str, Any]:\n    bindings = _exact_keys(\n        value,\n        {\n            \"product_cycle_file_sha256\",\n            \"product_cycle_schema_file_sha256\",\n            \"product_cycle_contract_sha256\",\n            \"product_cycle_evidence_canonical_bytes_sha256\",\n            \"task_population_schema_file_sha256\",\n            \"task_population_contract_file_sha256\",\n            \"task_population_contract_sha256\",\n            \"task_population_binding_canonical_bytes_sha256\",\n            \"review_ledger_schema_file_sha256\",\n            \"review_ledger_file_sha256\",\n            \"review_ledger_sha256\",\n            \"selection_receipt_file_sha256\",\n            \"assignment_receipt_file_sha256\",\n            \"overlap_receipt_file_sha256\",\n            \"candidate_lock_receipt_file_sha256\",\n            \"owner_approval_receipt_file_sha256\",\n            \"v4_implementation_lock_sha256\",\n            \"execution_attestations_sha256\",\n            \"identity_sha256\",\n        },\n        \"source_byte_bindings\",\n    )\n    expected = {\n        \"product_cycle_file_sha256\": bundle.product_cycle.sha256,\n        \"product_cycle_schema_file_sha256\": bundle.schemas[\"product_cycle\"].sha256,\n        \"product_cycle_contract_sha256\": product_root[\"manifest_sha256\"],\n        \"product_cycle_evidence_canonical_bytes_sha256\": PRODUCT.value_sha256(\n            product_root\n","stderr":"","aggregated_output":"\n    def union(left: str, right: str) -> None:\n        left_root = find(left)\n        right_root = find(right)\n        if left_root != right_root:\n            first, second = sorted((left_root, right_root))\n            parent[second] = first\n\n    for field in (\"family_commitment_sha256\",):\n        groups: dict[str, list[str]] = defaultdict(list)\n        for ref, member in refs.items():\n            groups[str(member[field])].append(ref)\n        for group in groups.values():\n            for ref in group[1:]:\n                union(group[0], ref)\n    for artifact_field in (\"fix_commitment_sha256\",):\n        groups = defaultdict(list)\n        for ref, member in refs.items():\n            groups[str(member[\"artifacts\"][artifact_field])].append(ref)\n        for group in groups.values():\n            for ref in group[1:]:\n                union(group[0], ref)\n    session_groups: dict[str, list[str]] = defaultdict(list)\n    for ref, member in refs.items():\n        for session in member[\"source_session_commitments\"]:\n            session_groups[str(session)].append(ref)\n    for group in session_groups.values():\n        for ref in group[1:]:\n            union(group[0], ref)\n    for edge in population[\"related_task_edges\"]:\n        left = str(edge[\"left_member_ref\"])\n        right = str(edge[\"right_member_ref\"])\n        if edge[\"material\"] is True and left in refs and right in refs:\n            union(left, right)\n\n    components: dict[str, list[str]] = defaultdict(list)\n    for ref in sorted(refs):\n        components[find(ref)].append(ref)\n    by_task: dict[str, str] = {}\n    cluster_rows: list[dict[str, Any]] = []\n    for member_refs in sorted(components.values()):\n        active_members = [ref for ref in member_refs if ref in active_refs]\n        if not active_members:\n            continue\n        cluster_sha = PRODUCT.value_sha256(\n            {\n                \"algorithm\": \"family_fix_session_material_edge_transitive_closure_v1\",\n                \"member_refs\": member_refs,\n            }\n        )\n        task_ids = sorted(str(refs[ref][\"task_id\"]) for ref in active_members)\n        for task_id in task_ids:\n            by_task[task_id] = cluster_sha\n        cluster_rows.append(\n            {\n                \"independence_cluster_sha256\": cluster_sha,\n                \"member_refs\": member_refs,\n                \"task_ids\": task_ids,\n            }\n        )\n    return by_task, PRODUCT.value_sha256(cluster_rows)\n\n\ndef _derive_population_binding(\n    *,\n    bundle: ArtifactBundle,\n    product_root: Mapping[str, Any],\n) -> tuple[dict[str, Any], list[str], dict[str, str]]:\n    population = bundle.task_population.value\n    selection = population[\"selection_policy\"]\n    split = population[\"split_policy\"]\n    receipt_specs = (\n        (\n            bundle.selection_receipt,\n            \"selection\",\n            selection,\n            \"selection_receipt_sha256\",\n        ),\n        (\n            bundle.assignment_receipt,\n            \"assignment\",\n            split,\n            \"assignment_receipt_sha256\",\n        ),\n        (\n            bundle.overlap_receipt,\n            \"overlap_commitment\",\n            split,\n            \"overlap_commitment_receipt_sha256\",\n        ),\n    )\n    for artifact, kind, subject, field in receipt_specs:\n        _require(subject[field] == artifact.sha256, f\"{kind} receipt raw-byte hash drift\")\n        _validate_population_receipt(\n            artifact,\n            expected_kind=kind,\n            expected_subject_sha256=_population_receipt_subject_sha256(\n                population, kind\n            ),\n        )\n\n    calibration_members = [\n        member\n        for member in population[\"members\"]\n        if member[\"membership\"] == \"development_calibration\"\n        and member[\"contamination_state\"] != \"excluded\"\n    ]\n    _require(\n        all(member[\"contamination_state\"] == \"reviewed_clear\" for member in calibration_members),\n        \"calibration population contains a non-reviewed-clear active member\",\n    )\n    cluster_by_task, closure_sha = _independence_clusters(\n        population, calibration_members\n    )\n    cluster_count = len(set(cluster_by_task.values()))\n    _require(\n        cluster_count >= MIN_CALIBRATION_CLUSTERS,\n        \"final calibration requires at least 12 derived independent clusters\",\n    )\n    _require(\n        cluster_count == len(calibration_members),\n        \"candidate sizing requires one mutually independent calibration task per derived cluster\",\n    )\n    product_tasks = {str(task[\"task_id\"]): task for task in product_root[\"tasks\"]}\n    task_ids = sorted(str(member[\"task_id\"]) for member in calibration_members)\n    _require(\n        task_ids == sorted(product_tasks),\n        \"raw product-cycle tasks do not exactly match validated calibration members\",\n    )\n    task_hashes = [str(product_tasks[task_id][\"task_sha256\"]) for task_id in task_ids]\n    _require(\n        len(task_hashes) == len(set(task_hashes)),\n        \"calibration product task hashes must be unique\",\n    )\n    projected_members: list[dict[str, Any]] = []\n    for member in sorted(calibration_members, key=lambda item: str(item[\"task_id\"])):\n        task_id = str(member[\"task_id\"])\n        projected = {\n            \"member_ref\": member[\"member_ref\"],\n            \"membership\": member[\"membership\"],\n            \"task_id\": task_id,\n            \"task_id_sha256\": member[\"task_id_sha256\"],\n            \"product_task_sha256\": product_tasks[task_id][\"task_sha256\"],\n            \"task_overlap_commitment_sha256\": member[\n                \"task_overlap_commitment_sha256\"\n            ],\n            \"family_commitment_sha256\": member[\"family_commitment_sha256\"],\n            \"fix_commitment_sha256\": member[\"artifacts\"][\"fix_commitment_sha256\"],\n            \"source_session_commitments\": sorted(member[\"source_session_commitments\"]),\n            \"contamination_state\": member[\"contamination_state\"],\n            \"review_commitment_sha256\": member[\"review_commitment_sha256\"],\n            \"independence_cluster_sha256\": cluster_by_task[task_id],\n        }\n        projected[\"identity_sha256\"] = _self_sha256(projected)\n        projected_members.append(projected)\n    binding: dict[str, Any] = {\n        \"schema_version\": 2,\n        \"profile\": TASK_POPULATION_PROFILE,\n        \"status\": population[\"status\"],\n        \"schema_file_sha256\": bundle.schemas[\"task_population\"].sha256,\n        \"population_sha256\": population[\"population_sha256\"],\n        \"source_file_sha256\": bundle.task_population.sha256,\n        \"review_ledger_sha256\": bundle.review_ledger.value[\"ledger_sha256\"],\n        \"review_ledger_file_sha256\": bundle.review_ledger.sha256,\n        \"selection_verification_status\": selection[\"selection_verification_status\"],\n        \"selection_receipt_file_sha256\": bundle.selection_receipt.sha256,\n        \"assignment_verification_status\": split[\"assignment_verification_status\"],\n        \"assignment_receipt_file_sha256\": bundle.assignment_receipt.sha256,\n        \"overlap_commitment_verification_status\": split[\n            \"overlap_commitment_verification_status\"\n        ],\n        \"overlap_commitment_receipt_file_sha256\": bundle.overlap_receipt.sha256,\n        \"calibration_min_independent_tasks\": split[\n            \"calibration_min_independent_tasks\"\n        ],\n        \"holdout_plaintext\": split[\"holdout_plaintext\"],\n        \"independence_closure_algorithm\": \"family_fix_session_material_edge_transitive_closure_v1\",\n        \"independence_cluster_count\": cluster_count,\n        \"independence_projection_sha256\": closure_sha,\n        \"calibration_members\": projected_members,\n    }\n    binding[\"identity_sha256\"] = _self_sha256(binding)\n    return binding, task_ids, cluster_by_task\n\n\ndef _validate_population_binding(\n    value: Any,\n    *,\n    bundle: ArtifactBundle,\n    product_root: Mapping[str, Any],\n) -> tuple[list[str], dict[str, dict[str, Any]], dict[str, str]]:\n    expected, task_ids, cluster_by_task = _derive_population_binding(\n        bundle=bundle, product_root=product_root\n    )\n    _require(value == expected, \"task-population projection differs from validated raw artifacts\")\n    by_task = {member[\"task_id\"]: member for member in expected[\"calibration_members\"]}\n    return task_ids, by_task, cluster_by_task\n\n\ndef _precalibration_plan_sha256(product_root: Mapping[str, Any]) -> str:\n    \"\"\"Hash only inputs that exist before any calibration outcome is opened.\"\"\"\n    design = product_root[\"design\"]\n    return PRODUCT.value_sha256(\n        {\n            \"schema\": \"agent-brain-product-cycle-precalibration-plan/v1\",\n            \"purpose\": product_root[\"purpose\"],\n            \"evidence_class\": product_root[\"evidence_class\"],\n            \"claim_scope\": product_root[\"claim_scope\"],\n            \"product_identity_binding_sha256\": product_root[\"product_identities\"][\n                \"binding_sha256\"\n            ],\n            \"task_inventory_sha256\": product_root[\"task_inventory_sha256\"],\n            \"shared_execution_identity_sha256\": product_root[\"shared_execution\"][\n                \"identity_sha256\"\n            ],\n            \"arms\": design[\"arms\"],\n            \"arm_product_roles\": design[\"arm_product_roles\"],\n            \"primary_contrast\": design[\"primary_contrast\"],\n            \"diagnostic_contrast\": design[\"diagnostic_contrast\"],\n            \"task_clusters\": design[\"task_clusters\"],\n            \"repetitions_per_arm\": design[\"repetitions_per_arm\"],\n            \"requested_cells\": design[\"requested_cells\"],\n            \"agent_retry_limit\": design[\"agent_retry_limit\"],\n            \"replacement_cell_limit\": design[\"replacement_cell_limit\"],\n            \"reserve_cell_limit\": design[\"reserve_cell_limit\"],\n            \"maximum_agent_invocations\": design[\"maximum_agent_invocations\"],\n            \"budget\": design[\"budget\"],\n            \"schedule_sha256\": product_root[\"shared_execution\"][\"schedule_sha256\"],\n        }\n    )\n\n\ndef _file_sha256(path: pathlib.Path, label: str) -> str:\n    return hashlib.sha256(_read_regular_bytes(path, label)).hexdigest()\n\n\ndef _expected_implementation_lock(bundle: ArtifactBundle) -> dict[str, Any]:\n    \"\"\"Build the exact lock for the current analyzer, validators, and schemas.\"\"\"\n    lock: dict[str, Any] = {\n        \"schema\": \"agent-brain-power-v4-implementation-lock/v1\",\n        \"analyzer_path\": \"benchmarks/agent-brain/confirmatory/power_analysis_v4.py\",\n        \"analyzer_file_sha256\": _file_sha256(\n            HERE / \"power_analysis_v4.py\", \"power-v4 analyzer\"\n        ),\n        \"draft202012_validator_file_sha256\": _file_sha256(\n            HERE / \"draft202012.py\", \"Draft 2020-12 validator\"\n        ),\n        \"product_cycle_validator_file_sha256\": _file_sha256(\n            HERE / \"product_cycle.py\", \"product-cycle validator\"\n        ),\n        \"task_population_validator_file_sha256\": _file_sha256(\n            HERE / \"task_population.py\", \"task-population validator\"\n        ),\n        \"product_cycle_schema_file_sha256\": bundle.schemas[\"product_cycle\"].sha256,\n        \"task_population_schema_file_sha256\": bundle.schemas[\"task_population\"].sha256,\n        \"review_ledger_schema_file_sha256\": bundle.schemas[\"review_ledger\"].sha256,\n        \"final_calibration_schema_file_sha256\": bundle.schemas[\n            \"final_calibration\"\n        ].sha256,\n        \"power_report_schema_file_sha256\": bundle.schemas[\"power_report\"].sha256,\n        \"population_receipt_schema_file_sha256\": bundle.schemas[\n            \"population_receipt\"\n        ].sha256,\n        \"candidate_lock_receipt_schema_file_sha256\": bundle.schemas[\n            \"candidate_lock_receipt\"\n        ].sha256,\n        \"owner_approval_receipt_schema_file_sha256\": bundle.schemas[\n            \"owner_approval_receipt\"\n        ].sha256,\n    }\n    lock[\"identity_sha256\"] = _self_sha256(lock)\n    return lock\n\n\ndef _validate_implementation_lock(\n    value: Any, *, bundle: ArtifactBundle\n) -> dict[str, Any]:\n    lock = _exact_keys(\n        value,\n        {\n            \"schema\",\n            \"analyzer_path\",\n            \"analyzer_file_sha256\",\n            \"draft202012_validator_file_sha256\",\n            \"product_cycle_validator_file_sha256\",\n            \"task_population_validator_file_sha256\",\n            \"product_cycle_schema_file_sha256\",\n            \"task_population_schema_file_sha256\",\n            \"review_ledger_schema_file_sha256\",\n            \"final_calibration_schema_file_sha256\",\n            \"power_report_schema_file_sha256\",\n            \"population_receipt_schema_file_sha256\",\n            \"candidate_lock_receipt_schema_file_sha256\",\n            \"owner_approval_receipt_schema_file_sha256\",\n            \"identity_sha256\",\n        },\n        \"v4_implementation_lock\",\n    )\n    expected = _expected_implementation_lock(bundle)\n    for field, expected_value in expected.items():\n        _require(lock[field] == expected_value, f\"v4 implementation lock drift: {field}\")\n    _require(\n        lock[\"identity_sha256\"] == _self_sha256(lock),\n        \"v4 implementation lock identity hash mismatch\",\n    )\n    return lock\n\n\ndef _validate_execution_contract(\n    value: Any, *, product_root: Mapping[str, Any]\n) -> dict[str, Any]:\n    contract = _exact_keys(\n        value,\n        {\n            \"schema\",\n            \"status\",\n            \"provider_id\",\n            \"agent_cli_id\",\n            \"agent_cli_version\",\n            \"requested_model_id\",\n            \"resolved_model_id\",\n            \"effort\",\n            \"runner_sha256\",\n            \"timeout_policy_sha256\",\n            \"agent_timeout_limit_seconds\",\n            \"timeout_component_limit_seconds\",\n            \"identity_sha256\",\n        },\n        \"execution_contract\",\n    )\n    _require(contract[\"schema\"] == \"agent-brain-power-v4-execution-contract/v1\", \"execution contract schema changed\")\n    _require(contract[\"status\"] == \"locked_before_calibration_opening\", \"execution contract was not locked before calibration\")\n    for field in (\n        \"provider_id\",\n        \"agent_cli_id\",\n        \"agent_cli_version\",\n        \"requested_model_id\",\n        \"resolved_model_id\",\n        \"effort\",\n    ):\n        _nonempty(contract[field], f\"execution_contract.{field}\")\n    shared = product_root[\"shared_execution\"]\n    _require(contract[\"resolved_model_id\"] == shared[\"model_id\"], \"resolved model identity drift\")\n    _require(contract[\"effort\"] == shared[\"effort\"], \"execution effort drift\")\n    _require(contract[\"runner_sha256\"] == shared[\"runner_sha256\"], \"execution runner drift\")\n    _sha256(contract[\"timeout_policy_sha256\"], \"execution_contract.timeout_policy_sha256\")\n    _positive_int(\n        contract[\"agent_timeout_limit_seconds\"],\n        \"execution_contract.agent_timeout_limit_seconds\",\n    )\n    component_limit = contract[\"timeout_component_limit_seconds\"]\n    _require(\n        component_limit is None or (type(component_limit) is int and component_limit > 0),\n        \"execution_contract.timeout_component_limit_seconds is invalid\",\n    )\n    _require(\n        contract[\"identity_sha256\"] == _self_sha256(contract),\n        \"execution contract identity hash mismatch\",\n    )\n    return contract\n\n\ndef _validate_execution_attestations(\n    value: Any,\n    *,\n    product_root: Mapping[str, Any],\n    execution_contract: Mapping[str, Any],\n) -> str:\n    _require(isinstance(value, list), \"execution_attestations must be a list\")\n    cells = {str(cell[\"run_id\"]): cell for cell in product_root[\"cells\"]}\n    _require(len(value) == len(cells), \"execution attestation count differs from product cells\")\n    expected_shared = {\n        \"provider_id\": execution_contract[\"provider_id\"],\n        \"agent_cli_id\": execution_contract[\"agent_cli_id\"],\n        \"agent_cli_version\": execution_contract[\"agent_cli_version\"],\n        \"requested_model_id\": execution_contract[\"requested_model_id\"],\n        \"resolved_model_id\": execution_contract[\"resolved_model_id\"],\n        \"effort\": execution_contract[\"effort\"],\n        \"runner_sha256\": execution_contract[\"runner_sha256\"],\n        \"timeout_policy_sha256\": execution_contract[\"timeout_policy_sha256\"],\n        \"agent_timeout_limit_seconds\": execution_contract[\n            \"agent_timeout_limit_seconds\"\n        ],\n        \"timeout_component_limit_seconds\": execution_contract[\n            \"timeout_component_limit_seconds\"\n        ],\n    }\n    seen: set[str] = set()\n    for index, raw in enumerate(value):\n        label = f\"execution_attestations[{index}]\"\n        attestation = _exact_keys(\n            raw,\n            {\n                \"run_id\",\n                \"cell_identity_sha256\",\n                *expected_shared.keys(),\n                \"identity_sha256\",\n            },\n            label,\n        )\n        run_id = _nonempty(attestation[\"run_id\"], f\"{label}.run_id\")\n        _require(run_id in cells and run_id not in seen, f\"{label} run identity drift\")\n        seen.add(run_id)\n        cell = cells[run_id]\n        _require(\n            attestation[\"cell_identity_sha256\"] == cell[\"identity_sha256\"],\n            f\"{label} cell identity drift\",\n        )\n        for field, expected_value in expected_shared.items():\n            _require(attestation[field] == expected_value, f\"{label}.{field} parity drift\")\n        execution = cell[\"execution_identity\"]\n        timing = cell[\"outcome\"][\"timing\"]\n        _require(attestation[\"runner_sha256\"] == execution[\"runner_sha256\"], f\"{label} runner/cell drift\")\n        _require(attestation[\"resolved_model_id\"] == execution[\"model_id\"], f\"{label} resolved-model/cell drift\")\n        _require(attestation[\"effort\"] == execution[\"effort\"], f\"{label} effort/cell drift\")\n        _require(\n            attestation[\"agent_timeout_limit_seconds\"]\n            == timing[\"agent_timeout_limit_seconds\"],\n            f\"{label} agent-timeout/cell drift\",\n        )\n        _require(\n            attestation[\"timeout_component_limit_seconds\"]\n            == timing[\"timeout_component_limit_seconds\"],\n            f\"{label} component-timeout/cell drift\",\n        )\n        _require(\n            attestation[\"identity_sha256\"] == _self_sha256(attestation),\n            f\"{label} identity hash mismatch\",\n        )\n    _require([row[\"run_id\"] for row in value] == sorted(seen), \"execution attestations must be ordered by run_id\")\n    return PRODUCT.value_sha256(value)\n\n\ndef _validate_candidate_lock(\n    value: Any,\n    *,\n    bundle: ArtifactBundle,\n    product_root: Mapping[str, Any],\n    population_binding: Mapping[str, Any],\n    complete_plan_sha256: str,\n) -> dict[str, Any]:\n    lock = _exact_keys(\n        value,\n        {\n            \"status\",\n            \"candidate_product_identity_sha256\",\n            \"complete_plan_sha256\",\n            \"task_population_contract_sha256\",\n            \"task_population_file_sha256\",\n            \"lock_receipt_file_sha256\",\n            \"authentication_status\",\n            \"identity_sha256\",\n        },\n        \"candidate_lock\",\n    )\n    _require(\n        lock[\"status\"] == \"structurally_locked_before_development_calibration\",\n        \"candidate lock must precede development calibration\",\n    )\n    candidate_sha = _sha256(\n        lock[\"candidate_product_identity_sha256\"],\n        \"candidate_lock.candidate_product_identity_sha256\",\n    )\n    _require(\n        candidate_sha\n        == product_root[\"product_identities\"][\"candidate\"][\"identity_sha256\"],\n        \"candidate lock product identity drift\",\n    )\n    _require(\n        lock[\"complete_plan_sha256\"] == complete_plan_sha256,\n        \"candidate lock complete-plan drift\",\n    )\n    population_sha = _sha256(\n        lock[\"task_population_contract_sha256\"],\n        \"candidate_lock.task_population_contract_sha256\",\n    )\n    _require(\n        population_sha == population_binding[\"population_sha256\"],\n        \"candidate lock task-population contract drift\",\n    )\n    _require(\n        lock[\"task_population_file_sha256\"] == bundle.task_population.sha256,\n        \"candidate lock task-population raw bytes drift\",\n    )\n    _require(\n        lock[\"lock_receipt_file_sha256\"] == bundle.candidate_lock_receipt.sha256,\n        \"candidate-lock receipt raw bytes drift\",\n    )\n    _require(\n        lock[\"authentication_status\"] == NO_TRUST_ANCHOR,\n        \"candidate-lock authentication status drift\",\n    )\n    receipt = bundle.candidate_lock_receipt.value\n    expected_receipt = {\n        \"complete_plan_sha256\": complete_plan_sha256,\n        \"candidate_product_identity_sha256\": candidate_sha,\n        \"task_population_file_sha256\": bundle.task_population.sha256,\n        \"authentication_status\": NO_TRUST_ANCHOR,\n    }\n    for field, expected_value in expected_receipt.items():\n        _require(receipt[field] == expected_value, f\"candidate-lock receipt drift: {field}\")\n    _require(\n        receipt[\"identity_sha256\"] == _self_sha256(receipt),\n        \"candidate-lock receipt identity hash mismatch\",\n    )\n    digest = _sha256(lock[\"identity_sha256\"], \"candidate_lock.identity_sha256\")\n    _require(digest == _self_sha256(lock), \"candidate lock identity hash mismatch\")\n    return lock\n\n\ndef _validate_source_byte_bindings(\n    value: Any,\n    *,\n    bundle: ArtifactBundle,\n    product_root: Mapping[str, Any],\n    population_binding: Mapping[str, Any],\n    implementation_lock_sha256: str,\n    execution_attestations_sha256: str,\n) -> dict[str, Any]:\n    bindings = _exact_keys(\n        value,\n        {\n            \"product_cycle_file_sha256\",\n            \"product_cycle_schema_file_sha256\",\n            \"product_cycle_contract_sha256\",\n            \"product_cycle_evidence_canonical_bytes_sha256\",\n            \"task_population_schema_file_sha256\",\n            \"task_population_contract_file_sha256\",\n            \"task_population_contract_sha256\",\n            \"task_population_binding_canonical_bytes_sha256\",\n            \"review_ledger_schema_file_sha256\",\n            \"review_ledger_file_sha256\",\n            \"review_ledger_sha256\",\n            \"selection_receipt_file_sha256\",\n            \"assignment_receipt_file_sha256\",\n            \"overlap_receipt_file_sha256\",\n            \"candidate_lock_receipt_file_sha256\",\n            \"owner_approval_receipt_file_sha256\",\n            \"v4_implementation_lock_sha256\",\n            \"execution_attestations_sha256\",\n            \"identity_sha256\",\n        },\n        \"source_byte_bindings\",\n    )\n    expected = {\n        \"product_cycle_file_sha256\": bundle.product_cycle.sha256,\n        \"product_cycle_schema_file_sha256\": bundle.schemas[\"product_cycle\"].sha256,\n        \"product_cycle_contract_sha256\": product_root[\"manifest_sha256\"],\n        \"product_cycle_evidence_canonical_bytes_sha256\": PRODUCT.value_sha256(\n            product_root\n","exit_code":0,"duration":{"secs":0,"nanos":2791},"formatted_output":"\n    def union(left: str, right: str) -> None:\n        left_root = find(left)\n        right_root = find(right)\n        if left_root != right_root:\n            first, second = sorted((left_root, right_root))\n            parent[second] = first\n\n    for field in (\"family_commitment_sha256\",):\n        groups: dict[str, list[str]] = defaultdict(list)\n        for ref, member in refs.items():\n            groups[str(member[field])].append(ref)\n        for group in groups.values():\n            for ref in group[1:]:\n                union(group[0], ref)\n    for artifact_field in (\"fix_commitment_sha256\",):\n        groups = defaultdict(list)\n        for ref, member in refs.items():\n            groups[str(member[\"artifacts\"][artifact_field])].append(ref)\n        for group in groups.values():\n            for ref in group[1:]:\n                union(group[0], ref)\n    session_groups: dict[str, list[str]] = defaultdict(list)\n    for ref, member in refs.items():\n        for session in member[\"source_session_commitments\"]:\n            session_groups[str(session)].append(ref)\n    for group in session_groups.values():\n        for ref in group[1:]:\n            union(group[0], ref)\n    for edge in population[\"related_task_edges\"]:\n        left = str(edge[\"left_member_ref\"])\n        right = str(edge[\"right_member_ref\"])\n        if edge[\"material\"] is True and left in refs and right in refs:\n            union(left, right)\n\n    components: dict[str, list[str]] = defaultdict(list)\n    for ref in sorted(refs):\n        components[find(ref)].append(ref)\n    by_task: dict[str, str] = {}\n    cluster_rows: list[dict[str, Any]] = []\n    for member_refs in sorted(components.values()):\n        active_members = [ref for ref in member_refs if ref in active_refs]\n        if not active_members:\n            continue\n        cluster_sha = PRODUCT.value_sha256(\n            {\n                \"algorithm\": \"family_fix_session_material_edge_transitive_closure_v1\",\n                \"member_refs\": member_refs,\n            }\n        )\n        task_ids = sorted(str(refs[ref][\"task_id\"]) for ref in active_members)\n        for task_id in task_ids:\n            by_task[task_id] = cluster_sha\n        cluster_rows.append(\n            {\n                \"independence_cluster_sha256\": cluster_sha,\n                \"member_refs\": member_refs,\n                \"task_ids\": task_ids,\n            }\n        )\n    return by_task, PRODUCT.value_sha256(cluster_rows)\n\n\ndef _derive_population_binding(\n    *,\n    bundle: ArtifactBundle,\n    product_root: Mapping[str, Any],\n) -> tuple[dict[str, Any], list[str], dict[str, str]]:\n    population = bundle.task_population.value\n    selection = population[\"selection_policy\"]\n    split = population[\"split_policy\"]\n    receipt_specs = (\n        (\n            bundle.selection_receipt,\n            \"selection\",\n            selection,\n            \"selection_receipt_sha256\",\n        ),\n        (\n            bundle.assignment_receipt,\n            \"assignment\",\n            split,\n            \"assignment_receipt_sha256\",\n        ),\n        (\n            bundle.overlap_receipt,\n            \"overlap_commitment\",\n            split,\n            \"overlap_commitment_receipt_sha256\",\n        ),\n    )\n    for artifact, kind, subject, field in receipt_specs:\n        _require(subject[field] == artifact.sha256, f\"{kind} receipt raw-byte hash drift\")\n        _validate_population_receipt(\n            artifact,\n            expected_kind=kind,\n            expected_subject_sha256=_population_receipt_subject_sha256(\n                population, kind\n            ),\n        )\n\n    calibration_members = [\n        member\n        for member in population[\"members\"]\n        if member[\"membership\"] == \"development_calibration\"\n        and member[\"contamination_state\"] != \"excluded\"\n    ]\n    _require(\n        all(member[\"contamination_state\"] == \"reviewed_clear\" for member in calibration_members),\n        \"calibration population contains a non-reviewed-clear active member\",\n    )\n    cluster_by_task, closure_sha = _independence_clusters(\n        population, calibration_members\n    )\n    cluster_count = len(set(cluster_by_task.values()))\n    _require(\n        cluster_count >= MIN_CALIBRATION_CLUSTERS,\n        \"final calibration requires at least 12 derived independent clusters\",\n    )\n    _require(\n        cluster_count == len(calibration_members),\n        \"candidate sizing requires one mutually independent calibration task per derived cluster\",\n    )\n    product_tasks = {str(task[\"task_id\"]): task for task in product_root[\"tasks\"]}\n    task_ids = sorted(str(member[\"task_id\"]) for member in calibration_members)\n    _require(\n        task_ids == sorted(product_tasks),\n        \"raw product-cycle tasks do not exactly match validated calibration members\",\n    )\n    task_hashes = [str(product_tasks[task_id][\"task_sha256\"]) for task_id in task_ids]\n    _require(\n        len(task_hashes) == len(set(task_hashes)),\n        \"calibration product task hashes must be unique\",\n    )\n    projected_members: list[dict[str, Any]] = []\n    for member in sorted(calibration_members, key=lambda item: str(item[\"task_id\"])):\n        task_id = str(member[\"task_id\"])\n        projected = {\n            \"member_ref\": member[\"member_ref\"],\n            \"membership\": member[\"membership\"],\n            \"task_id\": task_id,\n            \"task_id_sha256\": member[\"task_id_sha256\"],\n            \"product_task_sha256\": product_tasks[task_id][\"task_sha256\"],\n            \"task_overlap_commitment_sha256\": member[\n                \"task_overlap_commitment_sha256\"\n            ],\n            \"family_commitment_sha256\": member[\"family_commitment_sha256\"],\n            \"fix_commitment_sha256\": member[\"artifacts\"][\"fix_commitment_sha256\"],\n            \"source_session_commitments\": sorted(member[\"source_session_commitments\"]),\n            \"contamination_state\": member[\"contamination_state\"],\n            \"review_commitment_sha256\": member[\"review_commitment_sha256\"],\n            \"independence_cluster_sha256\": cluster_by_task[task_id],\n        }\n        projected[\"identity_sha256\"] = _self_sha256(projected)\n        projected_members.append(projected)\n    binding: dict[str, Any] = {\n        \"schema_version\": 2,\n        \"profile\": TASK_POPULATION_PROFILE,\n        \"status\": population[\"status\"],\n        \"schema_file_sha256\": bundle.schemas[\"task_population\"].sha256,\n        \"population_sha256\": population[\"population_sha256\"],\n        \"source_file_sha256\": bundle.task_population.sha256,\n        \"review_ledger_sha256\": bundle.review_ledger.value[\"ledger_sha256\"],\n        \"review_ledger_file_sha256\": bundle.review_ledger.sha256,\n        \"selection_verification_status\": selection[\"selection_verification_status\"],\n        \"selection_receipt_file_sha256\": bundle.selection_receipt.sha256,\n        \"assignment_verification_status\": split[\"assignment_verification_status\"],\n        \"assignment_receipt_file_sha256\": bundle.assignment_receipt.sha256,\n        \"overlap_commitment_verification_status\": split[\n            \"overlap_commitment_verification_status\"\n        ],\n        \"overlap_commitment_receipt_file_sha256\": bundle.overlap_receipt.sha256,\n        \"calibration_min_independent_tasks\": split[\n            \"calibration_min_independent_tasks\"\n        ],\n        \"holdout_plaintext\": split[\"holdout_plaintext\"],\n        \"independence_closure_algorithm\": \"family_fix_session_material_edge_transitive_closure_v1\",\n        \"independence_cluster_count\": cluster_count,\n        \"independence_projection_sha256\": closure_sha,\n        \"calibration_members\": projected_members,\n    }\n    binding[\"identity_sha256\"] = _self_sha256(binding)\n    return binding, task_ids, cluster_by_task\n\n\ndef _validate_population_binding(\n    value: Any,\n    *,\n    bundle: ArtifactBundle,\n    product_root: Mapping[str, Any],\n) -> tuple[list[str], dict[str, dict[str, Any]], dict[str, str]]:\n    expected, task_ids, cluster_by_task = _derive_population_binding(\n        bundle=bundle, product_root=product_root\n    )\n    _require(value == expected, \"task-population projection differs from validated raw artifacts\")\n    by_task = {member[\"task_id\"]: member for member in expected[\"calibration_members\"]}\n    return task_ids, by_task, cluster_by_task\n\n\ndef _precalibration_plan_sha256(product_root: Mapping[str, Any]) -> str:\n    \"\"\"Hash only inputs that exist before any calibration outcome is opened.\"\"\"\n    design = product_root[\"design\"]\n    return PRODUCT.value_sha256(\n        {\n            \"schema\": \"agent-brain-product-cycle-precalibration-plan/v1\",\n            \"purpose\": product_root[\"purpose\"],\n            \"evidence_class\": product_root[\"evidence_class\"],\n            \"claim_scope\": product_root[\"claim_scope\"],\n            \"product_identity_binding_sha256\": product_root[\"product_identities\"][\n                \"binding_sha256\"\n            ],\n            \"task_inventory_sha256\": product_root[\"task_inventory_sha256\"],\n            \"shared_execution_identity_sha256\": product_root[\"shared_execution\"][\n                \"identity_sha256\"\n            ],\n            \"arms\": design[\"arms\"],\n            \"arm_product_roles\": design[\"arm_product_roles\"],\n            \"primary_contrast\": design[\"primary_contrast\"],\n            \"diagnostic_contrast\": design[\"diagnostic_contrast\"],\n            \"task_clusters\": design[\"task_clusters\"],\n            \"repetitions_per_arm\": design[\"repetitions_per_arm\"],\n            \"requested_cells\": design[\"requested_cells\"],\n            \"agent_retry_limit\": design[\"agent_retry_limit\"],\n            \"replacement_cell_limit\": design[\"replacement_cell_limit\"],\n            \"reserve_cell_limit\": design[\"reserve_cell_limit\"],\n            \"maximum_agent_invocations\": design[\"maximum_agent_invocations\"],\n            \"budget\": design[\"budget\"],\n            \"schedule_sha256\": product_root[\"shared_execution\"][\"schedule_sha256\"],\n        }\n    )\n\n\ndef _file_sha256(path: pathlib.Path, label: str) -> str:\n    return hashlib.sha256(_read_regular_bytes(path, label)).hexdigest()\n\n\ndef _expected_implementation_lock(bundle: ArtifactBundle) -> dict[str, Any]:\n    \"\"\"Build the exact lock for the current analyzer, validators, and schemas.\"\"\"\n    lock: dict[str, Any] = {\n        \"schema\": \"agent-brain-power-v4-implementation-lock/v1\",\n        \"analyzer_path\": \"benchmarks/agent-brain/confirmatory/power_analysis_v4.py\",\n        \"analyzer_file_sha256\": _file_sha256(\n            HERE / \"power_analysis_v4.py\", \"power-v4 analyzer\"\n        ),\n        \"draft202012_validator_file_sha256\": _file_sha256(\n            HERE / \"draft202012.py\", \"Draft 2020-12 validator\"\n        ),\n        \"product_cycle_validator_file_sha256\": _file_sha256(\n            HERE / \"product_cycle.py\", \"product-cycle validator\"\n        ),\n        \"task_population_validator_file_sha256\": _file_sha256(\n            HERE / \"task_population.py\", \"task-population validator\"\n        ),\n        \"product_cycle_schema_file_sha256\": bundle.schemas[\"product_cycle\"].sha256,\n        \"task_population_schema_file_sha256\": bundle.schemas[\"task_population\"].sha256,\n        \"review_ledger_schema_file_sha256\": bundle.schemas[\"review_ledger\"].sha256,\n        \"final_calibration_schema_file_sha256\": bundle.schemas[\n            \"final_calibration\"\n        ].sha256,\n        \"power_report_schema_file_sha256\": bundle.schemas[\"power_report\"].sha256,\n        \"population_receipt_schema_file_sha256\": bundle.schemas[\n            \"population_receipt\"\n        ].sha256,\n        \"candidate_lock_receipt_schema_file_sha256\": bundle.schemas[\n            \"candidate_lock_receipt\"\n        ].sha256,\n        \"owner_approval_receipt_schema_file_sha256\": bundle.schemas[\n            \"owner_approval_receipt\"\n        ].sha256,\n    }\n    lock[\"identity_sha256\"] = _self_sha256(lock)\n    return lock\n\n\ndef _validate_implementation_lock(\n    value: Any, *, bundle: ArtifactBundle\n) -> dict[str, Any]:\n    lock = _exact_keys(\n        value,\n        {\n            \"schema\",\n            \"analyzer_path\",\n            \"analyzer_file_sha256\",\n            \"draft202012_validator_file_sha256\",\n            \"product_cycle_validator_file_sha256\",\n            \"task_population_validator_file_sha256\",\n            \"product_cycle_schema_file_sha256\",\n            \"task_population_schema_file_sha256\",\n            \"review_ledger_schema_file_sha256\",\n            \"final_calibration_schema_file_sha256\",\n            \"power_report_schema_file_sha256\",\n            \"population_receipt_schema_file_sha256\",\n            \"candidate_lock_receipt_schema_file_sha256\",\n            \"owner_approval_receipt_schema_file_sha256\",\n            \"identity_sha256\",\n        },\n        \"v4_implementation_lock\",\n    )\n    expected = _expected_implementation_lock(bundle)\n    for field, expected_value in expected.items():\n        _require(lock[field] == expected_value, f\"v4 implementation lock drift: {field}\")\n    _require(\n        lock[\"identity_sha256\"] == _self_sha256(lock),\n        \"v4 implementation lock identity hash mismatch\",\n    )\n    return lock\n\n\ndef _validate_execution_contract(\n    value: Any, *, product_root: Mapping[str, Any]\n) -> dict[str, Any]:\n    contract = _exact_keys(\n        value,\n        {\n            \"schema\",\n            \"status\",\n            \"provider_id\",\n            \"agent_cli_id\",\n            \"agent_cli_version\",\n            \"requested_model_id\",\n            \"resolved_model_id\",\n            \"effort\",\n            \"runner_sha256\",\n            \"timeout_policy_sha256\",\n            \"agent_timeout_limit_seconds\",\n            \"timeout_component_limit_seconds\",\n            \"identity_sha256\",\n        },\n        \"execution_contract\",\n    )\n    _require(contract[\"schema\"] == \"agent-brain-power-v4-execution-contract/v1\", \"execution contract schema changed\")\n    _require(contract[\"status\"] == \"locked_before_calibration_opening\", \"execution contract was not locked before calibration\")\n    for field in (\n        \"provider_id\",\n        \"agent_cli_id\",\n        \"agent_cli_version\",\n        \"requested_model_id\",\n        \"resolved_model_id\",\n        \"effort\",\n    ):\n        _nonempty(contract[field], f\"execution_contract.{field}\")\n    shared = product_root[\"shared_execution\"]\n    _require(contract[\"resolved_model_id\"] == shared[\"model_id\"], \"resolved model identity drift\")\n    _require(contract[\"effort\"] == shared[\"effort\"], \"execution effort drift\")\n    _require(contract[\"runner_sha256\"] == shared[\"runner_sha256\"], \"execution runner drift\")\n    _sha256(contract[\"timeout_policy_sha256\"], \"execution_contract.timeout_policy_sha256\")\n    _positive_int(\n        contract[\"agent_timeout_limit_seconds\"],\n        \"execution_contract.agent_timeout_limit_seconds\",\n    )\n    component_limit = contract[\"timeout_component_limit_seconds\"]\n    _require(\n        component_limit is None or (type(component_limit) is int and component_limit > 0),\n        \"execution_contract.timeout_component_limit_seconds is invalid\",\n    )\n    _require(\n        contract[\"identity_sha256\"] == _self_sha256(contract),\n        \"execution contract identity hash mismatch\",\n    )\n    return contract\n\n\ndef _validate_execution_attestations(\n    value: Any,\n    *,\n    product_root: Mapping[str, Any],\n    execution_contract: Mapping[str, Any],\n) -> str:\n    _require(isinstance(value, list), \"execution_attestations must be a list\")\n    cells = {str(cell[\"run_id\"]): cell for cell in product_root[\"cells\"]}\n    _require(len(value) == len(cells), \"execution attestation count differs from product cells\")\n    expected_shared = {\n        \"provider_id\": execution_contract[\"provider_id\"],\n        \"agent_cli_id\": execution_contract[\"agent_cli_id\"],\n        \"agent_cli_version\": execution_contract[\"agent_cli_version\"],\n        \"requested_model_id\": execution_contract[\"requested_model_id\"],\n        \"resolved_model_id\": execution_contract[\"resolved_model_id\"],\n        \"effort\": execution_contract[\"effort\"],\n        \"runner_sha256\": execution_contract[\"runner_sha256\"],\n        \"timeout_policy_sha256\": execution_contract[\"timeout_policy_sha256\"],\n        \"agent_timeout_limit_seconds\": execution_contract[\n            \"agent_timeout_limit_seconds\"\n        ],\n        \"timeout_component_limit_seconds\": execution_contract[\n            \"timeout_component_limit_seconds\"\n        ],\n    }\n    seen: set[str] = set()\n    for index, raw in enumerate(value):\n        label = f\"execution_attestations[{index}]\"\n        attestation = _exact_keys(\n            raw,\n            {\n                \"run_id\",\n                \"cell_identity_sha256\",\n                *expected_shared.keys(),\n                \"identity_sha256\",\n            },\n            label,\n        )\n        run_id = _nonempty(attestation[\"run_id\"], f\"{label}.run_id\")\n        _require(run_id in cells and run_id not in seen, f\"{label} run identity drift\")\n        seen.add(run_id)\n        cell = cells[run_id]\n        _require(\n            attestation[\"cell_identity_sha256\"] == cell[\"identity_sha256\"],\n            f\"{label} cell identity drift\",\n        )\n        for field, expected_value in expected_shared.items():\n            _require(attestation[field] == expected_value, f\"{label}.{field} parity drift\")\n        execution = cell[\"execution_identity\"]\n        timing = cell[\"outcome\"][\"timing\"]\n        _require(attestation[\"runner_sha256\"] == execution[\"runner_sha256\"], f\"{label} runner/cell drift\")\n        _require(attestation[\"resolved_model_id\"] == execution[\"model_id\"], f\"{label} resolved-model/cell drift\")\n        _require(attestation[\"effort\"] == execution[\"effort\"], f\"{label} effort/cell drift\")\n        _require(\n            attestation[\"agent_timeout_limit_seconds\"]\n            == timing[\"agent_timeout_limit_seconds\"],\n            f\"{label} agent-timeout/cell drift\",\n        )\n        _require(\n            attestation[\"timeout_component_limit_seconds\"]\n            == timing[\"timeout_component_limit_seconds\"],\n            f\"{label} component-timeout/cell drift\",\n        )\n        _require(\n            attestation[\"identity_sha256\"] == _self_sha256(attestation),\n            f\"{label} identity hash mismatch\",\n        )\n    _require([row[\"run_id\"] for row in value] == sorted(seen), \"execution attestations must be ordered by run_id\")\n    return PRODUCT.value_sha256(value)\n\n\ndef _validate_candidate_lock(\n    value: Any,\n    *,\n    bundle: ArtifactBundle,\n    product_root: Mapping[str, Any],\n    population_binding: Mapping[str, Any],\n    complete_plan_sha256: str,\n) -> dict[str, Any]:\n    lock = _exact_keys(\n        value,\n        {\n            \"status\",\n            \"candidate_product_identity_sha256\",\n            \"complete_plan_sha256\",\n            \"task_population_contract_sha256\",\n            \"task_population_file_sha256\",\n            \"lock_receipt_file_sha256\",\n            \"authentication_status\",\n            \"identity_sha256\",\n        },\n        \"candidate_lock\",\n    )\n    _require(\n        lock[\"status\"] == \"structurally_locked_before_development_calibration\",\n        \"candidate lock must precede development calibration\",\n    )\n    candidate_sha = _sha256(\n        lock[\"candidate_product_identity_sha256\"],\n        \"candidate_lock.candidate_product_identity_sha256\",\n    )\n    _require(\n        candidate_sha\n        == product_root[\"product_identities\"][\"candidate\"][\"identity_sha256\"],\n        \"candidate lock product identity drift\",\n    )\n    _require(\n        lock[\"complete_plan_sha256\"] == complete_plan_sha256,\n        \"candidate lock complete-plan drift\",\n    )\n    population_sha = _sha256(\n        lock[\"task_population_contract_sha256\"],\n        \"candidate_lock.task_population_contract_sha256\",\n    )\n    _require(\n        population_sha == population_binding[\"population_sha256\"],\n        \"candidate lock task-population contract drift\",\n    )\n    _require(\n        lock[\"task_population_file_sha256\"] == bundle.task_population.sha256,\n        \"candidate lock task-population raw bytes drift\",\n    )\n    _require(\n        lock[\"lock_receipt_file_sha256\"] == bundle.candidate_lock_receipt.sha256,\n        \"candidate-lock receipt raw bytes drift\",\n    )\n    _require(\n        lock[\"authentication_status\"] == NO_TRUST_ANCHOR,\n        \"candidate-lock authentication status drift\",\n    )\n    receipt = bundle.candidate_lock_receipt.value\n    expected_receipt = {\n        \"complete_plan_sha256\": complete_plan_sha256,\n        \"candidate_product_identity_sha256\": candidate_sha,\n        \"task_population_file_sha256\": bundle.task_population.sha256,\n        \"authentication_status\": NO_TRUST_ANCHOR,\n    }\n    for field, expected_value in expected_receipt.items():\n        _require(receipt[field] == expected_value, f\"candidate-lock receipt drift: {field}\")\n    _require(\n        receipt[\"identity_sha256\"] == _self_sha256(receipt),\n        \"candidate-lock receipt identity hash mismatch\",\n    )\n    digest = _sha256(lock[\"identity_sha256\"], \"candidate_lock.identity_sha256\")\n    _require(digest == _self_sha256(lock), \"candidate lock identity hash mismatch\")\n    return lock\n\n\ndef _validate_source_byte_bindings(\n    value: Any,\n    *,\n    bundle: ArtifactBundle,\n    product_root: Mapping[str, Any],\n    population_binding: Mapping[str, Any],\n    implementation_lock_sha256: str,\n    execution_attestations_sha256: str,\n) -> dict[str, Any]:\n    bindings = _exact_keys(\n        value,\n        {\n            \"product_cycle_file_sha256\",\n            \"product_cycle_schema_file_sha256\",\n            \"product_cycle_contract_sha256\",\n            \"product_cycle_evidence_canonical_bytes_sha256\",\n            \"task_population_schema_file_sha256\",\n            \"task_population_contract_file_sha256\",\n            \"task_population_contract_sha256\",\n            \"task_population_binding_canonical_bytes_sha256\",\n            \"review_ledger_schema_file_sha256\",\n            \"review_ledger_file_sha256\",\n            \"review_ledger_sha256\",\n            \"selection_receipt_file_sha256\",\n            \"assignment_receipt_file_sha256\",\n            \"overlap_receipt_file_sha256\",\n            \"candidate_lock_receipt_file_sha256\",\n            \"owner_approval_receipt_file_sha256\",\n            \"v4_implementation_lock_sha256\",\n            \"execution_attestations_sha256\",\n            \"identity_sha256\",\n        },\n        \"source_byte_bindings\",\n    )\n    expected = {\n        \"product_cycle_file_sha256\": bundle.product_cycle.sha256,\n        \"product_cycle_schema_file_sha256\": bundle.schemas[\"product_cycle\"].sha256,\n        \"product_cycle_contract_sha256\": product_root[\"manifest_sha256\"],\n        \"product_cycle_evidence_canonical_bytes_sha256\": PRODUCT.value_sha256(\n            product_root\n"},"started_at_ms":1789839595931,"completed_at_ms":1789839595931}}
{"timestamp":"2026-09-19T17:39:55.987Z","ordinal":7540,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0bac0-d9d3-7200-8161-513b8ac4db9a","call_id":"call_IlnrRvLLdQRmfUwo1D3CGQbb","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"53421f\",\"wall_time_seconds\":0.000002791,\"exit_code\":0,\"original_token_count\":5629,\"output\":\"\\n    def union(left: str, right: str) -> None:\\n        left_root = find(left)\\n        right_root = find(right)\\n        if left_root != right_root:\\n            first, second = sorted((left_root, right_root))\\n            parent[second] = first\\n\\n    for field in (\\\"family_commitment_sha256\\\",):\\n        groups: dict[str, list[str]] = defaultdict(list)\\n        for ref, member in refs.items():\\n            groups[str(member[field])].append(ref)\\n        for group in groups.values():\\n            for ref in group[1:]:\\n                union(group[0], ref)\\n    for artifact_field in (\\\"fix_commitment_sha256\\\",):\\n        groups = defaultdict(list)\\n        for ref, member in refs.items():\\n            groups[str(member[\\\"artifacts\\\"][artifact_field])].append(ref)\\n        for group in groups.values():\\n            for ref in group[1:]:\\n                union(group[0], ref)\\n    session_groups: dict[str, list[str]] = defaultdict(list)\\n    for ref, member in refs.items():\\n        for session in member[\\\"source_session_commitments\\\"]:\\n            session_groups[str(session)].append(ref)\\n    for group in session_groups.values():\\n        for ref in group[1:]:\\n            union(group[0], ref)\\n    for edge in population[\\\"related_task_edges\\\"]:\\n        left = str(edge[\\\"left_member_ref\\\"])\\n        right = str(edge[\\\"right_member_ref\\\"])\\n        if edge[\\\"material\\\"] is True and left in refs and right in refs:\\n            union(left, right)\\n\\n    components: dict[str, list[str]] = defaultdict(list)\\n    for ref in sorted(refs):\\n        components[find(ref)].append(ref)\\n    by_task: dict[str, str] = {}\\n    cluster_rows: list[dict[str, Any]] = []\\n    for member_refs in sorted(components.values()):\\n        active_members = [ref for ref in member_refs if ref in active_refs]\\n        if not active_members:\\n            continue\\n        cluster_sha = PRODUCT.value_sha256(\\n            {\\n                \\\"algorithm\\\": \\\"family_fix_session_material_edge_transitive_closure_v1\\\",\\n                \\\"member_refs\\\": member_refs,\\n            }\\n        )\\n        task_ids = sorted(str(refs[ref][\\\"task_id\\\"]) for ref in active_members)\\n        for task_id in task_ids:\\n            by_task[task_id] = cluster_sha\\n        cluster_rows.append(\\n            {\\n                \\\"independence_cluster_sha256\\\": cluster_sha,\\n                \\\"member_refs\\\": member_refs,\\n                \\\"task_ids\\\": task_ids,\\n            }\\n        )\\n    return by_task, PRODUCT.value_sha256(cluster_rows)\\n\\n\\ndef _derive_population_binding(\\n    *,\\n    bundle: ArtifactBundle,\\n    product_root: Mapping[str, Any],\\n) -> tuple[dict[str, Any], list[str], dict[str, str]]:\\n    population = bundle.task_population.value\\n    selection = population[\\\"selection_policy\\\"]\\n    split = population[\\\"split_policy\\\"]\\n    receipt_specs = (\\n        (\\n            bundle.selection_receipt,\\n            \\\"selection\\\",\\n            selection,\\n            \\\"selection_receipt_sha256\\\",\\n        ),\\n        (\\n            bundle.assignment_receipt,\\n            \\\"assignment\\\",\\n            split,\\n            \\\"assignment_receipt_sha256\\\",\\n        ),\\n        (\\n            bundle.overlap_receipt,\\n            \\\"overlap_commitment\\\",\\n            split,\\n            \\\"overlap_commitment_receipt_sha256\\\",\\n        ),\\n    )\\n    for artifact, kind, subject, field in receipt_specs:\\n        _require(subject[field] == artifact.sha256, f\\\"{kind} receipt raw-byte hash drift\\\")\\n        _validate_population_receipt(\\n            artifact,\\n            expected_kind=kind,\\n            expected_subject_sha256=_population_receipt_subject_sha256(\\n                population, kind\\n            ),\\n        )\\n\\n    calibration_members = [\\n        member\\n        for member in population[\\\"members\\\"]\\n        if member[\\\"membership\\\"] == \\\"development_calibration\\\"\\n        and member[\\\"contamination_state\\\"] != \\\"excluded\\\"\\n    ]\\n    _require(\\n        all(member[\\\"contamination_state\\\"] == \\\"reviewed_clear\\\" for member in calibration_members),\\n        \\\"calibration population contains a non-reviewed-clear active member\\\",\\n    )\\n    cluster_by_task, closure_sha = _independence_clusters(\\n        population, calibration_members\\n    )\\n    cluster_count = len(set(cluster_by_task.values()))\\n    _require(\\n        cluster_count >= MIN_CALIBRATION_CLUSTERS,\\n        \\\"final calibration requires at least 12 derived independent clusters\\\",\\n    )\\n    _require(\\n        cluster_count == len(calibration_members),\\n        \\\"candidate sizing requires one mutually independent calibration task per derived cluster\\\",\\n    )\\n    product_tasks = {str(task[\\\"task_id\\\"]): task for task in product_root[\\\"tasks\\\"]}\\n    task_ids = sorted(str(member[\\\"task_id\\\"]) for member in calibration_members)\\n    _require(\\n        task_ids == sorted(product_tasks),\\n        \\\"raw product-cycle tasks do not exactly match validated calibration members\\\",\\n    )\\n    task_hashes = [str(product_tasks[task_id][\\\"task_sha256\\\"]) for task_id in task_ids]\\n    _require(\\n        len(task_hashes) == len(set(task_hashes)),\\n        \\\"calibration product task hashes must be unique\\\",\\n    )\\n    projected_members: list[dict[str, Any]] = []\\n    for member in sorted(calibration_members, key=lambda item: str(item[\\\"task_id\\\"])):\\n        task_id = str(member[\\\"task_id\\\"])\\n        projected = {\\n            \\\"member_ref\\\": member[\\\"member_ref\\\"],\\n            \\\"membership\\\": member[\\\"membership\\\"],\\n            \\\"task_id\\\": task_id,\\n            \\\"task_id_sha256\\\": member[\\\"task_id_sha256\\\"],\\n            \\\"product_task_sha256\\\": product_tasks[task_id][\\\"task_sha256\\\"],\\n            \\\"task_overlap_commitment_sha256\\\": member[\\n                \\\"task_overlap_commitment_sha256\\\"\\n            ],\\n            \\\"family_commitment_sha256\\\": member[\\\"family_commitment_sha256\\\"],\\n            \\\"fix_commitment_sha256\\\": member[\\\"artifacts\\\"][\\\"fix_commitment_sha256\\\"],\\n            \\\"source_session_commitments\\\": sorted(member[\\\"source_session_commitments\\\"]),\\n            \\\"contamination_state\\\": member[\\\"contamination_state\\\"],\\n            \\\"review_commitment_sha256\\\": member[\\\"review_commitment_sha256\\\"],\\n            \\\"independence_cluster_sha256\\\": cluster_by_task[task_id],\\n        }\\n        projected[\\\"identity_sha256\\\"] = _self_sha256(projected)\\n        projected_members.append(projected)\\n    binding: dict[str, Any] = {\\n        \\\"schema_version\\\": 2,\\n        \\\"profile\\\": TASK_POPULATION_PROFILE,\\n        \\\"status\\\": population[\\\"status\\\"],\\n        \\\"schema_file_sha256\\\": bundle.schemas[\\\"task_population\\\"].sha256,\\n        \\\"population_sha256\\\": population[\\\"population_sha256\\\"],\\n        \\\"source_file_sha256\\\": bundle.task_population.sha256,\\n        \\\"review_ledger_sha256\\\": bundle.review_ledger.value[\\\"ledger_sha256\\\"],\\n        \\\"review_ledger_file_sha256\\\": bundle.review_ledger.sha256,\\n        \\\"selection_verification_status\\\": selection[\\\"selection_verification_status\\\"],\\n        \\\"selection_receipt_file_sha256\\\": bundle.selection_receipt.sha256,\\n        \\\"assignment_verification_status\\\": split[\\\"assignment_verification_status\\\"],\\n        \\\"assignment_receipt_file_sha256\\\": bundle.assignment_receipt.sha256,\\n        \\\"overlap_commitment_verification_status\\\": split[\\n            \\\"overlap_commitment_verification_status\\\"\\n        ],\\n        \\\"overlap_commitment_receipt_file_sha256\\\": bundle.overlap_receipt.sha256,\\n        \\\"calibration_min_independent_tasks\\\": split[\\n            \\\"calibration_min_independent_tasks\\\"\\n        ],\\n        \\\"holdout_plaintext\\\": split[\\\"holdout_plaintext\\\"],\\n        \\\"independence_closure_algorithm\\\": \\\"family_fix_session_material_edge_transitive_closure_v1\\\",\\n        \\\"independence_cluster_count\\\": cluster_count,\\n        \\\"independence_projection_sha256\\\": closure_sha,\\n        \\\"calibration_members\\\": projected_members,\\n    }\\n    binding[\\\"identity_sha256\\\"] = _self_sha256(binding)\\n    return binding, task_ids, cluster_by_task\\n\\n\\ndef _validate_population_binding(\\n    value: Any,\\n    *,\\n    bundle: ArtifactBundle,\\n    product_root: Mapping[str, Any],\\n) -> tuple[list[str], dict[str, dict[str, Any]], dict[str, str]]:\\n    expected, task_ids, cluster_by_task = _derive_population_binding(\\n        bundle=bundle, product_root=product_root\\n    )\\n    _require(value == expected, \\\"task-population projection differs from validated raw artifacts\\\")\\n    by_task = {member[\\\"task_id\\\"]: member for member in expected[\\\"calibration_members\\\"]}\\n    return task_ids, by_task, cluster_by_task\\n\\n\\ndef _precalibration_plan_sha256(product_root: Mapping[str, Any]) -> str:\\n    \\\"\\\"\\\"Hash only inputs that exist before any calibration outcome is opened.\\\"\\\"\\\"\\n    design = product_root[\\\"design\\\"]\\n    return PRODUCT.value_sha256(\\n        {\\n            \\\"schema\\\": \\\"agent-brain-product-cycle-precalibration-plan/v1\\\",\\n            \\\"purpose\\\": product_root[\\\"purpose\\\"],\\n            \\\"evidence_class\\\": product_root[\\\"evidence_class\\\"],\\n            \\\"claim_scope\\\": product_root[\\\"claim_scope\\\"],\\n            \\\"product_identity_binding_sha256\\\": product_root[\\\"product_identities\\\"][\\n                \\\"binding_sha256\\\"\\n            ],\\n            \\\"task_inventory_sha256\\\": product_root[\\\"task_inventory_sha256\\\"],\\n            \\\"shared_execution_identity_sha256\\\": product_root[\\\"shared_execution\\\"][\\n                \\\"identity_sha256\\\"\\n            ],\\n            \\\"arms\\\": design[\\\"arms\\\"],\\n            \\\"arm_product_roles\\\": design[\\\"arm_product_roles\\\"],\\n            \\\"primary_contrast\\\": design[\\\"primary_contrast\\\"],\\n            \\\"diagnostic_contrast\\\": design[\\\"diagnostic_contrast\\\"],\\n            \\\"task_clusters\\\": design[\\\"task_clusters\\\"],\\n            \\\"repetitions_per_arm\\\": design[\\\"repetitions_per_arm\\\"],\\n            \\\"requested_cells\\\": design[\\\"requested_cells\\\"],\\n            \\\"agent_retry_limit\\\": design[\\\"agent_retry_limit\\\"],\\n            \\\"replacement_cell_limit\\\": design[\\\"replacement_cell_limit\\\"],\\n            \\\"reserve_cell_limit\\\": design[\\\"reserve_cell_limit\\\"],\\n            \\\"maximum_agent_invocations\\\": design[\\\"maximum_agent_invocations\\\"],\\n            \\\"budget\\\": design[\\\"budget\\\"],\\n            \\\"schedule_sha256\\\": product_root[\\\"shared_execution\\\"][\\\"schedule_sha256\\\"],\\n        }\\n    )\\n\\n\\ndef _file_sha256(path: pathlib.Path, label: str) -> str:\\n    return hashlib.sha256(_read_regular_bytes(path, label)).hexdigest()\\n\\n\\ndef _expected_implementation_lock(bundle: ArtifactBundle) -> dict[str, Any]:\\n    \\\"\\\"\\\"Build the exact lock for the current analyzer, validators, and schemas.\\\"\\\"\\\"\\n    lock: dict[str, Any] = {\\n        \\\"schema\\\": \\\"agent-brain-power-v4-implementation-lock/v1\\\",\\n        \\\"analyzer_path\\\": \\\"benchmarks/agent-brain/confirmatory/power_analysis_v4.py\\\",\\n        \\\"analyzer_file_sha256\\\": _file_sha256(\\n            HERE / \\\"power_analysis_v4.py\\\", \\\"power-v4 analyzer\\\"\\n        ),\\n        \\\"draft202012_validator_file_sha256\\\": _file_sha256(\\n            HERE / \\\"draft202012.py\\\", \\\"Draft 2020-12 validator\\\"\\n        ),\\n        \\\"product_cycle_validator_file_sha256\\\": _file_sha256(\\n            HERE / \\\"product_cycle.py\\\", \\\"product-cycle validator\\\"\\n        ),\\n        \\\"task_population_validator_file_sha256\\\": _file_sha256(\\n            HERE / \\\"task_population.py\\\", \\\"task-population validator\\\"\\n        ),\\n        \\\"product_cycle_schema_file_sha256\\\": bundle.schemas[\\\"product_cycle\\\"].sha256,\\n        \\\"task_population_schema_file_sha256\\\": bundle.schemas[\\\"task_population\\\"].sha256,\\n        \\\"review_ledger_schema_file_sha256\\\": bundle.schemas[\\\"review_ledger\\\"].sha256,\\n        \\\"final_calibration_schema_file_sha256\\\": bundle.schemas[\\n            \\\"final_calibration\\\"\\n        ].sha256,\\n        \\\"power_report_schema_file_sha256\\\": bundle.schemas[\\\"power_report\\\"].sha256,\\n        \\\"population_receipt_schema_file_sha256\\\": bundle.schemas[\\n            \\\"population_receipt\\\"\\n        ].sha256,\\n        \\\"candidate_lock_receipt_schema_file_sha256\\\": bundle.schemas[\\n            \\\"candidate_lock_receipt\\\"\\n        ].sha256,\\n        \\\"owner_approval_receipt_schema_file_sha256\\\": bundle.schemas[\\n            \\\"owner_approval_receipt\\\"\\n        ].sha256,\\n    }\\n    lock[\\\"identity_sha256\\\"] = _self_sha256(lock)\\n    return lock\\n\\n\\ndef _validate_implementation_lock(\\n    value: Any, *, bundle: ArtifactBundle\\n) -> dict[str, Any]:\\n    lock = _exact_keys(\\n        value,\\n        {\\n            \\\"schema\\\",\\n            \\\"analyzer_path\\\",\\n            \\\"analyzer_file_sha256\\\",\\n            \\\"draft202012_validator_file_sha256\\\",\\n            \\\"product_cycle_validator_file_sha256\\\",\\n            \\\"task_population_validator_file_sha256\\\",\\n            \\\"product_cycle_schema_file_sha256\\\",\\n            \\\"task_population_schema_file_sha256\\\",\\n            \\\"review_ledger_schema_file_sha256\\\",\\n            \\\"final_calibration_schema_file_sha256\\\",\\n            \\\"power_report_schema_file_sha256\\\",\\n            \\\"population_receipt_schema_file_sha256\\\",\\n            \\\"candidate_lock_receipt_schema_file_sha256\\\",\\n            \\\"owner_approval_receipt_schema_file_sha256\\\",\\n            \\\"identity_sha256\\\",\\n        },\\n        \\\"v4_implementation_lock\\\",\\n    )\\n    expected = _expected_implementation_lock(bundle)\\n    for field, expected_value in expected.items():\\n        _require(lock[field] == expected_value, f\\\"v4 implementation lock drift: {field}\\\")\\n    _require(\\n        lock[\\\"identity_sha256\\\"] == _self_sha256(lock),\\n        \\\"v4 implementation lock identity hash mismatch\\\",\\n    )\\n    return lock\\n\\n\\ndef _validate_execution_contract(\\n    value: Any, *, product_root: Mapping[str, Any]\\n) -> dict[str, Any]:\\n    contract = _exact_keys(\\n        value,\\n        {\\n            \\\"schema\\\",\\n            \\\"status\\\",\\n            \\\"provider_id\\\",\\n            \\\"agent_cli_id\\\",\\n            \\\"agent_cli_version\\\",\\n            \\\"requested_model_id\\\",\\n            \\\"resolved_model_id\\\",\\n            \\\"effort\\\",\\n            \\\"runner_sha256\\\",\\n            \\\"timeout_policy_sha256\\\",\\n            \\\"agent_timeout_limit_seconds\\\",\\n            \\\"timeout_component_limit_seconds\\\",\\n            \\\"identity_sha256\\\",\\n        },\\n        \\\"execution_contract\\\",\\n    )\\n    _require(contract[\\\"schema\\\"] == \\\"agent-brain-power-v4-execution-contract/v1\\\", \\\"execution contract schema changed\\\")\\n    _require(contract[\\\"status\\\"] == \\\"locked_before_calibration_opening\\\", \\\"execution contract was not locked before calibration\\\")\\n    for field in (\\n        \\\"provider_id\\\",\\n        \\\"agent_cli_id\\\",\\n        \\\"agent_cli_version\\\",\\n        \\\"requested_model_id\\\",\\n        \\\"resolved_model_id\\\",\\n        \\\"effort\\\",\\n    ):\\n        _nonempty(contract[field], f\\\"execution_contract.{field}\\\")\\n    shared = product_root[\\\"shared_execution\\\"]\\n    _require(contract[\\\"resolved_model_id\\\"] == shared[\\\"model_id\\\"], \\\"resolved model identity drift\\\")\\n    _require(contract[\\\"effort\\\"] == shared[\\\"effort\\\"], \\\"execution effort drift\\\")\\n    _require(contract[\\\"runner_sha256\\\"] == shared[\\\"runner_sha256\\\"], \\\"execution runner drift\\\")\\n    _sha256(contract[\\\"timeout_policy_sha256\\\"], \\\"execution_contract.timeout_policy_sha256\\\")\\n    _positive_int(\\n        contract[\\\"agent_timeout_limit_seconds\\\"],\\n        \\\"execution_contract.agent_timeout_limit_seconds\\\",\\n    )\\n    component_limit = contract[\\\"timeout_component_limit_seconds\\\"]\\n    _require(\\n        component_limit is None or (type(component_limit) is int and component_limit > 0),\\n        \\\"execution_contract.timeout_component_limit_seconds is invalid\\\",\\n    )\\n    _require(\\n        contract[\\\"identity_sha256\\\"] == _self_sha256(contract),\\n        \\\"execution contract identity hash mismatch\\\",\\n    )\\n    return contract\\n\\n\\ndef _validate_execution_attestations(\\n    value: Any,\\n    *,\\n    product_root: Mapping[str, Any],\\n    execution_contract: Mapping[str, Any],\\n) -> str:\\n    _require(isinstance(value, list), \\\"execution_attestations must be a list\\\")\\n    cells = {str(cell[\\\"run_id\\\"]): cell for cell in product_root[\\\"cells\\\"]}\\n    _require(len(value) == len(cells), \\\"execution attestation count differs from product cells\\\")\\n    expected_shared = {\\n        \\\"provider_id\\\": execution_contract[\\\"provider_id\\\"],\\n        \\\"agent_cli_id\\\": execution_contract[\\\"agent_cli_id\\\"],\\n        \\\"agent_cli_version\\\": execution_contract[\\\"agent_cli_version\\\"],\\n        \\\"requested_model_id\\\": execution_contract[\\\"requested_model_id\\\"],\\n        \\\"resolved_model_id\\\": execution_contract[\\\"resolved_model_id\\\"],\\n        \\\"effort\\\": execution_contract[\\\"effort\\\"],\\n        \\\"runner_sha256\\\": execution_contract[\\\"runner_sha256\\\"],\\n        \\\"timeout_policy_sha256\\\": execution_contract[\\\"timeout_policy_sha256\\\"],\\n        \\\"agent_timeout_limit_seconds\\\": execution_contract[\\n            \\\"agent_timeout_limit_seconds\\\"\\n        ],\\n        \\\"timeout_component_limit_seconds\\\": execution_contract[\\n            \\\"timeout_component_limit_seconds\\\"\\n        ],\\n    }\\n    seen: set[str] = set()\\n    for index, raw in enumerate(value):\\n        label = f\\\"execution_attestations[{index}]\\\"\\n        attestation = _exact_keys(\\n            raw,\\n            {\\n                \\\"run_id\\\",\\n                \\\"cell_identity_sha256\\\",\\n                *expected_shared.keys(),\\n                \\\"identity_sha256\\\",\\n            },\\n            label,\\n        )\\n        run_id = _nonempty(attestation[\\\"run_id\\\"], f\\\"{label}.run_id\\\")\\n        _require(run_id in cells and run_id not in seen, f\\\"{label} run identity drift\\\")\\n        seen.add(run_id)\\n        cell = cells[run_id]\\n        _require(\\n            attestation[\\\"cell_identity_sha256\\\"] == cell[\\\"identity_sha256\\\"],\\n            f\\\"{label} cell identity drift\\\",\\n        )\\n        for field, expected_value in expected_shared.items():\\n            _require(attestation[field] == expected_value, f\\\"{label}.{field} parity drift\\\")\\n        execution = cell[\\\"execution_identity\\\"]\\n        timing = cell[\\\"outcome\\\"][\\\"timing\\\"]\\n        _require(attestation[\\\"runner_sha256\\\"] == execution[\\\"runner_sha256\\\"], f\\\"{label} runner/cell drift\\\")\\n        _require(attestation[\\\"resolved_model_id\\\"] == execution[\\\"model_id\\\"], f\\\"{label} resolved-model/cell drift\\\")\\n        _require(attestation[\\\"effort\\\"] == execution[\\\"effort\\\"], f\\\"{label} effort/cell drift\\\")\\n        _require(\\n            attestation[\\\"agent_timeout_limit_seconds\\\"]\\n            == timing[\\\"agent_timeout_limit_seconds\\\"],\\n            f\\\"{label} agent-timeout/cell drift\\\",\\n        )\\n        _require(\\n            attestation[\\\"timeout_component_limit_seconds\\\"]\\n            == timing[\\\"timeout_component_limit_seconds\\\"],\\n            f\\\"{label} component-timeout/cell drift\\\",\\n        )\\n        _require(\\n            attestation[\\\"identity_sha256\\\"] == _self_sha256(attestation),\\n            f\\\"{label} identity hash mismatch\\\",\\n        )\\n    _require([row[\\\"run_id\\\"] for row in value] == sorted(seen), \\\"execution attestations must be ordered by run_id\\\")\\n    return PRODUCT.value_sha256(value)\\n\\n\\ndef _validate_candidate_lock(\\n    value: Any,\\n    *,\\n    bundle: ArtifactBundle,\\n    product_root: Mapping[str, Any],\\n    population_binding: Mapping[str, Any],\\n    complete_plan_sha256: str,\\n) -> dict[str, Any]:\\n    lock = _exact_keys(\\n        value,\\n        {\\n            \\\"status\\\",\\n            \\\"candidate_product_identity_sha256\\\",\\n            \\\"complete_plan_sha256\\\",\\n            \\\"task_population_contract_sha256\\\",\\n            \\\"task_population_file_sha256\\\",\\n            \\\"lock_receipt_file_sha256\\\",\\n            \\\"authentication_status\\\",\\n            \\\"identity_sha256\\\",\\n        },\\n        \\\"candidate_lock\\\",\\n    )\\n    _require(\\n        lock[\\\"status\\\"] == \\\"structurally_locked_before_development_calibration\\\",\\n        \\\"candidate lock must precede development calibration\\\",\\n    )\\n    candidate_sha = _sha256(\\n        lock[\\\"candidate_product_identity_sha256\\\"],\\n        \\\"candidate_lock.candidate_product_identity_sha256\\\",\\n    )\\n    _require(\\n        candidate_sha\\n        == product_root[\\\"product_identities\\\"][\\\"candidate\\\"][\\\"identity_sha256\\\"],\\n        \\\"candidate lock product identity drift\\\",\\n    )\\n    _require(\\n        lock[\\\"complete_plan_sha256\\\"] == complete_plan_sha256,\\n        \\\"candidate lock complete-plan drift\\\",\\n    )\\n    population_sha = _sha256(\\n        lock[\\\"task_population_contract_sha256\\\"],\\n        \\\"candidate_lock.task_population_contract_sha256\\\",\\n    )\\n    _require(\\n        population_sha == population_binding[\\\"population_sha256\\\"],\\n        \\\"candidate lock task-population contract drift\\\",\\n    )\\n    _require(\\n        lock[\\\"task_population_file_sha256\\\"] == bundle.task_population.sha256,\\n        \\\"candidate lock task-population raw bytes drift\\\",\\n    )\\n    _require(\\n        lock[\\\"lock_receipt_file_sha256\\\"] == bundle.candidate_lock_receipt.sha256,\\n        \\\"candidate-lock receipt raw bytes drift\\\",\\n    )\\n    _require(\\n        lock[\\\"authentication_status\\\"] == NO_TRUST_ANCHOR,\\n        \\\"candidate-lock authentication status drift\\\",\\n    )\\n    receipt = bundle.candidate_lock_receipt.value\\n    expected_receipt = {\\n        \\\"complete_plan_sha256\\\": complete_plan_sha256,\\n        \\\"candidate_product_identity_sha256\\\": candidate_sha,\\n        \\\"task_population_file_sha256\\\": bundle.task_population.sha256,\\n        \\\"authentication_status\\\": NO_TRUST_ANCHOR,\\n    }\\n    for field, expected_value in expected_receipt.items():\\n        _require(receipt[field] == expected_value, f\\\"candidate-lock receipt drift: {field}\\\")\\n    _require(\\n        receipt[\\\"identity_sha256\\\"] == _self_sha256(receipt),\\n        \\\"candidate-lock receipt identity hash mismatch\\\",\\n    )\\n    digest = _sha256(lock[\\\"identity_sha256\\\"], \\\"candidate_lock.identity_sha256\\\")\\n    _require(digest == _self_sha256(lock), \\\"candidate lock identity hash mismatch\\\")\\n    return lock\\n\\n\\ndef _validate_source_byte_bindings(\\n    value: Any,\\n    *,\\n    bundle: ArtifactBundle,\\n    product_root: Mapping[str, Any],\\n    population_binding: Mapping[str, Any],\\n    implementation_lock_sha256: str,\\n    execution_attestations_sha256: str,\\n) -> dict[str, Any]:\\n    bindings = _exact_keys(\\n        value,\\n        {\\n            \\\"product_cycle_file_sha256\\\",\\n            \\\"product_cycle_schema_file_sha256\\\",\\n            \\\"product_cycle_contract_sha256\\\",\\n            \\\"product_cycle_evidence_canonical_bytes_sha256\\\",\\n            \\\"task_population_schema_file_sha256\\\",\\n            \\\"task_population_contract_file_sha256\\\",\\n            \\\"task_population_contract_sha256\\\",\\n            \\\"task_population_binding_canonical_bytes_sha256\\\",\\n            \\\"review_ledger_schema_file_sha256\\\",\\n            \\\"review_ledger_file_sha256\\\",\\n            \\\"review_ledger_sha256\\\",\\n            \\\"selection_receipt_file_sha256\\\",\\n            \\\"assignment_receipt_file_sha256\\\",\\n            \\\"overlap_receipt_file_sha256\\\",\\n            \\\"candidate_lock_receipt_file_sha256\\\",\\n            \\\"owner_approval_receipt_file_sha256\\\",\\n            \\\"v4_implementation_lock_sha256\\\",\\n            \\\"execution_attestations_sha256\\\",\\n            \\\"identity_sha256\\\",\\n        },\\n        \\\"source_byte_bindings\\\",\\n    )\\n    expected = {\\n        \\\"product_cycle_file_sha256\\\": bundle.product_cycle.sha256,\\n        \\\"product_cycle_schema_file_sha256\\\": bundle.schemas[\\\"product_cycle\\\"].sha256,\\n        \\\"product_cycle_contract_sha256\\\": product_root[\\\"manifest_sha256\\\"],\\n        \\\"product_cycle_evidence_canonical_bytes_sha256\\\": PRODUCT.value_sha256(\\n            product_root\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839595.987682}}}
{"timestamp":"2026-09-19T17:39:55.988Z","ordinal":7541,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":69760850,"cached_input_tokens":66555264,"cache_write_input_tokens":0,"output_tokens":100956,"reasoning_output_tokens":14607,"total_tokens":69861806},"last_token_usage":{"input_tokens":134967,"cached_input_tokens":129664,"cache_write_input_tokens":0,"output_tokens":72,"reasoning_output_tokens":21,"total_tokens":135039},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":15.0,"window_minutes":10080,"resets_at":1790414256},"secondary":null,"credits":{"has_credits":true,"unlimited":false,"balance":"1118.8998305000"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
