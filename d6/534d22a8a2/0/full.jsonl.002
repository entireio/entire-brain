{"timestamp":"2026-09-19T17:38:43.566Z","ordinal":7466,"type":"token_usage_record","payload":{"thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","session_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","root_turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","response_id":"resp_0cb48b2b18d09e75016aaec8a0b34087d2ba2a59de5236321a","usage":{"input_tokens":63718,"cached_input_tokens":57728,"cache_write_input_tokens":0,"output_tokens":50,"reasoning_output_tokens":0,"total_tokens":63768},"turn_token_usage":{"input_tokens":71623870,"cached_input_tokens":68546432,"cache_write_input_tokens":0,"output_tokens":170517,"reasoning_output_tokens":14438,"total_tokens":71794387},"thread_token_usage":{"input_tokens":137508889,"cached_input_tokens":131118464,"cache_write_input_tokens":0,"output_tokens":355316,"reasoning_output_tokens":35815,"total_tokens":137864205}}}
{"timestamp":"2026-09-19T17:38:43.590Z","ordinal":7467,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","item":{"type":"CommandExecution","id":"exec-8b4da6fb-3db7-4398-8273-0b620696256f","process_id":"83678","command":["/bin/zsh","-lc","sed -n '971,1444p' benchmarks/agent-brain/confirmatory/offline_relevance_eval.py"],"cwd":"file:///Users/thomi/.codex/worktrees/5d33/entire-brain","parsed_cmd":[{"type":"read","cmd":"sed -n '971,1444p' benchmarks/agent-brain/confirmatory/offline_relevance_eval.py","name":"offline_relevance_eval.py","path":"benchmarks/agent-brain/confirmatory/offline_relevance_eval.py"}],"source":"unified_exec_startup","status":"completed","stdout":"\ndef _mrr(results: list[dict[str, Any]], positives: set[str]) -> float:\n    for rank, result in enumerate(results[:MRR_CUTOFF], 1):\n        if result[\"fact_id\"] in positives:\n            return round(1.0 / rank, 12)\n    return 0.0\n\n\ndef _ndcg(results: list[dict[str, Any]], judgments: dict[str, dict[str, Any]]) -> float:\n    def gain(weight: int) -> float:\n        return float((2**weight) - 1)\n\n    dcg = 0.0\n    for rank, result in enumerate(results[:NDCG_CUTOFF], 1):\n        judgment = judgments.get(result[\"fact_id\"])\n        weight = GRADE_WEIGHTS[judgment[\"grade\"]] if judgment is not None else 0\n        dcg += gain(weight) / math.log2(rank + 1)\n    ideal_weights = sorted(\n        (GRADE_WEIGHTS[judgment[\"grade\"]] for judgment in judgments.values()), reverse=True\n    )[:NDCG_CUTOFF]\n    idcg = sum(gain(weight) / math.log2(rank + 1) for rank, weight in enumerate(ideal_weights, 1))\n    return round(dcg / idcg, 12) if idcg else 0.0\n\n\ndef _query_metrics(\n    query: dict[str, Any], dataset_item: dict[str, Any], k: int\n) -> dict[str, Any]:\n    results = query[\"ordered_results\"]\n    top = results[:k]\n    positives = dataset_item[\"positive_ids\"]\n    judgments = dataset_item[\"judgments\"]\n    grades = Counter(\n        judgments[result[\"fact_id\"]][\"grade\"]\n        if result[\"fact_id\"] in judgments\n        else \"unjudged\"\n        for result in top\n    )\n    kinds = Counter(result[\"kind\"] for result in top)\n    clusters = Counter(result[\"cluster_id\"] for result in top)\n    positive_hits = sum(result[\"fact_id\"] in positives for result in top)\n    return {\n        \"query_source\": query[\"query_source\"],\n        \"null_query\": query[\"null_query\"],\n        \"recall_at_1\": _recall(results, positives, 1),\n        \"recall_at_5\": _recall(results, positives, 5),\n        \"recall_at_10\": _recall(results, positives, 10),\n        \"mrr\": _mrr(results, positives),\n        \"ndcg_at_10\": _ndcg(results, judgments),\n        \"precision_at_k\": _ratio(positive_hits, k),\n        \"positive_hits\": positive_hits,\n        \"hard_topical_distractor_hits\": grades[\"hard_topical_distractor\"],\n        \"irrelevant_hits\": grades[\"irrelevant\"],\n        \"unjudged_hits\": grades[\"unjudged\"],\n        \"result_count\": len(top),\n        \"kind_counts\": dict(sorted(kinds.items())),\n        \"maximum_cluster_occupancy\": max(clusters.values(), default=0),\n        \"duplicate_cluster_count\": sum(value > 1 for value in clusters.values()),\n        \"temporal_leakage_count\": sum(result[\"eligible\"] is not True for result in top),\n        \"packet_tokens\": sum(result[\"estimated_tokens\"] for result in top),\n        \"ranking_latency_ms\": query[\"telemetry\"][\"ranking_latency_ms\"],\n    }\n\n\ndef _aggregate_metrics(metrics: list[dict[str, Any]], *, product: bool, k: int) -> dict[str, Any]:\n    answerable = [metric for metric in metrics if not metric[\"null_query\"]]\n    nulls = [metric for metric in metrics if metric[\"null_query\"]]\n    kinds: Counter[str] = Counter()\n    for metric in metrics:\n        kinds.update(metric[\"kind_counts\"])\n    false_positive_nulls = sum(metric[\"result_count\"] > 0 for metric in nulls)\n    null_rate: float | None = (\n        _ratio(false_positive_nulls, len(nulls)) if nulls else None\n    )\n    result = {\n        \"query_count\": len(metrics),\n        \"answerable_query_count\": len(answerable),\n        \"null_query_count\": len(nulls),\n        \"mean_recall_at_1\": _mean(metric[\"recall_at_1\"] for metric in answerable),\n        \"mean_recall_at_5\": _mean(metric[\"recall_at_5\"] for metric in answerable),\n        \"mean_recall_at_10\": _mean(metric[\"recall_at_10\"] for metric in answerable),\n        \"mean_mrr\": _mean(metric[\"mrr\"] for metric in answerable),\n        \"mean_ndcg_at_10\": _mean(metric[\"ndcg_at_10\"] for metric in answerable),\n        \"mean_precision_at_k\": _mean(metric[\"precision_at_k\"] for metric in metrics),\n        \"positive_hits\": sum(metric[\"positive_hits\"] for metric in metrics),\n        \"hard_topical_distractor_hits\": sum(\n            metric[\"hard_topical_distractor_hits\"] for metric in metrics\n        ),\n        \"irrelevant_hits\": sum(metric[\"irrelevant_hits\"] for metric in metrics),\n        \"unjudged_hits\": sum(metric[\"unjudged_hits\"] for metric in metrics),\n        \"result_count\": sum(metric[\"result_count\"] for metric in metrics),\n        \"kind_distribution\": dict(sorted(kinds.items())),\n        \"maximum_cluster_occupancy\": max(\n            (metric[\"maximum_cluster_occupancy\"] for metric in metrics), default=0\n        ),\n        \"duplicate_cluster_query_count\": sum(\n            metric[\"duplicate_cluster_count\"] > 0 for metric in metrics\n        ),\n        \"temporal_leakage_count\": sum(\n            metric[\"temporal_leakage_count\"] for metric in metrics\n        ),\n        \"null_false_positive_numerator\": false_positive_nulls,\n        \"null_false_positive_denominator\": len(nulls),\n        \"null_query_false_positive_rate\": null_rate,\n        \"packet_tokens_total\": sum(metric[\"packet_tokens\"] for metric in metrics),\n        \"ranking_latency_ms_total\": round(\n            sum(metric[\"ranking_latency_ms\"] for metric in metrics), 12\n        ),\n        \"k\": k,\n    }\n    if product and (not answerable or not nulls):\n        raise EvaluationError(\"product metrics require answerable and null query strata\")\n    if not product and not answerable:\n        raise EvaluationError(\"oracle metrics require an answerable query\")\n    return result\n\n\ndef _candidate_metrics(\n    run: dict[str, Any],\n    dataset_index: dict[str, Any],\n    k: int,\n    *,\n    authoritative_thresholds_enabled: bool,\n) -> dict[str, Any]:\n    product_metrics: list[dict[str, Any]] = []\n    oracle_metrics: list[dict[str, Any]] = []\n    for query in run[\"queries\"]:\n        metric = _query_metrics(query, dataset_index[query[\"query_id\"]], k)\n        if query[\"query_source\"] == \"user_prompt_derived\":\n            product_metrics.append(metric)\n        else:\n            oracle_metrics.append(metric)\n    product = _aggregate_metrics(product_metrics, product=True, k=k)\n    oracle = _aggregate_metrics(oracle_metrics, product=False, k=k)\n    null_rate = product[\"null_query_false_positive_rate\"]\n    assert isinstance(null_rate, float)\n    threshold_values = {\n        \"answerable_product_recall_at_5\": product[\"mean_recall_at_5\"],\n        \"null_query_false_positive_rate\": null_rate,\n        \"temporal_leakage_count\": product[\"temporal_leakage_count\"]\n        + oracle[\"temporal_leakage_count\"],\n        \"maximum_cluster_occupancy\": max(\n            product[\"maximum_cluster_occupancy\"], oracle[\"maximum_cluster_occupancy\"]\n        ),\n    }\n    conditions_met = bool(\n        threshold_values[\"answerable_product_recall_at_5\"]\n        >= THRESHOLDS[\"answerable_product_recall_at_5_min\"]\n        and threshold_values[\"null_query_false_positive_rate\"]\n        <= THRESHOLDS[\"null_query_false_positive_rate_max\"]\n        and threshold_values[\"temporal_leakage_count\"] <= THRESHOLDS[\"temporal_leakage_max\"]\n        and threshold_values[\"maximum_cluster_occupancy\"]\n        <= THRESHOLDS[\"selected_packet_cluster_occupancy_max\"]\n    )\n    passed = bool(conditions_met and authoritative_thresholds_enabled)\n    return {\n        \"k\": k,\n        \"product\": product,\n        \"oracle\": oracle,\n        \"threshold_values\": threshold_values,\n        \"threshold_conditions_met\": conditions_met,\n        \"thresholds_passed\": passed,\n    }\n\n\ndef metric_contract() -> dict[str, Any]:\n    return {\n        \"schema\": METRIC_SCHEMA,\n        \"positive_grades\": list(POSITIVE_GRADES),\n        \"grade_weights\": dict(GRADE_WEIGHTS),\n        \"unjudged_policy\": \"zero_gain_and_nonrelevant_development_lower_bound\",\n        \"recall_denominator\": \"all_explicit_positive_judgments_per_answerable_query\",\n        \"precision_denominator\": \"fixed_k_with_missing_slots_nonrelevant\",\n        \"mrr_cutoff\": MRR_CUTOFF,\n        \"ndcg_cutoff\": NDCG_CUTOFF,\n        \"ndcg_gain\": \"two_to_grade_weight_minus_one\",\n        \"null_false_positive_numerator\": \"product_null_queries_with_any_result_in_top_k\",\n        \"null_false_positive_denominator\": \"product_null_query_count\",\n        \"temporal_leakage\": \"any_ranked_fact_not_derived_active_and_eligible_fails_closed\",\n        \"ranking_result_metadata_policy_scope\": (\n            \"fact_hash_kind_cluster_eligibility_and_query_telemetry_fields\"\n        ),\n        \"token_estimation_policy_scope\": \"positive_estimated_tokens_per_delivered_fact\",\n        \"serialization_policy_scope\": \"canonical_text_free_ranked_run_and_report_json\",\n        \"strata\": [\"user_prompt_derived\", \"oracle_upper_bound\"],\n    }\n\n\ndef selection_contract() -> dict[str, Any]:\n    return {\n        \"schema\": SELECTION_SCHEMA,\n        \"k_candidates\": list(K_CANDIDATES),\n        \"aggregation_candidates\": list(AGGREGATION_CANDIDATES),\n        \"thresholds\": copy.deepcopy(THRESHOLDS),\n        \"tie_break_order\": list(TIE_BREAK_ORDER),\n        \"decision_authority_requirement\": (\n            \"authoritative_status_required_for_threshold_pass_and_selection\"\n        ),\n        \"diagnostic_candidate_scope\": (\n            \"within_each_declared_engine_no_cross_engine_winner\"\n        ),\n        \"selection_scope\": \"authoritative_selection_disabled_in_v1\",\n    }\n\n\ndef decision_authority() -> dict[str, Any]:\n    \"\"\"Return the immutable fail-closed authority state for evaluator v1.\"\"\"\n    return {\n        \"status\": DECISION_AUTHORITY_STATUS,\n        \"authoritative_thresholds_enabled\": False,\n        \"producer_runner_bytes_verified\": False,\n        \"producer_code_bytes_verified\": False,\n        \"ranking_result_metadata_policy_bytes_verified\": False,\n        \"token_estimation_policy_bytes_verified\": False,\n        \"serialization_policy_bytes_verified\": False,\n        \"fact_metadata_catalog_verified\": False,\n        \"engine_evidence_verified\": False,\n        \"source_contract_verified\": False,\n        \"blocking_reasons\": list(DECISION_AUTHORITY_BLOCKERS),\n    }\n\n\ndef _selection_key(candidate: dict[str, Any]) -> tuple[Any, ...]:\n    product = candidate[\"metrics\"][\"product\"]\n    values = candidate[\"metrics\"][\"threshold_values\"]\n    return (\n        -int(candidate[\"metrics\"][\"threshold_conditions_met\"]),\n        -float(values[\"answerable_product_recall_at_5\"]),\n        float(values[\"null_query_false_positive_rate\"]),\n        int(values[\"temporal_leakage_count\"]),\n        int(values[\"maximum_cluster_occupancy\"]),\n        -float(product[\"mean_mrr\"]),\n        -float(product[\"mean_ndcg_at_10\"]),\n        -float(product[\"mean_precision_at_k\"]),\n        int(product[\"packet_tokens_total\"]),\n        int(candidate[\"k\"]),\n        AGGREGATION_CANDIDATES.index(candidate[\"aggregation_rule\"]),\n        candidate[\"run_id\"],\n    )\n\n\ndef evaluate(\n    *,\n    engine_matrix_raw: bytes,\n    engine_pins_raw: bytes,\n    producer_identity_raw: bytes,\n    fixture: dict[str, Any],\n    dataset_raw: bytes,\n    source_membership_raw: bytes,\n    ranked_run_raws: list[bytes],\n) -> dict[str, Any]:\n    \"\"\"Validate inputs, derive metrics, and return a self-hashed text-free report.\"\"\"\n    authority = decision_authority()\n    engine_matrix = _object(decode_json(engine_matrix_raw, \"engine matrix\"), \"engine matrix\")\n    engine_pins = _object(decode_json(engine_pins_raw, \"engine pins\"), \"engine pins\")\n    producer_identity = _validate_producer_identity(\n        decode_json(producer_identity_raw, \"producer identity\")\n    )\n    dataset = _object(decode_json(dataset_raw, \"dataset\"), \"dataset\")\n    source_membership_value = _object(\n        decode_json(source_membership_raw, \"source membership\"), \"source membership\"\n    )\n    fixture_index, fixture_order = _validate_fixture(fixture)\n    dataset_contract = _validate_dataset(dataset, fixture_index, fixture_order)\n    membership = _validate_membership(source_membership_value)\n    _validate_judgment_eligibility(dataset_contract, fixture_index, membership)\n    input_bindings = _build_input_bindings(\n        engine_matrix_raw,\n        engine_matrix,\n        engine_pins_raw,\n        engine_pins,\n        producer_identity_raw,\n        producer_identity,\n        fixture,\n        dataset_raw,\n        dataset,\n        source_membership_raw,\n        source_membership_value,\n    )\n    arm_order, _ = _engine_arms(engine_matrix)\n    decoded_runs: list[tuple[bytes, dict[str, Any]]] = []\n    run_ids: set[str] = set()\n    run_keys: set[tuple[str, str]] = set()\n    arm_identities: dict[str, dict[str, Any]] = {}\n    for index, raw in enumerate(ranked_run_raws):\n        decoded = decode_json(raw, f\"ranked run[{index}]\")\n        run = _validate_run(\n            decoded,\n            expected_bindings=input_bindings,\n            expected_producer_identity=producer_identity,\n            engine_matrix=engine_matrix,\n            engine_pins=engine_pins,\n            fixture_index=fixture_index,\n            fixture_order=fixture_order,\n            dataset_index=dataset_contract[\"items\"],\n            membership=membership,\n        )\n        if run[\"run_id\"] in run_ids:\n            raise EvaluationError(\"ranked run IDs are duplicated\")\n        run_ids.add(run[\"run_id\"])\n        key = (run[\"engine_identity\"][\"arm_id\"], run[\"aggregation_rule\"])\n        if key in run_keys:\n            raise EvaluationError(\"engine/aggregation ranked run is duplicated\")\n        run_keys.add(key)\n        prior_identity = arm_identities.setdefault(\n            run[\"engine_identity\"][\"arm_id\"], run[\"engine_identity\"]\n        )\n        if run[\"engine_identity\"] != prior_identity:\n            raise EvaluationError(\"engine identity differs across aggregation runs\")\n        decoded_runs.append((raw, run))\n    expected_keys = {\n        (arm_id, aggregation)\n        for arm_id in arm_order\n        for aggregation in AGGREGATION_CANDIDATES\n    }\n    if run_keys != expected_keys:\n        raise EvaluationError(\"ranked runs do not cover the full engine/aggregation matrix\")\n    arm_position = {arm_id: index for index, arm_id in enumerate(arm_order)}\n    decoded_runs.sort(\n        key=lambda pair: (\n            arm_position[pair[1][\"engine_identity\"][\"arm_id\"]],\n            AGGREGATION_CANDIDATES.index(pair[1][\"aggregation_rule\"]),\n            pair[1][\"run_id\"],\n        )\n    )\n    evaluated: list[dict[str, Any]] = []\n    selectable: dict[str, list[dict[str, Any]]] = {arm_id: [] for arm_id in arm_order}\n    for raw, run in decoded_runs:\n        candidates = [\n            _candidate_metrics(\n                run,\n                dataset_contract[\"items\"],\n                k,\n                authoritative_thresholds_enabled=authority[\n                    \"authoritative_thresholds_enabled\"\n                ],\n            )\n            for k in K_CANDIDATES\n        ]\n        evaluated.append(\n            {\n                \"run_id\": run[\"run_id\"],\n                \"run_sha256\": run[\"run_sha256\"],\n                \"run_file_sha256\": sha256_bytes(raw),\n                \"producer_identity_sha256\": run[\"producer_identity\"][\n                    \"producer_identity_sha256\"\n                ],\n                \"engine_identity\": copy.deepcopy(run[\"engine_identity\"]),\n                \"aggregation_rule\": run[\"aggregation_rule\"],\n                \"candidates\": candidates,\n            }\n        )\n        for metrics in candidates:\n            selectable[run[\"engine_identity\"][\"arm_id\"]].append(\n                {\n                    \"run_id\": run[\"run_id\"],\n                    \"run_sha256\": run[\"run_sha256\"],\n                    \"aggregation_rule\": run[\"aggregation_rule\"],\n                    \"k\": metrics[\"k\"],\n                    \"metrics\": metrics,\n                }\n            )\n    diagnostic_best_candidates: list[dict[str, Any]] = []\n    selections: list[dict[str, Any]] = []\n    for arm_id in arm_order:\n        ordered = sorted(selectable[arm_id], key=_selection_key)\n        diagnostic = ordered[0]\n        diagnostic_projection = {\n            \"arm_id\": arm_id,\n            \"run_id\": diagnostic[\"run_id\"],\n            \"run_sha256\": diagnostic[\"run_sha256\"],\n            \"aggregation_rule\": diagnostic[\"aggregation_rule\"],\n            \"k\": diagnostic[\"k\"],\n            \"threshold_conditions_met\": diagnostic[\"metrics\"][\n                \"threshold_conditions_met\"\n            ],\n        }\n        diagnostic_best_candidates.append(\n            {\n                \"status\": \"diagnostic_best_candidate\",\n                **diagnostic_projection,\n                \"diagnostic_selection_sha256\": sha256_bytes(\n                    canonical_json(diagnostic_projection)\n                ),\n            }\n        )\n        selections.append(\n            {\n                \"arm_id\": arm_id,\n                \"status\": \"non_authoritative\",\n                \"run_id\": None,\n                \"run_sha256\": None,\n                \"aggregation_rule\": None,\n                \"k\": None,\n                \"selection_sha256\": None,\n            }\n        )\n    generated_at = max(\n        (run[\"created_at\"] for _, run in decoded_runs),\n        key=lambda value: (_timestamp(value, \"ranked run created_at\")[1], value),\n    )\n    report = {\n        \"schema_version\": SCHEMA_VERSION,\n        \"schema\": REPORT_SCHEMA,\n        \"report_id\": \"entire-brain-offline-relevance-development-diagnostic-v1\",\n        \"generated_at\": generated_at,\n        \"input_bindings\": input_bindings,\n        \"producer_identity\": producer_identity,\n        \"decision_authority\": authority,\n        \"metric_contract\": metric_contract(),\n        \"selection_contract\": selection_contract(),\n        \"evaluated_runs\": evaluated,\n        \"diagnostic_best_candidates\": diagnostic_best_candidates,\n        \"selections\": selections,\n        \"report_sha256\": \"\",\n    }\n    return finalize_report(report)\n\n\ndef _load_public(path: pathlib.Path, label: str) -> bytes:\n    try:\n        return path.read_bytes()\n    except OSError as exc:\n        raise EvaluationError(f\"cannot read {label}: {exc}\") from exc\n\n\ndef main(argv: list[str] | None = None) -> int:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--repo-root\", type=pathlib.Path, default=pathlib.Path.cwd())\n    parser.add_argument(\"--producer-identity\", type=pathlib.Path, required=True)\n    parser.add_argument(\"--ranked-run\", action=\"append\", type=pathlib.Path, required=True)\n    parser.add_argument(\"--output\", type=pathlib.Path)\n    args = parser.parse_args(argv)\n    repo = args.repo_root.resolve()\n    confirmatory = repo / \"benchmarks\" / \"agent-brain\" / \"confirmatory\"\n    sys.path.insert(0, str(confirmatory))\n    try:\n        import development_relevance_queries as query_fixture  # type: ignore\n    except ImportError as exc:\n        print(f\"ERROR: cannot import verified query fixture loader: {exc}\", file=sys.stderr)\n        return 1\n\n    try:\n        fixture = query_fixture.load_verified_fixture(repo)\n        report = evaluate(\n            engine_matrix_raw=_load_public(confirmatory / \"engine-matrix.json\", \"engine matrix\"),\n            engine_pins_raw=_load_public(\n                confirmatory / \"engine-verification-pins.json\", \"engine pins\"\n            ),\n            producer_identity_raw=_load_public(\n                args.producer_identity, \"producer identity\"\n            ),\n            fixture=fixture,\n            dataset_raw=_load_public(\n                confirmatory / \"offline-relevance-dataset.json\", \"dataset\"\n            ),\n            source_membership_raw=_load_public(\n                confirmatory / \"offline-relevance-source-membership.json\",\n                \"source membership\",\n            ),\n            ranked_run_raws=[_load_public(path, \"ranked run\") for path in args.ranked_run],\n        )\n    except (EvaluationError, query_fixture.FixtureError) as exc:\n        print(f\"ERROR: {exc}\", file=sys.stderr)\n        return 1\n    output = canonical_json(report) + b\"\\n\"\n    if args.output is None:\n        sys.stdout.buffer.write(output)\n    else:\n        args.output.write_bytes(output)\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","stderr":"","aggregated_output":"\ndef _mrr(results: list[dict[str, Any]], positives: set[str]) -> float:\n    for rank, result in enumerate(results[:MRR_CUTOFF], 1):\n        if result[\"fact_id\"] in positives:\n            return round(1.0 / rank, 12)\n    return 0.0\n\n\ndef _ndcg(results: list[dict[str, Any]], judgments: dict[str, dict[str, Any]]) -> float:\n    def gain(weight: int) -> float:\n        return float((2**weight) - 1)\n\n    dcg = 0.0\n    for rank, result in enumerate(results[:NDCG_CUTOFF], 1):\n        judgment = judgments.get(result[\"fact_id\"])\n        weight = GRADE_WEIGHTS[judgment[\"grade\"]] if judgment is not None else 0\n        dcg += gain(weight) / math.log2(rank + 1)\n    ideal_weights = sorted(\n        (GRADE_WEIGHTS[judgment[\"grade\"]] for judgment in judgments.values()), reverse=True\n    )[:NDCG_CUTOFF]\n    idcg = sum(gain(weight) / math.log2(rank + 1) for rank, weight in enumerate(ideal_weights, 1))\n    return round(dcg / idcg, 12) if idcg else 0.0\n\n\ndef _query_metrics(\n    query: dict[str, Any], dataset_item: dict[str, Any], k: int\n) -> dict[str, Any]:\n    results = query[\"ordered_results\"]\n    top = results[:k]\n    positives = dataset_item[\"positive_ids\"]\n    judgments = dataset_item[\"judgments\"]\n    grades = Counter(\n        judgments[result[\"fact_id\"]][\"grade\"]\n        if result[\"fact_id\"] in judgments\n        else \"unjudged\"\n        for result in top\n    )\n    kinds = Counter(result[\"kind\"] for result in top)\n    clusters = Counter(result[\"cluster_id\"] for result in top)\n    positive_hits = sum(result[\"fact_id\"] in positives for result in top)\n    return {\n        \"query_source\": query[\"query_source\"],\n        \"null_query\": query[\"null_query\"],\n        \"recall_at_1\": _recall(results, positives, 1),\n        \"recall_at_5\": _recall(results, positives, 5),\n        \"recall_at_10\": _recall(results, positives, 10),\n        \"mrr\": _mrr(results, positives),\n        \"ndcg_at_10\": _ndcg(results, judgments),\n        \"precision_at_k\": _ratio(positive_hits, k),\n        \"positive_hits\": positive_hits,\n        \"hard_topical_distractor_hits\": grades[\"hard_topical_distractor\"],\n        \"irrelevant_hits\": grades[\"irrelevant\"],\n        \"unjudged_hits\": grades[\"unjudged\"],\n        \"result_count\": len(top),\n        \"kind_counts\": dict(sorted(kinds.items())),\n        \"maximum_cluster_occupancy\": max(clusters.values(), default=0),\n        \"duplicate_cluster_count\": sum(value > 1 for value in clusters.values()),\n        \"temporal_leakage_count\": sum(result[\"eligible\"] is not True for result in top),\n        \"packet_tokens\": sum(result[\"estimated_tokens\"] for result in top),\n        \"ranking_latency_ms\": query[\"telemetry\"][\"ranking_latency_ms\"],\n    }\n\n\ndef _aggregate_metrics(metrics: list[dict[str, Any]], *, product: bool, k: int) -> dict[str, Any]:\n    answerable = [metric for metric in metrics if not metric[\"null_query\"]]\n    nulls = [metric for metric in metrics if metric[\"null_query\"]]\n    kinds: Counter[str] = Counter()\n    for metric in metrics:\n        kinds.update(metric[\"kind_counts\"])\n    false_positive_nulls = sum(metric[\"result_count\"] > 0 for metric in nulls)\n    null_rate: float | None = (\n        _ratio(false_positive_nulls, len(nulls)) if nulls else None\n    )\n    result = {\n        \"query_count\": len(metrics),\n        \"answerable_query_count\": len(answerable),\n        \"null_query_count\": len(nulls),\n        \"mean_recall_at_1\": _mean(metric[\"recall_at_1\"] for metric in answerable),\n        \"mean_recall_at_5\": _mean(metric[\"recall_at_5\"] for metric in answerable),\n        \"mean_recall_at_10\": _mean(metric[\"recall_at_10\"] for metric in answerable),\n        \"mean_mrr\": _mean(metric[\"mrr\"] for metric in answerable),\n        \"mean_ndcg_at_10\": _mean(metric[\"ndcg_at_10\"] for metric in answerable),\n        \"mean_precision_at_k\": _mean(metric[\"precision_at_k\"] for metric in metrics),\n        \"positive_hits\": sum(metric[\"positive_hits\"] for metric in metrics),\n        \"hard_topical_distractor_hits\": sum(\n            metric[\"hard_topical_distractor_hits\"] for metric in metrics\n        ),\n        \"irrelevant_hits\": sum(metric[\"irrelevant_hits\"] for metric in metrics),\n        \"unjudged_hits\": sum(metric[\"unjudged_hits\"] for metric in metrics),\n        \"result_count\": sum(metric[\"result_count\"] for metric in metrics),\n        \"kind_distribution\": dict(sorted(kinds.items())),\n        \"maximum_cluster_occupancy\": max(\n            (metric[\"maximum_cluster_occupancy\"] for metric in metrics), default=0\n        ),\n        \"duplicate_cluster_query_count\": sum(\n            metric[\"duplicate_cluster_count\"] > 0 for metric in metrics\n        ),\n        \"temporal_leakage_count\": sum(\n            metric[\"temporal_leakage_count\"] for metric in metrics\n        ),\n        \"null_false_positive_numerator\": false_positive_nulls,\n        \"null_false_positive_denominator\": len(nulls),\n        \"null_query_false_positive_rate\": null_rate,\n        \"packet_tokens_total\": sum(metric[\"packet_tokens\"] for metric in metrics),\n        \"ranking_latency_ms_total\": round(\n            sum(metric[\"ranking_latency_ms\"] for metric in metrics), 12\n        ),\n        \"k\": k,\n    }\n    if product and (not answerable or not nulls):\n        raise EvaluationError(\"product metrics require answerable and null query strata\")\n    if not product and not answerable:\n        raise EvaluationError(\"oracle metrics require an answerable query\")\n    return result\n\n\ndef _candidate_metrics(\n    run: dict[str, Any],\n    dataset_index: dict[str, Any],\n    k: int,\n    *,\n    authoritative_thresholds_enabled: bool,\n) -> dict[str, Any]:\n    product_metrics: list[dict[str, Any]] = []\n    oracle_metrics: list[dict[str, Any]] = []\n    for query in run[\"queries\"]:\n        metric = _query_metrics(query, dataset_index[query[\"query_id\"]], k)\n        if query[\"query_source\"] == \"user_prompt_derived\":\n            product_metrics.append(metric)\n        else:\n            oracle_metrics.append(metric)\n    product = _aggregate_metrics(product_metrics, product=True, k=k)\n    oracle = _aggregate_metrics(oracle_metrics, product=False, k=k)\n    null_rate = product[\"null_query_false_positive_rate\"]\n    assert isinstance(null_rate, float)\n    threshold_values = {\n        \"answerable_product_recall_at_5\": product[\"mean_recall_at_5\"],\n        \"null_query_false_positive_rate\": null_rate,\n        \"temporal_leakage_count\": product[\"temporal_leakage_count\"]\n        + oracle[\"temporal_leakage_count\"],\n        \"maximum_cluster_occupancy\": max(\n            product[\"maximum_cluster_occupancy\"], oracle[\"maximum_cluster_occupancy\"]\n        ),\n    }\n    conditions_met = bool(\n        threshold_values[\"answerable_product_recall_at_5\"]\n        >= THRESHOLDS[\"answerable_product_recall_at_5_min\"]\n        and threshold_values[\"null_query_false_positive_rate\"]\n        <= THRESHOLDS[\"null_query_false_positive_rate_max\"]\n        and threshold_values[\"temporal_leakage_count\"] <= THRESHOLDS[\"temporal_leakage_max\"]\n        and threshold_values[\"maximum_cluster_occupancy\"]\n        <= THRESHOLDS[\"selected_packet_cluster_occupancy_max\"]\n    )\n    passed = bool(conditions_met and authoritative_thresholds_enabled)\n    return {\n        \"k\": k,\n        \"product\": product,\n        \"oracle\": oracle,\n        \"threshold_values\": threshold_values,\n        \"threshold_conditions_met\": conditions_met,\n        \"thresholds_passed\": passed,\n    }\n\n\ndef metric_contract() -> dict[str, Any]:\n    return {\n        \"schema\": METRIC_SCHEMA,\n        \"positive_grades\": list(POSITIVE_GRADES),\n        \"grade_weights\": dict(GRADE_WEIGHTS),\n        \"unjudged_policy\": \"zero_gain_and_nonrelevant_development_lower_bound\",\n        \"recall_denominator\": \"all_explicit_positive_judgments_per_answerable_query\",\n        \"precision_denominator\": \"fixed_k_with_missing_slots_nonrelevant\",\n        \"mrr_cutoff\": MRR_CUTOFF,\n        \"ndcg_cutoff\": NDCG_CUTOFF,\n        \"ndcg_gain\": \"two_to_grade_weight_minus_one\",\n        \"null_false_positive_numerator\": \"product_null_queries_with_any_result_in_top_k\",\n        \"null_false_positive_denominator\": \"product_null_query_count\",\n        \"temporal_leakage\": \"any_ranked_fact_not_derived_active_and_eligible_fails_closed\",\n        \"ranking_result_metadata_policy_scope\": (\n            \"fact_hash_kind_cluster_eligibility_and_query_telemetry_fields\"\n        ),\n        \"token_estimation_policy_scope\": \"positive_estimated_tokens_per_delivered_fact\",\n        \"serialization_policy_scope\": \"canonical_text_free_ranked_run_and_report_json\",\n        \"strata\": [\"user_prompt_derived\", \"oracle_upper_bound\"],\n    }\n\n\ndef selection_contract() -> dict[str, Any]:\n    return {\n        \"schema\": SELECTION_SCHEMA,\n        \"k_candidates\": list(K_CANDIDATES),\n        \"aggregation_candidates\": list(AGGREGATION_CANDIDATES),\n        \"thresholds\": copy.deepcopy(THRESHOLDS),\n        \"tie_break_order\": list(TIE_BREAK_ORDER),\n        \"decision_authority_requirement\": (\n            \"authoritative_status_required_for_threshold_pass_and_selection\"\n        ),\n        \"diagnostic_candidate_scope\": (\n            \"within_each_declared_engine_no_cross_engine_winner\"\n        ),\n        \"selection_scope\": \"authoritative_selection_disabled_in_v1\",\n    }\n\n\ndef decision_authority() -> dict[str, Any]:\n    \"\"\"Return the immutable fail-closed authority state for evaluator v1.\"\"\"\n    return {\n        \"status\": DECISION_AUTHORITY_STATUS,\n        \"authoritative_thresholds_enabled\": False,\n        \"producer_runner_bytes_verified\": False,\n        \"producer_code_bytes_verified\": False,\n        \"ranking_result_metadata_policy_bytes_verified\": False,\n        \"token_estimation_policy_bytes_verified\": False,\n        \"serialization_policy_bytes_verified\": False,\n        \"fact_metadata_catalog_verified\": False,\n        \"engine_evidence_verified\": False,\n        \"source_contract_verified\": False,\n        \"blocking_reasons\": list(DECISION_AUTHORITY_BLOCKERS),\n    }\n\n\ndef _selection_key(candidate: dict[str, Any]) -> tuple[Any, ...]:\n    product = candidate[\"metrics\"][\"product\"]\n    values = candidate[\"metrics\"][\"threshold_values\"]\n    return (\n        -int(candidate[\"metrics\"][\"threshold_conditions_met\"]),\n        -float(values[\"answerable_product_recall_at_5\"]),\n        float(values[\"null_query_false_positive_rate\"]),\n        int(values[\"temporal_leakage_count\"]),\n        int(values[\"maximum_cluster_occupancy\"]),\n        -float(product[\"mean_mrr\"]),\n        -float(product[\"mean_ndcg_at_10\"]),\n        -float(product[\"mean_precision_at_k\"]),\n        int(product[\"packet_tokens_total\"]),\n        int(candidate[\"k\"]),\n        AGGREGATION_CANDIDATES.index(candidate[\"aggregation_rule\"]),\n        candidate[\"run_id\"],\n    )\n\n\ndef evaluate(\n    *,\n    engine_matrix_raw: bytes,\n    engine_pins_raw: bytes,\n    producer_identity_raw: bytes,\n    fixture: dict[str, Any],\n    dataset_raw: bytes,\n    source_membership_raw: bytes,\n    ranked_run_raws: list[bytes],\n) -> dict[str, Any]:\n    \"\"\"Validate inputs, derive metrics, and return a self-hashed text-free report.\"\"\"\n    authority = decision_authority()\n    engine_matrix = _object(decode_json(engine_matrix_raw, \"engine matrix\"), \"engine matrix\")\n    engine_pins = _object(decode_json(engine_pins_raw, \"engine pins\"), \"engine pins\")\n    producer_identity = _validate_producer_identity(\n        decode_json(producer_identity_raw, \"producer identity\")\n    )\n    dataset = _object(decode_json(dataset_raw, \"dataset\"), \"dataset\")\n    source_membership_value = _object(\n        decode_json(source_membership_raw, \"source membership\"), \"source membership\"\n    )\n    fixture_index, fixture_order = _validate_fixture(fixture)\n    dataset_contract = _validate_dataset(dataset, fixture_index, fixture_order)\n    membership = _validate_membership(source_membership_value)\n    _validate_judgment_eligibility(dataset_contract, fixture_index, membership)\n    input_bindings = _build_input_bindings(\n        engine_matrix_raw,\n        engine_matrix,\n        engine_pins_raw,\n        engine_pins,\n        producer_identity_raw,\n        producer_identity,\n        fixture,\n        dataset_raw,\n        dataset,\n        source_membership_raw,\n        source_membership_value,\n    )\n    arm_order, _ = _engine_arms(engine_matrix)\n    decoded_runs: list[tuple[bytes, dict[str, Any]]] = []\n    run_ids: set[str] = set()\n    run_keys: set[tuple[str, str]] = set()\n    arm_identities: dict[str, dict[str, Any]] = {}\n    for index, raw in enumerate(ranked_run_raws):\n        decoded = decode_json(raw, f\"ranked run[{index}]\")\n        run = _validate_run(\n            decoded,\n            expected_bindings=input_bindings,\n            expected_producer_identity=producer_identity,\n            engine_matrix=engine_matrix,\n            engine_pins=engine_pins,\n            fixture_index=fixture_index,\n            fixture_order=fixture_order,\n            dataset_index=dataset_contract[\"items\"],\n            membership=membership,\n        )\n        if run[\"run_id\"] in run_ids:\n            raise EvaluationError(\"ranked run IDs are duplicated\")\n        run_ids.add(run[\"run_id\"])\n        key = (run[\"engine_identity\"][\"arm_id\"], run[\"aggregation_rule\"])\n        if key in run_keys:\n            raise EvaluationError(\"engine/aggregation ranked run is duplicated\")\n        run_keys.add(key)\n        prior_identity = arm_identities.setdefault(\n            run[\"engine_identity\"][\"arm_id\"], run[\"engine_identity\"]\n        )\n        if run[\"engine_identity\"] != prior_identity:\n            raise EvaluationError(\"engine identity differs across aggregation runs\")\n        decoded_runs.append((raw, run))\n    expected_keys = {\n        (arm_id, aggregation)\n        for arm_id in arm_order\n        for aggregation in AGGREGATION_CANDIDATES\n    }\n    if run_keys != expected_keys:\n        raise EvaluationError(\"ranked runs do not cover the full engine/aggregation matrix\")\n    arm_position = {arm_id: index for index, arm_id in enumerate(arm_order)}\n    decoded_runs.sort(\n        key=lambda pair: (\n            arm_position[pair[1][\"engine_identity\"][\"arm_id\"]],\n            AGGREGATION_CANDIDATES.index(pair[1][\"aggregation_rule\"]),\n            pair[1][\"run_id\"],\n        )\n    )\n    evaluated: list[dict[str, Any]] = []\n    selectable: dict[str, list[dict[str, Any]]] = {arm_id: [] for arm_id in arm_order}\n    for raw, run in decoded_runs:\n        candidates = [\n            _candidate_metrics(\n                run,\n                dataset_contract[\"items\"],\n                k,\n                authoritative_thresholds_enabled=authority[\n                    \"authoritative_thresholds_enabled\"\n                ],\n            )\n            for k in K_CANDIDATES\n        ]\n        evaluated.append(\n            {\n                \"run_id\": run[\"run_id\"],\n                \"run_sha256\": run[\"run_sha256\"],\n                \"run_file_sha256\": sha256_bytes(raw),\n                \"producer_identity_sha256\": run[\"producer_identity\"][\n                    \"producer_identity_sha256\"\n                ],\n                \"engine_identity\": copy.deepcopy(run[\"engine_identity\"]),\n                \"aggregation_rule\": run[\"aggregation_rule\"],\n                \"candidates\": candidates,\n            }\n        )\n        for metrics in candidates:\n            selectable[run[\"engine_identity\"][\"arm_id\"]].append(\n                {\n                    \"run_id\": run[\"run_id\"],\n                    \"run_sha256\": run[\"run_sha256\"],\n                    \"aggregation_rule\": run[\"aggregation_rule\"],\n                    \"k\": metrics[\"k\"],\n                    \"metrics\": metrics,\n                }\n            )\n    diagnostic_best_candidates: list[dict[str, Any]] = []\n    selections: list[dict[str, Any]] = []\n    for arm_id in arm_order:\n        ordered = sorted(selectable[arm_id], key=_selection_key)\n        diagnostic = ordered[0]\n        diagnostic_projection = {\n            \"arm_id\": arm_id,\n            \"run_id\": diagnostic[\"run_id\"],\n            \"run_sha256\": diagnostic[\"run_sha256\"],\n            \"aggregation_rule\": diagnostic[\"aggregation_rule\"],\n            \"k\": diagnostic[\"k\"],\n            \"threshold_conditions_met\": diagnostic[\"metrics\"][\n                \"threshold_conditions_met\"\n            ],\n        }\n        diagnostic_best_candidates.append(\n            {\n                \"status\": \"diagnostic_best_candidate\",\n                **diagnostic_projection,\n                \"diagnostic_selection_sha256\": sha256_bytes(\n                    canonical_json(diagnostic_projection)\n                ),\n            }\n        )\n        selections.append(\n            {\n                \"arm_id\": arm_id,\n                \"status\": \"non_authoritative\",\n                \"run_id\": None,\n                \"run_sha256\": None,\n                \"aggregation_rule\": None,\n                \"k\": None,\n                \"selection_sha256\": None,\n            }\n        )\n    generated_at = max(\n        (run[\"created_at\"] for _, run in decoded_runs),\n        key=lambda value: (_timestamp(value, \"ranked run created_at\")[1], value),\n    )\n    report = {\n        \"schema_version\": SCHEMA_VERSION,\n        \"schema\": REPORT_SCHEMA,\n        \"report_id\": \"entire-brain-offline-relevance-development-diagnostic-v1\",\n        \"generated_at\": generated_at,\n        \"input_bindings\": input_bindings,\n        \"producer_identity\": producer_identity,\n        \"decision_authority\": authority,\n        \"metric_contract\": metric_contract(),\n        \"selection_contract\": selection_contract(),\n        \"evaluated_runs\": evaluated,\n        \"diagnostic_best_candidates\": diagnostic_best_candidates,\n        \"selections\": selections,\n        \"report_sha256\": \"\",\n    }\n    return finalize_report(report)\n\n\ndef _load_public(path: pathlib.Path, label: str) -> bytes:\n    try:\n        return path.read_bytes()\n    except OSError as exc:\n        raise EvaluationError(f\"cannot read {label}: {exc}\") from exc\n\n\ndef main(argv: list[str] | None = None) -> int:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--repo-root\", type=pathlib.Path, default=pathlib.Path.cwd())\n    parser.add_argument(\"--producer-identity\", type=pathlib.Path, required=True)\n    parser.add_argument(\"--ranked-run\", action=\"append\", type=pathlib.Path, required=True)\n    parser.add_argument(\"--output\", type=pathlib.Path)\n    args = parser.parse_args(argv)\n    repo = args.repo_root.resolve()\n    confirmatory = repo / \"benchmarks\" / \"agent-brain\" / \"confirmatory\"\n    sys.path.insert(0, str(confirmatory))\n    try:\n        import development_relevance_queries as query_fixture  # type: ignore\n    except ImportError as exc:\n        print(f\"ERROR: cannot import verified query fixture loader: {exc}\", file=sys.stderr)\n        return 1\n\n    try:\n        fixture = query_fixture.load_verified_fixture(repo)\n        report = evaluate(\n            engine_matrix_raw=_load_public(confirmatory / \"engine-matrix.json\", \"engine matrix\"),\n            engine_pins_raw=_load_public(\n                confirmatory / \"engine-verification-pins.json\", \"engine pins\"\n            ),\n            producer_identity_raw=_load_public(\n                args.producer_identity, \"producer identity\"\n            ),\n            fixture=fixture,\n            dataset_raw=_load_public(\n                confirmatory / \"offline-relevance-dataset.json\", \"dataset\"\n            ),\n            source_membership_raw=_load_public(\n                confirmatory / \"offline-relevance-source-membership.json\",\n                \"source membership\",\n            ),\n            ranked_run_raws=[_load_public(path, \"ranked run\") for path in args.ranked_run],\n        )\n    except (EvaluationError, query_fixture.FixtureError) as exc:\n        print(f\"ERROR: {exc}\", file=sys.stderr)\n        return 1\n    output = canonical_json(report) + b\"\\n\"\n    if args.output is None:\n        sys.stdout.buffer.write(output)\n    else:\n        args.output.write_bytes(output)\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"duration":{"secs":0,"nanos":2959},"formatted_output":"\ndef _mrr(results: list[dict[str, Any]], positives: set[str]) -> float:\n    for rank, result in enumerate(results[:MRR_CUTOFF], 1):\n        if result[\"fact_id\"] in positives:\n            return round(1.0 / rank, 12)\n    return 0.0\n\n\ndef _ndcg(results: list[dict[str, Any]], judgments: dict[str, dict[str, Any]]) -> float:\n    def gain(weight: int) -> float:\n        return float((2**weight) - 1)\n\n    dcg = 0.0\n    for rank, result in enumerate(results[:NDCG_CUTOFF], 1):\n        judgment = judgments.get(result[\"fact_id\"])\n        weight = GRADE_WEIGHTS[judgment[\"grade\"]] if judgment is not None else 0\n        dcg += gain(weight) / math.log2(rank + 1)\n    ideal_weights = sorted(\n        (GRADE_WEIGHTS[judgment[\"grade\"]] for judgment in judgments.values()), reverse=True\n    )[:NDCG_CUTOFF]\n    idcg = sum(gain(weight) / math.log2(rank + 1) for rank, weight in enumerate(ideal_weights, 1))\n    return round(dcg / idcg, 12) if idcg else 0.0\n\n\ndef _query_metrics(\n    query: dict[str, Any], dataset_item: dict[str, Any], k: int\n) -> dict[str, Any]:\n    results = query[\"ordered_results\"]\n    top = results[:k]\n    positives = dataset_item[\"positive_ids\"]\n    judgments = dataset_item[\"judgments\"]\n    grades = Counter(\n        judgments[result[\"fact_id\"]][\"grade\"]\n        if result[\"fact_id\"] in judgments\n        else \"unjudged\"\n        for result in top\n    )\n    kinds = Counter(result[\"kind\"] for result in top)\n    clusters = Counter(result[\"cluster_id\"] for result in top)\n    positive_hits = sum(result[\"fact_id\"] in positives for result in top)\n    return {\n        \"query_source\": query[\"query_source\"],\n        \"null_query\": query[\"null_query\"],\n        \"recall_at_1\": _recall(results, positives, 1),\n        \"recall_at_5\": _recall(results, positives, 5),\n        \"recall_at_10\": _recall(results, positives, 10),\n        \"mrr\": _mrr(results, positives),\n        \"ndcg_at_10\": _ndcg(results, judgments),\n        \"precision_at_k\": _ratio(positive_hits, k),\n        \"positive_hits\": positive_hits,\n        \"hard_topical_distractor_hits\": grades[\"hard_topical_distractor\"],\n        \"irrelevant_hits\": grades[\"irrelevant\"],\n        \"unjudged_hits\": grades[\"unjudged\"],\n        \"result_count\": len(top),\n        \"kind_counts\": dict(sorted(kinds.items())),\n        \"maximum_cluster_occupancy\": max(clusters.values(), default=0),\n        \"duplicate_cluster_count\": sum(value > 1 for value in clusters.values()),\n        \"temporal_leakage_count\": sum(result[\"eligible\"] is not True for result in top),\n        \"packet_tokens\": sum(result[\"estimated_tokens\"] for result in top),\n        \"ranking_latency_ms\": query[\"telemetry\"][\"ranking_latency_ms\"],\n    }\n\n\ndef _aggregate_metrics(metrics: list[dict[str, Any]], *, product: bool, k: int) -> dict[str, Any]:\n    answerable = [metric for metric in metrics if not metric[\"null_query\"]]\n    nulls = [metric for metric in metrics if metric[\"null_query\"]]\n    kinds: Counter[str] = Counter()\n    for metric in metrics:\n        kinds.update(metric[\"kind_counts\"])\n    false_positive_nulls = sum(metric[\"result_count\"] > 0 for metric in nulls)\n    null_rate: float | None = (\n        _ratio(false_positive_nulls, len(nulls)) if nulls else None\n    )\n    result = {\n        \"query_count\": len(metrics),\n        \"answerable_query_count\": len(answerable),\n        \"null_query_count\": len(nulls),\n        \"mean_recall_at_1\": _mean(metric[\"recall_at_1\"] for metric in answerable),\n        \"mean_recall_at_5\": _mean(metric[\"recall_at_5\"] for metric in answerable),\n        \"mean_recall_at_10\": _mean(metric[\"recall_at_10\"] for metric in answerable),\n        \"mean_mrr\": _mean(metric[\"mrr\"] for metric in answerable),\n        \"mean_ndcg_at_10\": _mean(metric[\"ndcg_at_10\"] for metric in answerable),\n        \"mean_precision_at_k\": _mean(metric[\"precision_at_k\"] for metric in metrics),\n        \"positive_hits\": sum(metric[\"positive_hits\"] for metric in metrics),\n        \"hard_topical_distractor_hits\": sum(\n            metric[\"hard_topical_distractor_hits\"] for metric in metrics\n        ),\n        \"irrelevant_hits\": sum(metric[\"irrelevant_hits\"] for metric in metrics),\n        \"unjudged_hits\": sum(metric[\"unjudged_hits\"] for metric in metrics),\n        \"result_count\": sum(metric[\"result_count\"] for metric in metrics),\n        \"kind_distribution\": dict(sorted(kinds.items())),\n        \"maximum_cluster_occupancy\": max(\n            (metric[\"maximum_cluster_occupancy\"] for metric in metrics), default=0\n        ),\n        \"duplicate_cluster_query_count\": sum(\n            metric[\"duplicate_cluster_count\"] > 0 for metric in metrics\n        ),\n        \"temporal_leakage_count\": sum(\n            metric[\"temporal_leakage_count\"] for metric in metrics\n        ),\n        \"null_false_positive_numerator\": false_positive_nulls,\n        \"null_false_positive_denominator\": len(nulls),\n        \"null_query_false_positive_rate\": null_rate,\n        \"packet_tokens_total\": sum(metric[\"packet_tokens\"] for metric in metrics),\n        \"ranking_latency_ms_total\": round(\n            sum(metric[\"ranking_latency_ms\"] for metric in metrics), 12\n        ),\n        \"k\": k,\n    }\n    if product and (not answerable or not nulls):\n        raise EvaluationError(\"product metrics require answerable and null query strata\")\n    if not product and not answerable:\n        raise EvaluationError(\"oracle metrics require an answerable query\")\n    return result\n\n\ndef _candidate_metrics(\n    run: dict[str, Any],\n    dataset_index: dict[str, Any],\n    k: int,\n    *,\n    authoritative_thresholds_enabled: bool,\n) -> dict[str, Any]:\n    product_metrics: list[dict[str, Any]] = []\n    oracle_metrics: list[dict[str, Any]] = []\n    for query in run[\"queries\"]:\n        metric = _query_metrics(query, dataset_index[query[\"query_id\"]], k)\n        if query[\"query_source\"] == \"user_prompt_derived\":\n            product_metrics.append(metric)\n        else:\n            oracle_metrics.append(metric)\n    product = _aggregate_metrics(product_metrics, product=True, k=k)\n    oracle = _aggregate_metrics(oracle_metrics, product=False, k=k)\n    null_rate = product[\"null_query_false_positive_rate\"]\n    assert isinstance(null_rate, float)\n    threshold_values = {\n        \"answerable_product_recall_at_5\": product[\"mean_recall_at_5\"],\n        \"null_query_false_positive_rate\": null_rate,\n        \"temporal_leakage_count\": product[\"temporal_leakage_count\"]\n        + oracle[\"temporal_leakage_count\"],\n        \"maximum_cluster_occupancy\": max(\n            product[\"maximum_cluster_occupancy\"], oracle[\"maximum_cluster_occupancy\"]\n        ),\n    }\n    conditions_met = bool(\n        threshold_values[\"answerable_product_recall_at_5\"]\n        >= THRESHOLDS[\"answerable_product_recall_at_5_min\"]\n        and threshold_values[\"null_query_false_positive_rate\"]\n        <= THRESHOLDS[\"null_query_false_positive_rate_max\"]\n        and threshold_values[\"temporal_leakage_count\"] <= THRESHOLDS[\"temporal_leakage_max\"]\n        and threshold_values[\"maximum_cluster_occupancy\"]\n        <= THRESHOLDS[\"selected_packet_cluster_occupancy_max\"]\n    )\n    passed = bool(conditions_met and authoritative_thresholds_enabled)\n    return {\n        \"k\": k,\n        \"product\": product,\n        \"oracle\": oracle,\n        \"threshold_values\": threshold_values,\n        \"threshold_conditions_met\": conditions_met,\n        \"thresholds_passed\": passed,\n    }\n\n\ndef metric_contract() -> dict[str, Any]:\n    return {\n        \"schema\": METRIC_SCHEMA,\n        \"positive_grades\": list(POSITIVE_GRADES),\n        \"grade_weights\": dict(GRADE_WEIGHTS),\n        \"unjudged_policy\": \"zero_gain_and_nonrelevant_development_lower_bound\",\n        \"recall_denominator\": \"all_explicit_positive_judgments_per_answerable_query\",\n        \"precision_denominator\": \"fixed_k_with_missing_slots_nonrelevant\",\n        \"mrr_cutoff\": MRR_CUTOFF,\n        \"ndcg_cutoff\": NDCG_CUTOFF,\n        \"ndcg_gain\": \"two_to_grade_weight_minus_one\",\n        \"null_false_positive_numerator\": \"product_null_queries_with_any_result_in_top_k\",\n        \"null_false_positive_denominator\": \"product_null_query_count\",\n        \"temporal_leakage\": \"any_ranked_fact_not_derived_active_and_eligible_fails_closed\",\n        \"ranking_result_metadata_policy_scope\": (\n            \"fact_hash_kind_cluster_eligibility_and_query_telemetry_fields\"\n        ),\n        \"token_estimation_policy_scope\": \"positive_estimated_tokens_per_delivered_fact\",\n        \"serialization_policy_scope\": \"canonical_text_free_ranked_run_and_report_json\",\n        \"strata\": [\"user_prompt_derived\", \"oracle_upper_bound\"],\n    }\n\n\ndef selection_contract() -> dict[str, Any]:\n    return {\n        \"schema\": SELECTION_SCHEMA,\n        \"k_candidates\": list(K_CANDIDATES),\n        \"aggregation_candidates\": list(AGGREGATION_CANDIDATES),\n        \"thresholds\": copy.deepcopy(THRESHOLDS),\n        \"tie_break_order\": list(TIE_BREAK_ORDER),\n        \"decision_authority_requirement\": (\n            \"authoritative_status_required_for_threshold_pass_and_selection\"\n        ),\n        \"diagnostic_candidate_scope\": (\n            \"within_each_declared_engine_no_cross_engine_winner\"\n        ),\n        \"selection_scope\": \"authoritative_selection_disabled_in_v1\",\n    }\n\n\ndef decision_authority() -> dict[str, Any]:\n    \"\"\"Return the immutable fail-closed authority state for evaluator v1.\"\"\"\n    return {\n        \"status\": DECISION_AUTHORITY_STATUS,\n        \"authoritative_thresholds_enabled\": False,\n        \"producer_runner_bytes_verified\": False,\n        \"producer_code_bytes_verified\": False,\n        \"ranking_result_metadata_policy_bytes_verified\": False,\n        \"token_estimation_policy_bytes_verified\": False,\n        \"serialization_policy_bytes_verified\": False,\n        \"fact_metadata_catalog_verified\": False,\n        \"engine_evidence_verified\": False,\n        \"source_contract_verified\": False,\n        \"blocking_reasons\": list(DECISION_AUTHORITY_BLOCKERS),\n    }\n\n\ndef _selection_key(candidate: dict[str, Any]) -> tuple[Any, ...]:\n    product = candidate[\"metrics\"][\"product\"]\n    values = candidate[\"metrics\"][\"threshold_values\"]\n    return (\n        -int(candidate[\"metrics\"][\"threshold_conditions_met\"]),\n        -float(values[\"answerable_product_recall_at_5\"]),\n        float(values[\"null_query_false_positive_rate\"]),\n        int(values[\"temporal_leakage_count\"]),\n        int(values[\"maximum_cluster_occupancy\"]),\n        -float(product[\"mean_mrr\"]),\n        -float(product[\"mean_ndcg_at_10\"]),\n        -float(product[\"mean_precision_at_k\"]),\n        int(product[\"packet_tokens_total\"]),\n        int(candidate[\"k\"]),\n        AGGREGATION_CANDIDATES.index(candidate[\"aggregation_rule\"]),\n        candidate[\"run_id\"],\n    )\n\n\ndef evaluate(\n    *,\n    engine_matrix_raw: bytes,\n    engine_pins_raw: bytes,\n    producer_identity_raw: bytes,\n    fixture: dict[str, Any],\n    dataset_raw: bytes,\n    source_membership_raw: bytes,\n    ranked_run_raws: list[bytes],\n) -> dict[str, Any]:\n    \"\"\"Validate inputs, derive metrics, and return a self-hashed text-free report.\"\"\"\n    authority = decision_authority()\n    engine_matrix = _object(decode_json(engine_matrix_raw, \"engine matrix\"), \"engine matrix\")\n    engine_pins = _object(decode_json(engine_pins_raw, \"engine pins\"), \"engine pins\")\n    producer_identity = _validate_producer_identity(\n        decode_json(producer_identity_raw, \"producer identity\")\n    )\n    dataset = _object(decode_json(dataset_raw, \"dataset\"), \"dataset\")\n    source_membership_value = _object(\n        decode_json(source_membership_raw, \"source membership\"), \"source membership\"\n    )\n    fixture_index, fixture_order = _validate_fixture(fixture)\n    dataset_contract = _validate_dataset(dataset, fixture_index, fixture_order)\n    membership = _validate_membership(source_membership_value)\n    _validate_judgment_eligibility(dataset_contract, fixture_index, membership)\n    input_bindings = _build_input_bindings(\n        engine_matrix_raw,\n        engine_matrix,\n        engine_pins_raw,\n        engine_pins,\n        producer_identity_raw,\n        producer_identity,\n        fixture,\n        dataset_raw,\n        dataset,\n        source_membership_raw,\n        source_membership_value,\n    )\n    arm_order, _ = _engine_arms(engine_matrix)\n    decoded_runs: list[tuple[bytes, dict[str, Any]]] = []\n    run_ids: set[str] = set()\n    run_keys: set[tuple[str, str]] = set()\n    arm_identities: dict[str, dict[str, Any]] = {}\n    for index, raw in enumerate(ranked_run_raws):\n        decoded = decode_json(raw, f\"ranked run[{index}]\")\n        run = _validate_run(\n            decoded,\n            expected_bindings=input_bindings,\n            expected_producer_identity=producer_identity,\n            engine_matrix=engine_matrix,\n            engine_pins=engine_pins,\n            fixture_index=fixture_index,\n            fixture_order=fixture_order,\n            dataset_index=dataset_contract[\"items\"],\n            membership=membership,\n        )\n        if run[\"run_id\"] in run_ids:\n            raise EvaluationError(\"ranked run IDs are duplicated\")\n        run_ids.add(run[\"run_id\"])\n        key = (run[\"engine_identity\"][\"arm_id\"], run[\"aggregation_rule\"])\n        if key in run_keys:\n            raise EvaluationError(\"engine/aggregation ranked run is duplicated\")\n        run_keys.add(key)\n        prior_identity = arm_identities.setdefault(\n            run[\"engine_identity\"][\"arm_id\"], run[\"engine_identity\"]\n        )\n        if run[\"engine_identity\"] != prior_identity:\n            raise EvaluationError(\"engine identity differs across aggregation runs\")\n        decoded_runs.append((raw, run))\n    expected_keys = {\n        (arm_id, aggregation)\n        for arm_id in arm_order\n        for aggregation in AGGREGATION_CANDIDATES\n    }\n    if run_keys != expected_keys:\n        raise EvaluationError(\"ranked runs do not cover the full engine/aggregation matrix\")\n    arm_position = {arm_id: index for index, arm_id in enumerate(arm_order)}\n    decoded_runs.sort(\n        key=lambda pair: (\n            arm_position[pair[1][\"engine_identity\"][\"arm_id\"]],\n            AGGREGATION_CANDIDATES.index(pair[1][\"aggregation_rule\"]),\n            pair[1][\"run_id\"],\n        )\n    )\n    evaluated: list[dict[str, Any]] = []\n    selectable: dict[str, list[dict[str, Any]]] = {arm_id: [] for arm_id in arm_order}\n    for raw, run in decoded_runs:\n        candidates = [\n            _candidate_metrics(\n                run,\n                dataset_contract[\"items\"],\n                k,\n                authoritative_thresholds_enabled=authority[\n                    \"authoritative_thresholds_enabled\"\n                ],\n            )\n            for k in K_CANDIDATES\n        ]\n        evaluated.append(\n            {\n                \"run_id\": run[\"run_id\"],\n                \"run_sha256\": run[\"run_sha256\"],\n                \"run_file_sha256\": sha256_bytes(raw),\n                \"producer_identity_sha256\": run[\"producer_identity\"][\n                    \"producer_identity_sha256\"\n                ],\n                \"engine_identity\": copy.deepcopy(run[\"engine_identity\"]),\n                \"aggregation_rule\": run[\"aggregation_rule\"],\n                \"candidates\": candidates,\n            }\n        )\n        for metrics in candidates:\n            selectable[run[\"engine_identity\"][\"arm_id\"]].append(\n                {\n                    \"run_id\": run[\"run_id\"],\n                    \"run_sha256\": run[\"run_sha256\"],\n                    \"aggregation_rule\": run[\"aggregation_rule\"],\n                    \"k\": metrics[\"k\"],\n                    \"metrics\": metrics,\n                }\n            )\n    diagnostic_best_candidates: list[dict[str, Any]] = []\n    selections: list[dict[str, Any]] = []\n    for arm_id in arm_order:\n        ordered = sorted(selectable[arm_id], key=_selection_key)\n        diagnostic = ordered[0]\n        diagnostic_projection = {\n            \"arm_id\": arm_id,\n            \"run_id\": diagnostic[\"run_id\"],\n            \"run_sha256\": diagnostic[\"run_sha256\"],\n            \"aggregation_rule\": diagnostic[\"aggregation_rule\"],\n            \"k\": diagnostic[\"k\"],\n            \"threshold_conditions_met\": diagnostic[\"metrics\"][\n                \"threshold_conditions_met\"\n            ],\n        }\n        diagnostic_best_candidates.append(\n            {\n                \"status\": \"diagnostic_best_candidate\",\n                **diagnostic_projection,\n                \"diagnostic_selection_sha256\": sha256_bytes(\n                    canonical_json(diagnostic_projection)\n                ),\n            }\n        )\n        selections.append(\n            {\n                \"arm_id\": arm_id,\n                \"status\": \"non_authoritative\",\n                \"run_id\": None,\n                \"run_sha256\": None,\n                \"aggregation_rule\": None,\n                \"k\": None,\n                \"selection_sha256\": None,\n            }\n        )\n    generated_at = max(\n        (run[\"created_at\"] for _, run in decoded_runs),\n        key=lambda value: (_timestamp(value, \"ranked run created_at\")[1], value),\n    )\n    report = {\n        \"schema_version\": SCHEMA_VERSION,\n        \"schema\": REPORT_SCHEMA,\n        \"report_id\": \"entire-brain-offline-relevance-development-diagnostic-v1\",\n        \"generated_at\": generated_at,\n        \"input_bindings\": input_bindings,\n        \"producer_identity\": producer_identity,\n        \"decision_authority\": authority,\n        \"metric_contract\": metric_contract(),\n        \"selection_contract\": selection_contract(),\n        \"evaluated_runs\": evaluated,\n        \"diagnostic_best_candidates\": diagnostic_best_candidates,\n        \"selections\": selections,\n        \"report_sha256\": \"\",\n    }\n    return finalize_report(report)\n\n\ndef _load_public(path: pathlib.Path, label: str) -> bytes:\n    try:\n        return path.read_bytes()\n    except OSError as exc:\n        raise EvaluationError(f\"cannot read {label}: {exc}\") from exc\n\n\ndef main(argv: list[str] | None = None) -> int:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--repo-root\", type=pathlib.Path, default=pathlib.Path.cwd())\n    parser.add_argument(\"--producer-identity\", type=pathlib.Path, required=True)\n    parser.add_argument(\"--ranked-run\", action=\"append\", type=pathlib.Path, required=True)\n    parser.add_argument(\"--output\", type=pathlib.Path)\n    args = parser.parse_args(argv)\n    repo = args.repo_root.resolve()\n    confirmatory = repo / \"benchmarks\" / \"agent-brain\" / \"confirmatory\"\n    sys.path.insert(0, str(confirmatory))\n    try:\n        import development_relevance_queries as query_fixture  # type: ignore\n    except ImportError as exc:\n        print(f\"ERROR: cannot import verified query fixture loader: {exc}\", file=sys.stderr)\n        return 1\n\n    try:\n        fixture = query_fixture.load_verified_fixture(repo)\n        report = evaluate(\n            engine_matrix_raw=_load_public(confirmatory / \"engine-matrix.json\", \"engine matrix\"),\n            engine_pins_raw=_load_public(\n                confirmatory / \"engine-verification-pins.json\", \"engine pins\"\n            ),\n            producer_identity_raw=_load_public(\n                args.producer_identity, \"producer identity\"\n            ),\n            fixture=fixture,\n            dataset_raw=_load_public(\n                confirmatory / \"offline-relevance-dataset.json\", \"dataset\"\n            ),\n            source_membership_raw=_load_public(\n                confirmatory / \"offline-relevance-source-membership.json\",\n                \"source membership\",\n            ),\n            ranked_run_raws=[_load_public(path, \"ranked run\") for path in args.ranked_run],\n        )\n    except (EvaluationError, query_fixture.FixtureError) as exc:\n        print(f\"ERROR: {exc}\", file=sys.stderr)\n        return 1\n    output = canonical_json(report) + b\"\\n\"\n    if args.output is None:\n        sys.stdout.buffer.write(output)\n    else:\n        args.output.write_bytes(output)\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"},"started_at_ms":1789839523589,"completed_at_ms":1789839523590}}
{"timestamp":"2026-09-19T17:38:43.642Z","ordinal":7468,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0babf-bf3a-77b0-bada-d94ce31475bb","call_id":"call_kzA9aEsLVmmwP2MWHrf4Jn78","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"722dca\",\"wall_time_seconds\":0.000002959,\"exit_code\":0,\"original_token_count\":4962,\"output\":\"\\ndef _mrr(results: list[dict[str, Any]], positives: set[str]) -> float:\\n    for rank, result in enumerate(results[:MRR_CUTOFF], 1):\\n        if result[\\\"fact_id\\\"] in positives:\\n            return round(1.0 / rank, 12)\\n    return 0.0\\n\\n\\ndef _ndcg(results: list[dict[str, Any]], judgments: dict[str, dict[str, Any]]) -> float:\\n    def gain(weight: int) -> float:\\n        return float((2**weight) - 1)\\n\\n    dcg = 0.0\\n    for rank, result in enumerate(results[:NDCG_CUTOFF], 1):\\n        judgment = judgments.get(result[\\\"fact_id\\\"])\\n        weight = GRADE_WEIGHTS[judgment[\\\"grade\\\"]] if judgment is not None else 0\\n        dcg += gain(weight) / math.log2(rank + 1)\\n    ideal_weights = sorted(\\n        (GRADE_WEIGHTS[judgment[\\\"grade\\\"]] for judgment in judgments.values()), reverse=True\\n    )[:NDCG_CUTOFF]\\n    idcg = sum(gain(weight) / math.log2(rank + 1) for rank, weight in enumerate(ideal_weights, 1))\\n    return round(dcg / idcg, 12) if idcg else 0.0\\n\\n\\ndef _query_metrics(\\n    query: dict[str, Any], dataset_item: dict[str, Any], k: int\\n) -> dict[str, Any]:\\n    results = query[\\\"ordered_results\\\"]\\n    top = results[:k]\\n    positives = dataset_item[\\\"positive_ids\\\"]\\n    judgments = dataset_item[\\\"judgments\\\"]\\n    grades = Counter(\\n        judgments[result[\\\"fact_id\\\"]][\\\"grade\\\"]\\n        if result[\\\"fact_id\\\"] in judgments\\n        else \\\"unjudged\\\"\\n        for result in top\\n    )\\n    kinds = Counter(result[\\\"kind\\\"] for result in top)\\n    clusters = Counter(result[\\\"cluster_id\\\"] for result in top)\\n    positive_hits = sum(result[\\\"fact_id\\\"] in positives for result in top)\\n    return {\\n        \\\"query_source\\\": query[\\\"query_source\\\"],\\n        \\\"null_query\\\": query[\\\"null_query\\\"],\\n        \\\"recall_at_1\\\": _recall(results, positives, 1),\\n        \\\"recall_at_5\\\": _recall(results, positives, 5),\\n        \\\"recall_at_10\\\": _recall(results, positives, 10),\\n        \\\"mrr\\\": _mrr(results, positives),\\n        \\\"ndcg_at_10\\\": _ndcg(results, judgments),\\n        \\\"precision_at_k\\\": _ratio(positive_hits, k),\\n        \\\"positive_hits\\\": positive_hits,\\n        \\\"hard_topical_distractor_hits\\\": grades[\\\"hard_topical_distractor\\\"],\\n        \\\"irrelevant_hits\\\": grades[\\\"irrelevant\\\"],\\n        \\\"unjudged_hits\\\": grades[\\\"unjudged\\\"],\\n        \\\"result_count\\\": len(top),\\n        \\\"kind_counts\\\": dict(sorted(kinds.items())),\\n        \\\"maximum_cluster_occupancy\\\": max(clusters.values(), default=0),\\n        \\\"duplicate_cluster_count\\\": sum(value > 1 for value in clusters.values()),\\n        \\\"temporal_leakage_count\\\": sum(result[\\\"eligible\\\"] is not True for result in top),\\n        \\\"packet_tokens\\\": sum(result[\\\"estimated_tokens\\\"] for result in top),\\n        \\\"ranking_latency_ms\\\": query[\\\"telemetry\\\"][\\\"ranking_latency_ms\\\"],\\n    }\\n\\n\\ndef _aggregate_metrics(metrics: list[dict[str, Any]], *, product: bool, k: int) -> dict[str, Any]:\\n    answerable = [metric for metric in metrics if not metric[\\\"null_query\\\"]]\\n    nulls = [metric for metric in metrics if metric[\\\"null_query\\\"]]\\n    kinds: Counter[str] = Counter()\\n    for metric in metrics:\\n        kinds.update(metric[\\\"kind_counts\\\"])\\n    false_positive_nulls = sum(metric[\\\"result_count\\\"] > 0 for metric in nulls)\\n    null_rate: float | None = (\\n        _ratio(false_positive_nulls, len(nulls)) if nulls else None\\n    )\\n    result = {\\n        \\\"query_count\\\": len(metrics),\\n        \\\"answerable_query_count\\\": len(answerable),\\n        \\\"null_query_count\\\": len(nulls),\\n        \\\"mean_recall_at_1\\\": _mean(metric[\\\"recall_at_1\\\"] for metric in answerable),\\n        \\\"mean_recall_at_5\\\": _mean(metric[\\\"recall_at_5\\\"] for metric in answerable),\\n        \\\"mean_recall_at_10\\\": _mean(metric[\\\"recall_at_10\\\"] for metric in answerable),\\n        \\\"mean_mrr\\\": _mean(metric[\\\"mrr\\\"] for metric in answerable),\\n        \\\"mean_ndcg_at_10\\\": _mean(metric[\\\"ndcg_at_10\\\"] for metric in answerable),\\n        \\\"mean_precision_at_k\\\": _mean(metric[\\\"precision_at_k\\\"] for metric in metrics),\\n        \\\"positive_hits\\\": sum(metric[\\\"positive_hits\\\"] for metric in metrics),\\n        \\\"hard_topical_distractor_hits\\\": sum(\\n            metric[\\\"hard_topical_distractor_hits\\\"] for metric in metrics\\n        ),\\n        \\\"irrelevant_hits\\\": sum(metric[\\\"irrelevant_hits\\\"] for metric in metrics),\\n        \\\"unjudged_hits\\\": sum(metric[\\\"unjudged_hits\\\"] for metric in metrics),\\n        \\\"result_count\\\": sum(metric[\\\"result_count\\\"] for metric in metrics),\\n        \\\"kind_distribution\\\": dict(sorted(kinds.items())),\\n        \\\"maximum_cluster_occupancy\\\": max(\\n            (metric[\\\"maximum_cluster_occupancy\\\"] for metric in metrics), default=0\\n        ),\\n        \\\"duplicate_cluster_query_count\\\": sum(\\n            metric[\\\"duplicate_cluster_count\\\"] > 0 for metric in metrics\\n        ),\\n        \\\"temporal_leakage_count\\\": sum(\\n            metric[\\\"temporal_leakage_count\\\"] for metric in metrics\\n        ),\\n        \\\"null_false_positive_numerator\\\": false_positive_nulls,\\n        \\\"null_false_positive_denominator\\\": len(nulls),\\n        \\\"null_query_false_positive_rate\\\": null_rate,\\n        \\\"packet_tokens_total\\\": sum(metric[\\\"packet_tokens\\\"] for metric in metrics),\\n        \\\"ranking_latency_ms_total\\\": round(\\n            sum(metric[\\\"ranking_latency_ms\\\"] for metric in metrics), 12\\n        ),\\n        \\\"k\\\": k,\\n    }\\n    if product and (not answerable or not nulls):\\n        raise EvaluationError(\\\"product metrics require answerable and null query strata\\\")\\n    if not product and not answerable:\\n        raise EvaluationError(\\\"oracle metrics require an answerable query\\\")\\n    return result\\n\\n\\ndef _candidate_metrics(\\n    run: dict[str, Any],\\n    dataset_index: dict[str, Any],\\n    k: int,\\n    *,\\n    authoritative_thresholds_enabled: bool,\\n) -> dict[str, Any]:\\n    product_metrics: list[dict[str, Any]] = []\\n    oracle_metrics: list[dict[str, Any]] = []\\n    for query in run[\\\"queries\\\"]:\\n        metric = _query_metrics(query, dataset_index[query[\\\"query_id\\\"]], k)\\n        if query[\\\"query_source\\\"] == \\\"user_prompt_derived\\\":\\n            product_metrics.append(metric)\\n        else:\\n            oracle_metrics.append(metric)\\n    product = _aggregate_metrics(product_metrics, product=True, k=k)\\n    oracle = _aggregate_metrics(oracle_metrics, product=False, k=k)\\n    null_rate = product[\\\"null_query_false_positive_rate\\\"]\\n    assert isinstance(null_rate, float)\\n    threshold_values = {\\n        \\\"answerable_product_recall_at_5\\\": product[\\\"mean_recall_at_5\\\"],\\n        \\\"null_query_false_positive_rate\\\": null_rate,\\n        \\\"temporal_leakage_count\\\": product[\\\"temporal_leakage_count\\\"]\\n        + oracle[\\\"temporal_leakage_count\\\"],\\n        \\\"maximum_cluster_occupancy\\\": max(\\n            product[\\\"maximum_cluster_occupancy\\\"], oracle[\\\"maximum_cluster_occupancy\\\"]\\n        ),\\n    }\\n    conditions_met = bool(\\n        threshold_values[\\\"answerable_product_recall_at_5\\\"]\\n        >= THRESHOLDS[\\\"answerable_product_recall_at_5_min\\\"]\\n        and threshold_values[\\\"null_query_false_positive_rate\\\"]\\n        <= THRESHOLDS[\\\"null_query_false_positive_rate_max\\\"]\\n        and threshold_values[\\\"temporal_leakage_count\\\"] <= THRESHOLDS[\\\"temporal_leakage_max\\\"]\\n        and threshold_values[\\\"maximum_cluster_occupancy\\\"]\\n        <= THRESHOLDS[\\\"selected_packet_cluster_occupancy_max\\\"]\\n    )\\n    passed = bool(conditions_met and authoritative_thresholds_enabled)\\n    return {\\n        \\\"k\\\": k,\\n        \\\"product\\\": product,\\n        \\\"oracle\\\": oracle,\\n        \\\"threshold_values\\\": threshold_values,\\n        \\\"threshold_conditions_met\\\": conditions_met,\\n        \\\"thresholds_passed\\\": passed,\\n    }\\n\\n\\ndef metric_contract() -> dict[str, Any]:\\n    return {\\n        \\\"schema\\\": METRIC_SCHEMA,\\n        \\\"positive_grades\\\": list(POSITIVE_GRADES),\\n        \\\"grade_weights\\\": dict(GRADE_WEIGHTS),\\n        \\\"unjudged_policy\\\": \\\"zero_gain_and_nonrelevant_development_lower_bound\\\",\\n        \\\"recall_denominator\\\": \\\"all_explicit_positive_judgments_per_answerable_query\\\",\\n        \\\"precision_denominator\\\": \\\"fixed_k_with_missing_slots_nonrelevant\\\",\\n        \\\"mrr_cutoff\\\": MRR_CUTOFF,\\n        \\\"ndcg_cutoff\\\": NDCG_CUTOFF,\\n        \\\"ndcg_gain\\\": \\\"two_to_grade_weight_minus_one\\\",\\n        \\\"null_false_positive_numerator\\\": \\\"product_null_queries_with_any_result_in_top_k\\\",\\n        \\\"null_false_positive_denominator\\\": \\\"product_null_query_count\\\",\\n        \\\"temporal_leakage\\\": \\\"any_ranked_fact_not_derived_active_and_eligible_fails_closed\\\",\\n        \\\"ranking_result_metadata_policy_scope\\\": (\\n            \\\"fact_hash_kind_cluster_eligibility_and_query_telemetry_fields\\\"\\n        ),\\n        \\\"token_estimation_policy_scope\\\": \\\"positive_estimated_tokens_per_delivered_fact\\\",\\n        \\\"serialization_policy_scope\\\": \\\"canonical_text_free_ranked_run_and_report_json\\\",\\n        \\\"strata\\\": [\\\"user_prompt_derived\\\", \\\"oracle_upper_bound\\\"],\\n    }\\n\\n\\ndef selection_contract() -> dict[str, Any]:\\n    return {\\n        \\\"schema\\\": SELECTION_SCHEMA,\\n        \\\"k_candidates\\\": list(K_CANDIDATES),\\n        \\\"aggregation_candidates\\\": list(AGGREGATION_CANDIDATES),\\n        \\\"thresholds\\\": copy.deepcopy(THRESHOLDS),\\n        \\\"tie_break_order\\\": list(TIE_BREAK_ORDER),\\n        \\\"decision_authority_requirement\\\": (\\n            \\\"authoritative_status_required_for_threshold_pass_and_selection\\\"\\n        ),\\n        \\\"diagnostic_candidate_scope\\\": (\\n            \\\"within_each_declared_engine_no_cross_engine_winner\\\"\\n        ),\\n        \\\"selection_scope\\\": \\\"authoritative_selection_disabled_in_v1\\\",\\n    }\\n\\n\\ndef decision_authority() -> dict[str, Any]:\\n    \\\"\\\"\\\"Return the immutable fail-closed authority state for evaluator v1.\\\"\\\"\\\"\\n    return {\\n        \\\"status\\\": DECISION_AUTHORITY_STATUS,\\n        \\\"authoritative_thresholds_enabled\\\": False,\\n        \\\"producer_runner_bytes_verified\\\": False,\\n        \\\"producer_code_bytes_verified\\\": False,\\n        \\\"ranking_result_metadata_policy_bytes_verified\\\": False,\\n        \\\"token_estimation_policy_bytes_verified\\\": False,\\n        \\\"serialization_policy_bytes_verified\\\": False,\\n        \\\"fact_metadata_catalog_verified\\\": False,\\n        \\\"engine_evidence_verified\\\": False,\\n        \\\"source_contract_verified\\\": False,\\n        \\\"blocking_reasons\\\": list(DECISION_AUTHORITY_BLOCKERS),\\n    }\\n\\n\\ndef _selection_key(candidate: dict[str, Any]) -> tuple[Any, ...]:\\n    product = candidate[\\\"metrics\\\"][\\\"product\\\"]\\n    values = candidate[\\\"metrics\\\"][\\\"threshold_values\\\"]\\n    return (\\n        -int(candidate[\\\"metrics\\\"][\\\"threshold_conditions_met\\\"]),\\n        -float(values[\\\"answerable_product_recall_at_5\\\"]),\\n        float(values[\\\"null_query_false_positive_rate\\\"]),\\n        int(values[\\\"temporal_leakage_count\\\"]),\\n        int(values[\\\"maximum_cluster_occupancy\\\"]),\\n        -float(product[\\\"mean_mrr\\\"]),\\n        -float(product[\\\"mean_ndcg_at_10\\\"]),\\n        -float(product[\\\"mean_precision_at_k\\\"]),\\n        int(product[\\\"packet_tokens_total\\\"]),\\n        int(candidate[\\\"k\\\"]),\\n        AGGREGATION_CANDIDATES.index(candidate[\\\"aggregation_rule\\\"]),\\n        candidate[\\\"run_id\\\"],\\n    )\\n\\n\\ndef evaluate(\\n    *,\\n    engine_matrix_raw: bytes,\\n    engine_pins_raw: bytes,\\n    producer_identity_raw: bytes,\\n    fixture: dict[str, Any],\\n    dataset_raw: bytes,\\n    source_membership_raw: bytes,\\n    ranked_run_raws: list[bytes],\\n) -> dict[str, Any]:\\n    \\\"\\\"\\\"Validate inputs, derive metrics, and return a self-hashed text-free report.\\\"\\\"\\\"\\n    authority = decision_authority()\\n    engine_matrix = _object(decode_json(engine_matrix_raw, \\\"engine matrix\\\"), \\\"engine matrix\\\")\\n    engine_pins = _object(decode_json(engine_pins_raw, \\\"engine pins\\\"), \\\"engine pins\\\")\\n    producer_identity = _validate_producer_identity(\\n        decode_json(producer_identity_raw, \\\"producer identity\\\")\\n    )\\n    dataset = _object(decode_json(dataset_raw, \\\"dataset\\\"), \\\"dataset\\\")\\n    source_membership_value = _object(\\n        decode_json(source_membership_raw, \\\"source membership\\\"), \\\"source membership\\\"\\n    )\\n    fixture_index, fixture_order = _validate_fixture(fixture)\\n    dataset_contract = _validate_dataset(dataset, fixture_index, fixture_order)\\n    membership = _validate_membership(source_membership_value)\\n    _validate_judgment_eligibility(dataset_contract, fixture_index, membership)\\n    input_bindings = _build_input_bindings(\\n        engine_matrix_raw,\\n        engine_matrix,\\n        engine_pins_raw,\\n        engine_pins,\\n        producer_identity_raw,\\n        producer_identity,\\n        fixture,\\n        dataset_raw,\\n        dataset,\\n        source_membership_raw,\\n        source_membership_value,\\n    )\\n    arm_order, _ = _engine_arms(engine_matrix)\\n    decoded_runs: list[tuple[bytes, dict[str, Any]]] = []\\n    run_ids: set[str] = set()\\n    run_keys: set[tuple[str, str]] = set()\\n    arm_identities: dict[str, dict[str, Any]] = {}\\n    for index, raw in enumerate(ranked_run_raws):\\n        decoded = decode_json(raw, f\\\"ranked run[{index}]\\\")\\n        run = _validate_run(\\n            decoded,\\n            expected_bindings=input_bindings,\\n            expected_producer_identity=producer_identity,\\n            engine_matrix=engine_matrix,\\n            engine_pins=engine_pins,\\n            fixture_index=fixture_index,\\n            fixture_order=fixture_order,\\n            dataset_index=dataset_contract[\\\"items\\\"],\\n            membership=membership,\\n        )\\n        if run[\\\"run_id\\\"] in run_ids:\\n            raise EvaluationError(\\\"ranked run IDs are duplicated\\\")\\n        run_ids.add(run[\\\"run_id\\\"])\\n        key = (run[\\\"engine_identity\\\"][\\\"arm_id\\\"], run[\\\"aggregation_rule\\\"])\\n        if key in run_keys:\\n            raise EvaluationError(\\\"engine/aggregation ranked run is duplicated\\\")\\n        run_keys.add(key)\\n        prior_identity = arm_identities.setdefault(\\n            run[\\\"engine_identity\\\"][\\\"arm_id\\\"], run[\\\"engine_identity\\\"]\\n        )\\n        if run[\\\"engine_identity\\\"] != prior_identity:\\n            raise EvaluationError(\\\"engine identity differs across aggregation runs\\\")\\n        decoded_runs.append((raw, run))\\n    expected_keys = {\\n        (arm_id, aggregation)\\n        for arm_id in arm_order\\n        for aggregation in AGGREGATION_CANDIDATES\\n    }\\n    if run_keys != expected_keys:\\n        raise EvaluationError(\\\"ranked runs do not cover the full engine/aggregation matrix\\\")\\n    arm_position = {arm_id: index for index, arm_id in enumerate(arm_order)}\\n    decoded_runs.sort(\\n        key=lambda pair: (\\n            arm_position[pair[1][\\\"engine_identity\\\"][\\\"arm_id\\\"]],\\n            AGGREGATION_CANDIDATES.index(pair[1][\\\"aggregation_rule\\\"]),\\n            pair[1][\\\"run_id\\\"],\\n        )\\n    )\\n    evaluated: list[dict[str, Any]] = []\\n    selectable: dict[str, list[dict[str, Any]]] = {arm_id: [] for arm_id in arm_order}\\n    for raw, run in decoded_runs:\\n        candidates = [\\n            _candidate_metrics(\\n                run,\\n                dataset_contract[\\\"items\\\"],\\n                k,\\n                authoritative_thresholds_enabled=authority[\\n                    \\\"authoritative_thresholds_enabled\\\"\\n                ],\\n            )\\n            for k in K_CANDIDATES\\n        ]\\n        evaluated.append(\\n            {\\n                \\\"run_id\\\": run[\\\"run_id\\\"],\\n                \\\"run_sha256\\\": run[\\\"run_sha256\\\"],\\n                \\\"run_file_sha256\\\": sha256_bytes(raw),\\n                \\\"producer_identity_sha256\\\": run[\\\"producer_identity\\\"][\\n                    \\\"producer_identity_sha256\\\"\\n                ],\\n                \\\"engine_identity\\\": copy.deepcopy(run[\\\"engine_identity\\\"]),\\n                \\\"aggregation_rule\\\": run[\\\"aggregation_rule\\\"],\\n                \\\"candidates\\\": candidates,\\n            }\\n        )\\n        for metrics in candidates:\\n            selectable[run[\\\"engine_identity\\\"][\\\"arm_id\\\"]].append(\\n                {\\n                    \\\"run_id\\\": run[\\\"run_id\\\"],\\n                    \\\"run_sha256\\\": run[\\\"run_sha256\\\"],\\n                    \\\"aggregation_rule\\\": run[\\\"aggregation_rule\\\"],\\n                    \\\"k\\\": metrics[\\\"k\\\"],\\n                    \\\"metrics\\\": metrics,\\n                }\\n            )\\n    diagnostic_best_candidates: list[dict[str, Any]] = []\\n    selections: list[dict[str, Any]] = []\\n    for arm_id in arm_order:\\n        ordered = sorted(selectable[arm_id], key=_selection_key)\\n        diagnostic = ordered[0]\\n        diagnostic_projection = {\\n            \\\"arm_id\\\": arm_id,\\n            \\\"run_id\\\": diagnostic[\\\"run_id\\\"],\\n            \\\"run_sha256\\\": diagnostic[\\\"run_sha256\\\"],\\n            \\\"aggregation_rule\\\": diagnostic[\\\"aggregation_rule\\\"],\\n            \\\"k\\\": diagnostic[\\\"k\\\"],\\n            \\\"threshold_conditions_met\\\": diagnostic[\\\"metrics\\\"][\\n                \\\"threshold_conditions_met\\\"\\n            ],\\n        }\\n        diagnostic_best_candidates.append(\\n            {\\n                \\\"status\\\": \\\"diagnostic_best_candidate\\\",\\n                **diagnostic_projection,\\n                \\\"diagnostic_selection_sha256\\\": sha256_bytes(\\n                    canonical_json(diagnostic_projection)\\n                ),\\n            }\\n        )\\n        selections.append(\\n            {\\n                \\\"arm_id\\\": arm_id,\\n                \\\"status\\\": \\\"non_authoritative\\\",\\n                \\\"run_id\\\": None,\\n                \\\"run_sha256\\\": None,\\n                \\\"aggregation_rule\\\": None,\\n                \\\"k\\\": None,\\n                \\\"selection_sha256\\\": None,\\n            }\\n        )\\n    generated_at = max(\\n        (run[\\\"created_at\\\"] for _, run in decoded_runs),\\n        key=lambda value: (_timestamp(value, \\\"ranked run created_at\\\")[1], value),\\n    )\\n    report = {\\n        \\\"schema_version\\\": SCHEMA_VERSION,\\n        \\\"schema\\\": REPORT_SCHEMA,\\n        \\\"report_id\\\": \\\"entire-brain-offline-relevance-development-diagnostic-v1\\\",\\n        \\\"generated_at\\\": generated_at,\\n        \\\"input_bindings\\\": input_bindings,\\n        \\\"producer_identity\\\": producer_identity,\\n        \\\"decision_authority\\\": authority,\\n        \\\"metric_contract\\\": metric_contract(),\\n        \\\"selection_contract\\\": selection_contract(),\\n        \\\"evaluated_runs\\\": evaluated,\\n        \\\"diagnostic_best_candidates\\\": diagnostic_best_candidates,\\n        \\\"selections\\\": selections,\\n        \\\"report_sha256\\\": \\\"\\\",\\n    }\\n    return finalize_report(report)\\n\\n\\ndef _load_public(path: pathlib.Path, label: str) -> bytes:\\n    try:\\n        return path.read_bytes()\\n    except OSError as exc:\\n        raise EvaluationError(f\\\"cannot read {label}: {exc}\\\") from exc\\n\\n\\ndef main(argv: list[str] | None = None) -> int:\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    parser.add_argument(\\\"--repo-root\\\", type=pathlib.Path, default=pathlib.Path.cwd())\\n    parser.add_argument(\\\"--producer-identity\\\", type=pathlib.Path, required=True)\\n    parser.add_argument(\\\"--ranked-run\\\", action=\\\"append\\\", type=pathlib.Path, required=True)\\n    parser.add_argument(\\\"--output\\\", type=pathlib.Path)\\n    args = parser.parse_args(argv)\\n    repo = args.repo_root.resolve()\\n    confirmatory = repo / \\\"benchmarks\\\" / \\\"agent-brain\\\" / \\\"confirmatory\\\"\\n    sys.path.insert(0, str(confirmatory))\\n    try:\\n        import development_relevance_queries as query_fixture  # type: ignore\\n    except ImportError as exc:\\n        print(f\\\"ERROR: cannot import verified query fixture loader: {exc}\\\", file=sys.stderr)\\n        return 1\\n\\n    try:\\n        fixture = query_fixture.load_verified_fixture(repo)\\n        report = evaluate(\\n            engine_matrix_raw=_load_public(confirmatory / \\\"engine-matrix.json\\\", \\\"engine matrix\\\"),\\n            engine_pins_raw=_load_public(\\n                confirmatory / \\\"engine-verification-pins.json\\\", \\\"engine pins\\\"\\n            ),\\n            producer_identity_raw=_load_public(\\n                args.producer_identity, \\\"producer identity\\\"\\n            ),\\n            fixture=fixture,\\n            dataset_raw=_load_public(\\n                confirmatory / \\\"offline-relevance-dataset.json\\\", \\\"dataset\\\"\\n            ),\\n            source_membership_raw=_load_public(\\n                confirmatory / \\\"offline-relevance-source-membership.json\\\",\\n                \\\"source membership\\\",\\n            ),\\n            ranked_run_raws=[_load_public(path, \\\"ranked run\\\") for path in args.ranked_run],\\n        )\\n    except (EvaluationError, query_fixture.FixtureError) as exc:\\n        print(f\\\"ERROR: {exc}\\\", file=sys.stderr)\\n        return 1\\n    output = canonical_json(report) + b\\\"\\\\n\\\"\\n    if args.output is None:\\n        sys.stdout.buffer.write(output)\\n    else:\\n        args.output.write_bytes(output)\\n    return 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    raise SystemExit(main())\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839523.64239}}}
