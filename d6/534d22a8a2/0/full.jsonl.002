{"timestamp":"2026-09-19T17:35:06.596Z","ordinal":7404,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","item":{"type":"CommandExecution","id":"exec-a877328d-b081-4634-bc72-afe0a72f186a","process_id":"71639","command":["/bin/zsh","-lc","sed -n '851,1390p' benchmarks/agent-brain/confirmatory/negative_control_cache_bundle_v2.py"],"cwd":"file:///Users/thomi/.codex/worktrees/5d33/entire-brain","parsed_cmd":[{"type":"read","cmd":"sed -n '851,1390p' benchmarks/agent-brain/confirmatory/negative_control_cache_bundle_v2.py","name":"negative_control_cache_bundle_v2.py","path":"benchmarks/agent-brain/confirmatory/negative_control_cache_bundle_v2.py"}],"source":"unified_exec_startup","status":"completed","stdout":"        )\n        for schema, path, label in (\n            (format_schema, FORMAT_SCHEMA_PATH, \"cache bundle format\"),\n            (report_schema, REPORT_SCHEMA_PATH, \"cache bundle verification report\"),\n            (verifier_schema, VERIFIER_SCHEMA_PATH, \"cache bundle verifier contract\"),\n        ):\n            v1._audit_schema(schema, schema_name=path.name, label=label)\n        format_contract, format_raw = v1._read_json(\n            FORMAT_PATH,\n            maximum=v1.MAX_FIXED_JSON_BYTES,\n            label=\"cache bundle format contract\",\n            canonical=True,\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    _require(_sha256(format_raw) == CHECKED_FORMAT_FILE_SHA256, \"format-contract raw hash differs\")\n    validated_format = _validate_format_contract(format_contract, schema=format_schema, v1=v1)\n    return {\n        \"format\": validated_format,\n        \"format_raw\": format_raw,\n        \"format_schema\": format_schema,\n        \"format_schema_raw\": format_schema_raw,\n        \"report_schema\": report_schema,\n        \"report_schema_raw\": report_schema_raw,\n        \"v1\": v1,\n        \"v1_dependencies\": v1_dependencies,\n        \"v1_verifier_contract\": v1_verifier_contract,\n        \"v1_verifier_contract_raw\": v1_verifier_contract_raw,\n        \"verifier_schema\": verifier_schema,\n        \"verifier_schema_raw\": verifier_schema_raw,\n    }\n\n\ndef _expected_implementation(dependencies: Mapping[str, Any]) -> dict[str, Any]:\n    v1 = dependencies[\"v1\"]\n    try:\n        source_raw = v1._read_bounded(\n            pathlib.Path(__file__),\n            maximum=MAX_SOURCE_BYTES,\n            label=\"cache bundle verifier source\",\n            require_single_link=True,\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    v1_dependencies = dependencies[\"v1_dependencies\"]\n    _require(type(v1_dependencies) is dict, \"v1 fixed dependencies differ\")\n    return {\n        \"builder\": _file_binding(pathlib.Path(__file__), source_raw),\n        \"draft202012_validator\": copy.deepcopy(v1_dependencies[\"draft_validator\"]),\n        \"format_artifact\": _file_binding(FORMAT_PATH, dependencies[\"format_raw\"]),\n        \"format_schema\": _file_binding(FORMAT_SCHEMA_PATH, dependencies[\"format_schema_raw\"]),\n        \"manifest_schema\": _file_binding(\n            pathlib.Path(\"offline-go-cache-seed-manifest-v1.schema.json\"),\n            v1_dependencies[\"manifest_schema_raw\"],\n        ),\n        \"report_schema\": _file_binding(REPORT_SCHEMA_PATH, dependencies[\"report_schema_raw\"]),\n        \"v1_raw_verifier_source\": _file_binding(V1_SOURCE_PATH, _read_checked_v1_source()),\n        \"verifier_contract_schema\": _file_binding(\n            VERIFIER_SCHEMA_PATH,\n            dependencies[\"verifier_schema_raw\"],\n        ),\n    }\n\n\ndef _expected_raw_identity_binding(dependencies: Mapping[str, Any]) -> dict[str, Any]:\n    v1_dependencies = dependencies[\"v1_dependencies\"]\n    material = v1_dependencies[\"material\"]\n    v1_contract = dependencies[\"v1_verifier_contract\"]\n    _require(\n        type(material) is dict and type(v1_contract) is dict,\n        \"v1 raw identity dependencies differ\",\n    )\n    return {\n        \"v1_material\": {\n            \"artifact_file\": \"negative-control-cache-archive-material-v1.json\",\n            \"artifact_sha256\": _sha256(v1_dependencies[\"material_raw\"]),\n            \"material_declaration_sha256\": material[\"material_declaration_sha256\"],\n            \"profile\": material[\"profile\"],\n            \"status\": material[\"status\"],\n        },\n        \"v1_material_schema_sha256\": \"1424cd22b5eb057b5794347403780435f95c0428d4f81ff42441e71abc39d5d5\",\n        \"v1_raw_verifier_source_sha256\": CHECKED_V1_SOURCE_SHA256,\n        \"v1_report_schema_sha256\": \"5827c78df73b024df32bf2853d412df428e7362e869d5d202b33dac15bbe4e5d\",\n        \"v1_verifier_contract\": {\n            \"artifact_file\": V1_VERIFIER_CONTRACT_PATH.name,\n            \"artifact_sha256\": _sha256(dependencies[\"v1_verifier_contract_raw\"]),\n            \"profile\": v1_contract[\"profile\"],\n            \"status\": v1_contract[\"status\"],\n            \"verifier_contract_sha256\": v1_contract[\"verifier_contract_sha256\"],\n        },\n        \"v1_verifier_contract_schema_sha256\": \"c35c0de98dbdcec6744a3fe33ee363261507eb894bbddbb3af5af3642be7f914\",\n    }\n\n\ndef _expected_status(dependencies: Mapping[str, Any]) -> str:\n    material = dependencies[\"v1_dependencies\"][\"material\"]\n    v1_contract = dependencies[\"v1_verifier_contract\"]\n    _require(\n        type(material) is dict and type(v1_contract) is dict,\n        \"v1 approval dependencies differ\",\n    )\n    material_status = material.get(\"status\")\n    contract_status = v1_contract.get(\"status\")\n    if material_status == V1_PENDING_MATERIAL_STATUS:\n        _require(\n            contract_status == V1_PENDING_VERIFIER_STATUS,\n            \"pending v1 material and verifier statuses differ\",\n        )\n        return PENDING_STATUS\n    _require(\n        material_status == V1_APPROVED_MATERIAL_STATUS\n        and contract_status == V1_APPROVED_VERIFIER_STATUS,\n        \"approved v1 material and verifier statuses differ\",\n    )\n    return APPROVED_STATUS\n\n\ndef _build_verifier_contract(dependencies: Mapping[str, Any]) -> dict[str, Any]:\n    v1 = dependencies[\"v1\"]\n    contract: dict[str, Any] = {\n        \"authority\": copy.deepcopy(AUTHORITY),\n        \"format_binding\": copy.deepcopy(FORMAT_BINDING),\n        \"implementation\": _expected_implementation(dependencies),\n        \"manifest_binding\": copy.deepcopy(MANIFEST_BINDING),\n        \"profile\": VERIFIER_PROFILE,\n        \"raw_identity_binding\": _expected_raw_identity_binding(dependencies),\n        \"residual_gates\": list(RESIDUAL_GATES),\n        \"runtime_bindings\": copy.deepcopy(RUNTIME_BINDINGS),\n        \"schema_version\": SCHEMA_VERSION,\n        \"status\": _expected_status(dependencies),\n        \"verification_policy\": copy.deepcopy(VERIFICATION_POLICY),\n        \"verifier_contract_sha256\": None,\n    }\n    contract[\"verifier_contract_sha256\"] = v1._field_self_hash(\n        contract,\n        \"verifier_contract_sha256\",\n    )\n    return validate_verifier_contract(\n        contract,\n        schema=dependencies[\"verifier_schema\"],\n        dependencies=dependencies,\n    )\n\n\ndef build_verifier_contract() -> dict[str, Any]:\n    \"\"\"Build a non-authorizing verifier contract from fixed local inputs.\"\"\"\n\n    return _build_verifier_contract(_load_fixed_dependencies())\n\n\ndef validate_verifier_contract(\n    value: Mapping[str, Any],\n    *,\n    schema: Mapping[str, Any],\n    dependencies: Mapping[str, Any],\n) -> dict[str, Any]:\n    v1 = dependencies[\"v1\"]\n    try:\n        v1._validate_schema(\n            value,\n            schema,\n            schema_name=VERIFIER_SCHEMA_PATH.name,\n            label=\"cache bundle verifier contract\",\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    expected_fields = {\n        \"authority\",\n        \"format_binding\",\n        \"implementation\",\n        \"manifest_binding\",\n        \"profile\",\n        \"raw_identity_binding\",\n        \"residual_gates\",\n        \"runtime_bindings\",\n        \"schema_version\",\n        \"status\",\n        \"verification_policy\",\n        \"verifier_contract_sha256\",\n    }\n    _require(type(value) is dict and set(value) == expected_fields, \"verifier-contract fields differ\")\n    _require(\n        value[\"profile\"] == VERIFIER_PROFILE\n        and value[\"schema_version\"] == SCHEMA_VERSION\n        and value[\"status\"] == _expected_status(dependencies),\n        \"verifier-contract identity or status differs\",\n    )\n    _require(value[\"authority\"] == AUTHORITY, \"verifier-contract authority differs\")\n    _require(value[\"format_binding\"] == FORMAT_BINDING, \"verifier-contract format binding differs\")\n    _require(value[\"manifest_binding\"] == MANIFEST_BINDING, \"verifier-contract manifest binding differs\")\n    _require(\n        value[\"raw_identity_binding\"] == _expected_raw_identity_binding(dependencies),\n        \"verifier-contract raw identity binding differs\",\n    )\n    _require(\n        value[\"implementation\"] == _expected_implementation(dependencies),\n        \"verifier-contract implementation binding differs\",\n    )\n    _require(value[\"residual_gates\"] == RESIDUAL_GATES, \"verifier-contract residual gates differ\")\n    _require(value[\"runtime_bindings\"] == RUNTIME_BINDINGS, \"verifier-contract runtime bindings differ\")\n    _require(value[\"verification_policy\"] == VERIFICATION_POLICY, \"verifier-contract policy differs\")\n    self_hash = value[\"verifier_contract_sha256\"]\n    _require(\n        type(self_hash) is str\n        and len(self_hash) == 64\n        and self_hash == v1._field_self_hash(value, \"verifier_contract_sha256\"),\n        \"verifier-contract self hash differs\",\n    )\n    return copy.deepcopy(dict(value))\n\n\ndef _check_verifier_contract(dependencies: Mapping[str, Any]) -> dict[str, Any]:\n    v1 = dependencies[\"v1\"]\n    try:\n        value, raw = v1._read_json(\n            VERIFIER_CONTRACT_PATH,\n            maximum=MAX_VERIFIER_CONTRACT_BYTES,\n            label=\"cache bundle verifier contract\",\n            canonical=True,\n            require_single_link=True,\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    validated = validate_verifier_contract(\n        value,\n        schema=dependencies[\"verifier_schema\"],\n        dependencies=dependencies,\n    )\n    expected = _build_verifier_contract(dependencies)\n    _require(raw == v1._render(expected) and validated == expected, \"checked verifier contract differs\")\n    return validated\n\n\ndef check_verifier_contract() -> dict[str, Any]:\n    \"\"\"Check only the fixed production verifier contract and dependencies.\"\"\"\n\n    return _check_verifier_contract(_load_fixed_dependencies())\n\n\ndef _build_verification_report(\n    *,\n    bundle_identity: Mapping[str, Any],\n    content_summary: Mapping[str, Any],\n    manifest: Mapping[str, Any],\n    manifest_raw: bytes,\n    dependencies: Mapping[str, Any],\n    verifier_contract: Mapping[str, Any],\n) -> dict[str, Any]:\n    material = dependencies[\"v1_dependencies\"][\"material\"]\n    declared = material[\"material\"]\n    contents = manifest[\"contents\"]\n    run_plan = manifest[\"run_plan\"]\n    v1_contract = dependencies[\"v1_verifier_contract\"]\n    _require(\n        all(type(value) is dict for value in (declared, contents, run_plan, v1_contract)),\n        \"verified report inputs differ\",\n    )\n    report: dict[str, Any] = {\n        \"authority\": copy.deepcopy(REPORT_AUTHORITY),\n        \"bindings\": {\n            \"binding_status\": \"same_descriptor_raw_identity_recomputed_against_source_reviewed_v1_material\",\n            \"format_artifact_sha256\": CHECKED_FORMAT_FILE_SHA256,\n            \"format_contract_sha256\": CHECKED_FORMAT_SHA256,\n            \"v1_material_artifact_sha256\": _sha256(dependencies[\"v1_dependencies\"][\"material_raw\"]),\n            \"v1_material_declaration_sha256\": material[\"material_declaration_sha256\"],\n            \"v1_verifier_contract_artifact_sha256\": _sha256(\n                dependencies[\"v1_verifier_contract_raw\"]\n            ),\n            \"v1_verifier_contract_sha256\": v1_contract[\"verifier_contract_sha256\"],\n            \"v2_verifier_contract_sha256\": verifier_contract[\"verifier_contract_sha256\"],\n        },\n        \"bundle\": {\n            \"artifact_file\": declared[\"archive_file\"],\n            \"byte_count\": bundle_identity[\"byte_count\"],\n            \"flags\": 0,\n            \"format_version\": FORMAT_VERSION,\n            \"header_byte_count\": HEADER_BYTES,\n            \"prefix_sha256\": content_summary[\"prefix_sha256\"],\n            \"raw_sha256\": bundle_identity[\"sha256\"],\n            \"record_fixed_byte_count\": RECORD_FIXED_BYTES,\n            \"records_sha256\": content_summary[\"records_sha256\"],\n            \"trailer_byte_count\": TRAILER_BYTES,\n        },\n        \"contents\": {\n            \"all_payload_sha256_verified\": True,\n            \"file_count\": content_summary[\"file_count\"],\n            \"manifest_bijection\": True,\n            \"repository_file_counts\": copy.deepcopy(\n                content_summary[\"repository_file_counts\"]\n            ),\n            \"shared_seed_semantics\": \"one_shared_union_seed_copied_unchanged_to_every_arm\",\n            \"unpacked_byte_count\": content_summary[\"unpacked_byte_count\"],\n        },\n        \"manifest\": {\n            \"artifact_file\": declared[\"manifest_file\"],\n            \"artifact_sha256\": _sha256(manifest_raw),\n            \"inventory_sha256\": contents[\"inventory_sha256\"],\n            \"manifest_sha256\": manifest[\"manifest_sha256\"],\n            \"profile\": manifest[\"profile\"],\n            \"projection_sha256\": _manifest_projection_sha256(manifest),\n            \"run_plan_sha256\": run_plan[\"plan_sha256\"],\n            \"schema_sha256\": MANIFEST_BINDING[\"manifest_schema_sha256\"],\n            \"toolchain_bindings_sha256\": run_plan[\"toolchain_bindings_sha256\"],\n        },\n        \"profile\": REPORT_PROFILE,\n        \"report_sha256\": None,\n        \"safety\": copy.deepcopy(REPORT_SAFETY),\n        \"schema_version\": SCHEMA_VERSION,\n        \"status\": REPORT_STATUS,\n        \"structure\": copy.deepcopy(REPORT_STRUCTURE),\n    }\n    v1 = dependencies[\"v1\"]\n    report[\"report_sha256\"] = v1._field_self_hash(report, \"report_sha256\")\n    return _validate_verification_report(\n        report,\n        schema=dependencies[\"report_schema\"],\n        v1=v1,\n    )\n\n\ndef _validate_verification_report(\n    value: Mapping[str, Any],\n    *,\n    schema: Mapping[str, Any],\n    v1: types.ModuleType,\n) -> dict[str, Any]:\n    try:\n        v1._validate_schema(\n            value,\n            schema,\n            schema_name=REPORT_SCHEMA_PATH.name,\n            label=\"cache bundle verification report\",\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    expected_fields = {\n        \"authority\",\n        \"bindings\",\n        \"bundle\",\n        \"contents\",\n        \"manifest\",\n        \"profile\",\n        \"report_sha256\",\n        \"safety\",\n        \"schema_version\",\n        \"status\",\n        \"structure\",\n    }\n    _require(type(value) is dict and set(value) == expected_fields, \"verification-report fields differ\")\n    _require(\n        value[\"profile\"] == REPORT_PROFILE\n        and value[\"schema_version\"] == SCHEMA_VERSION\n        and value[\"status\"] == REPORT_STATUS,\n        \"verification-report identity differs\",\n    )\n    _require(value[\"authority\"] == REPORT_AUTHORITY, \"verification-report authority differs\")\n    _require(value[\"safety\"] == REPORT_SAFETY, \"verification-report safety differs\")\n    _require(value[\"structure\"] == REPORT_STRUCTURE, \"verification-report structure differs\")\n    report_hash = value[\"report_sha256\"]\n    _require(\n        type(report_hash) is str\n        and len(report_hash) == 64\n        and report_hash == v1._field_self_hash(value, \"report_sha256\"),\n        \"verification-report self hash differs\",\n    )\n    return copy.deepcopy(dict(value))\n\n\ndef _verify_with_dependencies(\n    manifest_path: pathlib.Path,\n    bundle_path: pathlib.Path,\n    *,\n    dependencies: Mapping[str, Any],\n    verifier_contract: Mapping[str, Any],\n) -> dict[str, Any]:\n    \"\"\"Private synthetic seam; production callers use fixed dependencies.\"\"\"\n\n    v1 = dependencies[\"v1\"]\n    validated_contract = validate_verifier_contract(\n        verifier_contract,\n        schema=dependencies[\"verifier_schema\"],\n        dependencies=dependencies,\n    )\n    material = dependencies[\"v1_dependencies\"][\"material\"]\n    _require(type(material) is dict, \"v1 material dependency differs\")\n    _require(\n        material.get(\"status\") == V1_APPROVED_MATERIAL_STATUS\n        and validated_contract[\"status\"] == APPROVED_STATUS,\n        \"cache bundle material source review is pending; locator access forbidden\",\n    )\n\n    declared = material.get(\"material\")\n    _require(type(declared) is dict, \"approved v1 material identities differ\")\n    declared_map = cast(dict[str, Any], declared)\n    _require(\n        manifest_path.name == declared_map[\"manifest_file\"]\n        and bundle_path.name == declared_map[\"archive_file\"],\n        \"cache bundle locator filename differs from reviewed identity\",\n    )\n    try:\n        manifest, manifest_raw = v1._read_json(\n            manifest_path,\n            maximum=MAX_FIXED_JSON_BYTES,\n            label=\"reviewed cache manifest\",\n            canonical=True,\n            require_single_link=True,\n        )\n        _require(\n            _sha256(manifest_raw) == declared_map[\"manifest_file_sha256\"],\n            \"cache manifest raw hash differs from reviewed material\",\n        )\n        validated_manifest = v1._validate_manifest_identity(\n            manifest,\n            schema=dependencies[\"v1_dependencies\"][\"manifest_schema\"],\n            material=material,\n        )\n        _validate_bundle_path_policy(validated_manifest)\n        descriptor, directories = v1._open_regular_descriptor(\n            bundle_path,\n            label=\"reviewed cache bundle\",\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n\n    try:\n        bundle_identity, bundle_stat = _raw_identity_pass(\n            descriptor,\n            expected_byte_count=declared_map[\"archive_byte_count\"],\n            expected_sha256=declared_map[\"archive_sha256\"],\n        )\n        content_summary = _parse_content_pass(\n            descriptor,\n            bundle_stat=bundle_stat,\n            manifest=validated_manifest,\n            format_contract=dependencies[\"format\"],\n        )\n    finally:\n        os.close(descriptor)\n        for current in reversed(directories):\n            os.close(current)\n    return _build_verification_report(\n        bundle_identity=bundle_identity,\n        content_summary=content_summary,\n        manifest=validated_manifest,\n        manifest_raw=manifest_raw,\n        dependencies=dependencies,\n        verifier_contract=validated_contract,\n    )\n\n\ndef verify_bundle_files(\n    manifest_path: pathlib.Path,\n    bundle_path: pathlib.Path,\n) -> dict[str, Any]:\n    \"\"\"Verify reviewed bundle contents without extracting, staging, or executing.\"\"\"\n\n    dependencies = _load_fixed_dependencies()\n    verifier_contract = _check_verifier_contract(dependencies)\n    material = dependencies[\"v1_dependencies\"][\"material\"]\n    _require(\n        type(material) is dict and material.get(\"status\") == V1_APPROVED_MATERIAL_STATUS,\n        \"cache bundle material source review is pending; locator access forbidden\",\n    )\n    return _verify_with_dependencies(\n        manifest_path,\n        bundle_path,\n        dependencies=dependencies,\n        verifier_contract=verifier_contract,\n    )\n\n\ndef _write_atomic(path: pathlib.Path, value: Mapping[str, Any]) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    descriptor, temporary_name = tempfile.mkstemp(\n        prefix=f\".{path.name}.\",\n        dir=path.parent,\n    )\n    temporary = pathlib.Path(temporary_name)\n    try:\n        os.fchmod(descriptor, 0o644)\n        with os.fdopen(descriptor, \"wb\") as handle:\n            handle.write(_checked_v1()._render(value))\n            handle.flush()\n            os.fsync(handle.fileno())\n        os.replace(temporary, path)\n    finally:\n        temporary.unlink(missing_ok=True)\n\n\ndef _parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(description=__doc__)\n    commands = parser.add_subparsers(dest=\"command\", required=True)\n    build = commands.add_parser(\"build\", help=\"build the non-authorizing verifier contract\")\n    build.add_argument(\"--output\", required=True, type=pathlib.Path)\n    commands.add_parser(\"check\", help=\"check the fixed verifier contract and dependencies\")\n    verify = commands.add_parser(\"verify\", help=\"verify reviewed bundle contents without staging\")\n    verify.add_argument(\"manifest\", type=pathlib.Path)\n    verify.add_argument(\"bundle\", type=pathlib.Path)\n    return parser\n\n\ndef main(argv: Sequence[str] | None = None) -> int:\n    parser = _parser()\n    args = parser.parse_args(argv)\n    try:\n        if args.command == \"build\":\n            _write_atomic(args.output, build_verifier_contract())\n        elif args.command == \"check\":\n            contract = check_verifier_contract()\n            print(\n                json.dumps(\n                    {\n                        \"execution_authority\": False,\n                        \"profile\": contract[\"profile\"],\n                        \"status\": contract[\"status\"],\n                    },\n                    separators=(\",\", \":\"),\n                    sort_keys=True,\n                )\n            )\n        else:\n            report = verify_bundle_files(args.manifest, args.bundle)\n            print(_checked_v1()._canonical_bytes(report).decode(\"utf-8\"))\n    except CacheBundleVerificationError as exc:\n        parser.error(str(exc))\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","stderr":"","aggregated_output":"        )\n        for schema, path, label in (\n            (format_schema, FORMAT_SCHEMA_PATH, \"cache bundle format\"),\n            (report_schema, REPORT_SCHEMA_PATH, \"cache bundle verification report\"),\n            (verifier_schema, VERIFIER_SCHEMA_PATH, \"cache bundle verifier contract\"),\n        ):\n            v1._audit_schema(schema, schema_name=path.name, label=label)\n        format_contract, format_raw = v1._read_json(\n            FORMAT_PATH,\n            maximum=v1.MAX_FIXED_JSON_BYTES,\n            label=\"cache bundle format contract\",\n            canonical=True,\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    _require(_sha256(format_raw) == CHECKED_FORMAT_FILE_SHA256, \"format-contract raw hash differs\")\n    validated_format = _validate_format_contract(format_contract, schema=format_schema, v1=v1)\n    return {\n        \"format\": validated_format,\n        \"format_raw\": format_raw,\n        \"format_schema\": format_schema,\n        \"format_schema_raw\": format_schema_raw,\n        \"report_schema\": report_schema,\n        \"report_schema_raw\": report_schema_raw,\n        \"v1\": v1,\n        \"v1_dependencies\": v1_dependencies,\n        \"v1_verifier_contract\": v1_verifier_contract,\n        \"v1_verifier_contract_raw\": v1_verifier_contract_raw,\n        \"verifier_schema\": verifier_schema,\n        \"verifier_schema_raw\": verifier_schema_raw,\n    }\n\n\ndef _expected_implementation(dependencies: Mapping[str, Any]) -> dict[str, Any]:\n    v1 = dependencies[\"v1\"]\n    try:\n        source_raw = v1._read_bounded(\n            pathlib.Path(__file__),\n            maximum=MAX_SOURCE_BYTES,\n            label=\"cache bundle verifier source\",\n            require_single_link=True,\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    v1_dependencies = dependencies[\"v1_dependencies\"]\n    _require(type(v1_dependencies) is dict, \"v1 fixed dependencies differ\")\n    return {\n        \"builder\": _file_binding(pathlib.Path(__file__), source_raw),\n        \"draft202012_validator\": copy.deepcopy(v1_dependencies[\"draft_validator\"]),\n        \"format_artifact\": _file_binding(FORMAT_PATH, dependencies[\"format_raw\"]),\n        \"format_schema\": _file_binding(FORMAT_SCHEMA_PATH, dependencies[\"format_schema_raw\"]),\n        \"manifest_schema\": _file_binding(\n            pathlib.Path(\"offline-go-cache-seed-manifest-v1.schema.json\"),\n            v1_dependencies[\"manifest_schema_raw\"],\n        ),\n        \"report_schema\": _file_binding(REPORT_SCHEMA_PATH, dependencies[\"report_schema_raw\"]),\n        \"v1_raw_verifier_source\": _file_binding(V1_SOURCE_PATH, _read_checked_v1_source()),\n        \"verifier_contract_schema\": _file_binding(\n            VERIFIER_SCHEMA_PATH,\n            dependencies[\"verifier_schema_raw\"],\n        ),\n    }\n\n\ndef _expected_raw_identity_binding(dependencies: Mapping[str, Any]) -> dict[str, Any]:\n    v1_dependencies = dependencies[\"v1_dependencies\"]\n    material = v1_dependencies[\"material\"]\n    v1_contract = dependencies[\"v1_verifier_contract\"]\n    _require(\n        type(material) is dict and type(v1_contract) is dict,\n        \"v1 raw identity dependencies differ\",\n    )\n    return {\n        \"v1_material\": {\n            \"artifact_file\": \"negative-control-cache-archive-material-v1.json\",\n            \"artifact_sha256\": _sha256(v1_dependencies[\"material_raw\"]),\n            \"material_declaration_sha256\": material[\"material_declaration_sha256\"],\n            \"profile\": material[\"profile\"],\n            \"status\": material[\"status\"],\n        },\n        \"v1_material_schema_sha256\": \"1424cd22b5eb057b5794347403780435f95c0428d4f81ff42441e71abc39d5d5\",\n        \"v1_raw_verifier_source_sha256\": CHECKED_V1_SOURCE_SHA256,\n        \"v1_report_schema_sha256\": \"5827c78df73b024df32bf2853d412df428e7362e869d5d202b33dac15bbe4e5d\",\n        \"v1_verifier_contract\": {\n            \"artifact_file\": V1_VERIFIER_CONTRACT_PATH.name,\n            \"artifact_sha256\": _sha256(dependencies[\"v1_verifier_contract_raw\"]),\n            \"profile\": v1_contract[\"profile\"],\n            \"status\": v1_contract[\"status\"],\n            \"verifier_contract_sha256\": v1_contract[\"verifier_contract_sha256\"],\n        },\n        \"v1_verifier_contract_schema_sha256\": \"c35c0de98dbdcec6744a3fe33ee363261507eb894bbddbb3af5af3642be7f914\",\n    }\n\n\ndef _expected_status(dependencies: Mapping[str, Any]) -> str:\n    material = dependencies[\"v1_dependencies\"][\"material\"]\n    v1_contract = dependencies[\"v1_verifier_contract\"]\n    _require(\n        type(material) is dict and type(v1_contract) is dict,\n        \"v1 approval dependencies differ\",\n    )\n    material_status = material.get(\"status\")\n    contract_status = v1_contract.get(\"status\")\n    if material_status == V1_PENDING_MATERIAL_STATUS:\n        _require(\n            contract_status == V1_PENDING_VERIFIER_STATUS,\n            \"pending v1 material and verifier statuses differ\",\n        )\n        return PENDING_STATUS\n    _require(\n        material_status == V1_APPROVED_MATERIAL_STATUS\n        and contract_status == V1_APPROVED_VERIFIER_STATUS,\n        \"approved v1 material and verifier statuses differ\",\n    )\n    return APPROVED_STATUS\n\n\ndef _build_verifier_contract(dependencies: Mapping[str, Any]) -> dict[str, Any]:\n    v1 = dependencies[\"v1\"]\n    contract: dict[str, Any] = {\n        \"authority\": copy.deepcopy(AUTHORITY),\n        \"format_binding\": copy.deepcopy(FORMAT_BINDING),\n        \"implementation\": _expected_implementation(dependencies),\n        \"manifest_binding\": copy.deepcopy(MANIFEST_BINDING),\n        \"profile\": VERIFIER_PROFILE,\n        \"raw_identity_binding\": _expected_raw_identity_binding(dependencies),\n        \"residual_gates\": list(RESIDUAL_GATES),\n        \"runtime_bindings\": copy.deepcopy(RUNTIME_BINDINGS),\n        \"schema_version\": SCHEMA_VERSION,\n        \"status\": _expected_status(dependencies),\n        \"verification_policy\": copy.deepcopy(VERIFICATION_POLICY),\n        \"verifier_contract_sha256\": None,\n    }\n    contract[\"verifier_contract_sha256\"] = v1._field_self_hash(\n        contract,\n        \"verifier_contract_sha256\",\n    )\n    return validate_verifier_contract(\n        contract,\n        schema=dependencies[\"verifier_schema\"],\n        dependencies=dependencies,\n    )\n\n\ndef build_verifier_contract() -> dict[str, Any]:\n    \"\"\"Build a non-authorizing verifier contract from fixed local inputs.\"\"\"\n\n    return _build_verifier_contract(_load_fixed_dependencies())\n\n\ndef validate_verifier_contract(\n    value: Mapping[str, Any],\n    *,\n    schema: Mapping[str, Any],\n    dependencies: Mapping[str, Any],\n) -> dict[str, Any]:\n    v1 = dependencies[\"v1\"]\n    try:\n        v1._validate_schema(\n            value,\n            schema,\n            schema_name=VERIFIER_SCHEMA_PATH.name,\n            label=\"cache bundle verifier contract\",\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    expected_fields = {\n        \"authority\",\n        \"format_binding\",\n        \"implementation\",\n        \"manifest_binding\",\n        \"profile\",\n        \"raw_identity_binding\",\n        \"residual_gates\",\n        \"runtime_bindings\",\n        \"schema_version\",\n        \"status\",\n        \"verification_policy\",\n        \"verifier_contract_sha256\",\n    }\n    _require(type(value) is dict and set(value) == expected_fields, \"verifier-contract fields differ\")\n    _require(\n        value[\"profile\"] == VERIFIER_PROFILE\n        and value[\"schema_version\"] == SCHEMA_VERSION\n        and value[\"status\"] == _expected_status(dependencies),\n        \"verifier-contract identity or status differs\",\n    )\n    _require(value[\"authority\"] == AUTHORITY, \"verifier-contract authority differs\")\n    _require(value[\"format_binding\"] == FORMAT_BINDING, \"verifier-contract format binding differs\")\n    _require(value[\"manifest_binding\"] == MANIFEST_BINDING, \"verifier-contract manifest binding differs\")\n    _require(\n        value[\"raw_identity_binding\"] == _expected_raw_identity_binding(dependencies),\n        \"verifier-contract raw identity binding differs\",\n    )\n    _require(\n        value[\"implementation\"] == _expected_implementation(dependencies),\n        \"verifier-contract implementation binding differs\",\n    )\n    _require(value[\"residual_gates\"] == RESIDUAL_GATES, \"verifier-contract residual gates differ\")\n    _require(value[\"runtime_bindings\"] == RUNTIME_BINDINGS, \"verifier-contract runtime bindings differ\")\n    _require(value[\"verification_policy\"] == VERIFICATION_POLICY, \"verifier-contract policy differs\")\n    self_hash = value[\"verifier_contract_sha256\"]\n    _require(\n        type(self_hash) is str\n        and len(self_hash) == 64\n        and self_hash == v1._field_self_hash(value, \"verifier_contract_sha256\"),\n        \"verifier-contract self hash differs\",\n    )\n    return copy.deepcopy(dict(value))\n\n\ndef _check_verifier_contract(dependencies: Mapping[str, Any]) -> dict[str, Any]:\n    v1 = dependencies[\"v1\"]\n    try:\n        value, raw = v1._read_json(\n            VERIFIER_CONTRACT_PATH,\n            maximum=MAX_VERIFIER_CONTRACT_BYTES,\n            label=\"cache bundle verifier contract\",\n            canonical=True,\n            require_single_link=True,\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    validated = validate_verifier_contract(\n        value,\n        schema=dependencies[\"verifier_schema\"],\n        dependencies=dependencies,\n    )\n    expected = _build_verifier_contract(dependencies)\n    _require(raw == v1._render(expected) and validated == expected, \"checked verifier contract differs\")\n    return validated\n\n\ndef check_verifier_contract() -> dict[str, Any]:\n    \"\"\"Check only the fixed production verifier contract and dependencies.\"\"\"\n\n    return _check_verifier_contract(_load_fixed_dependencies())\n\n\ndef _build_verification_report(\n    *,\n    bundle_identity: Mapping[str, Any],\n    content_summary: Mapping[str, Any],\n    manifest: Mapping[str, Any],\n    manifest_raw: bytes,\n    dependencies: Mapping[str, Any],\n    verifier_contract: Mapping[str, Any],\n) -> dict[str, Any]:\n    material = dependencies[\"v1_dependencies\"][\"material\"]\n    declared = material[\"material\"]\n    contents = manifest[\"contents\"]\n    run_plan = manifest[\"run_plan\"]\n    v1_contract = dependencies[\"v1_verifier_contract\"]\n    _require(\n        all(type(value) is dict for value in (declared, contents, run_plan, v1_contract)),\n        \"verified report inputs differ\",\n    )\n    report: dict[str, Any] = {\n        \"authority\": copy.deepcopy(REPORT_AUTHORITY),\n        \"bindings\": {\n            \"binding_status\": \"same_descriptor_raw_identity_recomputed_against_source_reviewed_v1_material\",\n            \"format_artifact_sha256\": CHECKED_FORMAT_FILE_SHA256,\n            \"format_contract_sha256\": CHECKED_FORMAT_SHA256,\n            \"v1_material_artifact_sha256\": _sha256(dependencies[\"v1_dependencies\"][\"material_raw\"]),\n            \"v1_material_declaration_sha256\": material[\"material_declaration_sha256\"],\n            \"v1_verifier_contract_artifact_sha256\": _sha256(\n                dependencies[\"v1_verifier_contract_raw\"]\n            ),\n            \"v1_verifier_contract_sha256\": v1_contract[\"verifier_contract_sha256\"],\n            \"v2_verifier_contract_sha256\": verifier_contract[\"verifier_contract_sha256\"],\n        },\n        \"bundle\": {\n            \"artifact_file\": declared[\"archive_file\"],\n            \"byte_count\": bundle_identity[\"byte_count\"],\n            \"flags\": 0,\n            \"format_version\": FORMAT_VERSION,\n            \"header_byte_count\": HEADER_BYTES,\n            \"prefix_sha256\": content_summary[\"prefix_sha256\"],\n            \"raw_sha256\": bundle_identity[\"sha256\"],\n            \"record_fixed_byte_count\": RECORD_FIXED_BYTES,\n            \"records_sha256\": content_summary[\"records_sha256\"],\n            \"trailer_byte_count\": TRAILER_BYTES,\n        },\n        \"contents\": {\n            \"all_payload_sha256_verified\": True,\n            \"file_count\": content_summary[\"file_count\"],\n            \"manifest_bijection\": True,\n            \"repository_file_counts\": copy.deepcopy(\n                content_summary[\"repository_file_counts\"]\n            ),\n            \"shared_seed_semantics\": \"one_shared_union_seed_copied_unchanged_to_every_arm\",\n            \"unpacked_byte_count\": content_summary[\"unpacked_byte_count\"],\n        },\n        \"manifest\": {\n            \"artifact_file\": declared[\"manifest_file\"],\n            \"artifact_sha256\": _sha256(manifest_raw),\n            \"inventory_sha256\": contents[\"inventory_sha256\"],\n            \"manifest_sha256\": manifest[\"manifest_sha256\"],\n            \"profile\": manifest[\"profile\"],\n            \"projection_sha256\": _manifest_projection_sha256(manifest),\n            \"run_plan_sha256\": run_plan[\"plan_sha256\"],\n            \"schema_sha256\": MANIFEST_BINDING[\"manifest_schema_sha256\"],\n            \"toolchain_bindings_sha256\": run_plan[\"toolchain_bindings_sha256\"],\n        },\n        \"profile\": REPORT_PROFILE,\n        \"report_sha256\": None,\n        \"safety\": copy.deepcopy(REPORT_SAFETY),\n        \"schema_version\": SCHEMA_VERSION,\n        \"status\": REPORT_STATUS,\n        \"structure\": copy.deepcopy(REPORT_STRUCTURE),\n    }\n    v1 = dependencies[\"v1\"]\n    report[\"report_sha256\"] = v1._field_self_hash(report, \"report_sha256\")\n    return _validate_verification_report(\n        report,\n        schema=dependencies[\"report_schema\"],\n        v1=v1,\n    )\n\n\ndef _validate_verification_report(\n    value: Mapping[str, Any],\n    *,\n    schema: Mapping[str, Any],\n    v1: types.ModuleType,\n) -> dict[str, Any]:\n    try:\n        v1._validate_schema(\n            value,\n            schema,\n            schema_name=REPORT_SCHEMA_PATH.name,\n            label=\"cache bundle verification report\",\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    expected_fields = {\n        \"authority\",\n        \"bindings\",\n        \"bundle\",\n        \"contents\",\n        \"manifest\",\n        \"profile\",\n        \"report_sha256\",\n        \"safety\",\n        \"schema_version\",\n        \"status\",\n        \"structure\",\n    }\n    _require(type(value) is dict and set(value) == expected_fields, \"verification-report fields differ\")\n    _require(\n        value[\"profile\"] == REPORT_PROFILE\n        and value[\"schema_version\"] == SCHEMA_VERSION\n        and value[\"status\"] == REPORT_STATUS,\n        \"verification-report identity differs\",\n    )\n    _require(value[\"authority\"] == REPORT_AUTHORITY, \"verification-report authority differs\")\n    _require(value[\"safety\"] == REPORT_SAFETY, \"verification-report safety differs\")\n    _require(value[\"structure\"] == REPORT_STRUCTURE, \"verification-report structure differs\")\n    report_hash = value[\"report_sha256\"]\n    _require(\n        type(report_hash) is str\n        and len(report_hash) == 64\n        and report_hash == v1._field_self_hash(value, \"report_sha256\"),\n        \"verification-report self hash differs\",\n    )\n    return copy.deepcopy(dict(value))\n\n\ndef _verify_with_dependencies(\n    manifest_path: pathlib.Path,\n    bundle_path: pathlib.Path,\n    *,\n    dependencies: Mapping[str, Any],\n    verifier_contract: Mapping[str, Any],\n) -> dict[str, Any]:\n    \"\"\"Private synthetic seam; production callers use fixed dependencies.\"\"\"\n\n    v1 = dependencies[\"v1\"]\n    validated_contract = validate_verifier_contract(\n        verifier_contract,\n        schema=dependencies[\"verifier_schema\"],\n        dependencies=dependencies,\n    )\n    material = dependencies[\"v1_dependencies\"][\"material\"]\n    _require(type(material) is dict, \"v1 material dependency differs\")\n    _require(\n        material.get(\"status\") == V1_APPROVED_MATERIAL_STATUS\n        and validated_contract[\"status\"] == APPROVED_STATUS,\n        \"cache bundle material source review is pending; locator access forbidden\",\n    )\n\n    declared = material.get(\"material\")\n    _require(type(declared) is dict, \"approved v1 material identities differ\")\n    declared_map = cast(dict[str, Any], declared)\n    _require(\n        manifest_path.name == declared_map[\"manifest_file\"]\n        and bundle_path.name == declared_map[\"archive_file\"],\n        \"cache bundle locator filename differs from reviewed identity\",\n    )\n    try:\n        manifest, manifest_raw = v1._read_json(\n            manifest_path,\n            maximum=MAX_FIXED_JSON_BYTES,\n            label=\"reviewed cache manifest\",\n            canonical=True,\n            require_single_link=True,\n        )\n        _require(\n            _sha256(manifest_raw) == declared_map[\"manifest_file_sha256\"],\n            \"cache manifest raw hash differs from reviewed material\",\n        )\n        validated_manifest = v1._validate_manifest_identity(\n            manifest,\n            schema=dependencies[\"v1_dependencies\"][\"manifest_schema\"],\n            material=material,\n        )\n        _validate_bundle_path_policy(validated_manifest)\n        descriptor, directories = v1._open_regular_descriptor(\n            bundle_path,\n            label=\"reviewed cache bundle\",\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n\n    try:\n        bundle_identity, bundle_stat = _raw_identity_pass(\n            descriptor,\n            expected_byte_count=declared_map[\"archive_byte_count\"],\n            expected_sha256=declared_map[\"archive_sha256\"],\n        )\n        content_summary = _parse_content_pass(\n            descriptor,\n            bundle_stat=bundle_stat,\n            manifest=validated_manifest,\n            format_contract=dependencies[\"format\"],\n        )\n    finally:\n        os.close(descriptor)\n        for current in reversed(directories):\n            os.close(current)\n    return _build_verification_report(\n        bundle_identity=bundle_identity,\n        content_summary=content_summary,\n        manifest=validated_manifest,\n        manifest_raw=manifest_raw,\n        dependencies=dependencies,\n        verifier_contract=validated_contract,\n    )\n\n\ndef verify_bundle_files(\n    manifest_path: pathlib.Path,\n    bundle_path: pathlib.Path,\n) -> dict[str, Any]:\n    \"\"\"Verify reviewed bundle contents without extracting, staging, or executing.\"\"\"\n\n    dependencies = _load_fixed_dependencies()\n    verifier_contract = _check_verifier_contract(dependencies)\n    material = dependencies[\"v1_dependencies\"][\"material\"]\n    _require(\n        type(material) is dict and material.get(\"status\") == V1_APPROVED_MATERIAL_STATUS,\n        \"cache bundle material source review is pending; locator access forbidden\",\n    )\n    return _verify_with_dependencies(\n        manifest_path,\n        bundle_path,\n        dependencies=dependencies,\n        verifier_contract=verifier_contract,\n    )\n\n\ndef _write_atomic(path: pathlib.Path, value: Mapping[str, Any]) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    descriptor, temporary_name = tempfile.mkstemp(\n        prefix=f\".{path.name}.\",\n        dir=path.parent,\n    )\n    temporary = pathlib.Path(temporary_name)\n    try:\n        os.fchmod(descriptor, 0o644)\n        with os.fdopen(descriptor, \"wb\") as handle:\n            handle.write(_checked_v1()._render(value))\n            handle.flush()\n            os.fsync(handle.fileno())\n        os.replace(temporary, path)\n    finally:\n        temporary.unlink(missing_ok=True)\n\n\ndef _parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(description=__doc__)\n    commands = parser.add_subparsers(dest=\"command\", required=True)\n    build = commands.add_parser(\"build\", help=\"build the non-authorizing verifier contract\")\n    build.add_argument(\"--output\", required=True, type=pathlib.Path)\n    commands.add_parser(\"check\", help=\"check the fixed verifier contract and dependencies\")\n    verify = commands.add_parser(\"verify\", help=\"verify reviewed bundle contents without staging\")\n    verify.add_argument(\"manifest\", type=pathlib.Path)\n    verify.add_argument(\"bundle\", type=pathlib.Path)\n    return parser\n\n\ndef main(argv: Sequence[str] | None = None) -> int:\n    parser = _parser()\n    args = parser.parse_args(argv)\n    try:\n        if args.command == \"build\":\n            _write_atomic(args.output, build_verifier_contract())\n        elif args.command == \"check\":\n            contract = check_verifier_contract()\n            print(\n                json.dumps(\n                    {\n                        \"execution_authority\": False,\n                        \"profile\": contract[\"profile\"],\n                        \"status\": contract[\"status\"],\n                    },\n                    separators=(\",\", \":\"),\n                    sort_keys=True,\n                )\n            )\n        else:\n            report = verify_bundle_files(args.manifest, args.bundle)\n            print(_checked_v1()._canonical_bytes(report).decode(\"utf-8\"))\n    except CacheBundleVerificationError as exc:\n        parser.error(str(exc))\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"duration":{"secs":0,"nanos":2791},"formatted_output":"        )\n        for schema, path, label in (\n            (format_schema, FORMAT_SCHEMA_PATH, \"cache bundle format\"),\n            (report_schema, REPORT_SCHEMA_PATH, \"cache bundle verification report\"),\n            (verifier_schema, VERIFIER_SCHEMA_PATH, \"cache bundle verifier contract\"),\n        ):\n            v1._audit_schema(schema, schema_name=path.name, label=label)\n        format_contract, format_raw = v1._read_json(\n            FORMAT_PATH,\n            maximum=v1.MAX_FIXED_JSON_BYTES,\n            label=\"cache bundle format contract\",\n            canonical=True,\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    _require(_sha256(format_raw) == CHECKED_FORMAT_FILE_SHA256, \"format-contract raw hash differs\")\n    validated_format = _validate_format_contract(format_contract, schema=format_schema, v1=v1)\n    return {\n        \"format\": validated_format,\n        \"format_raw\": format_raw,\n        \"format_schema\": format_schema,\n        \"format_schema_raw\": format_schema_raw,\n        \"report_schema\": report_schema,\n        \"report_schema_raw\": report_schema_raw,\n        \"v1\": v1,\n        \"v1_dependencies\": v1_dependencies,\n        \"v1_verifier_contract\": v1_verifier_contract,\n        \"v1_verifier_contract_raw\": v1_verifier_contract_raw,\n        \"verifier_schema\": verifier_schema,\n        \"verifier_schema_raw\": verifier_schema_raw,\n    }\n\n\ndef _expected_implementation(dependencies: Mapping[str, Any]) -> dict[str, Any]:\n    v1 = dependencies[\"v1\"]\n    try:\n        source_raw = v1._read_bounded(\n            pathlib.Path(__file__),\n            maximum=MAX_SOURCE_BYTES,\n            label=\"cache bundle verifier source\",\n            require_single_link=True,\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    v1_dependencies = dependencies[\"v1_dependencies\"]\n    _require(type(v1_dependencies) is dict, \"v1 fixed dependencies differ\")\n    return {\n        \"builder\": _file_binding(pathlib.Path(__file__), source_raw),\n        \"draft202012_validator\": copy.deepcopy(v1_dependencies[\"draft_validator\"]),\n        \"format_artifact\": _file_binding(FORMAT_PATH, dependencies[\"format_raw\"]),\n        \"format_schema\": _file_binding(FORMAT_SCHEMA_PATH, dependencies[\"format_schema_raw\"]),\n        \"manifest_schema\": _file_binding(\n            pathlib.Path(\"offline-go-cache-seed-manifest-v1.schema.json\"),\n            v1_dependencies[\"manifest_schema_raw\"],\n        ),\n        \"report_schema\": _file_binding(REPORT_SCHEMA_PATH, dependencies[\"report_schema_raw\"]),\n        \"v1_raw_verifier_source\": _file_binding(V1_SOURCE_PATH, _read_checked_v1_source()),\n        \"verifier_contract_schema\": _file_binding(\n            VERIFIER_SCHEMA_PATH,\n            dependencies[\"verifier_schema_raw\"],\n        ),\n    }\n\n\ndef _expected_raw_identity_binding(dependencies: Mapping[str, Any]) -> dict[str, Any]:\n    v1_dependencies = dependencies[\"v1_dependencies\"]\n    material = v1_dependencies[\"material\"]\n    v1_contract = dependencies[\"v1_verifier_contract\"]\n    _require(\n        type(material) is dict and type(v1_contract) is dict,\n        \"v1 raw identity dependencies differ\",\n    )\n    return {\n        \"v1_material\": {\n            \"artifact_file\": \"negative-control-cache-archive-material-v1.json\",\n            \"artifact_sha256\": _sha256(v1_dependencies[\"material_raw\"]),\n            \"material_declaration_sha256\": material[\"material_declaration_sha256\"],\n            \"profile\": material[\"profile\"],\n            \"status\": material[\"status\"],\n        },\n        \"v1_material_schema_sha256\": \"1424cd22b5eb057b5794347403780435f95c0428d4f81ff42441e71abc39d5d5\",\n        \"v1_raw_verifier_source_sha256\": CHECKED_V1_SOURCE_SHA256,\n        \"v1_report_schema_sha256\": \"5827c78df73b024df32bf2853d412df428e7362e869d5d202b33dac15bbe4e5d\",\n        \"v1_verifier_contract\": {\n            \"artifact_file\": V1_VERIFIER_CONTRACT_PATH.name,\n            \"artifact_sha256\": _sha256(dependencies[\"v1_verifier_contract_raw\"]),\n            \"profile\": v1_contract[\"profile\"],\n            \"status\": v1_contract[\"status\"],\n            \"verifier_contract_sha256\": v1_contract[\"verifier_contract_sha256\"],\n        },\n        \"v1_verifier_contract_schema_sha256\": \"c35c0de98dbdcec6744a3fe33ee363261507eb894bbddbb3af5af3642be7f914\",\n    }\n\n\ndef _expected_status(dependencies: Mapping[str, Any]) -> str:\n    material = dependencies[\"v1_dependencies\"][\"material\"]\n    v1_contract = dependencies[\"v1_verifier_contract\"]\n    _require(\n        type(material) is dict and type(v1_contract) is dict,\n        \"v1 approval dependencies differ\",\n    )\n    material_status = material.get(\"status\")\n    contract_status = v1_contract.get(\"status\")\n    if material_status == V1_PENDING_MATERIAL_STATUS:\n        _require(\n            contract_status == V1_PENDING_VERIFIER_STATUS,\n            \"pending v1 material and verifier statuses differ\",\n        )\n        return PENDING_STATUS\n    _require(\n        material_status == V1_APPROVED_MATERIAL_STATUS\n        and contract_status == V1_APPROVED_VERIFIER_STATUS,\n        \"approved v1 material and verifier statuses differ\",\n    )\n    return APPROVED_STATUS\n\n\ndef _build_verifier_contract(dependencies: Mapping[str, Any]) -> dict[str, Any]:\n    v1 = dependencies[\"v1\"]\n    contract: dict[str, Any] = {\n        \"authority\": copy.deepcopy(AUTHORITY),\n        \"format_binding\": copy.deepcopy(FORMAT_BINDING),\n        \"implementation\": _expected_implementation(dependencies),\n        \"manifest_binding\": copy.deepcopy(MANIFEST_BINDING),\n        \"profile\": VERIFIER_PROFILE,\n        \"raw_identity_binding\": _expected_raw_identity_binding(dependencies),\n        \"residual_gates\": list(RESIDUAL_GATES),\n        \"runtime_bindings\": copy.deepcopy(RUNTIME_BINDINGS),\n        \"schema_version\": SCHEMA_VERSION,\n        \"status\": _expected_status(dependencies),\n        \"verification_policy\": copy.deepcopy(VERIFICATION_POLICY),\n        \"verifier_contract_sha256\": None,\n    }\n    contract[\"verifier_contract_sha256\"] = v1._field_self_hash(\n        contract,\n        \"verifier_contract_sha256\",\n    )\n    return validate_verifier_contract(\n        contract,\n        schema=dependencies[\"verifier_schema\"],\n        dependencies=dependencies,\n    )\n\n\ndef build_verifier_contract() -> dict[str, Any]:\n    \"\"\"Build a non-authorizing verifier contract from fixed local inputs.\"\"\"\n\n    return _build_verifier_contract(_load_fixed_dependencies())\n\n\ndef validate_verifier_contract(\n    value: Mapping[str, Any],\n    *,\n    schema: Mapping[str, Any],\n    dependencies: Mapping[str, Any],\n) -> dict[str, Any]:\n    v1 = dependencies[\"v1\"]\n    try:\n        v1._validate_schema(\n            value,\n            schema,\n            schema_name=VERIFIER_SCHEMA_PATH.name,\n            label=\"cache bundle verifier contract\",\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    expected_fields = {\n        \"authority\",\n        \"format_binding\",\n        \"implementation\",\n        \"manifest_binding\",\n        \"profile\",\n        \"raw_identity_binding\",\n        \"residual_gates\",\n        \"runtime_bindings\",\n        \"schema_version\",\n        \"status\",\n        \"verification_policy\",\n        \"verifier_contract_sha256\",\n    }\n    _require(type(value) is dict and set(value) == expected_fields, \"verifier-contract fields differ\")\n    _require(\n        value[\"profile\"] == VERIFIER_PROFILE\n        and value[\"schema_version\"] == SCHEMA_VERSION\n        and value[\"status\"] == _expected_status(dependencies),\n        \"verifier-contract identity or status differs\",\n    )\n    _require(value[\"authority\"] == AUTHORITY, \"verifier-contract authority differs\")\n    _require(value[\"format_binding\"] == FORMAT_BINDING, \"verifier-contract format binding differs\")\n    _require(value[\"manifest_binding\"] == MANIFEST_BINDING, \"verifier-contract manifest binding differs\")\n    _require(\n        value[\"raw_identity_binding\"] == _expected_raw_identity_binding(dependencies),\n        \"verifier-contract raw identity binding differs\",\n    )\n    _require(\n        value[\"implementation\"] == _expected_implementation(dependencies),\n        \"verifier-contract implementation binding differs\",\n    )\n    _require(value[\"residual_gates\"] == RESIDUAL_GATES, \"verifier-contract residual gates differ\")\n    _require(value[\"runtime_bindings\"] == RUNTIME_BINDINGS, \"verifier-contract runtime bindings differ\")\n    _require(value[\"verification_policy\"] == VERIFICATION_POLICY, \"verifier-contract policy differs\")\n    self_hash = value[\"verifier_contract_sha256\"]\n    _require(\n        type(self_hash) is str\n        and len(self_hash) == 64\n        and self_hash == v1._field_self_hash(value, \"verifier_contract_sha256\"),\n        \"verifier-contract self hash differs\",\n    )\n    return copy.deepcopy(dict(value))\n\n\ndef _check_verifier_contract(dependencies: Mapping[str, Any]) -> dict[str, Any]:\n    v1 = dependencies[\"v1\"]\n    try:\n        value, raw = v1._read_json(\n            VERIFIER_CONTRACT_PATH,\n            maximum=MAX_VERIFIER_CONTRACT_BYTES,\n            label=\"cache bundle verifier contract\",\n            canonical=True,\n            require_single_link=True,\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    validated = validate_verifier_contract(\n        value,\n        schema=dependencies[\"verifier_schema\"],\n        dependencies=dependencies,\n    )\n    expected = _build_verifier_contract(dependencies)\n    _require(raw == v1._render(expected) and validated == expected, \"checked verifier contract differs\")\n    return validated\n\n\ndef check_verifier_contract() -> dict[str, Any]:\n    \"\"\"Check only the fixed production verifier contract and dependencies.\"\"\"\n\n    return _check_verifier_contract(_load_fixed_dependencies())\n\n\ndef _build_verification_report(\n    *,\n    bundle_identity: Mapping[str, Any],\n    content_summary: Mapping[str, Any],\n    manifest: Mapping[str, Any],\n    manifest_raw: bytes,\n    dependencies: Mapping[str, Any],\n    verifier_contract: Mapping[str, Any],\n) -> dict[str, Any]:\n    material = dependencies[\"v1_dependencies\"][\"material\"]\n    declared = material[\"material\"]\n    contents = manifest[\"contents\"]\n    run_plan = manifest[\"run_plan\"]\n    v1_contract = dependencies[\"v1_verifier_contract\"]\n    _require(\n        all(type(value) is dict for value in (declared, contents, run_plan, v1_contract)),\n        \"verified report inputs differ\",\n    )\n    report: dict[str, Any] = {\n        \"authority\": copy.deepcopy(REPORT_AUTHORITY),\n        \"bindings\": {\n            \"binding_status\": \"same_descriptor_raw_identity_recomputed_against_source_reviewed_v1_material\",\n            \"format_artifact_sha256\": CHECKED_FORMAT_FILE_SHA256,\n            \"format_contract_sha256\": CHECKED_FORMAT_SHA256,\n            \"v1_material_artifact_sha256\": _sha256(dependencies[\"v1_dependencies\"][\"material_raw\"]),\n            \"v1_material_declaration_sha256\": material[\"material_declaration_sha256\"],\n            \"v1_verifier_contract_artifact_sha256\": _sha256(\n                dependencies[\"v1_verifier_contract_raw\"]\n            ),\n            \"v1_verifier_contract_sha256\": v1_contract[\"verifier_contract_sha256\"],\n            \"v2_verifier_contract_sha256\": verifier_contract[\"verifier_contract_sha256\"],\n        },\n        \"bundle\": {\n            \"artifact_file\": declared[\"archive_file\"],\n            \"byte_count\": bundle_identity[\"byte_count\"],\n            \"flags\": 0,\n            \"format_version\": FORMAT_VERSION,\n            \"header_byte_count\": HEADER_BYTES,\n            \"prefix_sha256\": content_summary[\"prefix_sha256\"],\n            \"raw_sha256\": bundle_identity[\"sha256\"],\n            \"record_fixed_byte_count\": RECORD_FIXED_BYTES,\n            \"records_sha256\": content_summary[\"records_sha256\"],\n            \"trailer_byte_count\": TRAILER_BYTES,\n        },\n        \"contents\": {\n            \"all_payload_sha256_verified\": True,\n            \"file_count\": content_summary[\"file_count\"],\n            \"manifest_bijection\": True,\n            \"repository_file_counts\": copy.deepcopy(\n                content_summary[\"repository_file_counts\"]\n            ),\n            \"shared_seed_semantics\": \"one_shared_union_seed_copied_unchanged_to_every_arm\",\n            \"unpacked_byte_count\": content_summary[\"unpacked_byte_count\"],\n        },\n        \"manifest\": {\n            \"artifact_file\": declared[\"manifest_file\"],\n            \"artifact_sha256\": _sha256(manifest_raw),\n            \"inventory_sha256\": contents[\"inventory_sha256\"],\n            \"manifest_sha256\": manifest[\"manifest_sha256\"],\n            \"profile\": manifest[\"profile\"],\n            \"projection_sha256\": _manifest_projection_sha256(manifest),\n            \"run_plan_sha256\": run_plan[\"plan_sha256\"],\n            \"schema_sha256\": MANIFEST_BINDING[\"manifest_schema_sha256\"],\n            \"toolchain_bindings_sha256\": run_plan[\"toolchain_bindings_sha256\"],\n        },\n        \"profile\": REPORT_PROFILE,\n        \"report_sha256\": None,\n        \"safety\": copy.deepcopy(REPORT_SAFETY),\n        \"schema_version\": SCHEMA_VERSION,\n        \"status\": REPORT_STATUS,\n        \"structure\": copy.deepcopy(REPORT_STRUCTURE),\n    }\n    v1 = dependencies[\"v1\"]\n    report[\"report_sha256\"] = v1._field_self_hash(report, \"report_sha256\")\n    return _validate_verification_report(\n        report,\n        schema=dependencies[\"report_schema\"],\n        v1=v1,\n    )\n\n\ndef _validate_verification_report(\n    value: Mapping[str, Any],\n    *,\n    schema: Mapping[str, Any],\n    v1: types.ModuleType,\n) -> dict[str, Any]:\n    try:\n        v1._validate_schema(\n            value,\n            schema,\n            schema_name=REPORT_SCHEMA_PATH.name,\n            label=\"cache bundle verification report\",\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n    expected_fields = {\n        \"authority\",\n        \"bindings\",\n        \"bundle\",\n        \"contents\",\n        \"manifest\",\n        \"profile\",\n        \"report_sha256\",\n        \"safety\",\n        \"schema_version\",\n        \"status\",\n        \"structure\",\n    }\n    _require(type(value) is dict and set(value) == expected_fields, \"verification-report fields differ\")\n    _require(\n        value[\"profile\"] == REPORT_PROFILE\n        and value[\"schema_version\"] == SCHEMA_VERSION\n        and value[\"status\"] == REPORT_STATUS,\n        \"verification-report identity differs\",\n    )\n    _require(value[\"authority\"] == REPORT_AUTHORITY, \"verification-report authority differs\")\n    _require(value[\"safety\"] == REPORT_SAFETY, \"verification-report safety differs\")\n    _require(value[\"structure\"] == REPORT_STRUCTURE, \"verification-report structure differs\")\n    report_hash = value[\"report_sha256\"]\n    _require(\n        type(report_hash) is str\n        and len(report_hash) == 64\n        and report_hash == v1._field_self_hash(value, \"report_sha256\"),\n        \"verification-report self hash differs\",\n    )\n    return copy.deepcopy(dict(value))\n\n\ndef _verify_with_dependencies(\n    manifest_path: pathlib.Path,\n    bundle_path: pathlib.Path,\n    *,\n    dependencies: Mapping[str, Any],\n    verifier_contract: Mapping[str, Any],\n) -> dict[str, Any]:\n    \"\"\"Private synthetic seam; production callers use fixed dependencies.\"\"\"\n\n    v1 = dependencies[\"v1\"]\n    validated_contract = validate_verifier_contract(\n        verifier_contract,\n        schema=dependencies[\"verifier_schema\"],\n        dependencies=dependencies,\n    )\n    material = dependencies[\"v1_dependencies\"][\"material\"]\n    _require(type(material) is dict, \"v1 material dependency differs\")\n    _require(\n        material.get(\"status\") == V1_APPROVED_MATERIAL_STATUS\n        and validated_contract[\"status\"] == APPROVED_STATUS,\n        \"cache bundle material source review is pending; locator access forbidden\",\n    )\n\n    declared = material.get(\"material\")\n    _require(type(declared) is dict, \"approved v1 material identities differ\")\n    declared_map = cast(dict[str, Any], declared)\n    _require(\n        manifest_path.name == declared_map[\"manifest_file\"]\n        and bundle_path.name == declared_map[\"archive_file\"],\n        \"cache bundle locator filename differs from reviewed identity\",\n    )\n    try:\n        manifest, manifest_raw = v1._read_json(\n            manifest_path,\n            maximum=MAX_FIXED_JSON_BYTES,\n            label=\"reviewed cache manifest\",\n            canonical=True,\n            require_single_link=True,\n        )\n        _require(\n            _sha256(manifest_raw) == declared_map[\"manifest_file_sha256\"],\n            \"cache manifest raw hash differs from reviewed material\",\n        )\n        validated_manifest = v1._validate_manifest_identity(\n            manifest,\n            schema=dependencies[\"v1_dependencies\"][\"manifest_schema\"],\n            material=material,\n        )\n        _validate_bundle_path_policy(validated_manifest)\n        descriptor, directories = v1._open_regular_descriptor(\n            bundle_path,\n            label=\"reviewed cache bundle\",\n        )\n    except v1.CacheArchiveVerificationError as exc:\n        raise CacheBundleVerificationError(str(exc)) from exc\n\n    try:\n        bundle_identity, bundle_stat = _raw_identity_pass(\n            descriptor,\n            expected_byte_count=declared_map[\"archive_byte_count\"],\n            expected_sha256=declared_map[\"archive_sha256\"],\n        )\n        content_summary = _parse_content_pass(\n            descriptor,\n            bundle_stat=bundle_stat,\n            manifest=validated_manifest,\n            format_contract=dependencies[\"format\"],\n        )\n    finally:\n        os.close(descriptor)\n        for current in reversed(directories):\n            os.close(current)\n    return _build_verification_report(\n        bundle_identity=bundle_identity,\n        content_summary=content_summary,\n        manifest=validated_manifest,\n        manifest_raw=manifest_raw,\n        dependencies=dependencies,\n        verifier_contract=validated_contract,\n    )\n\n\ndef verify_bundle_files(\n    manifest_path: pathlib.Path,\n    bundle_path: pathlib.Path,\n) -> dict[str, Any]:\n    \"\"\"Verify reviewed bundle contents without extracting, staging, or executing.\"\"\"\n\n    dependencies = _load_fixed_dependencies()\n    verifier_contract = _check_verifier_contract(dependencies)\n    material = dependencies[\"v1_dependencies\"][\"material\"]\n    _require(\n        type(material) is dict and material.get(\"status\") == V1_APPROVED_MATERIAL_STATUS,\n        \"cache bundle material source review is pending; locator access forbidden\",\n    )\n    return _verify_with_dependencies(\n        manifest_path,\n        bundle_path,\n        dependencies=dependencies,\n        verifier_contract=verifier_contract,\n    )\n\n\ndef _write_atomic(path: pathlib.Path, value: Mapping[str, Any]) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    descriptor, temporary_name = tempfile.mkstemp(\n        prefix=f\".{path.name}.\",\n        dir=path.parent,\n    )\n    temporary = pathlib.Path(temporary_name)\n    try:\n        os.fchmod(descriptor, 0o644)\n        with os.fdopen(descriptor, \"wb\") as handle:\n            handle.write(_checked_v1()._render(value))\n            handle.flush()\n            os.fsync(handle.fileno())\n        os.replace(temporary, path)\n    finally:\n        temporary.unlink(missing_ok=True)\n\n\ndef _parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(description=__doc__)\n    commands = parser.add_subparsers(dest=\"command\", required=True)\n    build = commands.add_parser(\"build\", help=\"build the non-authorizing verifier contract\")\n    build.add_argument(\"--output\", required=True, type=pathlib.Path)\n    commands.add_parser(\"check\", help=\"check the fixed verifier contract and dependencies\")\n    verify = commands.add_parser(\"verify\", help=\"verify reviewed bundle contents without staging\")\n    verify.add_argument(\"manifest\", type=pathlib.Path)\n    verify.add_argument(\"bundle\", type=pathlib.Path)\n    return parser\n\n\ndef main(argv: Sequence[str] | None = None) -> int:\n    parser = _parser()\n    args = parser.parse_args(argv)\n    try:\n        if args.command == \"build\":\n            _write_atomic(args.output, build_verifier_contract())\n        elif args.command == \"check\":\n            contract = check_verifier_contract()\n            print(\n                json.dumps(\n                    {\n                        \"execution_authority\": False,\n                        \"profile\": contract[\"profile\"],\n                        \"status\": contract[\"status\"],\n                    },\n                    separators=(\",\", \":\"),\n                    sort_keys=True,\n                )\n            )\n        else:\n            report = verify_bundle_files(args.manifest, args.bundle)\n            print(_checked_v1()._canonical_bytes(report).decode(\"utf-8\"))\n    except CacheBundleVerificationError as exc:\n        parser.error(str(exc))\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"},"started_at_ms":1789839306596,"completed_at_ms":1789839306596}}
{"timestamp":"2026-09-19T17:35:06.652Z","ordinal":7405,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0babc-6f9c-7d41-918f-d2bce5276d18","call_id":"call_VEvGtpmYugwQ3jT16PEN8roe","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"683c82\",\"wall_time_seconds\":0.000002791,\"exit_code\":0,\"original_token_count\":5255,\"output\":\"        )\\n        for schema, path, label in (\\n            (format_schema, FORMAT_SCHEMA_PATH, \\\"cache bundle format\\\"),\\n            (report_schema, REPORT_SCHEMA_PATH, \\\"cache bundle verification report\\\"),\\n            (verifier_schema, VERIFIER_SCHEMA_PATH, \\\"cache bundle verifier contract\\\"),\\n        ):\\n            v1._audit_schema(schema, schema_name=path.name, label=label)\\n        format_contract, format_raw = v1._read_json(\\n            FORMAT_PATH,\\n            maximum=v1.MAX_FIXED_JSON_BYTES,\\n            label=\\\"cache bundle format contract\\\",\\n            canonical=True,\\n        )\\n    except v1.CacheArchiveVerificationError as exc:\\n        raise CacheBundleVerificationError(str(exc)) from exc\\n    _require(_sha256(format_raw) == CHECKED_FORMAT_FILE_SHA256, \\\"format-contract raw hash differs\\\")\\n    validated_format = _validate_format_contract(format_contract, schema=format_schema, v1=v1)\\n    return {\\n        \\\"format\\\": validated_format,\\n        \\\"format_raw\\\": format_raw,\\n        \\\"format_schema\\\": format_schema,\\n        \\\"format_schema_raw\\\": format_schema_raw,\\n        \\\"report_schema\\\": report_schema,\\n        \\\"report_schema_raw\\\": report_schema_raw,\\n        \\\"v1\\\": v1,\\n        \\\"v1_dependencies\\\": v1_dependencies,\\n        \\\"v1_verifier_contract\\\": v1_verifier_contract,\\n        \\\"v1_verifier_contract_raw\\\": v1_verifier_contract_raw,\\n        \\\"verifier_schema\\\": verifier_schema,\\n        \\\"verifier_schema_raw\\\": verifier_schema_raw,\\n    }\\n\\n\\ndef _expected_implementation(dependencies: Mapping[str, Any]) -> dict[str, Any]:\\n    v1 = dependencies[\\\"v1\\\"]\\n    try:\\n        source_raw = v1._read_bounded(\\n            pathlib.Path(__file__),\\n            maximum=MAX_SOURCE_BYTES,\\n            label=\\\"cache bundle verifier source\\\",\\n            require_single_link=True,\\n        )\\n    except v1.CacheArchiveVerificationError as exc:\\n        raise CacheBundleVerificationError(str(exc)) from exc\\n    v1_dependencies = dependencies[\\\"v1_dependencies\\\"]\\n    _require(type(v1_dependencies) is dict, \\\"v1 fixed dependencies differ\\\")\\n    return {\\n        \\\"builder\\\": _file_binding(pathlib.Path(__file__), source_raw),\\n        \\\"draft202012_validator\\\": copy.deepcopy(v1_dependencies[\\\"draft_validator\\\"]),\\n        \\\"format_artifact\\\": _file_binding(FORMAT_PATH, dependencies[\\\"format_raw\\\"]),\\n        \\\"format_schema\\\": _file_binding(FORMAT_SCHEMA_PATH, dependencies[\\\"format_schema_raw\\\"]),\\n        \\\"manifest_schema\\\": _file_binding(\\n            pathlib.Path(\\\"offline-go-cache-seed-manifest-v1.schema.json\\\"),\\n            v1_dependencies[\\\"manifest_schema_raw\\\"],\\n        ),\\n        \\\"report_schema\\\": _file_binding(REPORT_SCHEMA_PATH, dependencies[\\\"report_schema_raw\\\"]),\\n        \\\"v1_raw_verifier_source\\\": _file_binding(V1_SOURCE_PATH, _read_checked_v1_source()),\\n        \\\"verifier_contract_schema\\\": _file_binding(\\n            VERIFIER_SCHEMA_PATH,\\n            dependencies[\\\"verifier_schema_raw\\\"],\\n        ),\\n    }\\n\\n\\ndef _expected_raw_identity_binding(dependencies: Mapping[str, Any]) -> dict[str, Any]:\\n    v1_dependencies = dependencies[\\\"v1_dependencies\\\"]\\n    material = v1_dependencies[\\\"material\\\"]\\n    v1_contract = dependencies[\\\"v1_verifier_contract\\\"]\\n    _require(\\n        type(material) is dict and type(v1_contract) is dict,\\n        \\\"v1 raw identity dependencies differ\\\",\\n    )\\n    return {\\n        \\\"v1_material\\\": {\\n            \\\"artifact_file\\\": \\\"negative-control-cache-archive-material-v1.json\\\",\\n            \\\"artifact_sha256\\\": _sha256(v1_dependencies[\\\"material_raw\\\"]),\\n            \\\"material_declaration_sha256\\\": material[\\\"material_declaration_sha256\\\"],\\n            \\\"profile\\\": material[\\\"profile\\\"],\\n            \\\"status\\\": material[\\\"status\\\"],\\n        },\\n        \\\"v1_material_schema_sha256\\\": \\\"1424cd22b5eb057b5794347403780435f95c0428d4f81ff42441e71abc39d5d5\\\",\\n        \\\"v1_raw_verifier_source_sha256\\\": CHECKED_V1_SOURCE_SHA256,\\n        \\\"v1_report_schema_sha256\\\": \\\"5827c78df73b024df32bf2853d412df428e7362e869d5d202b33dac15bbe4e5d\\\",\\n        \\\"v1_verifier_contract\\\": {\\n            \\\"artifact_file\\\": V1_VERIFIER_CONTRACT_PATH.name,\\n            \\\"artifact_sha256\\\": _sha256(dependencies[\\\"v1_verifier_contract_raw\\\"]),\\n            \\\"profile\\\": v1_contract[\\\"profile\\\"],\\n            \\\"status\\\": v1_contract[\\\"status\\\"],\\n            \\\"verifier_contract_sha256\\\": v1_contract[\\\"verifier_contract_sha256\\\"],\\n        },\\n        \\\"v1_verifier_contract_schema_sha256\\\": \\\"c35c0de98dbdcec6744a3fe33ee363261507eb894bbddbb3af5af3642be7f914\\\",\\n    }\\n\\n\\ndef _expected_status(dependencies: Mapping[str, Any]) -> str:\\n    material = dependencies[\\\"v1_dependencies\\\"][\\\"material\\\"]\\n    v1_contract = dependencies[\\\"v1_verifier_contract\\\"]\\n    _require(\\n        type(material) is dict and type(v1_contract) is dict,\\n        \\\"v1 approval dependencies differ\\\",\\n    )\\n    material_status = material.get(\\\"status\\\")\\n    contract_status = v1_contract.get(\\\"status\\\")\\n    if material_status == V1_PENDING_MATERIAL_STATUS:\\n        _require(\\n            contract_status == V1_PENDING_VERIFIER_STATUS,\\n            \\\"pending v1 material and verifier statuses differ\\\",\\n        )\\n        return PENDING_STATUS\\n    _require(\\n        material_status == V1_APPROVED_MATERIAL_STATUS\\n        and contract_status == V1_APPROVED_VERIFIER_STATUS,\\n        \\\"approved v1 material and verifier statuses differ\\\",\\n    )\\n    return APPROVED_STATUS\\n\\n\\ndef _build_verifier_contract(dependencies: Mapping[str, Any]) -> dict[str, Any]:\\n    v1 = dependencies[\\\"v1\\\"]\\n    contract: dict[str, Any] = {\\n        \\\"authority\\\": copy.deepcopy(AUTHORITY),\\n        \\\"format_binding\\\": copy.deepcopy(FORMAT_BINDING),\\n        \\\"implementation\\\": _expected_implementation(dependencies),\\n        \\\"manifest_binding\\\": copy.deepcopy(MANIFEST_BINDING),\\n        \\\"profile\\\": VERIFIER_PROFILE,\\n        \\\"raw_identity_binding\\\": _expected_raw_identity_binding(dependencies),\\n        \\\"residual_gates\\\": list(RESIDUAL_GATES),\\n        \\\"runtime_bindings\\\": copy.deepcopy(RUNTIME_BINDINGS),\\n        \\\"schema_version\\\": SCHEMA_VERSION,\\n        \\\"status\\\": _expected_status(dependencies),\\n        \\\"verification_policy\\\": copy.deepcopy(VERIFICATION_POLICY),\\n        \\\"verifier_contract_sha256\\\": None,\\n    }\\n    contract[\\\"verifier_contract_sha256\\\"] = v1._field_self_hash(\\n        contract,\\n        \\\"verifier_contract_sha256\\\",\\n    )\\n    return validate_verifier_contract(\\n        contract,\\n        schema=dependencies[\\\"verifier_schema\\\"],\\n        dependencies=dependencies,\\n    )\\n\\n\\ndef build_verifier_contract() -> dict[str, Any]:\\n    \\\"\\\"\\\"Build a non-authorizing verifier contract from fixed local inputs.\\\"\\\"\\\"\\n\\n    return _build_verifier_contract(_load_fixed_dependencies())\\n\\n\\ndef validate_verifier_contract(\\n    value: Mapping[str, Any],\\n    *,\\n    schema: Mapping[str, Any],\\n    dependencies: Mapping[str, Any],\\n) -> dict[str, Any]:\\n    v1 = dependencies[\\\"v1\\\"]\\n    try:\\n        v1._validate_schema(\\n            value,\\n            schema,\\n            schema_name=VERIFIER_SCHEMA_PATH.name,\\n            label=\\\"cache bundle verifier contract\\\",\\n        )\\n    except v1.CacheArchiveVerificationError as exc:\\n        raise CacheBundleVerificationError(str(exc)) from exc\\n    expected_fields = {\\n        \\\"authority\\\",\\n        \\\"format_binding\\\",\\n        \\\"implementation\\\",\\n        \\\"manifest_binding\\\",\\n        \\\"profile\\\",\\n        \\\"raw_identity_binding\\\",\\n        \\\"residual_gates\\\",\\n        \\\"runtime_bindings\\\",\\n        \\\"schema_version\\\",\\n        \\\"status\\\",\\n        \\\"verification_policy\\\",\\n        \\\"verifier_contract_sha256\\\",\\n    }\\n    _require(type(value) is dict and set(value) == expected_fields, \\\"verifier-contract fields differ\\\")\\n    _require(\\n        value[\\\"profile\\\"] == VERIFIER_PROFILE\\n        and value[\\\"schema_version\\\"] == SCHEMA_VERSION\\n        and value[\\\"status\\\"] == _expected_status(dependencies),\\n        \\\"verifier-contract identity or status differs\\\",\\n    )\\n    _require(value[\\\"authority\\\"] == AUTHORITY, \\\"verifier-contract authority differs\\\")\\n    _require(value[\\\"format_binding\\\"] == FORMAT_BINDING, \\\"verifier-contract format binding differs\\\")\\n    _require(value[\\\"manifest_binding\\\"] == MANIFEST_BINDING, \\\"verifier-contract manifest binding differs\\\")\\n    _require(\\n        value[\\\"raw_identity_binding\\\"] == _expected_raw_identity_binding(dependencies),\\n        \\\"verifier-contract raw identity binding differs\\\",\\n    )\\n    _require(\\n        value[\\\"implementation\\\"] == _expected_implementation(dependencies),\\n        \\\"verifier-contract implementation binding differs\\\",\\n    )\\n    _require(value[\\\"residual_gates\\\"] == RESIDUAL_GATES, \\\"verifier-contract residual gates differ\\\")\\n    _require(value[\\\"runtime_bindings\\\"] == RUNTIME_BINDINGS, \\\"verifier-contract runtime bindings differ\\\")\\n    _require(value[\\\"verification_policy\\\"] == VERIFICATION_POLICY, \\\"verifier-contract policy differs\\\")\\n    self_hash = value[\\\"verifier_contract_sha256\\\"]\\n    _require(\\n        type(self_hash) is str\\n        and len(self_hash) == 64\\n        and self_hash == v1._field_self_hash(value, \\\"verifier_contract_sha256\\\"),\\n        \\\"verifier-contract self hash differs\\\",\\n    )\\n    return copy.deepcopy(dict(value))\\n\\n\\ndef _check_verifier_contract(dependencies: Mapping[str, Any]) -> dict[str, Any]:\\n    v1 = dependencies[\\\"v1\\\"]\\n    try:\\n        value, raw = v1._read_json(\\n            VERIFIER_CONTRACT_PATH,\\n            maximum=MAX_VERIFIER_CONTRACT_BYTES,\\n            label=\\\"cache bundle verifier contract\\\",\\n            canonical=True,\\n            require_single_link=True,\\n        )\\n    except v1.CacheArchiveVerificationError as exc:\\n        raise CacheBundleVerificationError(str(exc)) from exc\\n    validated = validate_verifier_contract(\\n        value,\\n        schema=dependencies[\\\"verifier_schema\\\"],\\n        dependencies=dependencies,\\n    )\\n    expected = _build_verifier_contract(dependencies)\\n    _require(raw == v1._render(expected) and validated == expected, \\\"checked verifier contract differs\\\")\\n    return validated\\n\\n\\ndef check_verifier_contract() -> dict[str, Any]:\\n    \\\"\\\"\\\"Check only the fixed production verifier contract and dependencies.\\\"\\\"\\\"\\n\\n    return _check_verifier_contract(_load_fixed_dependencies())\\n\\n\\ndef _build_verification_report(\\n    *,\\n    bundle_identity: Mapping[str, Any],\\n    content_summary: Mapping[str, Any],\\n    manifest: Mapping[str, Any],\\n    manifest_raw: bytes,\\n    dependencies: Mapping[str, Any],\\n    verifier_contract: Mapping[str, Any],\\n) -> dict[str, Any]:\\n    material = dependencies[\\\"v1_dependencies\\\"][\\\"material\\\"]\\n    declared = material[\\\"material\\\"]\\n    contents = manifest[\\\"contents\\\"]\\n    run_plan = manifest[\\\"run_plan\\\"]\\n    v1_contract = dependencies[\\\"v1_verifier_contract\\\"]\\n    _require(\\n        all(type(value) is dict for value in (declared, contents, run_plan, v1_contract)),\\n        \\\"verified report inputs differ\\\",\\n    )\\n    report: dict[str, Any] = {\\n        \\\"authority\\\": copy.deepcopy(REPORT_AUTHORITY),\\n        \\\"bindings\\\": {\\n            \\\"binding_status\\\": \\\"same_descriptor_raw_identity_recomputed_against_source_reviewed_v1_material\\\",\\n            \\\"format_artifact_sha256\\\": CHECKED_FORMAT_FILE_SHA256,\\n            \\\"format_contract_sha256\\\": CHECKED_FORMAT_SHA256,\\n            \\\"v1_material_artifact_sha256\\\": _sha256(dependencies[\\\"v1_dependencies\\\"][\\\"material_raw\\\"]),\\n            \\\"v1_material_declaration_sha256\\\": material[\\\"material_declaration_sha256\\\"],\\n            \\\"v1_verifier_contract_artifact_sha256\\\": _sha256(\\n                dependencies[\\\"v1_verifier_contract_raw\\\"]\\n            ),\\n            \\\"v1_verifier_contract_sha256\\\": v1_contract[\\\"verifier_contract_sha256\\\"],\\n            \\\"v2_verifier_contract_sha256\\\": verifier_contract[\\\"verifier_contract_sha256\\\"],\\n        },\\n        \\\"bundle\\\": {\\n            \\\"artifact_file\\\": declared[\\\"archive_file\\\"],\\n            \\\"byte_count\\\": bundle_identity[\\\"byte_count\\\"],\\n            \\\"flags\\\": 0,\\n            \\\"format_version\\\": FORMAT_VERSION,\\n            \\\"header_byte_count\\\": HEADER_BYTES,\\n            \\\"prefix_sha256\\\": content_summary[\\\"prefix_sha256\\\"],\\n            \\\"raw_sha256\\\": bundle_identity[\\\"sha256\\\"],\\n            \\\"record_fixed_byte_count\\\": RECORD_FIXED_BYTES,\\n            \\\"records_sha256\\\": content_summary[\\\"records_sha256\\\"],\\n            \\\"trailer_byte_count\\\": TRAILER_BYTES,\\n        },\\n        \\\"contents\\\": {\\n            \\\"all_payload_sha256_verified\\\": True,\\n            \\\"file_count\\\": content_summary[\\\"file_count\\\"],\\n            \\\"manifest_bijection\\\": True,\\n            \\\"repository_file_counts\\\": copy.deepcopy(\\n                content_summary[\\\"repository_file_counts\\\"]\\n            ),\\n            \\\"shared_seed_semantics\\\": \\\"one_shared_union_seed_copied_unchanged_to_every_arm\\\",\\n            \\\"unpacked_byte_count\\\": content_summary[\\\"unpacked_byte_count\\\"],\\n        },\\n        \\\"manifest\\\": {\\n            \\\"artifact_file\\\": declared[\\\"manifest_file\\\"],\\n            \\\"artifact_sha256\\\": _sha256(manifest_raw),\\n            \\\"inventory_sha256\\\": contents[\\\"inventory_sha256\\\"],\\n            \\\"manifest_sha256\\\": manifest[\\\"manifest_sha256\\\"],\\n            \\\"profile\\\": manifest[\\\"profile\\\"],\\n            \\\"projection_sha256\\\": _manifest_projection_sha256(manifest),\\n            \\\"run_plan_sha256\\\": run_plan[\\\"plan_sha256\\\"],\\n            \\\"schema_sha256\\\": MANIFEST_BINDING[\\\"manifest_schema_sha256\\\"],\\n            \\\"toolchain_bindings_sha256\\\": run_plan[\\\"toolchain_bindings_sha256\\\"],\\n        },\\n        \\\"profile\\\": REPORT_PROFILE,\\n        \\\"report_sha256\\\": None,\\n        \\\"safety\\\": copy.deepcopy(REPORT_SAFETY),\\n        \\\"schema_version\\\": SCHEMA_VERSION,\\n        \\\"status\\\": REPORT_STATUS,\\n        \\\"structure\\\": copy.deepcopy(REPORT_STRUCTURE),\\n    }\\n    v1 = dependencies[\\\"v1\\\"]\\n    report[\\\"report_sha256\\\"] = v1._field_self_hash(report, \\\"report_sha256\\\")\\n    return _validate_verification_report(\\n        report,\\n        schema=dependencies[\\\"report_schema\\\"],\\n        v1=v1,\\n    )\\n\\n\\ndef _validate_verification_report(\\n    value: Mapping[str, Any],\\n    *,\\n    schema: Mapping[str, Any],\\n    v1: types.ModuleType,\\n) -> dict[str, Any]:\\n    try:\\n        v1._validate_schema(\\n            value,\\n            schema,\\n            schema_name=REPORT_SCHEMA_PATH.name,\\n            label=\\\"cache bundle verification report\\\",\\n        )\\n    except v1.CacheArchiveVerificationError as exc:\\n        raise CacheBundleVerificationError(str(exc)) from exc\\n    expected_fields = {\\n        \\\"authority\\\",\\n        \\\"bindings\\\",\\n        \\\"bundle\\\",\\n        \\\"contents\\\",\\n        \\\"manifest\\\",\\n        \\\"profile\\\",\\n        \\\"report_sha256\\\",\\n        \\\"safety\\\",\\n        \\\"schema_version\\\",\\n        \\\"status\\\",\\n        \\\"structure\\\",\\n    }\\n    _require(type(value) is dict and set(value) == expected_fields, \\\"verification-report fields differ\\\")\\n    _require(\\n        value[\\\"profile\\\"] == REPORT_PROFILE\\n        and value[\\\"schema_version\\\"] == SCHEMA_VERSION\\n        and value[\\\"status\\\"] == REPORT_STATUS,\\n        \\\"verification-report identity differs\\\",\\n    )\\n    _require(value[\\\"authority\\\"] == REPORT_AUTHORITY, \\\"verification-report authority differs\\\")\\n    _require(value[\\\"safety\\\"] == REPORT_SAFETY, \\\"verification-report safety differs\\\")\\n    _require(value[\\\"structure\\\"] == REPORT_STRUCTURE, \\\"verification-report structure differs\\\")\\n    report_hash = value[\\\"report_sha256\\\"]\\n    _require(\\n        type(report_hash) is str\\n        and len(report_hash) == 64\\n        and report_hash == v1._field_self_hash(value, \\\"report_sha256\\\"),\\n        \\\"verification-report self hash differs\\\",\\n    )\\n    return copy.deepcopy(dict(value))\\n\\n\\ndef _verify_with_dependencies(\\n    manifest_path: pathlib.Path,\\n    bundle_path: pathlib.Path,\\n    *,\\n    dependencies: Mapping[str, Any],\\n    verifier_contract: Mapping[str, Any],\\n) -> dict[str, Any]:\\n    \\\"\\\"\\\"Private synthetic seam; production callers use fixed dependencies.\\\"\\\"\\\"\\n\\n    v1 = dependencies[\\\"v1\\\"]\\n    validated_contract = validate_verifier_contract(\\n        verifier_contract,\\n        schema=dependencies[\\\"verifier_schema\\\"],\\n        dependencies=dependencies,\\n    )\\n    material = dependencies[\\\"v1_dependencies\\\"][\\\"material\\\"]\\n    _require(type(material) is dict, \\\"v1 material dependency differs\\\")\\n    _require(\\n        material.get(\\\"status\\\") == V1_APPROVED_MATERIAL_STATUS\\n        and validated_contract[\\\"status\\\"] == APPROVED_STATUS,\\n        \\\"cache bundle material source review is pending; locator access forbidden\\\",\\n    )\\n\\n    declared = material.get(\\\"material\\\")\\n    _require(type(declared) is dict, \\\"approved v1 material identities differ\\\")\\n    declared_map = cast(dict[str, Any], declared)\\n    _require(\\n        manifest_path.name == declared_map[\\\"manifest_file\\\"]\\n        and bundle_path.name == declared_map[\\\"archive_file\\\"],\\n        \\\"cache bundle locator filename differs from reviewed identity\\\",\\n    )\\n    try:\\n        manifest, manifest_raw = v1._read_json(\\n            manifest_path,\\n            maximum=MAX_FIXED_JSON_BYTES,\\n            label=\\\"reviewed cache manifest\\\",\\n            canonical=True,\\n            require_single_link=True,\\n        )\\n        _require(\\n            _sha256(manifest_raw) == declared_map[\\\"manifest_file_sha256\\\"],\\n            \\\"cache manifest raw hash differs from reviewed material\\\",\\n        )\\n        validated_manifest = v1._validate_manifest_identity(\\n            manifest,\\n            schema=dependencies[\\\"v1_dependencies\\\"][\\\"manifest_schema\\\"],\\n            material=material,\\n        )\\n        _validate_bundle_path_policy(validated_manifest)\\n        descriptor, directories = v1._open_regular_descriptor(\\n            bundle_path,\\n            label=\\\"reviewed cache bundle\\\",\\n        )\\n    except v1.CacheArchiveVerificationError as exc:\\n        raise CacheBundleVerificationError(str(exc)) from exc\\n\\n    try:\\n        bundle_identity, bundle_stat = _raw_identity_pass(\\n            descriptor,\\n            expected_byte_count=declared_map[\\\"archive_byte_count\\\"],\\n            expected_sha256=declared_map[\\\"archive_sha256\\\"],\\n        )\\n        content_summary = _parse_content_pass(\\n            descriptor,\\n            bundle_stat=bundle_stat,\\n            manifest=validated_manifest,\\n            format_contract=dependencies[\\\"format\\\"],\\n        )\\n    finally:\\n        os.close(descriptor)\\n        for current in reversed(directories):\\n            os.close(current)\\n    return _build_verification_report(\\n        bundle_identity=bundle_identity,\\n        content_summary=content_summary,\\n        manifest=validated_manifest,\\n        manifest_raw=manifest_raw,\\n        dependencies=dependencies,\\n        verifier_contract=validated_contract,\\n    )\\n\\n\\ndef verify_bundle_files(\\n    manifest_path: pathlib.Path,\\n    bundle_path: pathlib.Path,\\n) -> dict[str, Any]:\\n    \\\"\\\"\\\"Verify reviewed bundle contents without extracting, staging, or executing.\\\"\\\"\\\"\\n\\n    dependencies = _load_fixed_dependencies()\\n    verifier_contract = _check_verifier_contract(dependencies)\\n    material = dependencies[\\\"v1_dependencies\\\"][\\\"material\\\"]\\n    _require(\\n        type(material) is dict and material.get(\\\"status\\\") == V1_APPROVED_MATERIAL_STATUS,\\n        \\\"cache bundle material source review is pending; locator access forbidden\\\",\\n    )\\n    return _verify_with_dependencies(\\n        manifest_path,\\n        bundle_path,\\n        dependencies=dependencies,\\n        verifier_contract=verifier_contract,\\n    )\\n\\n\\ndef _write_atomic(path: pathlib.Path, value: Mapping[str, Any]) -> None:\\n    path.parent.mkdir(parents=True, exist_ok=True)\\n    descriptor, temporary_name = tempfile.mkstemp(\\n        prefix=f\\\".{path.name}.\\\",\\n        dir=path.parent,\\n    )\\n    temporary = pathlib.Path(temporary_name)\\n    try:\\n        os.fchmod(descriptor, 0o644)\\n        with os.fdopen(descriptor, \\\"wb\\\") as handle:\\n            handle.write(_checked_v1()._render(value))\\n            handle.flush()\\n            os.fsync(handle.fileno())\\n        os.replace(temporary, path)\\n    finally:\\n        temporary.unlink(missing_ok=True)\\n\\n\\ndef _parser() -> argparse.ArgumentParser:\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    commands = parser.add_subparsers(dest=\\\"command\\\", required=True)\\n    build = commands.add_parser(\\\"build\\\", help=\\\"build the non-authorizing verifier contract\\\")\\n    build.add_argument(\\\"--output\\\", required=True, type=pathlib.Path)\\n    commands.add_parser(\\\"check\\\", help=\\\"check the fixed verifier contract and dependencies\\\")\\n    verify = commands.add_parser(\\\"verify\\\", help=\\\"verify reviewed bundle contents without staging\\\")\\n    verify.add_argument(\\\"manifest\\\", type=pathlib.Path)\\n    verify.add_argument(\\\"bundle\\\", type=pathlib.Path)\\n    return parser\\n\\n\\ndef main(argv: Sequence[str] | None = None) -> int:\\n    parser = _parser()\\n    args = parser.parse_args(argv)\\n    try:\\n        if args.command == \\\"build\\\":\\n            _write_atomic(args.output, build_verifier_contract())\\n        elif args.command == \\\"check\\\":\\n            contract = check_verifier_contract()\\n            print(\\n                json.dumps(\\n                    {\\n                        \\\"execution_authority\\\": False,\\n                        \\\"profile\\\": contract[\\\"profile\\\"],\\n                        \\\"status\\\": contract[\\\"status\\\"],\\n                    },\\n                    separators=(\\\",\\\", \\\":\\\"),\\n                    sort_keys=True,\\n                )\\n            )\\n        else:\\n            report = verify_bundle_files(args.manifest, args.bundle)\\n            print(_checked_v1()._canonical_bytes(report).decode(\\\"utf-8\\\"))\\n    except CacheBundleVerificationError as exc:\\n        parser.error(str(exc))\\n    return 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    raise SystemExit(main())\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839306.652708}}}
