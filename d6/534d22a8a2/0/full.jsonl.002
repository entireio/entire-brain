pathlib.Path('benchmarks/agent-brain/confirmatory').glob('*.md')}\nfor x in r:\n if x['path'] in names:\n  x['review_status']='source-inspected';x['checks'].append('Complete document read; reviewed input/authority boundaries, schema and dependency claims, experiment design, failure behavior, reproducibility.');x['notes']='Pending contracts remain explicitly non-authorizing; code-level defects recorded separately, including F4/F98/F99/F100. Ordinary check_protocol now fails stale source bindings and missing legacy calibration path.'\np.write_text(json.dumps(r,indent=2)+'\\n')\nfor name in ['audit-protocol-check.txt','audit-all-task-lint.txt','audit-assets-graph.json','audit-asset-brain.json']:shutil.copyfile('/tmp/'+name,b/'evidence'/name)\nd=json.load(open('/tmp/audit-all-task-lint.txt'));print('lint keys',list(d));print('summary',d.get('summary'));print('inspected',sum(x['review_status']=='source-inspected' for x in r));print('pending doc count',sum(x['category']=='documentation' and x['review_status']!='source-inspected' for x in r))\nPY"}],"source":"unified_exec_startup","status":"completed","stdout":"lint keys ['errors', 'ok', 'schema_version', 'tasks']\nsummary None\ninspected 979\npending doc count 51\n","stderr":"","aggregated_output":"lint keys ['errors', 'ok', 'schema_version', 'tasks']\nsummary None\ninspected 979\npending doc count 51\n","exit_code":0,"duration":{"secs":0,"nanos":2500},"formatted_output":"lint keys ['errors', 'ok', 'schema_version', 'tasks']\nsummary None\ninspected 979\npending doc count 51\n"},"started_at_ms":1789840400783,"completed_at_ms":1789840400783}}
