ions. No upstream download performed.'\nc.write_text(json.dumps(rows,indent=2)+'\\n')\nPY"],"cwd":"file:///Users/thomi/.codex/worktrees/5d33/entire-brain","parsed_cmd":[{"type":"unknown","cmd":"python3 - <<'PY'\nimport struct,pathlib,math,json,hashlib\np=pathlib.Path('assets/embedmodel.bin');b=p.read_bytes();o=0\ndef take(n):\n global o\n r=b[o:o+n];assert len(r)==n;o+=n;return r\ndef u(fmt):return struct.unpack(fmt,take(struct.calcsize(fmt)))[0]\ndef s():return take(u('<H')).decode('utf8')\nmagic=take(4).decode();v=u('<I');name=s();dim=u('<I');vocab=u('<I');dtype=u('<I');flags=u('<I');unk=u('<I');cont=s();tokens=[s() for _ in range(vocab)];scales=[u('<f') for _ in range(dim)];matrix=take(vocab*dim);assert o==len(b);assert magic=='EBM1' and v==1 and dtype==1 and unk<vocab;assert all(math.isfinite(s) and s>0 for s in scales)\nr=dict(path=str(p),sha256=hashlib.sha256(b).hexdigest(),bytes=len(b),magic=magic,version=v,model=name,dimension=dim,vocabulary=vocab,dtype=dtype,flags=flags,unknown_token=tokens[unk],continuation_prefix=cont,empty_tokens=tokens.count(''),duplicate_tokens=len(tokens)-len(set(tokens)),matrix_bytes=len(matrix),finite_positive_scales=True,exact_EOF=True)\nbase=pathlib.Path('/Users/thomi/.codex/visualizations/2026/09/18/01a0b6ce-e2ad-7853-bb2f-19731062a2c9/code-quality-audit');(base/'evidence/model-asset-validation.json').write_text(json.dumps(r,indent=2)+'\\n');print(json.dumps(r,indent=2))\nc=base/'coverage.json';rows=json.loads(c.read_text())\nfor x in rows:\n if x['path']==str(p):x['review_status']='source-inspected';x['checks'].append('Independent complete EBM1 binary parse: header, UTF-8 token inventory, all float scales, exact matrix length and EOF; existing Go golden parity tests passed in baseline.');x['notes']='Asset identity validated; converter does not pin upstream revision or dependency versions. No upstream download performed.'\nc.write_text(json.dumps(rows,indent=2)+'\\n')\nPY"}],"source":"unified_exec_startup","status":"completed","s