s/agent-brain/confirmatory/integration-logs/analysis-protocol-tests.txt', 5)\\n('benchmarks/agent-brain/confirmatory/integration-logs/engine-identity-tests.txt', 1)\\n('benchmarks/agent-brain/confirmatory/integration-logs/evidence-smoke.txt', 5)\\n('benchmarks/agent-brain/confirmatory/integration-logs/freeze-no-go.txt', 18)\\n('benchmarks/agent-brain/confirmatory/integration-logs/go-test-all.txt', 5)\\n('benchmarks/agent-brain/confirmatory/integration-logs/protocol-preparation.txt', 1)\\n('benchmarks/agent-brain/confirmatory/integration-logs/python-harness.txt', 642)\\n('benchmarks/agent-brain/confirmatory/integration-logs/task-lint.txt', 63)\\n('benchmarks/agent-brain/discovery/phase2-layer-b-20260610/report.md', 88)\\n('benchmarks/agent-brain/evidence/distill-perf-large/README.md', 68)\\n('benchmarks/agent-brain/evidence/distill-perf-large/distill-perf-audit-report.md', 16)\\n('benchmarks/agent-brain/evidence/distill-perf/README.md', 64)\\n('benchmarks/agent-brain/evidence/distill-perf/distill-perf-audit-report.md', 16)\\n('benchmarks/agent-brain/evidence/facts-eval-proof-fixture/README.md', 22)\\n('benchmarks/agent-brain/evidence/facts-eval-proof-fixture/facts-eval-audit-report.md', 25)\\n('benchmarks/agent-brain/evidence/facts-eval/README.md', 109)\\n('benchmarks/agent-brain/evidence/facts-eval/facts-eval-audit-report.md', 19)\\n('benchmarks/agent-brain/evidence/history-delivery-fix/README.md', 173)\\n('benchmarks/agent-brain/evidence/radar-tool/README.md', 19)\\n('benchmarks/agent-brain/evidence/radar-tool/radar-tool-audit-report.md', 13)\\n('benchmarks/agent-brain/evidence/release-matrix/README.md', 18)\\n('benchmarks/agent-brain/evidence/release-matrix/release-matrix-report.md', 28)\\n('benchmarks/agent-brain/evidence/release/README.md', 72)\\n('benchmarks/agent-brain/evidence/release/codex-audit-report.md', 47)\\n('benchmarks/agent-brain/evidence/replay-lab-clean/README.md', 85)\\n('benchmarks/agent-brain/evidence/replay-lab-clean/codex-audit-report.md', 27)