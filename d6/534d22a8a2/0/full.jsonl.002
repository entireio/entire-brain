{"timestamp":"2026-09-19T17:39:07.861Z","ordinal":7498,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","item":{"type":"CommandExecution","id":"exec-a0ea080f-97da-497b-91ff-fddb4abd1ecb","process_id":"22942","command":["/bin/zsh","-lc","sed -n '1101,1612p' benchmarks/agent-brain/confirmatory/relevance_dataset.py"],"cwd":"file:///Users/thomi/.codex/worktrees/5d33/entire-brain","parsed_cmd":[{"type":"read","cmd":"sed -n '1101,1612p' benchmarks/agent-brain/confirmatory/relevance_dataset.py","name":"relevance_dataset.py","path":"benchmarks/agent-brain/confirmatory/relevance_dataset.py"}],"source":"unified_exec_startup","status":"completed","stdout":"            \"task_prompt_sha256\": prompt_hash,\n            \"temporal_cutoff\": cutoff,\n            \"null_query\": null_query,\n            \"task_inventory_state\": state,\n            \"label_evidence\": evidence,\n            \"judgments\": judgments,\n        }\n        if null_query:\n            materialized_item[\"null_closure\"] = closure\n        items.append(materialized_item)\n\n    if not items:\n        raise DatasetError(\"development labels cannot be empty\")\n    if set(null_review_index) != consumed_null_reviews:\n        raise DatasetError(\"null review ledger coverage differs from null labels\")\n    observed_query_sources = {item[\"query_source\"] for item in items}\n    if observed_query_sources != set(QUERY_SOURCES):\n        raise DatasetError(f\"development labels must cover both query sources: {list(QUERY_SOURCES)!r}\")\n    missing_grades = [grade for grade in GRADES if not grade_counts[grade]]\n    if missing_grades:\n        raise DatasetError(f\"development labels do not cover required grades: {missing_grades}\")\n    dataset_id = labels.get(\"dataset_id\")\n    if not isinstance(dataset_id, str) or not dataset_id:\n        raise DatasetError(\"label dataset_id is missing\")\n    created_at = labels.get(\"created_at\")\n    _parse_time(created_at, \"label created_at\")\n    task_count = len({item[\"task_id\"] for item in items})\n    null_query_count = sum(item[\"null_query\"] for item in items)\n    answerable_product_items = [\n        item for item in items\n        if item[\"query_source\"] == \"user_prompt_derived\" and not item[\"null_query\"]\n    ]\n    product_null_items = [\n        item for item in items\n        if item[\"query_source\"] == \"user_prompt_derived\" and item[\"null_query\"]\n    ]\n    return {\n        \"schema_version\": SCHEMA_VERSION,\n        \"dataset_id\": dataset_id,\n        \"status\": \"draft_pending_labels_and_holdout_seal\",\n        \"created_at\": created_at,\n        \"label_policy\": {\n            \"query_sources\": list(QUERY_SOURCES),\n            \"required_judgments\": list(GRADES),\n            \"null_query_closure_required\": True,\n            \"null_query_requirement_for_threshold\": True,\n            \"null_query_coverage_status\": (\n                \"present_corpus_closed\" if null_query_count else \"pending_no_corpus_closed_queries\"\n            ),\n            \"temporal_eligibility_required\": True,\n            \"near_duplicate_cluster_ids_required\": True,\n            \"positive_definition\": [\"solving\", \"relevant_alternative\"],\n            \"fact_hash_definition\": \"sha256(canonical JSON fact record; UTF-8, sorted keys, compact separators)\",\n        },\n        \"development\": {\n            \"item_count\": len(items),\n            \"unique_task_count\": task_count,\n            \"null_query_count\": null_query_count,\n            \"answerable_product_item_count\": len(answerable_product_items),\n            \"unique_answerable_product_task_count\": len({item[\"task_id\"] for item in answerable_product_items}),\n            \"product_null_query_count\": len(product_null_items),\n            \"judgment_count\": sum(grade_counts.values()),\n            \"grade_counts\": {grade: grade_counts[grade] for grade in GRADES},\n            \"evidence_counts\": {evidence: evidence_counts[evidence] for evidence in EVIDENCE_TYPES},\n            \"source_facts_sha256\": snapshot[\"source_facts_sha256\"],\n            \"source_session_dates_sha256\": snapshot[\"source_session_dates_sha256\"],\n            \"source_active_fact_count\": snapshot[\"source_active_fact_count\"],\n            \"source_active_fact_catalog_sha256\": snapshot[\"source_active_fact_catalog_sha256\"],\n            \"snapshot_facts_sha256\": snapshot[\"facts_sha256\"],\n            \"snapshot_session_dates_sha256\": snapshot[\"session_dates_sha256\"],\n            \"labels_sha256\": sha256_bytes(labels_path.read_bytes()),\n            \"fact_snapshot_sha256\": sha256_bytes(snapshot_path.read_bytes()),\n            \"items\": items,\n        },\n        \"sealed_holdout\": {\n            \"item_count\": 0,\n            \"unique_task_count\": 0,\n            \"commitment_sha256\": None,\n            \"sealed_at\": None,\n            \"opened_at\": None,\n            \"items\": [],\n        },\n    }\n\n\ndef validate_dataset(dataset: dict[str, Any], expected: dict[str, Any]) -> None:\n    if canonical_json(dataset) != canonical_json(expected):\n        raise DatasetError(\"checked-in offline relevance dataset is stale; re-run materialize\")\n    development = dataset.get(\"development\")\n    if not isinstance(development, dict):\n        raise DatasetError(\"development section is missing\")\n    items = development.get(\"items\")\n    if not isinstance(items, list):\n        raise DatasetError(\"development items are missing\")\n    sealed = dataset.get(\"sealed_holdout\")\n    if sealed != {\n        \"item_count\": 0,\n        \"unique_task_count\": 0,\n        \"commitment_sha256\": None,\n        \"sealed_at\": None,\n        \"opened_at\": None,\n        \"items\": [],\n    }:\n        raise DatasetError(\"sealed holdout must remain unopened and empty during development labeling\")\n\n\ndef _schema_type_matches(value: Any, expected_type: str) -> bool:\n    return {\n        \"object\": isinstance(value, dict),\n        \"array\": isinstance(value, list),\n        \"string\": isinstance(value, str),\n        \"integer\": isinstance(value, int) and not isinstance(value, bool),\n        \"number\": isinstance(value, (int, float)) and not isinstance(value, bool),\n        \"boolean\": isinstance(value, bool),\n        \"null\": value is None,\n    }.get(expected_type, False)\n\n\ndef validate_schema_instance(value: Any, schema: dict[str, Any], label: str) -> list[str]:\n    \"\"\"Validate the JSON-Schema subset used by the relevance artifacts.\"\"\"\n    errors: list[str] = []\n\n    def resolve(reference: str) -> dict[str, Any] | None:\n        if not reference.startswith(\"#/\"):\n            return None\n        current: Any = schema\n        for part in reference[2:].split(\"/\"):\n            if not isinstance(current, dict) or part not in current:\n                return None\n            current = current[part]\n        return current if isinstance(current, dict) else None\n\n    def walk(instance: Any, rule: dict[str, Any], path: str) -> None:\n        reference = rule.get(\"$ref\")\n        if reference is not None:\n            target = resolve(reference) if isinstance(reference, str) else None\n            if target is None:\n                errors.append(f\"{label}{path}: unresolved schema reference {reference!r}\")\n                return\n            walk(instance, target, path)\n            return\n        if \"const\" in rule and instance != rule[\"const\"]:\n            errors.append(f\"{label}{path}: value differs from schema const\")\n        if \"enum\" in rule and instance not in rule[\"enum\"]:\n            errors.append(f\"{label}{path}: value is outside schema enum\")\n        expected = rule.get(\"type\")\n        if expected is not None:\n            expected_types = expected if isinstance(expected, list) else [expected]\n            if not all(isinstance(item, str) for item in expected_types) or not any(\n                _schema_type_matches(instance, item) for item in expected_types\n            ):\n                errors.append(f\"{label}{path}: value has wrong schema type\")\n                return\n        if isinstance(instance, dict):\n            required = rule.get(\"required\", [])\n            if isinstance(required, list):\n                for field in required:\n                    if field not in instance:\n                        errors.append(f\"{label}{path}: missing schema-required field {field}\")\n            properties = rule.get(\"properties\", {})\n            if not isinstance(properties, dict):\n                properties = {}\n            for field, child in properties.items():\n                if field in instance and isinstance(child, dict):\n                    walk(instance[field], child, f\"{path}.{field}\")\n            extras = set(instance) - set(properties)\n            additional = rule.get(\"additionalProperties\", True)\n            if additional is False:\n                for field in sorted(extras):\n                    errors.append(f\"{label}{path}: schema prohibits field {field}\")\n            elif isinstance(additional, dict):\n                for field in sorted(extras):\n                    walk(instance[field], additional, f\"{path}.{field}\")\n        if isinstance(instance, list):\n            minimum_items = rule.get(\"minItems\")\n            if isinstance(minimum_items, int) and len(instance) < minimum_items:\n                errors.append(f\"{label}{path}: array is shorter than schema minItems\")\n            if rule.get(\"uniqueItems\") is True:\n                encoded = [canonical_json(item) for item in instance]\n                if len(encoded) != len(set(encoded)):\n                    errors.append(f\"{label}{path}: array violates schema uniqueItems\")\n            item_rule = rule.get(\"items\")\n            if isinstance(item_rule, dict):\n                for index, item in enumerate(instance):\n                    walk(item, item_rule, f\"{path}[{index}]\")\n        if isinstance(instance, str):\n            minimum_length = rule.get(\"minLength\")\n            if isinstance(minimum_length, int) and len(instance) < minimum_length:\n                errors.append(f\"{label}{path}: string is shorter than schema minLength\")\n            pattern = rule.get(\"pattern\")\n            if isinstance(pattern, str) and re.search(pattern, instance) is None:\n                errors.append(f\"{label}{path}: string does not match schema pattern\")\n            if rule.get(\"format\") == \"date-time\":\n                try:\n                    _parse_time(instance, f\"{label}{path}\")\n                except DatasetError as exc:\n                    errors.append(str(exc))\n        minimum = rule.get(\"minimum\")\n        if isinstance(minimum, (int, float)) and isinstance(instance, (int, float)) and not isinstance(instance, bool):\n            if instance < minimum:\n                errors.append(f\"{label}{path}: number is below schema minimum\")\n\n    walk(value, schema, \"$\")\n    return errors\n\n\ndef validate_relevance_schemas(labels: dict[str, Any], snapshot: dict[str, Any], dataset: dict[str, Any],\n                               schema_dir: pathlib.Path, ledger: dict[str, Any] | None = None) -> list[str]:\n    errors: list[str] = []\n    artifacts: list[tuple[dict[str, Any], str, str]] = [\n        (labels, \"relevance-label-source.schema.json\", \"labels\"),\n        (snapshot, \"relevance-fact-snapshot.schema.json\", \"snapshot\"),\n        (dataset, \"relevance-dataset.schema.json\", \"dataset\"),\n    ]\n    if ledger is not None:\n        artifacts.append((ledger, \"relevance-review-ledger.schema.json\", \"review ledger\"))\n    for artifact, filename, label in artifacts:\n        schema = load_json(schema_dir / filename)\n        if not isinstance(schema, dict):\n            errors.append(f\"{filename}: schema must be an object\")\n            continue\n        if schema.get(\"$schema\") != \"https://json-schema.org/draft/2020-12/schema\":\n            errors.append(f\"{filename}: wrong JSON Schema dialect\")\n        errors.extend(validate_schema_instance(artifact, schema, label))\n    return errors\n\n\ndef _tokens(text: str) -> set[str]:\n    return {token for token in re.findall(r\"[a-z0-9]+\", text.casefold()) if token not in STOPWORDS and len(token) > 1}\n\n\ndef propose(repo: pathlib.Path, inventory_path: pathlib.Path, facts_path: pathlib.Path,\n            session_dates_path: pathlib.Path, limit: int) -> list[dict[str, Any]]:\n    inventory = _load_inventory(inventory_path)\n    facts = load_facts(facts_path)\n    sessions = load_json(session_dates_path)\n    if not isinstance(sessions, dict):\n        raise DatasetError(\"session date map must be an object\")\n    active = [fact for fact in facts if fact.get(\"status\") == \"active\"]\n    document_frequency: Counter[str] = Counter()\n    tokenized: dict[str, set[str]] = {}\n    for fact in active:\n        fact_id = str(fact.get(\"id\") or \"\")\n        tokens = _tokens(\" \".join([str(fact.get(\"text\") or \"\"), \" \".join(fact.get(\"locus\") or [])]))\n        tokenized[fact_id] = tokens\n        document_frequency.update(tokens)\n    output: list[dict[str, Any]] = []\n    for task_id, row in sorted(inventory.items()):\n        if row.get(\"assigned_split\") != \"development\" or row.get(\"state\") not in SAFE_STATES:\n            continue\n        config = _task_config(repo, row)\n        query_text = \" \".join([str(config.get(\"prompt\") or \"\"), *[str(value) for value in config.get(\"brain_queries\") or []]])\n        query_tokens = _tokens(query_text)\n        cutoff = config.get(\"rolling_cutoff_rfc3339\")\n        excluded = set(config.get(\"exclude_session_ids\") or [])\n        candidates: list[tuple[float, dict[str, Any]]] = []\n        for fact in active:\n            if not _eligible(fact, {str(k): str(v) for k, v in sessions.items()}, cutoff, excluded):\n                continue\n            overlap = query_tokens & tokenized[str(fact.get(\"id\") or \"\")]\n            if not overlap:\n                continue\n            score = sum(math.log((len(active) + 1) / (document_frequency[token] + 1)) + 1 for token in overlap)\n            candidates.append((score, fact))\n        candidates.sort(key=lambda pair: (-pair[0], str(pair[1].get(\"id\") or \"\")))\n        output.append({\n            \"task_id\": task_id,\n            \"inventory_state\": row[\"state\"],\n            \"query_text\": config.get(\"prompt\"),\n            \"candidates\": [{\n                \"fact_id\": fact.get(\"id\"),\n                \"kind\": fact.get(\"kind\"),\n                \"score\": round(score, 6),\n                \"text\": fact.get(\"text\"),\n            } for score, fact in candidates[:limit]],\n        })\n    return output\n\n\ndef _render(value: Any) -> str:\n    return json.dumps(value, indent=2, ensure_ascii=False) + \"\\n\"\n\n\ndef _write_or_check(path: pathlib.Path, value: Any, check: bool) -> None:\n    rendered = _render(value)\n    if check:\n        if not path.is_file() or path.read_text() != rendered:\n            raise DatasetError(f\"generated artifact is stale: {path}\")\n    else:\n        path.write_text(rendered)\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=__doc__)\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n    propose_parser = subparsers.add_parser(\"propose\", help=\"rank eligible frozen facts for exposed development prompts\")\n    propose_parser.add_argument(\"--repo\", type=pathlib.Path, default=pathlib.Path.cwd())\n    propose_parser.add_argument(\"--inventory\", type=pathlib.Path, required=True)\n    propose_parser.add_argument(\"--facts\", type=pathlib.Path, required=True)\n    propose_parser.add_argument(\"--session-dates\", type=pathlib.Path, required=True)\n    propose_parser.add_argument(\"--limit\", type=int, default=10)\n\n    bind_parser = subparsers.add_parser(\"bind\", help=\"bind reviewed labels to the full pinned corpus\")\n    bind_parser.add_argument(\"--labels\", type=pathlib.Path, required=True)\n    bind_parser.add_argument(\"--facts\", type=pathlib.Path, required=True)\n    bind_parser.add_argument(\"--session-dates\", type=pathlib.Path, required=True)\n    bind_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    bind_parser.add_argument(\"--check\", action=\"store_true\")\n\n    snapshot_parser = subparsers.add_parser(\"snapshot\", help=\"extract the labeled fact subset from a pinned full corpus\")\n    snapshot_parser.add_argument(\"--labels\", type=pathlib.Path, required=True)\n    snapshot_parser.add_argument(\"--facts\", type=pathlib.Path, required=True)\n    snapshot_parser.add_argument(\"--session-dates\", type=pathlib.Path, required=True)\n    snapshot_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    snapshot_parser.add_argument(\"--check\", action=\"store_true\")\n\n    membership_parser = subparsers.add_parser(\n        \"source-membership\", help=\"build the complete authenticated fact/date membership catalog\"\n    )\n    membership_parser.add_argument(\"--facts\", type=pathlib.Path, required=True)\n    membership_parser.add_argument(\"--session-dates\", type=pathlib.Path, required=True)\n    membership_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    membership_parser.add_argument(\"--check\", action=\"store_true\")\n\n    contract_parser = subparsers.add_parser(\n        \"source-contract\", help=\"build the small reviewed contract that pins a membership catalog\"\n    )\n    contract_parser.add_argument(\"--membership\", type=pathlib.Path, required=True)\n    contract_parser.add_argument(\"--membership-path\", required=True)\n    contract_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    contract_parser.add_argument(\"--check\", action=\"store_true\")\n\n    ledger_parser = subparsers.add_parser(\n        \"review-ledger\", help=\"build retained per-query/per-judgment manual review evidence\"\n    )\n    ledger_parser.add_argument(\"--labels\", type=pathlib.Path, required=True)\n    ledger_parser.add_argument(\"--source-contract\", type=pathlib.Path, required=True)\n    ledger_parser.add_argument(\"--reviewed-at\", required=True)\n    ledger_parser.add_argument(\"--reviewer\", required=True)\n    ledger_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    ledger_parser.add_argument(\"--check\", action=\"store_true\")\n\n    materialize_parser = subparsers.add_parser(\"materialize\", help=\"derive the checked-in dataset from labels and fact snapshot\")\n    materialize_parser.add_argument(\"--repo\", type=pathlib.Path, default=pathlib.Path.cwd())\n    materialize_parser.add_argument(\"--labels\", type=pathlib.Path, required=True)\n    materialize_parser.add_argument(\"--inventory\", type=pathlib.Path, required=True)\n    materialize_parser.add_argument(\"--snapshot\", type=pathlib.Path, required=True)\n    materialize_parser.add_argument(\"--source-membership\", type=pathlib.Path)\n    materialize_parser.add_argument(\"--null-review-ledger\", type=pathlib.Path)\n    materialize_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    materialize_parser.add_argument(\"--check\", action=\"store_true\")\n\n    validate_parser = subparsers.add_parser(\"validate\", help=\"fail if the checked-in dataset differs from its sources\")\n    validate_parser.add_argument(\"--repo\", type=pathlib.Path, default=pathlib.Path.cwd())\n    validate_parser.add_argument(\"--labels\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--inventory\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--snapshot\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--dataset\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--source-contract\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--source-membership\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--review-ledger\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--null-review-ledger\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--null-review-contract\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\n        \"--schemas\",\n        type=pathlib.Path,\n        default=pathlib.Path(__file__).resolve().with_name(\"schemas\"),\n    )\n\n    args = parser.parse_args()\n    try:\n        if args.command == \"propose\":\n            print(_render(propose(args.repo.resolve(), args.inventory, args.facts, args.session_dates, args.limit)), end=\"\")\n        elif args.command == \"bind\":\n            labels = load_json(args.labels)\n            sessions = load_json(args.session_dates)\n            if not isinstance(labels, dict) or not isinstance(sessions, dict):\n                raise DatasetError(\"labels/session dates must be JSON objects\")\n            value = bind_labels(\n                labels,\n                load_facts(args.facts),\n                {str(k): str(v) for k, v in sessions.items()},\n                sha256_bytes(args.facts.read_bytes()),\n                sha256_bytes(args.session_dates.read_bytes()),\n            )\n            _write_or_check(args.output, value, args.check)\n        elif args.command == \"snapshot\":\n            labels = load_json(args.labels)\n            sessions = load_json(args.session_dates)\n            if not isinstance(labels, dict) or not isinstance(sessions, dict):\n                raise DatasetError(\"labels/session dates must be JSON objects\")\n            value = build_snapshot(\n                labels,\n                load_facts(args.facts),\n                {str(k): str(v) for k, v in sessions.items()},\n                sha256_bytes(args.facts.read_bytes()),\n                sha256_bytes(args.session_dates.read_bytes()),\n            )\n            _write_or_check(args.output, value, args.check)\n        elif args.command == \"source-membership\":\n            sessions = load_json(args.session_dates)\n            if not isinstance(sessions, dict):\n                raise DatasetError(\"session dates must be a JSON object\")\n            value = build_source_membership(\n                load_facts(args.facts),\n                {str(k): str(v) for k, v in sessions.items()},\n                sha256_bytes(args.facts.read_bytes()),\n                sha256_bytes(args.session_dates.read_bytes()),\n            )\n            _write_or_check(args.output, value, args.check)\n        elif args.command == \"source-contract\":\n            membership = load_json(args.membership)\n            if not isinstance(membership, dict):\n                raise DatasetError(\"source membership must be a JSON object\")\n            value = build_source_contract(\n                args.membership_path,\n                membership,\n                sha256_bytes(args.membership.read_bytes()),\n            )\n            _write_or_check(args.output, value, args.check)\n        elif args.command == \"review-ledger\":\n            labels = load_json(args.labels)\n            contract = load_json(args.source_contract)\n            if not isinstance(labels, dict) or not isinstance(contract, dict):\n                raise DatasetError(\"labels/source contract must be JSON objects\")\n            value = build_review_ledger(\n                labels,\n                contract,\n                reviewed_at=args.reviewed_at,\n                reviewer=args.reviewer,\n            )\n            _write_or_check(args.output, value, args.check)\n        elif args.command == \"materialize\":\n            membership = load_json(args.source_membership) if args.source_membership else None\n            null_ledger = load_json(args.null_review_ledger) if args.null_review_ledger else None\n            ledger_path = (\n                args.null_review_ledger.resolve().relative_to(args.repo.resolve()).as_posix()\n                if args.null_review_ledger else \"\"\n            )\n            value = materialize(\n                args.repo.resolve(), args.labels, args.inventory, args.snapshot,\n                source_membership=membership if isinstance(membership, dict) else None,\n                null_review_ledger=null_ledger if isinstance(null_ledger, dict) else None,\n                null_review_ledger_path=ledger_path,\n                null_review_ledger_sha256=(\n                    sha256_bytes(args.null_review_ledger.read_bytes()) if args.null_review_ledger else \"\"\n                ),\n            )\n            _write_or_check(args.output, value, args.check)\n        else:\n            labels = load_json(args.labels)\n            snapshot = load_json(args.snapshot)\n            contract = load_json(args.source_contract)\n            membership = load_json(args.source_membership)\n            ledger = load_json(args.review_ledger)\n            null_ledger = load_json(args.null_review_ledger)\n            null_contract = load_json(args.null_review_contract)\n            if not all(isinstance(value, dict) for value in (\n                labels, snapshot, contract, membership, ledger, null_ledger, null_contract\n            )):\n                raise DatasetError(\"relevance validation artifacts must be objects\")\n            null_ledger_path = args.null_review_ledger.resolve().relative_to(args.repo.resolve()).as_posix()\n            null_ledger_sha = sha256_bytes(args.null_review_ledger.read_bytes())\n            value = materialize(\n                args.repo.resolve(), args.labels, args.inventory, args.snapshot,\n                source_membership=membership,\n                null_review_ledger=null_ledger,\n                null_review_ledger_path=null_ledger_path,\n                null_review_ledger_sha256=null_ledger_sha,\n            )\n            dataset = load_json(args.dataset)\n            if not isinstance(dataset, dict):\n                raise DatasetError(\"dataset must be an object\")\n            validate_dataset(dataset, value)\n            validate_source_membership(\n                labels,\n                snapshot,\n                contract,\n                membership,\n                membership_sha256=sha256_bytes(args.source_membership.read_bytes()),\n            )\n            validate_review_ledger(\n                labels,\n                ledger,\n                contract,\n                ledger_path=args.review_ledger.resolve().relative_to(args.repo.resolve()).as_posix(),\n                ledger_sha256=sha256_bytes(args.review_ledger.read_bytes()),\n            )\n            validate_null_review_contract(\n                null_contract,\n                null_ledger,\n                contract,\n                ledger_path=null_ledger_path,\n                ledger_sha256=null_ledger_sha,\n            )\n            schema_errors = validate_relevance_schemas(labels, snapshot, dataset, args.schemas, ledger)\n            if schema_errors:\n                raise DatasetError(\"schema validation failed: \" + \"; \".join(schema_errors))\n            print(\n                f\"relevance development dataset valid: {value['development']['item_count']} queries, \"\n                f\"{value['development']['unique_task_count']} tasks, \"\n                f\"{value['development']['judgment_count']} judgments; sealed holdout unopened\"\n            )\n    except DatasetError as exc:\n        print(f\"ERROR: {exc}\", file=sys.stderr)\n        return 1\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","stderr":"","aggregated_output":"            \"task_prompt_sha256\": prompt_hash,\n            \"temporal_cutoff\": cutoff,\n            \"null_query\": null_query,\n            \"task_inventory_state\": state,\n            \"label_evidence\": evidence,\n            \"judgments\": judgments,\n        }\n        if null_query:\n            materialized_item[\"null_closure\"] = closure\n        items.append(materialized_item)\n\n    if not items:\n        raise DatasetError(\"development labels cannot be empty\")\n    if set(null_review_index) != consumed_null_reviews:\n        raise DatasetError(\"null review ledger coverage differs from null labels\")\n    observed_query_sources = {item[\"query_source\"] for item in items}\n    if observed_query_sources != set(QUERY_SOURCES):\n        raise DatasetError(f\"development labels must cover both query sources: {list(QUERY_SOURCES)!r}\")\n    missing_grades = [grade for grade in GRADES if not grade_counts[grade]]\n    if missing_grades:\n        raise DatasetError(f\"development labels do not cover required grades: {missing_grades}\")\n    dataset_id = labels.get(\"dataset_id\")\n    if not isinstance(dataset_id, str) or not dataset_id:\n        raise DatasetError(\"label dataset_id is missing\")\n    created_at = labels.get(\"created_at\")\n    _parse_time(created_at, \"label created_at\")\n    task_count = len({item[\"task_id\"] for item in items})\n    null_query_count = sum(item[\"null_query\"] for item in items)\n    answerable_product_items = [\n        item for item in items\n        if item[\"query_source\"] == \"user_prompt_derived\" and not item[\"null_query\"]\n    ]\n    product_null_items = [\n        item for item in items\n        if item[\"query_source\"] == \"user_prompt_derived\" and item[\"null_query\"]\n    ]\n    return {\n        \"schema_version\": SCHEMA_VERSION,\n        \"dataset_id\": dataset_id,\n        \"status\": \"draft_pending_labels_and_holdout_seal\",\n        \"created_at\": created_at,\n        \"label_policy\": {\n            \"query_sources\": list(QUERY_SOURCES),\n            \"required_judgments\": list(GRADES),\n            \"null_query_closure_required\": True,\n            \"null_query_requirement_for_threshold\": True,\n            \"null_query_coverage_status\": (\n                \"present_corpus_closed\" if null_query_count else \"pending_no_corpus_closed_queries\"\n            ),\n            \"temporal_eligibility_required\": True,\n            \"near_duplicate_cluster_ids_required\": True,\n            \"positive_definition\": [\"solving\", \"relevant_alternative\"],\n            \"fact_hash_definition\": \"sha256(canonical JSON fact record; UTF-8, sorted keys, compact separators)\",\n        },\n        \"development\": {\n            \"item_count\": len(items),\n            \"unique_task_count\": task_count,\n            \"null_query_count\": null_query_count,\n            \"answerable_product_item_count\": len(answerable_product_items),\n            \"unique_answerable_product_task_count\": len({item[\"task_id\"] for item in answerable_product_items}),\n            \"product_null_query_count\": len(product_null_items),\n            \"judgment_count\": sum(grade_counts.values()),\n            \"grade_counts\": {grade: grade_counts[grade] for grade in GRADES},\n            \"evidence_counts\": {evidence: evidence_counts[evidence] for evidence in EVIDENCE_TYPES},\n            \"source_facts_sha256\": snapshot[\"source_facts_sha256\"],\n            \"source_session_dates_sha256\": snapshot[\"source_session_dates_sha256\"],\n            \"source_active_fact_count\": snapshot[\"source_active_fact_count\"],\n            \"source_active_fact_catalog_sha256\": snapshot[\"source_active_fact_catalog_sha256\"],\n            \"snapshot_facts_sha256\": snapshot[\"facts_sha256\"],\n            \"snapshot_session_dates_sha256\": snapshot[\"session_dates_sha256\"],\n            \"labels_sha256\": sha256_bytes(labels_path.read_bytes()),\n            \"fact_snapshot_sha256\": sha256_bytes(snapshot_path.read_bytes()),\n            \"items\": items,\n        },\n        \"sealed_holdout\": {\n            \"item_count\": 0,\n            \"unique_task_count\": 0,\n            \"commitment_sha256\": None,\n            \"sealed_at\": None,\n            \"opened_at\": None,\n            \"items\": [],\n        },\n    }\n\n\ndef validate_dataset(dataset: dict[str, Any], expected: dict[str, Any]) -> None:\n    if canonical_json(dataset) != canonical_json(expected):\n        raise DatasetError(\"checked-in offline relevance dataset is stale; re-run materialize\")\n    development = dataset.get(\"development\")\n    if not isinstance(development, dict):\n        raise DatasetError(\"development section is missing\")\n    items = development.get(\"items\")\n    if not isinstance(items, list):\n        raise DatasetError(\"development items are missing\")\n    sealed = dataset.get(\"sealed_holdout\")\n    if sealed != {\n        \"item_count\": 0,\n        \"unique_task_count\": 0,\n        \"commitment_sha256\": None,\n        \"sealed_at\": None,\n        \"opened_at\": None,\n        \"items\": [],\n    }:\n        raise DatasetError(\"sealed holdout must remain unopened and empty during development labeling\")\n\n\ndef _schema_type_matches(value: Any, expected_type: str) -> bool:\n    return {\n        \"object\": isinstance(value, dict),\n        \"array\": isinstance(value, list),\n        \"string\": isinstance(value, str),\n        \"integer\": isinstance(value, int) and not isinstance(value, bool),\n        \"number\": isinstance(value, (int, float)) and not isinstance(value, bool),\n        \"boolean\": isinstance(value, bool),\n        \"null\": value is None,\n    }.get(expected_type, False)\n\n\ndef validate_schema_instance(value: Any, schema: dict[str, Any], label: str) -> list[str]:\n    \"\"\"Validate the JSON-Schema subset used by the relevance artifacts.\"\"\"\n    errors: list[str] = []\n\n    def resolve(reference: str) -> dict[str, Any] | None:\n        if not reference.startswith(\"#/\"):\n            return None\n        current: Any = schema\n        for part in reference[2:].split(\"/\"):\n            if not isinstance(current, dict) or part not in current:\n                return None\n            current = current[part]\n        return current if isinstance(current, dict) else None\n\n    def walk(instance: Any, rule: dict[str, Any], path: str) -> None:\n        reference = rule.get(\"$ref\")\n        if reference is not None:\n            target = resolve(reference) if isinstance(reference, str) else None\n            if target is None:\n                errors.append(f\"{label}{path}: unresolved schema reference {reference!r}\")\n                return\n            walk(instance, target, path)\n            return\n        if \"const\" in rule and instance != rule[\"const\"]:\n            errors.append(f\"{label}{path}: value differs from schema const\")\n        if \"enum\" in rule and instance not in rule[\"enum\"]:\n            errors.append(f\"{label}{path}: value is outside schema enum\")\n        expected = rule.get(\"type\")\n        if expected is not None:\n            expected_types = expected if isinstance(expected, list) else [expected]\n            if not all(isinstance(item, str) for item in expected_types) or not any(\n                _schema_type_matches(instance, item) for item in expected_types\n            ):\n                errors.append(f\"{label}{path}: value has wrong schema type\")\n                return\n        if isinstance(instance, dict):\n            required = rule.get(\"required\", [])\n            if isinstance(required, list):\n                for field in required:\n                    if field not in instance:\n                        errors.append(f\"{label}{path}: missing schema-required field {field}\")\n            properties = rule.get(\"properties\", {})\n            if not isinstance(properties, dict):\n                properties = {}\n            for field, child in properties.items():\n                if field in instance and isinstance(child, dict):\n                    walk(instance[field], child, f\"{path}.{field}\")\n            extras = set(instance) - set(properties)\n            additional = rule.get(\"additionalProperties\", True)\n            if additional is False:\n                for field in sorted(extras):\n                    errors.append(f\"{label}{path}: schema prohibits field {field}\")\n            elif isinstance(additional, dict):\n                for field in sorted(extras):\n                    walk(instance[field], additional, f\"{path}.{field}\")\n        if isinstance(instance, list):\n            minimum_items = rule.get(\"minItems\")\n            if isinstance(minimum_items, int) and len(instance) < minimum_items:\n                errors.append(f\"{label}{path}: array is shorter than schema minItems\")\n            if rule.get(\"uniqueItems\") is True:\n                encoded = [canonical_json(item) for item in instance]\n                if len(encoded) != len(set(encoded)):\n                    errors.append(f\"{label}{path}: array violates schema uniqueItems\")\n            item_rule = rule.get(\"items\")\n            if isinstance(item_rule, dict):\n                for index, item in enumerate(instance):\n                    walk(item, item_rule, f\"{path}[{index}]\")\n        if isinstance(instance, str):\n            minimum_length = rule.get(\"minLength\")\n            if isinstance(minimum_length, int) and len(instance) < minimum_length:\n                errors.append(f\"{label}{path}: string is shorter than schema minLength\")\n            pattern = rule.get(\"pattern\")\n            if isinstance(pattern, str) and re.search(pattern, instance) is None:\n                errors.append(f\"{label}{path}: string does not match schema pattern\")\n            if rule.get(\"format\") == \"date-time\":\n                try:\n                    _parse_time(instance, f\"{label}{path}\")\n                except DatasetError as exc:\n                    errors.append(str(exc))\n        minimum = rule.get(\"minimum\")\n        if isinstance(minimum, (int, float)) and isinstance(instance, (int, float)) and not isinstance(instance, bool):\n            if instance < minimum:\n                errors.append(f\"{label}{path}: number is below schema minimum\")\n\n    walk(value, schema, \"$\")\n    return errors\n\n\ndef validate_relevance_schemas(labels: dict[str, Any], snapshot: dict[str, Any], dataset: dict[str, Any],\n                               schema_dir: pathlib.Path, ledger: dict[str, Any] | None = None) -> list[str]:\n    errors: list[str] = []\n    artifacts: list[tuple[dict[str, Any], str, str]] = [\n        (labels, \"relevance-label-source.schema.json\", \"labels\"),\n        (snapshot, \"relevance-fact-snapshot.schema.json\", \"snapshot\"),\n        (dataset, \"relevance-dataset.schema.json\", \"dataset\"),\n    ]\n    if ledger is not None:\n        artifacts.append((ledger, \"relevance-review-ledger.schema.json\", \"review ledger\"))\n    for artifact, filename, label in artifacts:\n        schema = load_json(schema_dir / filename)\n        if not isinstance(schema, dict):\n            errors.append(f\"{filename}: schema must be an object\")\n            continue\n        if schema.get(\"$schema\") != \"https://json-schema.org/draft/2020-12/schema\":\n            errors.append(f\"{filename}: wrong JSON Schema dialect\")\n        errors.extend(validate_schema_instance(artifact, schema, label))\n    return errors\n\n\ndef _tokens(text: str) -> set[str]:\n    return {token for token in re.findall(r\"[a-z0-9]+\", text.casefold()) if token not in STOPWORDS and len(token) > 1}\n\n\ndef propose(repo: pathlib.Path, inventory_path: pathlib.Path, facts_path: pathlib.Path,\n            session_dates_path: pathlib.Path, limit: int) -> list[dict[str, Any]]:\n    inventory = _load_inventory(inventory_path)\n    facts = load_facts(facts_path)\n    sessions = load_json(session_dates_path)\n    if not isinstance(sessions, dict):\n        raise DatasetError(\"session date map must be an object\")\n    active = [fact for fact in facts if fact.get(\"status\") == \"active\"]\n    document_frequency: Counter[str] = Counter()\n    tokenized: dict[str, set[str]] = {}\n    for fact in active:\n        fact_id = str(fact.get(\"id\") or \"\")\n        tokens = _tokens(\" \".join([str(fact.get(\"text\") or \"\"), \" \".join(fact.get(\"locus\") or [])]))\n        tokenized[fact_id] = tokens\n        document_frequency.update(tokens)\n    output: list[dict[str, Any]] = []\n    for task_id, row in sorted(inventory.items()):\n        if row.get(\"assigned_split\") != \"development\" or row.get(\"state\") not in SAFE_STATES:\n            continue\n        config = _task_config(repo, row)\n        query_text = \" \".join([str(config.get(\"prompt\") or \"\"), *[str(value) for value in config.get(\"brain_queries\") or []]])\n        query_tokens = _tokens(query_text)\n        cutoff = config.get(\"rolling_cutoff_rfc3339\")\n        excluded = set(config.get(\"exclude_session_ids\") or [])\n        candidates: list[tuple[float, dict[str, Any]]] = []\n        for fact in active:\n            if not _eligible(fact, {str(k): str(v) for k, v in sessions.items()}, cutoff, excluded):\n                continue\n            overlap = query_tokens & tokenized[str(fact.get(\"id\") or \"\")]\n            if not overlap:\n                continue\n            score = sum(math.log((len(active) + 1) / (document_frequency[token] + 1)) + 1 for token in overlap)\n            candidates.append((score, fact))\n        candidates.sort(key=lambda pair: (-pair[0], str(pair[1].get(\"id\") or \"\")))\n        output.append({\n            \"task_id\": task_id,\n            \"inventory_state\": row[\"state\"],\n            \"query_text\": config.get(\"prompt\"),\n            \"candidates\": [{\n                \"fact_id\": fact.get(\"id\"),\n                \"kind\": fact.get(\"kind\"),\n                \"score\": round(score, 6),\n                \"text\": fact.get(\"text\"),\n            } for score, fact in candidates[:limit]],\n        })\n    return output\n\n\ndef _render(value: Any) -> str:\n    return json.dumps(value, indent=2, ensure_ascii=False) + \"\\n\"\n\n\ndef _write_or_check(path: pathlib.Path, value: Any, check: bool) -> None:\n    rendered = _render(value)\n    if check:\n        if not path.is_file() or path.read_text() != rendered:\n            raise DatasetError(f\"generated artifact is stale: {path}\")\n    else:\n        path.write_text(rendered)\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=__doc__)\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n    propose_parser = subparsers.add_parser(\"propose\", help=\"rank eligible frozen facts for exposed development prompts\")\n    propose_parser.add_argument(\"--repo\", type=pathlib.Path, default=pathlib.Path.cwd())\n    propose_parser.add_argument(\"--inventory\", type=pathlib.Path, required=True)\n    propose_parser.add_argument(\"--facts\", type=pathlib.Path, required=True)\n    propose_parser.add_argument(\"--session-dates\", type=pathlib.Path, required=True)\n    propose_parser.add_argument(\"--limit\", type=int, default=10)\n\n    bind_parser = subparsers.add_parser(\"bind\", help=\"bind reviewed labels to the full pinned corpus\")\n    bind_parser.add_argument(\"--labels\", type=pathlib.Path, required=True)\n    bind_parser.add_argument(\"--facts\", type=pathlib.Path, required=True)\n    bind_parser.add_argument(\"--session-dates\", type=pathlib.Path, required=True)\n    bind_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    bind_parser.add_argument(\"--check\", action=\"store_true\")\n\n    snapshot_parser = subparsers.add_parser(\"snapshot\", help=\"extract the labeled fact subset from a pinned full corpus\")\n    snapshot_parser.add_argument(\"--labels\", type=pathlib.Path, required=True)\n    snapshot_parser.add_argument(\"--facts\", type=pathlib.Path, required=True)\n    snapshot_parser.add_argument(\"--session-dates\", type=pathlib.Path, required=True)\n    snapshot_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    snapshot_parser.add_argument(\"--check\", action=\"store_true\")\n\n    membership_parser = subparsers.add_parser(\n        \"source-membership\", help=\"build the complete authenticated fact/date membership catalog\"\n    )\n    membership_parser.add_argument(\"--facts\", type=pathlib.Path, required=True)\n    membership_parser.add_argument(\"--session-dates\", type=pathlib.Path, required=True)\n    membership_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    membership_parser.add_argument(\"--check\", action=\"store_true\")\n\n    contract_parser = subparsers.add_parser(\n        \"source-contract\", help=\"build the small reviewed contract that pins a membership catalog\"\n    )\n    contract_parser.add_argument(\"--membership\", type=pathlib.Path, required=True)\n    contract_parser.add_argument(\"--membership-path\", required=True)\n    contract_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    contract_parser.add_argument(\"--check\", action=\"store_true\")\n\n    ledger_parser = subparsers.add_parser(\n        \"review-ledger\", help=\"build retained per-query/per-judgment manual review evidence\"\n    )\n    ledger_parser.add_argument(\"--labels\", type=pathlib.Path, required=True)\n    ledger_parser.add_argument(\"--source-contract\", type=pathlib.Path, required=True)\n    ledger_parser.add_argument(\"--reviewed-at\", required=True)\n    ledger_parser.add_argument(\"--reviewer\", required=True)\n    ledger_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    ledger_parser.add_argument(\"--check\", action=\"store_true\")\n\n    materialize_parser = subparsers.add_parser(\"materialize\", help=\"derive the checked-in dataset from labels and fact snapshot\")\n    materialize_parser.add_argument(\"--repo\", type=pathlib.Path, default=pathlib.Path.cwd())\n    materialize_parser.add_argument(\"--labels\", type=pathlib.Path, required=True)\n    materialize_parser.add_argument(\"--inventory\", type=pathlib.Path, required=True)\n    materialize_parser.add_argument(\"--snapshot\", type=pathlib.Path, required=True)\n    materialize_parser.add_argument(\"--source-membership\", type=pathlib.Path)\n    materialize_parser.add_argument(\"--null-review-ledger\", type=pathlib.Path)\n    materialize_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    materialize_parser.add_argument(\"--check\", action=\"store_true\")\n\n    validate_parser = subparsers.add_parser(\"validate\", help=\"fail if the checked-in dataset differs from its sources\")\n    validate_parser.add_argument(\"--repo\", type=pathlib.Path, default=pathlib.Path.cwd())\n    validate_parser.add_argument(\"--labels\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--inventory\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--snapshot\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--dataset\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--source-contract\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--source-membership\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--review-ledger\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--null-review-ledger\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--null-review-contract\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\n        \"--schemas\",\n        type=pathlib.Path,\n        default=pathlib.Path(__file__).resolve().with_name(\"schemas\"),\n    )\n\n    args = parser.parse_args()\n    try:\n        if args.command == \"propose\":\n            print(_render(propose(args.repo.resolve(), args.inventory, args.facts, args.session_dates, args.limit)), end=\"\")\n        elif args.command == \"bind\":\n            labels = load_json(args.labels)\n            sessions = load_json(args.session_dates)\n            if not isinstance(labels, dict) or not isinstance(sessions, dict):\n                raise DatasetError(\"labels/session dates must be JSON objects\")\n            value = bind_labels(\n                labels,\n                load_facts(args.facts),\n                {str(k): str(v) for k, v in sessions.items()},\n                sha256_bytes(args.facts.read_bytes()),\n                sha256_bytes(args.session_dates.read_bytes()),\n            )\n            _write_or_check(args.output, value, args.check)\n        elif args.command == \"snapshot\":\n            labels = load_json(args.labels)\n            sessions = load_json(args.session_dates)\n            if not isinstance(labels, dict) or not isinstance(sessions, dict):\n                raise DatasetError(\"labels/session dates must be JSON objects\")\n            value = build_snapshot(\n                labels,\n                load_facts(args.facts),\n                {str(k): str(v) for k, v in sessions.items()},\n                sha256_bytes(args.facts.read_bytes()),\n                sha256_bytes(args.session_dates.read_bytes()),\n            )\n            _write_or_check(args.output, value, args.check)\n        elif args.command == \"source-membership\":\n            sessions = load_json(args.session_dates)\n            if not isinstance(sessions, dict):\n                raise DatasetError(\"session dates must be a JSON object\")\n            value = build_source_membership(\n                load_facts(args.facts),\n                {str(k): str(v) for k, v in sessions.items()},\n                sha256_bytes(args.facts.read_bytes()),\n                sha256_bytes(args.session_dates.read_bytes()),\n            )\n            _write_or_check(args.output, value, args.check)\n        elif args.command == \"source-contract\":\n            membership = load_json(args.membership)\n            if not isinstance(membership, dict):\n                raise DatasetError(\"source membership must be a JSON object\")\n            value = build_source_contract(\n                args.membership_path,\n                membership,\n                sha256_bytes(args.membership.read_bytes()),\n            )\n            _write_or_check(args.output, value, args.check)\n        elif args.command == \"review-ledger\":\n            labels = load_json(args.labels)\n            contract = load_json(args.source_contract)\n            if not isinstance(labels, dict) or not isinstance(contract, dict):\n                raise DatasetError(\"labels/source contract must be JSON objects\")\n            value = build_review_ledger(\n                labels,\n                contract,\n                reviewed_at=args.reviewed_at,\n                reviewer=args.reviewer,\n            )\n            _write_or_check(args.output, value, args.check)\n        elif args.command == \"materialize\":\n            membership = load_json(args.source_membership) if args.source_membership else None\n            null_ledger = load_json(args.null_review_ledger) if args.null_review_ledger else None\n            ledger_path = (\n                args.null_review_ledger.resolve().relative_to(args.repo.resolve()).as_posix()\n                if args.null_review_ledger else \"\"\n            )\n            value = materialize(\n                args.repo.resolve(), args.labels, args.inventory, args.snapshot,\n                source_membership=membership if isinstance(membership, dict) else None,\n                null_review_ledger=null_ledger if isinstance(null_ledger, dict) else None,\n                null_review_ledger_path=ledger_path,\n                null_review_ledger_sha256=(\n                    sha256_bytes(args.null_review_ledger.read_bytes()) if args.null_review_ledger else \"\"\n                ),\n            )\n            _write_or_check(args.output, value, args.check)\n        else:\n            labels = load_json(args.labels)\n            snapshot = load_json(args.snapshot)\n            contract = load_json(args.source_contract)\n            membership = load_json(args.source_membership)\n            ledger = load_json(args.review_ledger)\n            null_ledger = load_json(args.null_review_ledger)\n            null_contract = load_json(args.null_review_contract)\n            if not all(isinstance(value, dict) for value in (\n                labels, snapshot, contract, membership, ledger, null_ledger, null_contract\n            )):\n                raise DatasetError(\"relevance validation artifacts must be objects\")\n            null_ledger_path = args.null_review_ledger.resolve().relative_to(args.repo.resolve()).as_posix()\n            null_ledger_sha = sha256_bytes(args.null_review_ledger.read_bytes())\n            value = materialize(\n                args.repo.resolve(), args.labels, args.inventory, args.snapshot,\n                source_membership=membership,\n                null_review_ledger=null_ledger,\n                null_review_ledger_path=null_ledger_path,\n                null_review_ledger_sha256=null_ledger_sha,\n            )\n            dataset = load_json(args.dataset)\n            if not isinstance(dataset, dict):\n                raise DatasetError(\"dataset must be an object\")\n            validate_dataset(dataset, value)\n            validate_source_membership(\n                labels,\n                snapshot,\n                contract,\n                membership,\n                membership_sha256=sha256_bytes(args.source_membership.read_bytes()),\n            )\n            validate_review_ledger(\n                labels,\n                ledger,\n                contract,\n                ledger_path=args.review_ledger.resolve().relative_to(args.repo.resolve()).as_posix(),\n                ledger_sha256=sha256_bytes(args.review_ledger.read_bytes()),\n            )\n            validate_null_review_contract(\n                null_contract,\n                null_ledger,\n                contract,\n                ledger_path=null_ledger_path,\n                ledger_sha256=null_ledger_sha,\n            )\n            schema_errors = validate_relevance_schemas(labels, snapshot, dataset, args.schemas, ledger)\n            if schema_errors:\n                raise DatasetError(\"schema validation failed: \" + \"; \".join(schema_errors))\n            print(\n                f\"relevance development dataset valid: {value['development']['item_count']} queries, \"\n                f\"{value['development']['unique_task_count']} tasks, \"\n                f\"{value['development']['judgment_count']} judgments; sealed holdout unopened\"\n            )\n    except DatasetError as exc:\n        print(f\"ERROR: {exc}\", file=sys.stderr)\n        return 1\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"duration":{"secs":0,"nanos":2833},"formatted_output":"            \"task_prompt_sha256\": prompt_hash,\n            \"temporal_cutoff\": cutoff,\n            \"null_query\": null_query,\n            \"task_inventory_state\": state,\n            \"label_evidence\": evidence,\n            \"judgments\": judgments,\n        }\n        if null_query:\n            materialized_item[\"null_closure\"] = closure\n        items.append(materialized_item)\n\n    if not items:\n        raise DatasetError(\"development labels cannot be empty\")\n    if set(null_review_index) != consumed_null_reviews:\n        raise DatasetError(\"null review ledger coverage differs from null labels\")\n    observed_query_sources = {item[\"query_source\"] for item in items}\n    if observed_query_sources != set(QUERY_SOURCES):\n        raise DatasetError(f\"development labels must cover both query sources: {list(QUERY_SOURCES)!r}\")\n    missing_grades = [grade for grade in GRADES if not grade_counts[grade]]\n    if missing_grades:\n        raise DatasetError(f\"development labels do not cover required grades: {missing_grades}\")\n    dataset_id = labels.get(\"dataset_id\")\n    if not isinstance(dataset_id, str) or not dataset_id:\n        raise DatasetError(\"label dataset_id is missing\")\n    created_at = labels.get(\"created_at\")\n    _parse_time(created_at, \"label created_at\")\n    task_count = len({item[\"task_id\"] for item in items})\n    null_query_count = sum(item[\"null_query\"] for item in items)\n    answerable_product_items = [\n        item for item in items\n        if item[\"query_source\"] == \"user_prompt_derived\" and not item[\"null_query\"]\n    ]\n    product_null_items = [\n        item for item in items\n        if item[\"query_source\"] == \"user_prompt_derived\" and item[\"null_query\"]\n    ]\n    return {\n        \"schema_version\": SCHEMA_VERSION,\n        \"dataset_id\": dataset_id,\n        \"status\": \"draft_pending_labels_and_holdout_seal\",\n        \"created_at\": created_at,\n        \"label_policy\": {\n            \"query_sources\": list(QUERY_SOURCES),\n            \"required_judgments\": list(GRADES),\n            \"null_query_closure_required\": True,\n            \"null_query_requirement_for_threshold\": True,\n            \"null_query_coverage_status\": (\n                \"present_corpus_closed\" if null_query_count else \"pending_no_corpus_closed_queries\"\n            ),\n            \"temporal_eligibility_required\": True,\n            \"near_duplicate_cluster_ids_required\": True,\n            \"positive_definition\": [\"solving\", \"relevant_alternative\"],\n            \"fact_hash_definition\": \"sha256(canonical JSON fact record; UTF-8, sorted keys, compact separators)\",\n        },\n        \"development\": {\n            \"item_count\": len(items),\n            \"unique_task_count\": task_count,\n            \"null_query_count\": null_query_count,\n            \"answerable_product_item_count\": len(answerable_product_items),\n            \"unique_answerable_product_task_count\": len({item[\"task_id\"] for item in answerable_product_items}),\n            \"product_null_query_count\": len(product_null_items),\n            \"judgment_count\": sum(grade_counts.values()),\n            \"grade_counts\": {grade: grade_counts[grade] for grade in GRADES},\n            \"evidence_counts\": {evidence: evidence_counts[evidence] for evidence in EVIDENCE_TYPES},\n            \"source_facts_sha256\": snapshot[\"source_facts_sha256\"],\n            \"source_session_dates_sha256\": snapshot[\"source_session_dates_sha256\"],\n            \"source_active_fact_count\": snapshot[\"source_active_fact_count\"],\n            \"source_active_fact_catalog_sha256\": snapshot[\"source_active_fact_catalog_sha256\"],\n            \"snapshot_facts_sha256\": snapshot[\"facts_sha256\"],\n            \"snapshot_session_dates_sha256\": snapshot[\"session_dates_sha256\"],\n            \"labels_sha256\": sha256_bytes(labels_path.read_bytes()),\n            \"fact_snapshot_sha256\": sha256_bytes(snapshot_path.read_bytes()),\n            \"items\": items,\n        },\n        \"sealed_holdout\": {\n            \"item_count\": 0,\n            \"unique_task_count\": 0,\n            \"commitment_sha256\": None,\n            \"sealed_at\": None,\n            \"opened_at\": None,\n            \"items\": [],\n        },\n    }\n\n\ndef validate_dataset(dataset: dict[str, Any], expected: dict[str, Any]) -> None:\n    if canonical_json(dataset) != canonical_json(expected):\n        raise DatasetError(\"checked-in offline relevance dataset is stale; re-run materialize\")\n    development = dataset.get(\"development\")\n    if not isinstance(development, dict):\n        raise DatasetError(\"development section is missing\")\n    items = development.get(\"items\")\n    if not isinstance(items, list):\n        raise DatasetError(\"development items are missing\")\n    sealed = dataset.get(\"sealed_holdout\")\n    if sealed != {\n        \"item_count\": 0,\n        \"unique_task_count\": 0,\n        \"commitment_sha256\": None,\n        \"sealed_at\": None,\n        \"opened_at\": None,\n        \"items\": [],\n    }:\n        raise DatasetError(\"sealed holdout must remain unopened and empty during development labeling\")\n\n\ndef _schema_type_matches(value: Any, expected_type: str) -> bool:\n    return {\n        \"object\": isinstance(value, dict),\n        \"array\": isinstance(value, list),\n        \"string\": isinstance(value, str),\n        \"integer\": isinstance(value, int) and not isinstance(value, bool),\n        \"number\": isinstance(value, (int, float)) and not isinstance(value, bool),\n        \"boolean\": isinstance(value, bool),\n        \"null\": value is None,\n    }.get(expected_type, False)\n\n\ndef validate_schema_instance(value: Any, schema: dict[str, Any], label: str) -> list[str]:\n    \"\"\"Validate the JSON-Schema subset used by the relevance artifacts.\"\"\"\n    errors: list[str] = []\n\n    def resolve(reference: str) -> dict[str, Any] | None:\n        if not reference.startswith(\"#/\"):\n            return None\n        current: Any = schema\n        for part in reference[2:].split(\"/\"):\n            if not isinstance(current, dict) or part not in current:\n                return None\n            current = current[part]\n        return current if isinstance(current, dict) else None\n\n    def walk(instance: Any, rule: dict[str, Any], path: str) -> None:\n        reference = rule.get(\"$ref\")\n        if reference is not None:\n            target = resolve(reference) if isinstance(reference, str) else None\n            if target is None:\n                errors.append(f\"{label}{path}: unresolved schema reference {reference!r}\")\n                return\n            walk(instance, target, path)\n            return\n        if \"const\" in rule and instance != rule[\"const\"]:\n            errors.append(f\"{label}{path}: value differs from schema const\")\n        if \"enum\" in rule and instance not in rule[\"enum\"]:\n            errors.append(f\"{label}{path}: value is outside schema enum\")\n        expected = rule.get(\"type\")\n        if expected is not None:\n            expected_types = expected if isinstance(expected, list) else [expected]\n            if not all(isinstance(item, str) for item in expected_types) or not any(\n                _schema_type_matches(instance, item) for item in expected_types\n            ):\n                errors.append(f\"{label}{path}: value has wrong schema type\")\n                return\n        if isinstance(instance, dict):\n            required = rule.get(\"required\", [])\n            if isinstance(required, list):\n                for field in required:\n                    if field not in instance:\n                        errors.append(f\"{label}{path}: missing schema-required field {field}\")\n            properties = rule.get(\"properties\", {})\n            if not isinstance(properties, dict):\n                properties = {}\n            for field, child in properties.items():\n                if field in instance and isinstance(child, dict):\n                    walk(instance[field], child, f\"{path}.{field}\")\n            extras = set(instance) - set(properties)\n            additional = rule.get(\"additionalProperties\", True)\n            if additional is False:\n                for field in sorted(extras):\n                    errors.append(f\"{label}{path}: schema prohibits field {field}\")\n            elif isinstance(additional, dict):\n                for field in sorted(extras):\n                    walk(instance[field], additional, f\"{path}.{field}\")\n        if isinstance(instance, list):\n            minimum_items = rule.get(\"minItems\")\n            if isinstance(minimum_items, int) and len(instance) < minimum_items:\n                errors.append(f\"{label}{path}: array is shorter than schema minItems\")\n            if rule.get(\"uniqueItems\") is True:\n                encoded = [canonical_json(item) for item in instance]\n                if len(encoded) != len(set(encoded)):\n                    errors.append(f\"{label}{path}: array violates schema uniqueItems\")\n            item_rule = rule.get(\"items\")\n            if isinstance(item_rule, dict):\n                for index, item in enumerate(instance):\n                    walk(item, item_rule, f\"{path}[{index}]\")\n        if isinstance(instance, str):\n            minimum_length = rule.get(\"minLength\")\n            if isinstance(minimum_length, int) and len(instance) < minimum_length:\n                errors.append(f\"{label}{path}: string is shorter than schema minLength\")\n            pattern = rule.get(\"pattern\")\n            if isinstance(pattern, str) and re.search(pattern, instance) is None:\n                errors.append(f\"{label}{path}: string does not match schema pattern\")\n            if rule.get(\"format\") == \"date-time\":\n                try:\n                    _parse_time(instance, f\"{label}{path}\")\n                except DatasetError as exc:\n                    errors.append(str(exc))\n        minimum = rule.get(\"minimum\")\n        if isinstance(minimum, (int, float)) and isinstance(instance, (int, float)) and not isinstance(instance, bool):\n            if instance < minimum:\n                errors.append(f\"{label}{path}: number is below schema minimum\")\n\n    walk(value, schema, \"$\")\n    return errors\n\n\ndef validate_relevance_schemas(labels: dict[str, Any], snapshot: dict[str, Any], dataset: dict[str, Any],\n                               schema_dir: pathlib.Path, ledger: dict[str, Any] | None = None) -> list[str]:\n    errors: list[str] = []\n    artifacts: list[tuple[dict[str, Any], str, str]] = [\n        (labels, \"relevance-label-source.schema.json\", \"labels\"),\n        (snapshot, \"relevance-fact-snapshot.schema.json\", \"snapshot\"),\n        (dataset, \"relevance-dataset.schema.json\", \"dataset\"),\n    ]\n    if ledger is not None:\n        artifacts.append((ledger, \"relevance-review-ledger.schema.json\", \"review ledger\"))\n    for artifact, filename, label in artifacts:\n        schema = load_json(schema_dir / filename)\n        if not isinstance(schema, dict):\n            errors.append(f\"{filename}: schema must be an object\")\n            continue\n        if schema.get(\"$schema\") != \"https://json-schema.org/draft/2020-12/schema\":\n            errors.append(f\"{filename}: wrong JSON Schema dialect\")\n        errors.extend(validate_schema_instance(artifact, schema, label))\n    return errors\n\n\ndef _tokens(text: str) -> set[str]:\n    return {token for token in re.findall(r\"[a-z0-9]+\", text.casefold()) if token not in STOPWORDS and len(token) > 1}\n\n\ndef propose(repo: pathlib.Path, inventory_path: pathlib.Path, facts_path: pathlib.Path,\n            session_dates_path: pathlib.Path, limit: int) -> list[dict[str, Any]]:\n    inventory = _load_inventory(inventory_path)\n    facts = load_facts(facts_path)\n    sessions = load_json(session_dates_path)\n    if not isinstance(sessions, dict):\n        raise DatasetError(\"session date map must be an object\")\n    active = [fact for fact in facts if fact.get(\"status\") == \"active\"]\n    document_frequency: Counter[str] = Counter()\n    tokenized: dict[str, set[str]] = {}\n    for fact in active:\n        fact_id = str(fact.get(\"id\") or \"\")\n        tokens = _tokens(\" \".join([str(fact.get(\"text\") or \"\"), \" \".join(fact.get(\"locus\") or [])]))\n        tokenized[fact_id] = tokens\n        document_frequency.update(tokens)\n    output: list[dict[str, Any]] = []\n    for task_id, row in sorted(inventory.items()):\n        if row.get(\"assigned_split\") != \"development\" or row.get(\"state\") not in SAFE_STATES:\n            continue\n        config = _task_config(repo, row)\n        query_text = \" \".join([str(config.get(\"prompt\") or \"\"), *[str(value) for value in config.get(\"brain_queries\") or []]])\n        query_tokens = _tokens(query_text)\n        cutoff = config.get(\"rolling_cutoff_rfc3339\")\n        excluded = set(config.get(\"exclude_session_ids\") or [])\n        candidates: list[tuple[float, dict[str, Any]]] = []\n        for fact in active:\n            if not _eligible(fact, {str(k): str(v) for k, v in sessions.items()}, cutoff, excluded):\n                continue\n            overlap = query_tokens & tokenized[str(fact.get(\"id\") or \"\")]\n            if not overlap:\n                continue\n            score = sum(math.log((len(active) + 1) / (document_frequency[token] + 1)) + 1 for token in overlap)\n            candidates.append((score, fact))\n        candidates.sort(key=lambda pair: (-pair[0], str(pair[1].get(\"id\") or \"\")))\n        output.append({\n            \"task_id\": task_id,\n            \"inventory_state\": row[\"state\"],\n            \"query_text\": config.get(\"prompt\"),\n            \"candidates\": [{\n                \"fact_id\": fact.get(\"id\"),\n                \"kind\": fact.get(\"kind\"),\n                \"score\": round(score, 6),\n                \"text\": fact.get(\"text\"),\n            } for score, fact in candidates[:limit]],\n        })\n    return output\n\n\ndef _render(value: Any) -> str:\n    return json.dumps(value, indent=2, ensure_ascii=False) + \"\\n\"\n\n\ndef _write_or_check(path: pathlib.Path, value: Any, check: bool) -> None:\n    rendered = _render(value)\n    if check:\n        if not path.is_file() or path.read_text() != rendered:\n            raise DatasetError(f\"generated artifact is stale: {path}\")\n    else:\n        path.write_text(rendered)\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=__doc__)\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n    propose_parser = subparsers.add_parser(\"propose\", help=\"rank eligible frozen facts for exposed development prompts\")\n    propose_parser.add_argument(\"--repo\", type=pathlib.Path, default=pathlib.Path.cwd())\n    propose_parser.add_argument(\"--inventory\", type=pathlib.Path, required=True)\n    propose_parser.add_argument(\"--facts\", type=pathlib.Path, required=True)\n    propose_parser.add_argument(\"--session-dates\", type=pathlib.Path, required=True)\n    propose_parser.add_argument(\"--limit\", type=int, default=10)\n\n    bind_parser = subparsers.add_parser(\"bind\", help=\"bind reviewed labels to the full pinned corpus\")\n    bind_parser.add_argument(\"--labels\", type=pathlib.Path, required=True)\n    bind_parser.add_argument(\"--facts\", type=pathlib.Path, required=True)\n    bind_parser.add_argument(\"--session-dates\", type=pathlib.Path, required=True)\n    bind_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    bind_parser.add_argument(\"--check\", action=\"store_true\")\n\n    snapshot_parser = subparsers.add_parser(\"snapshot\", help=\"extract the labeled fact subset from a pinned full corpus\")\n    snapshot_parser.add_argument(\"--labels\", type=pathlib.Path, required=True)\n    snapshot_parser.add_argument(\"--facts\", type=pathlib.Path, required=True)\n    snapshot_parser.add_argument(\"--session-dates\", type=pathlib.Path, required=True)\n    snapshot_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    snapshot_parser.add_argument(\"--check\", action=\"store_true\")\n\n    membership_parser = subparsers.add_parser(\n        \"source-membership\", help=\"build the complete authenticated fact/date membership catalog\"\n    )\n    membership_parser.add_argument(\"--facts\", type=pathlib.Path, required=True)\n    membership_parser.add_argument(\"--session-dates\", type=pathlib.Path, required=True)\n    membership_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    membership_parser.add_argument(\"--check\", action=\"store_true\")\n\n    contract_parser = subparsers.add_parser(\n        \"source-contract\", help=\"build the small reviewed contract that pins a membership catalog\"\n    )\n    contract_parser.add_argument(\"--membership\", type=pathlib.Path, required=True)\n    contract_parser.add_argument(\"--membership-path\", required=True)\n    contract_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    contract_parser.add_argument(\"--check\", action=\"store_true\")\n\n    ledger_parser = subparsers.add_parser(\n        \"review-ledger\", help=\"build retained per-query/per-judgment manual review evidence\"\n    )\n    ledger_parser.add_argument(\"--labels\", type=pathlib.Path, required=True)\n    ledger_parser.add_argument(\"--source-contract\", type=pathlib.Path, required=True)\n    ledger_parser.add_argument(\"--reviewed-at\", required=True)\n    ledger_parser.add_argument(\"--reviewer\", required=True)\n    ledger_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    ledger_parser.add_argument(\"--check\", action=\"store_true\")\n\n    materialize_parser = subparsers.add_parser(\"materialize\", help=\"derive the checked-in dataset from labels and fact snapshot\")\n    materialize_parser.add_argument(\"--repo\", type=pathlib.Path, default=pathlib.Path.cwd())\n    materialize_parser.add_argument(\"--labels\", type=pathlib.Path, required=True)\n    materialize_parser.add_argument(\"--inventory\", type=pathlib.Path, required=True)\n    materialize_parser.add_argument(\"--snapshot\", type=pathlib.Path, required=True)\n    materialize_parser.add_argument(\"--source-membership\", type=pathlib.Path)\n    materialize_parser.add_argument(\"--null-review-ledger\", type=pathlib.Path)\n    materialize_parser.add_argument(\"--output\", type=pathlib.Path, required=True)\n    materialize_parser.add_argument(\"--check\", action=\"store_true\")\n\n    validate_parser = subparsers.add_parser(\"validate\", help=\"fail if the checked-in dataset differs from its sources\")\n    validate_parser.add_argument(\"--repo\", type=pathlib.Path, default=pathlib.Path.cwd())\n    validate_parser.add_argument(\"--labels\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--inventory\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--snapshot\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--dataset\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--source-contract\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--source-membership\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--review-ledger\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--null-review-ledger\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\"--null-review-contract\", type=pathlib.Path, required=True)\n    validate_parser.add_argument(\n        \"--schemas\",\n        type=pathlib.Path,\n        default=pathlib.Path(__file__).resolve().with_name(\"schemas\"),\n    )\n\n    args = parser.parse_args()\n    try:\n        if args.command == \"propose\":\n            print(_render(propose(args.repo.resolve(), args.inventory, args.facts, args.session_dates, args.limit)), end=\"\")\n        elif args.command == \"bind\":\n            labels = load_json(args.labels)\n            sessions = load_json(args.session_dates)\n            if not isinstance(labels, dict) or not isinstance(sessions, dict):\n                raise DatasetError(\"labels/session dates must be JSON objects\")\n            value = bind_labels(\n                labels,\n                load_facts(args.facts),\n                {str(k): str(v) for k, v in sessions.items()},\n                sha256_bytes(args.facts.read_bytes()),\n                sha256_bytes(args.session_dates.read_bytes()),\n            )\n            _write_or_check(args.output, value, args.check)\n        elif args.command == \"snapshot\":\n            labels = load_json(args.labels)\n            sessions = load_json(args.session_dates)\n            if not isinstance(labels, dict) or not isinstance(sessions, dict):\n                raise DatasetError(\"labels/session dates must be JSON objects\")\n            value = build_snapshot(\n                labels,\n                load_facts(args.facts),\n                {str(k): str(v) for k, v in sessions.items()},\n                sha256_bytes(args.facts.read_bytes()),\n                sha256_bytes(args.session_dates.read_bytes()),\n            )\n            _write_or_check(args.output, value, args.check)\n        elif args.command == \"source-membership\":\n            sessions = load_json(args.session_dates)\n            if not isinstance(sessions, dict):\n                raise DatasetError(\"session dates must be a JSON object\")\n            value = build_source_membership(\n                load_facts(args.facts),\n                {str(k): str(v) for k, v in sessions.items()},\n                sha256_bytes(args.facts.read_bytes()),\n                sha256_bytes(args.session_dates.read_bytes()),\n            )\n            _write_or_check(args.output, value, args.check)\n        elif args.command == \"source-contract\":\n            membership = load_json(args.membership)\n            if not isinstance(membership, dict):\n                raise DatasetError(\"source membership must be a JSON object\")\n            value = build_source_contract(\n                args.membership_path,\n                membership,\n                sha256_bytes(args.membership.read_bytes()),\n            )\n            _write_or_check(args.output, value, args.check)\n        elif args.command == \"review-ledger\":\n            labels = load_json(args.labels)\n            contract = load_json(args.source_contract)\n            if not isinstance(labels, dict) or not isinstance(contract, dict):\n                raise DatasetError(\"labels/source contract must be JSON objects\")\n            value = build_review_ledger(\n                labels,\n                contract,\n                reviewed_at=args.reviewed_at,\n                reviewer=args.reviewer,\n            )\n            _write_or_check(args.output, value, args.check)\n        elif args.command == \"materialize\":\n            membership = load_json(args.source_membership) if args.source_membership else None\n            null_ledger = load_json(args.null_review_ledger) if args.null_review_ledger else None\n            ledger_path = (\n                args.null_review_ledger.resolve().relative_to(args.repo.resolve()).as_posix()\n                if args.null_review_ledger else \"\"\n            )\n            value = materialize(\n                args.repo.resolve(), args.labels, args.inventory, args.snapshot,\n                source_membership=membership if isinstance(membership, dict) else None,\n                null_review_ledger=null_ledger if isinstance(null_ledger, dict) else None,\n                null_review_ledger_path=ledger_path,\n                null_review_ledger_sha256=(\n                    sha256_bytes(args.null_review_ledger.read_bytes()) if args.null_review_ledger else \"\"\n                ),\n            )\n            _write_or_check(args.output, value, args.check)\n        else:\n            labels = load_json(args.labels)\n            snapshot = load_json(args.snapshot)\n            contract = load_json(args.source_contract)\n            membership = load_json(args.source_membership)\n            ledger = load_json(args.review_ledger)\n            null_ledger = load_json(args.null_review_ledger)\n            null_contract = load_json(args.null_review_contract)\n            if not all(isinstance(value, dict) for value in (\n                labels, snapshot, contract, membership, ledger, null_ledger, null_contract\n            )):\n                raise DatasetError(\"relevance validation artifacts must be objects\")\n            null_ledger_path = args.null_review_ledger.resolve().relative_to(args.repo.resolve()).as_posix()\n            null_ledger_sha = sha256_bytes(args.null_review_ledger.read_bytes())\n            value = materialize(\n                args.repo.resolve(), args.labels, args.inventory, args.snapshot,\n                source_membership=membership,\n                null_review_ledger=null_ledger,\n                null_review_ledger_path=null_ledger_path,\n                null_review_ledger_sha256=null_ledger_sha,\n            )\n            dataset = load_json(args.dataset)\n            if not isinstance(dataset, dict):\n                raise DatasetError(\"dataset must be an object\")\n            validate_dataset(dataset, value)\n            validate_source_membership(\n                labels,\n                snapshot,\n                contract,\n                membership,\n                membership_sha256=sha256_bytes(args.source_membership.read_bytes()),\n            )\n            validate_review_ledger(\n                labels,\n                ledger,\n                contract,\n                ledger_path=args.review_ledger.resolve().relative_to(args.repo.resolve()).as_posix(),\n                ledger_sha256=sha256_bytes(args.review_ledger.read_bytes()),\n            )\n            validate_null_review_contract(\n                null_contract,\n                null_ledger,\n                contract,\n                ledger_path=null_ledger_path,\n                ledger_sha256=null_ledger_sha,\n            )\n            schema_errors = validate_relevance_schemas(labels, snapshot, dataset, args.schemas, ledger)\n            if schema_errors:\n                raise DatasetError(\"schema validation failed: \" + \"; \".join(schema_errors))\n            print(\n                f\"relevance development dataset valid: {value['development']['item_count']} queries, \"\n                f\"{value['development']['unique_task_count']} tasks, \"\n                f\"{value['development']['judgment_count']} judgments; sealed holdout unopened\"\n            )\n    except DatasetError as exc:\n        print(f\"ERROR: {exc}\", file=sys.stderr)\n        return 1\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"},"started_at_ms":1789839547861,"completed_at_ms":1789839547861}}
{"timestamp":"2026-09-19T17:39:07.917Z","ordinal":7499,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0bac0-1e0d-7f43-b9bd-4ed66ee8f37b","call_id":"call_ne18za4yoSWYsgxekWDyiWAc","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"0ee9d4\",\"wall_time_seconds\":0.000002833,\"exit_code\":0,\"original_token_count\":6498,\"output\":\"            \\\"task_prompt_sha256\\\": prompt_hash,\\n            \\\"temporal_cutoff\\\": cutoff,\\n            \\\"null_query\\\": null_query,\\n            \\\"task_inventory_state\\\": state,\\n            \\\"label_evidence\\\": evidence,\\n            \\\"judgments\\\": judgments,\\n        }\\n        if null_query:\\n            materialized_item[\\\"null_closure\\\"] = closure\\n        items.append(materialized_item)\\n\\n    if not items:\\n        raise DatasetError(\\\"development labels cannot be empty\\\")\\n    if set(null_review_index) != consumed_null_reviews:\\n        raise DatasetError(\\\"null review ledger coverage differs from null labels\\\")\\n    observed_query_sources = {item[\\\"query_source\\\"] for item in items}\\n    if observed_query_sources != set(QUERY_SOURCES):\\n        raise DatasetError(f\\\"development labels must cover both query sources: {list(QUERY_SOURCES)!r}\\\")\\n    missing_grades = [grade for grade in GRADES if not grade_counts[grade]]\\n    if missing_grades:\\n        raise DatasetError(f\\\"development labels do not cover required grades: {missing_grades}\\\")\\n    dataset_id = labels.get(\\\"dataset_id\\\")\\n    if not isinstance(dataset_id, str) or not dataset_id:\\n        raise DatasetError(\\\"label dataset_id is missing\\\")\\n    created_at = labels.get(\\\"created_at\\\")\\n    _parse_time(created_at, \\\"label created_at\\\")\\n    task_count = len({item[\\\"task_id\\\"] for item in items})\\n    null_query_count = sum(item[\\\"null_query\\\"] for item in items)\\n    answerable_product_items = [\\n        item for item in items\\n        if item[\\\"query_source\\\"] == \\\"user_prompt_derived\\\" and not item[\\\"null_query\\\"]\\n    ]\\n    product_null_items = [\\n        item for item in items\\n        if item[\\\"query_source\\\"] == \\\"user_prompt_derived\\\" and item[\\\"null_query\\\"]\\n    ]\\n    return {\\n        \\\"schema_version\\\": SCHEMA_VERSION,\\n        \\\"dataset_id\\\": dataset_id,\\n        \\\"status\\\": \\\"draft_pending_labels_and_holdout_seal\\\",\\n        \\\"created_at\\\": created_at,\\n        \\\"label_policy\\\": {\\n            \\\"query_sources\\\": list(QUERY_SOURCES),\\n            \\\"required_judgments\\\": list(GRADES),\\n            \\\"null_query_closure_required\\\": True,\\n            \\\"null_query_requirement_for_threshold\\\": True,\\n            \\\"null_query_coverage_status\\\": (\\n                \\\"present_corpus_closed\\\" if null_query_count else \\\"pending_no_corpus_closed_queries\\\"\\n            ),\\n            \\\"temporal_eligibility_required\\\": True,\\n            \\\"near_duplicate_cluster_ids_required\\\": True,\\n            \\\"positive_definition\\\": [\\\"solving\\\", \\\"relevant_alternative\\\"],\\n            \\\"fact_hash_definition\\\": \\\"sha256(canonical JSON fact record; UTF-8, sorted keys, compact separators)\\\",\\n        },\\n        \\\"development\\\": {\\n            \\\"item_count\\\": len(items),\\n            \\\"unique_task_count\\\": task_count,\\n            \\\"null_query_count\\\": null_query_count,\\n            \\\"answerable_product_item_count\\\": len(answerable_product_items),\\n            \\\"unique_answerable_product_task_count\\\": len({item[\\\"task_id\\\"] for item in answerable_product_items}),\\n            \\\"product_null_query_count\\\": len(product_null_items),\\n            \\\"judgment_count\\\": sum(grade_counts.values()),\\n            \\\"grade_counts\\\": {grade: grade_counts[grade] for grade in GRADES},\\n            \\\"evidence_counts\\\": {evidence: evidence_counts[evidence] for evidence in EVIDENCE_TYPES},\\n            \\\"source_facts_sha256\\\": snapshot[\\\"source_facts_sha256\\\"],\\n            \\\"source_session_dates_sha256\\\": snapshot[\\\"source_session_dates_sha256\\\"],\\n            \\\"source_active_fact_count\\\": snapshot[\\\"source_active_fact_count\\\"],\\n            \\\"source_active_fact_catalog_sha256\\\": snapshot[\\\"source_active_fact_catalog_sha256\\\"],\\n            \\\"snapshot_facts_sha256\\\": snapshot[\\\"facts_sha256\\\"],\\n            \\\"snapshot_session_dates_sha256\\\": snapshot[\\\"session_dates_sha256\\\"],\\n            \\\"labels_sha256\\\": sha256_bytes(labels_path.read_bytes()),\\n            \\\"fact_snapshot_sha256\\\": sha256_bytes(snapshot_path.read_bytes()),\\n            \\\"items\\\": items,\\n        },\\n        \\\"sealed_holdout\\\": {\\n            \\\"item_count\\\": 0,\\n            \\\"unique_task_count\\\": 0,\\n            \\\"commitment_sha256\\\": None,\\n            \\\"sealed_at\\\": None,\\n            \\\"opened_at\\\": None,\\n            \\\"items\\\": [],\\n        },\\n    }\\n\\n\\ndef validate_dataset(dataset: dict[str, Any], expected: dict[str, Any]) -> None:\\n    if canonical_json(dataset) != canonical_json(expected):\\n        raise DatasetError(\\\"checked-in offline relevance dataset is stale; re-run materialize\\\")\\n    development = dataset.get(\\\"development\\\")\\n    if not isinstance(development, dict):\\n        raise DatasetError(\\\"development section is missing\\\")\\n    items = development.get(\\\"items\\\")\\n    if not isinstance(items, list):\\n        raise DatasetError(\\\"development items are missing\\\")\\n    sealed = dataset.get(\\\"sealed_holdout\\\")\\n    if sealed != {\\n        \\\"item_count\\\": 0,\\n        \\\"unique_task_count\\\": 0,\\n        \\\"commitment_sha256\\\": None,\\n        \\\"sealed_at\\\": None,\\n        \\\"opened_at\\\": None,\\n        \\\"items\\\": [],\\n    }:\\n        raise DatasetError(\\\"sealed holdout must remain unopened and empty during development labeling\\\")\\n\\n\\ndef _schema_type_matches(value: Any, expected_type: str) -> bool:\\n    return {\\n        \\\"object\\\": isinstance(value, dict),\\n        \\\"array\\\": isinstance(value, list),\\n        \\\"string\\\": isinstance(value, str),\\n        \\\"integer\\\": isinstance(value, int) and not isinstance(value, bool),\\n        \\\"number\\\": isinstance(value, (int, float)) and not isinstance(value, bool),\\n        \\\"boolean\\\": isinstance(value, bool),\\n        \\\"null\\\": value is None,\\n    }.get(expected_type, False)\\n\\n\\ndef validate_schema_instance(value: Any, schema: dict[str, Any], label: str) -> list[str]:\\n    \\\"\\\"\\\"Validate the JSON-Schema subset used by the relevance artifacts.\\\"\\\"\\\"\\n    errors: list[str] = []\\n\\n    def resolve(reference: str) -> dict[str, Any] | None:\\n        if not reference.startswith(\\\"#/\\\"):\\n            return None\\n        current: Any = schema\\n        for part in reference[2:].split(\\\"/\\\"):\\n            if not isinstance(current, dict) or part not in current:\\n                return None\\n            current = current[part]\\n        return current if isinstance(current, dict) else None\\n\\n    def walk(instance: Any, rule: dict[str, Any], path: str) -> None:\\n        reference = rule.get(\\\"$ref\\\")\\n        if reference is not None:\\n            target = resolve(reference) if isinstance(reference, str) else None\\n            if target is None:\\n                errors.append(f\\\"{label}{path}: unresolved schema reference {reference!r}\\\")\\n                return\\n            walk(instance, target, path)\\n            return\\n        if \\\"const\\\" in rule and instance != rule[\\\"const\\\"]:\\n            errors.append(f\\\"{label}{path}: value differs from schema const\\\")\\n        if \\\"enum\\\" in rule and instance not in rule[\\\"enum\\\"]:\\n            errors.append(f\\\"{label}{path}: value is outside schema enum\\\")\\n        expected = rule.get(\\\"type\\\")\\n        if expected is not None:\\n            expected_types = expected if isinstance(expected, list) else [expected]\\n            if not all(isinstance(item, str) for item in expected_types) or not any(\\n                _schema_type_matches(instance, item) for item in expected_types\\n            ):\\n                errors.append(f\\\"{label}{path}: value has wrong schema type\\\")\\n                return\\n        if isinstance(instance, dict):\\n            required = rule.get(\\\"required\\\", [])\\n            if isinstance(required, list):\\n                for field in required:\\n                    if field not in instance:\\n                        errors.append(f\\\"{label}{path}: missing schema-required field {field}\\\")\\n            properties = rule.get(\\\"properties\\\", {})\\n            if not isinstance(properties, dict):\\n                properties = {}\\n            for field, child in properties.items():\\n                if field in instance and isinstance(child, dict):\\n                    walk(instance[field], child, f\\\"{path}.{field}\\\")\\n            extras = set(instance) - set(properties)\\n            additional = rule.get(\\\"additionalProperties\\\", True)\\n            if additional is False:\\n                for field in sorted(extras):\\n                    errors.append(f\\\"{label}{path}: schema prohibits field {field}\\\")\\n            elif isinstance(additional, dict):\\n                for field in sorted(extras):\\n                    walk(instance[field], additional, f\\\"{path}.{field}\\\")\\n        if isinstance(instance, list):\\n            minimum_items = rule.get(\\\"minItems\\\")\\n            if isinstance(minimum_items, int) and len(instance) < minimum_items:\\n                errors.append(f\\\"{label}{path}: array is shorter than schema minItems\\\")\\n            if rule.get(\\\"uniqueItems\\\") is True:\\n                encoded = [canonical_json(item) for item in instance]\\n                if len(encoded) != len(set(encoded)):\\n                    errors.append(f\\\"{label}{path}: array violates schema uniqueItems\\\")\\n            item_rule = rule.get(\\\"items\\\")\\n            if isinstance(item_rule, dict):\\n                for index, item in enumerate(instance):\\n                    walk(item, item_rule, f\\\"{path}[{index}]\\\")\\n        if isinstance(instance, str):\\n            minimum_length = rule.get(\\\"minLength\\\")\\n            if isinstance(minimum_length, int) and len(instance) < minimum_length:\\n                errors.append(f\\\"{label}{path}: string is shorter than schema minLength\\\")\\n            pattern = rule.get(\\\"pattern\\\")\\n            if isinstance(pattern, str) and re.search(pattern, instance) is None:\\n                errors.append(f\\\"{label}{path}: string does not match schema pattern\\\")\\n            if rule.get(\\\"format\\\") == \\\"date-time\\\":\\n                try:\\n                    _parse_time(instance, f\\\"{label}{path}\\\")\\n                except DatasetError as exc:\\n                    errors.append(str(exc))\\n        minimum = rule.get(\\\"minimum\\\")\\n        if isinstance(minimum, (int, float)) and isinstance(instance, (int, float)) and not isinstance(instance, bool):\\n            if instance < minimum:\\n                errors.append(f\\\"{label}{path}: number is below schema minimum\\\")\\n\\n    walk(value, schema, \\\"$\\\")\\n    return errors\\n\\n\\ndef validate_relevance_schemas(labels: dict[str, Any], snapshot: dict[str, Any], dataset: dict[str, Any],\\n                               schema_dir: pathlib.Path, ledger: dict[str, Any] | None = None) -> list[str]:\\n    errors: list[str] = []\\n    artifacts: list[tuple[dict[str, Any], str, str]] = [\\n        (labels, \\\"relevance-label-source.schema.json\\\", \\\"labels\\\"),\\n        (snapshot, \\\"relevance-fact-snapshot.schema.json\\\", \\\"snapshot\\\"),\\n        (dataset, \\\"relevance-dataset.schema.json\\\", \\\"dataset\\\"),\\n    ]\\n    if ledger is not None:\\n        artifacts.append((ledger, \\\"relevance-review-ledger.schema.json\\\", \\\"review ledger\\\"))\\n    for artifact, filename, label in artifacts:\\n        schema = load_json(schema_dir / filename)\\n        if not isinstance(schema, dict):\\n            errors.append(f\\\"{filename}: schema must be an object\\\")\\n            continue\\n        if schema.get(\\\"$schema\\\") != \\\"https://json-schema.org/draft/2020-12/schema\\\":\\n            errors.append(f\\\"{filename}: wrong JSON Schema dialect\\\")\\n        errors.extend(validate_schema_instance(artifact, schema, label))\\n    return errors\\n\\n\\ndef _tokens(text: str) -> set[str]:\\n    return {token for token in re.findall(r\\\"[a-z0-9]+\\\", text.casefold()) if token not in STOPWORDS and len(token) > 1}\\n\\n\\ndef propose(repo: pathlib.Path, inventory_path: pathlib.Path, facts_path: pathlib.Path,\\n            session_dates_path: pathlib.Path, limit: int) -> list[dict[str, Any]]:\\n    inventory = _load_inventory(inventory_path)\\n    facts = load_facts(facts_path)\\n    sessions = load_json(session_dates_path)\\n    if not isinstance(sessions, dict):\\n        raise DatasetError(\\\"session date map must be an object\\\")\\n    active = [fact for fact in facts if fact.get(\\\"status\\\") == \\\"active\\\"]\\n    document_frequency: Counter[str] = Counter()\\n    tokenized: dict[str, set[str]] = {}\\n    for fact in active:\\n        fact_id = str(fact.get(\\\"id\\\") or \\\"\\\")\\n        tokens = _tokens(\\\" \\\".join([str(fact.get(\\\"text\\\") or \\\"\\\"), \\\" \\\".join(fact.get(\\\"locus\\\") or [])]))\\n        tokenized[fact_id] = tokens\\n        document_frequency.update(tokens)\\n    output: list[dict[str, Any]] = []\\n    for task_id, row in sorted(inventory.items()):\\n        if row.get(\\\"assigned_split\\\") != \\\"development\\\" or row.get(\\\"state\\\") not in SAFE_STATES:\\n            continue\\n        config = _task_config(repo, row)\\n        query_text = \\\" \\\".join([str(config.get(\\\"prompt\\\") or \\\"\\\"), *[str(value) for value in config.get(\\\"brain_queries\\\") or []]])\\n        query_tokens = _tokens(query_text)\\n        cutoff = config.get(\\\"rolling_cutoff_rfc3339\\\")\\n        excluded = set(config.get(\\\"exclude_session_ids\\\") or [])\\n        candidates: list[tuple[float, dict[str, Any]]] = []\\n        for fact in active:\\n            if not _eligible(fact, {str(k): str(v) for k, v in sessions.items()}, cutoff, excluded):\\n                continue\\n            overlap = query_tokens & tokenized[str(fact.get(\\\"id\\\") or \\\"\\\")]\\n            if not overlap:\\n                continue\\n            score = sum(math.log((len(active) + 1) / (document_frequency[token] + 1)) + 1 for token in overlap)\\n            candidates.append((score, fact))\\n        candidates.sort(key=lambda pair: (-pair[0], str(pair[1].get(\\\"id\\\") or \\\"\\\")))\\n        output.append({\\n            \\\"task_id\\\": task_id,\\n            \\\"inventory_state\\\": row[\\\"state\\\"],\\n            \\\"query_text\\\": config.get(\\\"prompt\\\"),\\n            \\\"candidates\\\": [{\\n                \\\"fact_id\\\": fact.get(\\\"id\\\"),\\n                \\\"kind\\\": fact.get(\\\"kind\\\"),\\n                \\\"score\\\": round(score, 6),\\n                \\\"text\\\": fact.get(\\\"text\\\"),\\n            } for score, fact in candidates[:limit]],\\n        })\\n    return output\\n\\n\\ndef _render(value: Any) -> str:\\n    return json.dumps(value, indent=2, ensure_ascii=False) + \\\"\\\\n\\\"\\n\\n\\ndef _write_or_check(path: pathlib.Path, value: Any, check: bool) -> None:\\n    rendered = _render(value)\\n    if check:\\n        if not path.is_file() or path.read_text() != rendered:\\n            raise DatasetError(f\\\"generated artifact is stale: {path}\\\")\\n    else:\\n        path.write_text(rendered)\\n\\n\\ndef main() -> int:\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    subparsers = parser.add_subparsers(dest=\\\"command\\\", required=True)\\n\\n    propose_parser = subparsers.add_parser(\\\"propose\\\", help=\\\"rank eligible frozen facts for exposed development prompts\\\")\\n    propose_parser.add_argument(\\\"--repo\\\", type=pathlib.Path, default=pathlib.Path.cwd())\\n    propose_parser.add_argument(\\\"--inventory\\\", type=pathlib.Path, required=True)\\n    propose_parser.add_argument(\\\"--facts\\\", type=pathlib.Path, required=True)\\n    propose_parser.add_argument(\\\"--session-dates\\\", type=pathlib.Path, required=True)\\n    propose_parser.add_argument(\\\"--limit\\\", type=int, default=10)\\n\\n    bind_parser = subparsers.add_parser(\\\"bind\\\", help=\\\"bind reviewed labels to the full pinned corpus\\\")\\n    bind_parser.add_argument(\\\"--labels\\\", type=pathlib.Path, required=True)\\n    bind_parser.add_argument(\\\"--facts\\\", type=pathlib.Path, required=True)\\n    bind_parser.add_argument(\\\"--session-dates\\\", type=pathlib.Path, required=True)\\n    bind_parser.add_argument(\\\"--output\\\", type=pathlib.Path, required=True)\\n    bind_parser.add_argument(\\\"--check\\\", action=\\\"store_true\\\")\\n\\n    snapshot_parser = subparsers.add_parser(\\\"snapshot\\\", help=\\\"extract the labeled fact subset from a pinned full corpus\\\")\\n    snapshot_parser.add_argument(\\\"--labels\\\", type=pathlib.Path, required=True)\\n    snapshot_parser.add_argument(\\\"--facts\\\", type=pathlib.Path, required=True)\\n    snapshot_parser.add_argument(\\\"--session-dates\\\", type=pathlib.Path, required=True)\\n    snapshot_parser.add_argument(\\\"--output\\\", type=pathlib.Path, required=True)\\n    snapshot_parser.add_argument(\\\"--check\\\", action=\\\"store_true\\\")\\n\\n    membership_parser = subparsers.add_parser(\\n        \\\"source-membership\\\", help=\\\"build the complete authenticated fact/date membership catalog\\\"\\n    )\\n    membership_parser.add_argument(\\\"--facts\\\", type=pathlib.Path, required=True)\\n    membership_parser.add_argument(\\\"--session-dates\\\", type=pathlib.Path, required=True)\\n    membership_parser.add_argument(\\\"--output\\\", type=pathlib.Path, required=True)\\n    membership_parser.add_argument(\\\"--check\\\", action=\\\"store_true\\\")\\n\\n    contract_parser = subparsers.add_parser(\\n        \\\"source-contract\\\", help=\\\"build the small reviewed contract that pins a membership catalog\\\"\\n    )\\n    contract_parser.add_argument(\\\"--membership\\\", type=pathlib.Path, required=True)\\n    contract_parser.add_argument(\\\"--membership-path\\\", required=True)\\n    contract_parser.add_argument(\\\"--output\\\", type=pathlib.Path, required=True)\\n    contract_parser.add_argument(\\\"--check\\\", action=\\\"store_true\\\")\\n\\n    ledger_parser = subparsers.add_parser(\\n        \\\"review-ledger\\\", help=\\\"build retained per-query/per-judgment manual review evidence\\\"\\n    )\\n    ledger_parser.add_argument(\\\"--labels\\\", type=pathlib.Path, required=True)\\n    ledger_parser.add_argument(\\\"--source-contract\\\", type=pathlib.Path, required=True)\\n    ledger_parser.add_argument(\\\"--reviewed-at\\\", required=True)\\n    ledger_parser.add_argument(\\\"--reviewer\\\", required=True)\\n    ledger_parser.add_argument(\\\"--output\\\", type=pathlib.Path, required=True)\\n    ledger_parser.add_argument(\\\"--check\\\", action=\\\"store_true\\\")\\n\\n    materialize_parser = subparsers.add_parser(\\\"materialize\\\", help=\\\"derive the checked-in dataset from labels and fact snapshot\\\")\\n    materialize_parser.add_argument(\\\"--repo\\\", type=pathlib.Path, default=pathlib.Path.cwd())\\n    materialize_parser.add_argument(\\\"--labels\\\", type=pathlib.Path, required=True)\\n    materialize_parser.add_argument(\\\"--inventory\\\", type=pathlib.Path, required=True)\\n    materialize_parser.add_argument(\\\"--snapshot\\\", type=pathlib.Path, required=True)\\n    materialize_parser.add_argument(\\\"--source-membership\\\", type=pathlib.Path)\\n    materialize_parser.add_argument(\\\"--null-review-ledger\\\", type=pathlib.Path)\\n    materialize_parser.add_argument(\\\"--output\\\", type=pathlib.Path, required=True)\\n    materialize_parser.add_argument(\\\"--check\\\", action=\\\"store_true\\\")\\n\\n    validate_parser = subparsers.add_parser(\\\"validate\\\", help=\\\"fail if the checked-in dataset differs from its sources\\\")\\n    validate_parser.add_argument(\\\"--repo\\\", type=pathlib.Path, default=pathlib.Path.cwd())\\n    validate_parser.add_argument(\\\"--labels\\\", type=pathlib.Path, required=True)\\n    validate_parser.add_argument(\\\"--inventory\\\", type=pathlib.Path, required=True)\\n    validate_parser.add_argument(\\\"--snapshot\\\", type=pathlib.Path, required=True)\\n    validate_parser.add_argument(\\\"--dataset\\\", type=pathlib.Path, required=True)\\n    validate_parser.add_argument(\\\"--source-contract\\\", type=pathlib.Path, required=True)\\n    validate_parser.add_argument(\\\"--source-membership\\\", type=pathlib.Path, required=True)\\n    validate_parser.add_argument(\\\"--review-ledger\\\", type=pathlib.Path, required=True)\\n    validate_parser.add_argument(\\\"--null-review-ledger\\\", type=pathlib.Path, required=True)\\n    validate_parser.add_argument(\\\"--null-review-contract\\\", type=pathlib.Path, required=True)\\n    validate_parser.add_argument(\\n        \\\"--schemas\\\",\\n        type=pathlib.Path,\\n        default=pathlib.Path(__file__).resolve().with_name(\\\"schemas\\\"),\\n    )\\n\\n    args = parser.parse_args()\\n    try:\\n        if args.command == \\\"propose\\\":\\n            print(_render(propose(args.repo.resolve(), args.inventory, args.facts, args.session_dates, args.limit)), end=\\\"\\\")\\n        elif args.command == \\\"bind\\\":\\n            labels = load_json(args.labels)\\n            sessions = load_json(args.session_dates)\\n            if not isinstance(labels, dict) or not isinstance(sessions, dict):\\n                raise DatasetError(\\\"labels/session dates must be JSON objects\\\")\\n            value = bind_labels(\\n                labels,\\n                load_facts(args.facts),\\n                {str(k): str(v) for k, v in sessions.items()},\\n                sha256_bytes(args.facts.read_bytes()),\\n                sha256_bytes(args.session_dates.read_bytes()),\\n            )\\n            _write_or_check(args.output, value, args.check)\\n        elif args.command == \\\"snapshot\\\":\\n            labels = load_json(args.labels)\\n            sessions = load_json(args.session_dates)\\n            if not isinstance(labels, dict) or not isinstance(sessions, dict):\\n                raise DatasetError(\\\"labels/session dates must be JSON objects\\\")\\n            value = build_snapshot(\\n                labels,\\n                load_facts(args.facts),\\n                {str(k): str(v) for k, v in sessions.items()},\\n                sha256_bytes(args.facts.read_bytes()),\\n                sha256_bytes(args.session_dates.read_bytes()),\\n            )\\n            _write_or_check(args.output, value, args.check)\\n        elif args.command == \\\"source-membership\\\":\\n            sessions = load_json(args.session_dates)\\n            if not isinstance(sessions, dict):\\n                raise DatasetError(\\\"session dates must be a JSON object\\\")\\n            value = build_source_membership(\\n                load_facts(args.facts),\\n                {str(k): str(v) for k, v in sessions.items()},\\n                sha256_bytes(args.facts.read_bytes()),\\n                sha256_bytes(args.session_dates.read_bytes()),\\n            )\\n            _write_or_check(args.output, value, args.check)\\n        elif args.command == \\\"source-contract\\\":\\n            membership = load_json(args.membership)\\n            if not isinstance(membership, dict):\\n                raise DatasetError(\\\"source membership must be a JSON object\\\")\\n            value = build_source_contract(\\n                args.membership_path,\\n                membership,\\n                sha256_bytes(args.membership.read_bytes()),\\n            )\\n            _write_or_check(args.output, value, args.check)\\n        elif args.command == \\\"review-ledger\\\":\\n            labels = load_json(args.labels)\\n            contract = load_json(args.source_contract)\\n            if not isinstance(labels, dict) or not isinstance(contract, dict):\\n                raise DatasetError(\\\"labels/source contract must be JSON objects\\\")\\n            value = build_review_ledger(\\n                labels,\\n                contract,\\n                reviewed_at=args.reviewed_at,\\n                reviewer=args.reviewer,\\n            )\\n            _write_or_check(args.output, value, args.check)\\n        elif args.command == \\\"materialize\\\":\\n            membership = load_json(args.source_membership) if args.source_membership else None\\n            null_ledger = load_json(args.null_review_ledger) if args.null_review_ledger else None\\n            ledger_path = (\\n                args.null_review_ledger.resolve().relative_to(args.repo.resolve()).as_posix()\\n                if args.null_review_ledger else \\\"\\\"\\n            )\\n            value = materialize(\\n                args.repo.resolve(), args.labels, args.inventory, args.snapshot,\\n                source_membership=membership if isinstance(membership, dict) else None,\\n                null_review_ledger=null_ledger if isinstance(null_ledger, dict) else None,\\n                null_review_ledger_path=ledger_path,\\n                null_review_ledger_sha256=(\\n                    sha256_bytes(args.null_review_ledger.read_bytes()) if args.null_review_ledger else \\\"\\\"\\n                ),\\n            )\\n            _write_or_check(args.output, value, args.check)\\n        else:\\n            labels = load_json(args.labels)\\n            snapshot = load_json(args.snapshot)\\n            contract = load_json(args.source_contract)\\n            membership = load_json(args.source_membership)\\n            ledger = load_json(args.review_ledger)\\n            null_ledger = load_json(args.null_review_ledger)\\n            null_contract = load_json(args.null_review_contract)\\n            if not all(isinstance(value, dict) for value in (\\n                labels, snapshot, contract, membership, ledger, null_ledger, null_contract\\n            )):\\n                raise DatasetError(\\\"relevance validation artifacts must be objects\\\")\\n            null_ledger_path = args.null_review_ledger.resolve().relative_to(args.repo.resolve()).as_posix()\\n            null_ledger_sha = sha256_bytes(args.null_review_ledger.read_bytes())\\n            value = materialize(\\n                args.repo.resolve(), args.labels, args.inventory, args.snapshot,\\n                source_membership=membership,\\n                null_review_ledger=null_ledger,\\n                null_review_ledger_path=null_ledger_path,\\n                null_review_ledger_sha256=null_ledger_sha,\\n            )\\n            dataset = load_json(args.dataset)\\n            if not isinstance(dataset, dict):\\n                raise DatasetError(\\\"dataset must be an object\\\")\\n            validate_dataset(dataset, value)\\n            validate_source_membership(\\n                labels,\\n                snapshot,\\n                contract,\\n                membership,\\n                membership_sha256=sha256_bytes(args.source_membership.read_bytes()),\\n            )\\n            validate_review_ledger(\\n                labels,\\n                ledger,\\n                contract,\\n                ledger_path=args.review_ledger.resolve().relative_to(args.repo.resolve()).as_posix(),\\n                ledger_sha256=sha256_bytes(args.review_ledger.read_bytes()),\\n            )\\n            validate_null_review_contract(\\n                null_contract,\\n                null_ledger,\\n                contract,\\n                ledger_path=null_ledger_path,\\n                ledger_sha256=null_ledger_sha,\\n            )\\n            schema_errors = validate_relevance_schemas(labels, snapshot, dataset, args.schemas, ledger)\\n            if schema_errors:\\n                raise DatasetError(\\\"schema validation failed: \\\" + \\\"; \\\".join(schema_errors))\\n            print(\\n                f\\\"relevance development dataset valid: {value['development']['item_count']} queries, \\\"\\n                f\\\"{value['development']['unique_task_count']} tasks, \\\"\\n                f\\\"{value['development']['judgment_count']} judgments; sealed holdout unopened\\\"\\n            )\\n    except DatasetError as exc:\\n        print(f\\\"ERROR: {exc}\\\", file=sys.stderr)\\n        return 1\\n    return 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    raise SystemExit(main())\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839547.917375}}}
