ision\": False,\n        \"status\": PENDING_POWER_STATUS,\n        \"decision\": {\n            \"passed\": False,\n            \"reason\": PENDING_REASON,\n            \"prohibited_until_resolved\": [\n                \"mark power_target_met pass\",\n                \"freeze practical floors or planning alternatives without owner approval\",\n                \"seal or open the fresh holdout\",\n                \"authorize paid confirmatory agent invocations\",\n                \"promote legacy two-endpoint sensitivity task counts into the v3 design\",\n            ],\n        },\n    }\n    derived = recompute_power_decision(report)\n    report[\"status\"] = derived[\"status\"]\n    report[\"decision\"][\"passed\"] = derived[\"passed\"]\n    report[\"decision\"][\"reason\"] = derived[\"reason\"]\n    return _round_floats(report)\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\n        \"--check\",\n        type=pathlib.Path,\n        help=\"fail if this JSON artifact differs semantically from the deterministic report\",\n    )\n    parser.add_argument(\n        \"--output\",\n        type=pathlib.Path,\n        help=\"write the deterministic JSON report to this path\",\n    )\n    args = parser.parse_args()\n    try:\n        report = build_report()\n    except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError) as exc:\n        print(f\"ERROR: cannot build deterministic power report: {exc}\", file=sys.stderr)\n        return 2\n    if args.check is not None:\n        existing = json.loads(args.check.read_text(encoding=\"utf-8\"))\n        if existing != report:\n            print(f\"ERROR: stale power artifact: {args.check}\", file=sys.stderr)\n            return 1\n        print(f\"power artifact is current: {args.check}\")\n        return 0\n    if args.output is not None:\n        args.output.write_text(\n            json.dumps(report, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\"\n        )\n        return 0\n    print(json.dumps(report, indent=2, sort_keys=True))\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"duration":{"secs":0,"nanos":2583},"formatted_output":"            \"required_statistics\": {\n                \"elapsed_time\": \"SD of paired task-level mean log ratios\",\n                \"normalized_cost\": \"paired task-arm mean-cost rows for a task-clustered equal-weight ratio-of-means bootstrap\",\n                \"code_quality\": \"SD of paired task-level mean differences\",\n                \"dependence\": \"joint covariance or retained task-level calibration rows\",\n            },\n            \"minimum_independent_task_clusters\": MINIMUM_CALIBRATION_TASK_CLUSTERS,\n            \"minimum_is_calibration_floor_not_power_sized_design\": True,\n            \"selection_use\": \"development calibration only; cannot enter confirmatory outcomes\",\n        },\n        \"design_readiness\": {\n            \"provisional_tasks\": TASKS,\n            \"provisional_repetitions_per_treatment\": REPETITIONS,\n            \"provisional_requested_cells\": REQUESTED_CELLS,\n            \"maximum_agent_invocations\": MAXIMUM_AGENT_INVOCATIONS,\n            \"agent_retry_limit\": AGENT_RETRY_LIMIT,\n            \"replacement_cell_limit\": REPLACEMENT_CELL_LIMIT,\n            \"provisional_design_power_defensible\": False,\n            \"power_sized_development_task_count\": None,\n            \"power_sized_confirmatory_task_count\": None,\n            \"reason\": \"no owner-frozen alternatives or final-contract calibration support a numeric task count\",\n        },\n        \"exploratory_calibration\": calibration,\n        \"empirical_variance_used_in_confirmatory_decision\": False,\n        \"status\": PENDING_POWER_STATUS,\n        \"decision\": {\n            \"passed\": False,\n            \"reason\": PENDING_REASON,\n            \"prohibited_until_resolved\": [\n                \"mark power_target_met pass\",\n                \"freeze practical floors or planning alternatives without owner approval\",\n                \"seal or open the fresh holdout\",\n                \"authorize paid confirmatory agent invocations\",\n                \"promote legacy two-endpoint sensitivity task counts into the v3 design\",\n            ],\n        },\n    }\n    derived = recompute_power_decision(report)\n    report[\"status\"] = derived[\"status\"]\n    report[\"decision\"][\"passed\"] = derived[\"passed\"]\n    report[\"decision\"][\"reason\"] = derived[\"reason\"]\n    return _round_floats(report)\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\n        \"--check\",\n        type=pathlib.Path,\n        help=\"fail if this JSON artifact differs semantically from the deterministic report\",\n    )\n    parser.add_argument(\n        \"--output\",\n        type=pathlib.Path,\n        help=\"write the deterministic JSON report to this path\",\n    )\n    args = parser.parse_args()\n    try:\n        report = build_report()\n    except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError) as exc:\n        print(f\"ERROR: cannot build deterministic power report: {exc}\", file=sys.stderr)\n        return 2\n    if args.check is not None:\n        existing = json.loads(args.check.read_text(encoding=\"utf-8\"))\n        if existing != report:\n            print(f\"ERROR: stale power artifact: {args.check}\", file=sys.stderr)\n            return 1\n        print(f\"power artifact is current: {args.check}\")\n        return 0\n    if args.output is not None:\n        args.output.write_text(\n            json.dumps(report, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\"\n        )\n        return 0\n    print(json.dumps(report, indent=2, sort_keys=True))\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"},"started_at_ms":1789839590723,"completed_at_ms":1789839590723}}
{"timestamp":"2026-09-19T17:39:50.825Z","ordinal":7532,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","item":{"type":"CommandExecution","id":"exec-3e8dd5e0-a20d-4aaa-88ff-28ed788a3a87","process_id":"13749","command":["/bin/zsh","-lc","sed -n '1,420p' benchmarks/agent-brain/confirmatory/power_analysis_v4.py"],"cwd":"file:///Users/thomi/.codex/worktrees/5d33/entire-brain","parsed_cmd":[{"type":"read","cmd":"sed -n '1,420p' benchmarks/agent-brain/confirmatory/power_analysis_v4.py","name":"power_analysis_v4.py","path":"benchmarks/agent-brain/confirmatory/power_analysis_v4.py"}],"source":"unified_exec_startup","status":"completed","stdout":"#!/usr/bin/env python3\n\"\"\"Final development calibration and four-arm power analysis v4.\n\nV4 is a standalone development lane.  It consumes a completed product-cycle\nv1 manifest plus a hash-bound projection of the canonical task-population v2\ncontract.  It never changes the locked three-arm preregistration or power-v3\nartifact, authorizes no spend, and makes no provider or model call.\n\nPower is estimated with deterministic shared resampling of independent task\nclusters.  Repetition means are formed inside task/arm before contrasts.  Time\nuses paired task log ratios, normalized cost preserves the frozen ratio of\nequal-task-weighted arithmetic arm means, and quality uses paired task mean\ndifferences.  Joint power is the same-draw frequency of all three endpoints\nclearing their one-sided bounds; marginal powers are never multiplied.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom collections import defaultdict\nimport copy\nfrom dataclasses import dataclass\nfrom decimal import Decimal\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nimport pathlib\nimport stat\nimport sys\nfrom typing import Any, Mapping, Sequence\n\n\nHERE = pathlib.Path(__file__).resolve().parent\nif str(HERE) not in sys.path:\n    sys.path.insert(0, str(HERE))\nimport draft202012 as DRAFT  # noqa: E402\nimport task_population as TASK_POPULATION  # noqa: E402\n\nPRODUCT_SPEC = importlib.util.spec_from_file_location(\n    \"power_v4_product_cycle\", HERE / \"product_cycle.py\"\n)\nassert PRODUCT_SPEC and PRODUCT_SPEC.loader\nPRODUCT = importlib.util.module_from_spec(PRODUCT_SPEC)\nPRODUCT_SPEC.loader.exec_module(PRODUCT)\n\nCALIBRATION_SCHEMA = \"agent-brain-final-calibration/v1\"\nREPORT_SCHEMA = \"agent-brain-power-analysis/v4\"\nTASK_POPULATION_PROFILE = \"agent_brain_task_population_v2\"\nMIN_CALIBRATION_CLUSTERS = 12\nTARGET_POWER = 0.80\nCONFIDENCE = 0.95\nMIN_RESAMPLES = 100\nMAX_RESAMPLES = 10_000\nMAX_CANDIDATE_CLUSTERS = 512\nPRODUCTION_RESAMPLES = 10_000\nPRODUCTION_SEED = 0x4542563453454544\nPRODUCTION_CANDIDATE_GRID = (\n    12,\n    16,\n    20,\n    24,\n    32,\n    40,\n    48,\n    64,\n    80,\n    96,\n    128,\n    160,\n    192,\n    256,\n    320,\n    384,\n    512,\n)\nRESAMPLING_METHOD = \"paired_cluster_residual_bootstrap_shared_draws_v1\"\nRESAMPLING_DOMAIN = b\"entire-brain/power-analysis-v4/shared-cluster-resample\\0\"\nPRIMARY_COMPARISON = \"retrieved_memory_vs_no_memory\"\nDIAGNOSTIC_COMPARISON = \"retrieved_memory_vs_preoptimization_memory\"\nENDPOINTS = (\"elapsed_time\", \"normalized_cost\", \"code_quality\")\nMAX_JSON_BYTES = 64 * 1024 * 1024\nNO_TRUST_ANCHOR = \"unauthenticated_no_trust_anchor_fail_closed\"\nPOPULATION_RECEIPT_SUBJECT_SCHEMA = (\n    \"agent-brain-task-population-verification-subject/full-population-v1\"\n)\nSCHEMA_PATHS = {\n    \"product_cycle\": HERE / \"schemas\" / \"product-cycle-v1.schema.json\",\n    \"task_population\": HERE / \"schemas\" / \"task-population-v2.schema.json\",\n    \"review_ledger\": HERE.parent / \"schemas\" / \"task-review-ledger-v2.schema.json\",\n    \"final_calibration\": HERE / \"schemas\" / \"final-calibration-v1.schema.json\",\n    \"power_report\": HERE / \"schemas\" / \"power-analysis-v4.schema.json\",\n    \"population_receipt\": HERE / \"schemas\" / \"task-population-verification-receipt-v1.schema.json\",\n    \"candidate_lock_receipt\": HERE / \"schemas\" / \"candidate-lock-receipt-v1.schema.json\",\n    \"owner_approval_receipt\": HERE / \"schemas\" / \"owner-approval-receipt-v1.schema.json\",\n}\n\n\nclass PowerV4Error(ValueError):\n    \"\"\"Raised when calibration or power evidence cannot safely be used.\"\"\"\n\n\n@dataclass(frozen=True)\nclass RawJsonArtifact:\n    path: pathlib.Path\n    raw_bytes: bytes\n    value: dict[str, Any]\n    sha256: str\n\n\n@dataclass(frozen=True)\nclass ArtifactBundle:\n    product_cycle: RawJsonArtifact\n    task_population: RawJsonArtifact\n    review_ledger: RawJsonArtifact\n    selection_receipt: RawJsonArtifact\n    assignment_receipt: RawJsonArtifact\n    overlap_receipt: RawJsonArtifact\n    candidate_lock_receipt: RawJsonArtifact\n    owner_approval_receipt: RawJsonArtifact | None\n    schemas: Mapping[str, RawJsonArtifact]\n    schema_validator: DRAFT.Validator\n\n\ndef _require(condition: bool, message: str) -> None:\n    if not condition:\n        raise PowerV4Error(message)\n\n\ndef _duplicate_key_guard(pairs: list[tuple[str, Any]]) -> dict[str, Any]:\n    value: dict[str, Any] = {}\n    for key, item in pairs:\n        _require(key not in value, \"JSON contains a duplicate object key\")\n        value[key] = item\n    return value\n\n\ndef _reject_non_json_constant(value: str) -> None:\n    raise ValueError(f\"non-JSON numeric constant {value!r}\")\n\n\ndef _read_regular_bytes(path: pathlib.Path, label: str) -> bytes:\n    flags = os.O_RDONLY | getattr(os, \"O_CLOEXEC\", 0) | getattr(os, \"O_NOFOLLOW\", 0)\n    try:\n        descriptor = os.open(path, flags)\n    except OSError as exc:\n        raise PowerV4Error(f\"{label} cannot be opened safely: {exc}\") from exc\n    try:\n        before = os.fstat(descriptor)\n        _require(stat.S_ISREG(before.st_mode), f\"{label} must be a regular file\")\n        _require(before.st_size <= MAX_JSON_BYTES, f\"{label} exceeds the size bound\")\n        chunks: list[bytes] = []\n        remaining = before.st_size\n        while remaining:\n            chunk = os.read(descriptor, min(remaining, 1024 * 1024))\n            _require(bool(chunk), f\"{label} changed while being read\")\n            chunks.append(chunk)\n            remaining -= len(chunk)\n        _require(os.read(descriptor, 1) == b\"\", f\"{label} grew while being read\")\n        after = os.fstat(descriptor)\n        _require(\n            (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)\n            == (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns),\n            f\"{label} changed while being read\",\n        )\n        return b\"\".join(chunks)\n    finally:\n        os.close(descriptor)\n\n\ndef _load_json_artifact(path: pathlib.Path, label: str) -> RawJsonArtifact:\n    raw = _read_regular_bytes(path, label)\n    try:\n        value = json.loads(\n            raw.decode(\"utf-8\"),\n            object_pairs_hook=_duplicate_key_guard,\n            parse_constant=_reject_non_json_constant,\n        )\n    except PowerV4Error:\n        raise\n    except (UnicodeError, ValueError) as exc:\n        raise PowerV4Error(f\"{label} is not strict UTF-8 JSON: {exc}\") from exc\n    _require(isinstance(value, dict), f\"{label} root must be an object\")\n    return RawJsonArtifact(\n        path=path,\n        raw_bytes=raw,\n        value=value,\n        sha256=hashlib.sha256(raw).hexdigest(),\n    )\n\n\ndef load_calibration(path: pathlib.Path) -> dict[str, Any]:\n    return _load_json_artifact(path, \"calibration\").value\n\n\ndef load_power_report(path: pathlib.Path) -> dict[str, Any]:\n    return _load_json_artifact(path, \"power report\").value\n\n\ndef load_artifact_bundle(\n    *,\n    product_cycle: pathlib.Path,\n    task_population: pathlib.Path,\n    review_ledger: pathlib.Path,\n    selection_receipt: pathlib.Path,\n    assignment_receipt: pathlib.Path,\n    overlap_receipt: pathlib.Path,\n    candidate_lock_receipt: pathlib.Path,\n    owner_approval_receipt: pathlib.Path | None,\n) -> ArtifactBundle:\n    artifacts = {\n        \"product_cycle\": _load_json_artifact(product_cycle, \"product-cycle evidence\"),\n        \"task_population\": _load_json_artifact(task_population, \"task-population contract\"),\n        \"review_ledger\": _load_json_artifact(review_ledger, \"task-review ledger\"),\n        \"selection_receipt\": _load_json_artifact(selection_receipt, \"selection receipt\"),\n        \"assignment_receipt\": _load_json_artifact(assignment_receipt, \"assignment receipt\"),\n        \"overlap_receipt\": _load_json_artifact(overlap_receipt, \"overlap receipt\"),\n        \"candidate_lock_receipt\": _load_json_artifact(\n            candidate_lock_receipt, \"candidate-lock receipt\"\n        ),\n    }\n    approval = (\n        _load_json_artifact(owner_approval_receipt, \"owner-approval receipt\")\n        if owner_approval_receipt is not None\n        else None\n    )\n    schemas = {\n        name: _load_json_artifact(path, f\"{name} schema\")\n        for name, path in SCHEMA_PATHS.items()\n    }\n    try:\n        validator = DRAFT.Validator(\n            [\n                DRAFT.SchemaDocument(artifact.path.name, artifact.value)\n                for artifact in schemas.values()\n            ]\n        )\n        validator.validate(\n            artifacts[\"product_cycle\"].value,\n            SCHEMA_PATHS[\"product_cycle\"].name,\n            label=\"product-cycle evidence\",\n        )\n        validator.validate(\n            artifacts[\"task_population\"].value,\n            SCHEMA_PATHS[\"task_population\"].name,\n            label=\"task-population contract\",\n        )\n        validator.validate(\n            artifacts[\"review_ledger\"].value,\n            SCHEMA_PATHS[\"review_ledger\"].name,\n            label=\"task-review ledger\",\n        )\n        for kind in (\"selection\", \"assignment\", \"overlap\"):\n            validator.validate(\n                artifacts[f\"{kind}_receipt\"].value,\n                SCHEMA_PATHS[\"population_receipt\"].name,\n                label=f\"{kind} receipt\",\n            )\n        validator.validate(\n            artifacts[\"candidate_lock_receipt\"].value,\n            SCHEMA_PATHS[\"candidate_lock_receipt\"].name,\n            label=\"candidate-lock receipt\",\n        )\n        if approval is not None:\n            validator.validate(\n                approval.value,\n                SCHEMA_PATHS[\"owner_approval_receipt\"].name,\n                label=\"owner-approval receipt\",\n            )\n    except DRAFT.SchemaError as exc:\n        raise PowerV4Error(str(exc)) from exc\n    try:\n        TASK_POPULATION.validate_population(\n            artifacts[\"task_population\"].value,\n            artifacts[\"review_ledger\"].value,\n            population_schema=SCHEMA_PATHS[\"task_population\"],\n            review_schema=SCHEMA_PATHS[\"review_ledger\"],\n        )\n    except TASK_POPULATION.TaskPopulationError as exc:\n        raise PowerV4Error(f\"task-population validation failed: {exc}\") from exc\n    return ArtifactBundle(\n        product_cycle=artifacts[\"product_cycle\"],\n        task_population=artifacts[\"task_population\"],\n        review_ledger=artifacts[\"review_ledger\"],\n        selection_receipt=artifacts[\"selection_receipt\"],\n        assignment_receipt=artifacts[\"assignment_receipt\"],\n        overlap_receipt=artifacts[\"overlap_receipt\"],\n        candidate_lock_receipt=artifacts[\"candidate_lock_receipt\"],\n        owner_approval_receipt=approval,\n        schemas=schemas,\n        schema_validator=validator,\n    )\n\n\ndef _exact_keys(value: Any, expected: set[str], label: str) -> dict[str, Any]:\n    _require(isinstance(value, dict), f\"{label} must be an object\")\n    actual = set(value)\n    missing = sorted(expected - actual)\n    extra = sorted(actual - expected)\n    _require(not missing and not extra, f\"{label} fields mismatch: missing={missing}, extra={extra}\")\n    return value\n\n\ndef _sha256(value: Any, label: str) -> str:\n    try:\n        return PRODUCT._sha256(value, label)\n    except PRODUCT.ProductCycleError as exc:\n        raise PowerV4Error(str(exc)) from exc\n\n\ndef _self_sha256(value: Mapping[str, Any], field: str = \"identity_sha256\") -> str:\n    return PRODUCT.self_sha256(value, field)\n\n\ndef _nonempty(value: Any, label: str) -> str:\n    _require(isinstance(value, str) and bool(value), f\"{label} must be a non-empty string\")\n    return value\n\n\ndef _positive_int(value: Any, label: str, *, maximum: int | None = None) -> int:\n    _require(type(value) is int and value > 0, f\"{label} must be a positive integer\")\n    if maximum is not None:\n        _require(value <= maximum, f\"{label} exceeds {maximum}\")\n    return value\n\n\ndef _finite(value: Any, label: str) -> float:\n    _require(type(value) in {int, float}, f\"{label} must be a finite number\")\n    rendered = float(value)\n    _require(math.isfinite(rendered), f\"{label} must be finite\")\n    return rendered\n\n\ndef _stable_float(value: float | Decimal) -> float:\n    rendered = float(value)\n    _require(math.isfinite(rendered), \"analysis produced a non-finite result\")\n    return float(format(rendered, \".12g\"))\n\n\ndef _task_identity_sha256(task_id: str) -> str:\n    return hashlib.sha256(\n        b\"entire-brain/task-population-v2/task-id\\0\" + task_id.encode(\"utf-8\")\n    ).hexdigest()\n\n\ndef _population_receipt_subject_sha256(\n    population: Mapping[str, Any], kind: str\n) -> str:\n    \"\"\"Bind verified population outputs without creating receipt hash cycles.\"\"\"\n    _require(\n        kind in {\"selection\", \"assignment\", \"overlap_commitment\"},\n        \"population receipt kind is invalid\",\n    )\n    projected = copy.deepcopy(dict(population))\n    _require(\n        \"population_sha256\" in projected\n        and isinstance(projected.get(\"selection_policy\"), dict)\n        and isinstance(projected.get(\"split_policy\"), dict),\n        \"population receipt subject is incomplete\",\n    )\n    # Each receipt attests the entire final population: selected universe,\n    # member_ref->membership assignments, overlap commitments, relation edges,\n    # review-ledger identity, and derived summary.  Only the self hash and raw\n    # receipt hashes are nulled, because including them would be circular.\n    projected[\"population_sha256\"] = None\n    projected[\"selection_policy\"][\"selection_receipt_sha256\"] = None\n    projected[\"split_policy\"][\"assignment_receipt_sha256\"] = None\n    projected[\"split_policy\"][\"overlap_commitment_receipt_sha256\"] = None\n    return PRODUCT.value_sha256(\n        {\n            \"schema\": POPULATION_RECEIPT_SUBJECT_SCHEMA,\n            \"kind\": kind,\n            \"population\": projected,\n        }\n    )\n\n\ndef _validate_population_receipt(\n    artifact: RawJsonArtifact,\n    *,\n    expected_kind: str,\n    expected_subject_sha256: str,\n) -> None:\n    receipt = artifact.value\n    _require(receipt[\"kind\"] == expected_kind, f\"{expected_kind} receipt kind drift\")\n    _require(receipt[\"status\"] == \"verified\", f\"{expected_kind} receipt is not verified\")\n    _require(\n        receipt[\"authentication_status\"] == NO_TRUST_ANCHOR,\n        f\"{expected_kind} receipt authentication status drift\",\n    )\n    _require(\n        receipt[\"verification_subject_schema\"]\n        == POPULATION_RECEIPT_SUBJECT_SCHEMA,\n        f\"{expected_kind} receipt subject schema drift\",\n    )\n    _require(\n        receipt[\"verification_subject_sha256\"] == expected_subject_sha256,\n        f\"{expected_kind} receipt subject drift\",\n    )\n    _require(\n        receipt[\"identity_sha256\"] == _self_sha256(receipt),\n        f\"{expected_kind} receipt identity hash mismatch\",\n    )\n\n\ndef _independence_clusters(\n    population: Mapping[str, Any], calibration_members: Sequence[Mapping[str, Any]]\n) -> tuple[dict[str, str], str]:\n    # Build the graph over the full validated population.  Projecting first\n    # would miss A--excluded-X--B paths and falsely call A and B independent.\n    refs = {str(member[\"member_ref\"]): member for member in population[\"members\"]}\n    active_refs = {str(member[\"member_ref\"]) for member in calibration_members}\n    parent = {ref: ref for ref in refs}\n\n    def find(ref: str) -> str:\n        while parent[ref] != ref:\n            parent[ref] = parent[parent[ref]]\n            ref = parent[ref]\n        return ref\n","stderr":"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Final development calibration and four-arm power analysis v4.\n\nV4 is a standalone development lane.  It consumes a completed product-cycle\nv1 manifest plus a hash-bound projection of the canonical task-population v2\ncontract.  It never changes the locked three-arm preregistration or power-v3\nartifact, authorizes no spend, and makes no provider or model call.\n\nPower is estimated with deterministic shared resampling of independent task\nclusters.  Repetition means are formed inside task/arm before contrasts.  Time\nuses paired task log ratios, normalized cost preserves the frozen ratio of\nequal-task-weighted arithmetic arm means, and quality uses paired task mean\ndifferences.  Joint power is the same-draw frequency of all three endpoints\nclearing their one-sided bounds; marginal powers are never multiplied.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom collections import defaultdict\nimport copy\nfrom dataclasses import dataclass\nfrom decimal import Decimal\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nimport pathlib\nimport stat\nimport sys\nfrom typing import Any, Mapping, Sequence\n\n\nHERE = pathlib.Path(__file__).resolve().parent\nif str(HERE) not in sys.path:\n    sys.path.insert(0, str(HERE))\nimport draft202012 as DRAFT  # noqa: E402\nimport task_population as TASK_POPULATION  # noqa: E402\n\nPRODUCT_SPEC = importlib.util.spec_from_file_location(\n    \"power_v4_product_cycle\", HERE / \"product_cycle.py\"\n)\nassert PRODUCT_SPEC and PRODUCT_SPEC.loader\nPRODUCT = importlib.util.module_from_spec(PRODUCT_SPEC)\nPRODUCT_SPEC.loader.exec_module(PRODUCT)\n\nCALIBRATION_SCHEMA = \"agent-brain-final-calibration/v1\"\nREPORT_SCHEMA = \"agent-brain-power-analysis/v4\"\nTASK_POPULATION_PROFILE = \"agent_brain_task_population_v2\"\nMIN_CALIBRATION_CLUSTERS = 12\nTARGET_POWER = 0.80\nCONFIDENCE = 0.95\nMIN_RESAMPLES = 100\nMAX_RESAMPLES = 10_000\nMAX_CANDIDATE_CLUSTERS = 512\nPRODUCTION_RESAMPLES = 10_000\nPRODUCTION_SEED = 0x4542563453454544\nPRODUCTION_CANDIDATE_GRID = (\n    12,\n    16,\n    20,\n    24,\n    32,\n    40,\n    48,\n    64,\n    80,\n    96,\n    128,\n    160,\n    192,\n    256,\n    320,\n    384,\n    512,\n)\nRESAMPLING_METHOD = \"paired_cluster_residual_bootstrap_shared_draws_v1\"\nRESAMPLING_DOMAIN = b\"entire-brain/power-analysis-v4/shared-cluster-resample\\0\"\nPRIMARY_COMPARISON = \"retrieved_memory_vs_no_memory\"\nDIAGNOSTIC_COMPARISON = \"retrieved_memory_vs_preoptimization_memory\"\nENDPOINTS = (\"elapsed_time\", \"normalized_cost\", \"code_quality\")\nMAX_JSON_BYTES = 64 * 1024 * 1024\nNO_TRUST_ANCHOR = \"unauthenticated_no_trust_anchor_fail_closed\"\nPOPULATION_RECEIPT_SUBJECT_SCHEMA = (\n    \"agent-brain-task-population-verification-subject/full-population-v1\"\n)\nSCHEMA_PATHS = {\n    \"product_cycle\": HERE / \"schemas\" / \"product-cycle-v1.schema.json\",\n    \"task_population\": HERE / \"schemas\" / \"task-population-v2.schema.json\",\n    \"review_ledger\": HERE.parent / \"schemas\" / \"task-review-ledger-v2.schema.json\",\n    \"final_calibration\": HERE / \"schemas\" / \"final-calibration-v1.schema.json\",\n    \"power_report\": HERE / \"schemas\" / \"power-analysis-v4.schema.json\",\n    \"population_receipt\": HERE / \"schemas\" / \"task-population-verification-receipt-v1.schema.json\",\n    \"candidate_lock_receipt\": HERE / \"schemas\" / \"candidate-lock-receipt-v1.schema.json\",\n    \"owner_approval_receipt\": HERE / \"schemas\" / \"owner-approval-receipt-v1.schema.json\",\n}\n\n\nclass PowerV4Error(ValueError):\n    \"\"\"Raised when calibration or power evidence cannot safely be used.\"\"\"\n\n\n@dataclass(frozen=True)\nclass RawJsonArtifact:\n    path: pathlib.Path\n    raw_bytes: bytes\n    value: dict[str, Any]\n    sha256: str\n\n\n@dataclass(frozen=True)\nclass ArtifactBundle:\n    product_cycle: RawJsonArtifact\n    task_population: RawJsonArtifact\n    review_ledger: RawJsonArtifact\n    selection_receipt: RawJsonArtifact\n    assignment_receipt: RawJsonArtifact\n    overlap_receipt: RawJsonArtifact\n    candidate_lock_receipt: RawJsonArtifact\n    owner_approval_receipt: RawJsonArtifact | None\n    schemas: Mapping[str, RawJsonArtifact]\n    schema_validator: DRAFT.Validator\n\n\ndef _require(condition: bool, message: str) -> None:\n    if not condition:\n        raise PowerV4Error(message)\n\n\ndef _duplicate_key_guard(pairs: list[tuple[str, Any]]) -> dict[str, Any]:\n    value: dict[str, Any] = {}\n    for key, item in pairs:\n        _require(key not in value, \"JSON contains a duplicate object key\")\n        value[key] = item\n    return value\n\n\ndef _reject_non_json_constant(value: str) -> None:\n    raise ValueError(f\"non-JSON numeric constant {value!r}\")\n\n\ndef _read_regular_bytes(path: pathlib.Path, label: str) -> bytes:\n    flags = os.O_RDONLY | getattr(os, \"O_CLOEXEC\", 0) | getattr(os, \"O_NOFOLLOW\", 0)\n    try:\n        descriptor = os.open(path, flags)\n    except OSError as exc:\n        raise PowerV4Error(f\"{label} cannot be opened safely: {exc}\") from exc\n    try:\n        before = os.fstat(descriptor)\n        _require(stat.S_ISREG(before.st_mode), f\"{label} must be a regular file\")\n        _require(before.st_size <= MAX_JSON_BYTES, f\"{label} exceeds the size bound\")\n        chunks: list[bytes] = []\n        remaining = before.st_size\n        while remaining:\n            chunk = os.read(descriptor, min(remaining, 1024 * 1024))\n            _require(bool(chunk), f\"{label} changed while being read\")\n            chunks.append(chunk)\n            remaining -= len(chunk)\n        _require(os.read(descriptor, 1) == b\"\", f\"{label} grew while being read\")\n        after = os.fstat(descriptor)\n        _require(\n            (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)\n            == (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns),\n            f\"{label} changed while being read\",\n        )\n        return b\"\".join(chunks)\n    finally:\n        os.close(descriptor)\n\n\ndef _load_json_artifact(path: pathlib.Path, label: str) -> RawJsonArtifact:\n    raw = _read_regular_bytes(path, label)\n    try:\n        value = json.loads(\n            raw.decode(\"utf-8\"),\n            object_pairs_hook=_duplicate_key_guard,\n            parse_constant=_reject_non_json_constant,\n        )\n    except PowerV4Error:\n        raise\n    except (UnicodeError, ValueError) as exc:\n        raise PowerV4Error(f\"{label} is not strict UTF-8 JSON: {exc}\") from exc\n    _require(isinstance(value, dict), f\"{label} root must be an object\")\n    return RawJsonArtifact(\n        path=path,\n        raw_bytes=raw,\n        value=value,\n        sha256=hashlib.sha256(raw).hexdigest(),\n    )\n\n\ndef load_calibration(path: pathlib.Path) -> dict[str, Any]:\n    return _load_json_artifact(path, \"calibration\").value\n\n\ndef load_power_report(path: pathlib.Path) -> dict[str, Any]:\n    return _load_json_artifact(path, \"power report\").value\n\n\ndef load_artifact_bundle(\n    *,\n    product_cycle: pathlib.Path,\n    task_population: pathlib.Path,\n    review_ledger: pathlib.Path,\n    selection_receipt: pathlib.Path,\n    assignment_receipt: pathlib.Path,\n    overlap_receipt: pathlib.Path,\n    candidate_lock_receipt: pathlib.Path,\n    owner_approval_receipt: pathlib.Path | None,\n) -> ArtifactBundle:\n    artifacts = {\n        \"product_cycle\": _load_json_artifact(product_cycle, \"product-cycle evidence\"),\n        \"task_population\": _load_json_artifact(task_population, \"task-population contract\"),\n        \"review_ledger\": _load_json_artifact(review_ledger, \"task-review ledger\"),\n        \"selection_receipt\": _load_json_artifact(selection_receipt, \"selection receipt\"),\n        \"assignment_receipt\": _load_json_artifact(assignment_receipt, \"assignment receipt\"),\n        \"overlap_receipt\": _load_json_artifact(overlap_receipt, \"overlap receipt\"),\n        \"candidate_lock_receipt\": _load_json_artifact(\n            candidate_lock_receipt, \"candidate-lock receipt\"\n        ),\n    }\n    approval = (\n        _load_json_artifact(owner_approval_receipt, \"owner-approval receipt\")\n        if owner_approval_receipt is not None\n        else None\n    )\n    schemas = {\n        name: _load_json_artifact(path, f\"{name} schema\")\n        for name, path in SCHEMA_PATHS.items()\n    }\n    try:\n        validator = DRAFT.Validator(\n            [\n                DRAFT.SchemaDocument(artifact.path.name, artifact.value)\n                for artifact in schemas.values()\n            ]\n        )\n        validator.validate(\n            artifacts[\"product_cycle\"].value,\n            SCHEMA_PATHS[\"product_cycle\"].name,\n            label=\"product-cycle evidence\",\n        )\n        validator.validate(\n            artifacts[\"task_population\"].value,\n            SCHEMA_PATHS[\"task_population\"].name,\n            label=\"task-population contract\",\n        )\n        validator.validate(\n            artifacts[\"review_ledger\"].value,\n            SCHEMA_PATHS[\"review_ledger\"].name,\n            label=\"task-review ledger\",\n        )\n        for kind in (\"selection\", \"assignment\", \"overlap\"):\n            validator.validate(\n                artifacts[f\"{kind}_receipt\"].value,\n                SCHEMA_PATHS[\"population_receipt\"].name,\n                label=f\"{kind} receipt\",\n            )\n        validator.validate(\n            artifacts[\"candidate_lock_receipt\"].value,\n            SCHEMA_PATHS[\"candidate_lock_receipt\"].name,\n            label=\"candidate-lock receipt\",\n        )\n        if approval is not None:\n            validator.validate(\n                approval.value,\n                SCHEMA_PATHS[\"owner_approval_receipt\"].name,\n                label=\"owner-approval receipt\",\n            )\n    except DRAFT.SchemaError as exc:\n        raise PowerV4Error(str(exc)) from exc\n    try:\n        TASK_POPULATION.validate_population(\n            artifacts[\"task_population\"].value,\n            artifacts[\"review_ledger\"].value,\n            population_schema=SCHEMA_PATHS[\"task_population\"],\n            review_schema=SCHEMA_PATHS[\"review_ledger\"],\n        )\n    except TASK_POPULATION.TaskPopulationError as exc:\n        raise PowerV4Error(f\"task-population validation failed: {exc}\") from exc\n    return ArtifactBundle(\n        product_cycle=artifacts[\"product_cycle\"],\n        task_population=artifacts[\"task_population\"],\n        review_ledger=artifacts[\"review_ledger\"],\n        selection_receipt=artifacts[\"selection_receipt\"],\n        assignment_receipt=artifacts[\"assignment_receipt\"],\n        overlap_receipt=artifacts[\"overlap_receipt\"],\n        candidate_lock_receipt=artifacts[\"candidate_lock_receipt\"],\n        owner_approval_receipt=approval,\n        schemas=schemas,\n        schema_validator=validator,\n    )\n\n\ndef _exact_keys(value: Any, expected: set[str], label: str) -> dict[str, Any]:\n    _require(isinstance(value, dict), f\"{label} must be an object\")\n    actual = set(value)\n    missing = sorted(expected - actual)\n    extra = sorted(actual - expected)\n    _require(not missing and not extra, f\"{label} fields mismatch: missing={missing}, extra={extra}\")\n    return value\n\n\ndef _sha256(value: Any, label: str) -> str:\n    try:\n        return PRODUCT._sha256(value, label)\n    except PRODUCT.ProductCycleError as exc:\n        raise PowerV4Error(str(exc)) from exc\n\n\ndef _self_sha256(value: Mapping[str, Any], field: str = \"identity_sha256\") -> str:\n    return PRODUCT.self_sha256(value, field)\n\n\ndef _nonempty(value: Any, label: str) -> str:\n    _require(isinstance(value, str) and bool(value), f\"{label} must be a non-empty string\")\n    return value\n\n\ndef _positive_int(value: Any, label: str, *, maximum: int | None = None) -> int:\n    _require(type(value) is int and value > 0, f\"{label} must be a positive integer\")\n    if maximum is not None:\n        _require(value <= maximum, f\"{label} exceeds {maximum}\")\n    return value\n\n\ndef _finite(value: Any, label: str) -> float:\n    _require(type(value) in {int, float}, f\"{label} must be a finite number\")\n    rendered = float(value)\n    _require(math.isfinite(rendered), f\"{label} must be finite\")\n    return rendered\n\n\ndef _stable_float(value: float | Decimal) -> float:\n    rendered = float(value)\n    _require(math.isfinite(rendered), \"analysis produced a non-finite result\")\n    return float(format(rendered, \".12g\"))\n\n\ndef _task_identity_sha256(task_id: str) -> str:\n    return hashlib.sha256(\n        b\"entire-brain/task-population-v2/task-id\\0\" + task_id.encode(\"utf-8\")\n    ).hexdigest()\n\n\ndef _population_receipt_subject_sha256(\n    population: Mapping[str, Any], kind: str\n) -> str:\n    \"\"\"Bind verified population outputs without creating receipt hash cycles.\"\"\"\n    _require(\n        kind in {\"selection\", \"assignment\", \"overlap_commitment\"},\n        \"population receipt kind is invalid\",\n    )\n    projected = copy.deepcopy(dict(population))\n    _require(\n        \"population_sha256\" in projected\n        and isinstance(projected.get(\"selection_policy\"), dict)\n        and isinstance(projected.get(\"split_policy\"), dict),\n        \"population receipt subject is incomplete\",\n    )\n    # Each receipt attests the entire final population: selected universe,\n    # member_ref->membership assignments, overlap commitments, relation edges,\n    # review-ledger identity, and derived summary.  Only the self hash and raw\n    # receipt hashes are nulled, because including them would be circular.\n    projected[\"population_sha256\"] = None\n    projected[\"selection_policy\"][\"selection_receipt_sha256\"] = None\n    projected[\"split_policy\"][\"assignment_receipt_sha256\"] = None\n    projected[\"split_policy\"][\"overlap_commitment_receipt_sha256\"] = None\n    return PRODUCT.value_sha256(\n        {\n            \"schema\": POPULATION_RECEIPT_SUBJECT_SCHEMA,\n            \"kind\": kind,\n            \"population\": projected,\n        }\n    )\n\n\ndef _validate_population_receipt(\n    artifact: RawJsonArtifact,\n    *,\n    expected_kind: str,\n    expected_subject_sha256: str,\n) -> None:\n    receipt = artifact.value\n    _require(receipt[\"kind\"] == expected_kind, f\"{expected_kind} receipt kind drift\")\n    _require(receipt[\"status\"] == \"verified\", f\"{expected_kind} receipt is not verified\")\n    _require(\n        receipt[\"authentication_status\"] == NO_TRUST_ANCHOR,\n        f\"{expected_kind} receipt authentication status drift\",\n    )\n    _require(\n        receipt[\"verification_subject_schema\"]\n        == POPULATION_RECEIPT_SUBJECT_SCHEMA,\n        f\"{expected_kind} receipt subject schema drift\",\n    )\n    _require(\n        receipt[\"verification_subject_sha256\"] == expected_subject_sha256,\n        f\"{expected_kind} receipt subject drift\",\n    )\n    _require(\n        receipt[\"identity_sha256\"] == _self_sha256(receipt),\n        f\"{expected_kind} receipt identity hash mismatch\",\n    )\n\n\ndef _independence_clusters(\n    population: Mapping[str, Any], calibration_members: Sequence[Mapping[str, Any]]\n) -> tuple[dict[str, str], str]:\n    # Build the graph over the full validated population.  Projecting first\n    # would miss A--excluded-X--B paths and falsely call A and B independent.\n    refs = {str(member[\"member_ref\"]): member for member in population[\"members\"]}\n    active_refs = {str(member[\"member_ref\"]) for member in calibration_members}\n    parent = {ref: ref for ref in refs}\n\n    def find(ref: str) -> str:\n        while parent[ref] != ref:\n            parent[ref] = parent[parent[ref]]\n            ref = parent[ref]\n        return ref\n","exit_code":0,"duration":{"secs":0,"nanos":2125},"formatted_output":"#!/usr/bin/env python3\n\"\"\"Final development calibration and four-arm power analysis v4.\n\nV4 is a standalone development lane.  It consumes a completed product-cycle\nv1 manifest plus a hash-bound projection of the canonical task-population v2\ncontract.  It never changes the locked three-arm preregistration or power-v3\nartifact, authorizes no spend, and makes no provider or model call.\n\nPower is estimated with deterministic shared resampling of independent task\nclusters.  Repetition means are formed inside task/arm before contrasts.  Time\nuses paired task log ratios, normalized cost preserves the frozen ratio of\nequal-task-weighted arithmetic arm means, and quality uses paired task mean\ndifferences.  Joint power is the same-draw frequency of all three endpoints\nclearing their one-sided bounds; marginal powers are never multiplied.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom collections import defaultdict\nimport copy\nfrom dataclasses import dataclass\nfrom decimal import Decimal\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nimport pathlib\nimport stat\nimport sys\nfrom typing import Any, Mapping, Sequence\n\n\nHERE = pathlib.Path(__file__).resolve().parent\nif str(HERE) not in sys.path:\n    sys.path.insert(0, str(HERE))\nimport draft202012 as DRAFT  # noqa: E402\nimport task_population as TASK_POPULATION  # noqa: E402\n\nPRODUCT_SPEC = importlib.util.spec_from_file_location(\n    \"power_v4_product_cycle\", HERE / \"product_cycle.py\"\n)\nassert PRODUCT_SPEC and PRODUCT_SPEC.loader\nPRODUCT = importlib.util.module_from_spec(PRODUCT_SPEC)\nPRODUCT_SPEC.loader.exec_module(PRODUCT)\n\nCALIBRATION_SCHEMA = \"agent-brain-final-calibration/v1\"\nREPORT_SCHEMA = \"agent-brain-power-analysis/v4\"\nTASK_POPULATION_PROFILE = \"agent_brain_task_population_v2\"\nMIN_CALIBRATION_CLUSTERS = 12\nTARGET_POWER = 0.80\nCONFIDENCE = 0.95\nMIN_RESAMPLES = 100\nMAX_RESAMPLES = 10_000\nMAX_CANDIDATE_CLUSTERS = 512\nPRODUCTION_RESAMPLES = 10_000\nPRODUCTION_SEED = 0x4542563453454544\nPRODUCTION_CANDIDATE_GRID = (\n    12,\n    16,\n    20,\n    24,\n    32,\n    40,\n    48,\n    64,\n    80,\n    96,\n    128,\n    160,\n    192,\n    256,\n    320,\n    384,\n    512,\n)\nRESAMPLING_METHOD = \"paired_cluster_residual_bootstrap_shared_draws_v1\"\nRESAMPLING_DOMAIN = b\"entire-brain/power-analysis-v4/shared-cluster-resample\\0\"\nPRIMARY_COMPARISON = \"retrieved_memory_vs_no_memory\"\nDIAGNOSTIC_COMPARISON = \"retrieved_memory_vs_preoptimization_memory\"\nENDPOINTS = (\"elapsed_time\", \"normalized_cost\", \"code_quality\")\nMAX_JSON_BYTES = 64 * 1024 * 1024\nNO_TRUST_ANCHOR = \"unauthenticated_no_trust_anchor_fail_closed\"\nPOPULATION_RECEIPT_SUBJECT_SCHEMA = (\n    \"agent-brain-task-population-verification-subject/full-population-v1\"\n)\nSCHEMA_PATHS = {\n    \"product_cycle\": HERE / \"schemas\" / \"product-cycle-v1.schema.json\",\n    \"task_population\": HERE / \"schemas\" / \"task-population-v2.schema.json\",\n    \"review_ledger\": HERE.parent / \"schemas\" / \"task-review-ledger-v2.schema.json\",\n    \"final_calibration\": HERE / \"schemas\" / \"final-calibration-v1.schema.json\",\n    \"power_report\": HERE / \"schemas\" / \"power-analysis-v4.schema.json\",\n    \"population_receipt\": HERE / \"schemas\" / \"task-population-verification-receipt-v1.schema.json\",\n    \"candidate_lock_receipt\": HERE / \"schemas\" / \"candidate-lock-receipt-v1.schema.json\",\n    \"owner_approval_receipt\": HERE / \"schemas\" / \"owner-approval-receipt-v1.schema.json\",\n}\n\n\nclass PowerV4Error(ValueError):\n    \"\"\"Raised when calibration or power evidence cannot safely be used.\"\"\"\n\n\n@dataclass(frozen=True)\nclass RawJsonArtifact:\n    path: pathlib.Path\n    raw_bytes: bytes\n    value: dict[str, Any]\n    sha256: str\n\n\n@dataclass(frozen=True)\nclass ArtifactBundle:\n    product_cycle: RawJsonArtifact\n    task_population: RawJsonArtifact\n    review_ledger: RawJsonArtifact\n    selection_receipt: RawJsonArtifact\n    assignment_receipt: RawJsonArtifact\n    overlap_receipt: RawJsonArtifact\n    candidate_lock_receipt: RawJsonArtifact\n    owner_approval_receipt: RawJsonArtifact | None\n    schemas: Mapping[str, RawJsonArtifact]\n    schema_validator: DRAFT.Validator\n\n\ndef _require(condition: bool, message: str) -> None:\n    if not condition:\n        raise PowerV4Error(message)\n\n\ndef _duplicate_key_guard(pairs: list[tuple[str, Any]]) -> dict[str, Any]:\n    value: dict[str, Any] = {}\n    for key, item in pairs:\n        _require(key not in value, \"JSON contains a duplicate object key\")\n        value[key] = item\n    return value\n\n\ndef _reject_non_json_constant(value: str) -> None:\n    raise ValueError(f\"non-JSON numeric constant {value!r}\")\n\n\ndef _read_regular_bytes(path: pathlib.Path, label: str) -> bytes:\n    flags = os.O_RDONLY | getattr(os, \"O_CLOEXEC\", 0) | getattr(os, \"O_NOFOLLOW\", 0)\n    try:\n        descriptor = os.open(path, flags)\n    except OSError as exc:\n        raise PowerV4Error(f\"{label} cannot be opened safely: {exc}\") from exc\n    try:\n        before = os.fstat(descriptor)\n        _require(stat.S_ISREG(before.st_mode), f\"{label} must be a regular file\")\n        _require(before.st_size <= MAX_JSON_BYTES, f\"{label} exceeds the size bound\")\n        chunks: list[bytes] = []\n        remaining = before.st_size\n        while remaining:\n            chunk = os.read(descriptor, min(remaining, 1024 * 1024))\n            _require(bool(chunk), f\"{label} changed while being read\")\n            chunks.append(chunk)\n            remaining -= len(chunk)\n        _require(os.read(descriptor, 1) == b\"\", f\"{label} grew while being read\")\n        after = os.fstat(descriptor)\n        _require(\n            (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)\n            == (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns),\n            f\"{label} changed while being read\",\n        )\n        return b\"\".join(chunks)\n    finally:\n        os.close(descriptor)\n\n\ndef _load_json_artifact(path: pathlib.Path, label: str) -> RawJsonArtifact:\n    raw = _read_regular_bytes(path, label)\n    try:\n        value = json.loads(\n            raw.decode(\"utf-8\"),\n            object_pairs_hook=_duplicate_key_guard,\n            parse_constant=_reject_non_json_constant,\n        )\n    except PowerV4Error:\n        raise\n    except (UnicodeError, ValueError) as exc:\n        raise PowerV4Error(f\"{label} is not strict UTF-8 JSON: {exc}\") from exc\n    _require(isinstance(value, dict), f\"{label} root must be an object\")\n    return RawJsonArtifact(\n        path=path,\n        raw_bytes=raw,\n        value=value,\n        sha256=hashlib.sha256(raw).hexdigest(),\n    )\n\n\ndef load_calibration(path: pathlib.Path) -> dict[str, Any]:\n    return _load_json_artifact(path, \"calibration\").value\n\n\ndef load_power_report(path: pathlib.Path) -> dict[str, Any]:\n    return _load_json_artifact(path, \"power report\").value\n\n\ndef load_artifact_bundle(\n    *,\n    product_cycle: pathlib.Path,\n    task_population: pathlib.Path,\n    review_ledger: pathlib.Path,\n    selection_receipt: pathlib.Path,\n    assignment_receipt: pathlib.Path,\n    overlap_receipt: pathlib.Path,\n    candidate_lock_receipt: pathlib.Path,\n    owner_approval_receipt: pathlib.Path | None,\n) -> ArtifactBundle:\n    artifacts = {\n        \"product_cycle\": _load_json_artifact(product_cycle, \"product-cycle evidence\"),\n        \"task_population\": _load_json_artifact(task_population, \"task-population contract\"),\n        \"review_ledger\": _load_json_artifact(review_ledger, \"task-review ledger\"),\n        \"selection_receipt\": _load_json_artifact(selection_receipt, \"selection receipt\"),\n        \"assignment_receipt\": _load_json_artifact(assignment_receipt, \"assignment receipt\"),\n        \"overlap_receipt\": _load_json_artifact(overlap_receipt, \"overlap receipt\"),\n        \"candidate_lock_receipt\": _load_json_artifact(\n            candidate_lock_receipt, \"candidate-lock receipt\"\n        ),\n    }\n    approval = (\n        _load_json_artifact(owner_approval_receipt, \"owner-approval receipt\")\n        if owner_approval_receipt is not None\n        else None\n    )\n    schemas = {\n        name: _load_json_artifact(path, f\"{name} schema\")\n        for name, path in SCHEMA_PATHS.items()\n    }\n    try:\n        validator = DRAFT.Validator(\n            [\n                DRAFT.SchemaDocument(artifact.path.name, artifact.value)\n                for artifact in schemas.values()\n            ]\n        )\n        validator.validate(\n            artifacts[\"product_cycle\"].value,\n            SCHEMA_PATHS[\"product_cycle\"].name,\n            label=\"product-cycle evidence\",\n        )\n        validator.validate(\n            artifacts[\"task_population\"].value,\n            SCHEMA_PATHS[\"task_population\"].name,\n            label=\"task-population contract\",\n        )\n        validator.validate(\n            artifacts[\"review_ledger\"].value,\n            SCHEMA_PATHS[\"review_ledger\"].name,\n            label=\"task-review ledger\",\n        )\n        for kind in (\"selection\", \"assignment\", \"overlap\"):\n            validator.validate(\n                artifacts[f\"{kind}_receipt\"].value,\n                SCHEMA_PATHS[\"population_receipt\"].name,\n                label=f\"{kind} receipt\",\n            )\n        validator.validate(\n            artifacts[\"candidate_lock_receipt\"].value,\n            SCHEMA_PATHS[\"candidate_lock_receipt\"].name,\n            label=\"candidate-lock receipt\",\n        )\n        if approval is not None:\n            validator.validate(\n                approval.value,\n                SCHEMA_PATHS[\"owner_approval_receipt\"].name,\n                label=\"owner-approval receipt\",\n            )\n    except DRAFT.SchemaError as exc:\n        raise PowerV4Error(str(exc)) from exc\n    try:\n        TASK_POPULATION.validate_population(\n            artifacts[\"task_population\"].value,\n            artifacts[\"review_ledger\"].value,\n            population_schema=SCHEMA_PATHS[\"task_population\"],\n            review_schema=SCHEMA_PATHS[\"review_ledger\"],\n        )\n    except TASK_POPULATION.TaskPopulationError as exc:\n        raise PowerV4Error(f\"task-population validation failed: {exc}\") from exc\n    return ArtifactBundle(\n        product_cycle=artifacts[\"product_cycle\"],\n        task_population=artifacts[\"task_population\"],\n        review_ledger=artifacts[\"review_ledger\"],\n        selection_receipt=artifacts[\"selection_receipt\"],\n        assignment_receipt=artifacts[\"assignment_receipt\"],\n        overlap_receipt=artifacts[\"overlap_receipt\"],\n        candidate_lock_receipt=artifacts[\"candidate_lock_receipt\"],\n        owner_approval_receipt=approval,\n        schemas=schemas,\n        schema_validator=validator,\n    )\n\n\ndef _exact_keys(value: Any, expected: set[str], label: str) -> dict[str, Any]:\n    _require(isinstance(value, dict), f\"{label} must be an object\")\n    actual = set(value)\n    missing = sorted(expected - actual)\n    extra = sorted(actual - expected)\n    _require(not missing and not extra, f\"{label} fields mismatch: missing={missing}, extra={extra}\")\n    return value\n\n\ndef _sha256(value: Any, label: str) -> str:\n    try:\n        return PRODUCT._sha256(value, label)\n    except PRODUCT.ProductCycleError as exc:\n        raise PowerV4Error(str(exc)) from exc\n\n\ndef _self_sha256(value: Mapping[str, Any], field: str = \"identity_sha256\") -> str:\n    return PRODUCT.self_sha256(value, field)\n\n\ndef _nonempty(value: Any, label: str) -> str:\n    _require(isinstance(value, str) and bool(value), f\"{label} must be a non-empty string\")\n    return value\n\n\ndef _positive_int(value: Any, label: str, *, maximum: int | None = None) -> int:\n    _require(type(value) is int and value > 0, f\"{label} must be a positive integer\")\n    if maximum is not None:\n        _require(value <= maximum, f\"{label} exceeds {maximum}\")\n    return value\n\n\ndef _finite(value: Any, label: str) -> float:\n    _require(type(value) in {int, float}, f\"{label} must be a finite number\")\n    rendered = float(value)\n    _require(math.isfinite(rendered), f\"{label} must be finite\")\n    return rendered\n\n\ndef _stable_float(value: float | Decimal) -> float:\n    rendered = float(value)\n    _require(math.isfinite(rendered), \"analysis produced a non-finite result\")\n    return float(format(rendered, \".12g\"))\n\n\ndef _task_identity_sha256(task_id: str) -> str:\n    return hashlib.sha256(\n        b\"entire-brain/task-population-v2/task-id\\0\" + task_id.encode(\"utf-8\")\n    ).hexdigest()\n\n\ndef _population_receipt_subject_sha256(\n    population: Mapping[str, Any], kind: str\n) -> str:\n    \"\"\"Bind verified population outputs without creating receipt hash cycles.\"\"\"\n    _require(\n        kind in {\"selection\", \"assignment\", \"overlap_commitment\"},\n        \"population receipt kind is invalid\",\n    )\n    projected = copy.deepcopy(dict(population))\n    _require(\n        \"population_sha256\" in projected\n        and isinstance(projected.get(\"selection_policy\"), dict)\n        and isinstance(projected.get(\"split_policy\"), dict),\n        \"population receipt subject is incomplete\",\n    )\n    # Each receipt attests the entire final population: selected universe,\n    # member_ref->membership assignments, overlap commitments, relation edges,\n    # review-ledger identity, and derived summary.  Only the self hash and raw\n    # receipt hashes are nulled, because including them would be circular.\n    projected[\"population_sha256\"] = None\n    projected[\"selection_policy\"][\"selection_receipt_sha256\"] = None\n    projected[\"split_policy\"][\"assignment_receipt_sha256\"] = None\n    projected[\"split_policy\"][\"overlap_commitment_receipt_sha256\"] = None\n    return PRODUCT.value_sha256(\n        {\n            \"schema\": POPULATION_RECEIPT_SUBJECT_SCHEMA,\n            \"kind\": kind,\n            \"population\": projected,\n        }\n    )\n\n\ndef _validate_population_receipt(\n    artifact: RawJsonArtifact,\n    *,\n    expected_kind: str,\n    expected_subject_sha256: str,\n) -> None:\n    receipt = artifact.value\n    _require(receipt[\"kind\"] == expected_kind, f\"{expected_kind} receipt kind drift\")\n    _require(receipt[\"status\"] == \"verified\", f\"{expected_kind} receipt is not verified\")\n    _require(\n        receipt[\"authentication_status\"] == NO_TRUST_ANCHOR,\n        f\"{expected_kind} receipt authentication status drift\",\n    )\n    _require(\n        receipt[\"verification_subject_schema\"]\n        == POPULATION_RECEIPT_SUBJECT_SCHEMA,\n        f\"{expected_kind} receipt subject schema drift\",\n    )\n    _require(\n        receipt[\"verification_subject_sha256\"] == expected_subject_sha256,\n        f\"{expected_kind} receipt subject drift\",\n    )\n    _require(\n        receipt[\"identity_sha256\"] == _self_sha256(receipt),\n        f\"{expected_kind} receipt identity hash mismatch\",\n    )\n\n\ndef _independence_clusters(\n    population: Mapping[str, Any], calibration_members: Sequence[Mapping[str, Any]]\n) -> tuple[dict[str, str], str]:\n    # Build the graph over the full validated population.  Projecting first\n    # would miss A--excluded-X--B paths and falsely call A and B independent.\n    refs = {str(member[\"member_ref\"]): member for member in population[\"members\"]}\n    active_refs = {str(member[\"member_ref\"]) for member in calibration_members}\n    parent = {ref: ref for ref in refs}\n\n    def find(ref: str) -> str:\n        while parent[ref] != ref:\n            parent[ref] = parent[parent[ref]]\n            ref = parent[ref]\n        return ref\n"},"started_at_ms":1789839590825,"completed_at_ms":1789839590825}}
{"timestamp":"2026-09-19T17:39:50.876Z","ordinal":7533,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0bac0-c5dc-7cd1-8443-bc0f1b291951","call_id":"call_rqkhQeucaxwOxCwOOairVOx6","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"31d20f\",\"wall_time_seconds\":0.000002583,\"exit_code\":0,\"original_token_count\":873,\"output\":\"            \\\"required_statistics\\\": {\\n                \\\"elapsed_time\\\": \\\"SD of paired task-level mean log ratios\\\",\\n                \\\"normalized_cost\\\": \\\"paired task-arm mean-cost rows for a task-clustered equal-weight ratio-of-means bootstrap\\\",\\n                \\\"code_quality\\\": \\\"SD of paired task-level mean differences\\\",\\n                \\\"dependence\\\": \\\"joint covariance or retained task-level calibration rows\\\",\\n            },\\n            \\\"minimum_independent_task_clusters\\\": MINIMUM_CALIBRATION_TASK_CLUSTERS,\\n            \\\"minimum_is_calibration_floor_not_power_sized_design\\\": True,\\n            \\\"selection_use\\\": \\\"development calibration only; cannot enter confirmatory outcomes\\\",\\n        },\\n        \\\"design_readiness\\\": {\\n            \\\"provisional_tasks\\\": TASKS,\\n            \\\"provisional_repetitions_per_treatment\\\": REPETITIONS,\\n            \\\"provisional_requested_cells\\\": REQUESTED_CELLS,\\n            \\\"maximum_agent_invocations\\\": MAXIMUM_AGENT_INVOCATIONS,\\n            \\\"agent_retry_limit\\\": AGENT_RETRY_LIMIT,\\n            \\\"replacement_cell_limit\\\": REPLACEMENT_CELL_LIMIT,\\n            \\\"provisional_design_power_defensible\\\": False,\\n            \\\"power_sized_development_task_count\\\": None,\\n            \\\"power_sized_confirmatory_task_count\\\": None,\\n            \\\"reason\\\": \\\"no owner-frozen alternatives or final-contract calibration support a numeric task count\\\",\\n        },\\n        \\\"exploratory_calibration\\\": calibration,\\n        \\\"empirical_variance_used_in_confirmatory_decision\\\": False,\\n        \\\"status\\\": PENDING_POWER_STATUS,\\n        \\\"decision\\\": {\\n            \\\"passed\\\": False,\\n            \\\"reason\\\": PENDING_REASON,\\n            \\\"prohibited_until_resolved\\\": [\\n                \\\"mark power_target_met pass\\\",\\n                \\\"freeze practical floors or planning alternatives without owner approval\\\",\\n                \\\"seal or open the fresh holdout\\\",\\n                \\\"authorize paid confirmatory agent invocations\\\",\\n                \\\"promote legacy two-endpoint sensitivity task counts into the v3 design\\\",\\n            ],\\n        },\\n    }\\n    derived = recompute_power_decision(report)\\n    report[\\\"status\\\"] = derived[\\\"status\\\"]\\n    report[\\\"decision\\\"][\\\"passed\\\"] = derived[\\\"passed\\\"]\\n    report[\\\"decision\\\"][\\\"reason\\\"] = derived[\\\"reason\\\"]\\n    return _round_floats(report)\\n\\n\\ndef main() -> int:\\n    parser = argparse.ArgumentParser()\\n    parser.add_argument(\\n        \\\"--check\\\",\\n        type=pathlib.Path,\\n        help=\\\"fail if this JSON artifact differs semantically from the deterministic report\\\",\\n    )\\n    parser.add_argument(\\n        \\\"--output\\\",\\n        type=pathlib.Path,\\n        help=\\\"write the deterministic JSON report to this path\\\",\\n    )\\n    args = parser.parse_args()\\n    try:\\n        report = build_report()\\n    except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError) as exc:\\n        print(f\\\"ERROR: cannot build deterministic power report: {exc}\\\", file=sys.stderr)\\n        return 2\\n    if args.check is not None:\\n        existing = json.loads(args.check.read_text(encoding=\\\"utf-8\\\"))\\n        if existing != report:\\n            print(f\\\"ERROR: stale power artifact: {args.check}\\\", file=sys.stderr)\\n            return 1\\n        print(f\\\"power artifact is current: {args.check}\\\")\\n        return 0\\n    if args.output is not None:\\n        args.output.write_text(\\n            json.dumps(report, indent=2, sort_keys=True) + \\\"\\\\n\\\", encoding=\\\"utf-8\\\"\\n        )\\n        return 0\\n    print(json.dumps(report, indent=2, sort_keys=True))\\n    return 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    raise SystemExit(main())\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"2343fa\",\"wall_time_seconds\":0.000002125,\"exit_code\":0,\"original_token_count\":3805,\"output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Final development calibration and four-arm power analysis v4.\\n\\nV4 is a standalone development lane.  It consumes a completed product-cycle\\nv1 manifest plus a hash-bound projection of the canonical task-population v2\\ncontract.  It never changes the locked three-arm preregistration or power-v3\\nartifact, authorizes no spend, and makes no provider or model call.\\n\\nPower is estimated with deterministic shared resampling of independent task\\nclusters.  Repetition means are formed inside task/arm before contrasts.  Time\\nuses paired task log ratios, normalized cost preserves the frozen ratio of\\nequal-task-weighted arithmetic arm means, and quality uses paired task mean\\ndifferences.  Joint power is the same-draw frequency of all three endpoints\\nclearing their one-sided bounds; marginal powers are never multiplied.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport argparse\\nfrom collections import defaultdict\\nimport copy\\nfrom dataclasses import dataclass\\nfrom decimal import Decimal\\nimport hashlib\\nimport importlib.util\\nimport json\\nimport math\\nimport os\\nimport pathlib\\nimport stat\\nimport sys\\nfrom typing import Any, Mapping, Sequence\\n\\n\\nHERE = pathlib.Path(__file__).resolve().parent\\nif str(HERE) not in sys.path:\\n    sys.path.insert(0, str(HERE))\\nimport draft202012 as DRAFT  # noqa: E402\\nimport task_population as TASK_POPULATION  # noqa: E402\\n\\nPRODUCT_SPEC = importlib.util.spec_from_file_location(\\n    \\\"power_v4_product_cycle\\\", HERE / \\\"product_cycle.py\\\"\\n)\\nassert PRODUCT_SPEC and PRODUCT_SPEC.loader\\nPRODUCT = importlib.util.module_from_spec(PRODUCT_SPEC)\\nPRODUCT_SPEC.loader.exec_module(PRODUCT)\\n\\nCALIBRATION_SCHEMA = \\\"agent-brain-final-calibration/v1\\\"\\nREPORT_SCHEMA = \\\"agent-brain-power-analysis/v4\\\"\\nTASK_POPULATION_PROFILE = \\\"agent_brain_task_population_v2\\\"\\nMIN_CALIBRATION_CLUSTERS = 12\\nTARGET_POWER = 0.80\\nCONFIDENCE = 0.95\\nMIN_RESAMPLES = 100\\nMAX_RESAMPLES = 10_000\\nMAX_CANDIDATE_CLUSTERS = 512\\nPRODUCTION_RESAMPLES = 10_000\\nPRODUCTION_SEED = 0x4542563453454544\\nPRODUCTION_CANDIDATE_GRID = (\\n    12,\\n    16,\\n    20,\\n    24,\\n    32,\\n    40,\\n    48,\\n    64,\\n    80,\\n    96,\\n    128,\\n    160,\\n    192,\\n    256,\\n    320,\\n    384,\\n    512,\\n)\\nRESAMPLING_METHOD = \\\"paired_cluster_residual_bootstrap_shared_draws_v1\\\"\\nRESAMPLING_DOMAIN = b\\\"entire-brain/power-analysis-v4/shared-cluster-resample\\\\0\\\"\\nPRIMARY_COMPARISON = \\\"retrieved_memory_vs_no_memory\\\"\\nDIAGNOSTIC_COMPARISON = \\\"retrieved_memory_vs_preoptimization_memory\\\"\\nENDPOINTS = (\\\"elapsed_time\\\", \\\"normalized_cost\\\", \\\"code_quality\\\")\\nMAX_JSON_BYTES = 64 * 1024 * 1024\\nNO_TRUST_ANCHOR = \\\"unauthenticated_no_trust_anchor_fail_closed\\\"\\nPOPULATION_RECEIPT_SUBJECT_SCHEMA = (\\n    \\\"agent-brain-task-population-verification-subject/full-population-v1\\\"\\n)\\nSCHEMA_PATHS = {\\n    \\\"product_cycle\\\": HERE / \\\"schemas\\\" / \\\"product-cycle-v1.schema.json\\\",\\n    \\\"task_population\\\": HERE / \\\"schemas\\\" / \\\"task-population-v2.schema.json\\\",\\n    \\\"review_ledger\\\": HERE.parent / \\\"schemas\\\" / \\\"task-review-ledger-v2.schema.json\\\",\\n    \\\"final_calibration\\\": HERE / \\\"schemas\\\" / \\\"final-calibration-v1.schema.json\\\",\\n    \\\"power_report\\\": HERE / \\\"schemas\\\" / \\\"power-analysis-v4.schema.json\\\",\\n    \\\"population_receipt\\\": HERE / \\\"schemas\\\" / \\\"task-population-verification-receipt-v1.schema.json\\\",\\n    \\\"candidate_lock_receipt\\\": HERE / \\\"schemas\\\" / \\\"candidate-lock-receipt-v1.schema.json\\\",\\n    \\\"owner_approval_receipt\\\": HERE / \\\"schemas\\\" / \\\"owner-approval-receipt-v1.schema.json\\\",\\n}\\n\\n\\nclass PowerV4Error(ValueError):\\n    \\\"\\\"\\\"Raised when calibration or power evidence cannot safely be used.\\\"\\\"\\\"\\n\\n\\n@dataclass(frozen=True)\\nclass RawJsonArtifact:\\n    path: pathlib.Path\\n    raw_bytes: bytes\\n    value: dict[str, Any]\\n    sha256: str\\n\\n\\n@dataclass(frozen=True)\\nclass ArtifactBundle:\\n    product_cycle: RawJsonArtifact\\n    task_population: RawJsonArtifact\\n    review_ledger: RawJsonArtifact\\n    selection_receipt: RawJsonArtifact\\n    assignment_receipt: RawJsonArtifact\\n    overlap_receipt: RawJsonArtifact\\n    candidate_lock_receipt: RawJsonArtifact\\n    owner_approval_receipt: RawJsonArtifact | None\\n    schemas: Mapping[str, RawJsonArtifact]\\n    schema_validator: DRAFT.Validator\\n\\n\\ndef _require(condition: bool, message: str) -> None:\\n    if not condition:\\n        raise PowerV4Error(message)\\n\\n\\ndef _duplicate_key_guard(pairs: list[tuple[str, Any]]) -> dict[str, Any]:\\n    value: dict[str, Any] = {}\\n    for key, item in pairs:\\n        _require(key not in value, \\\"JSON contains a duplicate object key\\\")\\n        value[key] = item\\n    return value\\n\\n\\ndef _reject_non_json_constant(value: str) -> None:\\n    raise ValueError(f\\\"non-JSON numeric constant {value!r}\\\")\\n\\n\\ndef _read_regular_bytes(path: pathlib.Path, label: str) -> bytes:\\n    flags = os.O_RDONLY | getattr(os, \\\"O_CLOEXEC\\\", 0) | getattr(os, \\\"O_NOFOLLOW\\\", 0)\\n    try:\\n        descriptor = os.open(path, flags)\\n    except OSError as exc:\\n        raise PowerV4Error(f\\\"{label} cannot be opened safely: {exc}\\\") from exc\\n    try:\\n        before = os.fstat(descriptor)\\n        _require(stat.S_ISREG(before.st_mode), f\\\"{label} must be a regular file\\\")\\n        _require(before.st_size <= MAX_JSON_BYTES, f\\\"{label} exceeds the size bound\\\")\\n        chunks: list[bytes] = []\\n        remaining = before.st_size\\n        while remaining:\\n            chunk = os.read(descriptor, min(remaining, 1024 * 1024))\\n            _require(bool(chunk), f\\\"{label} changed while being read\\\")\\n            chunks.append(chunk)\\n            remaining -= len(chunk)\\n        _require(os.read(descriptor, 1) == b\\\"\\\", f\\\"{label} grew while being read\\\")\\n        after = os.fstat(descriptor)\\n        _require(\\n            (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)\\n            == (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns),\\n            f\\\"{label} changed while being read\\\",\\n        )\\n        return b\\\"\\\".join(chunks)\\n    finally:\\n        os.close(descriptor)\\n\\n\\ndef _load_json_artifact(path: pathlib.Path, label: str) -> RawJsonArtifact:\\n    raw = _read_regular_bytes(path, label)\\n    try:\\n        value = json.loads(\\n            raw.decode(\\\"utf-8\\\"),\\n            object_pairs_hook=_duplicate_key_guard,\\n            parse_constant=_reject_non_json_constant,\\n        )\\n    except PowerV4Error:\\n        raise\\n    except (UnicodeError, ValueError) as exc:\\n        raise PowerV4Error(f\\\"{label} is not strict UTF-8 JSON: {exc}\\\") from exc\\n    _require(isinstance(value, dict), f\\\"{label} root must be an object\\\")\\n    return RawJsonArtifact(\\n        path=path,\\n        raw_bytes=raw,\\n        value=value,\\n        sha256=hashlib.sha256(raw).hexdigest(),\\n    )\\n\\n\\ndef load_calibration(path: pathlib.Path) -> dict[str, Any]:\\n    return _load_json_artifact(path, \\\"calibration\\\").value\\n\\n\\ndef load_power_report(path: pathlib.Path) -> dict[str, Any]:\\n    return _load_json_artifact(path, \\\"power report\\\").value\\n\\n\\ndef load_artifact_bundle(\\n    *,\\n    product_cycle: pathlib.Path,\\n    task_population: pathlib.Path,\\n    review_ledger: pathlib.Path,\\n    selection_receipt: pathlib.Path,\\n    assignment_receipt: pathlib.Path,\\n    overlap_receipt: pathlib.Path,\\n    candidate_lock_receipt: pathlib.Path,\\n    owner_approval_receipt: pathlib.Path | None,\\n) -> ArtifactBundle:\\n    artifacts = {\\n        \\\"product_cycle\\\": _load_json_artifact(product_cycle, \\\"product-cycle evidence\\\"),\\n        \\\"task_population\\\": _load_json_artifact(task_population, \\\"task-population contract\\\"),\\n        \\\"review_ledger\\\": _load_json_artifact(review_ledger, \\\"task-review ledger\\\"),\\n        \\\"selection_receipt\\\": _load_json_artifact(selection_receipt, \\\"selection receipt\\\"),\\n        \\\"assignment_receipt\\\": _load_json_artifact(assignment_receipt, \\\"assignment receipt\\\"),\\n        \\\"overlap_receipt\\\": _load_json_artifact(overlap_receipt, \\\"overlap receipt\\\"),\\n        \\\"candidate_lock_receipt\\\": _load_json_artifact(\\n            candidate_lock_receipt, \\\"candidate-lock receipt\\\"\\n        ),\\n    }\\n    approval = (\\n        _load_json_artifact(owner_approval_receipt, \\\"owner-approval receipt\\\")\\n        if owner_approval_receipt is not None\\n        else None\\n    )\\n    schemas = {\\n        name: _load_json_artifact(path, f\\\"{name} schema\\\")\\n        for name, path in SCHEMA_PATHS.items()\\n    }\\n    try:\\n        validator = DRAFT.Validator(\\n            [\\n                DRAFT.SchemaDocument(artifact.path.name, artifact.value)\\n                for artifact in schemas.values()\\n            ]\\n        )\\n        validator.validate(\\n            artifacts[\\\"product_cycle\\\"].value,\\n            SCHEMA_PATHS[\\\"product_cycle\\\"].name,\\n            label=\\\"product-cycle evidence\\\",\\n        )\\n        validator.validate(\\n            artifacts[\\\"task_population\\\"].value,\\n            SCHEMA_PATHS[\\\"task_population\\\"].name,\\n            label=\\\"task-population contract\\\",\\n        )\\n        validator.validate(\\n            artifacts[\\\"review_ledger\\\"].value,\\n            SCHEMA_PATHS[\\\"review_ledger\\\"].name,\\n            label=\\\"task-review ledger\\\",\\n        )\\n        for kind in (\\\"selection\\\", \\\"assignment\\\", \\\"overlap\\\"):\\n            validator.validate(\\n                artifacts[f\\\"{kind}_receipt\\\"].value,\\n                SCHEMA_PATHS[\\\"population_receipt\\\"].name,\\n                label=f\\\"{kind} receipt\\\",\\n            )\\n        validator.validate(\\n            artifacts[\\\"candidate_lock_receipt\\\"].value,\\n            SCHEMA_PATHS[\\\"candidate_lock_receipt\\\"].name,\\n            label=\\\"candidate-lock receipt\\\",\\n        )\\n        if approval is not None:\\n            validator.validate(\\n                approval.value,\\n                SCHEMA_PATHS[\\\"owner_approval_receipt\\\"].name,\\n                label=\\\"owner-approval receipt\\\",\\n            )\\n    except DRAFT.SchemaError as exc:\\n        raise PowerV4Error(str(exc)) from exc\\n    try:\\n        TASK_POPULATION.validate_population(\\n            artifacts[\\\"task_population\\\"].value,\\n            artifacts[\\\"review_ledger\\\"].value,\\n            population_schema=SCHEMA_PATHS[\\\"task_population\\\"],\\n            review_schema=SCHEMA_PATHS[\\\"review_ledger\\\"],\\n        )\\n    except TASK_POPULATION.TaskPopulationError as exc:\\n        raise PowerV4Error(f\\\"task-population validation failed: {exc}\\\") from exc\\n    return ArtifactBundle(\\n        product_cycle=artifacts[\\\"product_cycle\\\"],\\n        task_population=artifacts[\\\"task_population\\\"],\\n        review_ledger=artifacts[\\\"review_ledger\\\"],\\n        selection_receipt=artifacts[\\\"selection_receipt\\\"],\\n        assignment_receipt=artifacts[\\\"assignment_receipt\\\"],\\n        overlap_receipt=artifacts[\\\"overlap_receipt\\\"],\\n        candidate_lock_receipt=artifacts[\\\"candidate_lock_receipt\\\"],\\n        owner_approval_receipt=approval,\\n        schemas=schemas,\\n        schema_validator=validator,\\n    )\\n\\n\\ndef _exact_keys(value: Any, expected: set[str], label: str) -> dict[str, Any]:\\n    _require(isinstance(value, dict), f\\\"{label} must be an object\\\")\\n    actual = set(value)\\n    missing = sorted(expected - actual)\\n    extra = sorted(actual - expected)\\n    _require(not missing and not extra, f\\\"{label} fields mismatch: missing={missing}, extra={extra}\\\")\\n    return value\\n\\n\\ndef _sha256(value: Any, label: str) -> str:\\n    try:\\n        return PRODUCT._sha256(value, label)\\n    except PRODUCT.ProductCycleError as exc:\\n        raise PowerV4Error(str(exc)) from exc\\n\\n\\ndef _self_sha256(value: Mapping[str, Any], field: str = \\\"identity_sha256\\\") -> str:\\n    return PRODUCT.self_sha256(value, field)\\n\\n\\ndef _nonempty(value: Any, label: str) -> str:\\n    _require(isinstance(value, str) and bool(value), f\\\"{label} must be a non-empty string\\\")\\n    return value\\n\\n\\ndef _positive_int(value: Any, label: str, *, maximum: int | None = None) -> int:\\n    _require(type(value) is int and value > 0, f\\\"{label} must be a positive integer\\\")\\n    if maximum is not None:\\n        _require(value <= maximum, f\\\"{label} exceeds {maximum}\\\")\\n    return value\\n\\n\\ndef _finite(value: Any, label: str) -> float:\\n    _require(type(value) in {int, float}, f\\\"{label} must be a finite number\\\")\\n    rendered = float(value)\\n    _require(math.isfinite(rendered), f\\\"{label} must be finite\\\")\\n    return rendered\\n\\n\\ndef _stable_float(value: float | Decimal) -> float:\\n    rendered = float(value)\\n    _require(math.isfinite(rendered), \\\"analysis produced a non-finite result\\\")\\n    return float(format(rendered, \\\".12g\\\"))\\n\\n\\ndef _task_identity_sha256(task_id: str) -> str:\\n    return hashlib.sha256(\\n        b\\\"entire-brain/task-population-v2/task-id\\\\0\\\" + task_id.encode(\\\"utf-8\\\")\\n    ).hexdigest()\\n\\n\\ndef _population_receipt_subject_sha256(\\n    population: Mapping[str, Any], kind: str\\n) -> str:\\n    \\\"\\\"\\\"Bind verified population outputs without creating receipt hash cycles.\\\"\\\"\\\"\\n    _require(\\n        kind in {\\\"selection\\\", \\\"assignment\\\", \\\"overlap_commitment\\\"},\\n        \\\"population receipt kind is invalid\\\",\\n    )\\n    projected = copy.deepcopy(dict(population))\\n    _require(\\n        \\\"population_sha256\\\" in projected\\n        and isinstance(projected.get(\\\"selection_policy\\\"), dict)\\n        and isinstance(projected.get(\\\"split_policy\\\"), dict),\\n        \\\"population receipt subject is incomplete\\\",\\n    )\\n    # Each receipt attests the entire final population: selected universe,\\n    # member_ref->membership assignments, overlap commitments, relation edges,\\n    # review-ledger identity, and derived summary.  Only the self hash and raw\\n    # receipt hashes are nulled, because including them would be circular.\\n    projected[\\\"population_sha256\\\"] = None\\n    projected[\\\"selection_policy\\\"][\\\"selection_receipt_sha256\\\"] = None\\n    projected[\\\"split_policy\\\"][\\\"assignment_receipt_sha256\\\"] = None\\n    projected[\\\"split_policy\\\"][\\\"overlap_commitment_receipt_sha256\\\"] = None\\n    return PRODUCT.value_sha256(\\n        {\\n            \\\"schema\\\": POPULATION_RECEIPT_SUBJECT_SCHEMA,\\n            \\\"kind\\\": kind,\\n            \\\"population\\\": projected,\\n        }\\n    )\\n\\n\\ndef _validate_population_receipt(\\n    artifact: RawJsonArtifact,\\n    *,\\n    expected_kind: str,\\n    expected_subject_sha256: str,\\n) -> None:\\n    receipt = artifact.value\\n    _require(receipt[\\\"kind\\\"] == expected_kind, f\\\"{expected_kind} receipt kind drift\\\")\\n    _require(receipt[\\\"status\\\"] == \\\"verified\\\", f\\\"{expected_kind} receipt is not verified\\\")\\n    _require(\\n        receipt[\\\"authentication_status\\\"] == NO_TRUST_ANCHOR,\\n        f\\\"{expected_kind} receipt authentication status drift\\\",\\n    )\\n    _require(\\n        receipt[\\\"verification_subject_schema\\\"]\\n        == POPULATION_RECEIPT_SUBJECT_SCHEMA,\\n        f\\\"{expected_kind} receipt subject schema drift\\\",\\n    )\\n    _require(\\n        receipt[\\\"verification_subject_sha256\\\"] == expected_subject_sha256,\\n        f\\\"{expected_kind} receipt subject drift\\\",\\n    )\\n    _require(\\n        receipt[\\\"identity_sha256\\\"] == _self_sha256(receipt),\\n        f\\\"{expected_kind} receipt identity hash mismatch\\\",\\n    )\\n\\n\\ndef _independence_clusters(\\n    population: Mapping[str, Any], calibration_members: Sequence[Mapping[str, Any]]\\n) -> tuple[dict[str, str], str]:\\n    # Build the graph over the full validated population.  Projecting first\\n    # would miss A--excluded-X--B paths and falsely call A and B independent.\\n    refs = {str(member[\\\"member_ref\\\"]): member for member in population[\\\"members\\\"]}\\n    active_refs = {str(member[\\\"member_ref\\\"]) for member in calibration_members}\\n    parent = {ref: ref for ref in refs}\\n\\n    def find(ref: str) -> str:\\n        while parent[ref] != ref:\\n            parent[ref] = parent[parent[ref]]\\n            ref = parent[ref]\\n        return ref\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839590.876722}}}
