{"timestamp":"2026-09-19T17:38:58.202Z","ordinal":7487,"type":"token_usage_record","payload":{"thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","session_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","root_turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","response_id":"resp_0cb48b2b18d09e75016aaec8ac996487d2b1edb532d49547d8","usage":{"input_tokens":80342,"cached_input_tokens":74496,"cache_write_input_tokens":0,"output_tokens":129,"reasoning_output_tokens":21,"total_tokens":80471},"turn_token_usage":{"input_tokens":71847894,"cached_input_tokens":68753536,"cache_write_input_tokens":0,"output_tokens":170770,"reasoning_output_tokens":14480,"total_tokens":72018664},"thread_token_usage":{"input_tokens":137732913,"cached_input_tokens":131325568,"cache_write_input_tokens":0,"output_tokens":355569,"reasoning_output_tokens":35857,"total_tokens":138088482}}}
{"timestamp":"2026-09-19T17:38:58.234Z","ordinal":7488,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","item":{"type":"CommandExecution","id":"exec-9eee25c1-e44f-4ced-8cb8-ceda19499a14","process_id":"11868","command":["/bin/zsh","-lc","sed -n '1,560p' benchmarks/agent-brain/confirmatory/relevance_dataset.py"],"cwd":"file:///Users/thomi/.codex/worktrees/5d33/entire-brain","parsed_cmd":[{"type":"read","cmd":"sed -n '1,560p' benchmarks/agent-brain/confirmatory/relevance_dataset.py","name":"relevance_dataset.py","path":"benchmarks/agent-brain/confirmatory/relevance_dataset.py"}],"source":"unified_exec_startup","status":"completed","stdout":"#!/usr/bin/env python3\n\"\"\"Build and verify the exposed-only offline relevance development dataset.\n\nLabels are human-reviewed source records.  This tool joins them to the reconciled task inventory\nand a content-addressed excerpt of the frozen fact corpus, deriving query/fact hashes, kinds, and\nrolling-cutoff eligibility.  It never reads a task outside the explicit development assignment and\nthe allowed exposed inventory states.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport copy\nimport datetime as dt\nimport hashlib\nimport json\nimport math\nimport pathlib\nimport re\nimport sys\nfrom collections import Counter\nfrom typing import Any\n\n\nSCHEMA_VERSION = 2\nSOURCE_MEMBERSHIP_SCHEMA_VERSION = 2\nSOURCE_CONTRACT_SCHEMA_VERSION = 2\nSAFE_STATES = (\"prompt_inspected\", \"retrieval_probed\", \"agent_run\", \"optimization_used\")\nGRADES = (\"solving\", \"relevant_alternative\", \"hard_topical_distractor\", \"irrelevant\")\nQUERY_SOURCES = (\"user_prompt_derived\", \"oracle_upper_bound\")\nEVIDENCE_TYPES = (\"legacy_agent_packet\", \"manual_frozen_corpus_review\")\nNULL_CLOSURE_METHOD = \"exhaustive_active_corpus_review_v2\"\nREVIEW_METHOD = \"manual_judgment_from_exposed_prompt_and_pinned_membership_v1\"\nSTOPWORDS = {\n    \"a\", \"an\", \"and\", \"are\", \"as\", \"at\", \"be\", \"by\", \"for\", \"from\", \"has\", \"in\", \"is\",\n    \"it\", \"of\", \"on\", \"or\", \"that\", \"the\", \"their\", \"this\", \"to\", \"was\", \"when\", \"with\",\n}\n\n\nclass DatasetError(ValueError):\n    \"\"\"A fail-closed dataset contract violation.\"\"\"\n\n\ndef sha256_bytes(value: bytes) -> str:\n    return hashlib.sha256(value).hexdigest()\n\n\ndef sha256_text(value: str) -> str:\n    return sha256_bytes(value.encode(\"utf-8\"))\n\n\ndef canonical_json(value: Any) -> bytes:\n    return json.dumps(value, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False).encode(\"utf-8\")\n\n\ndef fact_sha256(fact: dict[str, Any]) -> str:\n    return sha256_bytes(canonical_json(fact))\n\n\ndef fact_catalog_sha256(facts: list[dict[str, Any]]) -> str:\n    records = sorted(\n        ({\"fact_id\": str(fact.get(\"id\") or \"\"), \"fact_sha256\": fact_sha256(fact)} for fact in facts),\n        key=lambda record: record[\"fact_id\"],\n    )\n    if any(not record[\"fact_id\"] for record in records):\n        raise DatasetError(\"fact catalog contains an empty fact id\")\n    if len({record[\"fact_id\"] for record in records}) != len(records):\n        raise DatasetError(\"fact catalog contains duplicate fact ids\")\n    return sha256_bytes(canonical_json(records))\n\n\ndef _provenance_session_ids(fact: dict[str, Any]) -> list[str]:\n    \"\"\"Return the canonical provenance IDs, or an empty list for any malformed provenance.\"\"\"\n    provenance = fact.get(\"provenance\")\n    if not isinstance(provenance, list) or not provenance:\n        return []\n    session_ids: list[str] = []\n    for anchor in provenance:\n        if not isinstance(anchor, dict):\n            return []\n        session_id = str(anchor.get(\"session_id\") or \"\").strip()\n        if not session_id:\n            return []\n        session_ids.append(session_id)\n    return sorted(set(session_ids))\n\n\ndef _membership_fact_records(facts: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    records = sorted(({\n        \"fact_id\": str(fact.get(\"id\") or \"\"),\n        \"fact_sha256\": fact_sha256(fact),\n        \"status\": str(fact.get(\"status\") or \"\"),\n        \"provenance_session_ids\": _provenance_session_ids(fact),\n    } for fact in facts), key=lambda record: record[\"fact_id\"])\n    if any(not record[\"fact_id\"] or not record[\"status\"] for record in records):\n        raise DatasetError(\"source membership contains an empty fact id or status\")\n    if len({record[\"fact_id\"] for record in records}) != len(records):\n        raise DatasetError(\"source membership contains duplicate fact ids\")\n    return records\n\n\ndef fact_membership_root_sha256(records: list[dict[str, Any]]) -> str:\n    normalized = sorted(({\n        \"fact_id\": str(record.get(\"fact_id\") or \"\"),\n        \"fact_sha256\": str(record.get(\"fact_sha256\") or \"\"),\n        \"status\": str(record.get(\"status\") or \"\"),\n    } for record in records), key=lambda record: record[\"fact_id\"])\n    if any(\n        not record[\"fact_id\"] or not _is_sha256(record[\"fact_sha256\"]) or not record[\"status\"]\n        for record in normalized\n    ):\n        raise DatasetError(\"source membership fact record is malformed\")\n    if len({record[\"fact_id\"] for record in normalized}) != len(normalized):\n        raise DatasetError(\"source membership contains duplicate fact ids\")\n    return sha256_bytes(canonical_json(normalized))\n\n\ndef eligibility_membership_root_sha256(records: list[dict[str, Any]]) -> str:\n    normalized: list[dict[str, Any]] = []\n    for record in records:\n        session_ids = record.get(\"provenance_session_ids\")\n        if not isinstance(session_ids, list) or not all(\n            isinstance(session_id, str) and bool(session_id) for session_id in session_ids\n        ):\n            raise DatasetError(\"source eligibility membership provenance is malformed\")\n        if session_ids != sorted(set(session_ids)):\n            raise DatasetError(\"source eligibility membership provenance is not canonical\")\n        normalized.append({\n            \"fact_id\": str(record.get(\"fact_id\") or \"\"),\n            \"fact_sha256\": str(record.get(\"fact_sha256\") or \"\"),\n            \"status\": str(record.get(\"status\") or \"\"),\n            \"provenance_session_ids\": session_ids,\n        })\n    normalized.sort(key=lambda record: record[\"fact_id\"])\n    if any(\n        not record[\"fact_id\"] or not _is_sha256(record[\"fact_sha256\"]) or not record[\"status\"]\n        for record in normalized\n    ):\n        raise DatasetError(\"source eligibility membership fact record is malformed\")\n    if len({record[\"fact_id\"] for record in normalized}) != len(normalized):\n        raise DatasetError(\"source eligibility membership contains duplicate fact ids\")\n    return sha256_bytes(canonical_json(normalized))\n\n\ndef fact_record_catalog_sha256(records: list[dict[str, Any]], *, status: str | None = None) -> str:\n    selected = [record for record in records if status is None or record.get(\"status\") == status]\n    normalized = sorted(({\n        \"fact_id\": str(record.get(\"fact_id\") or \"\"),\n        \"fact_sha256\": str(record.get(\"fact_sha256\") or \"\"),\n    } for record in selected), key=lambda record: record[\"fact_id\"])\n    if any(not record[\"fact_id\"] or not _is_sha256(record[\"fact_sha256\"]) for record in normalized):\n        raise DatasetError(\"source membership fact catalog record is malformed\")\n    if len({record[\"fact_id\"] for record in normalized}) != len(normalized):\n        raise DatasetError(\"source membership fact catalog contains duplicate ids\")\n    return sha256_bytes(canonical_json(normalized))\n\n\ndef session_date_membership_root_sha256(session_dates: dict[str, Any]) -> str:\n    normalized: dict[str, str] = {}\n    for session_id, value in session_dates.items():\n        if not isinstance(session_id, str) or not session_id or not isinstance(value, str):\n            raise DatasetError(\"source membership session-date record is malformed\")\n        _parse_time(value, f\"source membership session date {session_id}\")\n        normalized[session_id] = value\n    return sha256_bytes(canonical_json(normalized))\n\n\ndef build_source_membership(\n    facts: list[dict[str, Any]],\n    session_dates: dict[str, str],\n    facts_source_sha256: str,\n    session_dates_source_sha256: str,\n) -> dict[str, Any]:\n    \"\"\"Build a complete authenticated ID/hash/status and session/date catalog.\"\"\"\n    records = _membership_fact_records(facts)\n    active = [record for record in records if record[\"status\"] == \"active\"]\n    return {\n        \"schema_version\": SOURCE_MEMBERSHIP_SCHEMA_VERSION,\n        \"source_facts_sha256\": facts_source_sha256,\n        \"source_session_dates_sha256\": session_dates_source_sha256,\n        \"fact_count\": len(records),\n        \"active_fact_count\": len(active),\n        \"fact_membership_root_sha256\": fact_membership_root_sha256(records),\n        \"eligibility_membership_root_sha256\": eligibility_membership_root_sha256(records),\n        \"active_fact_catalog_sha256\": fact_record_catalog_sha256(records, status=\"active\"),\n        \"facts\": records,\n        \"session_date_count\": len(session_dates),\n        \"session_date_membership_root_sha256\": session_date_membership_root_sha256(session_dates),\n        \"session_dates\": dict(sorted(session_dates.items())),\n    }\n\n\ndef build_source_contract(membership_path: str, membership: dict[str, Any], membership_sha256: str) -> dict[str, Any]:\n    \"\"\"Build the small reviewed trust-root document for a complete membership catalog.\"\"\"\n    return {\n        \"schema_version\": SOURCE_CONTRACT_SCHEMA_VERSION,\n        \"contract_id\": \"agent-brain-offline-relevance-source-2026-07-15\",\n        \"membership_path\": membership_path,\n        \"membership_sha256\": membership_sha256,\n        \"source_facts_sha256\": membership[\"source_facts_sha256\"],\n        \"source_session_dates_sha256\": membership[\"source_session_dates_sha256\"],\n        \"fact_count\": membership[\"fact_count\"],\n        \"active_fact_count\": membership[\"active_fact_count\"],\n        \"fact_membership_root_sha256\": membership[\"fact_membership_root_sha256\"],\n        \"eligibility_membership_root_sha256\": membership[\"eligibility_membership_root_sha256\"],\n        \"active_fact_catalog_sha256\": membership[\"active_fact_catalog_sha256\"],\n        \"session_date_count\": membership[\"session_date_count\"],\n        \"session_date_membership_root_sha256\": membership[\"session_date_membership_root_sha256\"],\n    }\n\n\ndef temporal_policy_sha256(cutoff: str, excluded_sessions: list[str]) -> str:\n    return sha256_bytes(canonical_json({\n        \"temporal_cutoff\": cutoff,\n        \"exclude_session_ids\": excluded_sessions,\n    }))\n\n\ndef _is_sha256(value: Any) -> bool:\n    return isinstance(value, str) and re.fullmatch(r\"[0-9a-f]{64}\", value) is not None\n\n\ndef _is_nonnegative_int(value: Any) -> bool:\n    return isinstance(value, int) and not isinstance(value, bool) and value >= 0\n\n\ndef load_json(path: pathlib.Path) -> Any:\n    try:\n        return json.loads(path.read_text())\n    except (OSError, json.JSONDecodeError) as exc:\n        raise DatasetError(f\"cannot read JSON {path}: {exc}\") from exc\n\n\ndef load_facts(path: pathlib.Path) -> list[dict[str, Any]]:\n    facts: list[dict[str, Any]] = []\n    try:\n        lines = path.read_text().splitlines()\n    except OSError as exc:\n        raise DatasetError(f\"cannot read facts {path}: {exc}\") from exc\n    for line_number, line in enumerate(lines, 1):\n        if not line.strip():\n            continue\n        try:\n            fact = json.loads(line)\n        except json.JSONDecodeError as exc:\n            raise DatasetError(f\"invalid fact JSON at {path}:{line_number}: {exc}\") from exc\n        if not isinstance(fact, dict):\n            raise DatasetError(f\"fact at {path}:{line_number} is not an object\")\n        facts.append(fact)\n    return facts\n\n\ndef _parse_time(value: Any, label: str) -> dt.datetime:\n    if not isinstance(value, str) or not value.strip():\n        raise DatasetError(f\"{label} must be a non-empty RFC3339 timestamp\")\n    text = value.strip()\n    if text.endswith((\"Z\", \"z\")):\n        text = text[:-1] + \"+00:00\"\n    try:\n        parsed = dt.datetime.fromisoformat(text)\n    except ValueError as exc:\n        raise DatasetError(f\"{label} is not an RFC3339 timestamp: {value!r}\") from exc\n    if parsed.tzinfo is None or parsed.utcoffset() is None:\n        raise DatasetError(f\"{label} must include an RFC3339 UTC offset: {value!r}\")\n    return parsed\n\n\ndef _unique_index(rows: list[dict[str, Any]], key: str, label: str) -> dict[str, dict[str, Any]]:\n    output: dict[str, dict[str, Any]] = {}\n    for row in rows:\n        value = str(row.get(key) or \"\").strip()\n        if not value:\n            raise DatasetError(f\"{label} row has no {key}\")\n        if value in output:\n            raise DatasetError(f\"duplicate {label} {key}: {value}\")\n        output[value] = row\n    return output\n\n\ndef _eligible(fact: dict[str, Any], session_dates: dict[str, str], cutoff: str,\n              excluded_sessions: set[str]) -> bool:\n    cutoff_at = _parse_time(cutoff, \"temporal cutoff\")\n    session_ids = _provenance_session_ids(fact)\n    if not session_ids:\n        return False\n    if any(session_id in excluded_sessions for session_id in session_ids):\n        return False\n    for session_id in session_ids:\n        created = session_dates.get(session_id)\n        if created is None:\n            return False\n        if not _parse_time(created, f\"session date {session_id}\") < cutoff_at:\n            return False\n    return True\n\n\ndef active_eligible_fact_catalog(\n    membership: dict[str, Any], cutoff: str, excluded_sessions: list[str]\n) -> list[dict[str, str]]:\n    \"\"\"Derive the exact active+eligible ID/hash catalog from authenticated membership metadata.\"\"\"\n    cutoff_at = _parse_time(cutoff, \"temporal cutoff\")\n    excluded = set(excluded_sessions)\n    facts = membership.get(\"facts\")\n    session_dates = membership.get(\"session_dates\")\n    if membership.get(\"schema_version\") != SOURCE_MEMBERSHIP_SCHEMA_VERSION:\n        raise DatasetError(\"null review requires provenance-aware source membership schema\")\n    if not isinstance(facts, list) or not isinstance(session_dates, dict):\n        raise DatasetError(\"null review source membership is malformed\")\n    output: list[dict[str, str]] = []\n    for record in facts:\n        if not isinstance(record, dict) or record.get(\"status\") != \"active\":\n            continue\n        session_ids = record.get(\"provenance_session_ids\")\n        if not isinstance(session_ids, list) or not session_ids:\n            continue\n        if session_ids != sorted(set(session_ids)) or not all(\n            isinstance(session_id, str) and bool(session_id) for session_id in session_ids\n        ):\n            raise DatasetError(\"null review source membership provenance is malformed\")\n        if any(session_id in excluded for session_id in session_ids):\n            continue\n        eligible = True\n        for session_id in session_ids:\n            created = session_dates.get(session_id)\n            if not isinstance(created, str):\n                eligible = False\n                break\n            try:\n                created_at = _parse_time(created, f\"source membership session date {session_id}\")\n            except DatasetError:\n                eligible = False\n                break\n            if not created_at < cutoff_at:\n                eligible = False\n                break\n        if eligible:\n            output.append({\n                \"fact_id\": str(record.get(\"fact_id\") or \"\"),\n                \"fact_sha256\": str(record.get(\"fact_sha256\") or \"\"),\n            })\n    output.sort(key=lambda record: record[\"fact_id\"])\n    fact_record_catalog_sha256(output)\n    return output\n\n\ndef _load_inventory(inventory_path: pathlib.Path) -> dict[str, dict[str, Any]]:\n    inventory = load_json(inventory_path)\n    if not isinstance(inventory, dict) or not isinstance(inventory.get(\"tasks\"), list):\n        raise DatasetError(\"task inventory must contain a tasks array\")\n    rows = _unique_index(inventory[\"tasks\"], \"task_id\", \"inventory\")\n    for task_id, row in rows.items():\n        artifact = row.get(\"artifacts\")\n        if not isinstance(artifact, dict):\n            raise DatasetError(f\"{task_id}: inventory artifacts missing\")\n        config_path = artifact.get(\"config_path\")\n        if not isinstance(config_path, str) or pathlib.PurePosixPath(config_path).is_absolute() or \"..\" in pathlib.PurePosixPath(config_path).parts:\n            raise DatasetError(f\"{task_id}: unsafe config_path\")\n    return rows\n\n\ndef _task_config(repo: pathlib.Path, inventory_row: dict[str, Any]) -> dict[str, Any]:\n    path = repo / inventory_row[\"artifacts\"][\"config_path\"]\n    task_id = str(inventory_row.get(\"task_id\") or \"<unknown>\")\n    if not path.is_file():\n        raise DatasetError(f\"{task_id}: task config does not exist\")\n    if sha256_bytes(path.read_bytes()) != inventory_row[\"artifacts\"].get(\"config_sha256\"):\n        raise DatasetError(f\"{task_id}: task config hash differs from inventory\")\n    config = load_json(path)\n    if not isinstance(config, dict):\n        raise DatasetError(f\"task config {path} is not an object\")\n    return config\n\n\ndef _repo_relative_file(repo: pathlib.Path, value: Any, label: str) -> pathlib.Path:\n    if not isinstance(value, str) or not value:\n        raise DatasetError(f\"{label} path is missing\")\n    relative = pathlib.PurePosixPath(value)\n    if relative.is_absolute() or \"..\" in relative.parts:\n        raise DatasetError(f\"{label} path is unsafe\")\n    target = (repo / pathlib.Path(*relative.parts)).resolve()\n    try:\n        target.relative_to(repo.resolve())\n    except ValueError as exc:\n        raise DatasetError(f\"{label} path escapes the repository\") from exc\n    if not target.is_file():\n        raise DatasetError(f\"{label} path does not exist\")\n    return target\n\n\ndef _snapshot_payload(facts: list[dict[str, Any]], session_dates: dict[str, str], wanted: set[str],\n                      facts_source_sha256: str, session_dates_source_sha256: str) -> dict[str, Any]:\n    fact_index = _unique_index(facts, \"id\", \"fact corpus\")\n    missing = sorted(wanted - set(fact_index))\n    if missing:\n        raise DatasetError(f\"labeled fact ids absent from frozen corpus: {missing}\")\n    selected = [fact_index[fact_id] for fact_id in sorted(wanted)]\n    provenance_ids = sorted({\n        str(anchor.get(\"session_id\") or \"\")\n        for fact in selected\n        for anchor in (fact.get(\"provenance\") or [])\n        if isinstance(anchor, dict) and str(anchor.get(\"session_id\") or \"\")\n    })\n    missing_sessions = sorted(set(provenance_ids) - set(session_dates))\n    if missing_sessions:\n        raise DatasetError(f\"labeled facts have provenance absent from the full session-date map: {missing_sessions}\")\n    selected_dates = {session_id: session_dates[session_id] for session_id in provenance_ids}\n    active = [fact for fact in facts if fact.get(\"status\") == \"active\"]\n    return {\n        \"schema_version\": SCHEMA_VERSION,\n        \"source_facts_sha256\": facts_source_sha256,\n        \"source_session_dates_sha256\": session_dates_source_sha256,\n        \"source_active_fact_count\": len(active),\n        \"source_active_fact_catalog_sha256\": fact_catalog_sha256(active),\n        \"fact_count\": len(selected),\n        \"facts_sha256\": sha256_bytes(canonical_json(selected)),\n        \"facts\": selected,\n        \"session_date_count\": len(selected_dates),\n        \"session_dates_sha256\": sha256_bytes(canonical_json(selected_dates)),\n        \"session_dates\": selected_dates,\n    }\n\n\ndef _wanted_fact_ids(labels: dict[str, Any]) -> set[str]:\n    wanted: set[str] = set()\n    for item in labels.get(\"items\") or []:\n        if not isinstance(item, dict):\n            raise DatasetError(\"label item must be an object\")\n        for judgment in item.get(\"judgments\") or []:\n            if not isinstance(judgment, dict):\n                raise DatasetError(\"judgment must be an object\")\n            wanted.add(str(judgment.get(\"fact_id\") or \"\"))\n    if \"\" in wanted:\n        raise DatasetError(\"judgment fact_id cannot be empty\")\n    return wanted\n\n\ndef _snapshot_commitment(snapshot: dict[str, Any]) -> dict[str, Any]:\n    return {\n        \"fact_count\": snapshot[\"fact_count\"],\n        \"facts_sha256\": snapshot[\"facts_sha256\"],\n        \"session_date_count\": snapshot[\"session_date_count\"],\n        \"session_dates_sha256\": snapshot[\"session_dates_sha256\"],\n    }\n\n\ndef bind_labels(labels: dict[str, Any], facts: list[dict[str, Any]], session_dates: dict[str, str],\n                facts_source_sha256: str, session_dates_source_sha256: str) -> dict[str, Any]:\n    \"\"\"Add full-source fact hashes and excerpt commitments without changing judgments.\"\"\"\n    if labels.get(\"schema_version\") != SCHEMA_VERSION:\n        raise DatasetError(f\"label source schema_version must be {SCHEMA_VERSION}\")\n    bound = copy.deepcopy(labels)\n    source = bound.get(\"source_corpus\")\n    if not isinstance(source, dict):\n        raise DatasetError(\"label source_corpus must be an object\")\n    if source.get(\"facts_sha256\") != facts_source_sha256:\n        raise DatasetError(\"full fact corpus hash does not match label source\")\n    if source.get(\"session_dates_sha256\") != session_dates_source_sha256:\n        raise DatasetError(\"session date map hash does not match label source\")\n    fact_index = _unique_index(facts, \"id\", \"fact corpus\")\n    for item in bound.get(\"items\") or []:\n        if not isinstance(item, dict):\n            raise DatasetError(\"label item must be an object\")\n        for judgment in item.get(\"judgments\") or []:\n            if not isinstance(judgment, dict):\n                raise DatasetError(\"judgment must be an object\")\n            fact_id = str(judgment.get(\"fact_id\") or \"\")\n            fact = fact_index.get(fact_id)\n            if fact is None:\n                raise DatasetError(f\"labeled fact id absent from frozen corpus: {fact_id!r}\")\n            judgment[\"fact_sha256\"] = fact_sha256(fact)\n    active = [fact for fact in facts if fact.get(\"status\") == \"active\"]\n    source[\"active_fact_count\"] = len(active)\n    source[\"active_fact_catalog_sha256\"] = fact_catalog_sha256(active)\n    snapshot = _snapshot_payload(\n        facts,\n        session_dates,\n        _wanted_fact_ids(bound),\n        facts_source_sha256,\n        session_dates_source_sha256,\n    )\n    bound[\"snapshot_commitment\"] = _snapshot_commitment(snapshot)\n    return bound\n\n\ndef build_snapshot(labels: dict[str, Any], facts: list[dict[str, Any]], session_dates: dict[str, str],\n                   facts_source_sha256: str, session_dates_source_sha256: str) -> dict[str, Any]:\n    if labels.get(\"schema_version\") != SCHEMA_VERSION:\n        raise DatasetError(f\"label source schema_version must be {SCHEMA_VERSION}\")\n    expected_source = labels.get(\"source_corpus\")\n    if not isinstance(expected_source, dict):\n        raise DatasetError(\"label source_corpus must be an object\")\n    if expected_source.get(\"facts_sha256\") != facts_source_sha256:\n        raise DatasetError(\"full fact corpus hash does not match label source\")\n    if expected_source.get(\"session_dates_sha256\") != session_dates_source_sha256:\n        raise DatasetError(\"session date map hash does not match label source\")\n    snapshot = _snapshot_payload(\n        facts,\n        session_dates,\n        _wanted_fact_ids(labels),\n        facts_source_sha256,\n        session_dates_source_sha256,\n    )\n    if expected_source.get(\"active_fact_count\") != snapshot[\"source_active_fact_count\"]:\n        raise DatasetError(\"active full-corpus fact count does not match label source\")\n    if expected_source.get(\"active_fact_catalog_sha256\") != snapshot[\"source_active_fact_catalog_sha256\"]:\n        raise DatasetError(\"active full-corpus fact catalog hash does not match label source\")\n    fact_index = _unique_index(facts, \"id\", \"fact corpus\")\n    for item in labels.get(\"items\") or []:\n        query_id = str(item.get(\"query_id\") or \"\")\n        for judgment in item.get(\"judgments\") or []:\n            fact_id = str(judgment.get(\"fact_id\") or \"\")\n            expected_hash = judgment.get(\"fact_sha256\")\n            if not isinstance(expected_hash, str) or re.fullmatch(r\"[0-9a-f]{64}\", expected_hash) is None:\n                raise DatasetError(f\"{query_id}/{fact_id}: reviewed fact_sha256 is missing or invalid\")\n            if fact_sha256(fact_index[fact_id]) != expected_hash:\n                raise DatasetError(f\"{query_id}/{fact_id}: reviewed fact hash differs from full corpus\")\n    if labels.get(\"snapshot_commitment\") != _snapshot_commitment(snapshot):\n        raise DatasetError(\"label snapshot commitment differs from the pinned full-source excerpt\")\n    return snapshot\n\n\ndef validate_source_membership(\n    labels: dict[str, Any],\n    snapshot: dict[str, Any],\n    contract: dict[str, Any],\n    membership: dict[str, Any],\n    *,\n    membership_sha256: str,\n) -> None:\n    \"\"\"Prove every selected fact and date belongs to the independently pinned full source.\"\"\"\n    contract_fields = {\n        \"schema_version\", \"contract_id\", \"membership_path\", \"membership_sha256\",\n        \"source_facts_sha256\", \"source_session_dates_sha256\", \"fact_count\",\n        \"active_fact_count\", \"fact_membership_root_sha256\", \"eligibility_membership_root_sha256\",\n        \"active_fact_catalog_sha256\",\n        \"session_date_count\", \"session_date_membership_root_sha256\",\n    }\n    if (\n        not isinstance(contract, dict)\n        or set(contract) != contract_fields\n        or contract.get(\"schema_version\") != SOURCE_CONTRACT_SCHEMA_VERSION\n    ):\n        raise DatasetError(\"source contract fields or schema version changed\")\n    if contract.get(\"membership_sha256\") != membership_sha256:\n        raise DatasetError(\"source membership content hash differs from reviewed contract\")\n    membership_fields = {\n        \"schema_version\", \"source_facts_sha256\", \"source_session_dates_sha256\", \"fact_count\",\n        \"active_fact_count\", \"fact_membership_root_sha256\", \"eligibility_membership_root_sha256\",\n        \"active_fact_catalog_sha256\", \"facts\",\n        \"session_date_count\", \"session_date_membership_root_sha256\", \"session_dates\",\n    }\n    if (\n        not isinstance(membership, dict)\n        or set(membership) != membership_fields\n        or membership.get(\"schema_version\") != SOURCE_MEMBERSHIP_SCHEMA_VERSION\n    ):\n        raise DatasetError(\"source membership fields or schema version changed\")\n    facts = membership.get(\"facts\")\n    session_dates = membership.get(\"session_dates\")\n    if not isinstance(facts, list) or not all(isinstance(record, dict) for record in facts):\n","stderr":"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Build and verify the exposed-only offline relevance development dataset.\n\nLabels are human-reviewed source records.  This tool joins them to the reconciled task inventory\nand a content-addressed excerpt of the frozen fact corpus, deriving query/fact hashes, kinds, and\nrolling-cutoff eligibility.  It never reads a task outside the explicit development assignment and\nthe allowed exposed inventory states.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport copy\nimport datetime as dt\nimport hashlib\nimport json\nimport math\nimport pathlib\nimport re\nimport sys\nfrom collections import Counter\nfrom typing import Any\n\n\nSCHEMA_VERSION = 2\nSOURCE_MEMBERSHIP_SCHEMA_VERSION = 2\nSOURCE_CONTRACT_SCHEMA_VERSION = 2\nSAFE_STATES = (\"prompt_inspected\", \"retrieval_probed\", \"agent_run\", \"optimization_used\")\nGRADES = (\"solving\", \"relevant_alternative\", \"hard_topical_distractor\", \"irrelevant\")\nQUERY_SOURCES = (\"user_prompt_derived\", \"oracle_upper_bound\")\nEVIDENCE_TYPES = (\"legacy_agent_packet\", \"manual_frozen_corpus_review\")\nNULL_CLOSURE_METHOD = \"exhaustive_active_corpus_review_v2\"\nREVIEW_METHOD = \"manual_judgment_from_exposed_prompt_and_pinned_membership_v1\"\nSTOPWORDS = {\n    \"a\", \"an\", \"and\", \"are\", \"as\", \"at\", \"be\", \"by\", \"for\", \"from\", \"has\", \"in\", \"is\",\n    \"it\", \"of\", \"on\", \"or\", \"that\", \"the\", \"their\", \"this\", \"to\", \"was\", \"when\", \"with\",\n}\n\n\nclass DatasetError(ValueError):\n    \"\"\"A fail-closed dataset contract violation.\"\"\"\n\n\ndef sha256_bytes(value: bytes) -> str:\n    return hashlib.sha256(value).hexdigest()\n\n\ndef sha256_text(value: str) -> str:\n    return sha256_bytes(value.encode(\"utf-8\"))\n\n\ndef canonical_json(value: Any) -> bytes:\n    return json.dumps(value, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False).encode(\"utf-8\")\n\n\ndef fact_sha256(fact: dict[str, Any]) -> str:\n    return sha256_bytes(canonical_json(fact))\n\n\ndef fact_catalog_sha256(facts: list[dict[str, Any]]) -> str:\n    records = sorted(\n        ({\"fact_id\": str(fact.get(\"id\") or \"\"), \"fact_sha256\": fact_sha256(fact)} for fact in facts),\n        key=lambda record: record[\"fact_id\"],\n    )\n    if any(not record[\"fact_id\"] for record in records):\n        raise DatasetError(\"fact catalog contains an empty fact id\")\n    if len({record[\"fact_id\"] for record in records}) != len(records):\n        raise DatasetError(\"fact catalog contains duplicate fact ids\")\n    return sha256_bytes(canonical_json(records))\n\n\ndef _provenance_session_ids(fact: dict[str, Any]) -> list[str]:\n    \"\"\"Return the canonical provenance IDs, or an empty list for any malformed provenance.\"\"\"\n    provenance = fact.get(\"provenance\")\n    if not isinstance(provenance, list) or not provenance:\n        return []\n    session_ids: list[str] = []\n    for anchor in provenance:\n        if not isinstance(anchor, dict):\n            return []\n        session_id = str(anchor.get(\"session_id\") or \"\").strip()\n        if not session_id:\n            return []\n        session_ids.append(session_id)\n    return sorted(set(session_ids))\n\n\ndef _membership_fact_records(facts: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    records = sorted(({\n        \"fact_id\": str(fact.get(\"id\") or \"\"),\n        \"fact_sha256\": fact_sha256(fact),\n        \"status\": str(fact.get(\"status\") or \"\"),\n        \"provenance_session_ids\": _provenance_session_ids(fact),\n    } for fact in facts), key=lambda record: record[\"fact_id\"])\n    if any(not record[\"fact_id\"] or not record[\"status\"] for record in records):\n        raise DatasetError(\"source membership contains an empty fact id or status\")\n    if len({record[\"fact_id\"] for record in records}) != len(records):\n        raise DatasetError(\"source membership contains duplicate fact ids\")\n    return records\n\n\ndef fact_membership_root_sha256(records: list[dict[str, Any]]) -> str:\n    normalized = sorted(({\n        \"fact_id\": str(record.get(\"fact_id\") or \"\"),\n        \"fact_sha256\": str(record.get(\"fact_sha256\") or \"\"),\n        \"status\": str(record.get(\"status\") or \"\"),\n    } for record in records), key=lambda record: record[\"fact_id\"])\n    if any(\n        not record[\"fact_id\"] or not _is_sha256(record[\"fact_sha256\"]) or not record[\"status\"]\n        for record in normalized\n    ):\n        raise DatasetError(\"source membership fact record is malformed\")\n    if len({record[\"fact_id\"] for record in normalized}) != len(normalized):\n        raise DatasetError(\"source membership contains duplicate fact ids\")\n    return sha256_bytes(canonical_json(normalized))\n\n\ndef eligibility_membership_root_sha256(records: list[dict[str, Any]]) -> str:\n    normalized: list[dict[str, Any]] = []\n    for record in records:\n        session_ids = record.get(\"provenance_session_ids\")\n        if not isinstance(session_ids, list) or not all(\n            isinstance(session_id, str) and bool(session_id) for session_id in session_ids\n        ):\n            raise DatasetError(\"source eligibility membership provenance is malformed\")\n        if session_ids != sorted(set(session_ids)):\n            raise DatasetError(\"source eligibility membership provenance is not canonical\")\n        normalized.append({\n            \"fact_id\": str(record.get(\"fact_id\") or \"\"),\n            \"fact_sha256\": str(record.get(\"fact_sha256\") or \"\"),\n            \"status\": str(record.get(\"status\") or \"\"),\n            \"provenance_session_ids\": session_ids,\n        })\n    normalized.sort(key=lambda record: record[\"fact_id\"])\n    if any(\n        not record[\"fact_id\"] or not _is_sha256(record[\"fact_sha256\"]) or not record[\"status\"]\n        for record in normalized\n    ):\n        raise DatasetError(\"source eligibility membership fact record is malformed\")\n    if len({record[\"fact_id\"] for record in normalized}) != len(normalized):\n        raise DatasetError(\"source eligibility membership contains duplicate fact ids\")\n    return sha256_bytes(canonical_json(normalized))\n\n\ndef fact_record_catalog_sha256(records: list[dict[str, Any]], *, status: str | None = None) -> str:\n    selected = [record for record in records if status is None or record.get(\"status\") == status]\n    normalized = sorted(({\n        \"fact_id\": str(record.get(\"fact_id\") or \"\"),\n        \"fact_sha256\": str(record.get(\"fact_sha256\") or \"\"),\n    } for record in selected), key=lambda record: record[\"fact_id\"])\n    if any(not record[\"fact_id\"] or not _is_sha256(record[\"fact_sha256\"]) for record in normalized):\n        raise DatasetError(\"source membership fact catalog record is malformed\")\n    if len({record[\"fact_id\"] for record in normalized}) != len(normalized):\n        raise DatasetError(\"source membership fact catalog contains duplicate ids\")\n    return sha256_bytes(canonical_json(normalized))\n\n\ndef session_date_membership_root_sha256(session_dates: dict[str, Any]) -> str:\n    normalized: dict[str, str] = {}\n    for session_id, value in session_dates.items():\n        if not isinstance(session_id, str) or not session_id or not isinstance(value, str):\n            raise DatasetError(\"source membership session-date record is malformed\")\n        _parse_time(value, f\"source membership session date {session_id}\")\n        normalized[session_id] = value\n    return sha256_bytes(canonical_json(normalized))\n\n\ndef build_source_membership(\n    facts: list[dict[str, Any]],\n    session_dates: dict[str, str],\n    facts_source_sha256: str,\n    session_dates_source_sha256: str,\n) -> dict[str, Any]:\n    \"\"\"Build a complete authenticated ID/hash/status and session/date catalog.\"\"\"\n    records = _membership_fact_records(facts)\n    active = [record for record in records if record[\"status\"] == \"active\"]\n    return {\n        \"schema_version\": SOURCE_MEMBERSHIP_SCHEMA_VERSION,\n        \"source_facts_sha256\": facts_source_sha256,\n        \"source_session_dates_sha256\": session_dates_source_sha256,\n        \"fact_count\": len(records),\n        \"active_fact_count\": len(active),\n        \"fact_membership_root_sha256\": fact_membership_root_sha256(records),\n        \"eligibility_membership_root_sha256\": eligibility_membership_root_sha256(records),\n        \"active_fact_catalog_sha256\": fact_record_catalog_sha256(records, status=\"active\"),\n        \"facts\": records,\n        \"session_date_count\": len(session_dates),\n        \"session_date_membership_root_sha256\": session_date_membership_root_sha256(session_dates),\n        \"session_dates\": dict(sorted(session_dates.items())),\n    }\n\n\ndef build_source_contract(membership_path: str, membership: dict[str, Any], membership_sha256: str) -> dict[str, Any]:\n    \"\"\"Build the small reviewed trust-root document for a complete membership catalog.\"\"\"\n    return {\n        \"schema_version\": SOURCE_CONTRACT_SCHEMA_VERSION,\n        \"contract_id\": \"agent-brain-offline-relevance-source-2026-07-15\",\n        \"membership_path\": membership_path,\n        \"membership_sha256\": membership_sha256,\n        \"source_facts_sha256\": membership[\"source_facts_sha256\"],\n        \"source_session_dates_sha256\": membership[\"source_session_dates_sha256\"],\n        \"fact_count\": membership[\"fact_count\"],\n        \"active_fact_count\": membership[\"active_fact_count\"],\n        \"fact_membership_root_sha256\": membership[\"fact_membership_root_sha256\"],\n        \"eligibility_membership_root_sha256\": membership[\"eligibility_membership_root_sha256\"],\n        \"active_fact_catalog_sha256\": membership[\"active_fact_catalog_sha256\"],\n        \"session_date_count\": membership[\"session_date_count\"],\n        \"session_date_membership_root_sha256\": membership[\"session_date_membership_root_sha256\"],\n    }\n\n\ndef temporal_policy_sha256(cutoff: str, excluded_sessions: list[str]) -> str:\n    return sha256_bytes(canonical_json({\n        \"temporal_cutoff\": cutoff,\n        \"exclude_session_ids\": excluded_sessions,\n    }))\n\n\ndef _is_sha256(value: Any) -> bool:\n    return isinstance(value, str) and re.fullmatch(r\"[0-9a-f]{64}\", value) is not None\n\n\ndef _is_nonnegative_int(value: Any) -> bool:\n    return isinstance(value, int) and not isinstance(value, bool) and value >= 0\n\n\ndef load_json(path: pathlib.Path) -> Any:\n    try:\n        return json.loads(path.read_text())\n    except (OSError, json.JSONDecodeError) as exc:\n        raise DatasetError(f\"cannot read JSON {path}: {exc}\") from exc\n\n\ndef load_facts(path: pathlib.Path) -> list[dict[str, Any]]:\n    facts: list[dict[str, Any]] = []\n    try:\n        lines = path.read_text().splitlines()\n    except OSError as exc:\n        raise DatasetError(f\"cannot read facts {path}: {exc}\") from exc\n    for line_number, line in enumerate(lines, 1):\n        if not line.strip():\n            continue\n        try:\n            fact = json.loads(line)\n        except json.JSONDecodeError as exc:\n            raise DatasetError(f\"invalid fact JSON at {path}:{line_number}: {exc}\") from exc\n        if not isinstance(fact, dict):\n            raise DatasetError(f\"fact at {path}:{line_number} is not an object\")\n        facts.append(fact)\n    return facts\n\n\ndef _parse_time(value: Any, label: str) -> dt.datetime:\n    if not isinstance(value, str) or not value.strip():\n        raise DatasetError(f\"{label} must be a non-empty RFC3339 timestamp\")\n    text = value.strip()\n    if text.endswith((\"Z\", \"z\")):\n        text = text[:-1] + \"+00:00\"\n    try:\n        parsed = dt.datetime.fromisoformat(text)\n    except ValueError as exc:\n        raise DatasetError(f\"{label} is not an RFC3339 timestamp: {value!r}\") from exc\n    if parsed.tzinfo is None or parsed.utcoffset() is None:\n        raise DatasetError(f\"{label} must include an RFC3339 UTC offset: {value!r}\")\n    return parsed\n\n\ndef _unique_index(rows: list[dict[str, Any]], key: str, label: str) -> dict[str, dict[str, Any]]:\n    output: dict[str, dict[str, Any]] = {}\n    for row in rows:\n        value = str(row.get(key) or \"\").strip()\n        if not value:\n            raise DatasetError(f\"{label} row has no {key}\")\n        if value in output:\n            raise DatasetError(f\"duplicate {label} {key}: {value}\")\n        output[value] = row\n    return output\n\n\ndef _eligible(fact: dict[str, Any], session_dates: dict[str, str], cutoff: str,\n              excluded_sessions: set[str]) -> bool:\n    cutoff_at = _parse_time(cutoff, \"temporal cutoff\")\n    session_ids = _provenance_session_ids(fact)\n    if not session_ids:\n        return False\n    if any(session_id in excluded_sessions for session_id in session_ids):\n        return False\n    for session_id in session_ids:\n        created = session_dates.get(session_id)\n        if created is None:\n            return False\n        if not _parse_time(created, f\"session date {session_id}\") < cutoff_at:\n            return False\n    return True\n\n\ndef active_eligible_fact_catalog(\n    membership: dict[str, Any], cutoff: str, excluded_sessions: list[str]\n) -> list[dict[str, str]]:\n    \"\"\"Derive the exact active+eligible ID/hash catalog from authenticated membership metadata.\"\"\"\n    cutoff_at = _parse_time(cutoff, \"temporal cutoff\")\n    excluded = set(excluded_sessions)\n    facts = membership.get(\"facts\")\n    session_dates = membership.get(\"session_dates\")\n    if membership.get(\"schema_version\") != SOURCE_MEMBERSHIP_SCHEMA_VERSION:\n        raise DatasetError(\"null review requires provenance-aware source membership schema\")\n    if not isinstance(facts, list) or not isinstance(session_dates, dict):\n        raise DatasetError(\"null review source membership is malformed\")\n    output: list[dict[str, str]] = []\n    for record in facts:\n        if not isinstance(record, dict) or record.get(\"status\") != \"active\":\n            continue\n        session_ids = record.get(\"provenance_session_ids\")\n        if not isinstance(session_ids, list) or not session_ids:\n            continue\n        if session_ids != sorted(set(session_ids)) or not all(\n            isinstance(session_id, str) and bool(session_id) for session_id in session_ids\n        ):\n            raise DatasetError(\"null review source membership provenance is malformed\")\n        if any(session_id in excluded for session_id in session_ids):\n            continue\n        eligible = True\n        for session_id in session_ids:\n            created = session_dates.get(session_id)\n            if not isinstance(created, str):\n                eligible = False\n                break\n            try:\n                created_at = _parse_time(created, f\"source membership session date {session_id}\")\n            except DatasetError:\n                eligible = False\n                break\n            if not created_at < cutoff_at:\n                eligible = False\n                break\n        if eligible:\n            output.append({\n                \"fact_id\": str(record.get(\"fact_id\") or \"\"),\n                \"fact_sha256\": str(record.get(\"fact_sha256\") or \"\"),\n            })\n    output.sort(key=lambda record: record[\"fact_id\"])\n    fact_record_catalog_sha256(output)\n    return output\n\n\ndef _load_inventory(inventory_path: pathlib.Path) -> dict[str, dict[str, Any]]:\n    inventory = load_json(inventory_path)\n    if not isinstance(inventory, dict) or not isinstance(inventory.get(\"tasks\"), list):\n        raise DatasetError(\"task inventory must contain a tasks array\")\n    rows = _unique_index(inventory[\"tasks\"], \"task_id\", \"inventory\")\n    for task_id, row in rows.items():\n        artifact = row.get(\"artifacts\")\n        if not isinstance(artifact, dict):\n            raise DatasetError(f\"{task_id}: inventory artifacts missing\")\n        config_path = artifact.get(\"config_path\")\n        if not isinstance(config_path, str) or pathlib.PurePosixPath(config_path).is_absolute() or \"..\" in pathlib.PurePosixPath(config_path).parts:\n            raise DatasetError(f\"{task_id}: unsafe config_path\")\n    return rows\n\n\ndef _task_config(repo: pathlib.Path, inventory_row: dict[str, Any]) -> dict[str, Any]:\n    path = repo / inventory_row[\"artifacts\"][\"config_path\"]\n    task_id = str(inventory_row.get(\"task_id\") or \"<unknown>\")\n    if not path.is_file():\n        raise DatasetError(f\"{task_id}: task config does not exist\")\n    if sha256_bytes(path.read_bytes()) != inventory_row[\"artifacts\"].get(\"config_sha256\"):\n        raise DatasetError(f\"{task_id}: task config hash differs from inventory\")\n    config = load_json(path)\n    if not isinstance(config, dict):\n        raise DatasetError(f\"task config {path} is not an object\")\n    return config\n\n\ndef _repo_relative_file(repo: pathlib.Path, value: Any, label: str) -> pathlib.Path:\n    if not isinstance(value, str) or not value:\n        raise DatasetError(f\"{label} path is missing\")\n    relative = pathlib.PurePosixPath(value)\n    if relative.is_absolute() or \"..\" in relative.parts:\n        raise DatasetError(f\"{label} path is unsafe\")\n    target = (repo / pathlib.Path(*relative.parts)).resolve()\n    try:\n        target.relative_to(repo.resolve())\n    except ValueError as exc:\n        raise DatasetError(f\"{label} path escapes the repository\") from exc\n    if not target.is_file():\n        raise DatasetError(f\"{label} path does not exist\")\n    return target\n\n\ndef _snapshot_payload(facts: list[dict[str, Any]], session_dates: dict[str, str], wanted: set[str],\n                      facts_source_sha256: str, session_dates_source_sha256: str) -> dict[str, Any]:\n    fact_index = _unique_index(facts, \"id\", \"fact corpus\")\n    missing = sorted(wanted - set(fact_index))\n    if missing:\n        raise DatasetError(f\"labeled fact ids absent from frozen corpus: {missing}\")\n    selected = [fact_index[fact_id] for fact_id in sorted(wanted)]\n    provenance_ids = sorted({\n        str(anchor.get(\"session_id\") or \"\")\n        for fact in selected\n        for anchor in (fact.get(\"provenance\") or [])\n        if isinstance(anchor, dict) and str(anchor.get(\"session_id\") or \"\")\n    })\n    missing_sessions = sorted(set(provenance_ids) - set(session_dates))\n    if missing_sessions:\n        raise DatasetError(f\"labeled facts have provenance absent from the full session-date map: {missing_sessions}\")\n    selected_dates = {session_id: session_dates[session_id] for session_id in provenance_ids}\n    active = [fact for fact in facts if fact.get(\"status\") == \"active\"]\n    return {\n        \"schema_version\": SCHEMA_VERSION,\n        \"source_facts_sha256\": facts_source_sha256,\n        \"source_session_dates_sha256\": session_dates_source_sha256,\n        \"source_active_fact_count\": len(active),\n        \"source_active_fact_catalog_sha256\": fact_catalog_sha256(active),\n        \"fact_count\": len(selected),\n        \"facts_sha256\": sha256_bytes(canonical_json(selected)),\n        \"facts\": selected,\n        \"session_date_count\": len(selected_dates),\n        \"session_dates_sha256\": sha256_bytes(canonical_json(selected_dates)),\n        \"session_dates\": selected_dates,\n    }\n\n\ndef _wanted_fact_ids(labels: dict[str, Any]) -> set[str]:\n    wanted: set[str] = set()\n    for item in labels.get(\"items\") or []:\n        if not isinstance(item, dict):\n            raise DatasetError(\"label item must be an object\")\n        for judgment in item.get(\"judgments\") or []:\n            if not isinstance(judgment, dict):\n                raise DatasetError(\"judgment must be an object\")\n            wanted.add(str(judgment.get(\"fact_id\") or \"\"))\n    if \"\" in wanted:\n        raise DatasetError(\"judgment fact_id cannot be empty\")\n    return wanted\n\n\ndef _snapshot_commitment(snapshot: dict[str, Any]) -> dict[str, Any]:\n    return {\n        \"fact_count\": snapshot[\"fact_count\"],\n        \"facts_sha256\": snapshot[\"facts_sha256\"],\n        \"session_date_count\": snapshot[\"session_date_count\"],\n        \"session_dates_sha256\": snapshot[\"session_dates_sha256\"],\n    }\n\n\ndef bind_labels(labels: dict[str, Any], facts: list[dict[str, Any]], session_dates: dict[str, str],\n                facts_source_sha256: str, session_dates_source_sha256: str) -> dict[str, Any]:\n    \"\"\"Add full-source fact hashes and excerpt commitments without changing judgments.\"\"\"\n    if labels.get(\"schema_version\") != SCHEMA_VERSION:\n        raise DatasetError(f\"label source schema_version must be {SCHEMA_VERSION}\")\n    bound = copy.deepcopy(labels)\n    source = bound.get(\"source_corpus\")\n    if not isinstance(source, dict):\n        raise DatasetError(\"label source_corpus must be an object\")\n    if source.get(\"facts_sha256\") != facts_source_sha256:\n        raise DatasetError(\"full fact corpus hash does not match label source\")\n    if source.get(\"session_dates_sha256\") != session_dates_source_sha256:\n        raise DatasetError(\"session date map hash does not match label source\")\n    fact_index = _unique_index(facts, \"id\", \"fact corpus\")\n    for item in bound.get(\"items\") or []:\n        if not isinstance(item, dict):\n            raise DatasetError(\"label item must be an object\")\n        for judgment in item.get(\"judgments\") or []:\n            if not isinstance(judgment, dict):\n                raise DatasetError(\"judgment must be an object\")\n            fact_id = str(judgment.get(\"fact_id\") or \"\")\n            fact = fact_index.get(fact_id)\n            if fact is None:\n                raise DatasetError(f\"labeled fact id absent from frozen corpus: {fact_id!r}\")\n            judgment[\"fact_sha256\"] = fact_sha256(fact)\n    active = [fact for fact in facts if fact.get(\"status\") == \"active\"]\n    source[\"active_fact_count\"] = len(active)\n    source[\"active_fact_catalog_sha256\"] = fact_catalog_sha256(active)\n    snapshot = _snapshot_payload(\n        facts,\n        session_dates,\n        _wanted_fact_ids(bound),\n        facts_source_sha256,\n        session_dates_source_sha256,\n    )\n    bound[\"snapshot_commitment\"] = _snapshot_commitment(snapshot)\n    return bound\n\n\ndef build_snapshot(labels: dict[str, Any], facts: list[dict[str, Any]], session_dates: dict[str, str],\n                   facts_source_sha256: str, session_dates_source_sha256: str) -> dict[str, Any]:\n    if labels.get(\"schema_version\") != SCHEMA_VERSION:\n        raise DatasetError(f\"label source schema_version must be {SCHEMA_VERSION}\")\n    expected_source = labels.get(\"source_corpus\")\n    if not isinstance(expected_source, dict):\n        raise DatasetError(\"label source_corpus must be an object\")\n    if expected_source.get(\"facts_sha256\") != facts_source_sha256:\n        raise DatasetError(\"full fact corpus hash does not match label source\")\n    if expected_source.get(\"session_dates_sha256\") != session_dates_source_sha256:\n        raise DatasetError(\"session date map hash does not match label source\")\n    snapshot = _snapshot_payload(\n        facts,\n        session_dates,\n        _wanted_fact_ids(labels),\n        facts_source_sha256,\n        session_dates_source_sha256,\n    )\n    if expected_source.get(\"active_fact_count\") != snapshot[\"source_active_fact_count\"]:\n        raise DatasetError(\"active full-corpus fact count does not match label source\")\n    if expected_source.get(\"active_fact_catalog_sha256\") != snapshot[\"source_active_fact_catalog_sha256\"]:\n        raise DatasetError(\"active full-corpus fact catalog hash does not match label source\")\n    fact_index = _unique_index(facts, \"id\", \"fact corpus\")\n    for item in labels.get(\"items\") or []:\n        query_id = str(item.get(\"query_id\") or \"\")\n        for judgment in item.get(\"judgments\") or []:\n            fact_id = str(judgment.get(\"fact_id\") or \"\")\n            expected_hash = judgment.get(\"fact_sha256\")\n            if not isinstance(expected_hash, str) or re.fullmatch(r\"[0-9a-f]{64}\", expected_hash) is None:\n                raise DatasetError(f\"{query_id}/{fact_id}: reviewed fact_sha256 is missing or invalid\")\n            if fact_sha256(fact_index[fact_id]) != expected_hash:\n                raise DatasetError(f\"{query_id}/{fact_id}: reviewed fact hash differs from full corpus\")\n    if labels.get(\"snapshot_commitment\") != _snapshot_commitment(snapshot):\n        raise DatasetError(\"label snapshot commitment differs from the pinned full-source excerpt\")\n    return snapshot\n\n\ndef validate_source_membership(\n    labels: dict[str, Any],\n    snapshot: dict[str, Any],\n    contract: dict[str, Any],\n    membership: dict[str, Any],\n    *,\n    membership_sha256: str,\n) -> None:\n    \"\"\"Prove every selected fact and date belongs to the independently pinned full source.\"\"\"\n    contract_fields = {\n        \"schema_version\", \"contract_id\", \"membership_path\", \"membership_sha256\",\n        \"source_facts_sha256\", \"source_session_dates_sha256\", \"fact_count\",\n        \"active_fact_count\", \"fact_membership_root_sha256\", \"eligibility_membership_root_sha256\",\n        \"active_fact_catalog_sha256\",\n        \"session_date_count\", \"session_date_membership_root_sha256\",\n    }\n    if (\n        not isinstance(contract, dict)\n        or set(contract) != contract_fields\n        or contract.get(\"schema_version\") != SOURCE_CONTRACT_SCHEMA_VERSION\n    ):\n        raise DatasetError(\"source contract fields or schema version changed\")\n    if contract.get(\"membership_sha256\") != membership_sha256:\n        raise DatasetError(\"source membership content hash differs from reviewed contract\")\n    membership_fields = {\n        \"schema_version\", \"source_facts_sha256\", \"source_session_dates_sha256\", \"fact_count\",\n        \"active_fact_count\", \"fact_membership_root_sha256\", \"eligibility_membership_root_sha256\",\n        \"active_fact_catalog_sha256\", \"facts\",\n        \"session_date_count\", \"session_date_membership_root_sha256\", \"session_dates\",\n    }\n    if (\n        not isinstance(membership, dict)\n        or set(membership) != membership_fields\n        or membership.get(\"schema_version\") != SOURCE_MEMBERSHIP_SCHEMA_VERSION\n    ):\n        raise DatasetError(\"source membership fields or schema version changed\")\n    facts = membership.get(\"facts\")\n    session_dates = membership.get(\"session_dates\")\n    if not isinstance(facts, list) or not all(isinstance(record, dict) for record in facts):\n","exit_code":0,"duration":{"secs":0,"nanos":2709},"formatted_output":"#!/usr/bin/env python3\n\"\"\"Build and verify the exposed-only offline relevance development dataset.\n\nLabels are human-reviewed source records.  This tool joins them to the reconciled task inventory\nand a content-addressed excerpt of the frozen fact corpus, deriving query/fact hashes, kinds, and\nrolling-cutoff eligibility.  It never reads a task outside the explicit development assignment and\nthe allowed exposed inventory states.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport copy\nimport datetime as dt\nimport hashlib\nimport json\nimport math\nimport pathlib\nimport re\nimport sys\nfrom collections import Counter\nfrom typing import Any\n\n\nSCHEMA_VERSION = 2\nSOURCE_MEMBERSHIP_SCHEMA_VERSION = 2\nSOURCE_CONTRACT_SCHEMA_VERSION = 2\nSAFE_STATES = (\"prompt_inspected\", \"retrieval_probed\", \"agent_run\", \"optimization_used\")\nGRADES = (\"solving\", \"relevant_alternative\", \"hard_topical_distractor\", \"irrelevant\")\nQUERY_SOURCES = (\"user_prompt_derived\", \"oracle_upper_bound\")\nEVIDENCE_TYPES = (\"legacy_agent_packet\", \"manual_frozen_corpus_review\")\nNULL_CLOSURE_METHOD = \"exhaustive_active_corpus_review_v2\"\nREVIEW_METHOD = \"manual_judgment_from_exposed_prompt_and_pinned_membership_v1\"\nSTOPWORDS = {\n    \"a\", \"an\", \"and\", \"are\", \"as\", \"at\", \"be\", \"by\", \"for\", \"from\", \"has\", \"in\", \"is\",\n    \"it\", \"of\", \"on\", \"or\", \"that\", \"the\", \"their\", \"this\", \"to\", \"was\", \"when\", \"with\",\n}\n\n\nclass DatasetError(ValueError):\n    \"\"\"A fail-closed dataset contract violation.\"\"\"\n\n\ndef sha256_bytes(value: bytes) -> str:\n    return hashlib.sha256(value).hexdigest()\n\n\ndef sha256_text(value: str) -> str:\n    return sha256_bytes(value.encode(\"utf-8\"))\n\n\ndef canonical_json(value: Any) -> bytes:\n    return json.dumps(value, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False).encode(\"utf-8\")\n\n\ndef fact_sha256(fact: dict[str, Any]) -> str:\n    return sha256_bytes(canonical_json(fact))\n\n\ndef fact_catalog_sha256(facts: list[dict[str, Any]]) -> str:\n    records = sorted(\n        ({\"fact_id\": str(fact.get(\"id\") or \"\"), \"fact_sha256\": fact_sha256(fact)} for fact in facts),\n        key=lambda record: record[\"fact_id\"],\n    )\n    if any(not record[\"fact_id\"] for record in records):\n        raise DatasetError(\"fact catalog contains an empty fact id\")\n    if len({record[\"fact_id\"] for record in records}) != len(records):\n        raise DatasetError(\"fact catalog contains duplicate fact ids\")\n    return sha256_bytes(canonical_json(records))\n\n\ndef _provenance_session_ids(fact: dict[str, Any]) -> list[str]:\n    \"\"\"Return the canonical provenance IDs, or an empty list for any malformed provenance.\"\"\"\n    provenance = fact.get(\"provenance\")\n    if not isinstance(provenance, list) or not provenance:\n        return []\n    session_ids: list[str] = []\n    for anchor in provenance:\n        if not isinstance(anchor, dict):\n            return []\n        session_id = str(anchor.get(\"session_id\") or \"\").strip()\n        if not session_id:\n            return []\n        session_ids.append(session_id)\n    return sorted(set(session_ids))\n\n\ndef _membership_fact_records(facts: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    records = sorted(({\n        \"fact_id\": str(fact.get(\"id\") or \"\"),\n        \"fact_sha256\": fact_sha256(fact),\n        \"status\": str(fact.get(\"status\") or \"\"),\n        \"provenance_session_ids\": _provenance_session_ids(fact),\n    } for fact in facts), key=lambda record: record[\"fact_id\"])\n    if any(not record[\"fact_id\"] or not record[\"status\"] for record in records):\n        raise DatasetError(\"source membership contains an empty fact id or status\")\n    if len({record[\"fact_id\"] for record in records}) != len(records):\n        raise DatasetError(\"source membership contains duplicate fact ids\")\n    return records\n\n\ndef fact_membership_root_sha256(records: list[dict[str, Any]]) -> str:\n    normalized = sorted(({\n        \"fact_id\": str(record.get(\"fact_id\") or \"\"),\n        \"fact_sha256\": str(record.get(\"fact_sha256\") or \"\"),\n        \"status\": str(record.get(\"status\") or \"\"),\n    } for record in records), key=lambda record: record[\"fact_id\"])\n    if any(\n        not record[\"fact_id\"] or not _is_sha256(record[\"fact_sha256\"]) or not record[\"status\"]\n        for record in normalized\n    ):\n        raise DatasetError(\"source membership fact record is malformed\")\n    if len({record[\"fact_id\"] for record in normalized}) != len(normalized):\n        raise DatasetError(\"source membership contains duplicate fact ids\")\n    return sha256_bytes(canonical_json(normalized))\n\n\ndef eligibility_membership_root_sha256(records: list[dict[str, Any]]) -> str:\n    normalized: list[dict[str, Any]] = []\n    for record in records:\n        session_ids = record.get(\"provenance_session_ids\")\n        if not isinstance(session_ids, list) or not all(\n            isinstance(session_id, str) and bool(session_id) for session_id in session_ids\n        ):\n            raise DatasetError(\"source eligibility membership provenance is malformed\")\n        if session_ids != sorted(set(session_ids)):\n            raise DatasetError(\"source eligibility membership provenance is not canonical\")\n        normalized.append({\n            \"fact_id\": str(record.get(\"fact_id\") or \"\"),\n            \"fact_sha256\": str(record.get(\"fact_sha256\") or \"\"),\n            \"status\": str(record.get(\"status\") or \"\"),\n            \"provenance_session_ids\": session_ids,\n        })\n    normalized.sort(key=lambda record: record[\"fact_id\"])\n    if any(\n        not record[\"fact_id\"] or not _is_sha256(record[\"fact_sha256\"]) or not record[\"status\"]\n        for record in normalized\n    ):\n        raise DatasetError(\"source eligibility membership fact record is malformed\")\n    if len({record[\"fact_id\"] for record in normalized}) != len(normalized):\n        raise DatasetError(\"source eligibility membership contains duplicate fact ids\")\n    return sha256_bytes(canonical_json(normalized))\n\n\ndef fact_record_catalog_sha256(records: list[dict[str, Any]], *, status: str | None = None) -> str:\n    selected = [record for record in records if status is None or record.get(\"status\") == status]\n    normalized = sorted(({\n        \"fact_id\": str(record.get(\"fact_id\") or \"\"),\n        \"fact_sha256\": str(record.get(\"fact_sha256\") or \"\"),\n    } for record in selected), key=lambda record: record[\"fact_id\"])\n    if any(not record[\"fact_id\"] or not _is_sha256(record[\"fact_sha256\"]) for record in normalized):\n        raise DatasetError(\"source membership fact catalog record is malformed\")\n    if len({record[\"fact_id\"] for record in normalized}) != len(normalized):\n        raise DatasetError(\"source membership fact catalog contains duplicate ids\")\n    return sha256_bytes(canonical_json(normalized))\n\n\ndef session_date_membership_root_sha256(session_dates: dict[str, Any]) -> str:\n    normalized: dict[str, str] = {}\n    for session_id, value in session_dates.items():\n        if not isinstance(session_id, str) or not session_id or not isinstance(value, str):\n            raise DatasetError(\"source membership session-date record is malformed\")\n        _parse_time(value, f\"source membership session date {session_id}\")\n        normalized[session_id] = value\n    return sha256_bytes(canonical_json(normalized))\n\n\ndef build_source_membership(\n    facts: list[dict[str, Any]],\n    session_dates: dict[str, str],\n    facts_source_sha256: str,\n    session_dates_source_sha256: str,\n) -> dict[str, Any]:\n    \"\"\"Build a complete authenticated ID/hash/status and session/date catalog.\"\"\"\n    records = _membership_fact_records(facts)\n    active = [record for record in records if record[\"status\"] == \"active\"]\n    return {\n        \"schema_version\": SOURCE_MEMBERSHIP_SCHEMA_VERSION,\n        \"source_facts_sha256\": facts_source_sha256,\n        \"source_session_dates_sha256\": session_dates_source_sha256,\n        \"fact_count\": len(records),\n        \"active_fact_count\": len(active),\n        \"fact_membership_root_sha256\": fact_membership_root_sha256(records),\n        \"eligibility_membership_root_sha256\": eligibility_membership_root_sha256(records),\n        \"active_fact_catalog_sha256\": fact_record_catalog_sha256(records, status=\"active\"),\n        \"facts\": records,\n        \"session_date_count\": len(session_dates),\n        \"session_date_membership_root_sha256\": session_date_membership_root_sha256(session_dates),\n        \"session_dates\": dict(sorted(session_dates.items())),\n    }\n\n\ndef build_source_contract(membership_path: str, membership: dict[str, Any], membership_sha256: str) -> dict[str, Any]:\n    \"\"\"Build the small reviewed trust-root document for a complete membership catalog.\"\"\"\n    return {\n        \"schema_version\": SOURCE_CONTRACT_SCHEMA_VERSION,\n        \"contract_id\": \"agent-brain-offline-relevance-source-2026-07-15\",\n        \"membership_path\": membership_path,\n        \"membership_sha256\": membership_sha256,\n        \"source_facts_sha256\": membership[\"source_facts_sha256\"],\n        \"source_session_dates_sha256\": membership[\"source_session_dates_sha256\"],\n        \"fact_count\": membership[\"fact_count\"],\n        \"active_fact_count\": membership[\"active_fact_count\"],\n        \"fact_membership_root_sha256\": membership[\"fact_membership_root_sha256\"],\n        \"eligibility_membership_root_sha256\": membership[\"eligibility_membership_root_sha256\"],\n        \"active_fact_catalog_sha256\": membership[\"active_fact_catalog_sha256\"],\n        \"session_date_count\": membership[\"session_date_count\"],\n        \"session_date_membership_root_sha256\": membership[\"session_date_membership_root_sha256\"],\n    }\n\n\ndef temporal_policy_sha256(cutoff: str, excluded_sessions: list[str]) -> str:\n    return sha256_bytes(canonical_json({\n        \"temporal_cutoff\": cutoff,\n        \"exclude_session_ids\": excluded_sessions,\n    }))\n\n\ndef _is_sha256(value: Any) -> bool:\n    return isinstance(value, str) and re.fullmatch(r\"[0-9a-f]{64}\", value) is not None\n\n\ndef _is_nonnegative_int(value: Any) -> bool:\n    return isinstance(value, int) and not isinstance(value, bool) and value >= 0\n\n\ndef load_json(path: pathlib.Path) -> Any:\n    try:\n        return json.loads(path.read_text())\n    except (OSError, json.JSONDecodeError) as exc:\n        raise DatasetError(f\"cannot read JSON {path}: {exc}\") from exc\n\n\ndef load_facts(path: pathlib.Path) -> list[dict[str, Any]]:\n    facts: list[dict[str, Any]] = []\n    try:\n        lines = path.read_text().splitlines()\n    except OSError as exc:\n        raise DatasetError(f\"cannot read facts {path}: {exc}\") from exc\n    for line_number, line in enumerate(lines, 1):\n        if not line.strip():\n            continue\n        try:\n            fact = json.loads(line)\n        except json.JSONDecodeError as exc:\n            raise DatasetError(f\"invalid fact JSON at {path}:{line_number}: {exc}\") from exc\n        if not isinstance(fact, dict):\n            raise DatasetError(f\"fact at {path}:{line_number} is not an object\")\n        facts.append(fact)\n    return facts\n\n\ndef _parse_time(value: Any, label: str) -> dt.datetime:\n    if not isinstance(value, str) or not value.strip():\n        raise DatasetError(f\"{label} must be a non-empty RFC3339 timestamp\")\n    text = value.strip()\n    if text.endswith((\"Z\", \"z\")):\n        text = text[:-1] + \"+00:00\"\n    try:\n        parsed = dt.datetime.fromisoformat(text)\n    except ValueError as exc:\n        raise DatasetError(f\"{label} is not an RFC3339 timestamp: {value!r}\") from exc\n    if parsed.tzinfo is None or parsed.utcoffset() is None:\n        raise DatasetError(f\"{label} must include an RFC3339 UTC offset: {value!r}\")\n    return parsed\n\n\ndef _unique_index(rows: list[dict[str, Any]], key: str, label: str) -> dict[str, dict[str, Any]]:\n    output: dict[str, dict[str, Any]] = {}\n    for row in rows:\n        value = str(row.get(key) or \"\").strip()\n        if not value:\n            raise DatasetError(f\"{label} row has no {key}\")\n        if value in output:\n            raise DatasetError(f\"duplicate {label} {key}: {value}\")\n        output[value] = row\n    return output\n\n\ndef _eligible(fact: dict[str, Any], session_dates: dict[str, str], cutoff: str,\n              excluded_sessions: set[str]) -> bool:\n    cutoff_at = _parse_time(cutoff, \"temporal cutoff\")\n    session_ids = _provenance_session_ids(fact)\n    if not session_ids:\n        return False\n    if any(session_id in excluded_sessions for session_id in session_ids):\n        return False\n    for session_id in session_ids:\n        created = session_dates.get(session_id)\n        if created is None:\n            return False\n        if not _parse_time(created, f\"session date {session_id}\") < cutoff_at:\n            return False\n    return True\n\n\ndef active_eligible_fact_catalog(\n    membership: dict[str, Any], cutoff: str, excluded_sessions: list[str]\n) -> list[dict[str, str]]:\n    \"\"\"Derive the exact active+eligible ID/hash catalog from authenticated membership metadata.\"\"\"\n    cutoff_at = _parse_time(cutoff, \"temporal cutoff\")\n    excluded = set(excluded_sessions)\n    facts = membership.get(\"facts\")\n    session_dates = membership.get(\"session_dates\")\n    if membership.get(\"schema_version\") != SOURCE_MEMBERSHIP_SCHEMA_VERSION:\n        raise DatasetError(\"null review requires provenance-aware source membership schema\")\n    if not isinstance(facts, list) or not isinstance(session_dates, dict):\n        raise DatasetError(\"null review source membership is malformed\")\n    output: list[dict[str, str]] = []\n    for record in facts:\n        if not isinstance(record, dict) or record.get(\"status\") != \"active\":\n            continue\n        session_ids = record.get(\"provenance_session_ids\")\n        if not isinstance(session_ids, list) or not session_ids:\n            continue\n        if session_ids != sorted(set(session_ids)) or not all(\n            isinstance(session_id, str) and bool(session_id) for session_id in session_ids\n        ):\n            raise DatasetError(\"null review source membership provenance is malformed\")\n        if any(session_id in excluded for session_id in session_ids):\n            continue\n        eligible = True\n        for session_id in session_ids:\n            created = session_dates.get(session_id)\n            if not isinstance(created, str):\n                eligible = False\n                break\n            try:\n                created_at = _parse_time(created, f\"source membership session date {session_id}\")\n            except DatasetError:\n                eligible = False\n                break\n            if not created_at < cutoff_at:\n                eligible = False\n                break\n        if eligible:\n            output.append({\n                \"fact_id\": str(record.get(\"fact_id\") or \"\"),\n                \"fact_sha256\": str(record.get(\"fact_sha256\") or \"\"),\n            })\n    output.sort(key=lambda record: record[\"fact_id\"])\n    fact_record_catalog_sha256(output)\n    return output\n\n\ndef _load_inventory(inventory_path: pathlib.Path) -> dict[str, dict[str, Any]]:\n    inventory = load_json(inventory_path)\n    if not isinstance(inventory, dict) or not isinstance(inventory.get(\"tasks\"), list):\n        raise DatasetError(\"task inventory must contain a tasks array\")\n    rows = _unique_index(inventory[\"tasks\"], \"task_id\", \"inventory\")\n    for task_id, row in rows.items():\n        artifact = row.get(\"artifacts\")\n        if not isinstance(artifact, dict):\n            raise DatasetError(f\"{task_id}: inventory artifacts missing\")\n        config_path = artifact.get(\"config_path\")\n        if not isinstance(config_path, str) or pathlib.PurePosixPath(config_path).is_absolute() or \"..\" in pathlib.PurePosixPath(config_path).parts:\n            raise DatasetError(f\"{task_id}: unsafe config_path\")\n    return rows\n\n\ndef _task_config(repo: pathlib.Path, inventory_row: dict[str, Any]) -> dict[str, Any]:\n    path = repo / inventory_row[\"artifacts\"][\"config_path\"]\n    task_id = str(inventory_row.get(\"task_id\") or \"<unknown>\")\n    if not path.is_file():\n        raise DatasetError(f\"{task_id}: task config does not exist\")\n    if sha256_bytes(path.read_bytes()) != inventory_row[\"artifacts\"].get(\"config_sha256\"):\n        raise DatasetError(f\"{task_id}: task config hash differs from inventory\")\n    config = load_json(path)\n    if not isinstance(config, dict):\n        raise DatasetError(f\"task config {path} is not an object\")\n    return config\n\n\ndef _repo_relative_file(repo: pathlib.Path, value: Any, label: str) -> pathlib.Path:\n    if not isinstance(value, str) or not value:\n        raise DatasetError(f\"{label} path is missing\")\n    relative = pathlib.PurePosixPath(value)\n    if relative.is_absolute() or \"..\" in relative.parts:\n        raise DatasetError(f\"{label} path is unsafe\")\n    target = (repo / pathlib.Path(*relative.parts)).resolve()\n    try:\n        target.relative_to(repo.resolve())\n    except ValueError as exc:\n        raise DatasetError(f\"{label} path escapes the repository\") from exc\n    if not target.is_file():\n        raise DatasetError(f\"{label} path does not exist\")\n    return target\n\n\ndef _snapshot_payload(facts: list[dict[str, Any]], session_dates: dict[str, str], wanted: set[str],\n                      facts_source_sha256: str, session_dates_source_sha256: str) -> dict[str, Any]:\n    fact_index = _unique_index(facts, \"id\", \"fact corpus\")\n    missing = sorted(wanted - set(fact_index))\n    if missing:\n        raise DatasetError(f\"labeled fact ids absent from frozen corpus: {missing}\")\n    selected = [fact_index[fact_id] for fact_id in sorted(wanted)]\n    provenance_ids = sorted({\n        str(anchor.get(\"session_id\") or \"\")\n        for fact in selected\n        for anchor in (fact.get(\"provenance\") or [])\n        if isinstance(anchor, dict) and str(anchor.get(\"session_id\") or \"\")\n    })\n    missing_sessions = sorted(set(provenance_ids) - set(session_dates))\n    if missing_sessions:\n        raise DatasetError(f\"labeled facts have provenance absent from the full session-date map: {missing_sessions}\")\n    selected_dates = {session_id: session_dates[session_id] for session_id in provenance_ids}\n    active = [fact for fact in facts if fact.get(\"status\") == \"active\"]\n    return {\n        \"schema_version\": SCHEMA_VERSION,\n        \"source_facts_sha256\": facts_source_sha256,\n        \"source_session_dates_sha256\": session_dates_source_sha256,\n        \"source_active_fact_count\": len(active),\n        \"source_active_fact_catalog_sha256\": fact_catalog_sha256(active),\n        \"fact_count\": len(selected),\n        \"facts_sha256\": sha256_bytes(canonical_json(selected)),\n        \"facts\": selected,\n        \"session_date_count\": len(selected_dates),\n        \"session_dates_sha256\": sha256_bytes(canonical_json(selected_dates)),\n        \"session_dates\": selected_dates,\n    }\n\n\ndef _wanted_fact_ids(labels: dict[str, Any]) -> set[str]:\n    wanted: set[str] = set()\n    for item in labels.get(\"items\") or []:\n        if not isinstance(item, dict):\n            raise DatasetError(\"label item must be an object\")\n        for judgment in item.get(\"judgments\") or []:\n            if not isinstance(judgment, dict):\n                raise DatasetError(\"judgment must be an object\")\n            wanted.add(str(judgment.get(\"fact_id\") or \"\"))\n    if \"\" in wanted:\n        raise DatasetError(\"judgment fact_id cannot be empty\")\n    return wanted\n\n\ndef _snapshot_commitment(snapshot: dict[str, Any]) -> dict[str, Any]:\n    return {\n        \"fact_count\": snapshot[\"fact_count\"],\n        \"facts_sha256\": snapshot[\"facts_sha256\"],\n        \"session_date_count\": snapshot[\"session_date_count\"],\n        \"session_dates_sha256\": snapshot[\"session_dates_sha256\"],\n    }\n\n\ndef bind_labels(labels: dict[str, Any], facts: list[dict[str, Any]], session_dates: dict[str, str],\n                facts_source_sha256: str, session_dates_source_sha256: str) -> dict[str, Any]:\n    \"\"\"Add full-source fact hashes and excerpt commitments without changing judgments.\"\"\"\n    if labels.get(\"schema_version\") != SCHEMA_VERSION:\n        raise DatasetError(f\"label source schema_version must be {SCHEMA_VERSION}\")\n    bound = copy.deepcopy(labels)\n    source = bound.get(\"source_corpus\")\n    if not isinstance(source, dict):\n        raise DatasetError(\"label source_corpus must be an object\")\n    if source.get(\"facts_sha256\") != facts_source_sha256:\n        raise DatasetError(\"full fact corpus hash does not match label source\")\n    if source.get(\"session_dates_sha256\") != session_dates_source_sha256:\n        raise DatasetError(\"session date map hash does not match label source\")\n    fact_index = _unique_index(facts, \"id\", \"fact corpus\")\n    for item in bound.get(\"items\") or []:\n        if not isinstance(item, dict):\n            raise DatasetError(\"label item must be an object\")\n        for judgment in item.get(\"judgments\") or []:\n            if not isinstance(judgment, dict):\n                raise DatasetError(\"judgment must be an object\")\n            fact_id = str(judgment.get(\"fact_id\") or \"\")\n            fact = fact_index.get(fact_id)\n            if fact is None:\n                raise DatasetError(f\"labeled fact id absent from frozen corpus: {fact_id!r}\")\n            judgment[\"fact_sha256\"] = fact_sha256(fact)\n    active = [fact for fact in facts if fact.get(\"status\") == \"active\"]\n    source[\"active_fact_count\"] = len(active)\n    source[\"active_fact_catalog_sha256\"] = fact_catalog_sha256(active)\n    snapshot = _snapshot_payload(\n        facts,\n        session_dates,\n        _wanted_fact_ids(bound),\n        facts_source_sha256,\n        session_dates_source_sha256,\n    )\n    bound[\"snapshot_commitment\"] = _snapshot_commitment(snapshot)\n    return bound\n\n\ndef build_snapshot(labels: dict[str, Any], facts: list[dict[str, Any]], session_dates: dict[str, str],\n                   facts_source_sha256: str, session_dates_source_sha256: str) -> dict[str, Any]:\n    if labels.get(\"schema_version\") != SCHEMA_VERSION:\n        raise DatasetError(f\"label source schema_version must be {SCHEMA_VERSION}\")\n    expected_source = labels.get(\"source_corpus\")\n    if not isinstance(expected_source, dict):\n        raise DatasetError(\"label source_corpus must be an object\")\n    if expected_source.get(\"facts_sha256\") != facts_source_sha256:\n        raise DatasetError(\"full fact corpus hash does not match label source\")\n    if expected_source.get(\"session_dates_sha256\") != session_dates_source_sha256:\n        raise DatasetError(\"session date map hash does not match label source\")\n    snapshot = _snapshot_payload(\n        facts,\n        session_dates,\n        _wanted_fact_ids(labels),\n        facts_source_sha256,\n        session_dates_source_sha256,\n    )\n    if expected_source.get(\"active_fact_count\") != snapshot[\"source_active_fact_count\"]:\n        raise DatasetError(\"active full-corpus fact count does not match label source\")\n    if expected_source.get(\"active_fact_catalog_sha256\") != snapshot[\"source_active_fact_catalog_sha256\"]:\n        raise DatasetError(\"active full-corpus fact catalog hash does not match label source\")\n    fact_index = _unique_index(facts, \"id\", \"fact corpus\")\n    for item in labels.get(\"items\") or []:\n        query_id = str(item.get(\"query_id\") or \"\")\n        for judgment in item.get(\"judgments\") or []:\n            fact_id = str(judgment.get(\"fact_id\") or \"\")\n            expected_hash = judgment.get(\"fact_sha256\")\n            if not isinstance(expected_hash, str) or re.fullmatch(r\"[0-9a-f]{64}\", expected_hash) is None:\n                raise DatasetError(f\"{query_id}/{fact_id}: reviewed fact_sha256 is missing or invalid\")\n            if fact_sha256(fact_index[fact_id]) != expected_hash:\n                raise DatasetError(f\"{query_id}/{fact_id}: reviewed fact hash differs from full corpus\")\n    if labels.get(\"snapshot_commitment\") != _snapshot_commitment(snapshot):\n        raise DatasetError(\"label snapshot commitment differs from the pinned full-source excerpt\")\n    return snapshot\n\n\ndef validate_source_membership(\n    labels: dict[str, Any],\n    snapshot: dict[str, Any],\n    contract: dict[str, Any],\n    membership: dict[str, Any],\n    *,\n    membership_sha256: str,\n) -> None:\n    \"\"\"Prove every selected fact and date belongs to the independently pinned full source.\"\"\"\n    contract_fields = {\n        \"schema_version\", \"contract_id\", \"membership_path\", \"membership_sha256\",\n        \"source_facts_sha256\", \"source_session_dates_sha256\", \"fact_count\",\n        \"active_fact_count\", \"fact_membership_root_sha256\", \"eligibility_membership_root_sha256\",\n        \"active_fact_catalog_sha256\",\n        \"session_date_count\", \"session_date_membership_root_sha256\",\n    }\n    if (\n        not isinstance(contract, dict)\n        or set(contract) != contract_fields\n        or contract.get(\"schema_version\") != SOURCE_CONTRACT_SCHEMA_VERSION\n    ):\n        raise DatasetError(\"source contract fields or schema version changed\")\n    if contract.get(\"membership_sha256\") != membership_sha256:\n        raise DatasetError(\"source membership content hash differs from reviewed contract\")\n    membership_fields = {\n        \"schema_version\", \"source_facts_sha256\", \"source_session_dates_sha256\", \"fact_count\",\n        \"active_fact_count\", \"fact_membership_root_sha256\", \"eligibility_membership_root_sha256\",\n        \"active_fact_catalog_sha256\", \"facts\",\n        \"session_date_count\", \"session_date_membership_root_sha256\", \"session_dates\",\n    }\n    if (\n        not isinstance(membership, dict)\n        or set(membership) != membership_fields\n        or membership.get(\"schema_version\") != SOURCE_MEMBERSHIP_SCHEMA_VERSION\n    ):\n        raise DatasetError(\"source membership fields or schema version changed\")\n    facts = membership.get(\"facts\")\n    session_dates = membership.get(\"session_dates\")\n    if not isinstance(facts, list) or not all(isinstance(record, dict) for record in facts):\n"},"started_at_ms":1789839538234,"completed_at_ms":1789839538234}}
{"timestamp":"2026-09-19T17:38:58.291Z","ordinal":7489,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0babf-f873-7102-a838-a6875269a4c8","call_id":"call_Eb69elNNOjLZ9zs9oogmvCzz","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"558801\",\"wall_time_seconds\":0.000002709,\"exit_code\":0,\"original_token_count\":6410,\"output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Build and verify the exposed-only offline relevance development dataset.\\n\\nLabels are human-reviewed source records.  This tool joins them to the reconciled task inventory\\nand a content-addressed excerpt of the frozen fact corpus, deriving query/fact hashes, kinds, and\\nrolling-cutoff eligibility.  It never reads a task outside the explicit development assignment and\\nthe allowed exposed inventory states.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport copy\\nimport datetime as dt\\nimport hashlib\\nimport json\\nimport math\\nimport pathlib\\nimport re\\nimport sys\\nfrom collections import Counter\\nfrom typing import Any\\n\\n\\nSCHEMA_VERSION = 2\\nSOURCE_MEMBERSHIP_SCHEMA_VERSION = 2\\nSOURCE_CONTRACT_SCHEMA_VERSION = 2\\nSAFE_STATES = (\\\"prompt_inspected\\\", \\\"retrieval_probed\\\", \\\"agent_run\\\", \\\"optimization_used\\\")\\nGRADES = (\\\"solving\\\", \\\"relevant_alternative\\\", \\\"hard_topical_distractor\\\", \\\"irrelevant\\\")\\nQUERY_SOURCES = (\\\"user_prompt_derived\\\", \\\"oracle_upper_bound\\\")\\nEVIDENCE_TYPES = (\\\"legacy_agent_packet\\\", \\\"manual_frozen_corpus_review\\\")\\nNULL_CLOSURE_METHOD = \\\"exhaustive_active_corpus_review_v2\\\"\\nREVIEW_METHOD = \\\"manual_judgment_from_exposed_prompt_and_pinned_membership_v1\\\"\\nSTOPWORDS = {\\n    \\\"a\\\", \\\"an\\\", \\\"and\\\", \\\"are\\\", \\\"as\\\", \\\"at\\\", \\\"be\\\", \\\"by\\\", \\\"for\\\", \\\"from\\\", \\\"has\\\", \\\"in\\\", \\\"is\\\",\\n    \\\"it\\\", \\\"of\\\", \\\"on\\\", \\\"or\\\", \\\"that\\\", \\\"the\\\", \\\"their\\\", \\\"this\\\", \\\"to\\\", \\\"was\\\", \\\"when\\\", \\\"with\\\",\\n}\\n\\n\\nclass DatasetError(ValueError):\\n    \\\"\\\"\\\"A fail-closed dataset contract violation.\\\"\\\"\\\"\\n\\n\\ndef sha256_bytes(value: bytes) -> str:\\n    return hashlib.sha256(value).hexdigest()\\n\\n\\ndef sha256_text(value: str) -> str:\\n    return sha256_bytes(value.encode(\\\"utf-8\\\"))\\n\\n\\ndef canonical_json(value: Any) -> bytes:\\n    return json.dumps(value, sort_keys=True, separators=(\\\",\\\", \\\":\\\"), ensure_ascii=False).encode(\\\"utf-8\\\")\\n\\n\\ndef fact_sha256(fact: dict[str, Any]) -> str:\\n    return sha256_bytes(canonical_json(fact))\\n\\n\\ndef fact_catalog_sha256(facts: list[dict[str, Any]]) -> str:\\n    records = sorted(\\n        ({\\\"fact_id\\\": str(fact.get(\\\"id\\\") or \\\"\\\"), \\\"fact_sha256\\\": fact_sha256(fact)} for fact in facts),\\n        key=lambda record: record[\\\"fact_id\\\"],\\n    )\\n    if any(not record[\\\"fact_id\\\"] for record in records):\\n        raise DatasetError(\\\"fact catalog contains an empty fact id\\\")\\n    if len({record[\\\"fact_id\\\"] for record in records}) != len(records):\\n        raise DatasetError(\\\"fact catalog contains duplicate fact ids\\\")\\n    return sha256_bytes(canonical_json(records))\\n\\n\\ndef _provenance_session_ids(fact: dict[str, Any]) -> list[str]:\\n    \\\"\\\"\\\"Return the canonical provenance IDs, or an empty list for any malformed provenance.\\\"\\\"\\\"\\n    provenance = fact.get(\\\"provenance\\\")\\n    if not isinstance(provenance, list) or not provenance:\\n        return []\\n    session_ids: list[str] = []\\n    for anchor in provenance:\\n        if not isinstance(anchor, dict):\\n            return []\\n        session_id = str(anchor.get(\\\"session_id\\\") or \\\"\\\").strip()\\n        if not session_id:\\n            return []\\n        session_ids.append(session_id)\\n    return sorted(set(session_ids))\\n\\n\\ndef _membership_fact_records(facts: list[dict[str, Any]]) -> list[dict[str, Any]]:\\n    records = sorted(({\\n        \\\"fact_id\\\": str(fact.get(\\\"id\\\") or \\\"\\\"),\\n        \\\"fact_sha256\\\": fact_sha256(fact),\\n        \\\"status\\\": str(fact.get(\\\"status\\\") or \\\"\\\"),\\n        \\\"provenance_session_ids\\\": _provenance_session_ids(fact),\\n    } for fact in facts), key=lambda record: record[\\\"fact_id\\\"])\\n    if any(not record[\\\"fact_id\\\"] or not record[\\\"status\\\"] for record in records):\\n        raise DatasetError(\\\"source membership contains an empty fact id or status\\\")\\n    if len({record[\\\"fact_id\\\"] for record in records}) != len(records):\\n        raise DatasetError(\\\"source membership contains duplicate fact ids\\\")\\n    return records\\n\\n\\ndef fact_membership_root_sha256(records: list[dict[str, Any]]) -> str:\\n    normalized = sorted(({\\n        \\\"fact_id\\\": str(record.get(\\\"fact_id\\\") or \\\"\\\"),\\n        \\\"fact_sha256\\\": str(record.get(\\\"fact_sha256\\\") or \\\"\\\"),\\n        \\\"status\\\": str(record.get(\\\"status\\\") or \\\"\\\"),\\n    } for record in records), key=lambda record: record[\\\"fact_id\\\"])\\n    if any(\\n        not record[\\\"fact_id\\\"] or not _is_sha256(record[\\\"fact_sha256\\\"]) or not record[\\\"status\\\"]\\n        for record in normalized\\n    ):\\n        raise DatasetError(\\\"source membership fact record is malformed\\\")\\n    if len({record[\\\"fact_id\\\"] for record in normalized}) != len(normalized):\\n        raise DatasetError(\\\"source membership contains duplicate fact ids\\\")\\n    return sha256_bytes(canonical_json(normalized))\\n\\n\\ndef eligibility_membership_root_sha256(records: list[dict[str, Any]]) -> str:\\n    normalized: list[dict[str, Any]] = []\\n    for record in records:\\n        session_ids = record.get(\\\"provenance_session_ids\\\")\\n        if not isinstance(session_ids, list) or not all(\\n            isinstance(session_id, str) and bool(session_id) for session_id in session_ids\\n        ):\\n            raise DatasetError(\\\"source eligibility membership provenance is malformed\\\")\\n        if session_ids != sorted(set(session_ids)):\\n            raise DatasetError(\\\"source eligibility membership provenance is not canonical\\\")\\n        normalized.append({\\n            \\\"fact_id\\\": str(record.get(\\\"fact_id\\\") or \\\"\\\"),\\n            \\\"fact_sha256\\\": str(record.get(\\\"fact_sha256\\\") or \\\"\\\"),\\n            \\\"status\\\": str(record.get(\\\"status\\\") or \\\"\\\"),\\n            \\\"provenance_session_ids\\\": session_ids,\\n        })\\n    normalized.sort(key=lambda record: record[\\\"fact_id\\\"])\\n    if any(\\n        not record[\\\"fact_id\\\"] or not _is_sha256(record[\\\"fact_sha256\\\"]) or not record[\\\"status\\\"]\\n        for record in normalized\\n    ):\\n        raise DatasetError(\\\"source eligibility membership fact record is malformed\\\")\\n    if len({record[\\\"fact_id\\\"] for record in normalized}) != len(normalized):\\n        raise DatasetError(\\\"source eligibility membership contains duplicate fact ids\\\")\\n    return sha256_bytes(canonical_json(normalized))\\n\\n\\ndef fact_record_catalog_sha256(records: list[dict[str, Any]], *, status: str | None = None) -> str:\\n    selected = [record for record in records if status is None or record.get(\\\"status\\\") == status]\\n    normalized = sorted(({\\n        \\\"fact_id\\\": str(record.get(\\\"fact_id\\\") or \\\"\\\"),\\n        \\\"fact_sha256\\\": str(record.get(\\\"fact_sha256\\\") or \\\"\\\"),\\n    } for record in selected), key=lambda record: record[\\\"fact_id\\\"])\\n    if any(not record[\\\"fact_id\\\"] or not _is_sha256(record[\\\"fact_sha256\\\"]) for record in normalized):\\n        raise DatasetError(\\\"source membership fact catalog record is malformed\\\")\\n    if len({record[\\\"fact_id\\\"] for record in normalized}) != len(normalized):\\n        raise DatasetError(\\\"source membership fact catalog contains duplicate ids\\\")\\n    return sha256_bytes(canonical_json(normalized))\\n\\n\\ndef session_date_membership_root_sha256(session_dates: dict[str, Any]) -> str:\\n    normalized: dict[str, str] = {}\\n    for session_id, value in session_dates.items():\\n        if not isinstance(session_id, str) or not session_id or not isinstance(value, str):\\n            raise DatasetError(\\\"source membership session-date record is malformed\\\")\\n        _parse_time(value, f\\\"source membership session date {session_id}\\\")\\n        normalized[session_id] = value\\n    return sha256_bytes(canonical_json(normalized))\\n\\n\\ndef build_source_membership(\\n    facts: list[dict[str, Any]],\\n    session_dates: dict[str, str],\\n    facts_source_sha256: str,\\n    session_dates_source_sha256: str,\\n) -> dict[str, Any]:\\n    \\\"\\\"\\\"Build a complete authenticated ID/hash/status and session/date catalog.\\\"\\\"\\\"\\n    records = _membership_fact_records(facts)\\n    active = [record for record in records if record[\\\"status\\\"] == \\\"active\\\"]\\n    return {\\n        \\\"schema_version\\\": SOURCE_MEMBERSHIP_SCHEMA_VERSION,\\n        \\\"source_facts_sha256\\\": facts_source_sha256,\\n        \\\"source_session_dates_sha256\\\": session_dates_source_sha256,\\n        \\\"fact_count\\\": len(records),\\n        \\\"active_fact_count\\\": len(active),\\n        \\\"fact_membership_root_sha256\\\": fact_membership_root_sha256(records),\\n        \\\"eligibility_membership_root_sha256\\\": eligibility_membership_root_sha256(records),\\n        \\\"active_fact_catalog_sha256\\\": fact_record_catalog_sha256(records, status=\\\"active\\\"),\\n        \\\"facts\\\": records,\\n        \\\"session_date_count\\\": len(session_dates),\\n        \\\"session_date_membership_root_sha256\\\": session_date_membership_root_sha256(session_dates),\\n        \\\"session_dates\\\": dict(sorted(session_dates.items())),\\n    }\\n\\n\\ndef build_source_contract(membership_path: str, membership: dict[str, Any], membership_sha256: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"Build the small reviewed trust-root document for a complete membership catalog.\\\"\\\"\\\"\\n    return {\\n        \\\"schema_version\\\": SOURCE_CONTRACT_SCHEMA_VERSION,\\n        \\\"contract_id\\\": \\\"agent-brain-offline-relevance-source-2026-07-15\\\",\\n        \\\"membership_path\\\": membership_path,\\n        \\\"membership_sha256\\\": membership_sha256,\\n        \\\"source_facts_sha256\\\": membership[\\\"source_facts_sha256\\\"],\\n        \\\"source_session_dates_sha256\\\": membership[\\\"source_session_dates_sha256\\\"],\\n        \\\"fact_count\\\": membership[\\\"fact_count\\\"],\\n        \\\"active_fact_count\\\": membership[\\\"active_fact_count\\\"],\\n        \\\"fact_membership_root_sha256\\\": membership[\\\"fact_membership_root_sha256\\\"],\\n        \\\"eligibility_membership_root_sha256\\\": membership[\\\"eligibility_membership_root_sha256\\\"],\\n        \\\"active_fact_catalog_sha256\\\": membership[\\\"active_fact_catalog_sha256\\\"],\\n        \\\"session_date_count\\\": membership[\\\"session_date_count\\\"],\\n        \\\"session_date_membership_root_sha256\\\": membership[\\\"session_date_membership_root_sha256\\\"],\\n    }\\n\\n\\ndef temporal_policy_sha256(cutoff: str, excluded_sessions: list[str]) -> str:\\n    return sha256_bytes(canonical_json({\\n        \\\"temporal_cutoff\\\": cutoff,\\n        \\\"exclude_session_ids\\\": excluded_sessions,\\n    }))\\n\\n\\ndef _is_sha256(value: Any) -> bool:\\n    return isinstance(value, str) and re.fullmatch(r\\\"[0-9a-f]{64}\\\", value) is not None\\n\\n\\ndef _is_nonnegative_int(value: Any) -> bool:\\n    return isinstance(value, int) and not isinstance(value, bool) and value >= 0\\n\\n\\ndef load_json(path: pathlib.Path) -> Any:\\n    try:\\n        return json.loads(path.read_text())\\n    except (OSError, json.JSONDecodeError) as exc:\\n        raise DatasetError(f\\\"cannot read JSON {path}: {exc}\\\") from exc\\n\\n\\ndef load_facts(path: pathlib.Path) -> list[dict[str, Any]]:\\n    facts: list[dict[str, Any]] = []\\n    try:\\n        lines = path.read_text().splitlines()\\n    except OSError as exc:\\n        raise DatasetError(f\\\"cannot read facts {path}: {exc}\\\") from exc\\n    for line_number, line in enumerate(lines, 1):\\n        if not line.strip():\\n            continue\\n        try:\\n            fact = json.loads(line)\\n        except json.JSONDecodeError as exc:\\n            raise DatasetError(f\\\"invalid fact JSON at {path}:{line_number}: {exc}\\\") from exc\\n        if not isinstance(fact, dict):\\n            raise DatasetError(f\\\"fact at {path}:{line_number} is not an object\\\")\\n        facts.append(fact)\\n    return facts\\n\\n\\ndef _parse_time(value: Any, label: str) -> dt.datetime:\\n    if not isinstance(value, str) or not value.strip():\\n        raise DatasetError(f\\\"{label} must be a non-empty RFC3339 timestamp\\\")\\n    text = value.strip()\\n    if text.endswith((\\\"Z\\\", \\\"z\\\")):\\n        text = text[:-1] + \\\"+00:00\\\"\\n    try:\\n        parsed = dt.datetime.fromisoformat(text)\\n    except ValueError as exc:\\n        raise DatasetError(f\\\"{label} is not an RFC3339 timestamp: {value!r}\\\") from exc\\n    if parsed.tzinfo is None or parsed.utcoffset() is None:\\n        raise DatasetError(f\\\"{label} must include an RFC3339 UTC offset: {value!r}\\\")\\n    return parsed\\n\\n\\ndef _unique_index(rows: list[dict[str, Any]], key: str, label: str) -> dict[str, dict[str, Any]]:\\n    output: dict[str, dict[str, Any]] = {}\\n    for row in rows:\\n        value = str(row.get(key) or \\\"\\\").strip()\\n        if not value:\\n            raise DatasetError(f\\\"{label} row has no {key}\\\")\\n        if value in output:\\n            raise DatasetError(f\\\"duplicate {label} {key}: {value}\\\")\\n        output[value] = row\\n    return output\\n\\n\\ndef _eligible(fact: dict[str, Any], session_dates: dict[str, str], cutoff: str,\\n              excluded_sessions: set[str]) -> bool:\\n    cutoff_at = _parse_time(cutoff, \\\"temporal cutoff\\\")\\n    session_ids = _provenance_session_ids(fact)\\n    if not session_ids:\\n        return False\\n    if any(session_id in excluded_sessions for session_id in session_ids):\\n        return False\\n    for session_id in session_ids:\\n        created = session_dates.get(session_id)\\n        if created is None:\\n            return False\\n        if not _parse_time(created, f\\\"session date {session_id}\\\") < cutoff_at:\\n            return False\\n    return True\\n\\n\\ndef active_eligible_fact_catalog(\\n    membership: dict[str, Any], cutoff: str, excluded_sessions: list[str]\\n) -> list[dict[str, str]]:\\n    \\\"\\\"\\\"Derive the exact active+eligible ID/hash catalog from authenticated membership metadata.\\\"\\\"\\\"\\n    cutoff_at = _parse_time(cutoff, \\\"temporal cutoff\\\")\\n    excluded = set(excluded_sessions)\\n    facts = membership.get(\\\"facts\\\")\\n    session_dates = membership.get(\\\"session_dates\\\")\\n    if membership.get(\\\"schema_version\\\") != SOURCE_MEMBERSHIP_SCHEMA_VERSION:\\n        raise DatasetError(\\\"null review requires provenance-aware source membership schema\\\")\\n    if not isinstance(facts, list) or not isinstance(session_dates, dict):\\n        raise DatasetError(\\\"null review source membership is malformed\\\")\\n    output: list[dict[str, str]] = []\\n    for record in facts:\\n        if not isinstance(record, dict) or record.get(\\\"status\\\") != \\\"active\\\":\\n            continue\\n        session_ids = record.get(\\\"provenance_session_ids\\\")\\n        if not isinstance(session_ids, list) or not session_ids:\\n            continue\\n        if session_ids != sorted(set(session_ids)) or not all(\\n            isinstance(session_id, str) and bool(session_id) for session_id in session_ids\\n        ):\\n            raise DatasetError(\\\"null review source membership provenance is malformed\\\")\\n        if any(session_id in excluded for session_id in session_ids):\\n            continue\\n        eligible = True\\n        for session_id in session_ids:\\n            created = session_dates.get(session_id)\\n            if not isinstance(created, str):\\n                eligible = False\\n                break\\n            try:\\n                created_at = _parse_time(created, f\\\"source membership session date {session_id}\\\")\\n            except DatasetError:\\n                eligible = False\\n                break\\n            if not created_at < cutoff_at:\\n                eligible = False\\n                break\\n        if eligible:\\n            output.append({\\n                \\\"fact_id\\\": str(record.get(\\\"fact_id\\\") or \\\"\\\"),\\n                \\\"fact_sha256\\\": str(record.get(\\\"fact_sha256\\\") or \\\"\\\"),\\n            })\\n    output.sort(key=lambda record: record[\\\"fact_id\\\"])\\n    fact_record_catalog_sha256(output)\\n    return output\\n\\n\\ndef _load_inventory(inventory_path: pathlib.Path) -> dict[str, dict[str, Any]]:\\n    inventory = load_json(inventory_path)\\n    if not isinstance(inventory, dict) or not isinstance(inventory.get(\\\"tasks\\\"), list):\\n        raise DatasetError(\\\"task inventory must contain a tasks array\\\")\\n    rows = _unique_index(inventory[\\\"tasks\\\"], \\\"task_id\\\", \\\"inventory\\\")\\n    for task_id, row in rows.items():\\n        artifact = row.get(\\\"artifacts\\\")\\n        if not isinstance(artifact, dict):\\n            raise DatasetError(f\\\"{task_id}: inventory artifacts missing\\\")\\n        config_path = artifact.get(\\\"config_path\\\")\\n        if not isinstance(config_path, str) or pathlib.PurePosixPath(config_path).is_absolute() or \\\"..\\\" in pathlib.PurePosixPath(config_path).parts:\\n            raise DatasetError(f\\\"{task_id}: unsafe config_path\\\")\\n    return rows\\n\\n\\ndef _task_config(repo: pathlib.Path, inventory_row: dict[str, Any]) -> dict[str, Any]:\\n    path = repo / inventory_row[\\\"artifacts\\\"][\\\"config_path\\\"]\\n    task_id = str(inventory_row.get(\\\"task_id\\\") or \\\"<unknown>\\\")\\n    if not path.is_file():\\n        raise DatasetError(f\\\"{task_id}: task config does not exist\\\")\\n    if sha256_bytes(path.read_bytes()) != inventory_row[\\\"artifacts\\\"].get(\\\"config_sha256\\\"):\\n        raise DatasetError(f\\\"{task_id}: task config hash differs from inventory\\\")\\n    config = load_json(path)\\n    if not isinstance(config, dict):\\n        raise DatasetError(f\\\"task config {path} is not an object\\\")\\n    return config\\n\\n\\ndef _repo_relative_file(repo: pathlib.Path, value: Any, label: str) -> pathlib.Path:\\n    if not isinstance(value, str) or not value:\\n        raise DatasetError(f\\\"{label} path is missing\\\")\\n    relative = pathlib.PurePosixPath(value)\\n    if relative.is_absolute() or \\\"..\\\" in relative.parts:\\n        raise DatasetError(f\\\"{label} path is unsafe\\\")\\n    target = (repo / pathlib.Path(*relative.parts)).resolve()\\n    try:\\n        target.relative_to(repo.resolve())\\n    except ValueError as exc:\\n        raise DatasetError(f\\\"{label} path escapes the repository\\\") from exc\\n    if not target.is_file():\\n        raise DatasetError(f\\\"{label} path does not exist\\\")\\n    return target\\n\\n\\ndef _snapshot_payload(facts: list[dict[str, Any]], session_dates: dict[str, str], wanted: set[str],\\n                      facts_source_sha256: str, session_dates_source_sha256: str) -> dict[str, Any]:\\n    fact_index = _unique_index(facts, \\\"id\\\", \\\"fact corpus\\\")\\n    missing = sorted(wanted - set(fact_index))\\n    if missing:\\n        raise DatasetError(f\\\"labeled fact ids absent from frozen corpus: {missing}\\\")\\n    selected = [fact_index[fact_id] for fact_id in sorted(wanted)]\\n    provenance_ids = sorted({\\n        str(anchor.get(\\\"session_id\\\") or \\\"\\\")\\n        for fact in selected\\n        for anchor in (fact.get(\\\"provenance\\\") or [])\\n        if isinstance(anchor, dict) and str(anchor.get(\\\"session_id\\\") or \\\"\\\")\\n    })\\n    missing_sessions = sorted(set(provenance_ids) - set(session_dates))\\n    if missing_sessions:\\n        raise DatasetError(f\\\"labeled facts have provenance absent from the full session-date map: {missing_sessions}\\\")\\n    selected_dates = {session_id: session_dates[session_id] for session_id in provenance_ids}\\n    active = [fact for fact in facts if fact.get(\\\"status\\\") == \\\"active\\\"]\\n    return {\\n        \\\"schema_version\\\": SCHEMA_VERSION,\\n        \\\"source_facts_sha256\\\": facts_source_sha256,\\n        \\\"source_session_dates_sha256\\\": session_dates_source_sha256,\\n        \\\"source_active_fact_count\\\": len(active),\\n        \\\"source_active_fact_catalog_sha256\\\": fact_catalog_sha256(active),\\n        \\\"fact_count\\\": len(selected),\\n        \\\"facts_sha256\\\": sha256_bytes(canonical_json(selected)),\\n        \\\"facts\\\": selected,\\n        \\\"session_date_count\\\": len(selected_dates),\\n        \\\"session_dates_sha256\\\": sha256_bytes(canonical_json(selected_dates)),\\n        \\\"session_dates\\\": selected_dates,\\n    }\\n\\n\\ndef _wanted_fact_ids(labels: dict[str, Any]) -> set[str]:\\n    wanted: set[str] = set()\\n    for item in labels.get(\\\"items\\\") or []:\\n        if not isinstance(item, dict):\\n            raise DatasetError(\\\"label item must be an object\\\")\\n        for judgment in item.get(\\\"judgments\\\") or []:\\n            if not isinstance(judgment, dict):\\n                raise DatasetError(\\\"judgment must be an object\\\")\\n            wanted.add(str(judgment.get(\\\"fact_id\\\") or \\\"\\\"))\\n    if \\\"\\\" in wanted:\\n        raise DatasetError(\\\"judgment fact_id cannot be empty\\\")\\n    return wanted\\n\\n\\ndef _snapshot_commitment(snapshot: dict[str, Any]) -> dict[str, Any]:\\n    return {\\n        \\\"fact_count\\\": snapshot[\\\"fact_count\\\"],\\n        \\\"facts_sha256\\\": snapshot[\\\"facts_sha256\\\"],\\n        \\\"session_date_count\\\": snapshot[\\\"session_date_count\\\"],\\n        \\\"session_dates_sha256\\\": snapshot[\\\"session_dates_sha256\\\"],\\n    }\\n\\n\\ndef bind_labels(labels: dict[str, Any], facts: list[dict[str, Any]], session_dates: dict[str, str],\\n                facts_source_sha256: str, session_dates_source_sha256: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"Add full-source fact hashes and excerpt commitments without changing judgments.\\\"\\\"\\\"\\n    if labels.get(\\\"schema_version\\\") != SCHEMA_VERSION:\\n        raise DatasetError(f\\\"label source schema_version must be {SCHEMA_VERSION}\\\")\\n    bound = copy.deepcopy(labels)\\n    source = bound.get(\\\"source_corpus\\\")\\n    if not isinstance(source, dict):\\n        raise DatasetError(\\\"label source_corpus must be an object\\\")\\n    if source.get(\\\"facts_sha256\\\") != facts_source_sha256:\\n        raise DatasetError(\\\"full fact corpus hash does not match label source\\\")\\n    if source.get(\\\"session_dates_sha256\\\") != session_dates_source_sha256:\\n        raise DatasetError(\\\"session date map hash does not match label source\\\")\\n    fact_index = _unique_index(facts, \\\"id\\\", \\\"fact corpus\\\")\\n    for item in bound.get(\\\"items\\\") or []:\\n        if not isinstance(item, dict):\\n            raise DatasetError(\\\"label item must be an object\\\")\\n        for judgment in item.get(\\\"judgments\\\") or []:\\n            if not isinstance(judgment, dict):\\n                raise DatasetError(\\\"judgment must be an object\\\")\\n            fact_id = str(judgment.get(\\\"fact_id\\\") or \\\"\\\")\\n            fact = fact_index.get(fact_id)\\n            if fact is None:\\n                raise DatasetError(f\\\"labeled fact id absent from frozen corpus: {fact_id!r}\\\")\\n            judgment[\\\"fact_sha256\\\"] = fact_sha256(fact)\\n    active = [fact for fact in facts if fact.get(\\\"status\\\") == \\\"active\\\"]\\n    source[\\\"active_fact_count\\\"] = len(active)\\n    source[\\\"active_fact_catalog_sha256\\\"] = fact_catalog_sha256(active)\\n    snapshot = _snapshot_payload(\\n        facts,\\n        session_dates,\\n        _wanted_fact_ids(bound),\\n        facts_source_sha256,\\n        session_dates_source_sha256,\\n    )\\n    bound[\\\"snapshot_commitment\\\"] = _snapshot_commitment(snapshot)\\n    return bound\\n\\n\\ndef build_snapshot(labels: dict[str, Any], facts: list[dict[str, Any]], session_dates: dict[str, str],\\n                   facts_source_sha256: str, session_dates_source_sha256: str) -> dict[str, Any]:\\n    if labels.get(\\\"schema_version\\\") != SCHEMA_VERSION:\\n        raise DatasetError(f\\\"label source schema_version must be {SCHEMA_VERSION}\\\")\\n    expected_source = labels.get(\\\"source_corpus\\\")\\n    if not isinstance(expected_source, dict):\\n        raise DatasetError(\\\"label source_corpus must be an object\\\")\\n    if expected_source.get(\\\"facts_sha256\\\") != facts_source_sha256:\\n        raise DatasetError(\\\"full fact corpus hash does not match label source\\\")\\n    if expected_source.get(\\\"session_dates_sha256\\\") != session_dates_source_sha256:\\n        raise DatasetError(\\\"session date map hash does not match label source\\\")\\n    snapshot = _snapshot_payload(\\n        facts,\\n        session_dates,\\n        _wanted_fact_ids(labels),\\n        facts_source_sha256,\\n        session_dates_source_sha256,\\n    )\\n    if expected_source.get(\\\"active_fact_count\\\") != snapshot[\\\"source_active_fact_count\\\"]:\\n        raise DatasetError(\\\"active full-corpus fact count does not match label source\\\")\\n    if expected_source.get(\\\"active_fact_catalog_sha256\\\") != snapshot[\\\"source_active_fact_catalog_sha256\\\"]:\\n        raise DatasetError(\\\"active full-corpus fact catalog hash does not match label source\\\")\\n    fact_index = _unique_index(facts, \\\"id\\\", \\\"fact corpus\\\")\\n    for item in labels.get(\\\"items\\\") or []:\\n        query_id = str(item.get(\\\"query_id\\\") or \\\"\\\")\\n        for judgment in item.get(\\\"judgments\\\") or []:\\n            fact_id = str(judgment.get(\\\"fact_id\\\") or \\\"\\\")\\n            expected_hash = judgment.get(\\\"fact_sha256\\\")\\n            if not isinstance(expected_hash, str) or re.fullmatch(r\\\"[0-9a-f]{64}\\\", expected_hash) is None:\\n                raise DatasetError(f\\\"{query_id}/{fact_id}: reviewed fact_sha256 is missing or invalid\\\")\\n            if fact_sha256(fact_index[fact_id]) != expected_hash:\\n                raise DatasetError(f\\\"{query_id}/{fact_id}: reviewed fact hash differs from full corpus\\\")\\n    if labels.get(\\\"snapshot_commitment\\\") != _snapshot_commitment(snapshot):\\n        raise DatasetError(\\\"label snapshot commitment differs from the pinned full-source excerpt\\\")\\n    return snapshot\\n\\n\\ndef validate_source_membership(\\n    labels: dict[str, Any],\\n    snapshot: dict[str, Any],\\n    contract: dict[str, Any],\\n    membership: dict[str, Any],\\n    *,\\n    membership_sha256: str,\\n) -> None:\\n    \\\"\\\"\\\"Prove every selected fact and date belongs to the independently pinned full source.\\\"\\\"\\\"\\n    contract_fields = {\\n        \\\"schema_version\\\", \\\"contract_id\\\", \\\"membership_path\\\", \\\"membership_sha256\\\",\\n        \\\"source_facts_sha256\\\", \\\"source_session_dates_sha256\\\", \\\"fact_count\\\",\\n        \\\"active_fact_count\\\", \\\"fact_membership_root_sha256\\\", \\\"eligibility_membership_root_sha256\\\",\\n        \\\"active_fact_catalog_sha256\\\",\\n        \\\"session_date_count\\\", \\\"session_date_membership_root_sha256\\\",\\n    }\\n    if (\\n        not isinstance(contract, dict)\\n        or set(contract) != contract_fields\\n        or contract.get(\\\"schema_version\\\") != SOURCE_CONTRACT_SCHEMA_VERSION\\n    ):\\n        raise DatasetError(\\\"source contract fields or schema version changed\\\")\\n    if contract.get(\\\"membership_sha256\\\") != membership_sha256:\\n        raise DatasetError(\\\"source membership content hash differs from reviewed contract\\\")\\n    membership_fields = {\\n        \\\"schema_version\\\", \\\"source_facts_sha256\\\", \\\"source_session_dates_sha256\\\", \\\"fact_count\\\",\\n        \\\"active_fact_count\\\", \\\"fact_membership_root_sha256\\\", \\\"eligibility_membership_root_sha256\\\",\\n        \\\"active_fact_catalog_sha256\\\", \\\"facts\\\",\\n        \\\"session_date_count\\\", \\\"session_date_membership_root_sha256\\\", \\\"session_dates\\\",\\n    }\\n    if (\\n        not isinstance(membership, dict)\\n        or set(membership) != membership_fields\\n        or membership.get(\\\"schema_version\\\") != SOURCE_MEMBERSHIP_SCHEMA_VERSION\\n    ):\\n        raise DatasetError(\\\"source membership fields or schema version changed\\\")\\n    facts = membership.get(\\\"facts\\\")\\n    session_dates = membership.get(\\\"session_dates\\\")\\n    if not isinstance(facts, list) or not all(isinstance(record, dict) for record in facts):\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839538.291022}}}
