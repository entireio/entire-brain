{"timestamp":"2026-09-19T17:39:30.157Z","ordinal":7512,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","item":{"type":"CommandExecution","id":"exec-d23d1d70-0728-4142-9b19-f9fdcb076acf","process_id":"3605","command":["/bin/zsh","-lc","python3 - <<'PY'\nimport json,pathlib\nb=pathlib.Path('/Users/thomi/.codex/visualizations/2026/09/18/01a0b6ce-e2ad-7853-bb2f-19731062a2c9/code-quality-audit');p=b/'coverage.json';a=json.loads(p.read_text())\nfor x in a:\n if x['path'].endswith(('/offline_relevance_eval.py','/test_offline_relevance_eval.py','/relevance_dataset.py','/test_relevance_dataset.py')):\n  x.update(review_status='source-inspected',checks=['Complete implementation and test source read; inspected metric arithmetic, temporal membership, schema subset and retained review contracts.'],notes='Diagnostic authority disabled intentionally. Schema subset and repeated session-map conversion candidates recorded; no new confirmed finding.')\np.write_text(json.dumps(a,indent=2)+'\\n')\nwith (b/'expanded-findings.md').open('a') as f:f.write('\\n### Offline relevance and dataset full coverage notes\\nFour implementation/test files fully read. Offline evaluator explicitly disables authoritative selections; producer metadata limitations are deliberate and mutation-tested. Dataset schema validator ignores prefixItems/maxItems/maximum and ref siblings; test_generated_report_matches_fail_closed_schema explicitly acknowledges prefixItems noncoverage, worth specific contract verification before promoting. relevance_dataset.propose reconstructs the entire session-date dict inside each task/fact loop (line 1365 approximately), introducing O(tasks*facts*sessions) conversion work; materialize similarly reconstructs per judgment. Temporal parser uses datetime microsecond precision whereas offline evaluator preserves nanoseconds; potential boundary false exclusions, not confirmed against data. No additional finding numbered yet.\\n')\nprint('coverage',sum(x['review_status']=='source-inspected' for x in a))\nPY"],"cwd":"file:///Users/thomi/.codex/worktrees/5d33/entire-brain","parsed_cmd":[{"type":"unknown","cmd":"python3 - <<'PY'\nimport json,pathlib\nb=pathlib.Path('/Users/thomi/.codex/visualizations/2026/09/18/01a0b6ce-e2ad-7853-bb2f-19731062a2c9/code-quality-audit');p=b/'coverage.json';a=json.loads(p.read_text())\nfor x in a:\n if x['path'].endswith(('/offline_relevance_eval.py','/test_offline_relevance_eval.py','/relevance_dataset.py','/test_relevance_dataset.py')):\n  x.update(review_status='source-inspected',checks=['Complete implementation and test source read; inspected metric arithmetic, temporal membership, schema subset and retained review contracts.'],notes='Diagnostic authority disabled intentionally. Schema subset and repeated session-map conversion candidates recorded; no new confirmed finding.')\np.write_text(json.dumps(a,indent=2)+'\\n')\nwith (b/'expanded-findings.md').open('a') as f:f.write('\\n### Offline relevance and dataset full coverage notes\\nFour implementation/test files fully read. Offline evaluator explicitly disables authoritative selections; producer metadata limitations are deliberate and mutation-tested. Dataset schema validator ignores prefixItems/maxItems/maximum and ref siblings; test_generated_report_matches_fail_closed_schema explicitly acknowledges prefixItems noncoverage, worth specific contract verification before promoting. relevance_dataset.propose reconstructs the entire session-date dict inside each task/fact loop (line 1365 approximately), introducing O(tasks*facts*sessions) conversion work; materialize similarly reconstructs per judgment. Temporal parser uses datetime microsecond precision whereas offline evaluator preserves nanoseconds; potential boundary false exclusions, not confirmed against data. No additional finding numbered yet.\\n')\nprint('coverage',sum(x['review_status']=='source-inspected' for x in a))\nPY"}],"source":"unified_exec_startup","status":"completed","stdout":"coverage 892\n","stderr":"","aggregated_output":"coverage 892\n","exit_code":0,"duration":{"secs":0,"nanos":2875},"formatted_output":"coverage 892\n"},"started_at_ms":1789839570157,"completed_at_ms":1789839570157}}
{"timestamp":"2026-09-19T17:39:30.255Z","ordinal":7513,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","item":{"type":"CommandExecution","id":"exec-0efd2657-fc87-4abe-ac6b-1f14834f4b9b","process_id":"28379","command":["/bin/zsh","-lc","sed -n '1,530p' benchmarks/agent-brain/confirmatory/power_analysis.py"],"cwd":"file:///Users/thomi/.codex/worktrees/5d33/entire-brain","parsed_cmd":[{"type":"read","cmd":"sed -n '1,530p' benchmarks/agent-brain/confirmatory/power_analysis.py","name":"power_analysis.py","path":"benchmarks/agent-brain/confirmatory/power_analysis.py"}],"source":"unified_exec_startup","status":"completed","stdout":"#!/usr/bin/env python3\n\"\"\"Deterministic v3 power-readiness contract for the three co-primary endpoints.\n\nThe authoritative report stays uncalibrated until final-contract paired task\nrows exist for elapsed time, normalized billed cost, and code quality. Legacy\ntoken/pass-rate calculations remain below only as quarantined exploratory\ncompatibility helpers; they cannot enter ``build_report`` or pass a gate.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport math\nimport pathlib\nimport sys\nfrom statistics import NormalDist, fmean, stdev\nfrom typing import Any, Callable\n\n\nHERE = pathlib.Path(__file__).resolve().parent\nREPO = HERE.parents[2]\nAGENT_BRAIN = REPO / \"benchmarks\" / \"agent-brain\"\nif str(AGENT_BRAIN) not in sys.path:\n    sys.path.insert(0, str(AGENT_BRAIN))\n\nfrom analysis.common import EXECUTED_RUN_PREDICATE_VERSION, is_executed_run  # noqa: E402\n\n\nPOWER_ARTIFACT_SCHEMA_VERSION = 3\nPOWER_ARTIFACT_ID = \"agent-brain-confirmatory-power-v3\"\nPOWER_ANALYSIS_KIND = \"three_endpoint_intersection_union_power_calibration_pending\"\nTASKS = 24\nREPETITIONS = 4\nPRIMARY_TREATMENT_IDS = (\"no_memory\", \"placebo_packet\", \"retrieved_memory\")\nPRIMARY_TREATMENTS = len(PRIMARY_TREATMENT_IDS)\nREQUESTED_CELLS = TASKS * REPETITIONS * PRIMARY_TREATMENTS\nAGENT_RETRY_LIMIT = 0\nREPLACEMENT_CELL_LIMIT = 0\nMAXIMUM_AGENT_INVOCATIONS = REQUESTED_CELLS\nTARGET_POWER = 0.80\nMINIMUM_CALIBRATION_TASK_CLUSTERS = 12\nTIME_REDUCTION_TARGET = 0.10\nCOST_REDUCTION_TARGET = 0.12\nQUALITY_DIFFERENCE_TARGET = 0.05\nTOKEN_REDUCTION_TARGET = 0.12\nTOKEN_RATIO_TARGET = 1.0 - TOKEN_REDUCTION_TARGET\nCORRECTNESS_MARGIN = -0.10\nFAMILY_ALPHA = 0.05\nFAMILY_COMPARISONS = 2\nPRIMARY_CONTRAST = \"retrieved_memory_vs_no_memory\"\nCLUSTER_UNIT = \"task\"\nATTEMPT_POLICY = \"all_executed_attempts\"\nPENDING_ENDPOINT_STATUS = \"pending_final_contract_calibration_and_alternative\"\nPENDING_ALTERNATIVE_STATUS = \"pending_owner_approval\"\nPENDING_POWER_STATUS = \"pending_uncalibrated\"\nJOINT_POWER_METHOD = \"frozen_endpoint_dependence_simulation_or_conservative_bound\"\nCOMPONENT_TESTS = \"one-sided task-clustered superiority at each frozen claim floor\"\nJOINT_RULE = (\n    \"intersection-union: all three component nulls must be rejected; no \"\n    \"across-endpoint multiplicity adjustment is required\"\n)\nPLANNING_RULE = (\n    \"owner-frozen true alternatives must be strictly better than claim floors; each \"\n    \"marginal power and overall intersection-union joint success probability must \"\n    \"each meet 0.80\"\n)\nPENDING_REASON = (\n    \"planning alternatives, final-contract variance inputs, and endpoint dependence are pending\"\n)\nPOWERED_TRANSITION_ERROR = (\n    \"power artifact schema v3 is pending-only; evaluated power requires a new versioned \"\n    \"schema, a content-hashed owner-approved final-calibration or assumption contract, \"\n    \"and deterministic power recomputation from those authenticated inputs\"\n)\nENDPOINT_IDENTITIES: tuple[tuple[str, str, str, float], ...] = (\n    (\"elapsed_time\", \"paired_task_log_ratio\", \"ratio_max\", 0.90),\n    (\n        \"normalized_cost\",\n        \"ratio_of_equal_task_weighted_task_arm_mean_costs\",\n        \"ratio_max\",\n        0.88,\n    ),\n    (\"code_quality\", \"paired_task_difference\", \"difference_min\", 0.05),\n)\n# Holm's first (worst-case) threshold for retrieved-vs-no-memory when the\n# endpoint family also contains placebo-vs-no-memory.\nPLANNING_ALPHA = FAMILY_ALPHA / FAMILY_COMPARISONS\nNORMAL = NormalDist()\nCALIBRATION_MANIFEST = HERE / \"power-calibration-exploratory-v1.json\"\nREPETITION_TRADEOFFS = (1, 2, 3, 4, 6, 8, 12)\nTASK_TRADEOFFS = (24, 48, 64, 80, 96, 118, 128)\n\n\nSCENARIOS: tuple[dict[str, Any], ...] = (\n    {\n        \"id\": \"favorable_high_pairing\",\n        \"role\": \"sensitivity_only\",\n        \"description\": \"Low heterogeneity and strong task pairing; deliberately favorable.\",\n        \"token\": {\n            \"between_task_log_ratio_sd\": 0.10,\n            \"within_attempt_log_token_sd\": 0.15,\n            \"cross_treatment_residual_correlation\": 0.50,\n        },\n        \"correctness\": {\n            \"no_memory_pass_probability\": 0.80,\n            \"retrieved_memory_pass_probability\": 0.80,\n            \"within_arm_attempt_icc\": 0.05,\n            \"cross_treatment_task_mean_correlation\": 0.80,\n        },\n    },\n    {\n        \"id\": \"conservative_planning\",\n        \"role\": \"decision_scenario\",\n        \"description\": (\n            \"Material task heterogeneity, moderate repeated-attempt clustering, and no assumed \"\n            \"cross-treatment pairing benefit.\"\n        ),\n        \"token\": {\n            \"between_task_log_ratio_sd\": 0.25,\n            \"within_attempt_log_token_sd\": 0.30,\n            \"cross_treatment_residual_correlation\": 0.00,\n        },\n        \"correctness\": {\n            \"no_memory_pass_probability\": 0.75,\n            \"retrieved_memory_pass_probability\": 0.75,\n            \"within_arm_attempt_icc\": 0.20,\n            \"cross_treatment_task_mean_correlation\": 0.00,\n        },\n    },\n    {\n        \"id\": \"stress_lower_correctness\",\n        \"role\": \"sensitivity_only\",\n        \"description\": \"Higher heterogeneity and a true correctness difference of -0.03, still inside the -0.10 margin.\",\n        \"token\": {\n            \"between_task_log_ratio_sd\": 0.35,\n            \"within_attempt_log_token_sd\": 0.40,\n            \"cross_treatment_residual_correlation\": 0.00,\n        },\n        \"correctness\": {\n            \"no_memory_pass_probability\": 0.60,\n            \"retrieved_memory_pass_probability\": 0.57,\n            \"within_arm_attempt_icc\": 0.30,\n            \"cross_treatment_task_mean_correlation\": 0.00,\n        },\n    },\n)\n\n\ndef _sha256(path: pathlib.Path) -> str:\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\ndef _repo_file(raw_path: Any) -> pathlib.Path:\n    if not isinstance(raw_path, str) or not raw_path:\n        raise ValueError(\"calibration path must be a non-empty repo-relative string\")\n    relative = pathlib.Path(raw_path)\n    if relative.is_absolute() or \"..\" in relative.parts:\n        raise ValueError(f\"unsafe calibration path: {raw_path!r}\")\n    resolved = (REPO / relative).resolve()\n    try:\n        resolved.relative_to(REPO.resolve())\n    except ValueError as exc:\n        raise ValueError(f\"calibration path escapes repository: {raw_path!r}\") from exc\n    if not resolved.is_file():\n        raise ValueError(f\"calibration file does not exist: {raw_path}\")\n    return resolved\n\n\ndef _verified_file(record: dict[str, Any]) -> pathlib.Path:\n    path = _repo_file(record.get(\"path\"))\n    expected = record.get(\"sha256\")\n    actual = _sha256(path)\n    if not isinstance(expected, str) or expected != actual:\n        raise ValueError(f\"calibration content hash mismatch: {record.get('path')}\")\n    return path\n\n\ndef _load_ndjson(path: pathlib.Path) -> list[dict[str, Any]]:\n    records: list[dict[str, Any]] = []\n    for line_number, line in enumerate(path.read_text(encoding=\"utf-8\").splitlines(), 1):\n        if not line.strip():\n            continue\n        value = json.loads(line)\n        if not isinstance(value, dict):\n            raise ValueError(f\"{path}:{line_number}: calibration record must be an object\")\n        records.append(value)\n    return records\n\n\ndef _positive_number(value: Any) -> float | None:\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\n        return None\n    number = float(value)\n    return number if math.isfinite(number) and number > 0.0 else None\n\n\ndef _record_tokens(record: dict[str, Any]) -> float | None:\n    agent_info = record.get(\"agent_info\")\n    usage = agent_info.get(\"usage\") if isinstance(agent_info, dict) else None\n    return _positive_number(usage.get(\"total_tokens\")) if isinstance(usage, dict) else None\n\n\ndef _record_correct(record: dict[str, Any]) -> float | None:\n    validation = record.get(\"validation\")\n    value = validation.get(\"ok\") if isinstance(validation, dict) else None\n    return float(value) if isinstance(value, bool) else None\n\n\ndef _sample_sd(values: list[float]) -> float | None:\n    return stdev(values) if len(values) >= 2 else None\n\n\ndef _correlation(left: list[float], right: list[float]) -> float | None:\n    if len(left) != len(right) or len(left) < 2:\n        return None\n    left_mean, right_mean = fmean(left), fmean(right)\n    left_delta = [value - left_mean for value in left]\n    right_delta = [value - right_mean for value in right]\n    denominator = math.sqrt(\n        sum(value * value for value in left_delta) * sum(value * value for value in right_delta)\n    )\n    if denominator == 0.0:\n        return None\n    return sum(a * b for a, b in zip(left_delta, right_delta)) / denominator\n\n\ndef _dirty_state(record: dict[str, Any]) -> bool | None:\n    provenance = record.get(\"provenance\")\n    harness = provenance.get(\"harness\") if isinstance(provenance, dict) else None\n    dirty = harness.get(\"dirty\") if isinstance(harness, dict) else None\n    value = dirty.get(\"dirty\") if isinstance(dirty, dict) else None\n    return value if isinstance(value, bool) else None\n\n\ndef _source_calibration(source: dict[str, Any]) -> dict[str, Any]:\n    path = _verified_file(source)\n    records = _load_ndjson(path)\n    control = source.get(\"control_condition\")\n    memory = source.get(\"memory_condition\")\n    if not isinstance(control, str) or not isinstance(memory, str) or control == memory:\n        raise ValueError(f\"invalid calibration conditions for {source.get('id')}\")\n    contamination = source.get(\"contamination\")\n    if (\n        not isinstance(contamination, list)\n        or not contamination\n        or any(not isinstance(reason, str) or not reason for reason in contamination)\n    ):\n        raise ValueError(f\"calibration contamination reasons are missing for {source.get('id')}\")\n    executed = [record for record in records if is_executed_run(record)]\n    selected = [record for record in executed if record.get(\"condition\") in {control, memory}]\n    tasks: dict[str, dict[str, list[dict[str, Any]]]] = {}\n    seen_cells: set[tuple[str, str, Any]] = set()\n    for record in selected:\n        task_id = record.get(\"task_id\")\n        condition = record.get(\"condition\")\n        if not isinstance(task_id, str) or not task_id:\n            raise ValueError(f\"calibration record in {source.get('path')} has no task_id\")\n        repetition = record.get(\"repetition\")\n        try:\n            cell = (task_id, condition, repetition)\n            duplicate = cell in seen_cells\n        except TypeError as exc:\n            raise ValueError(f\"calibration repetition is not hashable for {task_id}\") from exc\n        if duplicate:\n            raise ValueError(\n                f\"duplicate calibration task/condition/repetition cell: {task_id}/{condition}/{repetition}\"\n            )\n        seen_cells.add(cell)\n        tasks.setdefault(task_id, {}).setdefault(condition, []).append(record)\n\n    task_rows: list[dict[str, Any]] = []\n    token_residuals: list[float] = []\n    paired_residual_control: list[float] = []\n    paired_residual_memory: list[float] = []\n    arm_values: dict[str, dict[str, list[float]]] = {\n        control: {\"tokens\": [], \"correctness\": []},\n        memory: {\"tokens\": [], \"correctness\": []},\n    }\n    for task_id in sorted(tasks):\n        by_condition = tasks[task_id]\n        if control not in by_condition or memory not in by_condition:\n            continue\n        row: dict[str, Any] = {\"task_id\": task_id, \"conditions\": {}}\n        condition_log_means: dict[str, float] = {}\n        repetition_logs: dict[str, dict[Any, float]] = {}\n        for condition in (control, memory):\n            condition_records = by_condition[condition]\n            tokens = [\n                value\n                for value in (_record_tokens(record) for record in condition_records)\n                if value is not None\n            ]\n            correctness = [\n                value\n                for value in (_record_correct(record) for record in condition_records)\n                if value is not None\n            ]\n            arm_values[condition][\"tokens\"].extend(tokens)\n            arm_values[condition][\"correctness\"].extend(correctness)\n            log_tokens = [math.log(value) for value in tokens]\n            if log_tokens:\n                condition_log_means[condition] = fmean(log_tokens)\n                token_residuals.extend(value - condition_log_means[condition] for value in log_tokens)\n            repetitions: dict[Any, float] = {}\n            for record in condition_records:\n                token = _record_tokens(record)\n                repetition = record.get(\"repetition\")\n                if token is not None and repetition not in repetitions:\n                    repetitions[repetition] = math.log(token)\n            repetition_logs[condition] = repetitions\n            row[\"conditions\"][condition] = {\n                \"executed_attempts\": len(condition_records),\n                \"token_measurements\": len(tokens),\n                \"correctness_measurements\": len(correctness),\n                \"mean_total_tokens\": fmean(tokens) if tokens else None,\n                \"pass_rate\": fmean(correctness) if correctness else None,\n            }\n        control_tokens = row[\"conditions\"][control][\"mean_total_tokens\"]\n        memory_tokens = row[\"conditions\"][memory][\"mean_total_tokens\"]\n        control_pass = row[\"conditions\"][control][\"pass_rate\"]\n        memory_pass = row[\"conditions\"][memory][\"pass_rate\"]\n        row[\"mean_token_log_ratio_memory_vs_control\"] = (\n            math.log(memory_tokens / control_tokens)\n            if control_tokens is not None and memory_tokens is not None\n            else None\n        )\n        row[\"pass_rate_difference_memory_minus_control\"] = (\n            memory_pass - control_pass\n            if control_pass is not None and memory_pass is not None\n            else None\n        )\n        task_rows.append(row)\n\n        paired_repetitions = sorted(\n            set(repetition_logs[control]) & set(repetition_logs[memory]), key=lambda value: str(value)\n        )\n        for repetition in paired_repetitions:\n            if control in condition_log_means and memory in condition_log_means:\n                paired_residual_control.append(\n                    repetition_logs[control][repetition] - condition_log_means[control]\n                )\n                paired_residual_memory.append(\n                    repetition_logs[memory][repetition] - condition_log_means[memory]\n                )\n\n    log_ratios = [\n        row[\"mean_token_log_ratio_memory_vs_control\"]\n        for row in task_rows\n        if row[\"mean_token_log_ratio_memory_vs_control\"] is not None\n    ]\n    pass_differences = [\n        row[\"pass_rate_difference_memory_minus_control\"]\n        for row in task_rows\n        if row[\"pass_rate_difference_memory_minus_control\"] is not None\n    ]\n    dirty_states = [_dirty_state(record) for record in selected]\n    arms = {}\n    for condition in (control, memory):\n        tokens = arm_values[condition][\"tokens\"]\n        correctness = arm_values[condition][\"correctness\"]\n        arms[condition] = {\n            \"token_measurements\": len(tokens),\n            \"correctness_measurements\": len(correctness),\n            \"mean_total_tokens\": fmean(tokens) if tokens else None,\n            \"pass_rate\": fmean(correctness) if correctness else None,\n        }\n    return {\n        \"id\": source.get(\"id\"),\n        \"path\": source.get(\"path\"),\n        \"sha256\": source.get(\"sha256\"),\n        \"diagnostic_role\": source.get(\"diagnostic_role\"),\n        \"eligibility\": \"exploratory_only_excluded_from_confirmatory_decision\",\n        \"control_condition\": control,\n        \"memory_condition\": memory,\n        \"contamination\": contamination,\n        \"record_counts\": {\n            \"raw\": len(records),\n            \"executed\": len(executed),\n            \"selected_conditions\": len(selected),\n            \"dirty_harness_true\": sum(value is True for value in dirty_states),\n            \"dirty_harness_false\": sum(value is False for value in dirty_states),\n            \"dirty_harness_unknown\": sum(value is None for value in dirty_states),\n        },\n        \"paired_task_clusters\": len(task_rows),\n        \"arms\": arms,\n        \"observed_diagnostics\": {\n            \"task_mean_log_token_ratio_count\": len(log_ratios),\n            \"task_mean_log_token_ratio_sd\": _sample_sd(log_ratios),\n            \"task_pass_rate_difference_count\": len(pass_differences),\n            \"task_pass_rate_difference_sd\": _sample_sd(pass_differences),\n            \"within_task_arm_log_token_residual_count\": len(token_residuals),\n            \"within_task_arm_log_token_residual_sd\": _sample_sd(token_residuals),\n            \"same_repetition_cross_condition_residual_pairs\": len(paired_residual_control),\n            \"same_repetition_cross_condition_residual_correlation\": _correlation(\n                paired_residual_control, paired_residual_memory\n            ),\n        },\n        \"paired_task_ids\": [row[\"task_id\"] for row in task_rows],\n    }\n\n\ndef build_calibration_diagnostics(\n    manifest_path: pathlib.Path = CALIBRATION_MANIFEST,\n) -> dict[str, Any]:\n    manifest = json.loads(manifest_path.read_text(encoding=\"utf-8\"))\n    if manifest.get(\"schema_version\") != 1:\n        raise ValueError(\"calibration manifest schema_version must be 1\")\n    if manifest.get(\"eligibility\") != \"exploratory_only\":\n        raise ValueError(\"calibration manifest must remain exploratory_only\")\n    if manifest.get(\"confirmatory_assumption_source\") is not False:\n        raise ValueError(\"exploratory calibration cannot be a confirmatory assumption source\")\n    decision_use = manifest.get(\"decision_use\")\n    prohibited = (\n        \"may_select_confirmatory_assumptions\",\n        \"may_reduce_task_count_or_repetitions\",\n        \"may_pass_power_gate\",\n    )\n    if not isinstance(decision_use, dict) or any(decision_use.get(key) is not False for key in prohibited):\n        raise ValueError(\"calibration decision-use quarantine is missing\")\n    sources = manifest.get(\"sources\")\n    if not isinstance(sources, list) or not sources:\n        raise ValueError(\"calibration manifest must contain sources\")\n    source_ids = [source.get(\"id\") for source in sources if isinstance(source, dict)]\n    if len(source_ids) != len(sources) or any(not isinstance(value, str) for value in source_ids):\n        raise ValueError(\"calibration sources require string ids\")\n    if len(source_ids) != len(set(source_ids)):\n        raise ValueError(\"calibration source ids must be unique\")\n    diagnostics = [_source_calibration(source) for source in sources]\n\n    excluded = manifest.get(\"excluded_sources\")\n    if not isinstance(excluded, list):\n        raise ValueError(\"calibration excluded_sources must be an array\")\n    verified_exclusions = []\n    for record in excluded:\n        if not isinstance(record, dict):\n            raise ValueError(\"calibration excluded source must be an object\")\n        _verified_file(record)\n        verified_exclusions.append(record)\n\n    unique_tasks = {task_id for source in diagnostics for task_id in source[\"paired_task_ids\"]}\n    cluster_instances = sum(source[\"paired_task_clusters\"] for source in diagnostics)\n    return {\n        \"manifest_path\": str(manifest_path.resolve().relative_to(REPO.resolve())),\n        \"manifest_sha256\": _sha256(manifest_path),\n        \"executed_run_predicate_version\": EXECUTED_RUN_PREDICATE_VERSION,\n        \"eligibility\": \"exploratory_only_excluded_from_confirmatory_decision\",\n        \"confirmatory_assumption_source\": False,\n        \"pooling_policy\": manifest.get(\"pooling_policy\"),\n        \"source_count\": len(diagnostics),\n        \"paired_task_cluster_instances\": cluster_instances,\n        \"unique_task_ids_across_sources\": len(unique_tasks),\n        \"pooled_estimate_prohibited\": True,\n        \"sources\": diagnostics,\n        \"excluded_sources\": verified_exclusions,\n        \"interpretation\": (\n            \"The byte-verified legacy records show material heterogeneity and correctness saturation, \"\n            \"but their selected tasks, legacy treatments, runners, and harness contracts are not \"\n            \"exchangeable with the candidate confirmatory experiment. They cannot select assumptions \"\n            \"or pass the power gate.\"\n        ),\n    }\n\n\ndef normal_two_sided_power(effect: float, standard_error: float, alpha: float) -> float:\n    \"\"\"Power for a two-sided normal test under a fixed nonzero effect.\"\"\"\n    if standard_error < 0:\n        raise ValueError(\"standard_error must be non-negative\")\n    if standard_error == 0:\n        return float(effect != 0)\n    critical = NORMAL.inv_cdf(1.0 - alpha / 2.0)\n    signal = abs(effect) / standard_error\n    return NORMAL.cdf(-critical - signal) + 1.0 - NORMAL.cdf(critical - signal)\n\n\ndef normal_noninferiority_power(\n    true_difference: float,\n    margin: float,\n    standard_error: float,\n    alpha: float,\n) -> float:\n    \"\"\"Power for lower CI > margin using a one-sided normal critical value.\"\"\"\n    if true_difference <= margin:\n        return 0.0\n    if standard_error < 0:\n        raise ValueError(\"standard_error must be non-negative\")\n    if standard_error == 0:\n        return 1.0\n    critical = NORMAL.inv_cdf(1.0 - alpha)\n    signal = (true_difference - margin) / standard_error\n    return NORMAL.cdf(signal - critical)\n\n\ndef token_task_sd(token: dict[str, float], repetitions: int) -> float:\n    \"\"\"SD of a task's mean log token ratio under the stated components.\"\"\"\n    between = token[\"between_task_log_ratio_sd\"]\n    within = token[\"within_attempt_log_token_sd\"]\n    correlation = token[\"cross_treatment_residual_correlation\"]\n    if repetitions < 1 or not -1.0 <= correlation <= 1.0:\n        raise ValueError(\"invalid token planning assumption\")\n    return math.sqrt(between**2 + 2.0 * within**2 * (1.0 - correlation) / repetitions)\n\n\ndef correctness_task_sd(correctness: dict[str, float], repetitions: int) -> float:\n    \"\"\"SD of a paired task-level pass-rate difference.\n\n    Each arm uses a Bernoulli variance inflated by 1 + (r - 1) * ICC.  The\n    cross-treatment correlation is applied to the two task-level arm means.\n    \"\"\"\n    p0 = correctness[\"no_memory_pass_probability\"]\n    p1 = correctness[\"retrieved_memory_pass_probability\"]\n    icc = correctness[\"within_arm_attempt_icc\"]\n    correlation = correctness[\"cross_treatment_task_mean_correlation\"]\n    if repetitions < 1 or not (0.0 <= p0 <= 1.0 and 0.0 <= p1 <= 1.0):\n        raise ValueError(\"invalid correctness probability\")\n    if not 0.0 <= icc <= 1.0 or not -1.0 <= correlation <= 1.0:\n        raise ValueError(\"invalid correctness correlation\")\n    design_effect = 1.0 + (repetitions - 1.0) * icc\n    variance0 = p0 * (1.0 - p0) * design_effect / repetitions\n    variance1 = p1 * (1.0 - p1) * design_effect / repetitions\n    covariance = correlation * math.sqrt(variance0 * variance1)\n    return math.sqrt(max(0.0, variance0 + variance1 - 2.0 * covariance))\n\n\ndef _minimum_tasks(power_at_tasks: Callable[[int], float], target: float) -> int | None:\n    for tasks in range(2, 10_001):\n        if power_at_tasks(tasks) >= target:\n            return tasks\n    return None\n","stderr":"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Deterministic v3 power-readiness contract for the three co-primary endpoints.\n\nThe authoritative report stays uncalibrated until final-contract paired task\nrows exist for elapsed time, normalized billed cost, and code quality. Legacy\ntoken/pass-rate calculations remain below only as quarantined exploratory\ncompatibility helpers; they cannot enter ``build_report`` or pass a gate.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport math\nimport pathlib\nimport sys\nfrom statistics import NormalDist, fmean, stdev\nfrom typing import Any, Callable\n\n\nHERE = pathlib.Path(__file__).resolve().parent\nREPO = HERE.parents[2]\nAGENT_BRAIN = REPO / \"benchmarks\" / \"agent-brain\"\nif str(AGENT_BRAIN) not in sys.path:\n    sys.path.insert(0, str(AGENT_BRAIN))\n\nfrom analysis.common import EXECUTED_RUN_PREDICATE_VERSION, is_executed_run  # noqa: E402\n\n\nPOWER_ARTIFACT_SCHEMA_VERSION = 3\nPOWER_ARTIFACT_ID = \"agent-brain-confirmatory-power-v3\"\nPOWER_ANALYSIS_KIND = \"three_endpoint_intersection_union_power_calibration_pending\"\nTASKS = 24\nREPETITIONS = 4\nPRIMARY_TREATMENT_IDS = (\"no_memory\", \"placebo_packet\", \"retrieved_memory\")\nPRIMARY_TREATMENTS = len(PRIMARY_TREATMENT_IDS)\nREQUESTED_CELLS = TASKS * REPETITIONS * PRIMARY_TREATMENTS\nAGENT_RETRY_LIMIT = 0\nREPLACEMENT_CELL_LIMIT = 0\nMAXIMUM_AGENT_INVOCATIONS = REQUESTED_CELLS\nTARGET_POWER = 0.80\nMINIMUM_CALIBRATION_TASK_CLUSTERS = 12\nTIME_REDUCTION_TARGET = 0.10\nCOST_REDUCTION_TARGET = 0.12\nQUALITY_DIFFERENCE_TARGET = 0.05\nTOKEN_REDUCTION_TARGET = 0.12\nTOKEN_RATIO_TARGET = 1.0 - TOKEN_REDUCTION_TARGET\nCORRECTNESS_MARGIN = -0.10\nFAMILY_ALPHA = 0.05\nFAMILY_COMPARISONS = 2\nPRIMARY_CONTRAST = \"retrieved_memory_vs_no_memory\"\nCLUSTER_UNIT = \"task\"\nATTEMPT_POLICY = \"all_executed_attempts\"\nPENDING_ENDPOINT_STATUS = \"pending_final_contract_calibration_and_alternative\"\nPENDING_ALTERNATIVE_STATUS = \"pending_owner_approval\"\nPENDING_POWER_STATUS = \"pending_uncalibrated\"\nJOINT_POWER_METHOD = \"frozen_endpoint_dependence_simulation_or_conservative_bound\"\nCOMPONENT_TESTS = \"one-sided task-clustered superiority at each frozen claim floor\"\nJOINT_RULE = (\n    \"intersection-union: all three component nulls must be rejected; no \"\n    \"across-endpoint multiplicity adjustment is required\"\n)\nPLANNING_RULE = (\n    \"owner-frozen true alternatives must be strictly better than claim floors; each \"\n    \"marginal power and overall intersection-union joint success probability must \"\n    \"each meet 0.80\"\n)\nPENDING_REASON = (\n    \"planning alternatives, final-contract variance inputs, and endpoint dependence are pending\"\n)\nPOWERED_TRANSITION_ERROR = (\n    \"power artifact schema v3 is pending-only; evaluated power requires a new versioned \"\n    \"schema, a content-hashed owner-approved final-calibration or assumption contract, \"\n    \"and deterministic power recomputation from those authenticated inputs\"\n)\nENDPOINT_IDENTITIES: tuple[tuple[str, str, str, float], ...] = (\n    (\"elapsed_time\", \"paired_task_log_ratio\", \"ratio_max\", 0.90),\n    (\n        \"normalized_cost\",\n        \"ratio_of_equal_task_weighted_task_arm_mean_costs\",\n        \"ratio_max\",\n        0.88,\n    ),\n    (\"code_quality\", \"paired_task_difference\", \"difference_min\", 0.05),\n)\n# Holm's first (worst-case) threshold for retrieved-vs-no-memory when the\n# endpoint family also contains placebo-vs-no-memory.\nPLANNING_ALPHA = FAMILY_ALPHA / FAMILY_COMPARISONS\nNORMAL = NormalDist()\nCALIBRATION_MANIFEST = HERE / \"power-calibration-exploratory-v1.json\"\nREPETITION_TRADEOFFS = (1, 2, 3, 4, 6, 8, 12)\nTASK_TRADEOFFS = (24, 48, 64, 80, 96, 118, 128)\n\n\nSCENARIOS: tuple[dict[str, Any], ...] = (\n    {\n        \"id\": \"favorable_high_pairing\",\n        \"role\": \"sensitivity_only\",\n        \"description\": \"Low heterogeneity and strong task pairing; deliberately favorable.\",\n        \"token\": {\n            \"between_task_log_ratio_sd\": 0.10,\n            \"within_attempt_log_token_sd\": 0.15,\n            \"cross_treatment_residual_correlation\": 0.50,\n        },\n        \"correctness\": {\n            \"no_memory_pass_probability\": 0.80,\n            \"retrieved_memory_pass_probability\": 0.80,\n            \"within_arm_attempt_icc\": 0.05,\n            \"cross_treatment_task_mean_correlation\": 0.80,\n        },\n    },\n    {\n        \"id\": \"conservative_planning\",\n        \"role\": \"decision_scenario\",\n        \"description\": (\n            \"Material task heterogeneity, moderate repeated-attempt clustering, and no assumed \"\n            \"cross-treatment pairing benefit.\"\n        ),\n        \"token\": {\n            \"between_task_log_ratio_sd\": 0.25,\n            \"within_attempt_log_token_sd\": 0.30,\n            \"cross_treatment_residual_correlation\": 0.00,\n        },\n        \"correctness\": {\n            \"no_memory_pass_probability\": 0.75,\n            \"retrieved_memory_pass_probability\": 0.75,\n            \"within_arm_attempt_icc\": 0.20,\n            \"cross_treatment_task_mean_correlation\": 0.00,\n        },\n    },\n    {\n        \"id\": \"stress_lower_correctness\",\n        \"role\": \"sensitivity_only\",\n        \"description\": \"Higher heterogeneity and a true correctness difference of -0.03, still inside the -0.10 margin.\",\n        \"token\": {\n            \"between_task_log_ratio_sd\": 0.35,\n            \"within_attempt_log_token_sd\": 0.40,\n            \"cross_treatment_residual_correlation\": 0.00,\n        },\n        \"correctness\": {\n            \"no_memory_pass_probability\": 0.60,\n            \"retrieved_memory_pass_probability\": 0.57,\n            \"within_arm_attempt_icc\": 0.30,\n            \"cross_treatment_task_mean_correlation\": 0.00,\n        },\n    },\n)\n\n\ndef _sha256(path: pathlib.Path) -> str:\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\ndef _repo_file(raw_path: Any) -> pathlib.Path:\n    if not isinstance(raw_path, str) or not raw_path:\n        raise ValueError(\"calibration path must be a non-empty repo-relative string\")\n    relative = pathlib.Path(raw_path)\n    if relative.is_absolute() or \"..\" in relative.parts:\n        raise ValueError(f\"unsafe calibration path: {raw_path!r}\")\n    resolved = (REPO / relative).resolve()\n    try:\n        resolved.relative_to(REPO.resolve())\n    except ValueError as exc:\n        raise ValueError(f\"calibration path escapes repository: {raw_path!r}\") from exc\n    if not resolved.is_file():\n        raise ValueError(f\"calibration file does not exist: {raw_path}\")\n    return resolved\n\n\ndef _verified_file(record: dict[str, Any]) -> pathlib.Path:\n    path = _repo_file(record.get(\"path\"))\n    expected = record.get(\"sha256\")\n    actual = _sha256(path)\n    if not isinstance(expected, str) or expected != actual:\n        raise ValueError(f\"calibration content hash mismatch: {record.get('path')}\")\n    return path\n\n\ndef _load_ndjson(path: pathlib.Path) -> list[dict[str, Any]]:\n    records: list[dict[str, Any]] = []\n    for line_number, line in enumerate(path.read_text(encoding=\"utf-8\").splitlines(), 1):\n        if not line.strip():\n            continue\n        value = json.loads(line)\n        if not isinstance(value, dict):\n            raise ValueError(f\"{path}:{line_number}: calibration record must be an object\")\n        records.append(value)\n    return records\n\n\ndef _positive_number(value: Any) -> float | None:\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\n        return None\n    number = float(value)\n    return number if math.isfinite(number) and number > 0.0 else None\n\n\ndef _record_tokens(record: dict[str, Any]) -> float | None:\n    agent_info = record.get(\"agent_info\")\n    usage = agent_info.get(\"usage\") if isinstance(agent_info, dict) else None\n    return _positive_number(usage.get(\"total_tokens\")) if isinstance(usage, dict) else None\n\n\ndef _record_correct(record: dict[str, Any]) -> float | None:\n    validation = record.get(\"validation\")\n    value = validation.get(\"ok\") if isinstance(validation, dict) else None\n    return float(value) if isinstance(value, bool) else None\n\n\ndef _sample_sd(values: list[float]) -> float | None:\n    return stdev(values) if len(values) >= 2 else None\n\n\ndef _correlation(left: list[float], right: list[float]) -> float | None:\n    if len(left) != len(right) or len(left) < 2:\n        return None\n    left_mean, right_mean = fmean(left), fmean(right)\n    left_delta = [value - left_mean for value in left]\n    right_delta = [value - right_mean for value in right]\n    denominator = math.sqrt(\n        sum(value * value for value in left_delta) * sum(value * value for value in right_delta)\n    )\n    if denominator == 0.0:\n        return None\n    return sum(a * b for a, b in zip(left_delta, right_delta)) / denominator\n\n\ndef _dirty_state(record: dict[str, Any]) -> bool | None:\n    provenance = record.get(\"provenance\")\n    harness = provenance.get(\"harness\") if isinstance(provenance, dict) else None\n    dirty = harness.get(\"dirty\") if isinstance(harness, dict) else None\n    value = dirty.get(\"dirty\") if isinstance(dirty, dict) else None\n    return value if isinstance(value, bool) else None\n\n\ndef _source_calibration(source: dict[str, Any]) -> dict[str, Any]:\n    path = _verified_file(source)\n    records = _load_ndjson(path)\n    control = source.get(\"control_condition\")\n    memory = source.get(\"memory_condition\")\n    if not isinstance(control, str) or not isinstance(memory, str) or control == memory:\n        raise ValueError(f\"invalid calibration conditions for {source.get('id')}\")\n    contamination = source.get(\"contamination\")\n    if (\n        not isinstance(contamination, list)\n        or not contamination\n        or any(not isinstance(reason, str) or not reason for reason in contamination)\n    ):\n        raise ValueError(f\"calibration contamination reasons are missing for {source.get('id')}\")\n    executed = [record for record in records if is_executed_run(record)]\n    selected = [record for record in executed if record.get(\"condition\") in {control, memory}]\n    tasks: dict[str, dict[str, list[dict[str, Any]]]] = {}\n    seen_cells: set[tuple[str, str, Any]] = set()\n    for record in selected:\n        task_id = record.get(\"task_id\")\n        condition = record.get(\"condition\")\n        if not isinstance(task_id, str) or not task_id:\n            raise ValueError(f\"calibration record in {source.get('path')} has no task_id\")\n        repetition = record.get(\"repetition\")\n        try:\n            cell = (task_id, condition, repetition)\n            duplicate = cell in seen_cells\n        except TypeError as exc:\n            raise ValueError(f\"calibration repetition is not hashable for {task_id}\") from exc\n        if duplicate:\n            raise ValueError(\n                f\"duplicate calibration task/condition/repetition cell: {task_id}/{condition}/{repetition}\"\n            )\n        seen_cells.add(cell)\n        tasks.setdefault(task_id, {}).setdefault(condition, []).append(record)\n\n    task_rows: list[dict[str, Any]] = []\n    token_residuals: list[float] = []\n    paired_residual_control: list[float] = []\n    paired_residual_memory: list[float] = []\n    arm_values: dict[str, dict[str, list[float]]] = {\n        control: {\"tokens\": [], \"correctness\": []},\n        memory: {\"tokens\": [], \"correctness\": []},\n    }\n    for task_id in sorted(tasks):\n        by_condition = tasks[task_id]\n        if control not in by_condition or memory not in by_condition:\n            continue\n        row: dict[str, Any] = {\"task_id\": task_id, \"conditions\": {}}\n        condition_log_means: dict[str, float] = {}\n        repetition_logs: dict[str, dict[Any, float]] = {}\n        for condition in (control, memory):\n            condition_records = by_condition[condition]\n            tokens = [\n                value\n                for value in (_record_tokens(record) for record in condition_records)\n                if value is not None\n            ]\n            correctness = [\n                value\n                for value in (_record_correct(record) for record in condition_records)\n                if value is not None\n            ]\n            arm_values[condition][\"tokens\"].extend(tokens)\n            arm_values[condition][\"correctness\"].extend(correctness)\n            log_tokens = [math.log(value) for value in tokens]\n            if log_tokens:\n                condition_log_means[condition] = fmean(log_tokens)\n                token_residuals.extend(value - condition_log_means[condition] for value in log_tokens)\n            repetitions: dict[Any, float] = {}\n            for record in condition_records:\n                token = _record_tokens(record)\n                repetition = record.get(\"repetition\")\n                if token is not None and repetition not in repetitions:\n                    repetitions[repetition] = math.log(token)\n            repetition_logs[condition] = repetitions\n            row[\"conditions\"][condition] = {\n                \"executed_attempts\": len(condition_records),\n                \"token_measurements\": len(tokens),\n                \"correctness_measurements\": len(correctness),\n                \"mean_total_tokens\": fmean(tokens) if tokens else None,\n                \"pass_rate\": fmean(correctness) if correctness else None,\n            }\n        control_tokens = row[\"conditions\"][control][\"mean_total_tokens\"]\n        memory_tokens = row[\"conditions\"][memory][\"mean_total_tokens\"]\n        control_pass = row[\"conditions\"][control][\"pass_rate\"]\n        memory_pass = row[\"conditions\"][memory][\"pass_rate\"]\n        row[\"mean_token_log_ratio_memory_vs_control\"] = (\n            math.log(memory_tokens / control_tokens)\n            if control_tokens is not None and memory_tokens is not None\n            else None\n        )\n        row[\"pass_rate_difference_memory_minus_control\"] = (\n            memory_pass - control_pass\n            if control_pass is not None and memory_pass is not None\n            else None\n        )\n        task_rows.append(row)\n\n        paired_repetitions = sorted(\n            set(repetition_logs[control]) & set(repetition_logs[memory]), key=lambda value: str(value)\n        )\n        for repetition in paired_repetitions:\n            if control in condition_log_means and memory in condition_log_means:\n                paired_residual_control.append(\n                    repetition_logs[control][repetition] - condition_log_means[control]\n                )\n                paired_residual_memory.append(\n                    repetition_logs[memory][repetition] - condition_log_means[memory]\n                )\n\n    log_ratios = [\n        row[\"mean_token_log_ratio_memory_vs_control\"]\n        for row in task_rows\n        if row[\"mean_token_log_ratio_memory_vs_control\"] is not None\n    ]\n    pass_differences = [\n        row[\"pass_rate_difference_memory_minus_control\"]\n        for row in task_rows\n        if row[\"pass_rate_difference_memory_minus_control\"] is not None\n    ]\n    dirty_states = [_dirty_state(record) for record in selected]\n    arms = {}\n    for condition in (control, memory):\n        tokens = arm_values[condition][\"tokens\"]\n        correctness = arm_values[condition][\"correctness\"]\n        arms[condition] = {\n            \"token_measurements\": len(tokens),\n            \"correctness_measurements\": len(correctness),\n            \"mean_total_tokens\": fmean(tokens) if tokens else None,\n            \"pass_rate\": fmean(correctness) if correctness else None,\n        }\n    return {\n        \"id\": source.get(\"id\"),\n        \"path\": source.get(\"path\"),\n        \"sha256\": source.get(\"sha256\"),\n        \"diagnostic_role\": source.get(\"diagnostic_role\"),\n        \"eligibility\": \"exploratory_only_excluded_from_confirmatory_decision\",\n        \"control_condition\": control,\n        \"memory_condition\": memory,\n        \"contamination\": contamination,\n        \"record_counts\": {\n            \"raw\": len(records),\n            \"executed\": len(executed),\n            \"selected_conditions\": len(selected),\n            \"dirty_harness_true\": sum(value is True for value in dirty_states),\n            \"dirty_harness_false\": sum(value is False for value in dirty_states),\n            \"dirty_harness_unknown\": sum(value is None for value in dirty_states),\n        },\n        \"paired_task_clusters\": len(task_rows),\n        \"arms\": arms,\n        \"observed_diagnostics\": {\n            \"task_mean_log_token_ratio_count\": len(log_ratios),\n            \"task_mean_log_token_ratio_sd\": _sample_sd(log_ratios),\n            \"task_pass_rate_difference_count\": len(pass_differences),\n            \"task_pass_rate_difference_sd\": _sample_sd(pass_differences),\n            \"within_task_arm_log_token_residual_count\": len(token_residuals),\n            \"within_task_arm_log_token_residual_sd\": _sample_sd(token_residuals),\n            \"same_repetition_cross_condition_residual_pairs\": len(paired_residual_control),\n            \"same_repetition_cross_condition_residual_correlation\": _correlation(\n                paired_residual_control, paired_residual_memory\n            ),\n        },\n        \"paired_task_ids\": [row[\"task_id\"] for row in task_rows],\n    }\n\n\ndef build_calibration_diagnostics(\n    manifest_path: pathlib.Path = CALIBRATION_MANIFEST,\n) -> dict[str, Any]:\n    manifest = json.loads(manifest_path.read_text(encoding=\"utf-8\"))\n    if manifest.get(\"schema_version\") != 1:\n        raise ValueError(\"calibration manifest schema_version must be 1\")\n    if manifest.get(\"eligibility\") != \"exploratory_only\":\n        raise ValueError(\"calibration manifest must remain exploratory_only\")\n    if manifest.get(\"confirmatory_assumption_source\") is not False:\n        raise ValueError(\"exploratory calibration cannot be a confirmatory assumption source\")\n    decision_use = manifest.get(\"decision_use\")\n    prohibited = (\n        \"may_select_confirmatory_assumptions\",\n        \"may_reduce_task_count_or_repetitions\",\n        \"may_pass_power_gate\",\n    )\n    if not isinstance(decision_use, dict) or any(decision_use.get(key) is not False for key in prohibited):\n        raise ValueError(\"calibration decision-use quarantine is missing\")\n    sources = manifest.get(\"sources\")\n    if not isinstance(sources, list) or not sources:\n        raise ValueError(\"calibration manifest must contain sources\")\n    source_ids = [source.get(\"id\") for source in sources if isinstance(source, dict)]\n    if len(source_ids) != len(sources) or any(not isinstance(value, str) for value in source_ids):\n        raise ValueError(\"calibration sources require string ids\")\n    if len(source_ids) != len(set(source_ids)):\n        raise ValueError(\"calibration source ids must be unique\")\n    diagnostics = [_source_calibration(source) for source in sources]\n\n    excluded = manifest.get(\"excluded_sources\")\n    if not isinstance(excluded, list):\n        raise ValueError(\"calibration excluded_sources must be an array\")\n    verified_exclusions = []\n    for record in excluded:\n        if not isinstance(record, dict):\n            raise ValueError(\"calibration excluded source must be an object\")\n        _verified_file(record)\n        verified_exclusions.append(record)\n\n    unique_tasks = {task_id for source in diagnostics for task_id in source[\"paired_task_ids\"]}\n    cluster_instances = sum(source[\"paired_task_clusters\"] for source in diagnostics)\n    return {\n        \"manifest_path\": str(manifest_path.resolve().relative_to(REPO.resolve())),\n        \"manifest_sha256\": _sha256(manifest_path),\n        \"executed_run_predicate_version\": EXECUTED_RUN_PREDICATE_VERSION,\n        \"eligibility\": \"exploratory_only_excluded_from_confirmatory_decision\",\n        \"confirmatory_assumption_source\": False,\n        \"pooling_policy\": manifest.get(\"pooling_policy\"),\n        \"source_count\": len(diagnostics),\n        \"paired_task_cluster_instances\": cluster_instances,\n        \"unique_task_ids_across_sources\": len(unique_tasks),\n        \"pooled_estimate_prohibited\": True,\n        \"sources\": diagnostics,\n        \"excluded_sources\": verified_exclusions,\n        \"interpretation\": (\n            \"The byte-verified legacy records show material heterogeneity and correctness saturation, \"\n            \"but their selected tasks, legacy treatments, runners, and harness contracts are not \"\n            \"exchangeable with the candidate confirmatory experiment. They cannot select assumptions \"\n            \"or pass the power gate.\"\n        ),\n    }\n\n\ndef normal_two_sided_power(effect: float, standard_error: float, alpha: float) -> float:\n    \"\"\"Power for a two-sided normal test under a fixed nonzero effect.\"\"\"\n    if standard_error < 0:\n        raise ValueError(\"standard_error must be non-negative\")\n    if standard_error == 0:\n        return float(effect != 0)\n    critical = NORMAL.inv_cdf(1.0 - alpha / 2.0)\n    signal = abs(effect) / standard_error\n    return NORMAL.cdf(-critical - signal) + 1.0 - NORMAL.cdf(critical - signal)\n\n\ndef normal_noninferiority_power(\n    true_difference: float,\n    margin: float,\n    standard_error: float,\n    alpha: float,\n) -> float:\n    \"\"\"Power for lower CI > margin using a one-sided normal critical value.\"\"\"\n    if true_difference <= margin:\n        return 0.0\n    if standard_error < 0:\n        raise ValueError(\"standard_error must be non-negative\")\n    if standard_error == 0:\n        return 1.0\n    critical = NORMAL.inv_cdf(1.0 - alpha)\n    signal = (true_difference - margin) / standard_error\n    return NORMAL.cdf(signal - critical)\n\n\ndef token_task_sd(token: dict[str, float], repetitions: int) -> float:\n    \"\"\"SD of a task's mean log token ratio under the stated components.\"\"\"\n    between = token[\"between_task_log_ratio_sd\"]\n    within = token[\"within_attempt_log_token_sd\"]\n    correlation = token[\"cross_treatment_residual_correlation\"]\n    if repetitions < 1 or not -1.0 <= correlation <= 1.0:\n        raise ValueError(\"invalid token planning assumption\")\n    return math.sqrt(between**2 + 2.0 * within**2 * (1.0 - correlation) / repetitions)\n\n\ndef correctness_task_sd(correctness: dict[str, float], repetitions: int) -> float:\n    \"\"\"SD of a paired task-level pass-rate difference.\n\n    Each arm uses a Bernoulli variance inflated by 1 + (r - 1) * ICC.  The\n    cross-treatment correlation is applied to the two task-level arm means.\n    \"\"\"\n    p0 = correctness[\"no_memory_pass_probability\"]\n    p1 = correctness[\"retrieved_memory_pass_probability\"]\n    icc = correctness[\"within_arm_attempt_icc\"]\n    correlation = correctness[\"cross_treatment_task_mean_correlation\"]\n    if repetitions < 1 or not (0.0 <= p0 <= 1.0 and 0.0 <= p1 <= 1.0):\n        raise ValueError(\"invalid correctness probability\")\n    if not 0.0 <= icc <= 1.0 or not -1.0 <= correlation <= 1.0:\n        raise ValueError(\"invalid correctness correlation\")\n    design_effect = 1.0 + (repetitions - 1.0) * icc\n    variance0 = p0 * (1.0 - p0) * design_effect / repetitions\n    variance1 = p1 * (1.0 - p1) * design_effect / repetitions\n    covariance = correlation * math.sqrt(variance0 * variance1)\n    return math.sqrt(max(0.0, variance0 + variance1 - 2.0 * covariance))\n\n\ndef _minimum_tasks(power_at_tasks: Callable[[int], float], target: float) -> int | None:\n    for tasks in range(2, 10_001):\n        if power_at_tasks(tasks) >= target:\n            return tasks\n    return None\n","exit_code":0,"duration":{"secs":0,"nanos":2083},"formatted_output":"#!/usr/bin/env python3\n\"\"\"Deterministic v3 power-readiness contract for the three co-primary endpoints.\n\nThe authoritative report stays uncalibrated until final-contract paired task\nrows exist for elapsed time, normalized billed cost, and code quality. Legacy\ntoken/pass-rate calculations remain below only as quarantined exploratory\ncompatibility helpers; they cannot enter ``build_report`` or pass a gate.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport math\nimport pathlib\nimport sys\nfrom statistics import NormalDist, fmean, stdev\nfrom typing import Any, Callable\n\n\nHERE = pathlib.Path(__file__).resolve().parent\nREPO = HERE.parents[2]\nAGENT_BRAIN = REPO / \"benchmarks\" / \"agent-brain\"\nif str(AGENT_BRAIN) not in sys.path:\n    sys.path.insert(0, str(AGENT_BRAIN))\n\nfrom analysis.common import EXECUTED_RUN_PREDICATE_VERSION, is_executed_run  # noqa: E402\n\n\nPOWER_ARTIFACT_SCHEMA_VERSION = 3\nPOWER_ARTIFACT_ID = \"agent-brain-confirmatory-power-v3\"\nPOWER_ANALYSIS_KIND = \"three_endpoint_intersection_union_power_calibration_pending\"\nTASKS = 24\nREPETITIONS = 4\nPRIMARY_TREATMENT_IDS = (\"no_memory\", \"placebo_packet\", \"retrieved_memory\")\nPRIMARY_TREATMENTS = len(PRIMARY_TREATMENT_IDS)\nREQUESTED_CELLS = TASKS * REPETITIONS * PRIMARY_TREATMENTS\nAGENT_RETRY_LIMIT = 0\nREPLACEMENT_CELL_LIMIT = 0\nMAXIMUM_AGENT_INVOCATIONS = REQUESTED_CELLS\nTARGET_POWER = 0.80\nMINIMUM_CALIBRATION_TASK_CLUSTERS = 12\nTIME_REDUCTION_TARGET = 0.10\nCOST_REDUCTION_TARGET = 0.12\nQUALITY_DIFFERENCE_TARGET = 0.05\nTOKEN_REDUCTION_TARGET = 0.12\nTOKEN_RATIO_TARGET = 1.0 - TOKEN_REDUCTION_TARGET\nCORRECTNESS_MARGIN = -0.10\nFAMILY_ALPHA = 0.05\nFAMILY_COMPARISONS = 2\nPRIMARY_CONTRAST = \"retrieved_memory_vs_no_memory\"\nCLUSTER_UNIT = \"task\"\nATTEMPT_POLICY = \"all_executed_attempts\"\nPENDING_ENDPOINT_STATUS = \"pending_final_contract_calibration_and_alternative\"\nPENDING_ALTERNATIVE_STATUS = \"pending_owner_approval\"\nPENDING_POWER_STATUS = \"pending_uncalibrated\"\nJOINT_POWER_METHOD = \"frozen_endpoint_dependence_simulation_or_conservative_bound\"\nCOMPONENT_TESTS = \"one-sided task-clustered superiority at each frozen claim floor\"\nJOINT_RULE = (\n    \"intersection-union: all three component nulls must be rejected; no \"\n    \"across-endpoint multiplicity adjustment is required\"\n)\nPLANNING_RULE = (\n    \"owner-frozen true alternatives must be strictly better than claim floors; each \"\n    \"marginal power and overall intersection-union joint success probability must \"\n    \"each meet 0.80\"\n)\nPENDING_REASON = (\n    \"planning alternatives, final-contract variance inputs, and endpoint dependence are pending\"\n)\nPOWERED_TRANSITION_ERROR = (\n    \"power artifact schema v3 is pending-only; evaluated power requires a new versioned \"\n    \"schema, a content-hashed owner-approved final-calibration or assumption contract, \"\n    \"and deterministic power recomputation from those authenticated inputs\"\n)\nENDPOINT_IDENTITIES: tuple[tuple[str, str, str, float], ...] = (\n    (\"elapsed_time\", \"paired_task_log_ratio\", \"ratio_max\", 0.90),\n    (\n        \"normalized_cost\",\n        \"ratio_of_equal_task_weighted_task_arm_mean_costs\",\n        \"ratio_max\",\n        0.88,\n    ),\n    (\"code_quality\", \"paired_task_difference\", \"difference_min\", 0.05),\n)\n# Holm's first (worst-case) threshold for retrieved-vs-no-memory when the\n# endpoint family also contains placebo-vs-no-memory.\nPLANNING_ALPHA = FAMILY_ALPHA / FAMILY_COMPARISONS\nNORMAL = NormalDist()\nCALIBRATION_MANIFEST = HERE / \"power-calibration-exploratory-v1.json\"\nREPETITION_TRADEOFFS = (1, 2, 3, 4, 6, 8, 12)\nTASK_TRADEOFFS = (24, 48, 64, 80, 96, 118, 128)\n\n\nSCENARIOS: tuple[dict[str, Any], ...] = (\n    {\n        \"id\": \"favorable_high_pairing\",\n        \"role\": \"sensitivity_only\",\n        \"description\": \"Low heterogeneity and strong task pairing; deliberately favorable.\",\n        \"token\": {\n            \"between_task_log_ratio_sd\": 0.10,\n            \"within_attempt_log_token_sd\": 0.15,\n            \"cross_treatment_residual_correlation\": 0.50,\n        },\n        \"correctness\": {\n            \"no_memory_pass_probability\": 0.80,\n            \"retrieved_memory_pass_probability\": 0.80,\n            \"within_arm_attempt_icc\": 0.05,\n            \"cross_treatment_task_mean_correlation\": 0.80,\n        },\n    },\n    {\n        \"id\": \"conservative_planning\",\n        \"role\": \"decision_scenario\",\n        \"description\": (\n            \"Material task heterogeneity, moderate repeated-attempt clustering, and no assumed \"\n            \"cross-treatment pairing benefit.\"\n        ),\n        \"token\": {\n            \"between_task_log_ratio_sd\": 0.25,\n            \"within_attempt_log_token_sd\": 0.30,\n            \"cross_treatment_residual_correlation\": 0.00,\n        },\n        \"correctness\": {\n            \"no_memory_pass_probability\": 0.75,\n            \"retrieved_memory_pass_probability\": 0.75,\n            \"within_arm_attempt_icc\": 0.20,\n            \"cross_treatment_task_mean_correlation\": 0.00,\n        },\n    },\n    {\n        \"id\": \"stress_lower_correctness\",\n        \"role\": \"sensitivity_only\",\n        \"description\": \"Higher heterogeneity and a true correctness difference of -0.03, still inside the -0.10 margin.\",\n        \"token\": {\n            \"between_task_log_ratio_sd\": 0.35,\n            \"within_attempt_log_token_sd\": 0.40,\n            \"cross_treatment_residual_correlation\": 0.00,\n        },\n        \"correctness\": {\n            \"no_memory_pass_probability\": 0.60,\n            \"retrieved_memory_pass_probability\": 0.57,\n            \"within_arm_attempt_icc\": 0.30,\n            \"cross_treatment_task_mean_correlation\": 0.00,\n        },\n    },\n)\n\n\ndef _sha256(path: pathlib.Path) -> str:\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\ndef _repo_file(raw_path: Any) -> pathlib.Path:\n    if not isinstance(raw_path, str) or not raw_path:\n        raise ValueError(\"calibration path must be a non-empty repo-relative string\")\n    relative = pathlib.Path(raw_path)\n    if relative.is_absolute() or \"..\" in relative.parts:\n        raise ValueError(f\"unsafe calibration path: {raw_path!r}\")\n    resolved = (REPO / relative).resolve()\n    try:\n        resolved.relative_to(REPO.resolve())\n    except ValueError as exc:\n        raise ValueError(f\"calibration path escapes repository: {raw_path!r}\") from exc\n    if not resolved.is_file():\n        raise ValueError(f\"calibration file does not exist: {raw_path}\")\n    return resolved\n\n\ndef _verified_file(record: dict[str, Any]) -> pathlib.Path:\n    path = _repo_file(record.get(\"path\"))\n    expected = record.get(\"sha256\")\n    actual = _sha256(path)\n    if not isinstance(expected, str) or expected != actual:\n        raise ValueError(f\"calibration content hash mismatch: {record.get('path')}\")\n    return path\n\n\ndef _load_ndjson(path: pathlib.Path) -> list[dict[str, Any]]:\n    records: list[dict[str, Any]] = []\n    for line_number, line in enumerate(path.read_text(encoding=\"utf-8\").splitlines(), 1):\n        if not line.strip():\n            continue\n        value = json.loads(line)\n        if not isinstance(value, dict):\n            raise ValueError(f\"{path}:{line_number}: calibration record must be an object\")\n        records.append(value)\n    return records\n\n\ndef _positive_number(value: Any) -> float | None:\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\n        return None\n    number = float(value)\n    return number if math.isfinite(number) and number > 0.0 else None\n\n\ndef _record_tokens(record: dict[str, Any]) -> float | None:\n    agent_info = record.get(\"agent_info\")\n    usage = agent_info.get(\"usage\") if isinstance(agent_info, dict) else None\n    return _positive_number(usage.get(\"total_tokens\")) if isinstance(usage, dict) else None\n\n\ndef _record_correct(record: dict[str, Any]) -> float | None:\n    validation = record.get(\"validation\")\n    value = validation.get(\"ok\") if isinstance(validation, dict) else None\n    return float(value) if isinstance(value, bool) else None\n\n\ndef _sample_sd(values: list[float]) -> float | None:\n    return stdev(values) if len(values) >= 2 else None\n\n\ndef _correlation(left: list[float], right: list[float]) -> float | None:\n    if len(left) != len(right) or len(left) < 2:\n        return None\n    left_mean, right_mean = fmean(left), fmean(right)\n    left_delta = [value - left_mean for value in left]\n    right_delta = [value - right_mean for value in right]\n    denominator = math.sqrt(\n        sum(value * value for value in left_delta) * sum(value * value for value in right_delta)\n    )\n    if denominator == 0.0:\n        return None\n    return sum(a * b for a, b in zip(left_delta, right_delta)) / denominator\n\n\ndef _dirty_state(record: dict[str, Any]) -> bool | None:\n    provenance = record.get(\"provenance\")\n    harness = provenance.get(\"harness\") if isinstance(provenance, dict) else None\n    dirty = harness.get(\"dirty\") if isinstance(harness, dict) else None\n    value = dirty.get(\"dirty\") if isinstance(dirty, dict) else None\n    return value if isinstance(value, bool) else None\n\n\ndef _source_calibration(source: dict[str, Any]) -> dict[str, Any]:\n    path = _verified_file(source)\n    records = _load_ndjson(path)\n    control = source.get(\"control_condition\")\n    memory = source.get(\"memory_condition\")\n    if not isinstance(control, str) or not isinstance(memory, str) or control == memory:\n        raise ValueError(f\"invalid calibration conditions for {source.get('id')}\")\n    contamination = source.get(\"contamination\")\n    if (\n        not isinstance(contamination, list)\n        or not contamination\n        or any(not isinstance(reason, str) or not reason for reason in contamination)\n    ):\n        raise ValueError(f\"calibration contamination reasons are missing for {source.get('id')}\")\n    executed = [record for record in records if is_executed_run(record)]\n    selected = [record for record in executed if record.get(\"condition\") in {control, memory}]\n    tasks: dict[str, dict[str, list[dict[str, Any]]]] = {}\n    seen_cells: set[tuple[str, str, Any]] = set()\n    for record in selected:\n        task_id = record.get(\"task_id\")\n        condition = record.get(\"condition\")\n        if not isinstance(task_id, str) or not task_id:\n            raise ValueError(f\"calibration record in {source.get('path')} has no task_id\")\n        repetition = record.get(\"repetition\")\n        try:\n            cell = (task_id, condition, repetition)\n            duplicate = cell in seen_cells\n        except TypeError as exc:\n            raise ValueError(f\"calibration repetition is not hashable for {task_id}\") from exc\n        if duplicate:\n            raise ValueError(\n                f\"duplicate calibration task/condition/repetition cell: {task_id}/{condition}/{repetition}\"\n            )\n        seen_cells.add(cell)\n        tasks.setdefault(task_id, {}).setdefault(condition, []).append(record)\n\n    task_rows: list[dict[str, Any]] = []\n    token_residuals: list[float] = []\n    paired_residual_control: list[float] = []\n    paired_residual_memory: list[float] = []\n    arm_values: dict[str, dict[str, list[float]]] = {\n        control: {\"tokens\": [], \"correctness\": []},\n        memory: {\"tokens\": [], \"correctness\": []},\n    }\n    for task_id in sorted(tasks):\n        by_condition = tasks[task_id]\n        if control not in by_condition or memory not in by_condition:\n            continue\n        row: dict[str, Any] = {\"task_id\": task_id, \"conditions\": {}}\n        condition_log_means: dict[str, float] = {}\n        repetition_logs: dict[str, dict[Any, float]] = {}\n        for condition in (control, memory):\n            condition_records = by_condition[condition]\n            tokens = [\n                value\n                for value in (_record_tokens(record) for record in condition_records)\n                if value is not None\n            ]\n            correctness = [\n                value\n                for value in (_record_correct(record) for record in condition_records)\n                if value is not None\n            ]\n            arm_values[condition][\"tokens\"].extend(tokens)\n            arm_values[condition][\"correctness\"].extend(correctness)\n            log_tokens = [math.log(value) for value in tokens]\n            if log_tokens:\n                condition_log_means[condition] = fmean(log_tokens)\n                token_residuals.extend(value - condition_log_means[condition] for value in log_tokens)\n            repetitions: dict[Any, float] = {}\n            for record in condition_records:\n                token = _record_tokens(record)\n                repetition = record.get(\"repetition\")\n                if token is not None and repetition not in repetitions:\n                    repetitions[repetition] = math.log(token)\n            repetition_logs[condition] = repetitions\n            row[\"conditions\"][condition] = {\n                \"executed_attempts\": len(condition_records),\n                \"token_measurements\": len(tokens),\n                \"correctness_measurements\": len(correctness),\n                \"mean_total_tokens\": fmean(tokens) if tokens else None,\n                \"pass_rate\": fmean(correctness) if correctness else None,\n            }\n        control_tokens = row[\"conditions\"][control][\"mean_total_tokens\"]\n        memory_tokens = row[\"conditions\"][memory][\"mean_total_tokens\"]\n        control_pass = row[\"conditions\"][control][\"pass_rate\"]\n        memory_pass = row[\"conditions\"][memory][\"pass_rate\"]\n        row[\"mean_token_log_ratio_memory_vs_control\"] = (\n            math.log(memory_tokens / control_tokens)\n            if control_tokens is not None and memory_tokens is not None\n            else None\n        )\n        row[\"pass_rate_difference_memory_minus_control\"] = (\n            memory_pass - control_pass\n            if control_pass is not None and memory_pass is not None\n            else None\n        )\n        task_rows.append(row)\n\n        paired_repetitions = sorted(\n            set(repetition_logs[control]) & set(repetition_logs[memory]), key=lambda value: str(value)\n        )\n        for repetition in paired_repetitions:\n            if control in condition_log_means and memory in condition_log_means:\n                paired_residual_control.append(\n                    repetition_logs[control][repetition] - condition_log_means[control]\n                )\n                paired_residual_memory.append(\n                    repetition_logs[memory][repetition] - condition_log_means[memory]\n                )\n\n    log_ratios = [\n        row[\"mean_token_log_ratio_memory_vs_control\"]\n        for row in task_rows\n        if row[\"mean_token_log_ratio_memory_vs_control\"] is not None\n    ]\n    pass_differences = [\n        row[\"pass_rate_difference_memory_minus_control\"]\n        for row in task_rows\n        if row[\"pass_rate_difference_memory_minus_control\"] is not None\n    ]\n    dirty_states = [_dirty_state(record) for record in selected]\n    arms = {}\n    for condition in (control, memory):\n        tokens = arm_values[condition][\"tokens\"]\n        correctness = arm_values[condition][\"correctness\"]\n        arms[condition] = {\n            \"token_measurements\": len(tokens),\n            \"correctness_measurements\": len(correctness),\n            \"mean_total_tokens\": fmean(tokens) if tokens else None,\n            \"pass_rate\": fmean(correctness) if correctness else None,\n        }\n    return {\n        \"id\": source.get(\"id\"),\n        \"path\": source.get(\"path\"),\n        \"sha256\": source.get(\"sha256\"),\n        \"diagnostic_role\": source.get(\"diagnostic_role\"),\n        \"eligibility\": \"exploratory_only_excluded_from_confirmatory_decision\",\n        \"control_condition\": control,\n        \"memory_condition\": memory,\n        \"contamination\": contamination,\n        \"record_counts\": {\n            \"raw\": len(records),\n            \"executed\": len(executed),\n            \"selected_conditions\": len(selected),\n            \"dirty_harness_true\": sum(value is True for value in dirty_states),\n            \"dirty_harness_false\": sum(value is False for value in dirty_states),\n            \"dirty_harness_unknown\": sum(value is None for value in dirty_states),\n        },\n        \"paired_task_clusters\": len(task_rows),\n        \"arms\": arms,\n        \"observed_diagnostics\": {\n            \"task_mean_log_token_ratio_count\": len(log_ratios),\n            \"task_mean_log_token_ratio_sd\": _sample_sd(log_ratios),\n            \"task_pass_rate_difference_count\": len(pass_differences),\n            \"task_pass_rate_difference_sd\": _sample_sd(pass_differences),\n            \"within_task_arm_log_token_residual_count\": len(token_residuals),\n            \"within_task_arm_log_token_residual_sd\": _sample_sd(token_residuals),\n            \"same_repetition_cross_condition_residual_pairs\": len(paired_residual_control),\n            \"same_repetition_cross_condition_residual_correlation\": _correlation(\n                paired_residual_control, paired_residual_memory\n            ),\n        },\n        \"paired_task_ids\": [row[\"task_id\"] for row in task_rows],\n    }\n\n\ndef build_calibration_diagnostics(\n    manifest_path: pathlib.Path = CALIBRATION_MANIFEST,\n) -> dict[str, Any]:\n    manifest = json.loads(manifest_path.read_text(encoding=\"utf-8\"))\n    if manifest.get(\"schema_version\") != 1:\n        raise ValueError(\"calibration manifest schema_version must be 1\")\n    if manifest.get(\"eligibility\") != \"exploratory_only\":\n        raise ValueError(\"calibration manifest must remain exploratory_only\")\n    if manifest.get(\"confirmatory_assumption_source\") is not False:\n        raise ValueError(\"exploratory calibration cannot be a confirmatory assumption source\")\n    decision_use = manifest.get(\"decision_use\")\n    prohibited = (\n        \"may_select_confirmatory_assumptions\",\n        \"may_reduce_task_count_or_repetitions\",\n        \"may_pass_power_gate\",\n    )\n    if not isinstance(decision_use, dict) or any(decision_use.get(key) is not False for key in prohibited):\n        raise ValueError(\"calibration decision-use quarantine is missing\")\n    sources = manifest.get(\"sources\")\n    if not isinstance(sources, list) or not sources:\n        raise ValueError(\"calibration manifest must contain sources\")\n    source_ids = [source.get(\"id\") for source in sources if isinstance(source, dict)]\n    if len(source_ids) != len(sources) or any(not isinstance(value, str) for value in source_ids):\n        raise ValueError(\"calibration sources require string ids\")\n    if len(source_ids) != len(set(source_ids)):\n        raise ValueError(\"calibration source ids must be unique\")\n    diagnostics = [_source_calibration(source) for source in sources]\n\n    excluded = manifest.get(\"excluded_sources\")\n    if not isinstance(excluded, list):\n        raise ValueError(\"calibration excluded_sources must be an array\")\n    verified_exclusions = []\n    for record in excluded:\n        if not isinstance(record, dict):\n            raise ValueError(\"calibration excluded source must be an object\")\n        _verified_file(record)\n        verified_exclusions.append(record)\n\n    unique_tasks = {task_id for source in diagnostics for task_id in source[\"paired_task_ids\"]}\n    cluster_instances = sum(source[\"paired_task_clusters\"] for source in diagnostics)\n    return {\n        \"manifest_path\": str(manifest_path.resolve().relative_to(REPO.resolve())),\n        \"manifest_sha256\": _sha256(manifest_path),\n        \"executed_run_predicate_version\": EXECUTED_RUN_PREDICATE_VERSION,\n        \"eligibility\": \"exploratory_only_excluded_from_confirmatory_decision\",\n        \"confirmatory_assumption_source\": False,\n        \"pooling_policy\": manifest.get(\"pooling_policy\"),\n        \"source_count\": len(diagnostics),\n        \"paired_task_cluster_instances\": cluster_instances,\n        \"unique_task_ids_across_sources\": len(unique_tasks),\n        \"pooled_estimate_prohibited\": True,\n        \"sources\": diagnostics,\n        \"excluded_sources\": verified_exclusions,\n        \"interpretation\": (\n            \"The byte-verified legacy records show material heterogeneity and correctness saturation, \"\n            \"but their selected tasks, legacy treatments, runners, and harness contracts are not \"\n            \"exchangeable with the candidate confirmatory experiment. They cannot select assumptions \"\n            \"or pass the power gate.\"\n        ),\n    }\n\n\ndef normal_two_sided_power(effect: float, standard_error: float, alpha: float) -> float:\n    \"\"\"Power for a two-sided normal test under a fixed nonzero effect.\"\"\"\n    if standard_error < 0:\n        raise ValueError(\"standard_error must be non-negative\")\n    if standard_error == 0:\n        return float(effect != 0)\n    critical = NORMAL.inv_cdf(1.0 - alpha / 2.0)\n    signal = abs(effect) / standard_error\n    return NORMAL.cdf(-critical - signal) + 1.0 - NORMAL.cdf(critical - signal)\n\n\ndef normal_noninferiority_power(\n    true_difference: float,\n    margin: float,\n    standard_error: float,\n    alpha: float,\n) -> float:\n    \"\"\"Power for lower CI > margin using a one-sided normal critical value.\"\"\"\n    if true_difference <= margin:\n        return 0.0\n    if standard_error < 0:\n        raise ValueError(\"standard_error must be non-negative\")\n    if standard_error == 0:\n        return 1.0\n    critical = NORMAL.inv_cdf(1.0 - alpha)\n    signal = (true_difference - margin) / standard_error\n    return NORMAL.cdf(signal - critical)\n\n\ndef token_task_sd(token: dict[str, float], repetitions: int) -> float:\n    \"\"\"SD of a task's mean log token ratio under the stated components.\"\"\"\n    between = token[\"between_task_log_ratio_sd\"]\n    within = token[\"within_attempt_log_token_sd\"]\n    correlation = token[\"cross_treatment_residual_correlation\"]\n    if repetitions < 1 or not -1.0 <= correlation <= 1.0:\n        raise ValueError(\"invalid token planning assumption\")\n    return math.sqrt(between**2 + 2.0 * within**2 * (1.0 - correlation) / repetitions)\n\n\ndef correctness_task_sd(correctness: dict[str, float], repetitions: int) -> float:\n    \"\"\"SD of a paired task-level pass-rate difference.\n\n    Each arm uses a Bernoulli variance inflated by 1 + (r - 1) * ICC.  The\n    cross-treatment correlation is applied to the two task-level arm means.\n    \"\"\"\n    p0 = correctness[\"no_memory_pass_probability\"]\n    p1 = correctness[\"retrieved_memory_pass_probability\"]\n    icc = correctness[\"within_arm_attempt_icc\"]\n    correlation = correctness[\"cross_treatment_task_mean_correlation\"]\n    if repetitions < 1 or not (0.0 <= p0 <= 1.0 and 0.0 <= p1 <= 1.0):\n        raise ValueError(\"invalid correctness probability\")\n    if not 0.0 <= icc <= 1.0 or not -1.0 <= correlation <= 1.0:\n        raise ValueError(\"invalid correctness correlation\")\n    design_effect = 1.0 + (repetitions - 1.0) * icc\n    variance0 = p0 * (1.0 - p0) * design_effect / repetitions\n    variance1 = p1 * (1.0 - p1) * design_effect / repetitions\n    covariance = correlation * math.sqrt(variance0 * variance1)\n    return math.sqrt(max(0.0, variance0 + variance1 - 2.0 * covariance))\n\n\ndef _minimum_tasks(power_at_tasks: Callable[[int], float], target: float) -> int | None:\n    for tasks in range(2, 10_001):\n        if power_at_tasks(tasks) >= target:\n            return tasks\n    return None\n"},"started_at_ms":1789839570255,"completed_at_ms":1789839570255}}
{"timestamp":"2026-09-19T17:39:30.306Z","ordinal":7514,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0bac0-7582-76e0-b7f3-194a7d80d68e","call_id":"call_YjtFUn4gfCdfwCO09hAfne8c","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"70b0fd\",\"wall_time_seconds\":0.000002875,\"exit_code\":0,\"original_token_count\":4,\"output\":\"coverage 892\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"be5d98\",\"wall_time_seconds\":0.000002083,\"exit_code\":0,\"original_token_count\":5760,\"output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Deterministic v3 power-readiness contract for the three co-primary endpoints.\\n\\nThe authoritative report stays uncalibrated until final-contract paired task\\nrows exist for elapsed time, normalized billed cost, and code quality. Legacy\\ntoken/pass-rate calculations remain below only as quarantined exploratory\\ncompatibility helpers; they cannot enter ``build_report`` or pass a gate.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport hashlib\\nimport json\\nimport math\\nimport pathlib\\nimport sys\\nfrom statistics import NormalDist, fmean, stdev\\nfrom typing import Any, Callable\\n\\n\\nHERE = pathlib.Path(__file__).resolve().parent\\nREPO = HERE.parents[2]\\nAGENT_BRAIN = REPO / \\\"benchmarks\\\" / \\\"agent-brain\\\"\\nif str(AGENT_BRAIN) not in sys.path:\\n    sys.path.insert(0, str(AGENT_BRAIN))\\n\\nfrom analysis.common import EXECUTED_RUN_PREDICATE_VERSION, is_executed_run  # noqa: E402\\n\\n\\nPOWER_ARTIFACT_SCHEMA_VERSION = 3\\nPOWER_ARTIFACT_ID = \\\"agent-brain-confirmatory-power-v3\\\"\\nPOWER_ANALYSIS_KIND = \\\"three_endpoint_intersection_union_power_calibration_pending\\\"\\nTASKS = 24\\nREPETITIONS = 4\\nPRIMARY_TREATMENT_IDS = (\\\"no_memory\\\", \\\"placebo_packet\\\", \\\"retrieved_memory\\\")\\nPRIMARY_TREATMENTS = len(PRIMARY_TREATMENT_IDS)\\nREQUESTED_CELLS = TASKS * REPETITIONS * PRIMARY_TREATMENTS\\nAGENT_RETRY_LIMIT = 0\\nREPLACEMENT_CELL_LIMIT = 0\\nMAXIMUM_AGENT_INVOCATIONS = REQUESTED_CELLS\\nTARGET_POWER = 0.80\\nMINIMUM_CALIBRATION_TASK_CLUSTERS = 12\\nTIME_REDUCTION_TARGET = 0.10\\nCOST_REDUCTION_TARGET = 0.12\\nQUALITY_DIFFERENCE_TARGET = 0.05\\nTOKEN_REDUCTION_TARGET = 0.12\\nTOKEN_RATIO_TARGET = 1.0 - TOKEN_REDUCTION_TARGET\\nCORRECTNESS_MARGIN = -0.10\\nFAMILY_ALPHA = 0.05\\nFAMILY_COMPARISONS = 2\\nPRIMARY_CONTRAST = \\\"retrieved_memory_vs_no_memory\\\"\\nCLUSTER_UNIT = \\\"task\\\"\\nATTEMPT_POLICY = \\\"all_executed_attempts\\\"\\nPENDING_ENDPOINT_STATUS = \\\"pending_final_contract_calibration_and_alternative\\\"\\nPENDING_ALTERNATIVE_STATUS = \\\"pending_owner_approval\\\"\\nPENDING_POWER_STATUS = \\\"pending_uncalibrated\\\"\\nJOINT_POWER_METHOD = \\\"frozen_endpoint_dependence_simulation_or_conservative_bound\\\"\\nCOMPONENT_TESTS = \\\"one-sided task-clustered superiority at each frozen claim floor\\\"\\nJOINT_RULE = (\\n    \\\"intersection-union: all three component nulls must be rejected; no \\\"\\n    \\\"across-endpoint multiplicity adjustment is required\\\"\\n)\\nPLANNING_RULE = (\\n    \\\"owner-frozen true alternatives must be strictly better than claim floors; each \\\"\\n    \\\"marginal power and overall intersection-union joint success probability must \\\"\\n    \\\"each meet 0.80\\\"\\n)\\nPENDING_REASON = (\\n    \\\"planning alternatives, final-contract variance inputs, and endpoint dependence are pending\\\"\\n)\\nPOWERED_TRANSITION_ERROR = (\\n    \\\"power artifact schema v3 is pending-only; evaluated power requires a new versioned \\\"\\n    \\\"schema, a content-hashed owner-approved final-calibration or assumption contract, \\\"\\n    \\\"and deterministic power recomputation from those authenticated inputs\\\"\\n)\\nENDPOINT_IDENTITIES: tuple[tuple[str, str, str, float], ...] = (\\n    (\\\"elapsed_time\\\", \\\"paired_task_log_ratio\\\", \\\"ratio_max\\\", 0.90),\\n    (\\n        \\\"normalized_cost\\\",\\n        \\\"ratio_of_equal_task_weighted_task_arm_mean_costs\\\",\\n        \\\"ratio_max\\\",\\n        0.88,\\n    ),\\n    (\\\"code_quality\\\", \\\"paired_task_difference\\\", \\\"difference_min\\\", 0.05),\\n)\\n# Holm's first (worst-case) threshold for retrieved-vs-no-memory when the\\n# endpoint family also contains placebo-vs-no-memory.\\nPLANNING_ALPHA = FAMILY_ALPHA / FAMILY_COMPARISONS\\nNORMAL = NormalDist()\\nCALIBRATION_MANIFEST = HERE / \\\"power-calibration-exploratory-v1.json\\\"\\nREPETITION_TRADEOFFS = (1, 2, 3, 4, 6, 8, 12)\\nTASK_TRADEOFFS = (24, 48, 64, 80, 96, 118, 128)\\n\\n\\nSCENARIOS: tuple[dict[str, Any], ...] = (\\n    {\\n        \\\"id\\\": \\\"favorable_high_pairing\\\",\\n        \\\"role\\\": \\\"sensitivity_only\\\",\\n        \\\"description\\\": \\\"Low heterogeneity and strong task pairing; deliberately favorable.\\\",\\n        \\\"token\\\": {\\n            \\\"between_task_log_ratio_sd\\\": 0.10,\\n            \\\"within_attempt_log_token_sd\\\": 0.15,\\n            \\\"cross_treatment_residual_correlation\\\": 0.50,\\n        },\\n        \\\"correctness\\\": {\\n            \\\"no_memory_pass_probability\\\": 0.80,\\n            \\\"retrieved_memory_pass_probability\\\": 0.80,\\n            \\\"within_arm_attempt_icc\\\": 0.05,\\n            \\\"cross_treatment_task_mean_correlation\\\": 0.80,\\n        },\\n    },\\n    {\\n        \\\"id\\\": \\\"conservative_planning\\\",\\n        \\\"role\\\": \\\"decision_scenario\\\",\\n        \\\"description\\\": (\\n            \\\"Material task heterogeneity, moderate repeated-attempt clustering, and no assumed \\\"\\n            \\\"cross-treatment pairing benefit.\\\"\\n        ),\\n        \\\"token\\\": {\\n            \\\"between_task_log_ratio_sd\\\": 0.25,\\n            \\\"within_attempt_log_token_sd\\\": 0.30,\\n            \\\"cross_treatment_residual_correlation\\\": 0.00,\\n        },\\n        \\\"correctness\\\": {\\n            \\\"no_memory_pass_probability\\\": 0.75,\\n            \\\"retrieved_memory_pass_probability\\\": 0.75,\\n            \\\"within_arm_attempt_icc\\\": 0.20,\\n            \\\"cross_treatment_task_mean_correlation\\\": 0.00,\\n        },\\n    },\\n    {\\n        \\\"id\\\": \\\"stress_lower_correctness\\\",\\n        \\\"role\\\": \\\"sensitivity_only\\\",\\n        \\\"description\\\": \\\"Higher heterogeneity and a true correctness difference of -0.03, still inside the -0.10 margin.\\\",\\n        \\\"token\\\": {\\n            \\\"between_task_log_ratio_sd\\\": 0.35,\\n            \\\"within_attempt_log_token_sd\\\": 0.40,\\n            \\\"cross_treatment_residual_correlation\\\": 0.00,\\n        },\\n        \\\"correctness\\\": {\\n            \\\"no_memory_pass_probability\\\": 0.60,\\n            \\\"retrieved_memory_pass_probability\\\": 0.57,\\n            \\\"within_arm_attempt_icc\\\": 0.30,\\n            \\\"cross_treatment_task_mean_correlation\\\": 0.00,\\n        },\\n    },\\n)\\n\\n\\ndef _sha256(path: pathlib.Path) -> str:\\n    return hashlib.sha256(path.read_bytes()).hexdigest()\\n\\n\\ndef _repo_file(raw_path: Any) -> pathlib.Path:\\n    if not isinstance(raw_path, str) or not raw_path:\\n        raise ValueError(\\\"calibration path must be a non-empty repo-relative string\\\")\\n    relative = pathlib.Path(raw_path)\\n    if relative.is_absolute() or \\\"..\\\" in relative.parts:\\n        raise ValueError(f\\\"unsafe calibration path: {raw_path!r}\\\")\\n    resolved = (REPO / relative).resolve()\\n    try:\\n        resolved.relative_to(REPO.resolve())\\n    except ValueError as exc:\\n        raise ValueError(f\\\"calibration path escapes repository: {raw_path!r}\\\") from exc\\n    if not resolved.is_file():\\n        raise ValueError(f\\\"calibration file does not exist: {raw_path}\\\")\\n    return resolved\\n\\n\\ndef _verified_file(record: dict[str, Any]) -> pathlib.Path:\\n    path = _repo_file(record.get(\\\"path\\\"))\\n    expected = record.get(\\\"sha256\\\")\\n    actual = _sha256(path)\\n    if not isinstance(expected, str) or expected != actual:\\n        raise ValueError(f\\\"calibration content hash mismatch: {record.get('path')}\\\")\\n    return path\\n\\n\\ndef _load_ndjson(path: pathlib.Path) -> list[dict[str, Any]]:\\n    records: list[dict[str, Any]] = []\\n    for line_number, line in enumerate(path.read_text(encoding=\\\"utf-8\\\").splitlines(), 1):\\n        if not line.strip():\\n            continue\\n        value = json.loads(line)\\n        if not isinstance(value, dict):\\n            raise ValueError(f\\\"{path}:{line_number}: calibration record must be an object\\\")\\n        records.append(value)\\n    return records\\n\\n\\ndef _positive_number(value: Any) -> float | None:\\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\\n        return None\\n    number = float(value)\\n    return number if math.isfinite(number) and number > 0.0 else None\\n\\n\\ndef _record_tokens(record: dict[str, Any]) -> float | None:\\n    agent_info = record.get(\\\"agent_info\\\")\\n    usage = agent_info.get(\\\"usage\\\") if isinstance(agent_info, dict) else None\\n    return _positive_number(usage.get(\\\"total_tokens\\\")) if isinstance(usage, dict) else None\\n\\n\\ndef _record_correct(record: dict[str, Any]) -> float | None:\\n    validation = record.get(\\\"validation\\\")\\n    value = validation.get(\\\"ok\\\") if isinstance(validation, dict) else None\\n    return float(value) if isinstance(value, bool) else None\\n\\n\\ndef _sample_sd(values: list[float]) -> float | None:\\n    return stdev(values) if len(values) >= 2 else None\\n\\n\\ndef _correlation(left: list[float], right: list[float]) -> float | None:\\n    if len(left) != len(right) or len(left) < 2:\\n        return None\\n    left_mean, right_mean = fmean(left), fmean(right)\\n    left_delta = [value - left_mean for value in left]\\n    right_delta = [value - right_mean for value in right]\\n    denominator = math.sqrt(\\n        sum(value * value for value in left_delta) * sum(value * value for value in right_delta)\\n    )\\n    if denominator == 0.0:\\n        return None\\n    return sum(a * b for a, b in zip(left_delta, right_delta)) / denominator\\n\\n\\ndef _dirty_state(record: dict[str, Any]) -> bool | None:\\n    provenance = record.get(\\\"provenance\\\")\\n    harness = provenance.get(\\\"harness\\\") if isinstance(provenance, dict) else None\\n    dirty = harness.get(\\\"dirty\\\") if isinstance(harness, dict) else None\\n    value = dirty.get(\\\"dirty\\\") if isinstance(dirty, dict) else None\\n    return value if isinstance(value, bool) else None\\n\\n\\ndef _source_calibration(source: dict[str, Any]) -> dict[str, Any]:\\n    path = _verified_file(source)\\n    records = _load_ndjson(path)\\n    control = source.get(\\\"control_condition\\\")\\n    memory = source.get(\\\"memory_condition\\\")\\n    if not isinstance(control, str) or not isinstance(memory, str) or control == memory:\\n        raise ValueError(f\\\"invalid calibration conditions for {source.get('id')}\\\")\\n    contamination = source.get(\\\"contamination\\\")\\n    if (\\n        not isinstance(contamination, list)\\n        or not contamination\\n        or any(not isinstance(reason, str) or not reason for reason in contamination)\\n    ):\\n        raise ValueError(f\\\"calibration contamination reasons are missing for {source.get('id')}\\\")\\n    executed = [record for record in records if is_executed_run(record)]\\n    selected = [record for record in executed if record.get(\\\"condition\\\") in {control, memory}]\\n    tasks: dict[str, dict[str, list[dict[str, Any]]]] = {}\\n    seen_cells: set[tuple[str, str, Any]] = set()\\n    for record in selected:\\n        task_id = record.get(\\\"task_id\\\")\\n        condition = record.get(\\\"condition\\\")\\n        if not isinstance(task_id, str) or not task_id:\\n            raise ValueError(f\\\"calibration record in {source.get('path')} has no task_id\\\")\\n        repetition = record.get(\\\"repetition\\\")\\n        try:\\n            cell = (task_id, condition, repetition)\\n            duplicate = cell in seen_cells\\n        except TypeError as exc:\\n            raise ValueError(f\\\"calibration repetition is not hashable for {task_id}\\\") from exc\\n        if duplicate:\\n            raise ValueError(\\n                f\\\"duplicate calibration task/condition/repetition cell: {task_id}/{condition}/{repetition}\\\"\\n            )\\n        seen_cells.add(cell)\\n        tasks.setdefault(task_id, {}).setdefault(condition, []).append(record)\\n\\n    task_rows: list[dict[str, Any]] = []\\n    token_residuals: list[float] = []\\n    paired_residual_control: list[float] = []\\n    paired_residual_memory: list[float] = []\\n    arm_values: dict[str, dict[str, list[float]]] = {\\n        control: {\\\"tokens\\\": [], \\\"correctness\\\": []},\\n        memory: {\\\"tokens\\\": [], \\\"correctness\\\": []},\\n    }\\n    for task_id in sorted(tasks):\\n        by_condition = tasks[task_id]\\n        if control not in by_condition or memory not in by_condition:\\n            continue\\n        row: dict[str, Any] = {\\\"task_id\\\": task_id, \\\"conditions\\\": {}}\\n        condition_log_means: dict[str, float] = {}\\n        repetition_logs: dict[str, dict[Any, float]] = {}\\n        for condition in (control, memory):\\n            condition_records = by_condition[condition]\\n            tokens = [\\n                value\\n                for value in (_record_tokens(record) for record in condition_records)\\n                if value is not None\\n            ]\\n            correctness = [\\n                value\\n                for value in (_record_correct(record) for record in condition_records)\\n                if value is not None\\n            ]\\n            arm_values[condition][\\\"tokens\\\"].extend(tokens)\\n            arm_values[condition][\\\"correctness\\\"].extend(correctness)\\n            log_tokens = [math.log(value) for value in tokens]\\n            if log_tokens:\\n                condition_log_means[condition] = fmean(log_tokens)\\n                token_residuals.extend(value - condition_log_means[condition] for value in log_tokens)\\n            repetitions: dict[Any, float] = {}\\n            for record in condition_records:\\n                token = _record_tokens(record)\\n                repetition = record.get(\\\"repetition\\\")\\n                if token is not None and repetition not in repetitions:\\n                    repetitions[repetition] = math.log(token)\\n            repetition_logs[condition] = repetitions\\n            row[\\\"conditions\\\"][condition] = {\\n                \\\"executed_attempts\\\": len(condition_records),\\n                \\\"token_measurements\\\": len(tokens),\\n                \\\"correctness_measurements\\\": len(correctness),\\n                \\\"mean_total_tokens\\\": fmean(tokens) if tokens else None,\\n                \\\"pass_rate\\\": fmean(correctness) if correctness else None,\\n            }\\n        control_tokens = row[\\\"conditions\\\"][control][\\\"mean_total_tokens\\\"]\\n        memory_tokens = row[\\\"conditions\\\"][memory][\\\"mean_total_tokens\\\"]\\n        control_pass = row[\\\"conditions\\\"][control][\\\"pass_rate\\\"]\\n        memory_pass = row[\\\"conditions\\\"][memory][\\\"pass_rate\\\"]\\n        row[\\\"mean_token_log_ratio_memory_vs_control\\\"] = (\\n            math.log(memory_tokens / control_tokens)\\n            if control_tokens is not None and memory_tokens is not None\\n            else None\\n        )\\n        row[\\\"pass_rate_difference_memory_minus_control\\\"] = (\\n            memory_pass - control_pass\\n            if control_pass is not None and memory_pass is not None\\n            else None\\n        )\\n        task_rows.append(row)\\n\\n        paired_repetitions = sorted(\\n            set(repetition_logs[control]) & set(repetition_logs[memory]), key=lambda value: str(value)\\n        )\\n        for repetition in paired_repetitions:\\n            if control in condition_log_means and memory in condition_log_means:\\n                paired_residual_control.append(\\n                    repetition_logs[control][repetition] - condition_log_means[control]\\n                )\\n                paired_residual_memory.append(\\n                    repetition_logs[memory][repetition] - condition_log_means[memory]\\n                )\\n\\n    log_ratios = [\\n        row[\\\"mean_token_log_ratio_memory_vs_control\\\"]\\n        for row in task_rows\\n        if row[\\\"mean_token_log_ratio_memory_vs_control\\\"] is not None\\n    ]\\n    pass_differences = [\\n        row[\\\"pass_rate_difference_memory_minus_control\\\"]\\n        for row in task_rows\\n        if row[\\\"pass_rate_difference_memory_minus_control\\\"] is not None\\n    ]\\n    dirty_states = [_dirty_state(record) for record in selected]\\n    arms = {}\\n    for condition in (control, memory):\\n        tokens = arm_values[condition][\\\"tokens\\\"]\\n        correctness = arm_values[condition][\\\"correctness\\\"]\\n        arms[condition] = {\\n            \\\"token_measurements\\\": len(tokens),\\n            \\\"correctness_measurements\\\": len(correctness),\\n            \\\"mean_total_tokens\\\": fmean(tokens) if tokens else None,\\n            \\\"pass_rate\\\": fmean(correctness) if correctness else None,\\n        }\\n    return {\\n        \\\"id\\\": source.get(\\\"id\\\"),\\n        \\\"path\\\": source.get(\\\"path\\\"),\\n        \\\"sha256\\\": source.get(\\\"sha256\\\"),\\n        \\\"diagnostic_role\\\": source.get(\\\"diagnostic_role\\\"),\\n        \\\"eligibility\\\": \\\"exploratory_only_excluded_from_confirmatory_decision\\\",\\n        \\\"control_condition\\\": control,\\n        \\\"memory_condition\\\": memory,\\n        \\\"contamination\\\": contamination,\\n        \\\"record_counts\\\": {\\n            \\\"raw\\\": len(records),\\n            \\\"executed\\\": len(executed),\\n            \\\"selected_conditions\\\": len(selected),\\n            \\\"dirty_harness_true\\\": sum(value is True for value in dirty_states),\\n            \\\"dirty_harness_false\\\": sum(value is False for value in dirty_states),\\n            \\\"dirty_harness_unknown\\\": sum(value is None for value in dirty_states),\\n        },\\n        \\\"paired_task_clusters\\\": len(task_rows),\\n        \\\"arms\\\": arms,\\n        \\\"observed_diagnostics\\\": {\\n            \\\"task_mean_log_token_ratio_count\\\": len(log_ratios),\\n            \\\"task_mean_log_token_ratio_sd\\\": _sample_sd(log_ratios),\\n            \\\"task_pass_rate_difference_count\\\": len(pass_differences),\\n            \\\"task_pass_rate_difference_sd\\\": _sample_sd(pass_differences),\\n            \\\"within_task_arm_log_token_residual_count\\\": len(token_residuals),\\n            \\\"within_task_arm_log_token_residual_sd\\\": _sample_sd(token_residuals),\\n            \\\"same_repetition_cross_condition_residual_pairs\\\": len(paired_residual_control),\\n            \\\"same_repetition_cross_condition_residual_correlation\\\": _correlation(\\n                paired_residual_control, paired_residual_memory\\n            ),\\n        },\\n        \\\"paired_task_ids\\\": [row[\\\"task_id\\\"] for row in task_rows],\\n    }\\n\\n\\ndef build_calibration_diagnostics(\\n    manifest_path: pathlib.Path = CALIBRATION_MANIFEST,\\n) -> dict[str, Any]:\\n    manifest = json.loads(manifest_path.read_text(encoding=\\\"utf-8\\\"))\\n    if manifest.get(\\\"schema_version\\\") != 1:\\n        raise ValueError(\\\"calibration manifest schema_version must be 1\\\")\\n    if manifest.get(\\\"eligibility\\\") != \\\"exploratory_only\\\":\\n        raise ValueError(\\\"calibration manifest must remain exploratory_only\\\")\\n    if manifest.get(\\\"confirmatory_assumption_source\\\") is not False:\\n        raise ValueError(\\\"exploratory calibration cannot be a confirmatory assumption source\\\")\\n    decision_use = manifest.get(\\\"decision_use\\\")\\n    prohibited = (\\n        \\\"may_select_confirmatory_assumptions\\\",\\n        \\\"may_reduce_task_count_or_repetitions\\\",\\n        \\\"may_pass_power_gate\\\",\\n    )\\n    if not isinstance(decision_use, dict) or any(decision_use.get(key) is not False for key in prohibited):\\n        raise ValueError(\\\"calibration decision-use quarantine is missing\\\")\\n    sources = manifest.get(\\\"sources\\\")\\n    if not isinstance(sources, list) or not sources:\\n        raise ValueError(\\\"calibration manifest must contain sources\\\")\\n    source_ids = [source.get(\\\"id\\\") for source in sources if isinstance(source, dict)]\\n    if len(source_ids) != len(sources) or any(not isinstance(value, str) for value in source_ids):\\n        raise ValueError(\\\"calibration sources require string ids\\\")\\n    if len(source_ids) != len(set(source_ids)):\\n        raise ValueError(\\\"calibration source ids must be unique\\\")\\n    diagnostics = [_source_calibration(source) for source in sources]\\n\\n    excluded = manifest.get(\\\"excluded_sources\\\")\\n    if not isinstance(excluded, list):\\n        raise ValueError(\\\"calibration excluded_sources must be an array\\\")\\n    verified_exclusions = []\\n    for record in excluded:\\n        if not isinstance(record, dict):\\n            raise ValueError(\\\"calibration excluded source must be an object\\\")\\n        _verified_file(record)\\n        verified_exclusions.append(record)\\n\\n    unique_tasks = {task_id for source in diagnostics for task_id in source[\\\"paired_task_ids\\\"]}\\n    cluster_instances = sum(source[\\\"paired_task_clusters\\\"] for source in diagnostics)\\n    return {\\n        \\\"manifest_path\\\": str(manifest_path.resolve().relative_to(REPO.resolve())),\\n        \\\"manifest_sha256\\\": _sha256(manifest_path),\\n        \\\"executed_run_predicate_version\\\": EXECUTED_RUN_PREDICATE_VERSION,\\n        \\\"eligibility\\\": \\\"exploratory_only_excluded_from_confirmatory_decision\\\",\\n        \\\"confirmatory_assumption_source\\\": False,\\n        \\\"pooling_policy\\\": manifest.get(\\\"pooling_policy\\\"),\\n        \\\"source_count\\\": len(diagnostics),\\n        \\\"paired_task_cluster_instances\\\": cluster_instances,\\n        \\\"unique_task_ids_across_sources\\\": len(unique_tasks),\\n        \\\"pooled_estimate_prohibited\\\": True,\\n        \\\"sources\\\": diagnostics,\\n        \\\"excluded_sources\\\": verified_exclusions,\\n        \\\"interpretation\\\": (\\n            \\\"The byte-verified legacy records show material heterogeneity and correctness saturation, \\\"\\n            \\\"but their selected tasks, legacy treatments, runners, and harness contracts are not \\\"\\n            \\\"exchangeable with the candidate confirmatory experiment. They cannot select assumptions \\\"\\n            \\\"or pass the power gate.\\\"\\n        ),\\n    }\\n\\n\\ndef normal_two_sided_power(effect: float, standard_error: float, alpha: float) -> float:\\n    \\\"\\\"\\\"Power for a two-sided normal test under a fixed nonzero effect.\\\"\\\"\\\"\\n    if standard_error < 0:\\n        raise ValueError(\\\"standard_error must be non-negative\\\")\\n    if standard_error == 0:\\n        return float(effect != 0)\\n    critical = NORMAL.inv_cdf(1.0 - alpha / 2.0)\\n    signal = abs(effect) / standard_error\\n    return NORMAL.cdf(-critical - signal) + 1.0 - NORMAL.cdf(critical - signal)\\n\\n\\ndef normal_noninferiority_power(\\n    true_difference: float,\\n    margin: float,\\n    standard_error: float,\\n    alpha: float,\\n) -> float:\\n    \\\"\\\"\\\"Power for lower CI > margin using a one-sided normal critical value.\\\"\\\"\\\"\\n    if true_difference <= margin:\\n        return 0.0\\n    if standard_error < 0:\\n        raise ValueError(\\\"standard_error must be non-negative\\\")\\n    if standard_error == 0:\\n        return 1.0\\n    critical = NORMAL.inv_cdf(1.0 - alpha)\\n    signal = (true_difference - margin) / standard_error\\n    return NORMAL.cdf(signal - critical)\\n\\n\\ndef token_task_sd(token: dict[str, float], repetitions: int) -> float:\\n    \\\"\\\"\\\"SD of a task's mean log token ratio under the stated components.\\\"\\\"\\\"\\n    between = token[\\\"between_task_log_ratio_sd\\\"]\\n    within = token[\\\"within_attempt_log_token_sd\\\"]\\n    correlation = token[\\\"cross_treatment_residual_correlation\\\"]\\n    if repetitions < 1 or not -1.0 <= correlation <= 1.0:\\n        raise ValueError(\\\"invalid token planning assumption\\\")\\n    return math.sqrt(between**2 + 2.0 * within**2 * (1.0 - correlation) / repetitions)\\n\\n\\ndef correctness_task_sd(correctness: dict[str, float], repetitions: int) -> float:\\n    \\\"\\\"\\\"SD of a paired task-level pass-rate difference.\\n\\n    Each arm uses a Bernoulli variance inflated by 1 + (r - 1) * ICC.  The\\n    cross-treatment correlation is applied to the two task-level arm means.\\n    \\\"\\\"\\\"\\n    p0 = correctness[\\\"no_memory_pass_probability\\\"]\\n    p1 = correctness[\\\"retrieved_memory_pass_probability\\\"]\\n    icc = correctness[\\\"within_arm_attempt_icc\\\"]\\n    correlation = correctness[\\\"cross_treatment_task_mean_correlation\\\"]\\n    if repetitions < 1 or not (0.0 <= p0 <= 1.0 and 0.0 <= p1 <= 1.0):\\n        raise ValueError(\\\"invalid correctness probability\\\")\\n    if not 0.0 <= icc <= 1.0 or not -1.0 <= correlation <= 1.0:\\n        raise ValueError(\\\"invalid correctness correlation\\\")\\n    design_effect = 1.0 + (repetitions - 1.0) * icc\\n    variance0 = p0 * (1.0 - p0) * design_effect / repetitions\\n    variance1 = p1 * (1.0 - p1) * design_effect / repetitions\\n    covariance = correlation * math.sqrt(variance0 * variance1)\\n    return math.sqrt(max(0.0, variance0 + variance1 - 2.0 * covariance))\\n\\n\\ndef _minimum_tasks(power_at_tasks: Callable[[int], float], target: float) -> int | None:\\n    for tasks in range(2, 10_001):\\n        if power_at_tasks(tasks) >= target:\\n            return tasks\\n    return None\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839570.30637}}}
{"timestamp":"2026-09-19T17:39:30.307Z","ordinal":7515,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":69260754,"cached_input_tokens":66082176,"cache_write_input_tokens":0,"output_tokens":100647,"reasoning_output_tokens":14573,"total_tokens":69361401},"last_token_usage":{"input_tokens":108214,"cached_input_tokens":101376,"cache_write_input_tokens":0,"output_tokens":493,"reasoning_output_tokens":43,"total_tokens":108707},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":15.0,"window_minutes":10080,"resets_at":1790414255},"secondary":null,"credits":{"has_credits":true,"unlimited":false,"balance":"1118.8998305000"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
{"timestamp":"2026-09-19T17:39:34.414Z","ordinal":7516,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0cb48b2b18d09e75016aaec8d52b6487d2acbe144f2394f1ef","status":"completed","call_id":"call_Ne9xvFdU0XUtvwAujmgckiqs","name":"exec","input":"text(await tools.exec_command({cmd:\"sed -n '531,1060p' benchmarks/agent-brain/confirmatory/power_analysis.py\",\"max_output_tokens\":10000}));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839570.745974}}}
{"timestamp":"2026-09-19T17:39:34.503Z","ordinal":7517,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","item":{"type":"CommandExecution","id":"exec-e287308a-d292-4410-8c19-fad45339553f","process_id":"22178","command":["/bin/zsh","-lc","sed -n '531,1060p' benchmarks/agent-brain/confirmatory/power_analysis.py"],"cwd":"file:///Users/thomi/.codex/worktrees/5d33/entire-brain","parsed_cmd":[{"type":"read","cmd":"sed -n '531,1060p' benchmarks/agent-brain/confirmatory/power_analysis.py","name":"power_analysis.py","path":"benchmarks/agent-brain/confirmatory/power_analysis.py"}],"source":"unified_exec_startup","status":"completed","stdout":"\n\ndef _maximum_sd(power_at_sd: Callable[[float], float], target: float) -> float:\n    low, high = 0.0, 10.0\n    for _ in range(200):\n        midpoint = (low + high) / 2.0\n        if power_at_sd(midpoint) >= target:\n            low = midpoint\n        else:\n            high = midpoint\n    return low\n\n\ndef _design_power(scenario: dict[str, Any], tasks: int, repetitions: int) -> dict[str, Any]:\n    if tasks < 2 or repetitions < 1:\n        raise ValueError(\"power design requires at least two tasks and one repetition\")\n    token_sd = token_task_sd(scenario[\"token\"], repetitions)\n    token_power = normal_two_sided_power(\n        abs(math.log(TOKEN_RATIO_TARGET)), token_sd / math.sqrt(tasks), PLANNING_ALPHA\n    )\n    correctness = scenario[\"correctness\"]\n    true_difference = (\n        correctness[\"retrieved_memory_pass_probability\"]\n        - correctness[\"no_memory_pass_probability\"]\n    )\n    correctness_sd = correctness_task_sd(correctness, repetitions)\n    correctness_power = normal_noninferiority_power(\n        true_difference,\n        CORRECTNESS_MARGIN,\n        correctness_sd / math.sqrt(tasks),\n        PLANNING_ALPHA,\n    )\n    return {\n        \"tasks\": tasks,\n        \"repetitions_per_treatment\": repetitions,\n        \"requested_cells\": tasks * repetitions * PRIMARY_TREATMENTS,\n        \"maximum_agent_invocations_no_retries_or_replacements\": (\n            tasks * repetitions * PRIMARY_TREATMENTS\n        ),\n        \"token_task_level_log_ratio_sd\": token_sd,\n        \"token_marginal_power\": token_power,\n        \"correctness_task_level_pass_rate_difference_sd\": correctness_sd,\n        \"correctness_noninferiority_marginal_power\": correctness_power,\n        \"both_marginal_targets_met\": token_power >= TARGET_POWER\n        and correctness_power >= TARGET_POWER,\n    }\n\n\ndef _minimum_repetitions(\n    power_at_repetitions: Callable[[int], float], target: float, maximum: int = 10_000\n) -> int | None:\n    for repetitions in range(1, maximum + 1):\n        if power_at_repetitions(repetitions) >= target:\n            return repetitions\n    return None\n\n\ndef _design_tradeoffs(scenario: dict[str, Any]) -> dict[str, Any]:\n    token_effect = abs(math.log(TOKEN_RATIO_TARGET))\n    correctness = scenario[\"correctness\"]\n    true_difference = (\n        correctness[\"retrieved_memory_pass_probability\"]\n        - correctness[\"no_memory_pass_probability\"]\n    )\n    by_repetitions: list[dict[str, Any]] = []\n    for repetitions in REPETITION_TRADEOFFS:\n        token_sd = token_task_sd(scenario[\"token\"], repetitions)\n        correctness_sd = correctness_task_sd(correctness, repetitions)\n        token_tasks = _minimum_tasks(\n            lambda tasks: normal_two_sided_power(\n                token_effect, token_sd / math.sqrt(tasks), PLANNING_ALPHA\n            ),\n            TARGET_POWER,\n        )\n        correctness_tasks = _minimum_tasks(\n            lambda tasks: normal_noninferiority_power(\n                true_difference,\n                CORRECTNESS_MARGIN,\n                correctness_sd / math.sqrt(tasks),\n                PLANNING_ALPHA,\n            ),\n            TARGET_POWER,\n        )\n        tasks_for_both = (\n            max(token_tasks, correctness_tasks)\n            if token_tasks is not None and correctness_tasks is not None\n            else None\n        )\n        row = {\n            \"repetitions_per_treatment\": repetitions,\n            \"minimum_tasks_for_token_target\": token_tasks,\n            \"minimum_tasks_for_correctness_noninferiority_target\": correctness_tasks,\n            \"minimum_tasks_for_both_marginal_targets\": tasks_for_both,\n            \"requested_cells_at_minimum_tasks\": (\n                tasks_for_both * repetitions * PRIMARY_TREATMENTS\n                if tasks_for_both is not None\n                else None\n            ),\n            \"maximum_agent_invocations_no_retries_or_replacements\": (\n                tasks_for_both * repetitions * PRIMARY_TREATMENTS\n                if tasks_for_both is not None\n                else None\n            ),\n        }\n        by_repetitions.append(row)\n\n    by_tasks: list[dict[str, Any]] = []\n    for tasks in TASK_TRADEOFFS:\n        token_repetitions = _minimum_repetitions(\n            lambda repetitions: normal_two_sided_power(\n                token_effect,\n                token_task_sd(scenario[\"token\"], repetitions) / math.sqrt(tasks),\n                PLANNING_ALPHA,\n            ),\n            TARGET_POWER,\n        )\n        correctness_repetitions = _minimum_repetitions(\n            lambda repetitions: normal_noninferiority_power(\n                true_difference,\n                CORRECTNESS_MARGIN,\n                correctness_task_sd(correctness, repetitions) / math.sqrt(tasks),\n                PLANNING_ALPHA,\n            ),\n            TARGET_POWER,\n        )\n        repetitions_for_both = (\n            max(token_repetitions, correctness_repetitions)\n            if token_repetitions is not None and correctness_repetitions is not None\n            else None\n        )\n        by_tasks.append(\n            {\n                \"tasks\": tasks,\n                \"minimum_repetitions_for_token_target\": token_repetitions,\n                \"minimum_repetitions_for_correctness_noninferiority_target\": correctness_repetitions,\n                \"minimum_repetitions_for_both_marginal_targets\": repetitions_for_both,\n                \"requested_cells_at_minimum_repetitions\": (\n                    tasks * repetitions_for_both * PRIMARY_TREATMENTS\n                    if repetitions_for_both is not None\n                    else None\n                ),\n                \"maximum_agent_invocations_no_retries_or_replacements\": (\n                    tasks * repetitions_for_both * PRIMARY_TREATMENTS\n                    if repetitions_for_both is not None\n                    else None\n                ),\n            }\n        )\n\n    feasible_by_repetitions = [\n        row for row in by_repetitions if row[\"requested_cells_at_minimum_tasks\"] is not None\n    ]\n    fewest_cells = min(\n        feasible_by_repetitions,\n        key=lambda row: (\n            row[\"requested_cells_at_minimum_tasks\"],\n            row[\"minimum_tasks_for_both_marginal_targets\"],\n        ),\n    )\n    fewest_tasks = min(\n        feasible_by_repetitions,\n        key=lambda row: (\n            row[\"minimum_tasks_for_both_marginal_targets\"],\n            row[\"requested_cells_at_minimum_tasks\"],\n        ),\n    )\n    return {\n        \"scenario\": scenario[\"id\"],\n        \"status\": \"arithmetic_sensitivity_not_an_approved_design\",\n        \"repetition_options\": list(REPETITION_TRADEOFFS),\n        \"task_options\": list(TASK_TRADEOFFS),\n        \"minimum_tasks_by_repetitions\": by_repetitions,\n        \"minimum_repetitions_by_tasks\": by_tasks,\n        \"current_design\": _design_power(scenario, TASKS, REPETITIONS),\n        \"arithmetic_extremes_in_listed_repetition_options\": {\n            \"fewest_requested_cells\": fewest_cells,\n            \"fewest_task_clusters\": fewest_tasks,\n        },\n        \"interpretation\": (\n            \"More independent task clusters are substantially more cell-efficient than additional \"\n            \"repetitions under the stated positive ICC and irreducible task heterogeneity. These rows \"\n            \"are conditional on hypothetical assumptions and are not recommendations or budget approvals.\"\n        ),\n    }\n\n\ndef _scenario_result(scenario: dict[str, Any]) -> dict[str, Any]:\n    token_sd = token_task_sd(scenario[\"token\"], REPETITIONS)\n    token_effect = abs(math.log(TOKEN_RATIO_TARGET))\n    token_power = normal_two_sided_power(token_effect, token_sd / math.sqrt(TASKS), PLANNING_ALPHA)\n\n    correctness = scenario[\"correctness\"]\n    true_difference = (\n        correctness[\"retrieved_memory_pass_probability\"] - correctness[\"no_memory_pass_probability\"]\n    )\n    correctness_sd = correctness_task_sd(correctness, REPETITIONS)\n    correctness_power = normal_noninferiority_power(\n        true_difference,\n        CORRECTNESS_MARGIN,\n        correctness_sd / math.sqrt(TASKS),\n        PLANNING_ALPHA,\n    )\n\n    min_token_tasks = _minimum_tasks(\n        lambda tasks: normal_two_sided_power(\n            token_effect, token_sd / math.sqrt(tasks), PLANNING_ALPHA\n        ),\n        TARGET_POWER,\n    )\n    min_correctness_tasks = _minimum_tasks(\n        lambda tasks: normal_noninferiority_power(\n            true_difference,\n            CORRECTNESS_MARGIN,\n            correctness_sd / math.sqrt(tasks),\n            PLANNING_ALPHA,\n        ),\n        TARGET_POWER,\n    )\n    min_both = (\n        max(min_token_tasks, min_correctness_tasks)\n        if min_token_tasks is not None and min_correctness_tasks is not None\n        else None\n    )\n    joint_lower = max(0.0, token_power + correctness_power - 1.0)\n    joint_upper = min(token_power, correctness_power)\n    return {\n        **scenario,\n        \"assumption_basis\": \"hypothetical planning values; no benchmark outcomes or empirical variance used\",\n        \"results\": {\n            \"token\": {\n                \"task_level_log_ratio_sd\": token_sd,\n                \"standard_error\": token_sd / math.sqrt(TASKS),\n                \"marginal_power\": token_power,\n                \"target_met\": token_power >= TARGET_POWER,\n                \"minimum_tasks_at_4_repetitions\": min_token_tasks,\n            },\n            \"correctness_noninferiority\": {\n                \"true_difference\": true_difference,\n                \"task_level_pass_rate_difference_sd\": correctness_sd,\n                \"standard_error\": correctness_sd / math.sqrt(TASKS),\n                \"marginal_power\": correctness_power,\n                \"target_met\": correctness_power >= TARGET_POWER,\n                \"minimum_tasks_at_4_repetitions\": min_correctness_tasks,\n            },\n            \"both_endpoints\": {\n                \"both_marginal_targets_met\": token_power >= TARGET_POWER\n                and correctness_power >= TARGET_POWER,\n                \"joint_power_frechet_lower_bound\": joint_lower,\n                \"joint_power_frechet_upper_bound\": joint_upper,\n                \"joint_power_if_independent_sensitivity_only\": token_power * correctness_power,\n                \"minimum_tasks_for_both_marginal_targets_at_4_repetitions\": min_both,\n                \"requested_cells_at_that_task_count\": (\n                    min_both * REPETITIONS * PRIMARY_TREATMENTS if min_both is not None else None\n                ),\n                \"maximum_agent_invocations_no_retries_or_replacements\": (\n                    min_both * REPETITIONS * PRIMARY_TREATMENTS\n                    if min_both is not None\n                    else None\n                ),\n            },\n        },\n    }\n\n\ndef _asymptotic_repetition_result(scenario: dict[str, Any]) -> dict[str, Any]:\n    token = scenario[\"token\"]\n    correctness = scenario[\"correctness\"]\n    token_sd = token[\"between_task_log_ratio_sd\"]\n    p0 = correctness[\"no_memory_pass_probability\"]\n    p1 = correctness[\"retrieved_memory_pass_probability\"]\n    icc = correctness[\"within_arm_attempt_icc\"]\n    correlation = correctness[\"cross_treatment_task_mean_correlation\"]\n    variance0 = p0 * (1.0 - p0) * icc\n    variance1 = p1 * (1.0 - p1) * icc\n    correctness_sd = math.sqrt(\n        max(0.0, variance0 + variance1 - 2.0 * correlation * math.sqrt(variance0 * variance1))\n    )\n    true_difference = p1 - p0\n    token_power = normal_two_sided_power(\n        abs(math.log(TOKEN_RATIO_TARGET)), token_sd / math.sqrt(TASKS), PLANNING_ALPHA\n    )\n    correctness_power = normal_noninferiority_power(\n        true_difference,\n        CORRECTNESS_MARGIN,\n        correctness_sd / math.sqrt(TASKS),\n        PLANNING_ALPHA,\n    )\n    return {\n        \"interpretation\": \"limit as repetitions per treatment increase; task count remains 24\",\n        \"token_task_level_sd_floor\": token_sd,\n        \"token_marginal_power_ceiling\": token_power,\n        \"correctness_task_level_sd_floor\": correctness_sd,\n        \"correctness_marginal_power_ceiling\": correctness_power,\n        \"repetitions_only_can_meet_both_marginal_targets\": token_power >= TARGET_POWER\n        and correctness_power >= TARGET_POWER,\n    }\n\n\ndef _round_floats(value: Any) -> Any:\n    if isinstance(value, float):\n        return round(value, 6)\n    if isinstance(value, list):\n        return [_round_floats(item) for item in value]\n    if isinstance(value, tuple):\n        return [_round_floats(item) for item in value]\n    if isinstance(value, dict):\n        return {key: _round_floats(item) for key, item in value.items()}\n    return value\n\n\ndef _build_deprecated_v2_report_not_for_decision() -> dict[str, Any]:\n    token_effect = abs(math.log(TOKEN_RATIO_TARGET))\n    max_token_sd = _maximum_sd(\n        lambda sd: normal_two_sided_power(token_effect, sd / math.sqrt(TASKS), PLANNING_ALPHA),\n        TARGET_POWER,\n    )\n    max_correctness_sd = _maximum_sd(\n        lambda sd: normal_noninferiority_power(\n            0.0, CORRECTNESS_MARGIN, sd / math.sqrt(TASKS), PLANNING_ALPHA\n        ),\n        TARGET_POWER,\n    )\n    scenarios = [_scenario_result(scenario) for scenario in SCENARIOS]\n    conservative = next(item for item in scenarios if item[\"role\"] == \"decision_scenario\")\n    conservative_inputs = next(item for item in SCENARIOS if item[\"role\"] == \"decision_scenario\")\n    passed = conservative[\"results\"][\"both_endpoints\"][\"both_marginal_targets_met\"]\n    calibration = build_calibration_diagnostics()\n    tradeoffs = _design_tradeoffs(conservative_inputs)\n    report = {\n        \"schema_version\": 2,\n        \"artifact_id\": \"agent-brain-confirmatory-power-v2\",\n        \"status\": \"pass\" if passed else \"fail\",\n        \"analysis_kind\": \"deterministic_assumption_sensitivity_with_quarantined_exploratory_calibration\",\n        \"paid_runs_performed\": False,\n        \"empirical_variance_used_in_confirmatory_decision\": False,\n        \"empirical_variance_computed_for_exploratory_diagnostics\": True,\n        \"exploratory_outcomes_analyzed\": True,\n        \"protocol_inputs\": {\n            \"tasks\": TASKS,\n            \"repetitions_per_treatment\": REPETITIONS,\n            \"primary_treatments\": PRIMARY_TREATMENTS,\n            \"requested_cells\": REQUESTED_CELLS,\n            \"power_target\": TARGET_POWER,\n            \"token_reduction_target\": TOKEN_REDUCTION_TARGET,\n            \"token_ratio_alternative\": TOKEN_RATIO_TARGET,\n            \"correctness_noninferiority_margin_absolute\": CORRECTNESS_MARGIN,\n            \"endpoint_family_alpha\": FAMILY_ALPHA,\n            \"endpoint_family_comparisons\": FAMILY_COMPARISONS,\n            \"holm_worst_case_planning_alpha\": PLANNING_ALPHA,\n        },\n        \"method\": {\n            \"token\": (\n                \"Two-sided normal power for the paired task-level mean log token ratio; task SD is \"\n                \"sqrt(between-task treatment-effect variance + averaged within-attempt variance).\"\n            ),\n            \"correctness\": (\n                \"One-sided normal non-inferiority power for the paired task-level pass-rate \"\n                \"difference; repeated Bernoulli variance is inflated by a stated ICC.\"\n            ),\n            \"multiplicity\": \"Holm first-step alpha=0.05/2 is used for both retained-vs-control comparisons.\",\n            \"small_sample_caveat\": (\n                \"The normal approximation does not model discrete correctness outcomes or the exact \"\n                \"small-sample bootstrap tails at 24 task clusters; required task counts are sensitivity \"\n                \"estimates, not a final design recommendation.\"\n            ),\n            \"joint_power_caveat\": (\n                \"Endpoint dependence is unspecified. Frechet bounds and an independence sensitivity \"\n                \"are reported, but the pass rule uses the two marginal targets.\"\n            ),\n        },\n        \"design_tolerance_at_24_tasks\": {\n            \"maximum_task_level_log_ratio_sd_for_80_percent_token_power\": max_token_sd,\n            \"maximum_task_level_pass_rate_difference_sd_for_80_percent_noninferiority_power_at_true_parity\": max_correctness_sd,\n            \"interpretation\": (\n                \"The design can meet the marginal targets only if actual task-level variability is no \"\n                \"larger than these thresholds under the planning approximation.\"\n            ),\n        },\n        \"scenarios\": scenarios,\n        \"conservative_repetition_limit\": _asymptotic_repetition_result(conservative),\n        \"design_options\": tradeoffs,\n        \"exploratory_calibration\": calibration,\n        \"decision\": {\n            \"scenario\": conservative[\"id\"],\n            \"rule\": \"pass only if token and correctness marginal power are each at least 0.80\",\n            \"passed\": passed,\n            \"conclusion\": (\n                \"The proposed 24-task x 4-repetition design does not substantiate the declared power \"\n                \"target under the conservative planning scenario. Quarantined legacy outcomes cannot \"\n                \"repair that failure. Do not mark power_target_met pass.\"\n            ),\n        },\n        \"next_decision\": {\n            \"status\": \"human_methodology_decision_required\",\n            \"recommended_action\": \"choose_calibration_basis_before_resizing_or_sealing_holdout\",\n            \"smallest_defensible_step\": (\n                \"Keep the gate failed and the fresh holdout unopened. Decide whether to (a) explicitly \"\n                \"accept the hypothetical conservative assumptions and their resulting task/cell envelope, \"\n                \"or (b) preregister and budget a separate development-only calibration under the final \"\n                \"runner and treatment contracts. Do not choose task count from the legacy point estimates.\"\n            ),\n            \"why_no_automatic_design_is_selected\": [\n                \"the decision scenario is hypothetical rather than empirically calibrated\",\n                \"the retained outcomes use legacy treatments and non-exchangeable runners and harnesses\",\n                \"the byte-verifiable sources contain only sparse, selected task clusters with saturated or unstable correctness\",\n                \"the apparent cell minimum trades repetitions for hundreds of task clusters and is only arithmetic sensitivity\",\n            ],\n            \"prohibited_until_decision\": [\n                \"mark power_target_met pass\",\n                \"seal or open the fresh confirmatory holdout\",\n                \"authorize paid confirmatory cells\",\n                \"promote exploratory variance estimates into confirmatory assumptions\",\n            ],\n        },\n    }\n    return _round_floats(report)\n\n\ndef _finite_numeric(value: Any, label: str) -> float:\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\n        raise ValueError(f\"{label} must be numeric\")\n    try:\n        number = float(value)\n    except OverflowError as exc:\n        raise ValueError(f\"{label} must be finite\") from exc\n    if not math.isfinite(number):\n        raise ValueError(f\"{label} must be finite\")\n    return number\n\n\ndef _probability(value: Any, label: str) -> float:\n    number = _finite_numeric(value, label)\n    if not 0.0 <= number <= 1.0:\n        raise ValueError(f\"{label} must be in [0,1]\")\n    return number\n\n\ndef _positive_integer(value: Any, label: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value < 2:\n        raise ValueError(f\"{label} must be an integer of at least two\")\n    return value\n\n\ndef _require_exact_fields(value: Any, fields: tuple[str, ...], label: str) -> dict[str, Any]:\n    if not isinstance(value, dict):\n        raise ValueError(f\"{label} must be an object\")\n    if set(value) != set(fields):\n        raise ValueError(f\"{label} fields changed\")\n    return value\n\n\ndef recompute_power_decision(report: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Validate the pending-only v3 contract and derive its closed gate.\n\n    V3 deliberately has no authenticated final-calibration or owner-assumption\n    input ABI from which numeric power can be recomputed.  Supplying SDs,\n    marginal powers, joint power, or sized counts therefore cannot transition\n    this schema to an evaluated state.  That transition requires a new schema\n    which hashes its authoritative inputs and deterministically derives power.\n    \"\"\"\n    report = _require_exact_fields(\n        report,\n        (\n            \"schema_version\",\n            \"artifact_id\",\n            \"analysis_kind\",\n            \"paid_runs_performed\",\n            \"protocol_inputs\",\n            \"co_primary_endpoints\",\n            \"joint_iut_power\",\n            \"method\",\n            \"calibration_requirements\",\n            \"design_readiness\",\n            \"exploratory_calibration\",\n            \"empirical_variance_used_in_confirmatory_decision\",\n            \"status\",\n            \"decision\",\n        ),\n        \"power report\",\n    )\n    if report.get(\"schema_version\") != POWER_ARTIFACT_SCHEMA_VERSION:\n        raise ValueError(\"power artifact schema_version must remain 3\")\n    if report.get(\"artifact_id\") != POWER_ARTIFACT_ID:\n        raise ValueError(\"power artifact_id changed\")\n    if report.get(\"analysis_kind\") != POWER_ANALYSIS_KIND:\n        raise ValueError(\"power analysis_kind changed\")\n    if report.get(\"paid_runs_performed\") is not False:\n        raise ValueError(\"pending power artifact cannot claim paid runs\")\n\n    inputs = _require_exact_fields(\n        report.get(\"protocol_inputs\"),\n        (\n            \"tasks\",\n            \"repetitions_per_treatment\",\n            \"primary_treatments\",\n            \"requested_cells\",\n            \"agent_retry_limit\",\n            \"replacement_cell_limit\",\n            \"maximum_agent_invocations\",\n            \"power_target\",\n            \"intersection_union_alpha\",\n            \"primary_contrast\",\n            \"cluster_unit\",\n            \"attempt_policy\",\n        ),\n        \"power protocol_inputs\",\n    )\n    target = _probability(inputs.get(\"power_target\"), \"power target\")\n    if target != TARGET_POWER:\n        raise ValueError(f\"power target must remain frozen at {TARGET_POWER:.2f}\")\n    tasks = _positive_integer(inputs.get(\"tasks\"), \"protocol task count\")\n    repetitions = _positive_integer(\n        inputs.get(\"repetitions_per_treatment\"), \"protocol repetitions per treatment\"\n    )\n    treatments = _positive_integer(\n        inputs.get(\"primary_treatments\"), \"protocol primary treatment count\"\n    )\n    if tasks != TASKS:\n        raise ValueError(\n            f\"protocol task count must remain the provisional {TASKS} until a versioned sizing transition\"\n        )\n    if repetitions != REPETITIONS:\n        raise ValueError(\n            f\"protocol repetitions per treatment must remain frozen at {REPETITIONS} in v3\"\n        )\n    if treatments != PRIMARY_TREATMENTS:\n        raise ValueError(\n            f\"protocol primary treatment count must remain frozen at {PRIMARY_TREATMENTS} in v3\"\n        )\n    alpha = _probability(inputs.get(\"intersection_union_alpha\"), \"intersection-union alpha\")\n","stderr":"","aggregated_output":"\n\ndef _maximum_sd(power_at_sd: Callable[[float], float], target: float) -> float:\n    low, high = 0.0, 10.0\n    for _ in range(200):\n        midpoint = (low + high) / 2.0\n        if power_at_sd(midpoint) >= target:\n            low = midpoint\n        else:\n            high = midpoint\n    return low\n\n\ndef _design_power(scenario: dict[str, Any], tasks: int, repetitions: int) -> dict[str, Any]:\n    if tasks < 2 or repetitions < 1:\n        raise ValueError(\"power design requires at least two tasks and one repetition\")\n    token_sd = token_task_sd(scenario[\"token\"], repetitions)\n    token_power = normal_two_sided_power(\n        abs(math.log(TOKEN_RATIO_TARGET)), token_sd / math.sqrt(tasks), PLANNING_ALPHA\n    )\n    correctness = scenario[\"correctness\"]\n    true_difference = (\n        correctness[\"retrieved_memory_pass_probability\"]\n        - correctness[\"no_memory_pass_probability\"]\n    )\n    correctness_sd = correctness_task_sd(correctness, repetitions)\n    correctness_power = normal_noninferiority_power(\n        true_difference,\n        CORRECTNESS_MARGIN,\n        correctness_sd / math.sqrt(tasks),\n        PLANNING_ALPHA,\n    )\n    return {\n        \"tasks\": tasks,\n        \"repetitions_per_treatment\": repetitions,\n        \"requested_cells\": tasks * repetitions * PRIMARY_TREATMENTS,\n        \"maximum_agent_invocations_no_retries_or_replacements\": (\n            tasks * repetitions * PRIMARY_TREATMENTS\n        ),\n        \"token_task_level_log_ratio_sd\": token_sd,\n        \"token_marginal_power\": token_power,\n        \"correctness_task_level_pass_rate_difference_sd\": correctness_sd,\n        \"correctness_noninferiority_marginal_power\": correctness_power,\n        \"both_marginal_targets_met\": token_power >= TARGET_POWER\n        and correctness_power >= TARGET_POWER,\n    }\n\n\ndef _minimum_repetitions(\n    power_at_repetitions: Callable[[int], float], target: float, maximum: int = 10_000\n) -> int | None:\n    for repetitions in range(1, maximum + 1):\n        if power_at_repetitions(repetitions) >= target:\n            return repetitions\n    return None\n\n\ndef _design_tradeoffs(scenario: dict[str, Any]) -> dict[str, Any]:\n    token_effect = abs(math.log(TOKEN_RATIO_TARGET))\n    correctness = scenario[\"correctness\"]\n    true_difference = (\n        correctness[\"retrieved_memory_pass_probability\"]\n        - correctness[\"no_memory_pass_probability\"]\n    )\n    by_repetitions: list[dict[str, Any]] = []\n    for repetitions in REPETITION_TRADEOFFS:\n        token_sd = token_task_sd(scenario[\"token\"], repetitions)\n        correctness_sd = correctness_task_sd(correctness, repetitions)\n        token_tasks = _minimum_tasks(\n            lambda tasks: normal_two_sided_power(\n                token_effect, token_sd / math.sqrt(tasks), PLANNING_ALPHA\n            ),\n            TARGET_POWER,\n        )\n        correctness_tasks = _minimum_tasks(\n            lambda tasks: normal_noninferiority_power(\n                true_difference,\n                CORRECTNESS_MARGIN,\n                correctness_sd / math.sqrt(tasks),\n                PLANNING_ALPHA,\n            ),\n            TARGET_POWER,\n        )\n        tasks_for_both = (\n            max(token_tasks, correctness_tasks)\n            if token_tasks is not None and correctness_tasks is not None\n            else None\n        )\n        row = {\n            \"repetitions_per_treatment\": repetitions,\n            \"minimum_tasks_for_token_target\": token_tasks,\n            \"minimum_tasks_for_correctness_noninferiority_target\": correctness_tasks,\n            \"minimum_tasks_for_both_marginal_targets\": tasks_for_both,\n            \"requested_cells_at_minimum_tasks\": (\n                tasks_for_both * repetitions * PRIMARY_TREATMENTS\n                if tasks_for_both is not None\n                else None\n            ),\n            \"maximum_agent_invocations_no_retries_or_replacements\": (\n                tasks_for_both * repetitions * PRIMARY_TREATMENTS\n                if tasks_for_both is not None\n                else None\n            ),\n        }\n        by_repetitions.append(row)\n\n    by_tasks: list[dict[str, Any]] = []\n    for tasks in TASK_TRADEOFFS:\n        token_repetitions = _minimum_repetitions(\n            lambda repetitions: normal_two_sided_power(\n                token_effect,\n                token_task_sd(scenario[\"token\"], repetitions) / math.sqrt(tasks),\n                PLANNING_ALPHA,\n            ),\n            TARGET_POWER,\n        )\n        correctness_repetitions = _minimum_repetitions(\n            lambda repetitions: normal_noninferiority_power(\n                true_difference,\n                CORRECTNESS_MARGIN,\n                correctness_task_sd(correctness, repetitions) / math.sqrt(tasks),\n                PLANNING_ALPHA,\n            ),\n            TARGET_POWER,\n        )\n        repetitions_for_both = (\n            max(token_repetitions, correctness_repetitions)\n            if token_repetitions is not None and correctness_repetitions is not None\n            else None\n        )\n        by_tasks.append(\n            {\n                \"tasks\": tasks,\n                \"minimum_repetitions_for_token_target\": token_repetitions,\n                \"minimum_repetitions_for_correctness_noninferiority_target\": correctness_repetitions,\n                \"minimum_repetitions_for_both_marginal_targets\": repetitions_for_both,\n                \"requested_cells_at_minimum_repetitions\": (\n                    tasks * repetitions_for_both * PRIMARY_TREATMENTS\n                    if repetitions_for_both is not None\n                    else None\n                ),\n                \"maximum_agent_invocations_no_retries_or_replacements\": (\n                    tasks * repetitions_for_both * PRIMARY_TREATMENTS\n                    if repetitions_for_both is not None\n                    else None\n                ),\n            }\n        )\n\n    feasible_by_repetitions = [\n        row for row in by_repetitions if row[\"requested_cells_at_minimum_tasks\"] is not None\n    ]\n    fewest_cells = min(\n        feasible_by_repetitions,\n        key=lambda row: (\n            row[\"requested_cells_at_minimum_tasks\"],\n            row[\"minimum_tasks_for_both_marginal_targets\"],\n        ),\n    )\n    fewest_tasks = min(\n        feasible_by_repetitions,\n        key=lambda row: (\n            row[\"minimum_tasks_for_both_marginal_targets\"],\n            row[\"requested_cells_at_minimum_tasks\"],\n        ),\n    )\n    return {\n        \"scenario\": scenario[\"id\"],\n        \"status\": \"arithmetic_sensitivity_not_an_approved_design\",\n        \"repetition_options\": list(REPETITION_TRADEOFFS),\n        \"task_options\": list(TASK_TRADEOFFS),\n        \"minimum_tasks_by_repetitions\": by_repetitions,\n        \"minimum_repetitions_by_tasks\": by_tasks,\n        \"current_design\": _design_power(scenario, TASKS, REPETITIONS),\n        \"arithmetic_extremes_in_listed_repetition_options\": {\n            \"fewest_requested_cells\": fewest_cells,\n            \"fewest_task_clusters\": fewest_tasks,\n        },\n        \"interpretation\": (\n            \"More independent task clusters are substantially more cell-efficient than additional \"\n            \"repetitions under the stated positive ICC and irreducible task heterogeneity. These rows \"\n            \"are conditional on hypothetical assumptions and are not recommendations or budget approvals.\"\n        ),\n    }\n\n\ndef _scenario_result(scenario: dict[str, Any]) -> dict[str, Any]:\n    token_sd = token_task_sd(scenario[\"token\"], REPETITIONS)\n    token_effect = abs(math.log(TOKEN_RATIO_TARGET))\n    token_power = normal_two_sided_power(token_effect, token_sd / math.sqrt(TASKS), PLANNING_ALPHA)\n\n    correctness = scenario[\"correctness\"]\n    true_difference = (\n        correctness[\"retrieved_memory_pass_probability\"] - correctness[\"no_memory_pass_probability\"]\n    )\n    correctness_sd = correctness_task_sd(correctness, REPETITIONS)\n    correctness_power = normal_noninferiority_power(\n        true_difference,\n        CORRECTNESS_MARGIN,\n        correctness_sd / math.sqrt(TASKS),\n        PLANNING_ALPHA,\n    )\n\n    min_token_tasks = _minimum_tasks(\n        lambda tasks: normal_two_sided_power(\n            token_effect, token_sd / math.sqrt(tasks), PLANNING_ALPHA\n        ),\n        TARGET_POWER,\n    )\n    min_correctness_tasks = _minimum_tasks(\n        lambda tasks: normal_noninferiority_power(\n            true_difference,\n            CORRECTNESS_MARGIN,\n            correctness_sd / math.sqrt(tasks),\n            PLANNING_ALPHA,\n        ),\n        TARGET_POWER,\n    )\n    min_both = (\n        max(min_token_tasks, min_correctness_tasks)\n        if min_token_tasks is not None and min_correctness_tasks is not None\n        else None\n    )\n    joint_lower = max(0.0, token_power + correctness_power - 1.0)\n    joint_upper = min(token_power, correctness_power)\n    return {\n        **scenario,\n        \"assumption_basis\": \"hypothetical planning values; no benchmark outcomes or empirical variance used\",\n        \"results\": {\n            \"token\": {\n                \"task_level_log_ratio_sd\": token_sd,\n                \"standard_error\": token_sd / math.sqrt(TASKS),\n                \"marginal_power\": token_power,\n                \"target_met\": token_power >= TARGET_POWER,\n                \"minimum_tasks_at_4_repetitions\": min_token_tasks,\n            },\n            \"correctness_noninferiority\": {\n                \"true_difference\": true_difference,\n                \"task_level_pass_rate_difference_sd\": correctness_sd,\n                \"standard_error\": correctness_sd / math.sqrt(TASKS),\n                \"marginal_power\": correctness_power,\n                \"target_met\": correctness_power >= TARGET_POWER,\n                \"minimum_tasks_at_4_repetitions\": min_correctness_tasks,\n            },\n            \"both_endpoints\": {\n                \"both_marginal_targets_met\": token_power >= TARGET_POWER\n                and correctness_power >= TARGET_POWER,\n                \"joint_power_frechet_lower_bound\": joint_lower,\n                \"joint_power_frechet_upper_bound\": joint_upper,\n                \"joint_power_if_independent_sensitivity_only\": token_power * correctness_power,\n                \"minimum_tasks_for_both_marginal_targets_at_4_repetitions\": min_both,\n                \"requested_cells_at_that_task_count\": (\n                    min_both * REPETITIONS * PRIMARY_TREATMENTS if min_both is not None else None\n                ),\n                \"maximum_agent_invocations_no_retries_or_replacements\": (\n                    min_both * REPETITIONS * PRIMARY_TREATMENTS\n                    if min_both is not None\n                    else None\n                ),\n            },\n        },\n    }\n\n\ndef _asymptotic_repetition_result(scenario: dict[str, Any]) -> dict[str, Any]:\n    token = scenario[\"token\"]\n    correctness = scenario[\"correctness\"]\n    token_sd = token[\"between_task_log_ratio_sd\"]\n    p0 = correctness[\"no_memory_pass_probability\"]\n    p1 = correctness[\"retrieved_memory_pass_probability\"]\n    icc = correctness[\"within_arm_attempt_icc\"]\n    correlation = correctness[\"cross_treatment_task_mean_correlation\"]\n    variance0 = p0 * (1.0 - p0) * icc\n    variance1 = p1 * (1.0 - p1) * icc\n    correctness_sd = math.sqrt(\n        max(0.0, variance0 + variance1 - 2.0 * correlation * math.sqrt(variance0 * variance1))\n    )\n    true_difference = p1 - p0\n    token_power = normal_two_sided_power(\n        abs(math.log(TOKEN_RATIO_TARGET)), token_sd / math.sqrt(TASKS), PLANNING_ALPHA\n    )\n    correctness_power = normal_noninferiority_power(\n        true_difference,\n        CORRECTNESS_MARGIN,\n        correctness_sd / math.sqrt(TASKS),\n        PLANNING_ALPHA,\n    )\n    return {\n        \"interpretation\": \"limit as repetitions per treatment increase; task count remains 24\",\n        \"token_task_level_sd_floor\": token_sd,\n        \"token_marginal_power_ceiling\": token_power,\n        \"correctness_task_level_sd_floor\": correctness_sd,\n        \"correctness_marginal_power_ceiling\": correctness_power,\n        \"repetitions_only_can_meet_both_marginal_targets\": token_power >= TARGET_POWER\n        and correctness_power >= TARGET_POWER,\n    }\n\n\ndef _round_floats(value: Any) -> Any:\n    if isinstance(value, float):\n        return round(value, 6)\n    if isinstance(value, list):\n        return [_round_floats(item) for item in value]\n    if isinstance(value, tuple):\n        return [_round_floats(item) for item in value]\n    if isinstance(value, dict):\n        return {key: _round_floats(item) for key, item in value.items()}\n    return value\n\n\ndef _build_deprecated_v2_report_not_for_decision() -> dict[str, Any]:\n    token_effect = abs(math.log(TOKEN_RATIO_TARGET))\n    max_token_sd = _maximum_sd(\n        lambda sd: normal_two_sided_power(token_effect, sd / math.sqrt(TASKS), PLANNING_ALPHA),\n        TARGET_POWER,\n    )\n    max_correctness_sd = _maximum_sd(\n        lambda sd: normal_noninferiority_power(\n            0.0, CORRECTNESS_MARGIN, sd / math.sqrt(TASKS), PLANNING_ALPHA\n        ),\n        TARGET_POWER,\n    )\n    scenarios = [_scenario_result(scenario) for scenario in SCENARIOS]\n    conservative = next(item for item in scenarios if item[\"role\"] == \"decision_scenario\")\n    conservative_inputs = next(item for item in SCENARIOS if item[\"role\"] == \"decision_scenario\")\n    passed = conservative[\"results\"][\"both_endpoints\"][\"both_marginal_targets_met\"]\n    calibration = build_calibration_diagnostics()\n    tradeoffs = _design_tradeoffs(conservative_inputs)\n    report = {\n        \"schema_version\": 2,\n        \"artifact_id\": \"agent-brain-confirmatory-power-v2\",\n        \"status\": \"pass\" if passed else \"fail\",\n        \"analysis_kind\": \"deterministic_assumption_sensitivity_with_quarantined_exploratory_calibration\",\n        \"paid_runs_performed\": False,\n        \"empirical_variance_used_in_confirmatory_decision\": False,\n        \"empirical_variance_computed_for_exploratory_diagnostics\": True,\n        \"exploratory_outcomes_analyzed\": True,\n        \"protocol_inputs\": {\n            \"tasks\": TASKS,\n            \"repetitions_per_treatment\": REPETITIONS,\n            \"primary_treatments\": PRIMARY_TREATMENTS,\n            \"requested_cells\": REQUESTED_CELLS,\n            \"power_target\": TARGET_POWER,\n            \"token_reduction_target\": TOKEN_REDUCTION_TARGET,\n            \"token_ratio_alternative\": TOKEN_RATIO_TARGET,\n            \"correctness_noninferiority_margin_absolute\": CORRECTNESS_MARGIN,\n            \"endpoint_family_alpha\": FAMILY_ALPHA,\n            \"endpoint_family_comparisons\": FAMILY_COMPARISONS,\n            \"holm_worst_case_planning_alpha\": PLANNING_ALPHA,\n        },\n        \"method\": {\n            \"token\": (\n                \"Two-sided normal power for the paired task-level mean log token ratio; task SD is \"\n                \"sqrt(between-task treatment-effect variance + averaged within-attempt variance).\"\n            ),\n            \"correctness\": (\n                \"One-sided normal non-inferiority power for the paired task-level pass-rate \"\n                \"difference; repeated Bernoulli variance is inflated by a stated ICC.\"\n            ),\n            \"multiplicity\": \"Holm first-step alpha=0.05/2 is used for both retained-vs-control comparisons.\",\n            \"small_sample_caveat\": (\n                \"The normal approximation does not model discrete correctness outcomes or the exact \"\n                \"small-sample bootstrap tails at 24 task clusters; required task counts are sensitivity \"\n                \"estimates, not a final design recommendation.\"\n            ),\n            \"joint_power_caveat\": (\n                \"Endpoint dependence is unspecified. Frechet bounds and an independence sensitivity \"\n                \"are reported, but the pass rule uses the two marginal targets.\"\n            ),\n        },\n        \"design_tolerance_at_24_tasks\": {\n            \"maximum_task_level_log_ratio_sd_for_80_percent_token_power\": max_token_sd,\n            \"maximum_task_level_pass_rate_difference_sd_for_80_percent_noninferiority_power_at_true_parity\": max_correctness_sd,\n            \"interpretation\": (\n                \"The design can meet the marginal targets only if actual task-level variability is no \"\n                \"larger than these thresholds under the planning approximation.\"\n            ),\n        },\n        \"scenarios\": scenarios,\n        \"conservative_repetition_limit\": _asymptotic_repetition_result(conservative),\n        \"design_options\": tradeoffs,\n        \"exploratory_calibration\": calibration,\n        \"decision\": {\n            \"scenario\": conservative[\"id\"],\n            \"rule\": \"pass only if token and correctness marginal power are each at least 0.80\",\n            \"passed\": passed,\n            \"conclusion\": (\n                \"The proposed 24-task x 4-repetition design does not substantiate the declared power \"\n                \"target under the conservative planning scenario. Quarantined legacy outcomes cannot \"\n                \"repair that failure. Do not mark power_target_met pass.\"\n            ),\n        },\n        \"next_decision\": {\n            \"status\": \"human_methodology_decision_required\",\n            \"recommended_action\": \"choose_calibration_basis_before_resizing_or_sealing_holdout\",\n            \"smallest_defensible_step\": (\n                \"Keep the gate failed and the fresh holdout unopened. Decide whether to (a) explicitly \"\n                \"accept the hypothetical conservative assumptions and their resulting task/cell envelope, \"\n                \"or (b) preregister and budget a separate development-only calibration under the final \"\n                \"runner and treatment contracts. Do not choose task count from the legacy point estimates.\"\n            ),\n            \"why_no_automatic_design_is_selected\": [\n                \"the decision scenario is hypothetical rather than empirically calibrated\",\n                \"the retained outcomes use legacy treatments and non-exchangeable runners and harnesses\",\n                \"the byte-verifiable sources contain only sparse, selected task clusters with saturated or unstable correctness\",\n                \"the apparent cell minimum trades repetitions for hundreds of task clusters and is only arithmetic sensitivity\",\n            ],\n            \"prohibited_until_decision\": [\n                \"mark power_target_met pass\",\n                \"seal or open the fresh confirmatory holdout\",\n                \"authorize paid confirmatory cells\",\n                \"promote exploratory variance estimates into confirmatory assumptions\",\n            ],\n        },\n    }\n    return _round_floats(report)\n\n\ndef _finite_numeric(value: Any, label: str) -> float:\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\n        raise ValueError(f\"{label} must be numeric\")\n    try:\n        number = float(value)\n    except OverflowError as exc:\n        raise ValueError(f\"{label} must be finite\") from exc\n    if not math.isfinite(number):\n        raise ValueError(f\"{label} must be finite\")\n    return number\n\n\ndef _probability(value: Any, label: str) -> float:\n    number = _finite_numeric(value, label)\n    if not 0.0 <= number <= 1.0:\n        raise ValueError(f\"{label} must be in [0,1]\")\n    return number\n\n\ndef _positive_integer(value: Any, label: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value < 2:\n        raise ValueError(f\"{label} must be an integer of at least two\")\n    return value\n\n\ndef _require_exact_fields(value: Any, fields: tuple[str, ...], label: str) -> dict[str, Any]:\n    if not isinstance(value, dict):\n        raise ValueError(f\"{label} must be an object\")\n    if set(value) != set(fields):\n        raise ValueError(f\"{label} fields changed\")\n    return value\n\n\ndef recompute_power_decision(report: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Validate the pending-only v3 contract and derive its closed gate.\n\n    V3 deliberately has no authenticated final-calibration or owner-assumption\n    input ABI from which numeric power can be recomputed.  Supplying SDs,\n    marginal powers, joint power, or sized counts therefore cannot transition\n    this schema to an evaluated state.  That transition requires a new schema\n    which hashes its authoritative inputs and deterministically derives power.\n    \"\"\"\n    report = _require_exact_fields(\n        report,\n        (\n            \"schema_version\",\n            \"artifact_id\",\n            \"analysis_kind\",\n            \"paid_runs_performed\",\n            \"protocol_inputs\",\n            \"co_primary_endpoints\",\n            \"joint_iut_power\",\n            \"method\",\n            \"calibration_requirements\",\n            \"design_readiness\",\n            \"exploratory_calibration\",\n            \"empirical_variance_used_in_confirmatory_decision\",\n            \"status\",\n            \"decision\",\n        ),\n        \"power report\",\n    )\n    if report.get(\"schema_version\") != POWER_ARTIFACT_SCHEMA_VERSION:\n        raise ValueError(\"power artifact schema_version must remain 3\")\n    if report.get(\"artifact_id\") != POWER_ARTIFACT_ID:\n        raise ValueError(\"power artifact_id changed\")\n    if report.get(\"analysis_kind\") != POWER_ANALYSIS_KIND:\n        raise ValueError(\"power analysis_kind changed\")\n    if report.get(\"paid_runs_performed\") is not False:\n        raise ValueError(\"pending power artifact cannot claim paid runs\")\n\n    inputs = _require_exact_fields(\n        report.get(\"protocol_inputs\"),\n        (\n            \"tasks\",\n            \"repetitions_per_treatment\",\n            \"primary_treatments\",\n            \"requested_cells\",\n            \"agent_retry_limit\",\n            \"replacement_cell_limit\",\n            \"maximum_agent_invocations\",\n            \"power_target\",\n            \"intersection_union_alpha\",\n            \"primary_contrast\",\n            \"cluster_unit\",\n            \"attempt_policy\",\n        ),\n        \"power protocol_inputs\",\n    )\n    target = _probability(inputs.get(\"power_target\"), \"power target\")\n    if target != TARGET_POWER:\n        raise ValueError(f\"power target must remain frozen at {TARGET_POWER:.2f}\")\n    tasks = _positive_integer(inputs.get(\"tasks\"), \"protocol task count\")\n    repetitions = _positive_integer(\n        inputs.get(\"repetitions_per_treatment\"), \"protocol repetitions per treatment\"\n    )\n    treatments = _positive_integer(\n        inputs.get(\"primary_treatments\"), \"protocol primary treatment count\"\n    )\n    if tasks != TASKS:\n        raise ValueError(\n            f\"protocol task count must remain the provisional {TASKS} until a versioned sizing transition\"\n        )\n    if repetitions != REPETITIONS:\n        raise ValueError(\n            f\"protocol repetitions per treatment must remain frozen at {REPETITIONS} in v3\"\n        )\n    if treatments != PRIMARY_TREATMENTS:\n        raise ValueError(\n            f\"protocol primary treatment count must remain frozen at {PRIMARY_TREATMENTS} in v3\"\n        )\n    alpha = _probability(inputs.get(\"intersection_union_alpha\"), \"intersection-union alpha\")\n","exit_code":0,"duration":{"secs":0,"nanos":2417},"formatted_output":"\n\ndef _maximum_sd(power_at_sd: Callable[[float], float], target: float) -> float:\n    low, high = 0.0, 10.0\n    for _ in range(200):\n        midpoint = (low + high) / 2.0\n        if power_at_sd(midpoint) >= target:\n            low = midpoint\n        else:\n            high = midpoint\n    return low\n\n\ndef _design_power(scenario: dict[str, Any], tasks: int, repetitions: int) -> dict[str, Any]:\n    if tasks < 2 or repetitions < 1:\n        raise ValueError(\"power design requires at least two tasks and one repetition\")\n    token_sd = token_task_sd(scenario[\"token\"], repetitions)\n    token_power = normal_two_sided_power(\n        abs(math.log(TOKEN_RATIO_TARGET)), token_sd / math.sqrt(tasks), PLANNING_ALPHA\n    )\n    correctness = scenario[\"correctness\"]\n    true_difference = (\n        correctness[\"retrieved_memory_pass_probability\"]\n        - correctness[\"no_memory_pass_probability\"]\n    )\n    correctness_sd = correctness_task_sd(correctness, repetitions)\n    correctness_power = normal_noninferiority_power(\n        true_difference,\n        CORRECTNESS_MARGIN,\n        correctness_sd / math.sqrt(tasks),\n        PLANNING_ALPHA,\n    )\n    return {\n        \"tasks\": tasks,\n        \"repetitions_per_treatment\": repetitions,\n        \"requested_cells\": tasks * repetitions * PRIMARY_TREATMENTS,\n        \"maximum_agent_invocations_no_retries_or_replacements\": (\n            tasks * repetitions * PRIMARY_TREATMENTS\n        ),\n        \"token_task_level_log_ratio_sd\": token_sd,\n        \"token_marginal_power\": token_power,\n        \"correctness_task_level_pass_rate_difference_sd\": correctness_sd,\n        \"correctness_noninferiority_marginal_power\": correctness_power,\n        \"both_marginal_targets_met\": token_power >= TARGET_POWER\n        and correctness_power >= TARGET_POWER,\n    }\n\n\ndef _minimum_repetitions(\n    power_at_repetitions: Callable[[int], float], target: float, maximum: int = 10_000\n) -> int | None:\n    for repetitions in range(1, maximum + 1):\n        if power_at_repetitions(repetitions) >= target:\n            return repetitions\n    return None\n\n\ndef _design_tradeoffs(scenario: dict[str, Any]) -> dict[str, Any]:\n    token_effect = abs(math.log(TOKEN_RATIO_TARGET))\n    correctness = scenario[\"correctness\"]\n    true_difference = (\n        correctness[\"retrieved_memory_pass_probability\"]\n        - correctness[\"no_memory_pass_probability\"]\n    )\n    by_repetitions: list[dict[str, Any]] = []\n    for repetitions in REPETITION_TRADEOFFS:\n        token_sd = token_task_sd(scenario[\"token\"], repetitions)\n        correctness_sd = correctness_task_sd(correctness, repetitions)\n        token_tasks = _minimum_tasks(\n            lambda tasks: normal_two_sided_power(\n                token_effect, token_sd / math.sqrt(tasks), PLANNING_ALPHA\n            ),\n            TARGET_POWER,\n        )\n        correctness_tasks = _minimum_tasks(\n            lambda tasks: normal_noninferiority_power(\n                true_difference,\n                CORRECTNESS_MARGIN,\n                correctness_sd / math.sqrt(tasks),\n                PLANNING_ALPHA,\n            ),\n            TARGET_POWER,\n        )\n        tasks_for_both = (\n            max(token_tasks, correctness_tasks)\n            if token_tasks is not None and correctness_tasks is not None\n            else None\n        )\n        row = {\n            \"repetitions_per_treatment\": repetitions,\n            \"minimum_tasks_for_token_target\": token_tasks,\n            \"minimum_tasks_for_correctness_noninferiority_target\": correctness_tasks,\n            \"minimum_tasks_for_both_marginal_targets\": tasks_for_both,\n            \"requested_cells_at_minimum_tasks\": (\n                tasks_for_both * repetitions * PRIMARY_TREATMENTS\n                if tasks_for_both is not None\n                else None\n            ),\n            \"maximum_agent_invocations_no_retries_or_replacements\": (\n                tasks_for_both * repetitions * PRIMARY_TREATMENTS\n                if tasks_for_both is not None\n                else None\n            ),\n        }\n        by_repetitions.append(row)\n\n    by_tasks: list[dict[str, Any]] = []\n    for tasks in TASK_TRADEOFFS:\n        token_repetitions = _minimum_repetitions(\n            lambda repetitions: normal_two_sided_power(\n                token_effect,\n                token_task_sd(scenario[\"token\"], repetitions) / math.sqrt(tasks),\n                PLANNING_ALPHA,\n            ),\n            TARGET_POWER,\n        )\n        correctness_repetitions = _minimum_repetitions(\n            lambda repetitions: normal_noninferiority_power(\n                true_difference,\n                CORRECTNESS_MARGIN,\n                correctness_task_sd(correctness, repetitions) / math.sqrt(tasks),\n                PLANNING_ALPHA,\n            ),\n            TARGET_POWER,\n        )\n        repetitions_for_both = (\n            max(token_repetitions, correctness_repetitions)\n            if token_repetitions is not None and correctness_repetitions is not None\n            else None\n        )\n        by_tasks.append(\n            {\n                \"tasks\": tasks,\n                \"minimum_repetitions_for_token_target\": token_repetitions,\n                \"minimum_repetitions_for_correctness_noninferiority_target\": correctness_repetitions,\n                \"minimum_repetitions_for_both_marginal_targets\": repetitions_for_both,\n                \"requested_cells_at_minimum_repetitions\": (\n                    tasks * repetitions_for_both * PRIMARY_TREATMENTS\n                    if repetitions_for_both is not None\n                    else None\n                ),\n                \"maximum_agent_invocations_no_retries_or_replacements\": (\n                    tasks * repetitions_for_both * PRIMARY_TREATMENTS\n                    if repetitions_for_both is not None\n                    else None\n                ),\n            }\n        )\n\n    feasible_by_repetitions = [\n        row for row in by_repetitions if row[\"requested_cells_at_minimum_tasks\"] is not None\n    ]\n    fewest_cells = min(\n        feasible_by_repetitions,\n        key=lambda row: (\n            row[\"requested_cells_at_minimum_tasks\"],\n            row[\"minimum_tasks_for_both_marginal_targets\"],\n        ),\n    )\n    fewest_tasks = min(\n        feasible_by_repetitions,\n        key=lambda row: (\n            row[\"minimum_tasks_for_both_marginal_targets\"],\n            row[\"requested_cells_at_minimum_tasks\"],\n        ),\n    )\n    return {\n        \"scenario\": scenario[\"id\"],\n        \"status\": \"arithmetic_sensitivity_not_an_approved_design\",\n        \"repetition_options\": list(REPETITION_TRADEOFFS),\n        \"task_options\": list(TASK_TRADEOFFS),\n        \"minimum_tasks_by_repetitions\": by_repetitions,\n        \"minimum_repetitions_by_tasks\": by_tasks,\n        \"current_design\": _design_power(scenario, TASKS, REPETITIONS),\n        \"arithmetic_extremes_in_listed_repetition_options\": {\n            \"fewest_requested_cells\": fewest_cells,\n            \"fewest_task_clusters\": fewest_tasks,\n        },\n        \"interpretation\": (\n            \"More independent task clusters are substantially more cell-efficient than additional \"\n            \"repetitions under the stated positive ICC and irreducible task heterogeneity. These rows \"\n            \"are conditional on hypothetical assumptions and are not recommendations or budget approvals.\"\n        ),\n    }\n\n\ndef _scenario_result(scenario: dict[str, Any]) -> dict[str, Any]:\n    token_sd = token_task_sd(scenario[\"token\"], REPETITIONS)\n    token_effect = abs(math.log(TOKEN_RATIO_TARGET))\n    token_power = normal_two_sided_power(token_effect, token_sd / math.sqrt(TASKS), PLANNING_ALPHA)\n\n    correctness = scenario[\"correctness\"]\n    true_difference = (\n        correctness[\"retrieved_memory_pass_probability\"] - correctness[\"no_memory_pass_probability\"]\n    )\n    correctness_sd = correctness_task_sd(correctness, REPETITIONS)\n    correctness_power = normal_noninferiority_power(\n        true_difference,\n        CORRECTNESS_MARGIN,\n        correctness_sd / math.sqrt(TASKS),\n        PLANNING_ALPHA,\n    )\n\n    min_token_tasks = _minimum_tasks(\n        lambda tasks: normal_two_sided_power(\n            token_effect, token_sd / math.sqrt(tasks), PLANNING_ALPHA\n        ),\n        TARGET_POWER,\n    )\n    min_correctness_tasks = _minimum_tasks(\n        lambda tasks: normal_noninferiority_power(\n            true_difference,\n            CORRECTNESS_MARGIN,\n            correctness_sd / math.sqrt(tasks),\n            PLANNING_ALPHA,\n        ),\n        TARGET_POWER,\n    )\n    min_both = (\n        max(min_token_tasks, min_correctness_tasks)\n        if min_token_tasks is not None and min_correctness_tasks is not None\n        else None\n    )\n    joint_lower = max(0.0, token_power + correctness_power - 1.0)\n    joint_upper = min(token_power, correctness_power)\n    return {\n        **scenario,\n        \"assumption_basis\": \"hypothetical planning values; no benchmark outcomes or empirical variance used\",\n        \"results\": {\n            \"token\": {\n                \"task_level_log_ratio_sd\": token_sd,\n                \"standard_error\": token_sd / math.sqrt(TASKS),\n                \"marginal_power\": token_power,\n                \"target_met\": token_power >= TARGET_POWER,\n                \"minimum_tasks_at_4_repetitions\": min_token_tasks,\n            },\n            \"correctness_noninferiority\": {\n                \"true_difference\": true_difference,\n                \"task_level_pass_rate_difference_sd\": correctness_sd,\n                \"standard_error\": correctness_sd / math.sqrt(TASKS),\n                \"marginal_power\": correctness_power,\n                \"target_met\": correctness_power >= TARGET_POWER,\n                \"minimum_tasks_at_4_repetitions\": min_correctness_tasks,\n            },\n            \"both_endpoints\": {\n                \"both_marginal_targets_met\": token_power >= TARGET_POWER\n                and correctness_power >= TARGET_POWER,\n                \"joint_power_frechet_lower_bound\": joint_lower,\n                \"joint_power_frechet_upper_bound\": joint_upper,\n                \"joint_power_if_independent_sensitivity_only\": token_power * correctness_power,\n                \"minimum_tasks_for_both_marginal_targets_at_4_repetitions\": min_both,\n                \"requested_cells_at_that_task_count\": (\n                    min_both * REPETITIONS * PRIMARY_TREATMENTS if min_both is not None else None\n                ),\n                \"maximum_agent_invocations_no_retries_or_replacements\": (\n                    min_both * REPETITIONS * PRIMARY_TREATMENTS\n                    if min_both is not None\n                    else None\n                ),\n            },\n        },\n    }\n\n\ndef _asymptotic_repetition_result(scenario: dict[str, Any]) -> dict[str, Any]:\n    token = scenario[\"token\"]\n    correctness = scenario[\"correctness\"]\n    token_sd = token[\"between_task_log_ratio_sd\"]\n    p0 = correctness[\"no_memory_pass_probability\"]\n    p1 = correctness[\"retrieved_memory_pass_probability\"]\n    icc = correctness[\"within_arm_attempt_icc\"]\n    correlation = correctness[\"cross_treatment_task_mean_correlation\"]\n    variance0 = p0 * (1.0 - p0) * icc\n    variance1 = p1 * (1.0 - p1) * icc\n    correctness_sd = math.sqrt(\n        max(0.0, variance0 + variance1 - 2.0 * correlation * math.sqrt(variance0 * variance1))\n    )\n    true_difference = p1 - p0\n    token_power = normal_two_sided_power(\n        abs(math.log(TOKEN_RATIO_TARGET)), token_sd / math.sqrt(TASKS), PLANNING_ALPHA\n    )\n    correctness_power = normal_noninferiority_power(\n        true_difference,\n        CORRECTNESS_MARGIN,\n        correctness_sd / math.sqrt(TASKS),\n        PLANNING_ALPHA,\n    )\n    return {\n        \"interpretation\": \"limit as repetitions per treatment increase; task count remains 24\",\n        \"token_task_level_sd_floor\": token_sd,\n        \"token_marginal_power_ceiling\": token_power,\n        \"correctness_task_level_sd_floor\": correctness_sd,\n        \"correctness_marginal_power_ceiling\": correctness_power,\n        \"repetitions_only_can_meet_both_marginal_targets\": token_power >= TARGET_POWER\n        and correctness_power >= TARGET_POWER,\n    }\n\n\ndef _round_floats(value: Any) -> Any:\n    if isinstance(value, float):\n        return round(value, 6)\n    if isinstance(value, list):\n        return [_round_floats(item) for item in value]\n    if isinstance(value, tuple):\n        return [_round_floats(item) for item in value]\n    if isinstance(value, dict):\n        return {key: _round_floats(item) for key, item in value.items()}\n    return value\n\n\ndef _build_deprecated_v2_report_not_for_decision() -> dict[str, Any]:\n    token_effect = abs(math.log(TOKEN_RATIO_TARGET))\n    max_token_sd = _maximum_sd(\n        lambda sd: normal_two_sided_power(token_effect, sd / math.sqrt(TASKS), PLANNING_ALPHA),\n        TARGET_POWER,\n    )\n    max_correctness_sd = _maximum_sd(\n        lambda sd: normal_noninferiority_power(\n            0.0, CORRECTNESS_MARGIN, sd / math.sqrt(TASKS), PLANNING_ALPHA\n        ),\n        TARGET_POWER,\n    )\n    scenarios = [_scenario_result(scenario) for scenario in SCENARIOS]\n    conservative = next(item for item in scenarios if item[\"role\"] == \"decision_scenario\")\n    conservative_inputs = next(item for item in SCENARIOS if item[\"role\"] == \"decision_scenario\")\n    passed = conservative[\"results\"][\"both_endpoints\"][\"both_marginal_targets_met\"]\n    calibration = build_calibration_diagnostics()\n    tradeoffs = _design_tradeoffs(conservative_inputs)\n    report = {\n        \"schema_version\": 2,\n        \"artifact_id\": \"agent-brain-confirmatory-power-v2\",\n        \"status\": \"pass\" if passed else \"fail\",\n        \"analysis_kind\": \"deterministic_assumption_sensitivity_with_quarantined_exploratory_calibration\",\n        \"paid_runs_performed\": False,\n        \"empirical_variance_used_in_confirmatory_decision\": False,\n        \"empirical_variance_computed_for_exploratory_diagnostics\": True,\n        \"exploratory_outcomes_analyzed\": True,\n        \"protocol_inputs\": {\n            \"tasks\": TASKS,\n            \"repetitions_per_treatment\": REPETITIONS,\n            \"primary_treatments\": PRIMARY_TREATMENTS,\n            \"requested_cells\": REQUESTED_CELLS,\n            \"power_target\": TARGET_POWER,\n            \"token_reduction_target\": TOKEN_REDUCTION_TARGET,\n            \"token_ratio_alternative\": TOKEN_RATIO_TARGET,\n            \"correctness_noninferiority_margin_absolute\": CORRECTNESS_MARGIN,\n            \"endpoint_family_alpha\": FAMILY_ALPHA,\n            \"endpoint_family_comparisons\": FAMILY_COMPARISONS,\n            \"holm_worst_case_planning_alpha\": PLANNING_ALPHA,\n        },\n        \"method\": {\n            \"token\": (\n                \"Two-sided normal power for the paired task-level mean log token ratio; task SD is \"\n                \"sqrt(between-task treatment-effect variance + averaged within-attempt variance).\"\n            ),\n            \"correctness\": (\n                \"One-sided normal non-inferiority power for the paired task-level pass-rate \"\n                \"difference; repeated Bernoulli variance is inflated by a stated ICC.\"\n            ),\n            \"multiplicity\": \"Holm first-step alpha=0.05/2 is used for both retained-vs-control comparisons.\",\n            \"small_sample_caveat\": (\n                \"The normal approximation does not model discrete correctness outcomes or the exact \"\n                \"small-sample bootstrap tails at 24 task clusters; required task counts are sensitivity \"\n                \"estimates, not a final design recommendation.\"\n            ),\n            \"joint_power_caveat\": (\n                \"Endpoint dependence is unspecified. Frechet bounds and an independence sensitivity \"\n                \"are reported, but the pass rule uses the two marginal targets.\"\n            ),\n        },\n        \"design_tolerance_at_24_tasks\": {\n            \"maximum_task_level_log_ratio_sd_for_80_percent_token_power\": max_token_sd,\n            \"maximum_task_level_pass_rate_difference_sd_for_80_percent_noninferiority_power_at_true_parity\": max_correctness_sd,\n            \"interpretation\": (\n                \"The design can meet the marginal targets only if actual task-level variability is no \"\n                \"larger than these thresholds under the planning approximation.\"\n            ),\n        },\n        \"scenarios\": scenarios,\n        \"conservative_repetition_limit\": _asymptotic_repetition_result(conservative),\n        \"design_options\": tradeoffs,\n        \"exploratory_calibration\": calibration,\n        \"decision\": {\n            \"scenario\": conservative[\"id\"],\n            \"rule\": \"pass only if token and correctness marginal power are each at least 0.80\",\n            \"passed\": passed,\n            \"conclusion\": (\n                \"The proposed 24-task x 4-repetition design does not substantiate the declared power \"\n                \"target under the conservative planning scenario. Quarantined legacy outcomes cannot \"\n                \"repair that failure. Do not mark power_target_met pass.\"\n            ),\n        },\n        \"next_decision\": {\n            \"status\": \"human_methodology_decision_required\",\n            \"recommended_action\": \"choose_calibration_basis_before_resizing_or_sealing_holdout\",\n            \"smallest_defensible_step\": (\n                \"Keep the gate failed and the fresh holdout unopened. Decide whether to (a) explicitly \"\n                \"accept the hypothetical conservative assumptions and their resulting task/cell envelope, \"\n                \"or (b) preregister and budget a separate development-only calibration under the final \"\n                \"runner and treatment contracts. Do not choose task count from the legacy point estimates.\"\n            ),\n            \"why_no_automatic_design_is_selected\": [\n                \"the decision scenario is hypothetical rather than empirically calibrated\",\n                \"the retained outcomes use legacy treatments and non-exchangeable runners and harnesses\",\n                \"the byte-verifiable sources contain only sparse, selected task clusters with saturated or unstable correctness\",\n                \"the apparent cell minimum trades repetitions for hundreds of task clusters and is only arithmetic sensitivity\",\n            ],\n            \"prohibited_until_decision\": [\n                \"mark power_target_met pass\",\n                \"seal or open the fresh confirmatory holdout\",\n                \"authorize paid confirmatory cells\",\n                \"promote exploratory variance estimates into confirmatory assumptions\",\n            ],\n        },\n    }\n    return _round_floats(report)\n\n\ndef _finite_numeric(value: Any, label: str) -> float:\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\n        raise ValueError(f\"{label} must be numeric\")\n    try:\n        number = float(value)\n    except OverflowError as exc:\n        raise ValueError(f\"{label} must be finite\") from exc\n    if not math.isfinite(number):\n        raise ValueError(f\"{label} must be finite\")\n    return number\n\n\ndef _probability(value: Any, label: str) -> float:\n    number = _finite_numeric(value, label)\n    if not 0.0 <= number <= 1.0:\n        raise ValueError(f\"{label} must be in [0,1]\")\n    return number\n\n\ndef _positive_integer(value: Any, label: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value < 2:\n        raise ValueError(f\"{label} must be an integer of at least two\")\n    return value\n\n\ndef _require_exact_fields(value: Any, fields: tuple[str, ...], label: str) -> dict[str, Any]:\n    if not isinstance(value, dict):\n        raise ValueError(f\"{label} must be an object\")\n    if set(value) != set(fields):\n        raise ValueError(f\"{label} fields changed\")\n    return value\n\n\ndef recompute_power_decision(report: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Validate the pending-only v3 contract and derive its closed gate.\n\n    V3 deliberately has no authenticated final-calibration or owner-assumption\n    input ABI from which numeric power can be recomputed.  Supplying SDs,\n    marginal powers, joint power, or sized counts therefore cannot transition\n    this schema to an evaluated state.  That transition requires a new schema\n    which hashes its authoritative inputs and deterministically derives power.\n    \"\"\"\n    report = _require_exact_fields(\n        report,\n        (\n            \"schema_version\",\n            \"artifact_id\",\n            \"analysis_kind\",\n            \"paid_runs_performed\",\n            \"protocol_inputs\",\n            \"co_primary_endpoints\",\n            \"joint_iut_power\",\n            \"method\",\n            \"calibration_requirements\",\n            \"design_readiness\",\n            \"exploratory_calibration\",\n            \"empirical_variance_used_in_confirmatory_decision\",\n            \"status\",\n            \"decision\",\n        ),\n        \"power report\",\n    )\n    if report.get(\"schema_version\") != POWER_ARTIFACT_SCHEMA_VERSION:\n        raise ValueError(\"power artifact schema_version must remain 3\")\n    if report.get(\"artifact_id\") != POWER_ARTIFACT_ID:\n        raise ValueError(\"power artifact_id changed\")\n    if report.get(\"analysis_kind\") != POWER_ANALYSIS_KIND:\n        raise ValueError(\"power analysis_kind changed\")\n    if report.get(\"paid_runs_performed\") is not False:\n        raise ValueError(\"pending power artifact cannot claim paid runs\")\n\n    inputs = _require_exact_fields(\n        report.get(\"protocol_inputs\"),\n        (\n            \"tasks\",\n            \"repetitions_per_treatment\",\n            \"primary_treatments\",\n            \"requested_cells\",\n            \"agent_retry_limit\",\n            \"replacement_cell_limit\",\n            \"maximum_agent_invocations\",\n            \"power_target\",\n            \"intersection_union_alpha\",\n            \"primary_contrast\",\n            \"cluster_unit\",\n            \"attempt_policy\",\n        ),\n        \"power protocol_inputs\",\n    )\n    target = _probability(inputs.get(\"power_target\"), \"power target\")\n    if target != TARGET_POWER:\n        raise ValueError(f\"power target must remain frozen at {TARGET_POWER:.2f}\")\n    tasks = _positive_integer(inputs.get(\"tasks\"), \"protocol task count\")\n    repetitions = _positive_integer(\n        inputs.get(\"repetitions_per_treatment\"), \"protocol repetitions per treatment\"\n    )\n    treatments = _positive_integer(\n        inputs.get(\"primary_treatments\"), \"protocol primary treatment count\"\n    )\n    if tasks != TASKS:\n        raise ValueError(\n            f\"protocol task count must remain the provisional {TASKS} until a versioned sizing transition\"\n        )\n    if repetitions != REPETITIONS:\n        raise ValueError(\n            f\"protocol repetitions per treatment must remain frozen at {REPETITIONS} in v3\"\n        )\n    if treatments != PRIMARY_TREATMENTS:\n        raise ValueError(\n            f\"protocol primary treatment count must remain frozen at {PRIMARY_TREATMENTS} in v3\"\n        )\n    alpha = _probability(inputs.get(\"intersection_union_alpha\"), \"intersection-union alpha\")\n"},"started_at_ms":1789839574503,"completed_at_ms":1789839574503}}
{"timestamp":"2026-09-19T17:39:34.506Z","ordinal":7518,"type":"token_usage_record","payload":{"thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","session_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","root_turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","response_id":"resp_0cb48b2b18d09e75016aaec8d29d3087d2a4b24330500eb856","usage":{"input_tokens":114852,"cached_input_tokens":108160,"cache_write_input_tokens":0,"output_tokens":48,"reasoning_output_tokens":0,"total_tokens":114900},"turn_token_usage":{"input_tokens":72354677,"cached_input_tokens":69225472,"cache_write_input_tokens":0,"output_tokens":171491,"reasoning_output_tokens":14556,"total_tokens":72526168},"thread_token_usage":{"input_tokens":138239696,"cached_input_tokens":131797504,"cache_write_input_tokens":0,"output_tokens":356290,"reasoning_output_tokens":35933,"total_tokens":138595986}}}
{"timestamp":"2026-09-19T17:39:34.560Z","ordinal":7519,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0bac0-8620-76d1-ba4b-187e6a7d0e6d","call_id":"call_Ne9xvFdU0XUtvwAujmgckiqs","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"c58672\",\"wall_time_seconds\":0.000002417,\"exit_code\":0,\"original_token_count\":5709,\"output\":\"\\n\\ndef _maximum_sd(power_at_sd: Callable[[float], float], target: float) -> float:\\n    low, high = 0.0, 10.0\\n    for _ in range(200):\\n        midpoint = (low + high) / 2.0\\n        if power_at_sd(midpoint) >= target:\\n            low = midpoint\\n        else:\\n            high = midpoint\\n    return low\\n\\n\\ndef _design_power(scenario: dict[str, Any], tasks: int, repetitions: int) -> dict[str, Any]:\\n    if tasks < 2 or repetitions < 1:\\n        raise ValueError(\\\"power design requires at least two tasks and one repetition\\\")\\n    token_sd = token_task_sd(scenario[\\\"token\\\"], repetitions)\\n    token_power = normal_two_sided_power(\\n        abs(math.log(TOKEN_RATIO_TARGET)), token_sd / math.sqrt(tasks), PLANNING_ALPHA\\n    )\\n    correctness = scenario[\\\"correctness\\\"]\\n    true_difference = (\\n        correctness[\\\"retrieved_memory_pass_probability\\\"]\\n        - correctness[\\\"no_memory_pass_probability\\\"]\\n    )\\n    correctness_sd = correctness_task_sd(correctness, repetitions)\\n    correctness_power = normal_noninferiority_power(\\n        true_difference,\\n        CORRECTNESS_MARGIN,\\n        correctness_sd / math.sqrt(tasks),\\n        PLANNING_ALPHA,\\n    )\\n    return {\\n        \\\"tasks\\\": tasks,\\n        \\\"repetitions_per_treatment\\\": repetitions,\\n        \\\"requested_cells\\\": tasks * repetitions * PRIMARY_TREATMENTS,\\n        \\\"maximum_agent_invocations_no_retries_or_replacements\\\": (\\n            tasks * repetitions * PRIMARY_TREATMENTS\\n        ),\\n        \\\"token_task_level_log_ratio_sd\\\": token_sd,\\n        \\\"token_marginal_power\\\": token_power,\\n        \\\"correctness_task_level_pass_rate_difference_sd\\\": correctness_sd,\\n        \\\"correctness_noninferiority_marginal_power\\\": correctness_power,\\n        \\\"both_marginal_targets_met\\\": token_power >= TARGET_POWER\\n        and correctness_power >= TARGET_POWER,\\n    }\\n\\n\\ndef _minimum_repetitions(\\n    power_at_repetitions: Callable[[int], float], target: float, maximum: int = 10_000\\n) -> int | None:\\n    for repetitions in range(1, maximum + 1):\\n        if power_at_repetitions(repetitions) >= target:\\n            return repetitions\\n    return None\\n\\n\\ndef _design_tradeoffs(scenario: dict[str, Any]) -> dict[str, Any]:\\n    token_effect = abs(math.log(TOKEN_RATIO_TARGET))\\n    correctness = scenario[\\\"correctness\\\"]\\n    true_difference = (\\n        correctness[\\\"retrieved_memory_pass_probability\\\"]\\n        - correctness[\\\"no_memory_pass_probability\\\"]\\n    )\\n    by_repetitions: list[dict[str, Any]] = []\\n    for repetitions in REPETITION_TRADEOFFS:\\n        token_sd = token_task_sd(scenario[\\\"token\\\"], repetitions)\\n        correctness_sd = correctness_task_sd(correctness, repetitions)\\n        token_tasks = _minimum_tasks(\\n            lambda tasks: normal_two_sided_power(\\n                token_effect, token_sd / math.sqrt(tasks), PLANNING_ALPHA\\n            ),\\n            TARGET_POWER,\\n        )\\n        correctness_tasks = _minimum_tasks(\\n            lambda tasks: normal_noninferiority_power(\\n                true_difference,\\n                CORRECTNESS_MARGIN,\\n                correctness_sd / math.sqrt(tasks),\\n                PLANNING_ALPHA,\\n            ),\\n            TARGET_POWER,\\n        )\\n        tasks_for_both = (\\n            max(token_tasks, correctness_tasks)\\n            if token_tasks is not None and correctness_tasks is not None\\n            else None\\n        )\\n        row = {\\n            \\\"repetitions_per_treatment\\\": repetitions,\\n            \\\"minimum_tasks_for_token_target\\\": token_tasks,\\n            \\\"minimum_tasks_for_correctness_noninferiority_target\\\": correctness_tasks,\\n            \\\"minimum_tasks_for_both_marginal_targets\\\": tasks_for_both,\\n            \\\"requested_cells_at_minimum_tasks\\\": (\\n                tasks_for_both * repetitions * PRIMARY_TREATMENTS\\n                if tasks_for_both is not None\\n                else None\\n            ),\\n            \\\"maximum_agent_invocations_no_retries_or_replacements\\\": (\\n                tasks_for_both * repetitions * PRIMARY_TREATMENTS\\n                if tasks_for_both is not None\\n                else None\\n            ),\\n        }\\n        by_repetitions.append(row)\\n\\n    by_tasks: list[dict[str, Any]] = []\\n    for tasks in TASK_TRADEOFFS:\\n        token_repetitions = _minimum_repetitions(\\n            lambda repetitions: normal_two_sided_power(\\n                token_effect,\\n                token_task_sd(scenario[\\\"token\\\"], repetitions) / math.sqrt(tasks),\\n                PLANNING_ALPHA,\\n            ),\\n            TARGET_POWER,\\n        )\\n        correctness_repetitions = _minimum_repetitions(\\n            lambda repetitions: normal_noninferiority_power(\\n                true_difference,\\n                CORRECTNESS_MARGIN,\\n                correctness_task_sd(correctness, repetitions) / math.sqrt(tasks),\\n                PLANNING_ALPHA,\\n            ),\\n            TARGET_POWER,\\n        )\\n        repetitions_for_both = (\\n            max(token_repetitions, correctness_repetitions)\\n            if token_repetitions is not None and correctness_repetitions is not None\\n            else None\\n        )\\n        by_tasks.append(\\n            {\\n                \\\"tasks\\\": tasks,\\n                \\\"minimum_repetitions_for_token_target\\\": token_repetitions,\\n                \\\"minimum_repetitions_for_correctness_noninferiority_target\\\": correctness_repetitions,\\n                \\\"minimum_repetitions_for_both_marginal_targets\\\": repetitions_for_both,\\n                \\\"requested_cells_at_minimum_repetitions\\\": (\\n                    tasks * repetitions_for_both * PRIMARY_TREATMENTS\\n                    if repetitions_for_both is not None\\n                    else None\\n                ),\\n                \\\"maximum_agent_invocations_no_retries_or_replacements\\\": (\\n                    tasks * repetitions_for_both * PRIMARY_TREATMENTS\\n                    if repetitions_for_both is not None\\n                    else None\\n                ),\\n            }\\n        )\\n\\n    feasible_by_repetitions = [\\n        row for row in by_repetitions if row[\\\"requested_cells_at_minimum_tasks\\\"] is not None\\n    ]\\n    fewest_cells = min(\\n        feasible_by_repetitions,\\n        key=lambda row: (\\n            row[\\\"requested_cells_at_minimum_tasks\\\"],\\n            row[\\\"minimum_tasks_for_both_marginal_targets\\\"],\\n        ),\\n    )\\n    fewest_tasks = min(\\n        feasible_by_repetitions,\\n        key=lambda row: (\\n            row[\\\"minimum_tasks_for_both_marginal_targets\\\"],\\n            row[\\\"requested_cells_at_minimum_tasks\\\"],\\n        ),\\n    )\\n    return {\\n        \\\"scenario\\\": scenario[\\\"id\\\"],\\n        \\\"status\\\": \\\"arithmetic_sensitivity_not_an_approved_design\\\",\\n        \\\"repetition_options\\\": list(REPETITION_TRADEOFFS),\\n        \\\"task_options\\\": list(TASK_TRADEOFFS),\\n        \\\"minimum_tasks_by_repetitions\\\": by_repetitions,\\n        \\\"minimum_repetitions_by_tasks\\\": by_tasks,\\n        \\\"current_design\\\": _design_power(scenario, TASKS, REPETITIONS),\\n        \\\"arithmetic_extremes_in_listed_repetition_options\\\": {\\n            \\\"fewest_requested_cells\\\": fewest_cells,\\n            \\\"fewest_task_clusters\\\": fewest_tasks,\\n        },\\n        \\\"interpretation\\\": (\\n            \\\"More independent task clusters are substantially more cell-efficient than additional \\\"\\n            \\\"repetitions under the stated positive ICC and irreducible task heterogeneity. These rows \\\"\\n            \\\"are conditional on hypothetical assumptions and are not recommendations or budget approvals.\\\"\\n        ),\\n    }\\n\\n\\ndef _scenario_result(scenario: dict[str, Any]) -> dict[str, Any]:\\n    token_sd = token_task_sd(scenario[\\\"token\\\"], REPETITIONS)\\n    token_effect = abs(math.log(TOKEN_RATIO_TARGET))\\n    token_power = normal_two_sided_power(token_effect, token_sd / math.sqrt(TASKS), PLANNING_ALPHA)\\n\\n    correctness = scenario[\\\"correctness\\\"]\\n    true_difference = (\\n        correctness[\\\"retrieved_memory_pass_probability\\\"] - correctness[\\\"no_memory_pass_probability\\\"]\\n    )\\n    correctness_sd = correctness_task_sd(correctness, REPETITIONS)\\n    correctness_power = normal_noninferiority_power(\\n        true_difference,\\n        CORRECTNESS_MARGIN,\\n        correctness_sd / math.sqrt(TASKS),\\n        PLANNING_ALPHA,\\n    )\\n\\n    min_token_tasks = _minimum_tasks(\\n        lambda tasks: normal_two_sided_power(\\n            token_effect, token_sd / math.sqrt(tasks), PLANNING_ALPHA\\n        ),\\n        TARGET_POWER,\\n    )\\n    min_correctness_tasks = _minimum_tasks(\\n        lambda tasks: normal_noninferiority_power(\\n            true_difference,\\n            CORRECTNESS_MARGIN,\\n            correctness_sd / math.sqrt(tasks),\\n            PLANNING_ALPHA,\\n        ),\\n        TARGET_POWER,\\n    )\\n    min_both = (\\n        max(min_token_tasks, min_correctness_tasks)\\n        if min_token_tasks is not None and min_correctness_tasks is not None\\n        else None\\n    )\\n    joint_lower = max(0.0, token_power + correctness_power - 1.0)\\n    joint_upper = min(token_power, correctness_power)\\n    return {\\n        **scenario,\\n        \\\"assumption_basis\\\": \\\"hypothetical planning values; no benchmark outcomes or empirical variance used\\\",\\n        \\\"results\\\": {\\n            \\\"token\\\": {\\n                \\\"task_level_log_ratio_sd\\\": token_sd,\\n                \\\"standard_error\\\": token_sd / math.sqrt(TASKS),\\n                \\\"marginal_power\\\": token_power,\\n                \\\"target_met\\\": token_power >= TARGET_POWER,\\n                \\\"minimum_tasks_at_4_repetitions\\\": min_token_tasks,\\n            },\\n            \\\"correctness_noninferiority\\\": {\\n                \\\"true_difference\\\": true_difference,\\n                \\\"task_level_pass_rate_difference_sd\\\": correctness_sd,\\n                \\\"standard_error\\\": correctness_sd / math.sqrt(TASKS),\\n                \\\"marginal_power\\\": correctness_power,\\n                \\\"target_met\\\": correctness_power >= TARGET_POWER,\\n                \\\"minimum_tasks_at_4_repetitions\\\": min_correctness_tasks,\\n            },\\n            \\\"both_endpoints\\\": {\\n                \\\"both_marginal_targets_met\\\": token_power >= TARGET_POWER\\n                and correctness_power >= TARGET_POWER,\\n                \\\"joint_power_frechet_lower_bound\\\": joint_lower,\\n                \\\"joint_power_frechet_upper_bound\\\": joint_upper,\\n                \\\"joint_power_if_independent_sensitivity_only\\\": token_power * correctness_power,\\n                \\\"minimum_tasks_for_both_marginal_targets_at_4_repetitions\\\": min_both,\\n                \\\"requested_cells_at_that_task_count\\\": (\\n                    min_both * REPETITIONS * PRIMARY_TREATMENTS if min_both is not None else None\\n                ),\\n                \\\"maximum_agent_invocations_no_retries_or_replacements\\\": (\\n                    min_both * REPETITIONS * PRIMARY_TREATMENTS\\n                    if min_both is not None\\n                    else None\\n                ),\\n            },\\n        },\\n    }\\n\\n\\ndef _asymptotic_repetition_result(scenario: dict[str, Any]) -> dict[str, Any]:\\n    token = scenario[\\\"token\\\"]\\n    correctness = scenario[\\\"correctness\\\"]\\n    token_sd = token[\\\"between_task_log_ratio_sd\\\"]\\n    p0 = correctness[\\\"no_memory_pass_probability\\\"]\\n    p1 = correctness[\\\"retrieved_memory_pass_probability\\\"]\\n    icc = correctness[\\\"within_arm_attempt_icc\\\"]\\n    correlation = correctness[\\\"cross_treatment_task_mean_correlation\\\"]\\n    variance0 = p0 * (1.0 - p0) * icc\\n    variance1 = p1 * (1.0 - p1) * icc\\n    correctness_sd = math.sqrt(\\n        max(0.0, variance0 + variance1 - 2.0 * correlation * math.sqrt(variance0 * variance1))\\n    )\\n    true_difference = p1 - p0\\n    token_power = normal_two_sided_power(\\n        abs(math.log(TOKEN_RATIO_TARGET)), token_sd / math.sqrt(TASKS), PLANNING_ALPHA\\n    )\\n    correctness_power = normal_noninferiority_power(\\n        true_difference,\\n        CORRECTNESS_MARGIN,\\n        correctness_sd / math.sqrt(TASKS),\\n        PLANNING_ALPHA,\\n    )\\n    return {\\n        \\\"interpretation\\\": \\\"limit as repetitions per treatment increase; task count remains 24\\\",\\n        \\\"token_task_level_sd_floor\\\": token_sd,\\n        \\\"token_marginal_power_ceiling\\\": token_power,\\n        \\\"correctness_task_level_sd_floor\\\": correctness_sd,\\n        \\\"correctness_marginal_power_ceiling\\\": correctness_power,\\n        \\\"repetitions_only_can_meet_both_marginal_targets\\\": token_power >= TARGET_POWER\\n        and correctness_power >= TARGET_POWER,\\n    }\\n\\n\\ndef _round_floats(value: Any) -> Any:\\n    if isinstance(value, float):\\n        return round(value, 6)\\n    if isinstance(value, list):\\n        return [_round_floats(item) for item in value]\\n    if isinstance(value, tuple):\\n        return [_round_floats(item) for item in value]\\n    if isinstance(value, dict):\\n        return {key: _round_floats(item) for key, item in value.items()}\\n    return value\\n\\n\\ndef _build_deprecated_v2_report_not_for_decision() -> dict[str, Any]:\\n    token_effect = abs(math.log(TOKEN_RATIO_TARGET))\\n    max_token_sd = _maximum_sd(\\n        lambda sd: normal_two_sided_power(token_effect, sd / math.sqrt(TASKS), PLANNING_ALPHA),\\n        TARGET_POWER,\\n    )\\n    max_correctness_sd = _maximum_sd(\\n        lambda sd: normal_noninferiority_power(\\n            0.0, CORRECTNESS_MARGIN, sd / math.sqrt(TASKS), PLANNING_ALPHA\\n        ),\\n        TARGET_POWER,\\n    )\\n    scenarios = [_scenario_result(scenario) for scenario in SCENARIOS]\\n    conservative = next(item for item in scenarios if item[\\\"role\\\"] == \\\"decision_scenario\\\")\\n    conservative_inputs = next(item for item in SCENARIOS if item[\\\"role\\\"] == \\\"decision_scenario\\\")\\n    passed = conservative[\\\"results\\\"][\\\"both_endpoints\\\"][\\\"both_marginal_targets_met\\\"]\\n    calibration = build_calibration_diagnostics()\\n    tradeoffs = _design_tradeoffs(conservative_inputs)\\n    report = {\\n        \\\"schema_version\\\": 2,\\n        \\\"artifact_id\\\": \\\"agent-brain-confirmatory-power-v2\\\",\\n        \\\"status\\\": \\\"pass\\\" if passed else \\\"fail\\\",\\n        \\\"analysis_kind\\\": \\\"deterministic_assumption_sensitivity_with_quarantined_exploratory_calibration\\\",\\n        \\\"paid_runs_performed\\\": False,\\n        \\\"empirical_variance_used_in_confirmatory_decision\\\": False,\\n        \\\"empirical_variance_computed_for_exploratory_diagnostics\\\": True,\\n        \\\"exploratory_outcomes_analyzed\\\": True,\\n        \\\"protocol_inputs\\\": {\\n            \\\"tasks\\\": TASKS,\\n            \\\"repetitions_per_treatment\\\": REPETITIONS,\\n            \\\"primary_treatments\\\": PRIMARY_TREATMENTS,\\n            \\\"requested_cells\\\": REQUESTED_CELLS,\\n            \\\"power_target\\\": TARGET_POWER,\\n            \\\"token_reduction_target\\\": TOKEN_REDUCTION_TARGET,\\n            \\\"token_ratio_alternative\\\": TOKEN_RATIO_TARGET,\\n            \\\"correctness_noninferiority_margin_absolute\\\": CORRECTNESS_MARGIN,\\n            \\\"endpoint_family_alpha\\\": FAMILY_ALPHA,\\n            \\\"endpoint_family_comparisons\\\": FAMILY_COMPARISONS,\\n            \\\"holm_worst_case_planning_alpha\\\": PLANNING_ALPHA,\\n        },\\n        \\\"method\\\": {\\n            \\\"token\\\": (\\n                \\\"Two-sided normal power for the paired task-level mean log token ratio; task SD is \\\"\\n                \\\"sqrt(between-task treatment-effect variance + averaged within-attempt variance).\\\"\\n            ),\\n            \\\"correctness\\\": (\\n                \\\"One-sided normal non-inferiority power for the paired task-level pass-rate \\\"\\n                \\\"difference; repeated Bernoulli variance is inflated by a stated ICC.\\\"\\n            ),\\n            \\\"multiplicity\\\": \\\"Holm first-step alpha=0.05/2 is used for both retained-vs-control comparisons.\\\",\\n            \\\"small_sample_caveat\\\": (\\n                \\\"The normal approximation does not model discrete correctness outcomes or the exact \\\"\\n                \\\"small-sample bootstrap tails at 24 task clusters; required task counts are sensitivity \\\"\\n                \\\"estimates, not a final design recommendation.\\\"\\n            ),\\n            \\\"joint_power_caveat\\\": (\\n                \\\"Endpoint dependence is unspecified. Frechet bounds and an independence sensitivity \\\"\\n                \\\"are reported, but the pass rule uses the two marginal targets.\\\"\\n            ),\\n        },\\n        \\\"design_tolerance_at_24_tasks\\\": {\\n            \\\"maximum_task_level_log_ratio_sd_for_80_percent_token_power\\\": max_token_sd,\\n            \\\"maximum_task_level_pass_rate_difference_sd_for_80_percent_noninferiority_power_at_true_parity\\\": max_correctness_sd,\\n            \\\"interpretation\\\": (\\n                \\\"The design can meet the marginal targets only if actual task-level variability is no \\\"\\n                \\\"larger than these thresholds under the planning approximation.\\\"\\n            ),\\n        },\\n        \\\"scenarios\\\": scenarios,\\n        \\\"conservative_repetition_limit\\\": _asymptotic_repetition_result(conservative),\\n        \\\"design_options\\\": tradeoffs,\\n        \\\"exploratory_calibration\\\": calibration,\\n        \\\"decision\\\": {\\n            \\\"scenario\\\": conservative[\\\"id\\\"],\\n            \\\"rule\\\": \\\"pass only if token and correctness marginal power are each at least 0.80\\\",\\n            \\\"passed\\\": passed,\\n            \\\"conclusion\\\": (\\n                \\\"The proposed 24-task x 4-repetition design does not substantiate the declared power \\\"\\n                \\\"target under the conservative planning scenario. Quarantined legacy outcomes cannot \\\"\\n                \\\"repair that failure. Do not mark power_target_met pass.\\\"\\n            ),\\n        },\\n        \\\"next_decision\\\": {\\n            \\\"status\\\": \\\"human_methodology_decision_required\\\",\\n            \\\"recommended_action\\\": \\\"choose_calibration_basis_before_resizing_or_sealing_holdout\\\",\\n            \\\"smallest_defensible_step\\\": (\\n                \\\"Keep the gate failed and the fresh holdout unopened. Decide whether to (a) explicitly \\\"\\n                \\\"accept the hypothetical conservative assumptions and their resulting task/cell envelope, \\\"\\n                \\\"or (b) preregister and budget a separate development-only calibration under the final \\\"\\n                \\\"runner and treatment contracts. Do not choose task count from the legacy point estimates.\\\"\\n            ),\\n            \\\"why_no_automatic_design_is_selected\\\": [\\n                \\\"the decision scenario is hypothetical rather than empirically calibrated\\\",\\n                \\\"the retained outcomes use legacy treatments and non-exchangeable runners and harnesses\\\",\\n                \\\"the byte-verifiable sources contain only sparse, selected task clusters with saturated or unstable correctness\\\",\\n                \\\"the apparent cell minimum trades repetitions for hundreds of task clusters and is only arithmetic sensitivity\\\",\\n            ],\\n            \\\"prohibited_until_decision\\\": [\\n                \\\"mark power_target_met pass\\\",\\n                \\\"seal or open the fresh confirmatory holdout\\\",\\n                \\\"authorize paid confirmatory cells\\\",\\n                \\\"promote exploratory variance estimates into confirmatory assumptions\\\",\\n            ],\\n        },\\n    }\\n    return _round_floats(report)\\n\\n\\ndef _finite_numeric(value: Any, label: str) -> float:\\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\\n        raise ValueError(f\\\"{label} must be numeric\\\")\\n    try:\\n        number = float(value)\\n    except OverflowError as exc:\\n        raise ValueError(f\\\"{label} must be finite\\\") from exc\\n    if not math.isfinite(number):\\n        raise ValueError(f\\\"{label} must be finite\\\")\\n    return number\\n\\n\\ndef _probability(value: Any, label: str) -> float:\\n    number = _finite_numeric(value, label)\\n    if not 0.0 <= number <= 1.0:\\n        raise ValueError(f\\\"{label} must be in [0,1]\\\")\\n    return number\\n\\n\\ndef _positive_integer(value: Any, label: str) -> int:\\n    if isinstance(value, bool) or not isinstance(value, int) or value < 2:\\n        raise ValueError(f\\\"{label} must be an integer of at least two\\\")\\n    return value\\n\\n\\ndef _require_exact_fields(value: Any, fields: tuple[str, ...], label: str) -> dict[str, Any]:\\n    if not isinstance(value, dict):\\n        raise ValueError(f\\\"{label} must be an object\\\")\\n    if set(value) != set(fields):\\n        raise ValueError(f\\\"{label} fields changed\\\")\\n    return value\\n\\n\\ndef recompute_power_decision(report: dict[str, Any]) -> dict[str, Any]:\\n    \\\"\\\"\\\"Validate the pending-only v3 contract and derive its closed gate.\\n\\n    V3 deliberately has no authenticated final-calibration or owner-assumption\\n    input ABI from which numeric power can be recomputed.  Supplying SDs,\\n    marginal powers, joint power, or sized counts therefore cannot transition\\n    this schema to an evaluated state.  That transition requires a new schema\\n    which hashes its authoritative inputs and deterministically derives power.\\n    \\\"\\\"\\\"\\n    report = _require_exact_fields(\\n        report,\\n        (\\n            \\\"schema_version\\\",\\n            \\\"artifact_id\\\",\\n            \\\"analysis_kind\\\",\\n            \\\"paid_runs_performed\\\",\\n            \\\"protocol_inputs\\\",\\n            \\\"co_primary_endpoints\\\",\\n            \\\"joint_iut_power\\\",\\n            \\\"method\\\",\\n            \\\"calibration_requirements\\\",\\n            \\\"design_readiness\\\",\\n            \\\"exploratory_calibration\\\",\\n            \\\"empirical_variance_used_in_confirmatory_decision\\\",\\n            \\\"status\\\",\\n            \\\"decision\\\",\\n        ),\\n        \\\"power report\\\",\\n    )\\n    if report.get(\\\"schema_version\\\") != POWER_ARTIFACT_SCHEMA_VERSION:\\n        raise ValueError(\\\"power artifact schema_version must remain 3\\\")\\n    if report.get(\\\"artifact_id\\\") != POWER_ARTIFACT_ID:\\n        raise ValueError(\\\"power artifact_id changed\\\")\\n    if report.get(\\\"analysis_kind\\\") != POWER_ANALYSIS_KIND:\\n        raise ValueError(\\\"power analysis_kind changed\\\")\\n    if report.get(\\\"paid_runs_performed\\\") is not False:\\n        raise ValueError(\\\"pending power artifact cannot claim paid runs\\\")\\n\\n    inputs = _require_exact_fields(\\n        report.get(\\\"protocol_inputs\\\"),\\n        (\\n            \\\"tasks\\\",\\n            \\\"repetitions_per_treatment\\\",\\n            \\\"primary_treatments\\\",\\n            \\\"requested_cells\\\",\\n            \\\"agent_retry_limit\\\",\\n            \\\"replacement_cell_limit\\\",\\n            \\\"maximum_agent_invocations\\\",\\n            \\\"power_target\\\",\\n            \\\"intersection_union_alpha\\\",\\n            \\\"primary_contrast\\\",\\n            \\\"cluster_unit\\\",\\n            \\\"attempt_policy\\\",\\n        ),\\n        \\\"power protocol_inputs\\\",\\n    )\\n    target = _probability(inputs.get(\\\"power_target\\\"), \\\"power target\\\")\\n    if target != TARGET_POWER:\\n        raise ValueError(f\\\"power target must remain frozen at {TARGET_POWER:.2f}\\\")\\n    tasks = _positive_integer(inputs.get(\\\"tasks\\\"), \\\"protocol task count\\\")\\n    repetitions = _positive_integer(\\n        inputs.get(\\\"repetitions_per_treatment\\\"), \\\"protocol repetitions per treatment\\\"\\n    )\\n    treatments = _positive_integer(\\n        inputs.get(\\\"primary_treatments\\\"), \\\"protocol primary treatment count\\\"\\n    )\\n    if tasks != TASKS:\\n        raise ValueError(\\n            f\\\"protocol task count must remain the provisional {TASKS} until a versioned sizing transition\\\"\\n        )\\n    if repetitions != REPETITIONS:\\n        raise ValueError(\\n            f\\\"protocol repetitions per treatment must remain frozen at {REPETITIONS} in v3\\\"\\n        )\\n    if treatments != PRIMARY_TREATMENTS:\\n        raise ValueError(\\n            f\\\"protocol primary treatment count must remain frozen at {PRIMARY_TREATMENTS} in v3\\\"\\n        )\\n    alpha = _probability(inputs.get(\\\"intersection_union_alpha\\\"), \\\"intersection-union alpha\\\")\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839574.560184}}}
