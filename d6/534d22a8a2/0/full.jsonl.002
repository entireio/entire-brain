{"timestamp":"2026-09-19T17:39:13.134Z","ordinal":7505,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","item":{"type":"CommandExecution","id":"exec-75c1e0fa-f842-46d7-9ed7-cfc5072310a7","process_id":"76502","command":["/bin/zsh","-lc","sed -n '1,508p' benchmarks/agent-brain/confirmatory/test_relevance_dataset.py"],"cwd":"file:///Users/thomi/.codex/worktrees/5d33/entire-brain","parsed_cmd":[{"type":"read","cmd":"sed -n '1,508p' benchmarks/agent-brain/confirmatory/test_relevance_dataset.py","name":"test_relevance_dataset.py","path":"benchmarks/agent-brain/confirmatory/test_relevance_dataset.py"}],"source":"unified_exec_startup","status":"completed","stdout":"import copy\nimport importlib.util\nimport json\nimport pathlib\nimport tempfile\nimport unittest\n\n\nMODULE_PATH = pathlib.Path(__file__).with_name(\"relevance_dataset.py\")\nSPEC = importlib.util.spec_from_file_location(\"relevance_dataset\", MODULE_PATH)\nrelevance = importlib.util.module_from_spec(SPEC)\nassert SPEC.loader is not None\nSPEC.loader.exec_module(relevance)\n\n\nHERE = pathlib.Path(__file__).parent\nREPO = HERE.parents[2]\n\n\nclass RelevanceDatasetTests(unittest.TestCase):\n    @staticmethod\n    def _refresh_snapshot_commitment(labels_path, snapshot_path, *, refresh_judgment_hashes=False):\n        labels = json.loads(labels_path.read_text())\n        snapshot = json.loads(snapshot_path.read_text())\n        snapshot[\"fact_count\"] = len(snapshot[\"facts\"])\n        snapshot[\"facts_sha256\"] = relevance.sha256_bytes(relevance.canonical_json(snapshot[\"facts\"]))\n        snapshot[\"session_date_count\"] = len(snapshot[\"session_dates\"])\n        snapshot[\"session_dates_sha256\"] = relevance.sha256_bytes(\n            relevance.canonical_json(snapshot[\"session_dates\"])\n        )\n        labels[\"snapshot_commitment\"] = relevance._snapshot_commitment(snapshot)\n        if refresh_judgment_hashes:\n            fact_index = {fact[\"id\"]: fact for fact in snapshot[\"facts\"]}\n            for item in labels[\"items\"]:\n                for judgment in item[\"judgments\"]:\n                    judgment[\"fact_sha256\"] = relevance.fact_sha256(fact_index[judgment[\"fact_id\"]])\n        labels_path.write_text(json.dumps(labels))\n        snapshot_path.write_text(json.dumps(snapshot))\n\n    def _fixture(self):\n        temporary = tempfile.TemporaryDirectory()\n        repo = pathlib.Path(temporary.name)\n        (repo / \"tasks\").mkdir()\n        config = {\n            \"id\": \"task-one\",\n            \"prompt\": \"Fix the cumulative cache accounting.\",\n            \"rolling_cutoff_rfc3339\": \"2026-02-01T00:00:00Z\",\n            \"exclude_session_ids\": [],\n        }\n        config_path = repo / \"tasks\" / \"task-one.json\"\n        config_path.write_text(json.dumps(config))\n        null_config = {\n            \"id\": \"task-null\",\n            \"prompt\": \"No answer exists for this exposed product task.\",\n            \"rolling_cutoff_rfc3339\": \"2026-02-01T00:00:00Z\",\n            \"exclude_session_ids\": [],\n        }\n        null_config_path = repo / \"tasks\" / \"task-null.json\"\n        null_config_path.write_text(json.dumps(null_config))\n        inventory = {\n            \"tasks\": [{\n                \"task_id\": \"task-one\",\n                \"assigned_split\": \"development\",\n                \"state\": \"agent_run\",\n                \"artifacts\": {\n                    \"config_path\": \"tasks/task-one.json\",\n                    \"config_sha256\": relevance.sha256_bytes(config_path.read_bytes()),\n                    \"prompt_sha256\": relevance.sha256_text(config[\"prompt\"]),\n                },\n            }, {\n                \"task_id\": \"task-null\",\n                \"assigned_split\": \"development\",\n                \"state\": \"prompt_inspected\",\n                \"artifacts\": {\n                    \"config_path\": \"tasks/task-null.json\",\n                    \"config_sha256\": relevance.sha256_bytes(null_config_path.read_bytes()),\n                    \"prompt_sha256\": relevance.sha256_text(null_config[\"prompt\"]),\n                },\n            }],\n        }\n        inventory_path = repo / \"inventory.json\"\n        inventory_path.write_text(json.dumps(inventory))\n        facts = [\n            {\"id\": \"fact:positive\", \"kind\": \"decision\", \"status\": \"active\", \"text\": \"Accumulate cache usage.\",\n             \"provenance\": [{\"session_id\": \"old\"}]},\n            {\"id\": \"fact:distractor\", \"kind\": \"gotcha\", \"status\": \"active\", \"text\": \"Cache is inclusive elsewhere.\",\n             \"provenance\": [{\"session_id\": \"old\"}]},\n            {\"id\": \"fact:irrelevant\", \"kind\": \"decision\", \"status\": \"active\", \"text\": \"Use another API.\",\n             \"provenance\": [{\"session_id\": \"old\"}]},\n        ]\n        session_dates = {\"old\": \"2026-01-01T00:00:00Z\"}\n        active_catalog_hash = relevance.fact_catalog_sha256(facts)\n        snapshot = {\n            \"schema_version\": relevance.SCHEMA_VERSION,\n            \"source_facts_sha256\": \"a\" * 64,\n            \"source_session_dates_sha256\": \"b\" * 64,\n            \"source_active_fact_count\": len(facts),\n            \"source_active_fact_catalog_sha256\": active_catalog_hash,\n            \"fact_count\": len(facts),\n            \"facts_sha256\": relevance.sha256_bytes(relevance.canonical_json(facts)),\n            \"facts\": facts,\n            \"session_date_count\": len(session_dates),\n            \"session_dates_sha256\": relevance.sha256_bytes(relevance.canonical_json(session_dates)),\n            \"session_dates\": session_dates,\n        }\n        snapshot_path = repo / \"snapshot.json\"\n        snapshot_path.write_text(json.dumps(snapshot))\n        review_ledger_path = repo / \"review-ledger.json\"\n        review_ledger_path.write_text(\"fixture retained review bytes\\n\")\n        evidence = {\n            \"type\": \"manual_frozen_corpus_review\",\n            \"source_id\": \"review-ledger.json#fixture\",\n            \"source_path\": \"review-ledger.json\",\n            \"source_sha256\": relevance.sha256_bytes(review_ledger_path.read_bytes()),\n            \"rationale\": \"Reviewed the fixture.\",\n        }\n        labels = {\n            \"schema_version\": relevance.SCHEMA_VERSION,\n            \"dataset_id\": \"fixture\",\n            \"label_set_id\": \"fixture-v2\",\n            \"created_at\": \"2026-02-02T00:00:00Z\",\n            \"source_corpus\": {\n                \"facts_sha256\": \"a\" * 64,\n                \"session_dates_sha256\": \"b\" * 64,\n                \"active_fact_count\": len(facts),\n                \"active_fact_catalog_sha256\": active_catalog_hash,\n            },\n            \"snapshot_commitment\": relevance._snapshot_commitment(snapshot),\n            \"allowed_inventory_states\": list(relevance.SAFE_STATES),\n            \"items\": [\n                {\n                    \"query_id\": \"product\",\n                    \"task_id\": \"task-one\",\n                    \"query_source\": \"user_prompt_derived\",\n                    \"null_query\": False,\n                    \"label_evidence\": evidence,\n                    \"judgments\": [\n                        {\"fact_id\": \"fact:positive\", \"grade\": \"solving\", \"cluster_id\": \"positive\", \"rationale\": \"Direct.\"},\n                        {\"fact_id\": \"fact:distractor\", \"grade\": \"hard_topical_distractor\", \"cluster_id\": \"distractor\", \"rationale\": \"Wrong format.\"},\n                        {\"fact_id\": \"fact:irrelevant\", \"grade\": \"irrelevant\", \"cluster_id\": \"irrelevant\", \"rationale\": \"Unrelated.\"},\n                    ],\n                },\n                {\n                    \"query_id\": \"oracle\",\n                    \"task_id\": \"task-one\",\n                    \"query_source\": \"oracle_upper_bound\",\n                    \"query_text\": \"Which cache usage should accumulate?\",\n                    \"null_query\": False,\n                    \"label_evidence\": evidence,\n                    \"judgments\": [\n                        {\"fact_id\": \"fact:positive\", \"grade\": \"relevant_alternative\", \"cluster_id\": \"positive\", \"rationale\": \"Useful.\"},\n                        {\"fact_id\": \"fact:distractor\", \"grade\": \"hard_topical_distractor\", \"cluster_id\": \"distractor\", \"rationale\": \"Wrong format.\"},\n                    ],\n                },\n                {\n                    \"query_id\": \"null\",\n                    \"task_id\": \"task-null\",\n                    \"query_source\": \"user_prompt_derived\",\n                    \"null_query\": True,\n                    \"label_evidence\": evidence,\n                    \"judgments\": [\n                        {\"fact_id\": \"fact:distractor\", \"grade\": \"hard_topical_distractor\", \"cluster_id\": \"distractor\", \"rationale\": \"Topical only.\"},\n                    ],\n                },\n            ],\n        }\n        fact_index = {fact[\"id\"]: fact for fact in facts}\n        for item in labels[\"items\"]:\n            for judgment in item[\"judgments\"]:\n                judgment[\"fact_sha256\"] = relevance.fact_sha256(fact_index[judgment[\"fact_id\"]])\n        null_item = labels[\"items\"][2]\n        membership = relevance.build_source_membership(facts, session_dates, \"a\" * 64, \"b\" * 64)\n        null_ledger = {\n            \"schema_version\": 1,\n            \"ledger_id\": \"fixture-null-review\",\n            \"items\": [{\n                \"query_id\": \"null\",\n                \"task_id\": \"task-null\",\n                \"query_sha256\": relevance.sha256_text(null_config[\"prompt\"]),\n                \"temporal_policy_sha256\": relevance.temporal_policy_sha256(\n                    null_config[\"rolling_cutoff_rfc3339\"], null_config[\"exclude_session_ids\"]\n                ),\n                \"reviewed_at\": \"2026-02-02T00:00:00Z\",\n                \"reviewer\": \"fixture-reviewer\",\n                \"method\": relevance.NULL_CLOSURE_METHOD,\n                \"source_facts_sha256\": \"a\" * 64,\n                \"source_session_dates_sha256\": \"b\" * 64,\n                \"eligibility_membership_root_sha256\": membership[\"eligibility_membership_root_sha256\"],\n                \"reviewer_assertion\": \"Every derived active+eligible fixture fact was reviewed.\",\n                \"decisions\": [\n                    {\"fact_id\": \"fact:positive\", \"fact_sha256\": relevance.fact_sha256(facts[0]), \"grade\": \"irrelevant\"},\n                    {\"fact_id\": \"fact:distractor\", \"fact_sha256\": relevance.fact_sha256(facts[1]), \"grade\": \"hard_topical_distractor\"},\n                    {\"fact_id\": \"fact:irrelevant\", \"fact_sha256\": relevance.fact_sha256(facts[2]), \"grade\": \"irrelevant\"},\n                ],\n            }],\n        }\n        null_ledger_path = repo / \"null-review-ledger.json\"\n        null_ledger_path.write_text(json.dumps(null_ledger))\n        null_item[\"null_review\"] = {\n            \"source_id\": \"null-review-ledger.json#null\",\n            \"source_path\": \"null-review-ledger.json\",\n            \"source_sha256\": relevance.sha256_bytes(null_ledger_path.read_bytes()),\n        }\n        labels_path = repo / \"labels.json\"\n        labels_path.write_text(json.dumps(labels))\n        runtime = {\n            \"source_membership\": membership,\n            \"null_review_ledger\": null_ledger,\n            \"null_review_ledger_path\": \"null-review-ledger.json\",\n            \"null_review_ledger_sha256\": relevance.sha256_bytes(null_ledger_path.read_bytes()),\n        }\n        return temporary, repo, labels_path, inventory_path, snapshot_path, runtime\n\n    def test_canonical_fact_hash_ignores_object_key_order(self):\n        left = {\"id\": \"fact:x\", \"text\": \"value\"}\n        right = {\"text\": \"value\", \"id\": \"fact:x\"}\n        self.assertEqual(relevance.fact_sha256(left), relevance.fact_sha256(right))\n\n    def test_materialize_derives_hashes_and_temporal_eligibility(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        result = relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n        self.assertEqual(result[\"development\"][\"item_count\"], 3)\n        self.assertEqual(result[\"development\"][\"unique_task_count\"], 2)\n        self.assertEqual(result[\"development\"][\"unique_answerable_product_task_count\"], 1)\n        self.assertEqual(result[\"development\"][\"product_null_query_count\"], 1)\n        product = result[\"development\"][\"items\"][0]\n        self.assertEqual(product[\"query_sha256\"], relevance.sha256_text(product[\"query_text\"]))\n        self.assertTrue(product[\"judgments\"][0][\"eligible\"])\n        self.assertRegex(product[\"judgments\"][0][\"fact_sha256\"], r\"^[0-9a-f]{64}$\")\n\n    def test_materialize_rejects_unexposed_or_nondevelopment_task(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(inventory.read_text())\n        payload[\"tasks\"][0][\"state\"] = \"unseen\"\n        inventory.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"not exposed development\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_rejects_stale_inventory_config_hash(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        (repo / \"tasks\" / \"task-one.json\").write_text(\"{}\")\n        with self.assertRaisesRegex(relevance.DatasetError, \"config hash differs\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_does_not_read_unselected_unseen_config(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(inventory.read_text())\n        payload[\"tasks\"].append({\n            \"task_id\": \"sealed-task\",\n            \"assigned_split\": \"confirmatory\",\n            \"state\": \"unseen\",\n            \"artifacts\": {\n                \"config_path\": \"tasks/must-not-be-read.json\",\n                \"config_sha256\": \"c\" * 64,\n                \"prompt_sha256\": \"d\" * 64,\n            },\n        })\n        inventory.write_text(json.dumps(payload))\n        result = relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n        self.assertEqual(result[\"development\"][\"unique_task_count\"], 2)\n\n    def test_materialize_rejects_positive_fact_at_or_after_cutoff(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(snapshot.read_text())\n        payload[\"session_dates\"][\"old\"] = \"2026-02-01T00:00:00Z\"\n        snapshot.write_text(json.dumps(payload))\n        self._refresh_snapshot_commitment(labels, snapshot)\n        with self.assertRaisesRegex(relevance.DatasetError, \"answerable query has no eligible positive\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_rejects_superseded_fact(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(snapshot.read_text())\n        payload[\"facts\"][0][\"status\"] = \"superseded\"\n        snapshot.write_text(json.dumps(payload))\n        self._refresh_snapshot_commitment(labels, snapshot, refresh_judgment_hashes=True)\n        with self.assertRaisesRegex(relevance.DatasetError, \"only active facts may be judged\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_rejects_snapshot_fact_tampering_after_commitment_refresh(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(snapshot.read_text())\n        payload[\"facts\"][0][\"text\"] = \"Tampered reviewed fact text.\"\n        snapshot.write_text(json.dumps(payload))\n        self._refresh_snapshot_commitment(labels, snapshot)\n        with self.assertRaisesRegex(relevance.DatasetError, \"snapshot fact differs from reviewed fact hash\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_full_source_recheck_rejects_mutated_active_catalog(self):\n        temporary, _repo, labels, _inventory, snapshot, _runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        label_payload = json.loads(labels.read_text())\n        snapshot_payload = json.loads(snapshot.read_text())\n        snapshot_payload[\"facts\"][0][\"text\"] = \"Mutated full-source fact.\"\n        with self.assertRaisesRegex(relevance.DatasetError, \"active full-corpus fact catalog hash\"):\n            relevance.build_snapshot(\n                label_payload,\n                snapshot_payload[\"facts\"],\n                snapshot_payload[\"session_dates\"],\n                \"a\" * 64,\n                \"b\" * 64,\n            )\n\n    def test_materialize_rejects_snapshot_date_without_reviewed_commitment(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(snapshot.read_text())\n        payload[\"session_dates\"][\"old\"] = \"2025-12-01T00:00:00Z\"\n        snapshot.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"session_dates commitment is stale\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_rejects_product_query_override(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(labels.read_text())\n        payload[\"items\"][0][\"query_text\"] = \"hand tuned\"\n        labels.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"derive exactly from task prompt\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_requires_retained_evidence_path_and_hash(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(labels.read_text())\n        del payload[\"items\"][0][\"label_evidence\"][\"source_path\"]\n        labels.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"label_evidence source path is missing\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_rejects_mismatched_retained_evidence_bytes(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        (repo / \"review-ledger.json\").write_text(\"changed bytes\\n\")\n        with self.assertRaisesRegex(relevance.DatasetError, \"retained source hash differs\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_cannot_have_eligible_positive(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(labels.read_text())\n        payload[\"items\"][2][\"judgments\"][0][\"grade\"] = \"solving\"\n        labels.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"null query has eligible positive\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_requires_exhaustive_active_corpus_closure(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(labels.read_text())\n        del payload[\"items\"][2][\"null_review\"]\n        labels.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"requires exact retained review evidence\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_rejects_partial_corpus_review(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        runtime[\"null_review_ledger\"][\"items\"][0][\"decisions\"].pop()\n        with self.assertRaisesRegex(relevance.DatasetError, \"does not exactly cover\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_rejects_duplicate_or_wrong_hash_review_rows(self):\n        for attack in (\"duplicate\", \"wrong_hash\"):\n            with self.subTest(attack=attack):\n                temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n                self.addCleanup(temporary.cleanup)\n                decisions = runtime[\"null_review_ledger\"][\"items\"][0][\"decisions\"]\n                if attack == \"duplicate\":\n                    decisions.append(copy.deepcopy(decisions[0]))\n                    expected = \"missing or duplicated\"\n                else:\n                    decisions[0][\"fact_sha256\"] = \"f\" * 64\n                    expected = \"differs from membership\"\n                with self.assertRaisesRegex(relevance.DatasetError, expected):\n                    relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_rejects_positive_exhaustive_decision(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        runtime[\"null_review_ledger\"][\"items\"][0][\"decisions\"][0][\"grade\"] = \"relevant_alternative\"\n        with self.assertRaisesRegex(relevance.DatasetError, \"contains positive facts\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_rejects_temporal_membership_or_cutoff_laundering(self):\n        for attack in (\"provenance\", \"date\"):\n            with self.subTest(attack=attack):\n                temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n                self.addCleanup(temporary.cleanup)\n                membership = runtime[\"source_membership\"]\n                if attack == \"provenance\":\n                    membership[\"facts\"][0][\"provenance_session_ids\"] = []\n                else:\n                    membership[\"session_dates\"][\"old\"] = \"2026-02-01T00:00:00Z\"\n                with self.assertRaisesRegex(relevance.DatasetError, \"does not exactly cover\"):\n                    relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_d9df_url_fetch_advice_is_not_labeled_solving(self):\n        labels = relevance.load_json(HERE / \"offline-relevance-development-labels.json\")\n        item = next(row for row in labels[\"items\"] if row[\"task_id\"] == \"entire-cli-c0701-d9df8fcca\")\n        grades = {judgment[\"fact_id\"]: judgment[\"grade\"] for judgment in item[\"judgments\"]}\n        self.assertEqual(grades[\"fact:8325ce8c7c9c08ba273c812f\"], \"hard_topical_distractor\")\n        self.assertEqual(grades[\"fact:11af406c1bcd1c4994261a6c\"], \"relevant_alternative\")\n\n    def test_checked_in_dataset_rebuilds_and_keeps_holdout_unopened(self):\n        labels = HERE / \"offline-relevance-development-labels.json\"\n        inventory = HERE / \"task-inventory.json\"\n        snapshot = HERE / \"offline-relevance-fact-snapshot.json\"\n        dataset = HERE / \"offline-relevance-dataset.json\"\n        membership = relevance.load_json(HERE / \"offline-relevance-source-membership.json\")\n        null_ledger_path = HERE / \"offline-relevance-null-review-ledger.json\"\n        null_ledger = relevance.load_json(null_ledger_path)\n        expected = relevance.materialize(\n            REPO,\n            labels,\n            inventory,\n            snapshot,\n            source_membership=membership,\n            null_review_ledger=null_ledger,\n            null_review_ledger_path=null_ledger_path.relative_to(REPO).as_posix(),\n            null_review_ledger_sha256=relevance.sha256_bytes(null_ledger_path.read_bytes()),\n        )\n        actual = relevance.load_json(dataset)\n        relevance.validate_dataset(actual, expected)\n        self.assertEqual(actual[\"development\"][\"item_count\"], 14)\n        self.assertEqual(actual[\"development\"][\"unique_task_count\"], 13)\n        self.assertEqual(actual[\"development\"][\"null_query_count\"], 1)\n        self.assertEqual(actual[\"development\"][\"unique_answerable_product_task_count\"], 12)\n        self.assertEqual(actual[\"development\"][\"product_null_query_count\"], 1)\n        self.assertEqual(actual[\"development\"][\"judgment_count\"], 46)\n        null_item = next(\n            item for item in actual[\"development\"][\"items\"]\n            if item[\"query_id\"] == \"dev-product-b72a6e621\"\n        )\n        self.assertEqual(null_item[\"null_closure\"][\"reviewed_fact_count\"], 2531)\n        self.assertEqual(null_item[\"null_closure\"][\"positive_fact_count\"], 0)\n        decisions = null_ledger[\"items\"][0][\"decisions\"]\n        self.assertEqual(sum(row[\"grade\"] == \"hard_topical_distractor\" for row in decisions), 4)\n        self.assertEqual(sum(row[\"grade\"] == \"irrelevant\" for row in decisions), 2527)\n        schema_errors = relevance.validate_relevance_schemas(\n            relevance.load_json(labels),\n            relevance.load_json(snapshot),\n            actual,\n            HERE / \"schemas\",\n        )\n        self.assertEqual(schema_errors, [])\n        self.assertEqual(actual[\"sealed_holdout\"][\"items\"], [])\n\n    def test_complete_membership_rejects_fabricated_fact_and_date(self):\n        labels = relevance.load_json(HERE / \"offline-relevance-development-labels.json\")\n        snapshot = relevance.load_json(HERE / \"offline-relevance-fact-snapshot.json\")\n        contract = relevance.load_json(HERE / \"relevance-source-contract.json\")\n        membership_path = HERE / \"offline-relevance-source-membership.json\"\n        membership = relevance.load_json(membership_path)\n        fabricated = copy.deepcopy(snapshot)\n        fabricated[\"facts\"][0][\"text\"] += \" Fabricated.\"\n        session_id = next(iter(fabricated[\"session_dates\"]))\n        fabricated[\"session_dates\"][session_id] = \"2020-01-01T00:00:00Z\"\n        with self.assertRaisesRegex(\n            relevance.DatasetError,\n            \"snapshot fact differs from reviewed full-source membership\",\n        ):\n            relevance.validate_source_membership(\n                labels,\n                fabricated,\n                contract,\n                membership,\n                membership_sha256=relevance.sha256_bytes(membership_path.read_bytes()),\n            )\n        date_only = copy.deepcopy(snapshot)\n        date_only[\"session_dates\"][session_id] = \"2020-01-01T00:00:00Z\"\n        with self.assertRaisesRegex(\n            relevance.DatasetError,\n            \"snapshot session date differs from reviewed full-source membership\",\n        ):\n            relevance.validate_source_membership(\n                labels,\n                date_only,\n                contract,\n                membership,\n                membership_sha256=relevance.sha256_bytes(membership_path.read_bytes()),\n            )\n\n    def test_review_ledger_is_exact_per_query_and_judgment(self):\n        labels = relevance.load_json(HERE / \"offline-relevance-development-labels.json\")\n        contract = relevance.load_json(HERE / \"relevance-source-contract.json\")\n        ledger_path = HERE / \"offline-relevance-review-ledger.json\"\n        ledger = relevance.load_json(ledger_path)\n        ledger[\"items\"][0][\"judgments\"][0][\"grade\"] = \"irrelevant\"\n        with self.assertRaisesRegex(relevance.DatasetError, \"ledger judgments differ from labels\"):\n            relevance.validate_review_ledger(\n                labels,\n                ledger,\n                contract,\n                ledger_path=\"benchmarks/agent-brain/confirmatory/offline-relevance-review-ledger.json\",\n                ledger_sha256=relevance.sha256_bytes(ledger_path.read_bytes()),\n            )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","stderr":"","aggregated_output":"import copy\nimport importlib.util\nimport json\nimport pathlib\nimport tempfile\nimport unittest\n\n\nMODULE_PATH = pathlib.Path(__file__).with_name(\"relevance_dataset.py\")\nSPEC = importlib.util.spec_from_file_location(\"relevance_dataset\", MODULE_PATH)\nrelevance = importlib.util.module_from_spec(SPEC)\nassert SPEC.loader is not None\nSPEC.loader.exec_module(relevance)\n\n\nHERE = pathlib.Path(__file__).parent\nREPO = HERE.parents[2]\n\n\nclass RelevanceDatasetTests(unittest.TestCase):\n    @staticmethod\n    def _refresh_snapshot_commitment(labels_path, snapshot_path, *, refresh_judgment_hashes=False):\n        labels = json.loads(labels_path.read_text())\n        snapshot = json.loads(snapshot_path.read_text())\n        snapshot[\"fact_count\"] = len(snapshot[\"facts\"])\n        snapshot[\"facts_sha256\"] = relevance.sha256_bytes(relevance.canonical_json(snapshot[\"facts\"]))\n        snapshot[\"session_date_count\"] = len(snapshot[\"session_dates\"])\n        snapshot[\"session_dates_sha256\"] = relevance.sha256_bytes(\n            relevance.canonical_json(snapshot[\"session_dates\"])\n        )\n        labels[\"snapshot_commitment\"] = relevance._snapshot_commitment(snapshot)\n        if refresh_judgment_hashes:\n            fact_index = {fact[\"id\"]: fact for fact in snapshot[\"facts\"]}\n            for item in labels[\"items\"]:\n                for judgment in item[\"judgments\"]:\n                    judgment[\"fact_sha256\"] = relevance.fact_sha256(fact_index[judgment[\"fact_id\"]])\n        labels_path.write_text(json.dumps(labels))\n        snapshot_path.write_text(json.dumps(snapshot))\n\n    def _fixture(self):\n        temporary = tempfile.TemporaryDirectory()\n        repo = pathlib.Path(temporary.name)\n        (repo / \"tasks\").mkdir()\n        config = {\n            \"id\": \"task-one\",\n            \"prompt\": \"Fix the cumulative cache accounting.\",\n            \"rolling_cutoff_rfc3339\": \"2026-02-01T00:00:00Z\",\n            \"exclude_session_ids\": [],\n        }\n        config_path = repo / \"tasks\" / \"task-one.json\"\n        config_path.write_text(json.dumps(config))\n        null_config = {\n            \"id\": \"task-null\",\n            \"prompt\": \"No answer exists for this exposed product task.\",\n            \"rolling_cutoff_rfc3339\": \"2026-02-01T00:00:00Z\",\n            \"exclude_session_ids\": [],\n        }\n        null_config_path = repo / \"tasks\" / \"task-null.json\"\n        null_config_path.write_text(json.dumps(null_config))\n        inventory = {\n            \"tasks\": [{\n                \"task_id\": \"task-one\",\n                \"assigned_split\": \"development\",\n                \"state\": \"agent_run\",\n                \"artifacts\": {\n                    \"config_path\": \"tasks/task-one.json\",\n                    \"config_sha256\": relevance.sha256_bytes(config_path.read_bytes()),\n                    \"prompt_sha256\": relevance.sha256_text(config[\"prompt\"]),\n                },\n            }, {\n                \"task_id\": \"task-null\",\n                \"assigned_split\": \"development\",\n                \"state\": \"prompt_inspected\",\n                \"artifacts\": {\n                    \"config_path\": \"tasks/task-null.json\",\n                    \"config_sha256\": relevance.sha256_bytes(null_config_path.read_bytes()),\n                    \"prompt_sha256\": relevance.sha256_text(null_config[\"prompt\"]),\n                },\n            }],\n        }\n        inventory_path = repo / \"inventory.json\"\n        inventory_path.write_text(json.dumps(inventory))\n        facts = [\n            {\"id\": \"fact:positive\", \"kind\": \"decision\", \"status\": \"active\", \"text\": \"Accumulate cache usage.\",\n             \"provenance\": [{\"session_id\": \"old\"}]},\n            {\"id\": \"fact:distractor\", \"kind\": \"gotcha\", \"status\": \"active\", \"text\": \"Cache is inclusive elsewhere.\",\n             \"provenance\": [{\"session_id\": \"old\"}]},\n            {\"id\": \"fact:irrelevant\", \"kind\": \"decision\", \"status\": \"active\", \"text\": \"Use another API.\",\n             \"provenance\": [{\"session_id\": \"old\"}]},\n        ]\n        session_dates = {\"old\": \"2026-01-01T00:00:00Z\"}\n        active_catalog_hash = relevance.fact_catalog_sha256(facts)\n        snapshot = {\n            \"schema_version\": relevance.SCHEMA_VERSION,\n            \"source_facts_sha256\": \"a\" * 64,\n            \"source_session_dates_sha256\": \"b\" * 64,\n            \"source_active_fact_count\": len(facts),\n            \"source_active_fact_catalog_sha256\": active_catalog_hash,\n            \"fact_count\": len(facts),\n            \"facts_sha256\": relevance.sha256_bytes(relevance.canonical_json(facts)),\n            \"facts\": facts,\n            \"session_date_count\": len(session_dates),\n            \"session_dates_sha256\": relevance.sha256_bytes(relevance.canonical_json(session_dates)),\n            \"session_dates\": session_dates,\n        }\n        snapshot_path = repo / \"snapshot.json\"\n        snapshot_path.write_text(json.dumps(snapshot))\n        review_ledger_path = repo / \"review-ledger.json\"\n        review_ledger_path.write_text(\"fixture retained review bytes\\n\")\n        evidence = {\n            \"type\": \"manual_frozen_corpus_review\",\n            \"source_id\": \"review-ledger.json#fixture\",\n            \"source_path\": \"review-ledger.json\",\n            \"source_sha256\": relevance.sha256_bytes(review_ledger_path.read_bytes()),\n            \"rationale\": \"Reviewed the fixture.\",\n        }\n        labels = {\n            \"schema_version\": relevance.SCHEMA_VERSION,\n            \"dataset_id\": \"fixture\",\n            \"label_set_id\": \"fixture-v2\",\n            \"created_at\": \"2026-02-02T00:00:00Z\",\n            \"source_corpus\": {\n                \"facts_sha256\": \"a\" * 64,\n                \"session_dates_sha256\": \"b\" * 64,\n                \"active_fact_count\": len(facts),\n                \"active_fact_catalog_sha256\": active_catalog_hash,\n            },\n            \"snapshot_commitment\": relevance._snapshot_commitment(snapshot),\n            \"allowed_inventory_states\": list(relevance.SAFE_STATES),\n            \"items\": [\n                {\n                    \"query_id\": \"product\",\n                    \"task_id\": \"task-one\",\n                    \"query_source\": \"user_prompt_derived\",\n                    \"null_query\": False,\n                    \"label_evidence\": evidence,\n                    \"judgments\": [\n                        {\"fact_id\": \"fact:positive\", \"grade\": \"solving\", \"cluster_id\": \"positive\", \"rationale\": \"Direct.\"},\n                        {\"fact_id\": \"fact:distractor\", \"grade\": \"hard_topical_distractor\", \"cluster_id\": \"distractor\", \"rationale\": \"Wrong format.\"},\n                        {\"fact_id\": \"fact:irrelevant\", \"grade\": \"irrelevant\", \"cluster_id\": \"irrelevant\", \"rationale\": \"Unrelated.\"},\n                    ],\n                },\n                {\n                    \"query_id\": \"oracle\",\n                    \"task_id\": \"task-one\",\n                    \"query_source\": \"oracle_upper_bound\",\n                    \"query_text\": \"Which cache usage should accumulate?\",\n                    \"null_query\": False,\n                    \"label_evidence\": evidence,\n                    \"judgments\": [\n                        {\"fact_id\": \"fact:positive\", \"grade\": \"relevant_alternative\", \"cluster_id\": \"positive\", \"rationale\": \"Useful.\"},\n                        {\"fact_id\": \"fact:distractor\", \"grade\": \"hard_topical_distractor\", \"cluster_id\": \"distractor\", \"rationale\": \"Wrong format.\"},\n                    ],\n                },\n                {\n                    \"query_id\": \"null\",\n                    \"task_id\": \"task-null\",\n                    \"query_source\": \"user_prompt_derived\",\n                    \"null_query\": True,\n                    \"label_evidence\": evidence,\n                    \"judgments\": [\n                        {\"fact_id\": \"fact:distractor\", \"grade\": \"hard_topical_distractor\", \"cluster_id\": \"distractor\", \"rationale\": \"Topical only.\"},\n                    ],\n                },\n            ],\n        }\n        fact_index = {fact[\"id\"]: fact for fact in facts}\n        for item in labels[\"items\"]:\n            for judgment in item[\"judgments\"]:\n                judgment[\"fact_sha256\"] = relevance.fact_sha256(fact_index[judgment[\"fact_id\"]])\n        null_item = labels[\"items\"][2]\n        membership = relevance.build_source_membership(facts, session_dates, \"a\" * 64, \"b\" * 64)\n        null_ledger = {\n            \"schema_version\": 1,\n            \"ledger_id\": \"fixture-null-review\",\n            \"items\": [{\n                \"query_id\": \"null\",\n                \"task_id\": \"task-null\",\n                \"query_sha256\": relevance.sha256_text(null_config[\"prompt\"]),\n                \"temporal_policy_sha256\": relevance.temporal_policy_sha256(\n                    null_config[\"rolling_cutoff_rfc3339\"], null_config[\"exclude_session_ids\"]\n                ),\n                \"reviewed_at\": \"2026-02-02T00:00:00Z\",\n                \"reviewer\": \"fixture-reviewer\",\n                \"method\": relevance.NULL_CLOSURE_METHOD,\n                \"source_facts_sha256\": \"a\" * 64,\n                \"source_session_dates_sha256\": \"b\" * 64,\n                \"eligibility_membership_root_sha256\": membership[\"eligibility_membership_root_sha256\"],\n                \"reviewer_assertion\": \"Every derived active+eligible fixture fact was reviewed.\",\n                \"decisions\": [\n                    {\"fact_id\": \"fact:positive\", \"fact_sha256\": relevance.fact_sha256(facts[0]), \"grade\": \"irrelevant\"},\n                    {\"fact_id\": \"fact:distractor\", \"fact_sha256\": relevance.fact_sha256(facts[1]), \"grade\": \"hard_topical_distractor\"},\n                    {\"fact_id\": \"fact:irrelevant\", \"fact_sha256\": relevance.fact_sha256(facts[2]), \"grade\": \"irrelevant\"},\n                ],\n            }],\n        }\n        null_ledger_path = repo / \"null-review-ledger.json\"\n        null_ledger_path.write_text(json.dumps(null_ledger))\n        null_item[\"null_review\"] = {\n            \"source_id\": \"null-review-ledger.json#null\",\n            \"source_path\": \"null-review-ledger.json\",\n            \"source_sha256\": relevance.sha256_bytes(null_ledger_path.read_bytes()),\n        }\n        labels_path = repo / \"labels.json\"\n        labels_path.write_text(json.dumps(labels))\n        runtime = {\n            \"source_membership\": membership,\n            \"null_review_ledger\": null_ledger,\n            \"null_review_ledger_path\": \"null-review-ledger.json\",\n            \"null_review_ledger_sha256\": relevance.sha256_bytes(null_ledger_path.read_bytes()),\n        }\n        return temporary, repo, labels_path, inventory_path, snapshot_path, runtime\n\n    def test_canonical_fact_hash_ignores_object_key_order(self):\n        left = {\"id\": \"fact:x\", \"text\": \"value\"}\n        right = {\"text\": \"value\", \"id\": \"fact:x\"}\n        self.assertEqual(relevance.fact_sha256(left), relevance.fact_sha256(right))\n\n    def test_materialize_derives_hashes_and_temporal_eligibility(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        result = relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n        self.assertEqual(result[\"development\"][\"item_count\"], 3)\n        self.assertEqual(result[\"development\"][\"unique_task_count\"], 2)\n        self.assertEqual(result[\"development\"][\"unique_answerable_product_task_count\"], 1)\n        self.assertEqual(result[\"development\"][\"product_null_query_count\"], 1)\n        product = result[\"development\"][\"items\"][0]\n        self.assertEqual(product[\"query_sha256\"], relevance.sha256_text(product[\"query_text\"]))\n        self.assertTrue(product[\"judgments\"][0][\"eligible\"])\n        self.assertRegex(product[\"judgments\"][0][\"fact_sha256\"], r\"^[0-9a-f]{64}$\")\n\n    def test_materialize_rejects_unexposed_or_nondevelopment_task(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(inventory.read_text())\n        payload[\"tasks\"][0][\"state\"] = \"unseen\"\n        inventory.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"not exposed development\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_rejects_stale_inventory_config_hash(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        (repo / \"tasks\" / \"task-one.json\").write_text(\"{}\")\n        with self.assertRaisesRegex(relevance.DatasetError, \"config hash differs\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_does_not_read_unselected_unseen_config(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(inventory.read_text())\n        payload[\"tasks\"].append({\n            \"task_id\": \"sealed-task\",\n            \"assigned_split\": \"confirmatory\",\n            \"state\": \"unseen\",\n            \"artifacts\": {\n                \"config_path\": \"tasks/must-not-be-read.json\",\n                \"config_sha256\": \"c\" * 64,\n                \"prompt_sha256\": \"d\" * 64,\n            },\n        })\n        inventory.write_text(json.dumps(payload))\n        result = relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n        self.assertEqual(result[\"development\"][\"unique_task_count\"], 2)\n\n    def test_materialize_rejects_positive_fact_at_or_after_cutoff(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(snapshot.read_text())\n        payload[\"session_dates\"][\"old\"] = \"2026-02-01T00:00:00Z\"\n        snapshot.write_text(json.dumps(payload))\n        self._refresh_snapshot_commitment(labels, snapshot)\n        with self.assertRaisesRegex(relevance.DatasetError, \"answerable query has no eligible positive\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_rejects_superseded_fact(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(snapshot.read_text())\n        payload[\"facts\"][0][\"status\"] = \"superseded\"\n        snapshot.write_text(json.dumps(payload))\n        self._refresh_snapshot_commitment(labels, snapshot, refresh_judgment_hashes=True)\n        with self.assertRaisesRegex(relevance.DatasetError, \"only active facts may be judged\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_rejects_snapshot_fact_tampering_after_commitment_refresh(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(snapshot.read_text())\n        payload[\"facts\"][0][\"text\"] = \"Tampered reviewed fact text.\"\n        snapshot.write_text(json.dumps(payload))\n        self._refresh_snapshot_commitment(labels, snapshot)\n        with self.assertRaisesRegex(relevance.DatasetError, \"snapshot fact differs from reviewed fact hash\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_full_source_recheck_rejects_mutated_active_catalog(self):\n        temporary, _repo, labels, _inventory, snapshot, _runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        label_payload = json.loads(labels.read_text())\n        snapshot_payload = json.loads(snapshot.read_text())\n        snapshot_payload[\"facts\"][0][\"text\"] = \"Mutated full-source fact.\"\n        with self.assertRaisesRegex(relevance.DatasetError, \"active full-corpus fact catalog hash\"):\n            relevance.build_snapshot(\n                label_payload,\n                snapshot_payload[\"facts\"],\n                snapshot_payload[\"session_dates\"],\n                \"a\" * 64,\n                \"b\" * 64,\n            )\n\n    def test_materialize_rejects_snapshot_date_without_reviewed_commitment(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(snapshot.read_text())\n        payload[\"session_dates\"][\"old\"] = \"2025-12-01T00:00:00Z\"\n        snapshot.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"session_dates commitment is stale\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_rejects_product_query_override(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(labels.read_text())\n        payload[\"items\"][0][\"query_text\"] = \"hand tuned\"\n        labels.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"derive exactly from task prompt\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_requires_retained_evidence_path_and_hash(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(labels.read_text())\n        del payload[\"items\"][0][\"label_evidence\"][\"source_path\"]\n        labels.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"label_evidence source path is missing\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_rejects_mismatched_retained_evidence_bytes(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        (repo / \"review-ledger.json\").write_text(\"changed bytes\\n\")\n        with self.assertRaisesRegex(relevance.DatasetError, \"retained source hash differs\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_cannot_have_eligible_positive(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(labels.read_text())\n        payload[\"items\"][2][\"judgments\"][0][\"grade\"] = \"solving\"\n        labels.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"null query has eligible positive\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_requires_exhaustive_active_corpus_closure(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(labels.read_text())\n        del payload[\"items\"][2][\"null_review\"]\n        labels.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"requires exact retained review evidence\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_rejects_partial_corpus_review(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        runtime[\"null_review_ledger\"][\"items\"][0][\"decisions\"].pop()\n        with self.assertRaisesRegex(relevance.DatasetError, \"does not exactly cover\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_rejects_duplicate_or_wrong_hash_review_rows(self):\n        for attack in (\"duplicate\", \"wrong_hash\"):\n            with self.subTest(attack=attack):\n                temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n                self.addCleanup(temporary.cleanup)\n                decisions = runtime[\"null_review_ledger\"][\"items\"][0][\"decisions\"]\n                if attack == \"duplicate\":\n                    decisions.append(copy.deepcopy(decisions[0]))\n                    expected = \"missing or duplicated\"\n                else:\n                    decisions[0][\"fact_sha256\"] = \"f\" * 64\n                    expected = \"differs from membership\"\n                with self.assertRaisesRegex(relevance.DatasetError, expected):\n                    relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_rejects_positive_exhaustive_decision(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        runtime[\"null_review_ledger\"][\"items\"][0][\"decisions\"][0][\"grade\"] = \"relevant_alternative\"\n        with self.assertRaisesRegex(relevance.DatasetError, \"contains positive facts\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_rejects_temporal_membership_or_cutoff_laundering(self):\n        for attack in (\"provenance\", \"date\"):\n            with self.subTest(attack=attack):\n                temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n                self.addCleanup(temporary.cleanup)\n                membership = runtime[\"source_membership\"]\n                if attack == \"provenance\":\n                    membership[\"facts\"][0][\"provenance_session_ids\"] = []\n                else:\n                    membership[\"session_dates\"][\"old\"] = \"2026-02-01T00:00:00Z\"\n                with self.assertRaisesRegex(relevance.DatasetError, \"does not exactly cover\"):\n                    relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_d9df_url_fetch_advice_is_not_labeled_solving(self):\n        labels = relevance.load_json(HERE / \"offline-relevance-development-labels.json\")\n        item = next(row for row in labels[\"items\"] if row[\"task_id\"] == \"entire-cli-c0701-d9df8fcca\")\n        grades = {judgment[\"fact_id\"]: judgment[\"grade\"] for judgment in item[\"judgments\"]}\n        self.assertEqual(grades[\"fact:8325ce8c7c9c08ba273c812f\"], \"hard_topical_distractor\")\n        self.assertEqual(grades[\"fact:11af406c1bcd1c4994261a6c\"], \"relevant_alternative\")\n\n    def test_checked_in_dataset_rebuilds_and_keeps_holdout_unopened(self):\n        labels = HERE / \"offline-relevance-development-labels.json\"\n        inventory = HERE / \"task-inventory.json\"\n        snapshot = HERE / \"offline-relevance-fact-snapshot.json\"\n        dataset = HERE / \"offline-relevance-dataset.json\"\n        membership = relevance.load_json(HERE / \"offline-relevance-source-membership.json\")\n        null_ledger_path = HERE / \"offline-relevance-null-review-ledger.json\"\n        null_ledger = relevance.load_json(null_ledger_path)\n        expected = relevance.materialize(\n            REPO,\n            labels,\n            inventory,\n            snapshot,\n            source_membership=membership,\n            null_review_ledger=null_ledger,\n            null_review_ledger_path=null_ledger_path.relative_to(REPO).as_posix(),\n            null_review_ledger_sha256=relevance.sha256_bytes(null_ledger_path.read_bytes()),\n        )\n        actual = relevance.load_json(dataset)\n        relevance.validate_dataset(actual, expected)\n        self.assertEqual(actual[\"development\"][\"item_count\"], 14)\n        self.assertEqual(actual[\"development\"][\"unique_task_count\"], 13)\n        self.assertEqual(actual[\"development\"][\"null_query_count\"], 1)\n        self.assertEqual(actual[\"development\"][\"unique_answerable_product_task_count\"], 12)\n        self.assertEqual(actual[\"development\"][\"product_null_query_count\"], 1)\n        self.assertEqual(actual[\"development\"][\"judgment_count\"], 46)\n        null_item = next(\n            item for item in actual[\"development\"][\"items\"]\n            if item[\"query_id\"] == \"dev-product-b72a6e621\"\n        )\n        self.assertEqual(null_item[\"null_closure\"][\"reviewed_fact_count\"], 2531)\n        self.assertEqual(null_item[\"null_closure\"][\"positive_fact_count\"], 0)\n        decisions = null_ledger[\"items\"][0][\"decisions\"]\n        self.assertEqual(sum(row[\"grade\"] == \"hard_topical_distractor\" for row in decisions), 4)\n        self.assertEqual(sum(row[\"grade\"] == \"irrelevant\" for row in decisions), 2527)\n        schema_errors = relevance.validate_relevance_schemas(\n            relevance.load_json(labels),\n            relevance.load_json(snapshot),\n            actual,\n            HERE / \"schemas\",\n        )\n        self.assertEqual(schema_errors, [])\n        self.assertEqual(actual[\"sealed_holdout\"][\"items\"], [])\n\n    def test_complete_membership_rejects_fabricated_fact_and_date(self):\n        labels = relevance.load_json(HERE / \"offline-relevance-development-labels.json\")\n        snapshot = relevance.load_json(HERE / \"offline-relevance-fact-snapshot.json\")\n        contract = relevance.load_json(HERE / \"relevance-source-contract.json\")\n        membership_path = HERE / \"offline-relevance-source-membership.json\"\n        membership = relevance.load_json(membership_path)\n        fabricated = copy.deepcopy(snapshot)\n        fabricated[\"facts\"][0][\"text\"] += \" Fabricated.\"\n        session_id = next(iter(fabricated[\"session_dates\"]))\n        fabricated[\"session_dates\"][session_id] = \"2020-01-01T00:00:00Z\"\n        with self.assertRaisesRegex(\n            relevance.DatasetError,\n            \"snapshot fact differs from reviewed full-source membership\",\n        ):\n            relevance.validate_source_membership(\n                labels,\n                fabricated,\n                contract,\n                membership,\n                membership_sha256=relevance.sha256_bytes(membership_path.read_bytes()),\n            )\n        date_only = copy.deepcopy(snapshot)\n        date_only[\"session_dates\"][session_id] = \"2020-01-01T00:00:00Z\"\n        with self.assertRaisesRegex(\n            relevance.DatasetError,\n            \"snapshot session date differs from reviewed full-source membership\",\n        ):\n            relevance.validate_source_membership(\n                labels,\n                date_only,\n                contract,\n                membership,\n                membership_sha256=relevance.sha256_bytes(membership_path.read_bytes()),\n            )\n\n    def test_review_ledger_is_exact_per_query_and_judgment(self):\n        labels = relevance.load_json(HERE / \"offline-relevance-development-labels.json\")\n        contract = relevance.load_json(HERE / \"relevance-source-contract.json\")\n        ledger_path = HERE / \"offline-relevance-review-ledger.json\"\n        ledger = relevance.load_json(ledger_path)\n        ledger[\"items\"][0][\"judgments\"][0][\"grade\"] = \"irrelevant\"\n        with self.assertRaisesRegex(relevance.DatasetError, \"ledger judgments differ from labels\"):\n            relevance.validate_review_ledger(\n                labels,\n                ledger,\n                contract,\n                ledger_path=\"benchmarks/agent-brain/confirmatory/offline-relevance-review-ledger.json\",\n                ledger_sha256=relevance.sha256_bytes(ledger_path.read_bytes()),\n            )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"duration":{"secs":0,"nanos":2917},"formatted_output":"import copy\nimport importlib.util\nimport json\nimport pathlib\nimport tempfile\nimport unittest\n\n\nMODULE_PATH = pathlib.Path(__file__).with_name(\"relevance_dataset.py\")\nSPEC = importlib.util.spec_from_file_location(\"relevance_dataset\", MODULE_PATH)\nrelevance = importlib.util.module_from_spec(SPEC)\nassert SPEC.loader is not None\nSPEC.loader.exec_module(relevance)\n\n\nHERE = pathlib.Path(__file__).parent\nREPO = HERE.parents[2]\n\n\nclass RelevanceDatasetTests(unittest.TestCase):\n    @staticmethod\n    def _refresh_snapshot_commitment(labels_path, snapshot_path, *, refresh_judgment_hashes=False):\n        labels = json.loads(labels_path.read_text())\n        snapshot = json.loads(snapshot_path.read_text())\n        snapshot[\"fact_count\"] = len(snapshot[\"facts\"])\n        snapshot[\"facts_sha256\"] = relevance.sha256_bytes(relevance.canonical_json(snapshot[\"facts\"]))\n        snapshot[\"session_date_count\"] = len(snapshot[\"session_dates\"])\n        snapshot[\"session_dates_sha256\"] = relevance.sha256_bytes(\n            relevance.canonical_json(snapshot[\"session_dates\"])\n        )\n        labels[\"snapshot_commitment\"] = relevance._snapshot_commitment(snapshot)\n        if refresh_judgment_hashes:\n            fact_index = {fact[\"id\"]: fact for fact in snapshot[\"facts\"]}\n            for item in labels[\"items\"]:\n                for judgment in item[\"judgments\"]:\n                    judgment[\"fact_sha256\"] = relevance.fact_sha256(fact_index[judgment[\"fact_id\"]])\n        labels_path.write_text(json.dumps(labels))\n        snapshot_path.write_text(json.dumps(snapshot))\n\n    def _fixture(self):\n        temporary = tempfile.TemporaryDirectory()\n        repo = pathlib.Path(temporary.name)\n        (repo / \"tasks\").mkdir()\n        config = {\n            \"id\": \"task-one\",\n            \"prompt\": \"Fix the cumulative cache accounting.\",\n            \"rolling_cutoff_rfc3339\": \"2026-02-01T00:00:00Z\",\n            \"exclude_session_ids\": [],\n        }\n        config_path = repo / \"tasks\" / \"task-one.json\"\n        config_path.write_text(json.dumps(config))\n        null_config = {\n            \"id\": \"task-null\",\n            \"prompt\": \"No answer exists for this exposed product task.\",\n            \"rolling_cutoff_rfc3339\": \"2026-02-01T00:00:00Z\",\n            \"exclude_session_ids\": [],\n        }\n        null_config_path = repo / \"tasks\" / \"task-null.json\"\n        null_config_path.write_text(json.dumps(null_config))\n        inventory = {\n            \"tasks\": [{\n                \"task_id\": \"task-one\",\n                \"assigned_split\": \"development\",\n                \"state\": \"agent_run\",\n                \"artifacts\": {\n                    \"config_path\": \"tasks/task-one.json\",\n                    \"config_sha256\": relevance.sha256_bytes(config_path.read_bytes()),\n                    \"prompt_sha256\": relevance.sha256_text(config[\"prompt\"]),\n                },\n            }, {\n                \"task_id\": \"task-null\",\n                \"assigned_split\": \"development\",\n                \"state\": \"prompt_inspected\",\n                \"artifacts\": {\n                    \"config_path\": \"tasks/task-null.json\",\n                    \"config_sha256\": relevance.sha256_bytes(null_config_path.read_bytes()),\n                    \"prompt_sha256\": relevance.sha256_text(null_config[\"prompt\"]),\n                },\n            }],\n        }\n        inventory_path = repo / \"inventory.json\"\n        inventory_path.write_text(json.dumps(inventory))\n        facts = [\n            {\"id\": \"fact:positive\", \"kind\": \"decision\", \"status\": \"active\", \"text\": \"Accumulate cache usage.\",\n             \"provenance\": [{\"session_id\": \"old\"}]},\n            {\"id\": \"fact:distractor\", \"kind\": \"gotcha\", \"status\": \"active\", \"text\": \"Cache is inclusive elsewhere.\",\n             \"provenance\": [{\"session_id\": \"old\"}]},\n            {\"id\": \"fact:irrelevant\", \"kind\": \"decision\", \"status\": \"active\", \"text\": \"Use another API.\",\n             \"provenance\": [{\"session_id\": \"old\"}]},\n        ]\n        session_dates = {\"old\": \"2026-01-01T00:00:00Z\"}\n        active_catalog_hash = relevance.fact_catalog_sha256(facts)\n        snapshot = {\n            \"schema_version\": relevance.SCHEMA_VERSION,\n            \"source_facts_sha256\": \"a\" * 64,\n            \"source_session_dates_sha256\": \"b\" * 64,\n            \"source_active_fact_count\": len(facts),\n            \"source_active_fact_catalog_sha256\": active_catalog_hash,\n            \"fact_count\": len(facts),\n            \"facts_sha256\": relevance.sha256_bytes(relevance.canonical_json(facts)),\n            \"facts\": facts,\n            \"session_date_count\": len(session_dates),\n            \"session_dates_sha256\": relevance.sha256_bytes(relevance.canonical_json(session_dates)),\n            \"session_dates\": session_dates,\n        }\n        snapshot_path = repo / \"snapshot.json\"\n        snapshot_path.write_text(json.dumps(snapshot))\n        review_ledger_path = repo / \"review-ledger.json\"\n        review_ledger_path.write_text(\"fixture retained review bytes\\n\")\n        evidence = {\n            \"type\": \"manual_frozen_corpus_review\",\n            \"source_id\": \"review-ledger.json#fixture\",\n            \"source_path\": \"review-ledger.json\",\n            \"source_sha256\": relevance.sha256_bytes(review_ledger_path.read_bytes()),\n            \"rationale\": \"Reviewed the fixture.\",\n        }\n        labels = {\n            \"schema_version\": relevance.SCHEMA_VERSION,\n            \"dataset_id\": \"fixture\",\n            \"label_set_id\": \"fixture-v2\",\n            \"created_at\": \"2026-02-02T00:00:00Z\",\n            \"source_corpus\": {\n                \"facts_sha256\": \"a\" * 64,\n                \"session_dates_sha256\": \"b\" * 64,\n                \"active_fact_count\": len(facts),\n                \"active_fact_catalog_sha256\": active_catalog_hash,\n            },\n            \"snapshot_commitment\": relevance._snapshot_commitment(snapshot),\n            \"allowed_inventory_states\": list(relevance.SAFE_STATES),\n            \"items\": [\n                {\n                    \"query_id\": \"product\",\n                    \"task_id\": \"task-one\",\n                    \"query_source\": \"user_prompt_derived\",\n                    \"null_query\": False,\n                    \"label_evidence\": evidence,\n                    \"judgments\": [\n                        {\"fact_id\": \"fact:positive\", \"grade\": \"solving\", \"cluster_id\": \"positive\", \"rationale\": \"Direct.\"},\n                        {\"fact_id\": \"fact:distractor\", \"grade\": \"hard_topical_distractor\", \"cluster_id\": \"distractor\", \"rationale\": \"Wrong format.\"},\n                        {\"fact_id\": \"fact:irrelevant\", \"grade\": \"irrelevant\", \"cluster_id\": \"irrelevant\", \"rationale\": \"Unrelated.\"},\n                    ],\n                },\n                {\n                    \"query_id\": \"oracle\",\n                    \"task_id\": \"task-one\",\n                    \"query_source\": \"oracle_upper_bound\",\n                    \"query_text\": \"Which cache usage should accumulate?\",\n                    \"null_query\": False,\n                    \"label_evidence\": evidence,\n                    \"judgments\": [\n                        {\"fact_id\": \"fact:positive\", \"grade\": \"relevant_alternative\", \"cluster_id\": \"positive\", \"rationale\": \"Useful.\"},\n                        {\"fact_id\": \"fact:distractor\", \"grade\": \"hard_topical_distractor\", \"cluster_id\": \"distractor\", \"rationale\": \"Wrong format.\"},\n                    ],\n                },\n                {\n                    \"query_id\": \"null\",\n                    \"task_id\": \"task-null\",\n                    \"query_source\": \"user_prompt_derived\",\n                    \"null_query\": True,\n                    \"label_evidence\": evidence,\n                    \"judgments\": [\n                        {\"fact_id\": \"fact:distractor\", \"grade\": \"hard_topical_distractor\", \"cluster_id\": \"distractor\", \"rationale\": \"Topical only.\"},\n                    ],\n                },\n            ],\n        }\n        fact_index = {fact[\"id\"]: fact for fact in facts}\n        for item in labels[\"items\"]:\n            for judgment in item[\"judgments\"]:\n                judgment[\"fact_sha256\"] = relevance.fact_sha256(fact_index[judgment[\"fact_id\"]])\n        null_item = labels[\"items\"][2]\n        membership = relevance.build_source_membership(facts, session_dates, \"a\" * 64, \"b\" * 64)\n        null_ledger = {\n            \"schema_version\": 1,\n            \"ledger_id\": \"fixture-null-review\",\n            \"items\": [{\n                \"query_id\": \"null\",\n                \"task_id\": \"task-null\",\n                \"query_sha256\": relevance.sha256_text(null_config[\"prompt\"]),\n                \"temporal_policy_sha256\": relevance.temporal_policy_sha256(\n                    null_config[\"rolling_cutoff_rfc3339\"], null_config[\"exclude_session_ids\"]\n                ),\n                \"reviewed_at\": \"2026-02-02T00:00:00Z\",\n                \"reviewer\": \"fixture-reviewer\",\n                \"method\": relevance.NULL_CLOSURE_METHOD,\n                \"source_facts_sha256\": \"a\" * 64,\n                \"source_session_dates_sha256\": \"b\" * 64,\n                \"eligibility_membership_root_sha256\": membership[\"eligibility_membership_root_sha256\"],\n                \"reviewer_assertion\": \"Every derived active+eligible fixture fact was reviewed.\",\n                \"decisions\": [\n                    {\"fact_id\": \"fact:positive\", \"fact_sha256\": relevance.fact_sha256(facts[0]), \"grade\": \"irrelevant\"},\n                    {\"fact_id\": \"fact:distractor\", \"fact_sha256\": relevance.fact_sha256(facts[1]), \"grade\": \"hard_topical_distractor\"},\n                    {\"fact_id\": \"fact:irrelevant\", \"fact_sha256\": relevance.fact_sha256(facts[2]), \"grade\": \"irrelevant\"},\n                ],\n            }],\n        }\n        null_ledger_path = repo / \"null-review-ledger.json\"\n        null_ledger_path.write_text(json.dumps(null_ledger))\n        null_item[\"null_review\"] = {\n            \"source_id\": \"null-review-ledger.json#null\",\n            \"source_path\": \"null-review-ledger.json\",\n            \"source_sha256\": relevance.sha256_bytes(null_ledger_path.read_bytes()),\n        }\n        labels_path = repo / \"labels.json\"\n        labels_path.write_text(json.dumps(labels))\n        runtime = {\n            \"source_membership\": membership,\n            \"null_review_ledger\": null_ledger,\n            \"null_review_ledger_path\": \"null-review-ledger.json\",\n            \"null_review_ledger_sha256\": relevance.sha256_bytes(null_ledger_path.read_bytes()),\n        }\n        return temporary, repo, labels_path, inventory_path, snapshot_path, runtime\n\n    def test_canonical_fact_hash_ignores_object_key_order(self):\n        left = {\"id\": \"fact:x\", \"text\": \"value\"}\n        right = {\"text\": \"value\", \"id\": \"fact:x\"}\n        self.assertEqual(relevance.fact_sha256(left), relevance.fact_sha256(right))\n\n    def test_materialize_derives_hashes_and_temporal_eligibility(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        result = relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n        self.assertEqual(result[\"development\"][\"item_count\"], 3)\n        self.assertEqual(result[\"development\"][\"unique_task_count\"], 2)\n        self.assertEqual(result[\"development\"][\"unique_answerable_product_task_count\"], 1)\n        self.assertEqual(result[\"development\"][\"product_null_query_count\"], 1)\n        product = result[\"development\"][\"items\"][0]\n        self.assertEqual(product[\"query_sha256\"], relevance.sha256_text(product[\"query_text\"]))\n        self.assertTrue(product[\"judgments\"][0][\"eligible\"])\n        self.assertRegex(product[\"judgments\"][0][\"fact_sha256\"], r\"^[0-9a-f]{64}$\")\n\n    def test_materialize_rejects_unexposed_or_nondevelopment_task(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(inventory.read_text())\n        payload[\"tasks\"][0][\"state\"] = \"unseen\"\n        inventory.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"not exposed development\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_rejects_stale_inventory_config_hash(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        (repo / \"tasks\" / \"task-one.json\").write_text(\"{}\")\n        with self.assertRaisesRegex(relevance.DatasetError, \"config hash differs\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_does_not_read_unselected_unseen_config(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(inventory.read_text())\n        payload[\"tasks\"].append({\n            \"task_id\": \"sealed-task\",\n            \"assigned_split\": \"confirmatory\",\n            \"state\": \"unseen\",\n            \"artifacts\": {\n                \"config_path\": \"tasks/must-not-be-read.json\",\n                \"config_sha256\": \"c\" * 64,\n                \"prompt_sha256\": \"d\" * 64,\n            },\n        })\n        inventory.write_text(json.dumps(payload))\n        result = relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n        self.assertEqual(result[\"development\"][\"unique_task_count\"], 2)\n\n    def test_materialize_rejects_positive_fact_at_or_after_cutoff(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(snapshot.read_text())\n        payload[\"session_dates\"][\"old\"] = \"2026-02-01T00:00:00Z\"\n        snapshot.write_text(json.dumps(payload))\n        self._refresh_snapshot_commitment(labels, snapshot)\n        with self.assertRaisesRegex(relevance.DatasetError, \"answerable query has no eligible positive\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_rejects_superseded_fact(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(snapshot.read_text())\n        payload[\"facts\"][0][\"status\"] = \"superseded\"\n        snapshot.write_text(json.dumps(payload))\n        self._refresh_snapshot_commitment(labels, snapshot, refresh_judgment_hashes=True)\n        with self.assertRaisesRegex(relevance.DatasetError, \"only active facts may be judged\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_rejects_snapshot_fact_tampering_after_commitment_refresh(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(snapshot.read_text())\n        payload[\"facts\"][0][\"text\"] = \"Tampered reviewed fact text.\"\n        snapshot.write_text(json.dumps(payload))\n        self._refresh_snapshot_commitment(labels, snapshot)\n        with self.assertRaisesRegex(relevance.DatasetError, \"snapshot fact differs from reviewed fact hash\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_full_source_recheck_rejects_mutated_active_catalog(self):\n        temporary, _repo, labels, _inventory, snapshot, _runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        label_payload = json.loads(labels.read_text())\n        snapshot_payload = json.loads(snapshot.read_text())\n        snapshot_payload[\"facts\"][0][\"text\"] = \"Mutated full-source fact.\"\n        with self.assertRaisesRegex(relevance.DatasetError, \"active full-corpus fact catalog hash\"):\n            relevance.build_snapshot(\n                label_payload,\n                snapshot_payload[\"facts\"],\n                snapshot_payload[\"session_dates\"],\n                \"a\" * 64,\n                \"b\" * 64,\n            )\n\n    def test_materialize_rejects_snapshot_date_without_reviewed_commitment(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(snapshot.read_text())\n        payload[\"session_dates\"][\"old\"] = \"2025-12-01T00:00:00Z\"\n        snapshot.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"session_dates commitment is stale\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_rejects_product_query_override(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(labels.read_text())\n        payload[\"items\"][0][\"query_text\"] = \"hand tuned\"\n        labels.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"derive exactly from task prompt\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_requires_retained_evidence_path_and_hash(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(labels.read_text())\n        del payload[\"items\"][0][\"label_evidence\"][\"source_path\"]\n        labels.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"label_evidence source path is missing\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_materialize_rejects_mismatched_retained_evidence_bytes(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        (repo / \"review-ledger.json\").write_text(\"changed bytes\\n\")\n        with self.assertRaisesRegex(relevance.DatasetError, \"retained source hash differs\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_cannot_have_eligible_positive(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(labels.read_text())\n        payload[\"items\"][2][\"judgments\"][0][\"grade\"] = \"solving\"\n        labels.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"null query has eligible positive\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_requires_exhaustive_active_corpus_closure(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        payload = json.loads(labels.read_text())\n        del payload[\"items\"][2][\"null_review\"]\n        labels.write_text(json.dumps(payload))\n        with self.assertRaisesRegex(relevance.DatasetError, \"requires exact retained review evidence\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_rejects_partial_corpus_review(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        runtime[\"null_review_ledger\"][\"items\"][0][\"decisions\"].pop()\n        with self.assertRaisesRegex(relevance.DatasetError, \"does not exactly cover\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_rejects_duplicate_or_wrong_hash_review_rows(self):\n        for attack in (\"duplicate\", \"wrong_hash\"):\n            with self.subTest(attack=attack):\n                temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n                self.addCleanup(temporary.cleanup)\n                decisions = runtime[\"null_review_ledger\"][\"items\"][0][\"decisions\"]\n                if attack == \"duplicate\":\n                    decisions.append(copy.deepcopy(decisions[0]))\n                    expected = \"missing or duplicated\"\n                else:\n                    decisions[0][\"fact_sha256\"] = \"f\" * 64\n                    expected = \"differs from membership\"\n                with self.assertRaisesRegex(relevance.DatasetError, expected):\n                    relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_rejects_positive_exhaustive_decision(self):\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n        self.addCleanup(temporary.cleanup)\n        runtime[\"null_review_ledger\"][\"items\"][0][\"decisions\"][0][\"grade\"] = \"relevant_alternative\"\n        with self.assertRaisesRegex(relevance.DatasetError, \"contains positive facts\"):\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_null_query_rejects_temporal_membership_or_cutoff_laundering(self):\n        for attack in (\"provenance\", \"date\"):\n            with self.subTest(attack=attack):\n                temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\n                self.addCleanup(temporary.cleanup)\n                membership = runtime[\"source_membership\"]\n                if attack == \"provenance\":\n                    membership[\"facts\"][0][\"provenance_session_ids\"] = []\n                else:\n                    membership[\"session_dates\"][\"old\"] = \"2026-02-01T00:00:00Z\"\n                with self.assertRaisesRegex(relevance.DatasetError, \"does not exactly cover\"):\n                    relevance.materialize(repo, labels, inventory, snapshot, **runtime)\n\n    def test_d9df_url_fetch_advice_is_not_labeled_solving(self):\n        labels = relevance.load_json(HERE / \"offline-relevance-development-labels.json\")\n        item = next(row for row in labels[\"items\"] if row[\"task_id\"] == \"entire-cli-c0701-d9df8fcca\")\n        grades = {judgment[\"fact_id\"]: judgment[\"grade\"] for judgment in item[\"judgments\"]}\n        self.assertEqual(grades[\"fact:8325ce8c7c9c08ba273c812f\"], \"hard_topical_distractor\")\n        self.assertEqual(grades[\"fact:11af406c1bcd1c4994261a6c\"], \"relevant_alternative\")\n\n    def test_checked_in_dataset_rebuilds_and_keeps_holdout_unopened(self):\n        labels = HERE / \"offline-relevance-development-labels.json\"\n        inventory = HERE / \"task-inventory.json\"\n        snapshot = HERE / \"offline-relevance-fact-snapshot.json\"\n        dataset = HERE / \"offline-relevance-dataset.json\"\n        membership = relevance.load_json(HERE / \"offline-relevance-source-membership.json\")\n        null_ledger_path = HERE / \"offline-relevance-null-review-ledger.json\"\n        null_ledger = relevance.load_json(null_ledger_path)\n        expected = relevance.materialize(\n            REPO,\n            labels,\n            inventory,\n            snapshot,\n            source_membership=membership,\n            null_review_ledger=null_ledger,\n            null_review_ledger_path=null_ledger_path.relative_to(REPO).as_posix(),\n            null_review_ledger_sha256=relevance.sha256_bytes(null_ledger_path.read_bytes()),\n        )\n        actual = relevance.load_json(dataset)\n        relevance.validate_dataset(actual, expected)\n        self.assertEqual(actual[\"development\"][\"item_count\"], 14)\n        self.assertEqual(actual[\"development\"][\"unique_task_count\"], 13)\n        self.assertEqual(actual[\"development\"][\"null_query_count\"], 1)\n        self.assertEqual(actual[\"development\"][\"unique_answerable_product_task_count\"], 12)\n        self.assertEqual(actual[\"development\"][\"product_null_query_count\"], 1)\n        self.assertEqual(actual[\"development\"][\"judgment_count\"], 46)\n        null_item = next(\n            item for item in actual[\"development\"][\"items\"]\n            if item[\"query_id\"] == \"dev-product-b72a6e621\"\n        )\n        self.assertEqual(null_item[\"null_closure\"][\"reviewed_fact_count\"], 2531)\n        self.assertEqual(null_item[\"null_closure\"][\"positive_fact_count\"], 0)\n        decisions = null_ledger[\"items\"][0][\"decisions\"]\n        self.assertEqual(sum(row[\"grade\"] == \"hard_topical_distractor\" for row in decisions), 4)\n        self.assertEqual(sum(row[\"grade\"] == \"irrelevant\" for row in decisions), 2527)\n        schema_errors = relevance.validate_relevance_schemas(\n            relevance.load_json(labels),\n            relevance.load_json(snapshot),\n            actual,\n            HERE / \"schemas\",\n        )\n        self.assertEqual(schema_errors, [])\n        self.assertEqual(actual[\"sealed_holdout\"][\"items\"], [])\n\n    def test_complete_membership_rejects_fabricated_fact_and_date(self):\n        labels = relevance.load_json(HERE / \"offline-relevance-development-labels.json\")\n        snapshot = relevance.load_json(HERE / \"offline-relevance-fact-snapshot.json\")\n        contract = relevance.load_json(HERE / \"relevance-source-contract.json\")\n        membership_path = HERE / \"offline-relevance-source-membership.json\"\n        membership = relevance.load_json(membership_path)\n        fabricated = copy.deepcopy(snapshot)\n        fabricated[\"facts\"][0][\"text\"] += \" Fabricated.\"\n        session_id = next(iter(fabricated[\"session_dates\"]))\n        fabricated[\"session_dates\"][session_id] = \"2020-01-01T00:00:00Z\"\n        with self.assertRaisesRegex(\n            relevance.DatasetError,\n            \"snapshot fact differs from reviewed full-source membership\",\n        ):\n            relevance.validate_source_membership(\n                labels,\n                fabricated,\n                contract,\n                membership,\n                membership_sha256=relevance.sha256_bytes(membership_path.read_bytes()),\n            )\n        date_only = copy.deepcopy(snapshot)\n        date_only[\"session_dates\"][session_id] = \"2020-01-01T00:00:00Z\"\n        with self.assertRaisesRegex(\n            relevance.DatasetError,\n            \"snapshot session date differs from reviewed full-source membership\",\n        ):\n            relevance.validate_source_membership(\n                labels,\n                date_only,\n                contract,\n                membership,\n                membership_sha256=relevance.sha256_bytes(membership_path.read_bytes()),\n            )\n\n    def test_review_ledger_is_exact_per_query_and_judgment(self):\n        labels = relevance.load_json(HERE / \"offline-relevance-development-labels.json\")\n        contract = relevance.load_json(HERE / \"relevance-source-contract.json\")\n        ledger_path = HERE / \"offline-relevance-review-ledger.json\"\n        ledger = relevance.load_json(ledger_path)\n        ledger[\"items\"][0][\"judgments\"][0][\"grade\"] = \"irrelevant\"\n        with self.assertRaisesRegex(relevance.DatasetError, \"ledger judgments differ from labels\"):\n            relevance.validate_review_ledger(\n                labels,\n                ledger,\n                contract,\n                ledger_path=\"benchmarks/agent-brain/confirmatory/offline-relevance-review-ledger.json\",\n                ledger_sha256=relevance.sha256_bytes(ledger_path.read_bytes()),\n            )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"},"started_at_ms":1789839553134,"completed_at_ms":1789839553134}}
{"timestamp":"2026-09-19T17:39:13.191Z","ordinal":7506,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0bac0-32a7-7700-beb8-464e0c1771db","call_id":"call_WKkj45aqZJ92TdN7rdxwWTsZ","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"98ca81\",\"wall_time_seconds\":0.000002917,\"exit_code\":0,\"original_token_count\":6722,\"output\":\"import copy\\nimport importlib.util\\nimport json\\nimport pathlib\\nimport tempfile\\nimport unittest\\n\\n\\nMODULE_PATH = pathlib.Path(__file__).with_name(\\\"relevance_dataset.py\\\")\\nSPEC = importlib.util.spec_from_file_location(\\\"relevance_dataset\\\", MODULE_PATH)\\nrelevance = importlib.util.module_from_spec(SPEC)\\nassert SPEC.loader is not None\\nSPEC.loader.exec_module(relevance)\\n\\n\\nHERE = pathlib.Path(__file__).parent\\nREPO = HERE.parents[2]\\n\\n\\nclass RelevanceDatasetTests(unittest.TestCase):\\n    @staticmethod\\n    def _refresh_snapshot_commitment(labels_path, snapshot_path, *, refresh_judgment_hashes=False):\\n        labels = json.loads(labels_path.read_text())\\n        snapshot = json.loads(snapshot_path.read_text())\\n        snapshot[\\\"fact_count\\\"] = len(snapshot[\\\"facts\\\"])\\n        snapshot[\\\"facts_sha256\\\"] = relevance.sha256_bytes(relevance.canonical_json(snapshot[\\\"facts\\\"]))\\n        snapshot[\\\"session_date_count\\\"] = len(snapshot[\\\"session_dates\\\"])\\n        snapshot[\\\"session_dates_sha256\\\"] = relevance.sha256_bytes(\\n            relevance.canonical_json(snapshot[\\\"session_dates\\\"])\\n        )\\n        labels[\\\"snapshot_commitment\\\"] = relevance._snapshot_commitment(snapshot)\\n        if refresh_judgment_hashes:\\n            fact_index = {fact[\\\"id\\\"]: fact for fact in snapshot[\\\"facts\\\"]}\\n            for item in labels[\\\"items\\\"]:\\n                for judgment in item[\\\"judgments\\\"]:\\n                    judgment[\\\"fact_sha256\\\"] = relevance.fact_sha256(fact_index[judgment[\\\"fact_id\\\"]])\\n        labels_path.write_text(json.dumps(labels))\\n        snapshot_path.write_text(json.dumps(snapshot))\\n\\n    def _fixture(self):\\n        temporary = tempfile.TemporaryDirectory()\\n        repo = pathlib.Path(temporary.name)\\n        (repo / \\\"tasks\\\").mkdir()\\n        config = {\\n            \\\"id\\\": \\\"task-one\\\",\\n            \\\"prompt\\\": \\\"Fix the cumulative cache accounting.\\\",\\n            \\\"rolling_cutoff_rfc3339\\\": \\\"2026-02-01T00:00:00Z\\\",\\n            \\\"exclude_session_ids\\\": [],\\n        }\\n        config_path = repo / \\\"tasks\\\" / \\\"task-one.json\\\"\\n        config_path.write_text(json.dumps(config))\\n        null_config = {\\n            \\\"id\\\": \\\"task-null\\\",\\n            \\\"prompt\\\": \\\"No answer exists for this exposed product task.\\\",\\n            \\\"rolling_cutoff_rfc3339\\\": \\\"2026-02-01T00:00:00Z\\\",\\n            \\\"exclude_session_ids\\\": [],\\n        }\\n        null_config_path = repo / \\\"tasks\\\" / \\\"task-null.json\\\"\\n        null_config_path.write_text(json.dumps(null_config))\\n        inventory = {\\n            \\\"tasks\\\": [{\\n                \\\"task_id\\\": \\\"task-one\\\",\\n                \\\"assigned_split\\\": \\\"development\\\",\\n                \\\"state\\\": \\\"agent_run\\\",\\n                \\\"artifacts\\\": {\\n                    \\\"config_path\\\": \\\"tasks/task-one.json\\\",\\n                    \\\"config_sha256\\\": relevance.sha256_bytes(config_path.read_bytes()),\\n                    \\\"prompt_sha256\\\": relevance.sha256_text(config[\\\"prompt\\\"]),\\n                },\\n            }, {\\n                \\\"task_id\\\": \\\"task-null\\\",\\n                \\\"assigned_split\\\": \\\"development\\\",\\n                \\\"state\\\": \\\"prompt_inspected\\\",\\n                \\\"artifacts\\\": {\\n                    \\\"config_path\\\": \\\"tasks/task-null.json\\\",\\n                    \\\"config_sha256\\\": relevance.sha256_bytes(null_config_path.read_bytes()),\\n                    \\\"prompt_sha256\\\": relevance.sha256_text(null_config[\\\"prompt\\\"]),\\n                },\\n            }],\\n        }\\n        inventory_path = repo / \\\"inventory.json\\\"\\n        inventory_path.write_text(json.dumps(inventory))\\n        facts = [\\n            {\\\"id\\\": \\\"fact:positive\\\", \\\"kind\\\": \\\"decision\\\", \\\"status\\\": \\\"active\\\", \\\"text\\\": \\\"Accumulate cache usage.\\\",\\n             \\\"provenance\\\": [{\\\"session_id\\\": \\\"old\\\"}]},\\n            {\\\"id\\\": \\\"fact:distractor\\\", \\\"kind\\\": \\\"gotcha\\\", \\\"status\\\": \\\"active\\\", \\\"text\\\": \\\"Cache is inclusive elsewhere.\\\",\\n             \\\"provenance\\\": [{\\\"session_id\\\": \\\"old\\\"}]},\\n            {\\\"id\\\": \\\"fact:irrelevant\\\", \\\"kind\\\": \\\"decision\\\", \\\"status\\\": \\\"active\\\", \\\"text\\\": \\\"Use another API.\\\",\\n             \\\"provenance\\\": [{\\\"session_id\\\": \\\"old\\\"}]},\\n        ]\\n        session_dates = {\\\"old\\\": \\\"2026-01-01T00:00:00Z\\\"}\\n        active_catalog_hash = relevance.fact_catalog_sha256(facts)\\n        snapshot = {\\n            \\\"schema_version\\\": relevance.SCHEMA_VERSION,\\n            \\\"source_facts_sha256\\\": \\\"a\\\" * 64,\\n            \\\"source_session_dates_sha256\\\": \\\"b\\\" * 64,\\n            \\\"source_active_fact_count\\\": len(facts),\\n            \\\"source_active_fact_catalog_sha256\\\": active_catalog_hash,\\n            \\\"fact_count\\\": len(facts),\\n            \\\"facts_sha256\\\": relevance.sha256_bytes(relevance.canonical_json(facts)),\\n            \\\"facts\\\": facts,\\n            \\\"session_date_count\\\": len(session_dates),\\n            \\\"session_dates_sha256\\\": relevance.sha256_bytes(relevance.canonical_json(session_dates)),\\n            \\\"session_dates\\\": session_dates,\\n        }\\n        snapshot_path = repo / \\\"snapshot.json\\\"\\n        snapshot_path.write_text(json.dumps(snapshot))\\n        review_ledger_path = repo / \\\"review-ledger.json\\\"\\n        review_ledger_path.write_text(\\\"fixture retained review bytes\\\\n\\\")\\n        evidence = {\\n            \\\"type\\\": \\\"manual_frozen_corpus_review\\\",\\n            \\\"source_id\\\": \\\"review-ledger.json#fixture\\\",\\n            \\\"source_path\\\": \\\"review-ledger.json\\\",\\n            \\\"source_sha256\\\": relevance.sha256_bytes(review_ledger_path.read_bytes()),\\n            \\\"rationale\\\": \\\"Reviewed the fixture.\\\",\\n        }\\n        labels = {\\n            \\\"schema_version\\\": relevance.SCHEMA_VERSION,\\n            \\\"dataset_id\\\": \\\"fixture\\\",\\n            \\\"label_set_id\\\": \\\"fixture-v2\\\",\\n            \\\"created_at\\\": \\\"2026-02-02T00:00:00Z\\\",\\n            \\\"source_corpus\\\": {\\n                \\\"facts_sha256\\\": \\\"a\\\" * 64,\\n                \\\"session_dates_sha256\\\": \\\"b\\\" * 64,\\n                \\\"active_fact_count\\\": len(facts),\\n                \\\"active_fact_catalog_sha256\\\": active_catalog_hash,\\n            },\\n            \\\"snapshot_commitment\\\": relevance._snapshot_commitment(snapshot),\\n            \\\"allowed_inventory_states\\\": list(relevance.SAFE_STATES),\\n            \\\"items\\\": [\\n                {\\n                    \\\"query_id\\\": \\\"product\\\",\\n                    \\\"task_id\\\": \\\"task-one\\\",\\n                    \\\"query_source\\\": \\\"user_prompt_derived\\\",\\n                    \\\"null_query\\\": False,\\n                    \\\"label_evidence\\\": evidence,\\n                    \\\"judgments\\\": [\\n                        {\\\"fact_id\\\": \\\"fact:positive\\\", \\\"grade\\\": \\\"solving\\\", \\\"cluster_id\\\": \\\"positive\\\", \\\"rationale\\\": \\\"Direct.\\\"},\\n                        {\\\"fact_id\\\": \\\"fact:distractor\\\", \\\"grade\\\": \\\"hard_topical_distractor\\\", \\\"cluster_id\\\": \\\"distractor\\\", \\\"rationale\\\": \\\"Wrong format.\\\"},\\n                        {\\\"fact_id\\\": \\\"fact:irrelevant\\\", \\\"grade\\\": \\\"irrelevant\\\", \\\"cluster_id\\\": \\\"irrelevant\\\", \\\"rationale\\\": \\\"Unrelated.\\\"},\\n                    ],\\n                },\\n                {\\n                    \\\"query_id\\\": \\\"oracle\\\",\\n                    \\\"task_id\\\": \\\"task-one\\\",\\n                    \\\"query_source\\\": \\\"oracle_upper_bound\\\",\\n                    \\\"query_text\\\": \\\"Which cache usage should accumulate?\\\",\\n                    \\\"null_query\\\": False,\\n                    \\\"label_evidence\\\": evidence,\\n                    \\\"judgments\\\": [\\n                        {\\\"fact_id\\\": \\\"fact:positive\\\", \\\"grade\\\": \\\"relevant_alternative\\\", \\\"cluster_id\\\": \\\"positive\\\", \\\"rationale\\\": \\\"Useful.\\\"},\\n                        {\\\"fact_id\\\": \\\"fact:distractor\\\", \\\"grade\\\": \\\"hard_topical_distractor\\\", \\\"cluster_id\\\": \\\"distractor\\\", \\\"rationale\\\": \\\"Wrong format.\\\"},\\n                    ],\\n                },\\n                {\\n                    \\\"query_id\\\": \\\"null\\\",\\n                    \\\"task_id\\\": \\\"task-null\\\",\\n                    \\\"query_source\\\": \\\"user_prompt_derived\\\",\\n                    \\\"null_query\\\": True,\\n                    \\\"label_evidence\\\": evidence,\\n                    \\\"judgments\\\": [\\n                        {\\\"fact_id\\\": \\\"fact:distractor\\\", \\\"grade\\\": \\\"hard_topical_distractor\\\", \\\"cluster_id\\\": \\\"distractor\\\", \\\"rationale\\\": \\\"Topical only.\\\"},\\n                    ],\\n                },\\n            ],\\n        }\\n        fact_index = {fact[\\\"id\\\"]: fact for fact in facts}\\n        for item in labels[\\\"items\\\"]:\\n            for judgment in item[\\\"judgments\\\"]:\\n                judgment[\\\"fact_sha256\\\"] = relevance.fact_sha256(fact_index[judgment[\\\"fact_id\\\"]])\\n        null_item = labels[\\\"items\\\"][2]\\n        membership = relevance.build_source_membership(facts, session_dates, \\\"a\\\" * 64, \\\"b\\\" * 64)\\n        null_ledger = {\\n            \\\"schema_version\\\": 1,\\n            \\\"ledger_id\\\": \\\"fixture-null-review\\\",\\n            \\\"items\\\": [{\\n                \\\"query_id\\\": \\\"null\\\",\\n                \\\"task_id\\\": \\\"task-null\\\",\\n                \\\"query_sha256\\\": relevance.sha256_text(null_config[\\\"prompt\\\"]),\\n                \\\"temporal_policy_sha256\\\": relevance.temporal_policy_sha256(\\n                    null_config[\\\"rolling_cutoff_rfc3339\\\"], null_config[\\\"exclude_session_ids\\\"]\\n                ),\\n                \\\"reviewed_at\\\": \\\"2026-02-02T00:00:00Z\\\",\\n                \\\"reviewer\\\": \\\"fixture-reviewer\\\",\\n                \\\"method\\\": relevance.NULL_CLOSURE_METHOD,\\n                \\\"source_facts_sha256\\\": \\\"a\\\" * 64,\\n                \\\"source_session_dates_sha256\\\": \\\"b\\\" * 64,\\n                \\\"eligibility_membership_root_sha256\\\": membership[\\\"eligibility_membership_root_sha256\\\"],\\n                \\\"reviewer_assertion\\\": \\\"Every derived active+eligible fixture fact was reviewed.\\\",\\n                \\\"decisions\\\": [\\n                    {\\\"fact_id\\\": \\\"fact:positive\\\", \\\"fact_sha256\\\": relevance.fact_sha256(facts[0]), \\\"grade\\\": \\\"irrelevant\\\"},\\n                    {\\\"fact_id\\\": \\\"fact:distractor\\\", \\\"fact_sha256\\\": relevance.fact_sha256(facts[1]), \\\"grade\\\": \\\"hard_topical_distractor\\\"},\\n                    {\\\"fact_id\\\": \\\"fact:irrelevant\\\", \\\"fact_sha256\\\": relevance.fact_sha256(facts[2]), \\\"grade\\\": \\\"irrelevant\\\"},\\n                ],\\n            }],\\n        }\\n        null_ledger_path = repo / \\\"null-review-ledger.json\\\"\\n        null_ledger_path.write_text(json.dumps(null_ledger))\\n        null_item[\\\"null_review\\\"] = {\\n            \\\"source_id\\\": \\\"null-review-ledger.json#null\\\",\\n            \\\"source_path\\\": \\\"null-review-ledger.json\\\",\\n            \\\"source_sha256\\\": relevance.sha256_bytes(null_ledger_path.read_bytes()),\\n        }\\n        labels_path = repo / \\\"labels.json\\\"\\n        labels_path.write_text(json.dumps(labels))\\n        runtime = {\\n            \\\"source_membership\\\": membership,\\n            \\\"null_review_ledger\\\": null_ledger,\\n            \\\"null_review_ledger_path\\\": \\\"null-review-ledger.json\\\",\\n            \\\"null_review_ledger_sha256\\\": relevance.sha256_bytes(null_ledger_path.read_bytes()),\\n        }\\n        return temporary, repo, labels_path, inventory_path, snapshot_path, runtime\\n\\n    def test_canonical_fact_hash_ignores_object_key_order(self):\\n        left = {\\\"id\\\": \\\"fact:x\\\", \\\"text\\\": \\\"value\\\"}\\n        right = {\\\"text\\\": \\\"value\\\", \\\"id\\\": \\\"fact:x\\\"}\\n        self.assertEqual(relevance.fact_sha256(left), relevance.fact_sha256(right))\\n\\n    def test_materialize_derives_hashes_and_temporal_eligibility(self):\\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n        self.addCleanup(temporary.cleanup)\\n        result = relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n        self.assertEqual(result[\\\"development\\\"][\\\"item_count\\\"], 3)\\n        self.assertEqual(result[\\\"development\\\"][\\\"unique_task_count\\\"], 2)\\n        self.assertEqual(result[\\\"development\\\"][\\\"unique_answerable_product_task_count\\\"], 1)\\n        self.assertEqual(result[\\\"development\\\"][\\\"product_null_query_count\\\"], 1)\\n        product = result[\\\"development\\\"][\\\"items\\\"][0]\\n        self.assertEqual(product[\\\"query_sha256\\\"], relevance.sha256_text(product[\\\"query_text\\\"]))\\n        self.assertTrue(product[\\\"judgments\\\"][0][\\\"eligible\\\"])\\n        self.assertRegex(product[\\\"judgments\\\"][0][\\\"fact_sha256\\\"], r\\\"^[0-9a-f]{64}$\\\")\\n\\n    def test_materialize_rejects_unexposed_or_nondevelopment_task(self):\\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n        self.addCleanup(temporary.cleanup)\\n        payload = json.loads(inventory.read_text())\\n        payload[\\\"tasks\\\"][0][\\\"state\\\"] = \\\"unseen\\\"\\n        inventory.write_text(json.dumps(payload))\\n        with self.assertRaisesRegex(relevance.DatasetError, \\\"not exposed development\\\"):\\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n\\n    def test_materialize_rejects_stale_inventory_config_hash(self):\\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n        self.addCleanup(temporary.cleanup)\\n        (repo / \\\"tasks\\\" / \\\"task-one.json\\\").write_text(\\\"{}\\\")\\n        with self.assertRaisesRegex(relevance.DatasetError, \\\"config hash differs\\\"):\\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n\\n    def test_materialize_does_not_read_unselected_unseen_config(self):\\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n        self.addCleanup(temporary.cleanup)\\n        payload = json.loads(inventory.read_text())\\n        payload[\\\"tasks\\\"].append({\\n            \\\"task_id\\\": \\\"sealed-task\\\",\\n            \\\"assigned_split\\\": \\\"confirmatory\\\",\\n            \\\"state\\\": \\\"unseen\\\",\\n            \\\"artifacts\\\": {\\n                \\\"config_path\\\": \\\"tasks/must-not-be-read.json\\\",\\n                \\\"config_sha256\\\": \\\"c\\\" * 64,\\n                \\\"prompt_sha256\\\": \\\"d\\\" * 64,\\n            },\\n        })\\n        inventory.write_text(json.dumps(payload))\\n        result = relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n        self.assertEqual(result[\\\"development\\\"][\\\"unique_task_count\\\"], 2)\\n\\n    def test_materialize_rejects_positive_fact_at_or_after_cutoff(self):\\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n        self.addCleanup(temporary.cleanup)\\n        payload = json.loads(snapshot.read_text())\\n        payload[\\\"session_dates\\\"][\\\"old\\\"] = \\\"2026-02-01T00:00:00Z\\\"\\n        snapshot.write_text(json.dumps(payload))\\n        self._refresh_snapshot_commitment(labels, snapshot)\\n        with self.assertRaisesRegex(relevance.DatasetError, \\\"answerable query has no eligible positive\\\"):\\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n\\n    def test_materialize_rejects_superseded_fact(self):\\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n        self.addCleanup(temporary.cleanup)\\n        payload = json.loads(snapshot.read_text())\\n        payload[\\\"facts\\\"][0][\\\"status\\\"] = \\\"superseded\\\"\\n        snapshot.write_text(json.dumps(payload))\\n        self._refresh_snapshot_commitment(labels, snapshot, refresh_judgment_hashes=True)\\n        with self.assertRaisesRegex(relevance.DatasetError, \\\"only active facts may be judged\\\"):\\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n\\n    def test_materialize_rejects_snapshot_fact_tampering_after_commitment_refresh(self):\\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n        self.addCleanup(temporary.cleanup)\\n        payload = json.loads(snapshot.read_text())\\n        payload[\\\"facts\\\"][0][\\\"text\\\"] = \\\"Tampered reviewed fact text.\\\"\\n        snapshot.write_text(json.dumps(payload))\\n        self._refresh_snapshot_commitment(labels, snapshot)\\n        with self.assertRaisesRegex(relevance.DatasetError, \\\"snapshot fact differs from reviewed fact hash\\\"):\\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n\\n    def test_full_source_recheck_rejects_mutated_active_catalog(self):\\n        temporary, _repo, labels, _inventory, snapshot, _runtime = self._fixture()\\n        self.addCleanup(temporary.cleanup)\\n        label_payload = json.loads(labels.read_text())\\n        snapshot_payload = json.loads(snapshot.read_text())\\n        snapshot_payload[\\\"facts\\\"][0][\\\"text\\\"] = \\\"Mutated full-source fact.\\\"\\n        with self.assertRaisesRegex(relevance.DatasetError, \\\"active full-corpus fact catalog hash\\\"):\\n            relevance.build_snapshot(\\n                label_payload,\\n                snapshot_payload[\\\"facts\\\"],\\n                snapshot_payload[\\\"session_dates\\\"],\\n                \\\"a\\\" * 64,\\n                \\\"b\\\" * 64,\\n            )\\n\\n    def test_materialize_rejects_snapshot_date_without_reviewed_commitment(self):\\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n        self.addCleanup(temporary.cleanup)\\n        payload = json.loads(snapshot.read_text())\\n        payload[\\\"session_dates\\\"][\\\"old\\\"] = \\\"2025-12-01T00:00:00Z\\\"\\n        snapshot.write_text(json.dumps(payload))\\n        with self.assertRaisesRegex(relevance.DatasetError, \\\"session_dates commitment is stale\\\"):\\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n\\n    def test_materialize_rejects_product_query_override(self):\\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n        self.addCleanup(temporary.cleanup)\\n        payload = json.loads(labels.read_text())\\n        payload[\\\"items\\\"][0][\\\"query_text\\\"] = \\\"hand tuned\\\"\\n        labels.write_text(json.dumps(payload))\\n        with self.assertRaisesRegex(relevance.DatasetError, \\\"derive exactly from task prompt\\\"):\\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n\\n    def test_materialize_requires_retained_evidence_path_and_hash(self):\\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n        self.addCleanup(temporary.cleanup)\\n        payload = json.loads(labels.read_text())\\n        del payload[\\\"items\\\"][0][\\\"label_evidence\\\"][\\\"source_path\\\"]\\n        labels.write_text(json.dumps(payload))\\n        with self.assertRaisesRegex(relevance.DatasetError, \\\"label_evidence source path is missing\\\"):\\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n\\n    def test_materialize_rejects_mismatched_retained_evidence_bytes(self):\\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n        self.addCleanup(temporary.cleanup)\\n        (repo / \\\"review-ledger.json\\\").write_text(\\\"changed bytes\\\\n\\\")\\n        with self.assertRaisesRegex(relevance.DatasetError, \\\"retained source hash differs\\\"):\\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n\\n    def test_null_query_cannot_have_eligible_positive(self):\\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n        self.addCleanup(temporary.cleanup)\\n        payload = json.loads(labels.read_text())\\n        payload[\\\"items\\\"][2][\\\"judgments\\\"][0][\\\"grade\\\"] = \\\"solving\\\"\\n        labels.write_text(json.dumps(payload))\\n        with self.assertRaisesRegex(relevance.DatasetError, \\\"null query has eligible positive\\\"):\\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n\\n    def test_null_query_requires_exhaustive_active_corpus_closure(self):\\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n        self.addCleanup(temporary.cleanup)\\n        payload = json.loads(labels.read_text())\\n        del payload[\\\"items\\\"][2][\\\"null_review\\\"]\\n        labels.write_text(json.dumps(payload))\\n        with self.assertRaisesRegex(relevance.DatasetError, \\\"requires exact retained review evidence\\\"):\\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n\\n    def test_null_query_rejects_partial_corpus_review(self):\\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n        self.addCleanup(temporary.cleanup)\\n        runtime[\\\"null_review_ledger\\\"][\\\"items\\\"][0][\\\"decisions\\\"].pop()\\n        with self.assertRaisesRegex(relevance.DatasetError, \\\"does not exactly cover\\\"):\\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n\\n    def test_null_query_rejects_duplicate_or_wrong_hash_review_rows(self):\\n        for attack in (\\\"duplicate\\\", \\\"wrong_hash\\\"):\\n            with self.subTest(attack=attack):\\n                temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n                self.addCleanup(temporary.cleanup)\\n                decisions = runtime[\\\"null_review_ledger\\\"][\\\"items\\\"][0][\\\"decisions\\\"]\\n                if attack == \\\"duplicate\\\":\\n                    decisions.append(copy.deepcopy(decisions[0]))\\n                    expected = \\\"missing or duplicated\\\"\\n                else:\\n                    decisions[0][\\\"fact_sha256\\\"] = \\\"f\\\" * 64\\n                    expected = \\\"differs from membership\\\"\\n                with self.assertRaisesRegex(relevance.DatasetError, expected):\\n                    relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n\\n    def test_null_query_rejects_positive_exhaustive_decision(self):\\n        temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n        self.addCleanup(temporary.cleanup)\\n        runtime[\\\"null_review_ledger\\\"][\\\"items\\\"][0][\\\"decisions\\\"][0][\\\"grade\\\"] = \\\"relevant_alternative\\\"\\n        with self.assertRaisesRegex(relevance.DatasetError, \\\"contains positive facts\\\"):\\n            relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n\\n    def test_null_query_rejects_temporal_membership_or_cutoff_laundering(self):\\n        for attack in (\\\"provenance\\\", \\\"date\\\"):\\n            with self.subTest(attack=attack):\\n                temporary, repo, labels, inventory, snapshot, runtime = self._fixture()\\n                self.addCleanup(temporary.cleanup)\\n                membership = runtime[\\\"source_membership\\\"]\\n                if attack == \\\"provenance\\\":\\n                    membership[\\\"facts\\\"][0][\\\"provenance_session_ids\\\"] = []\\n                else:\\n                    membership[\\\"session_dates\\\"][\\\"old\\\"] = \\\"2026-02-01T00:00:00Z\\\"\\n                with self.assertRaisesRegex(relevance.DatasetError, \\\"does not exactly cover\\\"):\\n                    relevance.materialize(repo, labels, inventory, snapshot, **runtime)\\n\\n    def test_d9df_url_fetch_advice_is_not_labeled_solving(self):\\n        labels = relevance.load_json(HERE / \\\"offline-relevance-development-labels.json\\\")\\n        item = next(row for row in labels[\\\"items\\\"] if row[\\\"task_id\\\"] == \\\"entire-cli-c0701-d9df8fcca\\\")\\n        grades = {judgment[\\\"fact_id\\\"]: judgment[\\\"grade\\\"] for judgment in item[\\\"judgments\\\"]}\\n        self.assertEqual(grades[\\\"fact:8325ce8c7c9c08ba273c812f\\\"], \\\"hard_topical_distractor\\\")\\n        self.assertEqual(grades[\\\"fact:11af406c1bcd1c4994261a6c\\\"], \\\"relevant_alternative\\\")\\n\\n    def test_checked_in_dataset_rebuilds_and_keeps_holdout_unopened(self):\\n        labels = HERE / \\\"offline-relevance-development-labels.json\\\"\\n        inventory = HERE / \\\"task-inventory.json\\\"\\n        snapshot = HERE / \\\"offline-relevance-fact-snapshot.json\\\"\\n        dataset = HERE / \\\"offline-relevance-dataset.json\\\"\\n        membership = relevance.load_json(HERE / \\\"offline-relevance-source-membership.json\\\")\\n        null_ledger_path = HERE / \\\"offline-relevance-null-review-ledger.json\\\"\\n        null_ledger = relevance.load_json(null_ledger_path)\\n        expected = relevance.materialize(\\n            REPO,\\n            labels,\\n            inventory,\\n            snapshot,\\n            source_membership=membership,\\n            null_review_ledger=null_ledger,\\n            null_review_ledger_path=null_ledger_path.relative_to(REPO).as_posix(),\\n            null_review_ledger_sha256=relevance.sha256_bytes(null_ledger_path.read_bytes()),\\n        )\\n        actual = relevance.load_json(dataset)\\n        relevance.validate_dataset(actual, expected)\\n        self.assertEqual(actual[\\\"development\\\"][\\\"item_count\\\"], 14)\\n        self.assertEqual(actual[\\\"development\\\"][\\\"unique_task_count\\\"], 13)\\n        self.assertEqual(actual[\\\"development\\\"][\\\"null_query_count\\\"], 1)\\n        self.assertEqual(actual[\\\"development\\\"][\\\"unique_answerable_product_task_count\\\"], 12)\\n        self.assertEqual(actual[\\\"development\\\"][\\\"product_null_query_count\\\"], 1)\\n        self.assertEqual(actual[\\\"development\\\"][\\\"judgment_count\\\"], 46)\\n        null_item = next(\\n            item for item in actual[\\\"development\\\"][\\\"items\\\"]\\n            if item[\\\"query_id\\\"] == \\\"dev-product-b72a6e621\\\"\\n        )\\n        self.assertEqual(null_item[\\\"null_closure\\\"][\\\"reviewed_fact_count\\\"], 2531)\\n        self.assertEqual(null_item[\\\"null_closure\\\"][\\\"positive_fact_count\\\"], 0)\\n        decisions = null_ledger[\\\"items\\\"][0][\\\"decisions\\\"]\\n        self.assertEqual(sum(row[\\\"grade\\\"] == \\\"hard_topical_distractor\\\" for row in decisions), 4)\\n        self.assertEqual(sum(row[\\\"grade\\\"] == \\\"irrelevant\\\" for row in decisions), 2527)\\n        schema_errors = relevance.validate_relevance_schemas(\\n            relevance.load_json(labels),\\n            relevance.load_json(snapshot),\\n            actual,\\n            HERE / \\\"schemas\\\",\\n        )\\n        self.assertEqual(schema_errors, [])\\n        self.assertEqual(actual[\\\"sealed_holdout\\\"][\\\"items\\\"], [])\\n\\n    def test_complete_membership_rejects_fabricated_fact_and_date(self):\\n        labels = relevance.load_json(HERE / \\\"offline-relevance-development-labels.json\\\")\\n        snapshot = relevance.load_json(HERE / \\\"offline-relevance-fact-snapshot.json\\\")\\n        contract = relevance.load_json(HERE / \\\"relevance-source-contract.json\\\")\\n        membership_path = HERE / \\\"offline-relevance-source-membership.json\\\"\\n        membership = relevance.load_json(membership_path)\\n        fabricated = copy.deepcopy(snapshot)\\n        fabricated[\\\"facts\\\"][0][\\\"text\\\"] += \\\" Fabricated.\\\"\\n        session_id = next(iter(fabricated[\\\"session_dates\\\"]))\\n        fabricated[\\\"session_dates\\\"][session_id] = \\\"2020-01-01T00:00:00Z\\\"\\n        with self.assertRaisesRegex(\\n            relevance.DatasetError,\\n            \\\"snapshot fact differs from reviewed full-source membership\\\",\\n        ):\\n            relevance.validate_source_membership(\\n                labels,\\n                fabricated,\\n                contract,\\n                membership,\\n                membership_sha256=relevance.sha256_bytes(membership_path.read_bytes()),\\n            )\\n        date_only = copy.deepcopy(snapshot)\\n        date_only[\\\"session_dates\\\"][session_id] = \\\"2020-01-01T00:00:00Z\\\"\\n        with self.assertRaisesRegex(\\n            relevance.DatasetError,\\n            \\\"snapshot session date differs from reviewed full-source membership\\\",\\n        ):\\n            relevance.validate_source_membership(\\n                labels,\\n                date_only,\\n                contract,\\n                membership,\\n                membership_sha256=relevance.sha256_bytes(membership_path.read_bytes()),\\n            )\\n\\n    def test_review_ledger_is_exact_per_query_and_judgment(self):\\n        labels = relevance.load_json(HERE / \\\"offline-relevance-development-labels.json\\\")\\n        contract = relevance.load_json(HERE / \\\"relevance-source-contract.json\\\")\\n        ledger_path = HERE / \\\"offline-relevance-review-ledger.json\\\"\\n        ledger = relevance.load_json(ledger_path)\\n        ledger[\\\"items\\\"][0][\\\"judgments\\\"][0][\\\"grade\\\"] = \\\"irrelevant\\\"\\n        with self.assertRaisesRegex(relevance.DatasetError, \\\"ledger judgments differ from labels\\\"):\\n            relevance.validate_review_ledger(\\n                labels,\\n                ledger,\\n                contract,\\n                ledger_path=\\\"benchmarks/agent-brain/confirmatory/offline-relevance-review-ledger.json\\\",\\n                ledger_sha256=relevance.sha256_bytes(ledger_path.read_bytes()),\\n            )\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    unittest.main()\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839553.191098}}}
