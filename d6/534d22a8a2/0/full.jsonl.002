. /api/v1/clusters. These\\nplaceholders are filled from the current repo's origin remote:\\n  {owner} {repo}   the GitHub owner / repo\\n  {repo_id}        the repo's Entire ULID (from its mirror) — cells key on this\\n\\nThe method is GET unless a field/body is given (then POST); override with -X.\\n\\nUsage:\\n  entire api <path> [flags]\\n\\nExamples:\\n  entire api /api/v1/clusters\\n  entire api --to cell /api/v1/me/activity\\n  entire api --jurisdiction eu /api/v1/me/activity\\n  entire api --to cell \\\"/api/v1/me/recap?repo={repo_id}\\\"\\n  entire api -X POST /api/v1/projects -f name=demo\\n\\nFlags:\\n  -F, --field stringArray       add a typed parameter in key=value format; true/false/null/numbers are converted (repeatable)\\n  -H, --header stringArray      add a request header in key:value format (repeatable)\\n  -h, --help                    help for api\\n  -i, --include                 print the response status line and headers too\\n      --input string            file with the request body (\\\"-\\\" for stdin)\\n  -j, --jurisdiction string     target a specific jurisdiction's cell (e.g. us, eu) instead of your home cell; implies --to cell\\n  -X, --method string           HTTP method (default GET, or POST when a field/body is given)\\n  -f, --raw-field stringArray   add a string parameter in key=value format (repeatable)\\n      --to string               which backend to call: core or cell (default \\\"core\\\")\\n\\nGlobal Flags:\\n      --context name   Act as this saved login name for this command only, instead of the active context (entire auth contexts lists them)\\nrefs/remotes/origin/main\\n/Users/thomi/Projects/entire-brain/.git/hooks\\nSession not found.\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"1d3035\",\"wall_time_seconds\":0.00000225,\"exit_code\":0,\"original_token_count\":263,\"output\":\"prepare-commit-msg #!/bin/sh\\n# Entire CLI hooks\\nif command -v entire >/dev/null 2>&1; then entire hooks git prepare-commit-msg \\\"$1\\\" \\\"$2\\\" 2>/dev/null || true; else :; fi\\n\\ncommit-msg #!/bin/sh\\n# Entire CLI hooks\\n# Commit-msg hook: strip trailer if no user content (allows aborting empty commits)\\nif command -v entire >/dev/null 2>&1; then entire hooks git commit-msg \\\"$1\\\" || true; else printf '%s\\\\n' '[entire] Entire CLI is enabled but not installed or not on PATH. Skipping Entire Git hook; continuing. Installation guide: https://docs.entire.io/cli/installation#installation-methods' >&2 || :; fi\\n\\npost-commit #!/bin/sh\\n# Entire CLI hooks\\n# Post-commit hook: condense session data if commit has Entire-Checkpoint trailer\\nif command -v entire >/dev/null 2>&1; then entire hooks git post-commit 2>/dev/null || true; else :; fi\\n\\npre-push #!/bin/sh\\n# Entire CLI hooks\\n# Pre-push hook: push session logs alongside user's push\\n# $1 is the remote name (e.g., \\\"origin\\\")\\nif command -v entire >/dev/null 2>&1; then entire hooks git pre-push \\\"$1\\\"; else :; fi\\n\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0bb40-0204-7de1-a470-e55eab47a99a","create_time":1789848083.351914}}}
