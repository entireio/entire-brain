{"timestamp":"2026-09-19T17:38:48.497Z","ordinal":7474,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0b6ce-e2ad-7853-bb2f-19731062a2c9","turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","item":{"type":"CommandExecution","id":"exec-e342a12c-655b-431c-b5d5-3d8d3117e3a8","process_id":"57680","command":["/bin/zsh","-lc","sed -n '1,520p' benchmarks/agent-brain/confirmatory/test_offline_relevance_eval.py"],"cwd":"file:///Users/thomi/.codex/worktrees/5d33/entire-brain","parsed_cmd":[{"type":"read","cmd":"sed -n '1,520p' benchmarks/agent-brain/confirmatory/test_offline_relevance_eval.py","name":"test_offline_relevance_eval.py","path":"benchmarks/agent-brain/confirmatory/test_offline_relevance_eval.py"}],"source":"unified_exec_startup","status":"completed","stdout":"#!/usr/bin/env python3\n\"\"\"Synthetic, offline-only contract tests for offline_relevance_eval.py.\"\"\"\n\nfrom __future__ import annotations\n\nimport copy\nimport hashlib\nimport json\nimport pathlib\nimport unittest\nfrom typing import Any, Callable\n\nimport offline_relevance_eval as relevance\nimport relevance_dataset as schema_validation\n\n\ndef _hash(label: str) -> str:\n    return hashlib.sha256(label.encode(\"utf-8\")).hexdigest()\n\n\ndef _raw(value: object) -> bytes:\n    return relevance.canonical_json(value)\n\n\ndef _result(fact_id: str, kind: str, cluster_id: str, tokens: int) -> dict[str, object]:\n    return {\n        \"fact_id\": fact_id,\n        \"fact_sha256\": _hash(fact_id),\n        \"kind\": kind,\n        \"cluster_id\": cluster_id,\n        \"eligible\": True,\n        \"estimated_tokens\": tokens,\n    }\n\n\ndef _synthetic_case() -> dict[str, Any]:\n    arms = [\n        {\n            \"id\": \"lexical\",\n            \"semantic\": False,\n            \"effective_engine_required\": \"lexical\",\n            \"namespace\": \"lexical-v1\",\n        },\n        {\n            \"id\": \"model2vec\",\n            \"semantic\": True,\n            \"effective_engine_required\": \"model2vec\",\n            \"namespace\": \"model2vec-v1\",\n        },\n        {\n            \"id\": \"embeddinggemma\",\n            \"semantic\": True,\n            \"effective_engine_required\": \"embeddinggemma\",\n            \"namespace\": \"embeddinggemma-v1\",\n        },\n    ]\n    engine_matrix = {\"matrix_id\": \"synthetic-matrix-v1\", \"arms\": arms}\n    engine_pins = {\n        \"pin_set_id\": \"synthetic-pins-v1\",\n        \"binary\": {\"binary_sha256\": _hash(\"binary\"), \"binary_size_bytes\": 4096},\n        \"engines\": {\n            \"lexical\": {\"dimension\": None},\n            \"model2vec\": {\"dimension\": 512},\n            \"embeddinggemma\": {\"dimension\": 768},\n        },\n    }\n    facts = [\n        {\n            \"fact_id\": \"positive-1\",\n            \"fact_sha256\": _hash(\"positive-1\"),\n            \"status\": \"active\",\n            \"provenance_session_ids\": [\"session-old\"],\n        },\n        {\n            \"fact_id\": \"positive-2\",\n            \"fact_sha256\": _hash(\"positive-2\"),\n            \"status\": \"active\",\n            \"provenance_session_ids\": [\"session-old\"],\n        },\n        {\n            \"fact_id\": \"distractor-1\",\n            \"fact_sha256\": _hash(\"distractor-1\"),\n            \"status\": \"active\",\n            \"provenance_session_ids\": [\"session-old\"],\n        },\n        {\n            \"fact_id\": \"irrelevant-1\",\n            \"fact_sha256\": _hash(\"irrelevant-1\"),\n            \"status\": \"active\",\n            \"provenance_session_ids\": [\"session-old\"],\n        },\n        {\n            \"fact_id\": \"future-1\",\n            \"fact_sha256\": _hash(\"future-1\"),\n            \"status\": \"active\",\n            \"provenance_session_ids\": [\"session-future\"],\n        },\n    ]\n    membership = {\n        \"fact_count\": len(facts),\n        \"active_fact_count\": len(facts),\n        \"facts\": facts,\n        \"session_dates\": {\n            \"session-old\": \"2026-01-01T00:00:00Z\",\n            \"session-future\": \"2026-03-01T00:00:00Z\",\n        },\n        \"eligibility_membership_root_sha256\": relevance._membership_root(facts),\n    }\n    fixture = {\n        \"schema_version\": 1,\n        \"fixture_id\": \"synthetic-development-fixture-v1\",\n        \"items\": [\n            {\n                \"query_id\": \"query-product\",\n                \"task_id\": \"task-product\",\n                \"query_source\": \"user_prompt_derived\",\n                \"null_query\": False,\n                \"query_text\": \"synthetic product query sentinel\",\n                \"temporal_cutoff\": \"2026-02-01T00:00:00Z\",\n                \"exclude_session_ids\": [],\n            },\n            {\n                \"query_id\": \"query-null\",\n                \"task_id\": \"task-null\",\n                \"query_source\": \"user_prompt_derived\",\n                \"null_query\": True,\n                \"query_text\": \"synthetic null query sentinel\",\n                \"temporal_cutoff\": \"2026-02-01T00:00:00Z\",\n                \"exclude_session_ids\": [],\n            },\n            {\n                \"query_id\": \"query-oracle\",\n                \"task_id\": \"task-oracle\",\n                \"query_source\": \"oracle_upper_bound\",\n                \"null_query\": False,\n                \"query_text\": \"synthetic oracle query sentinel\",\n                \"temporal_cutoff\": \"2026-02-01T00:00:00Z\",\n                \"exclude_session_ids\": [],\n            },\n        ],\n        \"fixture_sha256\": \"\",\n    }\n    fixture[\"fixture_sha256\"] = relevance._self_hash(fixture, \"fixture_sha256\")\n    product_judgments = [\n        {\n            \"fact_id\": \"positive-1\",\n            \"fact_sha256\": _hash(\"positive-1\"),\n            \"grade\": \"solving\",\n            \"kind\": \"decision\",\n            \"cluster_id\": \"cluster-positive-1\",\n        },\n        {\n            \"fact_id\": \"positive-2\",\n            \"fact_sha256\": _hash(\"positive-2\"),\n            \"grade\": \"relevant_alternative\",\n            \"kind\": \"procedure\",\n            \"cluster_id\": \"cluster-positive-2\",\n        },\n        {\n            \"fact_id\": \"distractor-1\",\n            \"fact_sha256\": _hash(\"distractor-1\"),\n            \"grade\": \"hard_topical_distractor\",\n            \"kind\": \"constraint\",\n            \"cluster_id\": \"cluster-distractor-1\",\n        },\n        {\n            \"fact_id\": \"irrelevant-1\",\n            \"fact_sha256\": _hash(\"irrelevant-1\"),\n            \"grade\": \"irrelevant\",\n            \"kind\": \"observation\",\n            \"cluster_id\": \"cluster-irrelevant-1\",\n        },\n    ]\n    dataset = {\n        \"schema_version\": 2,\n        \"dataset_id\": \"synthetic-offline-relevance-v2\",\n        \"development\": {\n            \"items\": [\n                {\n                    \"query_id\": \"query-product\",\n                    \"task_id\": \"task-product\",\n                    \"query_source\": \"user_prompt_derived\",\n                    \"null_query\": False,\n                    \"judgments\": product_judgments,\n                },\n                {\n                    \"query_id\": \"query-null\",\n                    \"task_id\": \"task-null\",\n                    \"query_source\": \"user_prompt_derived\",\n                    \"null_query\": True,\n                    \"judgments\": copy.deepcopy(product_judgments[2:]),\n                },\n                {\n                    \"query_id\": \"query-oracle\",\n                    \"task_id\": \"task-oracle\",\n                    \"query_source\": \"oracle_upper_bound\",\n                    \"null_query\": False,\n                    \"judgments\": [copy.deepcopy(product_judgments[0])],\n                },\n            ]\n        },\n    }\n    producer_identity = relevance.finalize_producer_identity(\n        {\n            \"schema_version\": 1,\n            \"schema\": relevance.PRODUCER_IDENTITY_SCHEMA,\n            \"producer_id\": \"synthetic-ranked-run-producer-v1\",\n            \"runner_sha256\": _hash(\"synthetic-runner-artifact\"),\n            \"producer_code_sha256\": _hash(\"synthetic-runner-code\"),\n            \"ranking_result_metadata_policy_id\": \"synthetic-result-metadata-v1\",\n            \"ranking_result_metadata_policy_sha256\": _hash(\n                \"synthetic-result-metadata-policy\"\n            ),\n            \"token_estimation_policy_id\": \"synthetic-token-estimation-v1\",\n            \"token_estimation_policy_sha256\": _hash(\n                \"synthetic-token-estimation-policy\"\n            ),\n            \"serialization_policy_id\": \"synthetic-serialization-v1\",\n            \"serialization_policy_sha256\": _hash(\"synthetic-serialization-policy\"),\n            \"producer_identity_sha256\": \"\",\n        }\n    )\n    engine_matrix_raw = _raw(engine_matrix)\n    engine_pins_raw = _raw(engine_pins)\n    producer_identity_raw = _raw(producer_identity)\n    dataset_raw = _raw(dataset)\n    membership_raw = _raw(membership)\n    bindings = relevance._build_input_bindings(\n        engine_matrix_raw,\n        engine_matrix,\n        engine_pins_raw,\n        engine_pins,\n        producer_identity_raw,\n        producer_identity,\n        fixture,\n        dataset_raw,\n        dataset,\n        membership_raw,\n        membership,\n    )\n    result_rows = [\n        _result(\"positive-1\", \"decision\", \"cluster-positive-1\", 10),\n        _result(\"positive-2\", \"procedure\", \"cluster-positive-2\", 20),\n        _result(\"distractor-1\", \"constraint\", \"cluster-distractor-1\", 30),\n        _result(\"irrelevant-1\", \"observation\", \"cluster-irrelevant-1\", 40),\n    ]\n    query_rows = [\n        {\n            \"query_id\": \"query-product\",\n            \"task_id\": \"task-product\",\n            \"query_source\": \"user_prompt_derived\",\n            \"null_query\": False,\n            \"telemetry\": {\n                \"active_fact_count\": 5,\n                \"eligible_fact_count\": 4,\n                \"temporal_exclusion_count\": 1,\n                \"delivered_count\": 4,\n                \"ranking_latency_ms\": 2.5,\n            },\n            \"ordered_results\": result_rows,\n        },\n        {\n            \"query_id\": \"query-null\",\n            \"task_id\": \"task-null\",\n            \"query_source\": \"user_prompt_derived\",\n            \"null_query\": True,\n            \"telemetry\": {\n                \"active_fact_count\": 5,\n                \"eligible_fact_count\": 4,\n                \"temporal_exclusion_count\": 1,\n                \"delivered_count\": 0,\n                \"ranking_latency_ms\": 1.0,\n            },\n            \"ordered_results\": [],\n        },\n        {\n            \"query_id\": \"query-oracle\",\n            \"task_id\": \"task-oracle\",\n            \"query_source\": \"oracle_upper_bound\",\n            \"null_query\": False,\n            \"telemetry\": {\n                \"active_fact_count\": 5,\n                \"eligible_fact_count\": 4,\n                \"temporal_exclusion_count\": 1,\n                \"delivered_count\": 1,\n                \"ranking_latency_ms\": 0.5,\n            },\n            \"ordered_results\": [copy.deepcopy(result_rows[0])],\n        },\n    ]\n    runs: list[bytes] = []\n    dimensions = {\"lexical\": None, \"model2vec\": 512, \"embeddinggemma\": 768}\n    for arm in arms:\n        arm_id = arm[\"id\"]\n        for aggregation in relevance.AGGREGATION_CANDIDATES:\n            semantic = bool(arm[\"semantic\"])\n            identity = {\n                \"arm_id\": arm_id,\n                \"effective_engine\": arm[\"effective_engine_required\"],\n                \"semantic\": semantic,\n                \"binary_sha256\": engine_pins[\"binary\"][\"binary_sha256\"],\n                \"binary_size_bytes\": engine_pins[\"binary\"][\"binary_size_bytes\"],\n                \"vector_namespace\": arm[\"namespace\"],\n                \"vector_artifact_sha256\": _hash(f\"artifact-{arm_id}\") if semantic else None,\n                \"vector_artifact_size_bytes\": 8192 if semantic else None,\n                \"embedding_dimension\": dimensions[arm_id],\n                \"fallback_used\": False,\n            }\n            run = {\n                \"schema_version\": 1,\n                \"schema\": relevance.RANKED_RUN_SCHEMA,\n                \"run_id\": f\"run-{arm_id}-{aggregation}\",\n                \"created_at\": \"2026-04-01T00:00:00Z\",\n                \"input_bindings\": copy.deepcopy(bindings),\n                \"producer_identity\": copy.deepcopy(producer_identity),\n                \"engine_identity\": identity,\n                \"aggregation_rule\": aggregation,\n                \"k_candidates\": list(relevance.K_CANDIDATES),\n                \"queries\": copy.deepcopy(query_rows),\n                \"run_sha256\": \"\",\n            }\n            runs.append(_raw(relevance.finalize_ranked_run(run)))\n    return {\n        \"engine_matrix\": engine_matrix,\n        \"engine_matrix_raw\": engine_matrix_raw,\n        \"engine_pins\": engine_pins,\n        \"engine_pins_raw\": engine_pins_raw,\n        \"producer_identity\": producer_identity,\n        \"producer_identity_raw\": producer_identity_raw,\n        \"fixture\": fixture,\n        \"dataset\": dataset,\n        \"dataset_raw\": dataset_raw,\n        \"membership\": membership,\n        \"membership_raw\": membership_raw,\n        \"runs\": runs,\n    }\n\n\nclass OfflineRelevanceEvalTests(unittest.TestCase):\n    def setUp(self) -> None:\n        self.case: dict[str, Any] = _synthetic_case()\n\n    def evaluate(self, **overrides: Any) -> dict[str, Any]:\n        values: dict[str, Any] = {\n            \"engine_matrix_raw\": self.case[\"engine_matrix_raw\"],\n            \"engine_pins_raw\": self.case[\"engine_pins_raw\"],\n            \"producer_identity_raw\": self.case[\"producer_identity_raw\"],\n            \"fixture\": self.case[\"fixture\"],\n            \"dataset_raw\": self.case[\"dataset_raw\"],\n            \"source_membership_raw\": self.case[\"membership_raw\"],\n            \"ranked_run_raws\": self.case[\"runs\"],\n        }\n        values.update(overrides)\n        return relevance.evaluate(**values)\n\n    def mutate_run(\n        self, index: int, mutate: Callable[[dict[str, Any]], None]\n    ) -> list[bytes]:\n        runs = list(self.case[\"runs\"])\n        run = json.loads(runs[index])\n        mutate(run)\n        runs[index] = _raw(relevance.finalize_ranked_run(run))\n        return runs\n\n    def runs_with_unjudged_result(\n        self, *, cluster_id: str, estimated_tokens: int = 7\n    ) -> tuple[bytes, list[bytes]]:\n        membership = copy.deepcopy(self.case[\"membership\"])\n        membership[\"facts\"].append(\n            {\n                \"fact_id\": \"unjudged-1\",\n                \"fact_sha256\": _hash(\"unjudged-1\"),\n                \"status\": \"active\",\n                \"provenance_session_ids\": [\"session-old\"],\n            }\n        )\n        membership[\"fact_count\"] += 1\n        membership[\"active_fact_count\"] += 1\n        membership[\"eligibility_membership_root_sha256\"] = relevance._membership_root(\n            membership[\"facts\"]\n        )\n        membership_raw = _raw(membership)\n        bindings = relevance._build_input_bindings(\n            self.case[\"engine_matrix_raw\"],\n            self.case[\"engine_matrix\"],\n            self.case[\"engine_pins_raw\"],\n            self.case[\"engine_pins\"],\n            self.case[\"producer_identity_raw\"],\n            self.case[\"producer_identity\"],\n            self.case[\"fixture\"],\n            self.case[\"dataset_raw\"],\n            self.case[\"dataset\"],\n            membership_raw,\n            membership,\n        )\n        result = _result(\n            \"unjudged-1\", \"producer-supplied-kind\", cluster_id, estimated_tokens\n        )\n        runs: list[bytes] = []\n        for raw in self.case[\"runs\"]:\n            run = json.loads(raw)\n            run[\"input_bindings\"] = copy.deepcopy(bindings)\n            for query in run[\"queries\"]:\n                query[\"telemetry\"][\"active_fact_count\"] = 6\n                query[\"telemetry\"][\"eligible_fact_count\"] = 5\n                query[\"telemetry\"][\"temporal_exclusion_count\"] = 1\n            run[\"queries\"][0][\"ordered_results\"].append(copy.deepcopy(result))\n            run[\"queries\"][0][\"telemetry\"][\"delivered_count\"] = 5\n            runs.append(_raw(relevance.finalize_ranked_run(run)))\n        return membership_raw, runs\n\n    def coordinated_declared_producer(self) -> tuple[bytes, list[bytes]]:\n        producer = copy.deepcopy(self.case[\"producer_identity\"])\n        producer[\"producer_id\"] = \"coordinated-declaration-only-producer-v1\"\n        for field in (\n            \"runner_sha256\",\n            \"producer_code_sha256\",\n            \"ranking_result_metadata_policy_sha256\",\n            \"token_estimation_policy_sha256\",\n            \"serialization_policy_sha256\",\n        ):\n            producer[field] = _hash(f\"unretained-{field}\")\n        producer = relevance.finalize_producer_identity(producer)\n        producer_raw = _raw(producer)\n        bindings = relevance._build_input_bindings(\n            self.case[\"engine_matrix_raw\"],\n            self.case[\"engine_matrix\"],\n            self.case[\"engine_pins_raw\"],\n            self.case[\"engine_pins\"],\n            producer_raw,\n            producer,\n            self.case[\"fixture\"],\n            self.case[\"dataset_raw\"],\n            self.case[\"dataset\"],\n            self.case[\"membership_raw\"],\n            self.case[\"membership\"],\n        )\n        runs: list[bytes] = []\n        for raw in self.case[\"runs\"]:\n            run = json.loads(raw)\n            run[\"producer_identity\"] = copy.deepcopy(producer)\n            run[\"input_bindings\"] = copy.deepcopy(bindings)\n            runs.append(_raw(relevance.finalize_ranked_run(run)))\n        return producer_raw, runs\n\n    def test_metrics_and_per_engine_selection_are_deterministic(self) -> None:\n        report = self.evaluate()\n        self.assertEqual(report, self.evaluate())\n        self.assertEqual(\n            report[\"report_id\"],\n            \"entire-brain-offline-relevance-development-diagnostic-v1\",\n        )\n        self.assertEqual(report[\"report_sha256\"], relevance._self_hash(report, \"report_sha256\"))\n        self.assertEqual(report[\"producer_identity\"], self.case[\"producer_identity\"])\n        self.assertEqual(\n            report[\"input_bindings\"][\"producer_identity_file_sha256\"],\n            relevance.sha256_bytes(self.case[\"producer_identity_raw\"]),\n        )\n        self.assertEqual(\n            report[\"producer_identity\"][\"producer_identity_sha256\"],\n            relevance._self_hash(report[\"producer_identity\"], \"producer_identity_sha256\"),\n        )\n        self.assertEqual(len(report[\"evaluated_runs\"]), 6)\n        self.assertEqual(len(report[\"diagnostic_best_candidates\"]), 3)\n        self.assertEqual(len(report[\"selections\"]), 3)\n        first = report[\"evaluated_runs\"][0][\"candidates\"][0]\n        product = first[\"product\"]\n        oracle = first[\"oracle\"]\n        self.assertEqual(product[\"mean_recall_at_1\"], 0.5)\n        self.assertEqual(product[\"mean_recall_at_5\"], 1.0)\n        self.assertEqual(product[\"mean_recall_at_10\"], 1.0)\n        self.assertEqual(product[\"mean_mrr\"], 1.0)\n        self.assertEqual(product[\"mean_ndcg_at_10\"], 1.0)\n        self.assertEqual(product[\"mean_precision_at_k\"], 0.2)\n        self.assertEqual(product[\"null_false_positive_numerator\"], 0)\n        self.assertEqual(product[\"null_false_positive_denominator\"], 1)\n        self.assertEqual(product[\"null_query_false_positive_rate\"], 0.0)\n        self.assertEqual(product[\"maximum_cluster_occupancy\"], 1)\n        self.assertEqual(oracle[\"query_count\"], 1)\n        self.assertEqual(oracle[\"null_query_false_positive_rate\"], None)\n        self.assertTrue(first[\"threshold_conditions_met\"])\n        self.assertFalse(first[\"thresholds_passed\"])\n        for selection in report[\"selections\"]:\n            self.assertEqual(selection[\"status\"], \"non_authoritative\")\n            self.assertIsNone(selection[\"run_id\"])\n            self.assertIsNone(selection[\"run_sha256\"])\n            self.assertIsNone(selection[\"aggregation_rule\"])\n            self.assertIsNone(selection[\"k\"])\n            self.assertIsNone(selection[\"selection_sha256\"])\n        for diagnostic in report[\"diagnostic_best_candidates\"]:\n            self.assertEqual(diagnostic[\"status\"], \"diagnostic_best_candidate\")\n            self.assertEqual(diagnostic[\"k\"], 5)\n            self.assertTrue(diagnostic[\"threshold_conditions_met\"])\n            self.assertEqual(\n                diagnostic[\"aggregation_rule\"], \"best_rank_then_hit_count_v1\"\n            )\n        for evaluated in report[\"evaluated_runs\"]:\n            self.assertEqual(\n                evaluated[\"producer_identity_sha256\"],\n                report[\"producer_identity\"][\"producer_identity_sha256\"],\n            )\n\n    def test_decision_authority_is_explicit_and_fail_closed(self) -> None:\n        report = self.evaluate()\n        authority = report[\"decision_authority\"]\n        self.assertEqual(authority[\"status\"], \"diagnostic_unattested\")\n        self.assertFalse(authority[\"authoritative_thresholds_enabled\"])\n        verification_fields = (\n            \"producer_runner_bytes_verified\",\n            \"producer_code_bytes_verified\",\n            \"ranking_result_metadata_policy_bytes_verified\",\n            \"token_estimation_policy_bytes_verified\",\n            \"serialization_policy_bytes_verified\",\n            \"fact_metadata_catalog_verified\",\n            \"engine_evidence_verified\",\n            \"source_contract_verified\",\n        )\n        for field in verification_fields:\n            self.assertFalse(authority[field], field)\n        self.assertEqual(\n","stderr":"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Synthetic, offline-only contract tests for offline_relevance_eval.py.\"\"\"\n\nfrom __future__ import annotations\n\nimport copy\nimport hashlib\nimport json\nimport pathlib\nimport unittest\nfrom typing import Any, Callable\n\nimport offline_relevance_eval as relevance\nimport relevance_dataset as schema_validation\n\n\ndef _hash(label: str) -> str:\n    return hashlib.sha256(label.encode(\"utf-8\")).hexdigest()\n\n\ndef _raw(value: object) -> bytes:\n    return relevance.canonical_json(value)\n\n\ndef _result(fact_id: str, kind: str, cluster_id: str, tokens: int) -> dict[str, object]:\n    return {\n        \"fact_id\": fact_id,\n        \"fact_sha256\": _hash(fact_id),\n        \"kind\": kind,\n        \"cluster_id\": cluster_id,\n        \"eligible\": True,\n        \"estimated_tokens\": tokens,\n    }\n\n\ndef _synthetic_case() -> dict[str, Any]:\n    arms = [\n        {\n            \"id\": \"lexical\",\n            \"semantic\": False,\n            \"effective_engine_required\": \"lexical\",\n            \"namespace\": \"lexical-v1\",\n        },\n        {\n            \"id\": \"model2vec\",\n            \"semantic\": True,\n            \"effective_engine_required\": \"model2vec\",\n            \"namespace\": \"model2vec-v1\",\n        },\n        {\n            \"id\": \"embeddinggemma\",\n            \"semantic\": True,\n            \"effective_engine_required\": \"embeddinggemma\",\n            \"namespace\": \"embeddinggemma-v1\",\n        },\n    ]\n    engine_matrix = {\"matrix_id\": \"synthetic-matrix-v1\", \"arms\": arms}\n    engine_pins = {\n        \"pin_set_id\": \"synthetic-pins-v1\",\n        \"binary\": {\"binary_sha256\": _hash(\"binary\"), \"binary_size_bytes\": 4096},\n        \"engines\": {\n            \"lexical\": {\"dimension\": None},\n            \"model2vec\": {\"dimension\": 512},\n            \"embeddinggemma\": {\"dimension\": 768},\n        },\n    }\n    facts = [\n        {\n            \"fact_id\": \"positive-1\",\n            \"fact_sha256\": _hash(\"positive-1\"),\n            \"status\": \"active\",\n            \"provenance_session_ids\": [\"session-old\"],\n        },\n        {\n            \"fact_id\": \"positive-2\",\n            \"fact_sha256\": _hash(\"positive-2\"),\n            \"status\": \"active\",\n            \"provenance_session_ids\": [\"session-old\"],\n        },\n        {\n            \"fact_id\": \"distractor-1\",\n            \"fact_sha256\": _hash(\"distractor-1\"),\n            \"status\": \"active\",\n            \"provenance_session_ids\": [\"session-old\"],\n        },\n        {\n            \"fact_id\": \"irrelevant-1\",\n            \"fact_sha256\": _hash(\"irrelevant-1\"),\n            \"status\": \"active\",\n            \"provenance_session_ids\": [\"session-old\"],\n        },\n        {\n            \"fact_id\": \"future-1\",\n            \"fact_sha256\": _hash(\"future-1\"),\n            \"status\": \"active\",\n            \"provenance_session_ids\": [\"session-future\"],\n        },\n    ]\n    membership = {\n        \"fact_count\": len(facts),\n        \"active_fact_count\": len(facts),\n        \"facts\": facts,\n        \"session_dates\": {\n            \"session-old\": \"2026-01-01T00:00:00Z\",\n            \"session-future\": \"2026-03-01T00:00:00Z\",\n        },\n        \"eligibility_membership_root_sha256\": relevance._membership_root(facts),\n    }\n    fixture = {\n        \"schema_version\": 1,\n        \"fixture_id\": \"synthetic-development-fixture-v1\",\n        \"items\": [\n            {\n                \"query_id\": \"query-product\",\n                \"task_id\": \"task-product\",\n                \"query_source\": \"user_prompt_derived\",\n                \"null_query\": False,\n                \"query_text\": \"synthetic product query sentinel\",\n                \"temporal_cutoff\": \"2026-02-01T00:00:00Z\",\n                \"exclude_session_ids\": [],\n            },\n            {\n                \"query_id\": \"query-null\",\n                \"task_id\": \"task-null\",\n                \"query_source\": \"user_prompt_derived\",\n                \"null_query\": True,\n                \"query_text\": \"synthetic null query sentinel\",\n                \"temporal_cutoff\": \"2026-02-01T00:00:00Z\",\n                \"exclude_session_ids\": [],\n            },\n            {\n                \"query_id\": \"query-oracle\",\n                \"task_id\": \"task-oracle\",\n                \"query_source\": \"oracle_upper_bound\",\n                \"null_query\": False,\n                \"query_text\": \"synthetic oracle query sentinel\",\n                \"temporal_cutoff\": \"2026-02-01T00:00:00Z\",\n                \"exclude_session_ids\": [],\n            },\n        ],\n        \"fixture_sha256\": \"\",\n    }\n    fixture[\"fixture_sha256\"] = relevance._self_hash(fixture, \"fixture_sha256\")\n    product_judgments = [\n        {\n            \"fact_id\": \"positive-1\",\n            \"fact_sha256\": _hash(\"positive-1\"),\n            \"grade\": \"solving\",\n            \"kind\": \"decision\",\n            \"cluster_id\": \"cluster-positive-1\",\n        },\n        {\n            \"fact_id\": \"positive-2\",\n            \"fact_sha256\": _hash(\"positive-2\"),\n            \"grade\": \"relevant_alternative\",\n            \"kind\": \"procedure\",\n            \"cluster_id\": \"cluster-positive-2\",\n        },\n        {\n            \"fact_id\": \"distractor-1\",\n            \"fact_sha256\": _hash(\"distractor-1\"),\n            \"grade\": \"hard_topical_distractor\",\n            \"kind\": \"constraint\",\n            \"cluster_id\": \"cluster-distractor-1\",\n        },\n        {\n            \"fact_id\": \"irrelevant-1\",\n            \"fact_sha256\": _hash(\"irrelevant-1\"),\n            \"grade\": \"irrelevant\",\n            \"kind\": \"observation\",\n            \"cluster_id\": \"cluster-irrelevant-1\",\n        },\n    ]\n    dataset = {\n        \"schema_version\": 2,\n        \"dataset_id\": \"synthetic-offline-relevance-v2\",\n        \"development\": {\n            \"items\": [\n                {\n                    \"query_id\": \"query-product\",\n                    \"task_id\": \"task-product\",\n                    \"query_source\": \"user_prompt_derived\",\n                    \"null_query\": False,\n                    \"judgments\": product_judgments,\n                },\n                {\n                    \"query_id\": \"query-null\",\n                    \"task_id\": \"task-null\",\n                    \"query_source\": \"user_prompt_derived\",\n                    \"null_query\": True,\n                    \"judgments\": copy.deepcopy(product_judgments[2:]),\n                },\n                {\n                    \"query_id\": \"query-oracle\",\n                    \"task_id\": \"task-oracle\",\n                    \"query_source\": \"oracle_upper_bound\",\n                    \"null_query\": False,\n                    \"judgments\": [copy.deepcopy(product_judgments[0])],\n                },\n            ]\n        },\n    }\n    producer_identity = relevance.finalize_producer_identity(\n        {\n            \"schema_version\": 1,\n            \"schema\": relevance.PRODUCER_IDENTITY_SCHEMA,\n            \"producer_id\": \"synthetic-ranked-run-producer-v1\",\n            \"runner_sha256\": _hash(\"synthetic-runner-artifact\"),\n            \"producer_code_sha256\": _hash(\"synthetic-runner-code\"),\n            \"ranking_result_metadata_policy_id\": \"synthetic-result-metadata-v1\",\n            \"ranking_result_metadata_policy_sha256\": _hash(\n                \"synthetic-result-metadata-policy\"\n            ),\n            \"token_estimation_policy_id\": \"synthetic-token-estimation-v1\",\n            \"token_estimation_policy_sha256\": _hash(\n                \"synthetic-token-estimation-policy\"\n            ),\n            \"serialization_policy_id\": \"synthetic-serialization-v1\",\n            \"serialization_policy_sha256\": _hash(\"synthetic-serialization-policy\"),\n            \"producer_identity_sha256\": \"\",\n        }\n    )\n    engine_matrix_raw = _raw(engine_matrix)\n    engine_pins_raw = _raw(engine_pins)\n    producer_identity_raw = _raw(producer_identity)\n    dataset_raw = _raw(dataset)\n    membership_raw = _raw(membership)\n    bindings = relevance._build_input_bindings(\n        engine_matrix_raw,\n        engine_matrix,\n        engine_pins_raw,\n        engine_pins,\n        producer_identity_raw,\n        producer_identity,\n        fixture,\n        dataset_raw,\n        dataset,\n        membership_raw,\n        membership,\n    )\n    result_rows = [\n        _result(\"positive-1\", \"decision\", \"cluster-positive-1\", 10),\n        _result(\"positive-2\", \"procedure\", \"cluster-positive-2\", 20),\n        _result(\"distractor-1\", \"constraint\", \"cluster-distractor-1\", 30),\n        _result(\"irrelevant-1\", \"observation\", \"cluster-irrelevant-1\", 40),\n    ]\n    query_rows = [\n        {\n            \"query_id\": \"query-product\",\n            \"task_id\": \"task-product\",\n            \"query_source\": \"user_prompt_derived\",\n            \"null_query\": False,\n            \"telemetry\": {\n                \"active_fact_count\": 5,\n                \"eligible_fact_count\": 4,\n                \"temporal_exclusion_count\": 1,\n                \"delivered_count\": 4,\n                \"ranking_latency_ms\": 2.5,\n            },\n            \"ordered_results\": result_rows,\n        },\n        {\n            \"query_id\": \"query-null\",\n            \"task_id\": \"task-null\",\n            \"query_source\": \"user_prompt_derived\",\n            \"null_query\": True,\n            \"telemetry\": {\n                \"active_fact_count\": 5,\n                \"eligible_fact_count\": 4,\n                \"temporal_exclusion_count\": 1,\n                \"delivered_count\": 0,\n                \"ranking_latency_ms\": 1.0,\n            },\n            \"ordered_results\": [],\n        },\n        {\n            \"query_id\": \"query-oracle\",\n            \"task_id\": \"task-oracle\",\n            \"query_source\": \"oracle_upper_bound\",\n            \"null_query\": False,\n            \"telemetry\": {\n                \"active_fact_count\": 5,\n                \"eligible_fact_count\": 4,\n                \"temporal_exclusion_count\": 1,\n                \"delivered_count\": 1,\n                \"ranking_latency_ms\": 0.5,\n            },\n            \"ordered_results\": [copy.deepcopy(result_rows[0])],\n        },\n    ]\n    runs: list[bytes] = []\n    dimensions = {\"lexical\": None, \"model2vec\": 512, \"embeddinggemma\": 768}\n    for arm in arms:\n        arm_id = arm[\"id\"]\n        for aggregation in relevance.AGGREGATION_CANDIDATES:\n            semantic = bool(arm[\"semantic\"])\n            identity = {\n                \"arm_id\": arm_id,\n                \"effective_engine\": arm[\"effective_engine_required\"],\n                \"semantic\": semantic,\n                \"binary_sha256\": engine_pins[\"binary\"][\"binary_sha256\"],\n                \"binary_size_bytes\": engine_pins[\"binary\"][\"binary_size_bytes\"],\n                \"vector_namespace\": arm[\"namespace\"],\n                \"vector_artifact_sha256\": _hash(f\"artifact-{arm_id}\") if semantic else None,\n                \"vector_artifact_size_bytes\": 8192 if semantic else None,\n                \"embedding_dimension\": dimensions[arm_id],\n                \"fallback_used\": False,\n            }\n            run = {\n                \"schema_version\": 1,\n                \"schema\": relevance.RANKED_RUN_SCHEMA,\n                \"run_id\": f\"run-{arm_id}-{aggregation}\",\n                \"created_at\": \"2026-04-01T00:00:00Z\",\n                \"input_bindings\": copy.deepcopy(bindings),\n                \"producer_identity\": copy.deepcopy(producer_identity),\n                \"engine_identity\": identity,\n                \"aggregation_rule\": aggregation,\n                \"k_candidates\": list(relevance.K_CANDIDATES),\n                \"queries\": copy.deepcopy(query_rows),\n                \"run_sha256\": \"\",\n            }\n            runs.append(_raw(relevance.finalize_ranked_run(run)))\n    return {\n        \"engine_matrix\": engine_matrix,\n        \"engine_matrix_raw\": engine_matrix_raw,\n        \"engine_pins\": engine_pins,\n        \"engine_pins_raw\": engine_pins_raw,\n        \"producer_identity\": producer_identity,\n        \"producer_identity_raw\": producer_identity_raw,\n        \"fixture\": fixture,\n        \"dataset\": dataset,\n        \"dataset_raw\": dataset_raw,\n        \"membership\": membership,\n        \"membership_raw\": membership_raw,\n        \"runs\": runs,\n    }\n\n\nclass OfflineRelevanceEvalTests(unittest.TestCase):\n    def setUp(self) -> None:\n        self.case: dict[str, Any] = _synthetic_case()\n\n    def evaluate(self, **overrides: Any) -> dict[str, Any]:\n        values: dict[str, Any] = {\n            \"engine_matrix_raw\": self.case[\"engine_matrix_raw\"],\n            \"engine_pins_raw\": self.case[\"engine_pins_raw\"],\n            \"producer_identity_raw\": self.case[\"producer_identity_raw\"],\n            \"fixture\": self.case[\"fixture\"],\n            \"dataset_raw\": self.case[\"dataset_raw\"],\n            \"source_membership_raw\": self.case[\"membership_raw\"],\n            \"ranked_run_raws\": self.case[\"runs\"],\n        }\n        values.update(overrides)\n        return relevance.evaluate(**values)\n\n    def mutate_run(\n        self, index: int, mutate: Callable[[dict[str, Any]], None]\n    ) -> list[bytes]:\n        runs = list(self.case[\"runs\"])\n        run = json.loads(runs[index])\n        mutate(run)\n        runs[index] = _raw(relevance.finalize_ranked_run(run))\n        return runs\n\n    def runs_with_unjudged_result(\n        self, *, cluster_id: str, estimated_tokens: int = 7\n    ) -> tuple[bytes, list[bytes]]:\n        membership = copy.deepcopy(self.case[\"membership\"])\n        membership[\"facts\"].append(\n            {\n                \"fact_id\": \"unjudged-1\",\n                \"fact_sha256\": _hash(\"unjudged-1\"),\n                \"status\": \"active\",\n                \"provenance_session_ids\": [\"session-old\"],\n            }\n        )\n        membership[\"fact_count\"] += 1\n        membership[\"active_fact_count\"] += 1\n        membership[\"eligibility_membership_root_sha256\"] = relevance._membership_root(\n            membership[\"facts\"]\n        )\n        membership_raw = _raw(membership)\n        bindings = relevance._build_input_bindings(\n            self.case[\"engine_matrix_raw\"],\n            self.case[\"engine_matrix\"],\n            self.case[\"engine_pins_raw\"],\n            self.case[\"engine_pins\"],\n            self.case[\"producer_identity_raw\"],\n            self.case[\"producer_identity\"],\n            self.case[\"fixture\"],\n            self.case[\"dataset_raw\"],\n            self.case[\"dataset\"],\n            membership_raw,\n            membership,\n        )\n        result = _result(\n            \"unjudged-1\", \"producer-supplied-kind\", cluster_id, estimated_tokens\n        )\n        runs: list[bytes] = []\n        for raw in self.case[\"runs\"]:\n            run = json.loads(raw)\n            run[\"input_bindings\"] = copy.deepcopy(bindings)\n            for query in run[\"queries\"]:\n                query[\"telemetry\"][\"active_fact_count\"] = 6\n                query[\"telemetry\"][\"eligible_fact_count\"] = 5\n                query[\"telemetry\"][\"temporal_exclusion_count\"] = 1\n            run[\"queries\"][0][\"ordered_results\"].append(copy.deepcopy(result))\n            run[\"queries\"][0][\"telemetry\"][\"delivered_count\"] = 5\n            runs.append(_raw(relevance.finalize_ranked_run(run)))\n        return membership_raw, runs\n\n    def coordinated_declared_producer(self) -> tuple[bytes, list[bytes]]:\n        producer = copy.deepcopy(self.case[\"producer_identity\"])\n        producer[\"producer_id\"] = \"coordinated-declaration-only-producer-v1\"\n        for field in (\n            \"runner_sha256\",\n            \"producer_code_sha256\",\n            \"ranking_result_metadata_policy_sha256\",\n            \"token_estimation_policy_sha256\",\n            \"serialization_policy_sha256\",\n        ):\n            producer[field] = _hash(f\"unretained-{field}\")\n        producer = relevance.finalize_producer_identity(producer)\n        producer_raw = _raw(producer)\n        bindings = relevance._build_input_bindings(\n            self.case[\"engine_matrix_raw\"],\n            self.case[\"engine_matrix\"],\n            self.case[\"engine_pins_raw\"],\n            self.case[\"engine_pins\"],\n            producer_raw,\n            producer,\n            self.case[\"fixture\"],\n            self.case[\"dataset_raw\"],\n            self.case[\"dataset\"],\n            self.case[\"membership_raw\"],\n            self.case[\"membership\"],\n        )\n        runs: list[bytes] = []\n        for raw in self.case[\"runs\"]:\n            run = json.loads(raw)\n            run[\"producer_identity\"] = copy.deepcopy(producer)\n            run[\"input_bindings\"] = copy.deepcopy(bindings)\n            runs.append(_raw(relevance.finalize_ranked_run(run)))\n        return producer_raw, runs\n\n    def test_metrics_and_per_engine_selection_are_deterministic(self) -> None:\n        report = self.evaluate()\n        self.assertEqual(report, self.evaluate())\n        self.assertEqual(\n            report[\"report_id\"],\n            \"entire-brain-offline-relevance-development-diagnostic-v1\",\n        )\n        self.assertEqual(report[\"report_sha256\"], relevance._self_hash(report, \"report_sha256\"))\n        self.assertEqual(report[\"producer_identity\"], self.case[\"producer_identity\"])\n        self.assertEqual(\n            report[\"input_bindings\"][\"producer_identity_file_sha256\"],\n            relevance.sha256_bytes(self.case[\"producer_identity_raw\"]),\n        )\n        self.assertEqual(\n            report[\"producer_identity\"][\"producer_identity_sha256\"],\n            relevance._self_hash(report[\"producer_identity\"], \"producer_identity_sha256\"),\n        )\n        self.assertEqual(len(report[\"evaluated_runs\"]), 6)\n        self.assertEqual(len(report[\"diagnostic_best_candidates\"]), 3)\n        self.assertEqual(len(report[\"selections\"]), 3)\n        first = report[\"evaluated_runs\"][0][\"candidates\"][0]\n        product = first[\"product\"]\n        oracle = first[\"oracle\"]\n        self.assertEqual(product[\"mean_recall_at_1\"], 0.5)\n        self.assertEqual(product[\"mean_recall_at_5\"], 1.0)\n        self.assertEqual(product[\"mean_recall_at_10\"], 1.0)\n        self.assertEqual(product[\"mean_mrr\"], 1.0)\n        self.assertEqual(product[\"mean_ndcg_at_10\"], 1.0)\n        self.assertEqual(product[\"mean_precision_at_k\"], 0.2)\n        self.assertEqual(product[\"null_false_positive_numerator\"], 0)\n        self.assertEqual(product[\"null_false_positive_denominator\"], 1)\n        self.assertEqual(product[\"null_query_false_positive_rate\"], 0.0)\n        self.assertEqual(product[\"maximum_cluster_occupancy\"], 1)\n        self.assertEqual(oracle[\"query_count\"], 1)\n        self.assertEqual(oracle[\"null_query_false_positive_rate\"], None)\n        self.assertTrue(first[\"threshold_conditions_met\"])\n        self.assertFalse(first[\"thresholds_passed\"])\n        for selection in report[\"selections\"]:\n            self.assertEqual(selection[\"status\"], \"non_authoritative\")\n            self.assertIsNone(selection[\"run_id\"])\n            self.assertIsNone(selection[\"run_sha256\"])\n            self.assertIsNone(selection[\"aggregation_rule\"])\n            self.assertIsNone(selection[\"k\"])\n            self.assertIsNone(selection[\"selection_sha256\"])\n        for diagnostic in report[\"diagnostic_best_candidates\"]:\n            self.assertEqual(diagnostic[\"status\"], \"diagnostic_best_candidate\")\n            self.assertEqual(diagnostic[\"k\"], 5)\n            self.assertTrue(diagnostic[\"threshold_conditions_met\"])\n            self.assertEqual(\n                diagnostic[\"aggregation_rule\"], \"best_rank_then_hit_count_v1\"\n            )\n        for evaluated in report[\"evaluated_runs\"]:\n            self.assertEqual(\n                evaluated[\"producer_identity_sha256\"],\n                report[\"producer_identity\"][\"producer_identity_sha256\"],\n            )\n\n    def test_decision_authority_is_explicit_and_fail_closed(self) -> None:\n        report = self.evaluate()\n        authority = report[\"decision_authority\"]\n        self.assertEqual(authority[\"status\"], \"diagnostic_unattested\")\n        self.assertFalse(authority[\"authoritative_thresholds_enabled\"])\n        verification_fields = (\n            \"producer_runner_bytes_verified\",\n            \"producer_code_bytes_verified\",\n            \"ranking_result_metadata_policy_bytes_verified\",\n            \"token_estimation_policy_bytes_verified\",\n            \"serialization_policy_bytes_verified\",\n            \"fact_metadata_catalog_verified\",\n            \"engine_evidence_verified\",\n            \"source_contract_verified\",\n        )\n        for field in verification_fields:\n            self.assertFalse(authority[field], field)\n        self.assertEqual(\n","exit_code":0,"duration":{"secs":0,"nanos":4083},"formatted_output":"#!/usr/bin/env python3\n\"\"\"Synthetic, offline-only contract tests for offline_relevance_eval.py.\"\"\"\n\nfrom __future__ import annotations\n\nimport copy\nimport hashlib\nimport json\nimport pathlib\nimport unittest\nfrom typing import Any, Callable\n\nimport offline_relevance_eval as relevance\nimport relevance_dataset as schema_validation\n\n\ndef _hash(label: str) -> str:\n    return hashlib.sha256(label.encode(\"utf-8\")).hexdigest()\n\n\ndef _raw(value: object) -> bytes:\n    return relevance.canonical_json(value)\n\n\ndef _result(fact_id: str, kind: str, cluster_id: str, tokens: int) -> dict[str, object]:\n    return {\n        \"fact_id\": fact_id,\n        \"fact_sha256\": _hash(fact_id),\n        \"kind\": kind,\n        \"cluster_id\": cluster_id,\n        \"eligible\": True,\n        \"estimated_tokens\": tokens,\n    }\n\n\ndef _synthetic_case() -> dict[str, Any]:\n    arms = [\n        {\n            \"id\": \"lexical\",\n            \"semantic\": False,\n            \"effective_engine_required\": \"lexical\",\n            \"namespace\": \"lexical-v1\",\n        },\n        {\n            \"id\": \"model2vec\",\n            \"semantic\": True,\n            \"effective_engine_required\": \"model2vec\",\n            \"namespace\": \"model2vec-v1\",\n        },\n        {\n            \"id\": \"embeddinggemma\",\n            \"semantic\": True,\n            \"effective_engine_required\": \"embeddinggemma\",\n            \"namespace\": \"embeddinggemma-v1\",\n        },\n    ]\n    engine_matrix = {\"matrix_id\": \"synthetic-matrix-v1\", \"arms\": arms}\n    engine_pins = {\n        \"pin_set_id\": \"synthetic-pins-v1\",\n        \"binary\": {\"binary_sha256\": _hash(\"binary\"), \"binary_size_bytes\": 4096},\n        \"engines\": {\n            \"lexical\": {\"dimension\": None},\n            \"model2vec\": {\"dimension\": 512},\n            \"embeddinggemma\": {\"dimension\": 768},\n        },\n    }\n    facts = [\n        {\n            \"fact_id\": \"positive-1\",\n            \"fact_sha256\": _hash(\"positive-1\"),\n            \"status\": \"active\",\n            \"provenance_session_ids\": [\"session-old\"],\n        },\n        {\n            \"fact_id\": \"positive-2\",\n            \"fact_sha256\": _hash(\"positive-2\"),\n            \"status\": \"active\",\n            \"provenance_session_ids\": [\"session-old\"],\n        },\n        {\n            \"fact_id\": \"distractor-1\",\n            \"fact_sha256\": _hash(\"distractor-1\"),\n            \"status\": \"active\",\n            \"provenance_session_ids\": [\"session-old\"],\n        },\n        {\n            \"fact_id\": \"irrelevant-1\",\n            \"fact_sha256\": _hash(\"irrelevant-1\"),\n            \"status\": \"active\",\n            \"provenance_session_ids\": [\"session-old\"],\n        },\n        {\n            \"fact_id\": \"future-1\",\n            \"fact_sha256\": _hash(\"future-1\"),\n            \"status\": \"active\",\n            \"provenance_session_ids\": [\"session-future\"],\n        },\n    ]\n    membership = {\n        \"fact_count\": len(facts),\n        \"active_fact_count\": len(facts),\n        \"facts\": facts,\n        \"session_dates\": {\n            \"session-old\": \"2026-01-01T00:00:00Z\",\n            \"session-future\": \"2026-03-01T00:00:00Z\",\n        },\n        \"eligibility_membership_root_sha256\": relevance._membership_root(facts),\n    }\n    fixture = {\n        \"schema_version\": 1,\n        \"fixture_id\": \"synthetic-development-fixture-v1\",\n        \"items\": [\n            {\n                \"query_id\": \"query-product\",\n                \"task_id\": \"task-product\",\n                \"query_source\": \"user_prompt_derived\",\n                \"null_query\": False,\n                \"query_text\": \"synthetic product query sentinel\",\n                \"temporal_cutoff\": \"2026-02-01T00:00:00Z\",\n                \"exclude_session_ids\": [],\n            },\n            {\n                \"query_id\": \"query-null\",\n                \"task_id\": \"task-null\",\n                \"query_source\": \"user_prompt_derived\",\n                \"null_query\": True,\n                \"query_text\": \"synthetic null query sentinel\",\n                \"temporal_cutoff\": \"2026-02-01T00:00:00Z\",\n                \"exclude_session_ids\": [],\n            },\n            {\n                \"query_id\": \"query-oracle\",\n                \"task_id\": \"task-oracle\",\n                \"query_source\": \"oracle_upper_bound\",\n                \"null_query\": False,\n                \"query_text\": \"synthetic oracle query sentinel\",\n                \"temporal_cutoff\": \"2026-02-01T00:00:00Z\",\n                \"exclude_session_ids\": [],\n            },\n        ],\n        \"fixture_sha256\": \"\",\n    }\n    fixture[\"fixture_sha256\"] = relevance._self_hash(fixture, \"fixture_sha256\")\n    product_judgments = [\n        {\n            \"fact_id\": \"positive-1\",\n            \"fact_sha256\": _hash(\"positive-1\"),\n            \"grade\": \"solving\",\n            \"kind\": \"decision\",\n            \"cluster_id\": \"cluster-positive-1\",\n        },\n        {\n            \"fact_id\": \"positive-2\",\n            \"fact_sha256\": _hash(\"positive-2\"),\n            \"grade\": \"relevant_alternative\",\n            \"kind\": \"procedure\",\n            \"cluster_id\": \"cluster-positive-2\",\n        },\n        {\n            \"fact_id\": \"distractor-1\",\n            \"fact_sha256\": _hash(\"distractor-1\"),\n            \"grade\": \"hard_topical_distractor\",\n            \"kind\": \"constraint\",\n            \"cluster_id\": \"cluster-distractor-1\",\n        },\n        {\n            \"fact_id\": \"irrelevant-1\",\n            \"fact_sha256\": _hash(\"irrelevant-1\"),\n            \"grade\": \"irrelevant\",\n            \"kind\": \"observation\",\n            \"cluster_id\": \"cluster-irrelevant-1\",\n        },\n    ]\n    dataset = {\n        \"schema_version\": 2,\n        \"dataset_id\": \"synthetic-offline-relevance-v2\",\n        \"development\": {\n            \"items\": [\n                {\n                    \"query_id\": \"query-product\",\n                    \"task_id\": \"task-product\",\n                    \"query_source\": \"user_prompt_derived\",\n                    \"null_query\": False,\n                    \"judgments\": product_judgments,\n                },\n                {\n                    \"query_id\": \"query-null\",\n                    \"task_id\": \"task-null\",\n                    \"query_source\": \"user_prompt_derived\",\n                    \"null_query\": True,\n                    \"judgments\": copy.deepcopy(product_judgments[2:]),\n                },\n                {\n                    \"query_id\": \"query-oracle\",\n                    \"task_id\": \"task-oracle\",\n                    \"query_source\": \"oracle_upper_bound\",\n                    \"null_query\": False,\n                    \"judgments\": [copy.deepcopy(product_judgments[0])],\n                },\n            ]\n        },\n    }\n    producer_identity = relevance.finalize_producer_identity(\n        {\n            \"schema_version\": 1,\n            \"schema\": relevance.PRODUCER_IDENTITY_SCHEMA,\n            \"producer_id\": \"synthetic-ranked-run-producer-v1\",\n            \"runner_sha256\": _hash(\"synthetic-runner-artifact\"),\n            \"producer_code_sha256\": _hash(\"synthetic-runner-code\"),\n            \"ranking_result_metadata_policy_id\": \"synthetic-result-metadata-v1\",\n            \"ranking_result_metadata_policy_sha256\": _hash(\n                \"synthetic-result-metadata-policy\"\n            ),\n            \"token_estimation_policy_id\": \"synthetic-token-estimation-v1\",\n            \"token_estimation_policy_sha256\": _hash(\n                \"synthetic-token-estimation-policy\"\n            ),\n            \"serialization_policy_id\": \"synthetic-serialization-v1\",\n            \"serialization_policy_sha256\": _hash(\"synthetic-serialization-policy\"),\n            \"producer_identity_sha256\": \"\",\n        }\n    )\n    engine_matrix_raw = _raw(engine_matrix)\n    engine_pins_raw = _raw(engine_pins)\n    producer_identity_raw = _raw(producer_identity)\n    dataset_raw = _raw(dataset)\n    membership_raw = _raw(membership)\n    bindings = relevance._build_input_bindings(\n        engine_matrix_raw,\n        engine_matrix,\n        engine_pins_raw,\n        engine_pins,\n        producer_identity_raw,\n        producer_identity,\n        fixture,\n        dataset_raw,\n        dataset,\n        membership_raw,\n        membership,\n    )\n    result_rows = [\n        _result(\"positive-1\", \"decision\", \"cluster-positive-1\", 10),\n        _result(\"positive-2\", \"procedure\", \"cluster-positive-2\", 20),\n        _result(\"distractor-1\", \"constraint\", \"cluster-distractor-1\", 30),\n        _result(\"irrelevant-1\", \"observation\", \"cluster-irrelevant-1\", 40),\n    ]\n    query_rows = [\n        {\n            \"query_id\": \"query-product\",\n            \"task_id\": \"task-product\",\n            \"query_source\": \"user_prompt_derived\",\n            \"null_query\": False,\n            \"telemetry\": {\n                \"active_fact_count\": 5,\n                \"eligible_fact_count\": 4,\n                \"temporal_exclusion_count\": 1,\n                \"delivered_count\": 4,\n                \"ranking_latency_ms\": 2.5,\n            },\n            \"ordered_results\": result_rows,\n        },\n        {\n            \"query_id\": \"query-null\",\n            \"task_id\": \"task-null\",\n            \"query_source\": \"user_prompt_derived\",\n            \"null_query\": True,\n            \"telemetry\": {\n                \"active_fact_count\": 5,\n                \"eligible_fact_count\": 4,\n                \"temporal_exclusion_count\": 1,\n                \"delivered_count\": 0,\n                \"ranking_latency_ms\": 1.0,\n            },\n            \"ordered_results\": [],\n        },\n        {\n            \"query_id\": \"query-oracle\",\n            \"task_id\": \"task-oracle\",\n            \"query_source\": \"oracle_upper_bound\",\n            \"null_query\": False,\n            \"telemetry\": {\n                \"active_fact_count\": 5,\n                \"eligible_fact_count\": 4,\n                \"temporal_exclusion_count\": 1,\n                \"delivered_count\": 1,\n                \"ranking_latency_ms\": 0.5,\n            },\n            \"ordered_results\": [copy.deepcopy(result_rows[0])],\n        },\n    ]\n    runs: list[bytes] = []\n    dimensions = {\"lexical\": None, \"model2vec\": 512, \"embeddinggemma\": 768}\n    for arm in arms:\n        arm_id = arm[\"id\"]\n        for aggregation in relevance.AGGREGATION_CANDIDATES:\n            semantic = bool(arm[\"semantic\"])\n            identity = {\n                \"arm_id\": arm_id,\n                \"effective_engine\": arm[\"effective_engine_required\"],\n                \"semantic\": semantic,\n                \"binary_sha256\": engine_pins[\"binary\"][\"binary_sha256\"],\n                \"binary_size_bytes\": engine_pins[\"binary\"][\"binary_size_bytes\"],\n                \"vector_namespace\": arm[\"namespace\"],\n                \"vector_artifact_sha256\": _hash(f\"artifact-{arm_id}\") if semantic else None,\n                \"vector_artifact_size_bytes\": 8192 if semantic else None,\n                \"embedding_dimension\": dimensions[arm_id],\n                \"fallback_used\": False,\n            }\n            run = {\n                \"schema_version\": 1,\n                \"schema\": relevance.RANKED_RUN_SCHEMA,\n                \"run_id\": f\"run-{arm_id}-{aggregation}\",\n                \"created_at\": \"2026-04-01T00:00:00Z\",\n                \"input_bindings\": copy.deepcopy(bindings),\n                \"producer_identity\": copy.deepcopy(producer_identity),\n                \"engine_identity\": identity,\n                \"aggregation_rule\": aggregation,\n                \"k_candidates\": list(relevance.K_CANDIDATES),\n                \"queries\": copy.deepcopy(query_rows),\n                \"run_sha256\": \"\",\n            }\n            runs.append(_raw(relevance.finalize_ranked_run(run)))\n    return {\n        \"engine_matrix\": engine_matrix,\n        \"engine_matrix_raw\": engine_matrix_raw,\n        \"engine_pins\": engine_pins,\n        \"engine_pins_raw\": engine_pins_raw,\n        \"producer_identity\": producer_identity,\n        \"producer_identity_raw\": producer_identity_raw,\n        \"fixture\": fixture,\n        \"dataset\": dataset,\n        \"dataset_raw\": dataset_raw,\n        \"membership\": membership,\n        \"membership_raw\": membership_raw,\n        \"runs\": runs,\n    }\n\n\nclass OfflineRelevanceEvalTests(unittest.TestCase):\n    def setUp(self) -> None:\n        self.case: dict[str, Any] = _synthetic_case()\n\n    def evaluate(self, **overrides: Any) -> dict[str, Any]:\n        values: dict[str, Any] = {\n            \"engine_matrix_raw\": self.case[\"engine_matrix_raw\"],\n            \"engine_pins_raw\": self.case[\"engine_pins_raw\"],\n            \"producer_identity_raw\": self.case[\"producer_identity_raw\"],\n            \"fixture\": self.case[\"fixture\"],\n            \"dataset_raw\": self.case[\"dataset_raw\"],\n            \"source_membership_raw\": self.case[\"membership_raw\"],\n            \"ranked_run_raws\": self.case[\"runs\"],\n        }\n        values.update(overrides)\n        return relevance.evaluate(**values)\n\n    def mutate_run(\n        self, index: int, mutate: Callable[[dict[str, Any]], None]\n    ) -> list[bytes]:\n        runs = list(self.case[\"runs\"])\n        run = json.loads(runs[index])\n        mutate(run)\n        runs[index] = _raw(relevance.finalize_ranked_run(run))\n        return runs\n\n    def runs_with_unjudged_result(\n        self, *, cluster_id: str, estimated_tokens: int = 7\n    ) -> tuple[bytes, list[bytes]]:\n        membership = copy.deepcopy(self.case[\"membership\"])\n        membership[\"facts\"].append(\n            {\n                \"fact_id\": \"unjudged-1\",\n                \"fact_sha256\": _hash(\"unjudged-1\"),\n                \"status\": \"active\",\n                \"provenance_session_ids\": [\"session-old\"],\n            }\n        )\n        membership[\"fact_count\"] += 1\n        membership[\"active_fact_count\"] += 1\n        membership[\"eligibility_membership_root_sha256\"] = relevance._membership_root(\n            membership[\"facts\"]\n        )\n        membership_raw = _raw(membership)\n        bindings = relevance._build_input_bindings(\n            self.case[\"engine_matrix_raw\"],\n            self.case[\"engine_matrix\"],\n            self.case[\"engine_pins_raw\"],\n            self.case[\"engine_pins\"],\n            self.case[\"producer_identity_raw\"],\n            self.case[\"producer_identity\"],\n            self.case[\"fixture\"],\n            self.case[\"dataset_raw\"],\n            self.case[\"dataset\"],\n            membership_raw,\n            membership,\n        )\n        result = _result(\n            \"unjudged-1\", \"producer-supplied-kind\", cluster_id, estimated_tokens\n        )\n        runs: list[bytes] = []\n        for raw in self.case[\"runs\"]:\n            run = json.loads(raw)\n            run[\"input_bindings\"] = copy.deepcopy(bindings)\n            for query in run[\"queries\"]:\n                query[\"telemetry\"][\"active_fact_count\"] = 6\n                query[\"telemetry\"][\"eligible_fact_count\"] = 5\n                query[\"telemetry\"][\"temporal_exclusion_count\"] = 1\n            run[\"queries\"][0][\"ordered_results\"].append(copy.deepcopy(result))\n            run[\"queries\"][0][\"telemetry\"][\"delivered_count\"] = 5\n            runs.append(_raw(relevance.finalize_ranked_run(run)))\n        return membership_raw, runs\n\n    def coordinated_declared_producer(self) -> tuple[bytes, list[bytes]]:\n        producer = copy.deepcopy(self.case[\"producer_identity\"])\n        producer[\"producer_id\"] = \"coordinated-declaration-only-producer-v1\"\n        for field in (\n            \"runner_sha256\",\n            \"producer_code_sha256\",\n            \"ranking_result_metadata_policy_sha256\",\n            \"token_estimation_policy_sha256\",\n            \"serialization_policy_sha256\",\n        ):\n            producer[field] = _hash(f\"unretained-{field}\")\n        producer = relevance.finalize_producer_identity(producer)\n        producer_raw = _raw(producer)\n        bindings = relevance._build_input_bindings(\n            self.case[\"engine_matrix_raw\"],\n            self.case[\"engine_matrix\"],\n            self.case[\"engine_pins_raw\"],\n            self.case[\"engine_pins\"],\n            producer_raw,\n            producer,\n            self.case[\"fixture\"],\n            self.case[\"dataset_raw\"],\n            self.case[\"dataset\"],\n            self.case[\"membership_raw\"],\n            self.case[\"membership\"],\n        )\n        runs: list[bytes] = []\n        for raw in self.case[\"runs\"]:\n            run = json.loads(raw)\n            run[\"producer_identity\"] = copy.deepcopy(producer)\n            run[\"input_bindings\"] = copy.deepcopy(bindings)\n            runs.append(_raw(relevance.finalize_ranked_run(run)))\n        return producer_raw, runs\n\n    def test_metrics_and_per_engine_selection_are_deterministic(self) -> None:\n        report = self.evaluate()\n        self.assertEqual(report, self.evaluate())\n        self.assertEqual(\n            report[\"report_id\"],\n            \"entire-brain-offline-relevance-development-diagnostic-v1\",\n        )\n        self.assertEqual(report[\"report_sha256\"], relevance._self_hash(report, \"report_sha256\"))\n        self.assertEqual(report[\"producer_identity\"], self.case[\"producer_identity\"])\n        self.assertEqual(\n            report[\"input_bindings\"][\"producer_identity_file_sha256\"],\n            relevance.sha256_bytes(self.case[\"producer_identity_raw\"]),\n        )\n        self.assertEqual(\n            report[\"producer_identity\"][\"producer_identity_sha256\"],\n            relevance._self_hash(report[\"producer_identity\"], \"producer_identity_sha256\"),\n        )\n        self.assertEqual(len(report[\"evaluated_runs\"]), 6)\n        self.assertEqual(len(report[\"diagnostic_best_candidates\"]), 3)\n        self.assertEqual(len(report[\"selections\"]), 3)\n        first = report[\"evaluated_runs\"][0][\"candidates\"][0]\n        product = first[\"product\"]\n        oracle = first[\"oracle\"]\n        self.assertEqual(product[\"mean_recall_at_1\"], 0.5)\n        self.assertEqual(product[\"mean_recall_at_5\"], 1.0)\n        self.assertEqual(product[\"mean_recall_at_10\"], 1.0)\n        self.assertEqual(product[\"mean_mrr\"], 1.0)\n        self.assertEqual(product[\"mean_ndcg_at_10\"], 1.0)\n        self.assertEqual(product[\"mean_precision_at_k\"], 0.2)\n        self.assertEqual(product[\"null_false_positive_numerator\"], 0)\n        self.assertEqual(product[\"null_false_positive_denominator\"], 1)\n        self.assertEqual(product[\"null_query_false_positive_rate\"], 0.0)\n        self.assertEqual(product[\"maximum_cluster_occupancy\"], 1)\n        self.assertEqual(oracle[\"query_count\"], 1)\n        self.assertEqual(oracle[\"null_query_false_positive_rate\"], None)\n        self.assertTrue(first[\"threshold_conditions_met\"])\n        self.assertFalse(first[\"thresholds_passed\"])\n        for selection in report[\"selections\"]:\n            self.assertEqual(selection[\"status\"], \"non_authoritative\")\n            self.assertIsNone(selection[\"run_id\"])\n            self.assertIsNone(selection[\"run_sha256\"])\n            self.assertIsNone(selection[\"aggregation_rule\"])\n            self.assertIsNone(selection[\"k\"])\n            self.assertIsNone(selection[\"selection_sha256\"])\n        for diagnostic in report[\"diagnostic_best_candidates\"]:\n            self.assertEqual(diagnostic[\"status\"], \"diagnostic_best_candidate\")\n            self.assertEqual(diagnostic[\"k\"], 5)\n            self.assertTrue(diagnostic[\"threshold_conditions_met\"])\n            self.assertEqual(\n                diagnostic[\"aggregation_rule\"], \"best_rank_then_hit_count_v1\"\n            )\n        for evaluated in report[\"evaluated_runs\"]:\n            self.assertEqual(\n                evaluated[\"producer_identity_sha256\"],\n                report[\"producer_identity\"][\"producer_identity_sha256\"],\n            )\n\n    def test_decision_authority_is_explicit_and_fail_closed(self) -> None:\n        report = self.evaluate()\n        authority = report[\"decision_authority\"]\n        self.assertEqual(authority[\"status\"], \"diagnostic_unattested\")\n        self.assertFalse(authority[\"authoritative_thresholds_enabled\"])\n        verification_fields = (\n            \"producer_runner_bytes_verified\",\n            \"producer_code_bytes_verified\",\n            \"ranking_result_metadata_policy_bytes_verified\",\n            \"token_estimation_policy_bytes_verified\",\n            \"serialization_policy_bytes_verified\",\n            \"fact_metadata_catalog_verified\",\n            \"engine_evidence_verified\",\n            \"source_contract_verified\",\n        )\n        for field in verification_fields:\n            self.assertFalse(authority[field], field)\n        self.assertEqual(\n"},"started_at_ms":1789839528496,"completed_at_ms":1789839528497}}
{"timestamp":"2026-09-19T17:38:48.552Z","ordinal":7475,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0babf-d267-74b0-8f5e-98817a105662","call_id":"call_xeXEYOsCMKxDnFh7go3LzkWu","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"33ea1a\",\"wall_time_seconds\":0.000004083,\"exit_code\":0,\"original_token_count\":5029,\"output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Synthetic, offline-only contract tests for offline_relevance_eval.py.\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport copy\\nimport hashlib\\nimport json\\nimport pathlib\\nimport unittest\\nfrom typing import Any, Callable\\n\\nimport offline_relevance_eval as relevance\\nimport relevance_dataset as schema_validation\\n\\n\\ndef _hash(label: str) -> str:\\n    return hashlib.sha256(label.encode(\\\"utf-8\\\")).hexdigest()\\n\\n\\ndef _raw(value: object) -> bytes:\\n    return relevance.canonical_json(value)\\n\\n\\ndef _result(fact_id: str, kind: str, cluster_id: str, tokens: int) -> dict[str, object]:\\n    return {\\n        \\\"fact_id\\\": fact_id,\\n        \\\"fact_sha256\\\": _hash(fact_id),\\n        \\\"kind\\\": kind,\\n        \\\"cluster_id\\\": cluster_id,\\n        \\\"eligible\\\": True,\\n        \\\"estimated_tokens\\\": tokens,\\n    }\\n\\n\\ndef _synthetic_case() -> dict[str, Any]:\\n    arms = [\\n        {\\n            \\\"id\\\": \\\"lexical\\\",\\n            \\\"semantic\\\": False,\\n            \\\"effective_engine_required\\\": \\\"lexical\\\",\\n            \\\"namespace\\\": \\\"lexical-v1\\\",\\n        },\\n        {\\n            \\\"id\\\": \\\"model2vec\\\",\\n            \\\"semantic\\\": True,\\n            \\\"effective_engine_required\\\": \\\"model2vec\\\",\\n            \\\"namespace\\\": \\\"model2vec-v1\\\",\\n        },\\n        {\\n            \\\"id\\\": \\\"embeddinggemma\\\",\\n            \\\"semantic\\\": True,\\n            \\\"effective_engine_required\\\": \\\"embeddinggemma\\\",\\n            \\\"namespace\\\": \\\"embeddinggemma-v1\\\",\\n        },\\n    ]\\n    engine_matrix = {\\\"matrix_id\\\": \\\"synthetic-matrix-v1\\\", \\\"arms\\\": arms}\\n    engine_pins = {\\n        \\\"pin_set_id\\\": \\\"synthetic-pins-v1\\\",\\n        \\\"binary\\\": {\\\"binary_sha256\\\": _hash(\\\"binary\\\"), \\\"binary_size_bytes\\\": 4096},\\n        \\\"engines\\\": {\\n            \\\"lexical\\\": {\\\"dimension\\\": None},\\n            \\\"model2vec\\\": {\\\"dimension\\\": 512},\\n            \\\"embeddinggemma\\\": {\\\"dimension\\\": 768},\\n        },\\n    }\\n    facts = [\\n        {\\n            \\\"fact_id\\\": \\\"positive-1\\\",\\n            \\\"fact_sha256\\\": _hash(\\\"positive-1\\\"),\\n            \\\"status\\\": \\\"active\\\",\\n            \\\"provenance_session_ids\\\": [\\\"session-old\\\"],\\n        },\\n        {\\n            \\\"fact_id\\\": \\\"positive-2\\\",\\n            \\\"fact_sha256\\\": _hash(\\\"positive-2\\\"),\\n            \\\"status\\\": \\\"active\\\",\\n            \\\"provenance_session_ids\\\": [\\\"session-old\\\"],\\n        },\\n        {\\n            \\\"fact_id\\\": \\\"distractor-1\\\",\\n            \\\"fact_sha256\\\": _hash(\\\"distractor-1\\\"),\\n            \\\"status\\\": \\\"active\\\",\\n            \\\"provenance_session_ids\\\": [\\\"session-old\\\"],\\n        },\\n        {\\n            \\\"fact_id\\\": \\\"irrelevant-1\\\",\\n            \\\"fact_sha256\\\": _hash(\\\"irrelevant-1\\\"),\\n            \\\"status\\\": \\\"active\\\",\\n            \\\"provenance_session_ids\\\": [\\\"session-old\\\"],\\n        },\\n        {\\n            \\\"fact_id\\\": \\\"future-1\\\",\\n            \\\"fact_sha256\\\": _hash(\\\"future-1\\\"),\\n            \\\"status\\\": \\\"active\\\",\\n            \\\"provenance_session_ids\\\": [\\\"session-future\\\"],\\n        },\\n    ]\\n    membership = {\\n        \\\"fact_count\\\": len(facts),\\n        \\\"active_fact_count\\\": len(facts),\\n        \\\"facts\\\": facts,\\n        \\\"session_dates\\\": {\\n            \\\"session-old\\\": \\\"2026-01-01T00:00:00Z\\\",\\n            \\\"session-future\\\": \\\"2026-03-01T00:00:00Z\\\",\\n        },\\n        \\\"eligibility_membership_root_sha256\\\": relevance._membership_root(facts),\\n    }\\n    fixture = {\\n        \\\"schema_version\\\": 1,\\n        \\\"fixture_id\\\": \\\"synthetic-development-fixture-v1\\\",\\n        \\\"items\\\": [\\n            {\\n                \\\"query_id\\\": \\\"query-product\\\",\\n                \\\"task_id\\\": \\\"task-product\\\",\\n                \\\"query_source\\\": \\\"user_prompt_derived\\\",\\n                \\\"null_query\\\": False,\\n                \\\"query_text\\\": \\\"synthetic product query sentinel\\\",\\n                \\\"temporal_cutoff\\\": \\\"2026-02-01T00:00:00Z\\\",\\n                \\\"exclude_session_ids\\\": [],\\n            },\\n            {\\n                \\\"query_id\\\": \\\"query-null\\\",\\n                \\\"task_id\\\": \\\"task-null\\\",\\n                \\\"query_source\\\": \\\"user_prompt_derived\\\",\\n                \\\"null_query\\\": True,\\n                \\\"query_text\\\": \\\"synthetic null query sentinel\\\",\\n                \\\"temporal_cutoff\\\": \\\"2026-02-01T00:00:00Z\\\",\\n                \\\"exclude_session_ids\\\": [],\\n            },\\n            {\\n                \\\"query_id\\\": \\\"query-oracle\\\",\\n                \\\"task_id\\\": \\\"task-oracle\\\",\\n                \\\"query_source\\\": \\\"oracle_upper_bound\\\",\\n                \\\"null_query\\\": False,\\n                \\\"query_text\\\": \\\"synthetic oracle query sentinel\\\",\\n                \\\"temporal_cutoff\\\": \\\"2026-02-01T00:00:00Z\\\",\\n                \\\"exclude_session_ids\\\": [],\\n            },\\n        ],\\n        \\\"fixture_sha256\\\": \\\"\\\",\\n    }\\n    fixture[\\\"fixture_sha256\\\"] = relevance._self_hash(fixture, \\\"fixture_sha256\\\")\\n    product_judgments = [\\n        {\\n            \\\"fact_id\\\": \\\"positive-1\\\",\\n            \\\"fact_sha256\\\": _hash(\\\"positive-1\\\"),\\n            \\\"grade\\\": \\\"solving\\\",\\n            \\\"kind\\\": \\\"decision\\\",\\n            \\\"cluster_id\\\": \\\"cluster-positive-1\\\",\\n        },\\n        {\\n            \\\"fact_id\\\": \\\"positive-2\\\",\\n            \\\"fact_sha256\\\": _hash(\\\"positive-2\\\"),\\n            \\\"grade\\\": \\\"relevant_alternative\\\",\\n            \\\"kind\\\": \\\"procedure\\\",\\n            \\\"cluster_id\\\": \\\"cluster-positive-2\\\",\\n        },\\n        {\\n            \\\"fact_id\\\": \\\"distractor-1\\\",\\n            \\\"fact_sha256\\\": _hash(\\\"distractor-1\\\"),\\n            \\\"grade\\\": \\\"hard_topical_distractor\\\",\\n            \\\"kind\\\": \\\"constraint\\\",\\n            \\\"cluster_id\\\": \\\"cluster-distractor-1\\\",\\n        },\\n        {\\n            \\\"fact_id\\\": \\\"irrelevant-1\\\",\\n            \\\"fact_sha256\\\": _hash(\\\"irrelevant-1\\\"),\\n            \\\"grade\\\": \\\"irrelevant\\\",\\n            \\\"kind\\\": \\\"observation\\\",\\n            \\\"cluster_id\\\": \\\"cluster-irrelevant-1\\\",\\n        },\\n    ]\\n    dataset = {\\n        \\\"schema_version\\\": 2,\\n        \\\"dataset_id\\\": \\\"synthetic-offline-relevance-v2\\\",\\n        \\\"development\\\": {\\n            \\\"items\\\": [\\n                {\\n                    \\\"query_id\\\": \\\"query-product\\\",\\n                    \\\"task_id\\\": \\\"task-product\\\",\\n                    \\\"query_source\\\": \\\"user_prompt_derived\\\",\\n                    \\\"null_query\\\": False,\\n                    \\\"judgments\\\": product_judgments,\\n                },\\n                {\\n                    \\\"query_id\\\": \\\"query-null\\\",\\n                    \\\"task_id\\\": \\\"task-null\\\",\\n                    \\\"query_source\\\": \\\"user_prompt_derived\\\",\\n                    \\\"null_query\\\": True,\\n                    \\\"judgments\\\": copy.deepcopy(product_judgments[2:]),\\n                },\\n                {\\n                    \\\"query_id\\\": \\\"query-oracle\\\",\\n                    \\\"task_id\\\": \\\"task-oracle\\\",\\n                    \\\"query_source\\\": \\\"oracle_upper_bound\\\",\\n                    \\\"null_query\\\": False,\\n                    \\\"judgments\\\": [copy.deepcopy(product_judgments[0])],\\n                },\\n            ]\\n        },\\n    }\\n    producer_identity = relevance.finalize_producer_identity(\\n        {\\n            \\\"schema_version\\\": 1,\\n            \\\"schema\\\": relevance.PRODUCER_IDENTITY_SCHEMA,\\n            \\\"producer_id\\\": \\\"synthetic-ranked-run-producer-v1\\\",\\n            \\\"runner_sha256\\\": _hash(\\\"synthetic-runner-artifact\\\"),\\n            \\\"producer_code_sha256\\\": _hash(\\\"synthetic-runner-code\\\"),\\n            \\\"ranking_result_metadata_policy_id\\\": \\\"synthetic-result-metadata-v1\\\",\\n            \\\"ranking_result_metadata_policy_sha256\\\": _hash(\\n                \\\"synthetic-result-metadata-policy\\\"\\n            ),\\n            \\\"token_estimation_policy_id\\\": \\\"synthetic-token-estimation-v1\\\",\\n            \\\"token_estimation_policy_sha256\\\": _hash(\\n                \\\"synthetic-token-estimation-policy\\\"\\n            ),\\n            \\\"serialization_policy_id\\\": \\\"synthetic-serialization-v1\\\",\\n            \\\"serialization_policy_sha256\\\": _hash(\\\"synthetic-serialization-policy\\\"),\\n            \\\"producer_identity_sha256\\\": \\\"\\\",\\n        }\\n    )\\n    engine_matrix_raw = _raw(engine_matrix)\\n    engine_pins_raw = _raw(engine_pins)\\n    producer_identity_raw = _raw(producer_identity)\\n    dataset_raw = _raw(dataset)\\n    membership_raw = _raw(membership)\\n    bindings = relevance._build_input_bindings(\\n        engine_matrix_raw,\\n        engine_matrix,\\n        engine_pins_raw,\\n        engine_pins,\\n        producer_identity_raw,\\n        producer_identity,\\n        fixture,\\n        dataset_raw,\\n        dataset,\\n        membership_raw,\\n        membership,\\n    )\\n    result_rows = [\\n        _result(\\\"positive-1\\\", \\\"decision\\\", \\\"cluster-positive-1\\\", 10),\\n        _result(\\\"positive-2\\\", \\\"procedure\\\", \\\"cluster-positive-2\\\", 20),\\n        _result(\\\"distractor-1\\\", \\\"constraint\\\", \\\"cluster-distractor-1\\\", 30),\\n        _result(\\\"irrelevant-1\\\", \\\"observation\\\", \\\"cluster-irrelevant-1\\\", 40),\\n    ]\\n    query_rows = [\\n        {\\n            \\\"query_id\\\": \\\"query-product\\\",\\n            \\\"task_id\\\": \\\"task-product\\\",\\n            \\\"query_source\\\": \\\"user_prompt_derived\\\",\\n            \\\"null_query\\\": False,\\n            \\\"telemetry\\\": {\\n                \\\"active_fact_count\\\": 5,\\n                \\\"eligible_fact_count\\\": 4,\\n                \\\"temporal_exclusion_count\\\": 1,\\n                \\\"delivered_count\\\": 4,\\n                \\\"ranking_latency_ms\\\": 2.5,\\n            },\\n            \\\"ordered_results\\\": result_rows,\\n        },\\n        {\\n            \\\"query_id\\\": \\\"query-null\\\",\\n            \\\"task_id\\\": \\\"task-null\\\",\\n            \\\"query_source\\\": \\\"user_prompt_derived\\\",\\n            \\\"null_query\\\": True,\\n            \\\"telemetry\\\": {\\n                \\\"active_fact_count\\\": 5,\\n                \\\"eligible_fact_count\\\": 4,\\n                \\\"temporal_exclusion_count\\\": 1,\\n                \\\"delivered_count\\\": 0,\\n                \\\"ranking_latency_ms\\\": 1.0,\\n            },\\n            \\\"ordered_results\\\": [],\\n        },\\n        {\\n            \\\"query_id\\\": \\\"query-oracle\\\",\\n            \\\"task_id\\\": \\\"task-oracle\\\",\\n            \\\"query_source\\\": \\\"oracle_upper_bound\\\",\\n            \\\"null_query\\\": False,\\n            \\\"telemetry\\\": {\\n                \\\"active_fact_count\\\": 5,\\n                \\\"eligible_fact_count\\\": 4,\\n                \\\"temporal_exclusion_count\\\": 1,\\n                \\\"delivered_count\\\": 1,\\n                \\\"ranking_latency_ms\\\": 0.5,\\n            },\\n            \\\"ordered_results\\\": [copy.deepcopy(result_rows[0])],\\n        },\\n    ]\\n    runs: list[bytes] = []\\n    dimensions = {\\\"lexical\\\": None, \\\"model2vec\\\": 512, \\\"embeddinggemma\\\": 768}\\n    for arm in arms:\\n        arm_id = arm[\\\"id\\\"]\\n        for aggregation in relevance.AGGREGATION_CANDIDATES:\\n            semantic = bool(arm[\\\"semantic\\\"])\\n            identity = {\\n                \\\"arm_id\\\": arm_id,\\n                \\\"effective_engine\\\": arm[\\\"effective_engine_required\\\"],\\n                \\\"semantic\\\": semantic,\\n                \\\"binary_sha256\\\": engine_pins[\\\"binary\\\"][\\\"binary_sha256\\\"],\\n                \\\"binary_size_bytes\\\": engine_pins[\\\"binary\\\"][\\\"binary_size_bytes\\\"],\\n                \\\"vector_namespace\\\": arm[\\\"namespace\\\"],\\n                \\\"vector_artifact_sha256\\\": _hash(f\\\"artifact-{arm_id}\\\") if semantic else None,\\n                \\\"vector_artifact_size_bytes\\\": 8192 if semantic else None,\\n                \\\"embedding_dimension\\\": dimensions[arm_id],\\n                \\\"fallback_used\\\": False,\\n            }\\n            run = {\\n                \\\"schema_version\\\": 1,\\n                \\\"schema\\\": relevance.RANKED_RUN_SCHEMA,\\n                \\\"run_id\\\": f\\\"run-{arm_id}-{aggregation}\\\",\\n                \\\"created_at\\\": \\\"2026-04-01T00:00:00Z\\\",\\n                \\\"input_bindings\\\": copy.deepcopy(bindings),\\n                \\\"producer_identity\\\": copy.deepcopy(producer_identity),\\n                \\\"engine_identity\\\": identity,\\n                \\\"aggregation_rule\\\": aggregation,\\n                \\\"k_candidates\\\": list(relevance.K_CANDIDATES),\\n                \\\"queries\\\": copy.deepcopy(query_rows),\\n                \\\"run_sha256\\\": \\\"\\\",\\n            }\\n            runs.append(_raw(relevance.finalize_ranked_run(run)))\\n    return {\\n        \\\"engine_matrix\\\": engine_matrix,\\n        \\\"engine_matrix_raw\\\": engine_matrix_raw,\\n        \\\"engine_pins\\\": engine_pins,\\n        \\\"engine_pins_raw\\\": engine_pins_raw,\\n        \\\"producer_identity\\\": producer_identity,\\n        \\\"producer_identity_raw\\\": producer_identity_raw,\\n        \\\"fixture\\\": fixture,\\n        \\\"dataset\\\": dataset,\\n        \\\"dataset_raw\\\": dataset_raw,\\n        \\\"membership\\\": membership,\\n        \\\"membership_raw\\\": membership_raw,\\n        \\\"runs\\\": runs,\\n    }\\n\\n\\nclass OfflineRelevanceEvalTests(unittest.TestCase):\\n    def setUp(self) -> None:\\n        self.case: dict[str, Any] = _synthetic_case()\\n\\n    def evaluate(self, **overrides: Any) -> dict[str, Any]:\\n        values: dict[str, Any] = {\\n            \\\"engine_matrix_raw\\\": self.case[\\\"engine_matrix_raw\\\"],\\n            \\\"engine_pins_raw\\\": self.case[\\\"engine_pins_raw\\\"],\\n            \\\"producer_identity_raw\\\": self.case[\\\"producer_identity_raw\\\"],\\n            \\\"fixture\\\": self.case[\\\"fixture\\\"],\\n            \\\"dataset_raw\\\": self.case[\\\"dataset_raw\\\"],\\n            \\\"source_membership_raw\\\": self.case[\\\"membership_raw\\\"],\\n            \\\"ranked_run_raws\\\": self.case[\\\"runs\\\"],\\n        }\\n        values.update(overrides)\\n        return relevance.evaluate(**values)\\n\\n    def mutate_run(\\n        self, index: int, mutate: Callable[[dict[str, Any]], None]\\n    ) -> list[bytes]:\\n        runs = list(self.case[\\\"runs\\\"])\\n        run = json.loads(runs[index])\\n        mutate(run)\\n        runs[index] = _raw(relevance.finalize_ranked_run(run))\\n        return runs\\n\\n    def runs_with_unjudged_result(\\n        self, *, cluster_id: str, estimated_tokens: int = 7\\n    ) -> tuple[bytes, list[bytes]]:\\n        membership = copy.deepcopy(self.case[\\\"membership\\\"])\\n        membership[\\\"facts\\\"].append(\\n            {\\n                \\\"fact_id\\\": \\\"unjudged-1\\\",\\n                \\\"fact_sha256\\\": _hash(\\\"unjudged-1\\\"),\\n                \\\"status\\\": \\\"active\\\",\\n                \\\"provenance_session_ids\\\": [\\\"session-old\\\"],\\n            }\\n        )\\n        membership[\\\"fact_count\\\"] += 1\\n        membership[\\\"active_fact_count\\\"] += 1\\n        membership[\\\"eligibility_membership_root_sha256\\\"] = relevance._membership_root(\\n            membership[\\\"facts\\\"]\\n        )\\n        membership_raw = _raw(membership)\\n        bindings = relevance._build_input_bindings(\\n            self.case[\\\"engine_matrix_raw\\\"],\\n            self.case[\\\"engine_matrix\\\"],\\n            self.case[\\\"engine_pins_raw\\\"],\\n            self.case[\\\"engine_pins\\\"],\\n            self.case[\\\"producer_identity_raw\\\"],\\n            self.case[\\\"producer_identity\\\"],\\n            self.case[\\\"fixture\\\"],\\n            self.case[\\\"dataset_raw\\\"],\\n            self.case[\\\"dataset\\\"],\\n            membership_raw,\\n            membership,\\n        )\\n        result = _result(\\n            \\\"unjudged-1\\\", \\\"producer-supplied-kind\\\", cluster_id, estimated_tokens\\n        )\\n        runs: list[bytes] = []\\n        for raw in self.case[\\\"runs\\\"]:\\n            run = json.loads(raw)\\n            run[\\\"input_bindings\\\"] = copy.deepcopy(bindings)\\n            for query in run[\\\"queries\\\"]:\\n                query[\\\"telemetry\\\"][\\\"active_fact_count\\\"] = 6\\n                query[\\\"telemetry\\\"][\\\"eligible_fact_count\\\"] = 5\\n                query[\\\"telemetry\\\"][\\\"temporal_exclusion_count\\\"] = 1\\n            run[\\\"queries\\\"][0][\\\"ordered_results\\\"].append(copy.deepcopy(result))\\n            run[\\\"queries\\\"][0][\\\"telemetry\\\"][\\\"delivered_count\\\"] = 5\\n            runs.append(_raw(relevance.finalize_ranked_run(run)))\\n        return membership_raw, runs\\n\\n    def coordinated_declared_producer(self) -> tuple[bytes, list[bytes]]:\\n        producer = copy.deepcopy(self.case[\\\"producer_identity\\\"])\\n        producer[\\\"producer_id\\\"] = \\\"coordinated-declaration-only-producer-v1\\\"\\n        for field in (\\n            \\\"runner_sha256\\\",\\n            \\\"producer_code_sha256\\\",\\n            \\\"ranking_result_metadata_policy_sha256\\\",\\n            \\\"token_estimation_policy_sha256\\\",\\n            \\\"serialization_policy_sha256\\\",\\n        ):\\n            producer[field] = _hash(f\\\"unretained-{field}\\\")\\n        producer = relevance.finalize_producer_identity(producer)\\n        producer_raw = _raw(producer)\\n        bindings = relevance._build_input_bindings(\\n            self.case[\\\"engine_matrix_raw\\\"],\\n            self.case[\\\"engine_matrix\\\"],\\n            self.case[\\\"engine_pins_raw\\\"],\\n            self.case[\\\"engine_pins\\\"],\\n            producer_raw,\\n            producer,\\n            self.case[\\\"fixture\\\"],\\n            self.case[\\\"dataset_raw\\\"],\\n            self.case[\\\"dataset\\\"],\\n            self.case[\\\"membership_raw\\\"],\\n            self.case[\\\"membership\\\"],\\n        )\\n        runs: list[bytes] = []\\n        for raw in self.case[\\\"runs\\\"]:\\n            run = json.loads(raw)\\n            run[\\\"producer_identity\\\"] = copy.deepcopy(producer)\\n            run[\\\"input_bindings\\\"] = copy.deepcopy(bindings)\\n            runs.append(_raw(relevance.finalize_ranked_run(run)))\\n        return producer_raw, runs\\n\\n    def test_metrics_and_per_engine_selection_are_deterministic(self) -> None:\\n        report = self.evaluate()\\n        self.assertEqual(report, self.evaluate())\\n        self.assertEqual(\\n            report[\\\"report_id\\\"],\\n            \\\"entire-brain-offline-relevance-development-diagnostic-v1\\\",\\n        )\\n        self.assertEqual(report[\\\"report_sha256\\\"], relevance._self_hash(report, \\\"report_sha256\\\"))\\n        self.assertEqual(report[\\\"producer_identity\\\"], self.case[\\\"producer_identity\\\"])\\n        self.assertEqual(\\n            report[\\\"input_bindings\\\"][\\\"producer_identity_file_sha256\\\"],\\n            relevance.sha256_bytes(self.case[\\\"producer_identity_raw\\\"]),\\n        )\\n        self.assertEqual(\\n            report[\\\"producer_identity\\\"][\\\"producer_identity_sha256\\\"],\\n            relevance._self_hash(report[\\\"producer_identity\\\"], \\\"producer_identity_sha256\\\"),\\n        )\\n        self.assertEqual(len(report[\\\"evaluated_runs\\\"]), 6)\\n        self.assertEqual(len(report[\\\"diagnostic_best_candidates\\\"]), 3)\\n        self.assertEqual(len(report[\\\"selections\\\"]), 3)\\n        first = report[\\\"evaluated_runs\\\"][0][\\\"candidates\\\"][0]\\n        product = first[\\\"product\\\"]\\n        oracle = first[\\\"oracle\\\"]\\n        self.assertEqual(product[\\\"mean_recall_at_1\\\"], 0.5)\\n        self.assertEqual(product[\\\"mean_recall_at_5\\\"], 1.0)\\n        self.assertEqual(product[\\\"mean_recall_at_10\\\"], 1.0)\\n        self.assertEqual(product[\\\"mean_mrr\\\"], 1.0)\\n        self.assertEqual(product[\\\"mean_ndcg_at_10\\\"], 1.0)\\n        self.assertEqual(product[\\\"mean_precision_at_k\\\"], 0.2)\\n        self.assertEqual(product[\\\"null_false_positive_numerator\\\"], 0)\\n        self.assertEqual(product[\\\"null_false_positive_denominator\\\"], 1)\\n        self.assertEqual(product[\\\"null_query_false_positive_rate\\\"], 0.0)\\n        self.assertEqual(product[\\\"maximum_cluster_occupancy\\\"], 1)\\n        self.assertEqual(oracle[\\\"query_count\\\"], 1)\\n        self.assertEqual(oracle[\\\"null_query_false_positive_rate\\\"], None)\\n        self.assertTrue(first[\\\"threshold_conditions_met\\\"])\\n        self.assertFalse(first[\\\"thresholds_passed\\\"])\\n        for selection in report[\\\"selections\\\"]:\\n            self.assertEqual(selection[\\\"status\\\"], \\\"non_authoritative\\\")\\n            self.assertIsNone(selection[\\\"run_id\\\"])\\n            self.assertIsNone(selection[\\\"run_sha256\\\"])\\n            self.assertIsNone(selection[\\\"aggregation_rule\\\"])\\n            self.assertIsNone(selection[\\\"k\\\"])\\n            self.assertIsNone(selection[\\\"selection_sha256\\\"])\\n        for diagnostic in report[\\\"diagnostic_best_candidates\\\"]:\\n            self.assertEqual(diagnostic[\\\"status\\\"], \\\"diagnostic_best_candidate\\\")\\n            self.assertEqual(diagnostic[\\\"k\\\"], 5)\\n            self.assertTrue(diagnostic[\\\"threshold_conditions_met\\\"])\\n            self.assertEqual(\\n                diagnostic[\\\"aggregation_rule\\\"], \\\"best_rank_then_hit_count_v1\\\"\\n            )\\n        for evaluated in report[\\\"evaluated_runs\\\"]:\\n            self.assertEqual(\\n                evaluated[\\\"producer_identity_sha256\\\"],\\n                report[\\\"producer_identity\\\"][\\\"producer_identity_sha256\\\"],\\n            )\\n\\n    def test_decision_authority_is_explicit_and_fail_closed(self) -> None:\\n        report = self.evaluate()\\n        authority = report[\\\"decision_authority\\\"]\\n        self.assertEqual(authority[\\\"status\\\"], \\\"diagnostic_unattested\\\")\\n        self.assertFalse(authority[\\\"authoritative_thresholds_enabled\\\"])\\n        verification_fields = (\\n            \\\"producer_runner_bytes_verified\\\",\\n            \\\"producer_code_bytes_verified\\\",\\n            \\\"ranking_result_metadata_policy_bytes_verified\\\",\\n            \\\"token_estimation_policy_bytes_verified\\\",\\n            \\\"serialization_policy_bytes_verified\\\",\\n            \\\"fact_metadata_catalog_verified\\\",\\n            \\\"engine_evidence_verified\\\",\\n            \\\"source_contract_verified\\\",\\n        )\\n        for field in verification_fields:\\n            self.assertFalse(authority[field], field)\\n        self.assertEqual(\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba4f-3944-7ce3-88ac-4c7975e84b1b","create_time":1789839528.551936}}}
