_end_line': 74, 'language': 'JSON', 'kind': 'section', 'symbol_id': 'gh/entireio/entire-brain:JSON:benchmarks/agent-brain/confirmatory/schemas/negative-control-cache-bundle-verifier-contract-v2.schema.json:section:format_artifact', 'symbol_name': 'format_artifact', 'qualified_name': 'format_artifact', 'signature': 'json key format_artifact', 'signals': ['path', 'body', 'symbol-name'], 'snippet': '        \"format_artifact\": {'}, {'rank': 8, 'score': 20.5564, 'file_path': 'benchmarks/agent-brain/confirmatory/schemas/negative-control-cache-bundle-verification-report-v2.schema.json', 'start_line': 50, 'end_line': 50, 'focus_line': 50, 'snippet_start_line': 50, 'snippet_end_line': 50, 'symbol_start_line': 50, 'symbol_end_line': 50, 'language': 'JSON', 'kind': 'section', 'symbol_id': 'gh/entireio/entire-brain:JSON:benchmarks/agent-brain/confirmatory/schemas/negative-control-cache-bundle-verification-report-v2.schema.json:section:format_artifact_sha256', 'symbol_name': 'format_artifact_sha256', 'qualified_name': 'format_artifact_sha256', 'signature': 'json key format_artifact_sha256', 'signals': ['path', 'body', 'symbol-name'], 'snippet': '        \"format_artifact_sha256\": {'}, {'rank': 9, 'score': 20.3037, 'file_path': 'internal/cli/mcp.go', 'start_line': 2228, 'end_line': 2233, 'focus_line': 2228, 'snippet_start_line': 2228, 'snippet_end_line': 2229, 'symbol_start_line': 2228, 'symbol_end_line': 2233, 'language': 'Go', 'kind': 'function', 'symbol_id': 'gh/entireio/entire-brain:Go:internal/cli/mcp\nsymbols \nmatches \nquery embedded model binary format loader and model license provenance; confirmatory schema artifact validation entrypoints\nsummary \n"},"started_at_ms":1789840224272,"completed_at_ms":1789840263630}}
