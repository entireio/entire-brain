{"parentUuid":"26809e1d-ea47-43e1-9129-5fdbf648c2a9","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/suhaan/Documents/Coding/entire-brain/internal/tui/viewmodels.go","snippet":"1\tpackage tui\n2\t\n3\timport \"strings\"\n4\t\n5\t// Tab identifies a dashboard section. Home is the brain status/coverage view;\n6\t// the rest are entry browsers.\n7\ttype Tab int\n8\t\n9\tconst (\n10\t\tTabHome Tab = iota\n11\t\tTabFacts\n12\t\tTabSessions\n13\t\tTabHistory\n14\t\tTabSemantic\n15\t\tTabSearch\n16\t)\n17\t\n18\t// allTabs is the fixed left-to-right tab order.\n19\tvar allTabs = []Tab{TabHome, TabFacts, TabSessions, TabHistory, TabSemantic, TabSearch}\n20\t\n21\t// ParseTab resolves a tab name (case-insensitive), defaulting to Home for an\n22\t// empty or unknown name. The bool reports whether the name matched a known tab.\n23\tfunc ParseTab(name string) (Tab, bool) {\n24\t\tswitch strings.ToLower(strings.TrimSpace(name)) {\n25\t\tcase \"\", \"home\":\n26\t\t\treturn TabHome, name == \"\" || strings.EqualFold(strings.TrimSpace(name), \"home\")\n27\t\tcase \"facts\":\n28\t\t\treturn TabFacts, true\n29\t\tcase \"sessions\":\n30\t\t\treturn TabSessions, true\n31\t\tcase \"history\":\n32\t\t\treturn TabHistory, true\n33\t\tcase \"semantic\":\n34\t\t\treturn TabSemantic, true\n35\t\tcase \"search\":\n36\t\t\treturn TabSearch, true\n37\t\tdefault:\n38\t\t\treturn TabHome, false\n39\t\t}\n40\t}\n41\t\n42\tfunc (t Tab) String() string {\n43\t\tswitch t {\n44\t\tcase TabHome:\n45\t\t\treturn \"Home\"\n46\t\tcase TabFacts:\n47\t\t\treturn \"Facts\"\n48\t\tcase TabSessions:\n49\t\t\treturn \"Sessions\"\n50\t\tcase TabHistory:\n51\t\t\treturn \"History\"\n52\t\tcase TabSemantic:\n53\t\t\treturn \"Semantic\"\n54\t\tcase TabSearch:\n55\t\t\treturn \"Search\"\n56\t\tdefault:\n57\t\t\treturn \"?\"\n58\t\t}\n59\t}\n60\t\n61\t// Snapshot is the read-only view of a built brain handed to the TUI. The cli\n62\t// layer assembles it from disk; the TUI never does file IO. All content is\n63\t// deterministic — derived from data the brain already stores, with no agent\n64\t// calls.\n65\ttype Snapshot struct {\n66\t\tRepo        string\n67\t\tBranch      string\n68\t\tGeneratedAt string\n69\t\tHome        HomeView\n70\t\tFacts       []FactView\n71\t\tSessions    []SessionView\n72\t\tHistory     []HistoryView\n73\t\tSemantic    []SemanticView\n74\t\t// Search holds the results of the most recent in-dashboard search (the `s`\n75\t\t// key). SearchQuery is the query that produced them, and SearchErr any error\n76\t\t// from running it. They start empty and update live as the user searches.\n77\t\tSearch      []SearchResult\n78\t\tSearchQuery string\n79\t\tSearchErr   string\n80\t\t// Notes records non-fatal context, e.g. capped lists (\"facts: showing 500\n81\t\t// of 1234\"), so truncation is never silent.\n82\t\tNotes []string\n83\t}\n84\t\n85\t// SearchResult is one hit from an in-dashboard search across facts, history, and\n86\t// docs (the same retrieval `entire brain search` runs).\n87\ttype SearchResult struct {\n88\t\tSource   string // fact | history | doc\n89\t\tID       string\n90\t\tPath     string // brain-relative (display)\n91\t\tHeading  string\n92\t\tLine     int\n93\t\tText     string\n94\t\tScore    float64\n95\t\tOpenPath string // absolute source path to open (\"\" if none)\n96\t\tOpenLine int\n97\t}\n98\t\n99\t// HomeView is the brain status/coverage summary rendered on the Home tab.\n100\ttype HomeView struct {\n101\t\tSources    []SourceHealth\n102\t\tFreshness  string // severity label (\"\" when unknown)\n103\t\tAxes       []FreshnessAxis\n104\t\tBlindSpots []string\n105\t\tWarnings   []string\n106\t\tLive       LiveState\n107\t}\n108\t\n109\ttype SourceHealth struct {\n110\t\tName    string // Seed, Sessions, Semantic, History, Facts\n111\t\tPresent bool\n112\t\tDetail  string // e.g. \"55 symbols · 8 files\"\n113\t}\n114\t\n115\ttype FreshnessAxis struct {\n116\t\tName   string\n117\t\tState  string\n118\t\tDetail string\n119\t}\n120\t\n121\ttype LiveState struct {\n122\t\tBranch  string\n123\t\tHead    string\n124\t\tDirty   bool\n125\t\tSummary string // \"3 staged · 1 untracked\" or \"clean\"\n126\t}\n127\t\n128\t// FactView is one durable fact for the Facts tab.\n129\ttype FactView struct {\n130\t\tID         string\n131\t\tKind       string\n132\t\tText       string\n133\t\tPaths      []string\n134\t\tLocus      []string\n135\t\tStatus     string\n136\t\tOrigin     string\n137\t\tConfidence string\n138\t\tRelated    []string\n139\t\tProvenance []Anchor\n140\t\tSource     string // absolute transcript path to open (\"\" if none)\n141\t\tSourceLine int\n142\t}\n143\t\n144\t// Anchor cites where a fact was derived from.\n145\ttype Anchor struct {\n146\t\tSessionID  string\n147\t\tCommit     string\n148\t\tTranscript string // brain-relative (display)\n149\t\tLine       int\n150\t\tVerified   bool\n151\t}\n152\t\n153\t// SessionView is one recorded session for the Sessions tab.\n154\ttype SessionView struct {\n155\t\tID          string\n156\t\tBranch      string\n157\t\tAgent       string\n158\t\tModel       string\n159\t\tKind        string\n160\t\tCreated     string\n161\t\tFiles       []string\n162\t\tInputTok    int\n163\t\tOutputTok   int\n164\t\tIntent      string\n165\t\tOutcome     string\n166\t\tCheckpoints int\n167\t\tSource      string // absolute transcript path to open (\"\" if none)\n168\t}\n169\t\n170\t// SemanticView is one code symbol for the Semantic tab.\n171\ttype SemanticView struct {\n172\t\tKind          string\n173\t\tName          string\n174\t\tQualifiedName string\n175\t\tFilePath      string // repo-relative (display)\n176\t\tStartLine     int\n177\t\tEndLine       int\n178\t\tSignature     string\n179\t\tLanguage      string\n180\t\tSource        string // absolute file path to open (\"\" if none)\n181\t\tSourceLine    int\n182\t}\n183\t\n184\t// HistoryView is one history record (decision/learning/...) for the History tab.\n185\ttype HistoryView struct {\n186\t\tID         string\n187\t\tKind       string\n188\t\tBranch     string\n189\t\tSummary    string\n190\t\tPath       string // brain-relative (display)\n191\t\tLine       int\n192\t\tSource     string // absolute transcript path to open (\"\" if none)\n193\t\tSourceLine int\n194\t}\n195\t\n196\t// count returns the number of rows on a tab. The Home tab lists the brain's\n197\t// sources, so it counts those.\n198\tfunc (s Snapshot) count(tab Tab) int {\n199\t\tswitch tab {\n200\t\tcase TabHome:\n201\t\t\treturn len(s.Home.Sources)\n202\t\tcase TabFacts:\n203\t\t\treturn len(s.Facts)\n204\t\tcase TabSessions:\n205\t\t\treturn len(s.Sessions)\n206\t\tcase TabHistory:\n207\t\t\treturn len(s.History)\n208\t\tcase TabSemantic:\n209\t\t\treturn len(s.Semantic)\n210\t\tcase TabSearch:\n211\t\t\treturn len(s.Search)\n212\t\tdefault:\n213\t\t\treturn 0\n214\t\t}\n215\t}\n216\t\n217\t// filterKey returns the lowercased text a row is matched against by the filter.\n218\tfunc (s Snapshot) filterKey(tab Tab, i int) string {\n219\t\tswitch tab {\n220\t\tcase TabHome:\n221\t\t\tif i >= 0 && i < len(s.Home.Sources) {\n222\t\t\t\treturn strings.ToLower(s.Home.Sources[i].Name + \" \" + s.Home.Sources[i].Detail)\n223\t\t\t}\n224\t\t\treturn \"\"\n225\t\tcase TabFacts:\n226\t\t\tf := s.Facts[i]\n227\t\t\treturn strings.ToLower(f.Kind + \" \" + f.Text + \" \" + strings.Join(f.Paths, \" \") + \" \" + strings.Join(f.Locus, \" \"))\n228\t\tcase TabSessions:\n229\t\t\tv := s.Sessions[i]\n230\t\t\treturn strings.ToLower(v.Agent + \" \" + v.Model + \" \" + v.ID + \" \" + v.Intent + \" \" + v.Outcome)\n231\t\tcase TabHistory:\n232\t\t\th := s.History[i]\n233\t\t\treturn strings.ToLower(h.Kind + \" \" + h.Summary + \" \" + h.Branch)\n234\t\tcase TabSemantic:\n235\t\t\tv := s.Semantic[i]\n236\t\t\treturn strings.ToLower(v.Kind + \" \" + v.Name + \" \" + v.QualifiedName + \" \" + v.FilePath + \" \" + v.Language)\n237\t\tcase TabSearch:\n238\t\t\tr := s.Search[i]\n239\t\t\treturn strings.ToLower(r.Source + \" \" + r.Text + \" \" + r.Path + \" \" + r.Heading)\n240\t\tdefault:\n241\t\t\treturn \"\"\n242\t\t}\n243\t}\n244\t\n245\t// openTarget returns the absolute source path and 1-based line to open for the\n246\t// entry at index i on a tab, or (\"\", 0) when there is nothing to open.\n247\tfunc (s Snapshot) openTarget(tab Tab, i int) (string, int) {\n248\t\tswitch tab {\n249\t\tcase TabFacts:\n250\t\t\tif i >= 0 && i < len(s.Facts) {\n251\t\t\t\treturn s.Facts[i].Source, s.Facts[i].SourceLine\n252\t\t\t}\n253\t\tcase TabSessions:\n254\t\t\tif i >= 0 && i < len(s.Sessions) {\n255\t\t\t\treturn s.Sessions[i].Source, 0\n256\t\t\t}\n257\t\tcase TabHistory:\n258\t\t\tif i >= 0 && i < len(s.History) {\n259\t\t\t\treturn s.History[i].Source, s.History[i].SourceLine\n260\t\t\t}\n261\t\tcase TabSemantic:\n262\t\t\tif i >= 0 && i < len(s.Semantic) {\n263\t\t\t\treturn s.Semantic[i].Source, s.Semantic[i].SourceLine\n264\t\t\t}\n265\t\tcase TabSearch:\n266\t\t\tif i >= 0 && i < len(s.Search) {\n267\t\t\t\treturn s.Search[i].OpenPath, s.Search[i].OpenLine\n268\t\t\t}\n269\t\t}\n270\t\treturn \"\", 0\n271\t}"},"type":"attachment","uuid":"61a81523-e73a-4994-83f5-c1353d0e5783","timestamp":"2026-06-17T14:37:44.502Z","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/Documents/Coding/entire-brain","sessionId":"af861ed9-9e1d-41a7-8400-b53c2995aed8","version":"2.1.177","gitBranch":"claude/brain-dash-tui","slug":"zippy-floating-lovelace"}
