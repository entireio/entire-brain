      string\n58-\tRepoRoot        string\n59-\tPluginConfigDir string\n60-\tPluginDataDir   string\n61-\tPluginStateDir  string\n62-\tPluginCacheDir  string\n63-}\n64-\n65-func EnvFromOS() EntireEnv {\n66-\treturn EntireEnv{\n67-\t\tCLIVersion:      os.Getenv(envCLIVersion),\n68-\t\tRepoRoot:        os.Getenv(envRepoRoot),\n69-\t\tPluginConfigDir: os.Getenv(envPluginConfigDir),\n70-\t\tPluginDataDir:   os.Getenv(envPluginDataDir),\n71-\t\tPluginStateDir:  os.Getenv(envPluginStateDir),\n=== exportRepoDir ===\nexport.go:409:func exportRepoDir(env EntireEnv) (string, error) {\nexport.go-410-\tif env.RepoRoot != \"\" {\nexport.go-411-\t\treturn env.RepoRoot, nil\nexport.go-412-\t}\nexport.go-413-\twd, err := os.Getwd()\nexport.go-414-\tif err != nil {\nexport.go-415-\t\treturn \"\", fmt.Errorf(\"get current directory: %w\", err)\nexport.go-416-\t}\nexport.go-417-\treturn wd, nil\nexport.go-418-}\nexport.go-419-\nexport.go-420-func prepareExportDir(path string, allowExisting bool) (string, error) {\nexport.go-421-\tvar abs string\nexport.go-422-\tvar err error\nexport.go-423-\tif allowExisting {\nexport.go-424-\t\tabs, err = filepath.Abs(path)\n=== retrieveUnified signature ===\n48:func retrieveUnified(brainDir, branch, query string, limit int, mode retrievalMode) ([]unifiedResult, error) {\n=== EnvFromOS / RepoRoot field usage ===\n21:\tenvRepoRoot        = \"ENTIRE_REPO_ROOT\"\n58:\tRepoRoot        string\n68:\t\tRepoRoot:        os.Getenv(envRepoRoot),","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"6eed3ceb-599d-4d30-94da-77471dd165eb","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/Documents/Coding/entire-brain/internal/cli","sessionId":"af861ed9-9e1d-41a7-8400-b53c2995aed8","version":"2.1.177","gitBranch":"claude/brain-dash-tui","slug":"zippy-floating-lovelace"}
