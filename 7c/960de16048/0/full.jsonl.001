n// opening on startTab. search may be nil to disable in-dashboard search. It\n// blocks until the user quits.\nfunc Run(snap Snapshot, theme Theme, search SearchFunc, startTab Tab, out io.Writer) error {\n\tm := NewModel(snap, theme)\n\tm.searchFn = search\n\tif startTab != TabHome {\n\t\tm.tab = startTab\n\t\tm.rebuildVisible()\n\t}\n\tp := tea.NewProgram(m,\n\t\ttea.WithAltScreen(), tea.WithMouseCellMotion(), tea.WithOutput(out))\n\t_, err := p.Run()\n\treturn err\n}","originalFile":null,"structuredPatch":[{"oldStart":73,"oldLines":6,"newStart":73,"newLines":10,"lines":["   ti.Prompt = \"filter: \"","   ti.CharLimit = 64"," ","+  si := textinput.New()","+  si.Prompt = \"search: \"","+  si.CharLimit = 256","+","   m := Model{","     snap:   snap,","     theme:  theme,"]},{"oldStart":81,"oldLines":6,"newStart":85,"newLines":7,"lines":["     table:  newBrainTable(theme),","     vp:     viewport.New(60, 20),","     filter: ti,","+    search: si,","     width:  100,","     height: 30,","     tab:    TabHome,"]},{"oldStart":90,"oldLines":9,"newStart":95,"newLines":11,"lines":[" }"," "," // Run builds and runs the dashboard program against out (a real terminal),","-// opening on startTab. It blocks until the user quits.","-func Run(snap Snapshot, theme Theme, startTab Tab, out io.Writer) error {","+// opening on startTab. search may be nil to disable in-dashboard search. It","+// blocks until the user quits.","+func Run(snap Snapshot, theme Theme, search SearchFunc, startTab Tab, out io.Writer) error {","   m := NewModel(snap, theme)","+  m.searchFn = search","   if startTab != TabHome {","     m.tab = startTab","     m.rebuildVisible()"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"af32f531-a973-4af1-a3c3-2474e9eb0084","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/Documents/Coding/entire-brain/internal/cli","sessionId":"af861ed9-9e1d-41a7-8400-b53c2995aed8","version":"2.1.177","gitBranch":"claude/brain-dash-tui","slug":"zippy-fl