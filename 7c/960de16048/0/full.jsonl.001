(key.WithKeys(\"q\", \"ctrl+c\"), key.WithHelp(\"q\", \"quit\")),\n\t}\n}\n\n// ShortHelp is the single-line help shown in the footer.\nfunc (k keyMap) ShortHelp() []key.Binding {\n\treturn []key.Binding{k.Up, k.Down, k.Enter, k.Section, k.Filter, k.Open, k.Help, k.Quit}\n}\n\n// FullHelp is the expanded help shown when ? is toggled.\nfunc (k keyMap) FullHelp() [][]key.Binding {\n\treturn [][]key.Binding{\n\t\t{k.Up, k.Down, k.Enter, k.Back},\n\t\t{k.Section, k.PrevTab, k.Filter, k.Open},\n\t\t{k.Help, k.Quit},\n\t}\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"9e3ab88c-d643-4c35-9843-d0a360c88587","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/Documents/Coding/entire-brain","sessionId":"af861ed9-9e1d-41a7-8400-b53c2995aed8","version":"2.1.177","gitBranch":"claude/brain-dash-tui","slug":"zippy-floating-lovelace"}
