nPath = brainRelPath(brainDir, r.Path)\n\t\t\t\tsr.OpenLine = r.Line\n\t\t\t}\n\t\t\tout = append(out, sr)\n\t\t}\n\t\treturn out, nil\n\t}\n}","originalFile":null,"structuredPatch":[{"oldStart":79,"oldLines":9,"newStart":79,"newLines":39,"lines":["     printDashPlain(cmd, snap)","     return nil","   }","-  return tui.Run(snap, resolveDashTheme(flags.theme), startTab, cmd.OutOrStdout())","+  return tui.Run(snap, resolveDashTheme(flags.theme), brainSearchFunc(brainDir, branch), startTab, cmd.OutOrStdout())"," }"," ","+// brainSearchFunc adapts the lexical retrieval (`entire brain search`) into the","+// callback the dashboard's `s` key invokes, so search runs the same code path as","+// the CLI verb while keeping the TUI free of file IO.","+func brainSearchFunc(brainDir, branch string) tui.SearchFunc {","+  return func(query string) ([]tui.SearchResult, error) {","+    results, err := retrieveUnified(brainDir, branch, query, dashSearchLimit, modeLexical)","+    if err != nil {","+      return nil, err","+    }","+    out := make([]tui.SearchResult, 0, len(results))","+    for _, r := range results {","+      sr := tui.SearchResult{","+        Source:  r.Source,","+        ID:      r.ID,","+        Path:    r.Path,","+        Heading: r.Heading,","+        Line:    r.Line,","+        Text:    r.Text,","+        Score:   r.Score,","+      }","+      if r.Path != \"\" {","+        sr.OpenPath = brainRelPath(brainDir, r.Path)","+        sr.OpenLine = r.Line","+      }","+      out = append(out, sr)","+    }","+    return out, nil","+  }","+}","+"," // assembleBrainSnapshot is the only place that touches the brain on disk. It"," // reuses the existing loaders to build a read-only tui.Snapshot; no agent calls."," func assembleBrainSnapshot(ctx context.Context, opts Options, target, repoDir, brainDir, branch string, limit int) (tui.Snapshot, error) {"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"a7caf187-34a2-4ff5-83ba-f2070e8550c6","userType":"ex