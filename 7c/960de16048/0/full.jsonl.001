mantic\")\n790\t\t\tif p := s.Provider; p != nil && p.Name != \"\" {\n791\t\t\t\tfmt.Fprintf(out, \"  provider: %s %s (schema %s)\\n\", p.Name, p.Version, p.Schema)\n792\t\t\t}\n793\t\t\tif c := s.Coverage; c != nil {\n794\t\t\t\tfmt.Fprintf(out, \"  coverage: %d files, %d symbols, %d relations, %d warnings, %d partial failures\\n\",\n795\t\t\t\t\tc.Files, c.Symbols, c.Relations, c.Warnings, c.PartialFailures)\n796\t\t\t\tif len(c.FileLanguages) > 0 {\n797\t\t\t\t\tfmt.Fprintf(out, \"  file languages: %s\\n\", semanticAuditCountSummary(c.FileLanguages))\n798\t\t\t\t}\n799\t\t\t\tif len(c.Languages) > 0 {\n800\t\t\t\t\tfmt.Fprintf(out, \"  symbol languages: %s\\n\", semanticAuditCountSummary(c.Languages))\n801\t\t\t\t}\n802\t\t\t\tif len(c.RelationTypes) > 0 {\n803\t\t\t\t\tfmt.Fprintf(out, \"  relation types: %s\\n\", semanticAuditCountSummary(c.RelationTypes))\n804\t\t\t\t}\n805\t\t\t\tfor _, warning := range c.WarningDetails {\n806\t\t\t\t\tfmt.Fprintf(out, \"  warning: %s\\n\", semanticAuditWarningSummary(warning))\n807\t\t\t\t}\n808\t\t\t\tfor _, failure := range c.PartialFailureDetails {\n809\t\t\t\t\tfmt.Fprintf(out, \"  partial failure: %s\\n\", semanticAuditWarningSummary(failure))\n810\t\t\t\t}\n811\t\t\t}\n812\t\t\tif f := s.Freshness; f != nil {\n813\t\t\t\tfmt.Fprintf(out, \"  freshness: %s\\n\", f.Severity)\n814\t\t\t\tkeys := make([]string, 0, len(f.Axes))\n815\t\t\t\tfor key := range f.Axes {\n816\t\t\t\t\tkeys = append(keys, key)\n817\t\t\t\t}\n818\t\t\t\tsort.Strings(keys)\n819\t\t\t\tfor _, key := range keys {\n820\t\t\t\t\taxis := f.Axes[key]\n821\t\t\t\t\tline := \"    \" + key + \": \" + axis.State\n822\t\t\t\t\tif axis.Detail != \"\" {\n823\t\t\t\t\t\tline += \" (\" + axis.Detail + \")\"\n824\t\t\t\t\t}\n825\t\t\t\t\tfmt.Fprintln(out, line)\n826\t\t\t\t}\n827\t\t\t}\n828\t\t\t// Coverage is only populated by the status command's detail pass, which\n829\t\t\t// also fills blind spots — so its presence distinguishes \"checked, none"}]},"uuid":"96