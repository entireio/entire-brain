-// clearAllSessionCookies sets Max-Age=0 on the three browser cookies
-// COR-310 introduced (__Host-login, __Host-refresh) plus the existing
-// idp_session cookie. Called unconditionally on end-session — a
-// half-cleared client (some cookies kept, some deleted) ends up
-// fully consistent on the next response either way.
-func (s *Server) clearAllSessionCookies(w http.ResponseWriter) {
-	if s.loginCookie != nil {
-		s.loginCookie.Clear(w)
-	}
-	if s.refreshCookie != nil {
-		s.refreshCookie.Clear(w)
-	}
-	if s.idpCookie != nil {
-		s.idpCookie.Clear(w)
-	}
-}
