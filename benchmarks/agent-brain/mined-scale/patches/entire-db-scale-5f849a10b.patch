-// DeleteAndReturnFamily atomically deletes the session row and returns
-// the (account_id, refresh_family_id) it carried, in one round trip.
-// Used by /api/auth/end-session (COR-325) so the handler can call
-// RefreshStore.RevokeFamily on the returned family without racing a
-// second concurrent end-session that's already deleted the row.
-//
-// ok=false means the row was already gone (or never existed) — that's
-// the idempotent-logout case; the caller treats it as success and
-// still emits the cookie-clear headers. err is non-nil only for
-// transport / SQL failure. familyID is "" for sessions that were
-// created without a refresh family (pre-migration-015 rows or the
-// system-login paths that mint fid-less sessions); callers must
-// skip RevokeFamily in that case rather than calling it with "".
-func (s *SessionStore) DeleteAndReturnFamily(ctx context.Context, sessionID string) (model.AccountID, string, bool, error) {
-	var (
-		accountID model.AccountID
-		familyID  string
-	)
-	err := s.pool.QueryRow(ctx,
-		fmt.Sprintf(`DELETE FROM %s WHERE id = $1 RETURNING account_id, refresh_family_id`, s.tableName),
-		sessionID,
-	).Scan(&accountID, &familyID)
-	if err != nil {
-		if errors.Is(err, pgx.ErrNoRows) {
-			return "", "", false, nil
-		}
-		return "", "", false, fmt.Errorf("delete session and return family: %w", err)
-	}
-	return accountID, familyID, true, nil
-}
