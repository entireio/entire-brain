-		// stripped-down fallback paths (handleProviderRegionalCallback
-		// or the WorkOS callback) when the three-tier deps weren't
-		// fully wired, or it's a pre-migration-015 row. No refresh
-		// family was ever linked, so there's nothing to revoke. Info
-		// rather than warn — this is a legitimate state, just not
-		// the common one.
-		slogutil.Info(ctx, "logout for fid-less session — skipping RevokeFamily",
-			slog.String("outcome", "fid_less_skipped"),
-			slog.String("account_id", accountID.String()),
-			slog.String("session_id", sessionID))
