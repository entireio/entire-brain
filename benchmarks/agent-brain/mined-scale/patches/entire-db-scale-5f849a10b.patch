-// `outcome` attribute so observability can alert on the case where
-// cookies cleared but the refresh family is still alive — that's a
-// real failure mode (the user thinks they're logged out but their
-// refresh family lives until natural expiry, up to 30d). The
-// user's intent to log out still wins at the cookie layer; the
-// outcome attribute is the signal SRE relies on to detect when the
-// downstream cleanup didn't.
-func (s *Server) terminateIdpSession(ctx context.Context, r *http.Request) {
-	if s.idpCookie == nil || s.idpSessionStore == nil {
-		return
