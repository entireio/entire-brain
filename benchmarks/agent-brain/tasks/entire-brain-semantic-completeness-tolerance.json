{
  "id": "entire-brain-semantic-completeness-tolerance",
  "repo": "entire-brain",
  "repo_path": "entire-brain",
  "conditions": ["no_brain", "semantic_brain", "full_brain"],
  "copy_checkpoint_ref_from_source": true,
  "prompt": "Restore the semantic freshness behavior so a small number of tree-sitter parse-error files remains usable, while larger or non-parse failures still degrade the semantic index. Run the focused freshness/completeness tests before finishing.",
  "setup_replacements": [
    {
      "path": "internal/cli/semantic.go",
      "old": "const semanticParseErrorTolerance = 0.10",
      "new": "const semanticParseErrorTolerance = 0.00"
    }
  ],
  "validation": [
    "go test ./internal/cli -run 'TestSemanticCompletenessAxisToleratesFewParseErrors'"
  ],
  "hide_expected_from_agent": true,
  "hide_validation_from_agent": true,
  "agent_hidden_paths": ["benchmarks/agent-brain"],
  "leak_markers": ["full9-semantic-completeness-canary-20260722T1645Z"],
  "expected_files": ["internal/cli/semantic.go"],
  "forbidden_files": ["go.mod", "go.sum"],
  "brain_queries": ["benign parse errors tolerated fraction", "completeness axis degraded partial failures", "tree-sitter grammar version parse failure threshold", "few unparseable files should not degrade the index"]
}
