{
  "id": "entire-cli-review-base-flag-scope",
  "repo": "entire-cli",
  "repo_path": "cli",
  "conditions": ["no_brain", "semantic_brain", "full_brain"],
  "prompt": "Fix the review scope regression: `entire review --base <ref>` must use the explicit base ref when collecting checkpoint context and composing the agent prompt/banner. Preserve the existing review checkpoint context behavior.",
  "hide_expected_from_agent": true,
  "hide_validation_from_agent": true,
  "setup_replacements": [
    {
      "path": "cmd/entire/cli/review_context.go",
      "old": "scopeBaseRef+\"..HEAD\",",
      "new": "\"master..HEAD\","
    }
  ],
  "validation": [
    "test $(rg -n 'scopeBaseRef\\+\"\\.\\.HEAD\"' cmd/entire/cli/review_context.go | wc -l | tr -d ' ') -eq 1",
    "go test ./cmd/entire/cli -run 'TestReviewCommandSmoke_BaseFlagThreadsThroughToPromptAndBanner|TestReviewCheckpointContext_IncludesSummaryAndPromptFallback'"
  ],
  "expected_files": ["cmd/entire/cli/review_context.go"],
  "forbidden_files": ["go.mod", "go.sum"],
  "brain_queries": ["reviewContextCommitMessages", "scopeBaseRef", "BaseFlagThreadsThroughToPromptAndBanner"]
}
