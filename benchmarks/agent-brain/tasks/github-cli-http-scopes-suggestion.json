{
  "id": "github-cli-http-scopes-suggestion",
  "repo": "github-cli",
  "repo_path": "github-cli",
  "archetype": "architecture-localization",
  "conditions": ["no_brain", "semantic_brain"],
  "prompt": "Fix the HTTP error regression. When a 4xx response reports accepted OAuth scopes and the user's token lacks one, the wrapped HTTP error should keep the refresh-scope suggestion.",
  "hide_expected_from_agent": true,
  "hide_validation_from_agent": true,
  "setup_replacements": [
    {
      "path": "api/client.go",
      "old": "if tokenHasScopes == \"\" {\n\t\treturn \"\"\n\t}",
      "new": "if tokenHasScopes != \"\" {\n\t\treturn \"\"\n\t}"
    }
  ],
  "validation": [
    "go test ./api -run TestHTTPError_ScopesSuggestion"
  ],
  "leak_markers": [
    "full9-github-http-scopes-canary-20260722T1645Z"
  ],
  "expected_files": ["api/client.go"],
  "forbidden_files": ["go.mod", "go.sum"],
  "brain_queries": ["4xx error missing OAuth scope suggestion", "token lacks scope refresh hint", "suggestion to request additional OAuth scopes", "gh auth refresh advice in error message"]
}
