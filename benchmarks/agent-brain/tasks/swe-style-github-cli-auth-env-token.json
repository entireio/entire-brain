  "hide_validation_from_agent": true,
  "setup_replacements": [
    {
      "path": "pkg/cmdutil/auth_check.go",
      "old": "if cfg.Authentication().HasEnvToken() {\n\t\treturn true\n\t}",
      "new": "if cfg.Authentication().HasEnvToken() {\n\t\treturn false\n\t}"
    }
  ],
  "validation": [
    "go test ./pkg/cmdutil -run Test_CheckAuth"
  ],
  "expected_files": ["pkg/cmdutil/auth_check.go"],
  "forbidden_files": ["go.mod", "go.sum"],
  "brain_queries": ["environment token auth check", "HasEnvToken"]
}
