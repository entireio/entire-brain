{
  "id": "entire-brain-query-default-limit",
  "repo": "entire-brain",
  "repo_path": "entire-brain",
  "conditions": ["no_brain", "semantic_brain", "semantic_history_brain"],
  "copy_checkpoint_ref_from_source": true,
  "hide_expected_from_agent": true,
  "hide_validation_from_agent": true,
  "prompt": "Fix the query result-limit alias compatibility regression. The --limit and QMD-style -n flags should preserve equivalent defaults. Run the focused retrieval alias tests before finishing.",
  "setup_replacements": [
    {
      "path": "internal/cli/retrieve_cmd.go",
      "old": "cmd.Flags().IntVar(&limit, \"limit\", 10, \"Maximum results\")",
      "new": "cmd.Flags().IntVar(&limit, \"limit\", 2, \"Maximum results\")"
    }
  ],
  "validation": [
    "test $(go run ./cmd/entire-brain query --help | grep -c '(default 10)') -eq 2",
    "go test ./internal/cli -run 'TestQMDAliasesAcrossRetrievalVerbs|TestQMDOutputFormatAlias'"
  ],
  "expected_files": ["internal/cli/retrieve_cmd.go"],
  "forbidden_files": ["go.mod", "go.sum"],
  "agent_hidden_paths": ["benchmarks/agent-brain"],
  "leak_markers": ["EB_BENCH_CANARY_QUERY_LIMIT_91D2"],
  "brain_queries": ["newQueryCommand", "newRetrieveCommand", "QMD number alias"]
}
