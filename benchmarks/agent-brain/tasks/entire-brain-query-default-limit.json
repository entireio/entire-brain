{
  "id": "entire-brain-query-default-limit",
  "repo": "entire-brain",
  "repo_path": "entire-brain",
  "conditions": ["no_brain", "semantic_brain", "full_brain"],
  "copy_checkpoint_ref_from_source": true,
  "prompt": "Fix the unified query default-limit regression. The query command should keep its documented default result limit and its QMD-style -n alias. Run the focused retrieval alias tests before finishing.",
  "setup_replacements": [
    {
      "path": "internal/cli/retrieve_cmd.go",
      "old": "retrievalDefaultLimit = 5",
      "new": "retrievalDefaultLimit = 2"
    }
  ],
  "validation": [
    "test $(rg -n 'retrievalDefaultLimit = 5' internal/cli/retrieve_cmd.go | wc -l | tr -d ' ') -eq 1",
    "test $(rg -n 'IntVar\\(&limit, \"limit\", retrievalDefaultLimit' internal/cli/retrieve_cmd.go | wc -l | tr -d ' ') -eq 1",
    "test $(rg -n 'IntVarP\\(&limit, \"number\", \"n\", retrievalDefaultLimit' internal/cli/retrieve_cmd.go | wc -l | tr -d ' ') -eq 1",
    "go test ./internal/cli -run 'TestRetrievalCommandsDefaultToFiveCompactLocators|TestQMDAliasesAcrossRetrievalVerbs|TestQMDOutputFormatAlias'"
  ],
  "expected_files": ["internal/cli/retrieve_cmd.go"],
  "forbidden_files": ["go.mod", "go.sum"],
  "brain_queries": ["default result count for ranked retrieval", "ranked retrieval compact locators", "TestQMDAliasesAcrossRetrievalVerbs"]
}
