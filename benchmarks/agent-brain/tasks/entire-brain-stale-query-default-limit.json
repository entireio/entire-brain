{
  "id": "entire-brain-stale-query-default-limit",
  "repo": "entire-brain",
  "repo_path": "entire-brain",
  "conditions": ["no_brain", "semantic_brain", "full_brain"],
  "prompt": "Fix the unified query default-limit regression. A regression was applied after any prepared brain context, so do not trust semantic answers until you have checked freshness against the current checkout. The query command should keep its documented default result limit and its QMD-style -n alias. Run the focused retrieval alias tests before finishing.",
  "post_brain_replacements": [
    {
      "path": "internal/cli/retrieve_cmd.go",
      "old": "cmd.Flags().IntVar(&limit, \"limit\", 10, \"Maximum results\")",
      "new": "cmd.Flags().IntVar(&limit, \"limit\", 2, \"Maximum results\")"
    },
    {
      "path": "internal/cli/retrieve_cmd.go",
      "old": "cmd.Flags().IntVarP(&limit, \"number\", \"n\", 10, \"Maximum results (QMD-style alias for --limit)\")",
      "new": "cmd.Flags().IntVarP(&limit, \"number\", \"n\", 2, \"Maximum results (QMD-style alias for --limit)\")"
    }
  ],
  "validation": [
    "test $(rg -n 'IntVar\\(&limit, \"limit\", 10' internal/cli/retrieve_cmd.go | wc -l | tr -d ' ') -eq 1",
    "test $(rg -n 'IntVarP\\(&limit, \"number\", \"n\", 10' internal/cli/retrieve_cmd.go | wc -l | tr -d ' ') -eq 1",
    "go test ./internal/cli -run 'TestQMDAliasesAcrossRetrievalVerbs|TestQMDOutputFormatAlias'"
  ],
  "expected_files": ["internal/cli/retrieve_cmd.go"],
  "forbidden_files": ["go.mod", "go.sum"],
  "brain_queries": ["stale", "newQueryCommand", "newRetrieveCommand", "TestQMDAliasesAcrossRetrievalVerbs"]
}
