{
  "id": "github-cli-repo-name-trims-dotgit",
  "repo": "github-cli",
  "repo_path": "/Users/thomi/Projects/github-cli",
  "conditions": ["no_brain", "semantic_brain"],
  "prompt": "Fix the repository name normalization regression. Names entered with a trailing `.git` suffix should be normalized the same way GitHub's new-repository UI does.",
  "hide_expected_from_agent": true,
  "hide_validation_from_agent": true,
  "setup_replacements": [
    {
      "path": "pkg/cmd/repo/shared/repo.go",
      "old": "return strings.TrimSuffix(newName, \".git\")",
      "new": "return newName"
    }
  ],
  "validation": [
    "go test ./pkg/cmd/repo/shared -run TestNormalizeRepoName"
  ],
  "expected_files": ["pkg/cmd/repo/shared/repo.go"],
  "forbidden_files": ["go.mod", "go.sum"],
  "brain_queries": ["NormalizeRepoName", "invalidCharactersRE", "TrimSuffix"]
}
