{
  "schema": 1,
  "release_citable_suite_globs": [
    "release-candidate-*"
  ],
  "minimums": {
    "suites": 2,
    "records": 16,
    "proof_ready_comparisons": 2,
    "mcp_verified_records": 4,
    "mcp_named_tool_verified_records": 0,
    "hard_flags": 0
  },
  "min_repetitions_per_side": 4,
  "forbidden_suite_globs": [
    "release-local-*"
  ],
  "require_panel_provenance": true,
  "require_proof_ready_per_suite": true,
  "required_proof_scopes": [
    "history",
    "mcp"
  ],
  "required_named_tool_proof_scopes": [],
  "quarantine_note": "Historical, exploratory, and release-local suites in benchmarks/agent-brain/results are not release-citable until regenerated or copied into an explicit release-candidate-* suite and re-audited."
}
