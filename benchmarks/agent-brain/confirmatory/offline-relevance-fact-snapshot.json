    {
      "id": "fact:11af406c1bcd1c4994261a6c",
      "paths": [
        "constraints.git.behavior"
      ],
      "kind": "gotcha",
      "locus": [
        "fetch",
        "git",
        "git/config",
        "origin",
        "remote.\"<url-or-path>\".*",
        "remote.origin",
        "remote.origin.*",
        "repositoryformatversion"
      ],
      "text": "Git keys persisted partial-clone metadata to the exact fetch target identity: `git fetch origin` writes `remote.origin.*`, while fetching a literal URL or path can create a separate `remote.\"<url-or-path>\".*` promisor section and change `repositoryformatversion`; URL-based fetching avoids poisoning the named remote but does not guarantee zero `.git/config` changes.",
      "branch": "main",
      "origin": "distilled",
      "status": "active",
      "confidence": "1.00",
      "provenance": [
