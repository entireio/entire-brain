      "id": "fact:0539f87b0bf63eaf40ae9eec",
      "paths": [
        "constraints.authentication.flow"
      ],
      "kind": "closed-negative",
      "locus": [
        "/cli/auth",
        "/cli/auth?user_code=…",
        "cli/auth",
        "partial.to",
        "unified/proxied",
        "us.auth.partial.to",
        "user_code"
      ],
      "text": "Preserving the `/cli/auth?user_code=…` target across the `us.auth.partial.to` login redirect is insufficient for split-host device authorization: partial.to only accepts same-origin return paths and its `/cli/auth` uses a separate device-grant store, so fresh codes minted by entire-core are rejected as invalid; revisit cross-host redirecting only if partial.to safely allows trusted auth-host return URLs or the grant stores are unified/proxied.",
      "branch": "main",
      "origin": "distilled",
      "status": "active",
      "confidence": "1.00",
