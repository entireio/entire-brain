    {
      "id": "fact:f3d79fb1403f802256402f52",
      "paths": [
        "constraints.pagination.server"
      ],
      "kind": "closed-negative",
      "locus": [
        "limit",
        "page"
      ],
      "text": "Server-side search pagination was rejected as the TUI’s primary strategy because the worker applies `limit` as both page size and total-fetch cap, so `page` cannot expose additional results; the TUI requests the API maximum of 200 and paginates client-side, and server paging should be revisited only when the worker separates total retrieval from page size.",
      "branch": "main",
      "origin": "distilled",
      "status": "active",
      "confidence": "1.00",
