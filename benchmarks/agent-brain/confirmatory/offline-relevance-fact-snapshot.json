      "id": "fact:ebce57dacaa78919f1358d5d",
      "paths": [
        "architecture.data.flow"
      ],
      "kind": "decision",
      "locus": [
        "system/ide"
      ],
      "text": "Commit-link context uses the session’s most recent user prompt rather than its first prompt because it better represents the work being committed; both interactive and editor flows label it “Last Prompt,” use the session’s dynamic agent type, and strip injected system/IDE tags.",
      "branch": "main",
      "origin": "distilled",
