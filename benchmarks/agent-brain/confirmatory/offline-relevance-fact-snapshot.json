    {
      "id": "fact:f43f95628493822bad1fcda2",
      "paths": [
        "constraints.git.remote_config"
      ],
      "kind": "gotcha",
      "locus": [
        "remote.origin.partialclonefilter",
        "remote.origin.promisor"
      ],
      "text": "Users who ran the CLI after PR #712 and before commit d958ed408 may retain remote.origin.promisor=true and remote.origin.partialclonefilter=blob:none in local repository config; switching filtered fetches to origin URLs prevents new pollution but does not clean existing repositories, so a migration gated on the exact written pair remains necessary.",
      "branch": "main",
      "origin": "distilled",
