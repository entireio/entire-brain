{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entire.io/schemas/agent-brain/relevance-review-ledger-v1.json",
  "type": "object",
  "required": ["schema_version", "ledger_id", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "ledger_id": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "query_id", "task_id", "query_source", "reviewed_at", "reviewer", "review_method",
          "source_facts_sha256", "source_session_dates_sha256", "fact_membership_root_sha256",
          "active_fact_catalog_sha256", "session_date_membership_root_sha256",
          "decision_summary", "judgments"
        ],
        "properties": {
          "query_id": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "minLength": 1},
          "query_source": {"enum": ["user_prompt_derived", "oracle_upper_bound"]},
          "reviewed_at": {"type": "string", "format": "date-time"},
          "reviewer": {"type": "string", "minLength": 1},
          "review_method": {"const": "manual_judgment_from_exposed_prompt_and_pinned_membership_v1"},
          "source_facts_sha256": {"$ref": "#/$defs/sha256"},
          "source_session_dates_sha256": {"$ref": "#/$defs/sha256"},
          "fact_membership_root_sha256": {"$ref": "#/$defs/sha256"},
          "active_fact_catalog_sha256": {"$ref": "#/$defs/sha256"},
          "session_date_membership_root_sha256": {"$ref": "#/$defs/sha256"},
          "decision_summary": {"type": "string", "minLength": 1},
          "judgments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["fact_id", "fact_sha256", "grade", "cluster_id", "rationale"],
              "properties": {
                "fact_id": {"type": "string", "minLength": 1},
                "fact_sha256": {"$ref": "#/$defs/sha256"},
                "grade": {"enum": ["solving", "relevant_alternative", "hard_topical_distractor", "irrelevant"]},
                "cluster_id": {"type": "string", "minLength": 1},
                "rationale": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
