      "properties": {
        "entire-brain": { "type": "integer", "minimum": 1, "maximum": 250000 },
        "entire-db": { "type": "integer", "minimum": 1, "maximum": 250000 },
        "entire-graph": { "type": "integer", "minimum": 1, "maximum": 250000 }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    }
  }
