{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entire.io/schemas/agent-brain/relevance-source-membership-v1.json",
  "type": "object",
  "required": [
    "schema_version", "source_facts_sha256", "source_session_dates_sha256", "fact_count",
    "active_fact_count", "fact_membership_root_sha256", "active_fact_catalog_sha256", "facts",
    "session_date_count", "session_date_membership_root_sha256", "session_dates"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_facts_sha256": {"$ref": "#/$defs/sha256"},
    "source_session_dates_sha256": {"$ref": "#/$defs/sha256"},
    "fact_count": {"type": "integer", "minimum": 1},
    "active_fact_count": {"type": "integer", "minimum": 1},
    "fact_membership_root_sha256": {"$ref": "#/$defs/sha256"},
    "active_fact_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fact_id", "fact_sha256", "status"],
        "properties": {
          "fact_id": {"type": "string", "minLength": 1},
          "fact_sha256": {"$ref": "#/$defs/sha256"},
          "status": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "session_date_count": {"type": "integer", "minimum": 1},
    "session_date_membership_root_sha256": {"$ref": "#/$defs/sha256"},
    "session_dates": {
      "type": "object",
      "additionalProperties": {"type": "string", "format": "date-time"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
