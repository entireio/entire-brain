{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entire.io/schemas/agent-brain/task-inventory-v1.json",
  "type": "object",
  "required": ["schema_version", "inventory_id", "generated_at", "state_order", "summary", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "inventory_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "state_order": {"const": ["unseen", "prompt_inspected", "retrieval_probed", "agent_run", "optimization_used"]},
    "summary": {"type": "object"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "fix_commit", "source_split", "assigned_split", "confirmatory_eligible", "confirmatory_exclusion", "state", "state_recorded_at", "suite_references", "artifacts", "ledger"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "fix_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "source_split": {"enum": ["dev", "holdout"]},
          "assigned_split": {"enum": ["development", "secondary_validation", "confirmatory"]},
          "confirmatory_eligible": {"type": "boolean"},
          "confirmatory_exclusion": {"type": ["string", "null"]},
          "state": {"enum": ["unseen", "prompt_inspected", "retrieval_probed", "agent_run", "optimization_used"]},
          "state_recorded_at": {"type": "string", "format": "date-time"},
          "suite_references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "artifacts": {
            "type": "object",
            "required": ["config_path", "config_sha256", "prompt_sha256", "patch_path", "patch_sha256"],
            "properties": {
              "config_path": {"type": "string"},
              "config_sha256": {"$ref": "#/$defs/sha256"},
              "prompt_sha256": {"$ref": "#/$defs/sha256"},
              "patch_path": {"type": "string"},
              "patch_sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "ledger": {"type": "object", "required": ["present", "split"]}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": false
}
