{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entire.dev/schemas/agent-brain/pricing-budget.schema.json",
  "title": "Confirmatory pricing quote and paid-budget approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runner",
    "pricing_quote",
    "design",
    "token_assumptions",
    "calculation",
    "approval"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "runner": {"$ref": "#/$defs/nullableRunner"},
    "pricing_quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_uri",
        "source_artifact_path",
        "source_artifact_sha256",
        "as_of",
        "retrieved_at",
        "expires_at",
        "maximum_age_days",
        "currency",
        "tokens_per_price_unit",
        "prices_usd_per_unit"
      ],
      "properties": {
        "status": {"enum": ["pending", "pinned"]},
        "source_uri": {"type": ["string", "null"], "minLength": 1},
        "source_artifact_path": {"type": ["string", "null"], "minLength": 1},
        "source_artifact_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "as_of": {"type": ["string", "null"], "format": "date-time"},
        "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "maximum_age_days": {"type": ["integer", "null"], "minimum": 1},
        "currency": {"const": "USD"},
        "tokens_per_price_unit": {"const": 1000000},
        "prices_usd_per_unit": {"$ref": "#/$defs/nullablePrices"}
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "power_status_at_binding",
        "approved_for_budgeting",
        "tasks",
        "treatments",
        "repetitions_per_treatment",
        "requested_calls",
        "reserve_calls",
        "maximum_calls_with_reserve"
      ],
      "properties": {
        "protocol_id": {"type": "string", "minLength": 1},
        "power_status_at_binding": {"type": "string", "minLength": 1},
        "approved_for_budgeting": {"type": "boolean"},
        "tasks": {"type": "integer", "minimum": 1},
        "treatments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "repetitions_per_treatment": {"type": "integer", "minimum": 1},
        "requested_calls": {"type": "integer", "minimum": 1},
        "reserve_calls": {"type": "integer", "minimum": 0},
        "maximum_calls_with_reserve": {"type": "integer", "minimum": 1}
      }
    },
    "token_assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "explicit_per_call_caps", "empirical_bound"],
      "properties": {
        "mode": {"enum": [null, "explicit_per_call_caps", "empirical_bound"]},
        "explicit_per_call_caps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uncached_input", "cached_input", "output", "rationale"],
          "properties": {
            "uncached_input": {"$ref": "#/$defs/nullableTokenCount"},
            "cached_input": {"$ref": "#/$defs/nullableTokenCount"},
            "output": {"$ref": "#/$defs/nullableTokenCount"},
            "rationale": {"type": ["string", "null"], "minLength": 1}
          }
        },
        "empirical_bound": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runner",
            "evidence_path",
            "evidence_sha256",
            "statistic",
            "quantile",
            "safety_multiplier",
            "observed_tokens_per_call"
          ],
          "properties": {
            "runner": {
              "anyOf": [
                {"$ref": "#/$defs/nullableRunner"},
                {"type": "null"}
              ]
            },
            "evidence_path": {"type": ["string", "null"], "minLength": 1},
            "evidence_sha256": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-f]{64}$"
            },
            "statistic": {"type": ["string", "null"], "minLength": 1},
            "quantile": {
              "type": ["number", "null"],
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "safety_multiplier": {"$ref": "#/$defs/nullableDecimal"},
            "observed_tokens_per_call": {"$ref": "#/$defs/nullableTokenCounts"}
          }
        }
      }
    },
    "calculation": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "formula_id",
            "tokens_per_price_unit",
            "effective_tokens_per_call",
            "per_call_usd_by_category",
            "per_call_maximum_usd",
            "maximum_calls",
            "maximum_usd"
          ],
          "properties": {
            "formula_id": {"const": "worst_case_token_envelope_v1"},
            "tokens_per_price_unit": {"const": 1000000},
            "effective_tokens_per_call": {"$ref": "#/$defs/tokenCounts"},
            "per_call_usd_by_category": {"$ref": "#/$defs/prices"},
            "per_call_maximum_usd": {"$ref": "#/$defs/decimal"},
            "maximum_calls": {"type": "integer", "minimum": 1},
            "maximum_usd": {"$ref": "#/$defs/decimal"}
          }
        }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approved_cap_usd",
        "approved_by",
        "approver_role",
        "approved_at",
        "expires_at",
        "notes"
      ],
      "properties": {
        "status": {"enum": ["pending", "approved"]},
        "approved_cap_usd": {"$ref": "#/$defs/nullableDecimal"},
        "approved_by": {"type": ["string", "null"], "minLength": 1},
        "approver_role": {"type": ["string", "null"], "minLength": 1},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "nullableDecimal": {
      "type": ["string", "null"],
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "nullableTokenCount": {"type": ["integer", "null"], "minimum": 0},
    "tokenCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncached_input", "cached_input", "output"],
      "properties": {
        "uncached_input": {"type": "integer", "minimum": 0},
        "cached_input": {"type": "integer", "minimum": 0},
        "output": {"type": "integer", "minimum": 0}
      }
    },
    "nullableTokenCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncached_input", "cached_input", "output"],
      "properties": {
        "uncached_input": {"$ref": "#/$defs/nullableTokenCount"},
        "cached_input": {"$ref": "#/$defs/nullableTokenCount"},
        "output": {"$ref": "#/$defs/nullableTokenCount"}
      }
    },
    "prices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncached_input", "cached_input", "output"],
      "properties": {
        "uncached_input": {"$ref": "#/$defs/decimal"},
        "cached_input": {"$ref": "#/$defs/decimal"},
        "output": {"$ref": "#/$defs/decimal"}
      }
    },
    "nullablePrices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncached_input", "cached_input", "output"],
      "properties": {
        "uncached_input": {"$ref": "#/$defs/nullableDecimal"},
        "cached_input": {"$ref": "#/$defs/nullableDecimal"},
        "output": {"$ref": "#/$defs/nullableDecimal"}
      }
    },
    "nullableRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "runner_id", "runner_version", "model_id", "effort"],
      "properties": {
        "provider": {"type": ["string", "null"], "minLength": 1},
        "runner_id": {"type": ["string", "null"], "minLength": 1},
        "runner_version": {"type": ["string", "null"], "minLength": 1},
        "model_id": {"type": ["string", "null"], "minLength": 1},
        "effort": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
