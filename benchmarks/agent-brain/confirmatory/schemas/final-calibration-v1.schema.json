    "planning": {"$ref": "#/$defs/planning"},
    "identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "frozen"}}},
      "then": {
        "properties": {
          "evidence_class": {"const": "development_measurement"},
          "owner_approval_receipt_sha256": {"$ref": "#/$defs/sha256"}
        }
      },
      "else": {
        "properties": {"owner_approval_receipt_sha256": {"const": null}}
      }
    },
    {
      "if": {"properties": {"evidence_class": {"const": "development_measurement"}}},
      "then": {
        "properties": {
          "planning": {
            "properties": {
              "profile": {"const": "production_development_measurement_v1"},
              "resamples": {"const": 10000},
              "seed": {"const": 4990646119815267652},
              "candidate_task_clusters": {
                "const": [12, 16, 20, 24, 32, 40, 48, 64, 80, 96, 128, 160, 192, 256, 320, 384, 512]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "planning": {
            "properties": {"profile": {"const": "synthetic_fixture_test_v1"}}
          }
        }
      }
    }
  ],
