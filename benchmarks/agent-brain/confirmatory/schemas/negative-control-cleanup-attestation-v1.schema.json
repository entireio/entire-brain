{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entire.io/schemas/agent-brain/negative-control-cleanup-attestation-v1.json",
  "title": "Non-authorizing negative-control cleanup attestation v1",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "utc_second": {
      "type": "string",
      "pattern": "^(?:[0-9]{4})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_sha256",
    "authority",
    "bindings",
    "cleanup",
    "journal",
    "profile",
    "reservation_release",
    "schema_version",
    "status"
  ],
  "properties": {
    "attestation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authority": {
      "const": {
        "aggregate_receipt_authority": false,
        "benchmark_execution": "not_authorized_by_this_attestation",
        "candidate_execution": "not_authorized_by_this_attestation",
        "execution_authority": false,
        "model_provider_execution": "not_authorized_by_this_attestation",
        "paid_execution": "not_authorized_by_this_attestation",
        "recovery_authority": false
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atomic_consumption_genesis_sha256",
        "capacity_reservation_receipt_sha256",
        "execution_contract_artifact_sha256",
        "execution_contract_sha256",
        "run_id",
        "run_identity_sha256",
        "run_storage_contract_sha256"
      ],
      "properties": {
        "atomic_consumption_genesis_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capacity_reservation_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "execution_contract_artifact_sha256": {
          "const": "94422af8a5e24c6a855b66cf40868565ee3518d0c75eb5343b5d2450523b2c1e"
        },
        "execution_contract_sha256": {
          "const": "1e290b91d5e0be42f750bf0e655edee48d297f86ad3e3867b8fe9177fd5125ef"
        },
        "run_id": {
          "$ref": "#/$defs/sha256"
        },
        "run_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "run_storage_contract_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_implementation_sha256",
        "completed_at",
        "descriptor_relative",
        "disposable_run_root_removed",
        "failure_evidence_sha256",
        "inventory_after_sha256",
        "inventory_before_sha256",
        "nofollow_every_component",
        "path_policy",
        "postorder",
        "same_device",
        "unexpected_entry_count"
      ],
      "properties": {
        "adapter_implementation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "completed_at": {
          "$ref": "#/$defs/utc_second"
        },
        "descriptor_relative": {
          "const": true
        },
        "disposable_run_root_removed": {
          "type": "boolean"
        },
        "failure_evidence_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "inventory_after_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "inventory_before_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "nofollow_every_component": {
          "const": true
        },
        "path_policy": {
          "const": {
            "absolute_paths": "forbidden",
            "ancestor_conflicts": "forbidden",
            "backslash": "forbidden",
            "casefold_nfc_dot_dot_namedfork": "forbidden",
            "control_unicode_category_c": "forbidden",
            "descriptor_relative_only": true,
            "dot_or_dot_dot_component": "forbidden",
            "nul": "forbidden",
            "portable_collisions": "forbidden"
          }
        },
        "postorder": {
          "const": true
        },
        "same_device": {
          "const": true
        },
        "unexpected_entry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_record_sha256",
        "receipt_forbidden_latch",
        "recovery_mode",
        "schedule_cursor",
        "terminal_state"
      ],
      "properties": {
        "final_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_forbidden_latch": {
          "type": "boolean"
        },
        "recovery_mode": {
          "enum": [
            "normal_cleanup",
            "restart_cleanup_no_resume"
          ]
        },
        "schedule_cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 248
        },
        "terminal_state": {
          "enum": [
            "reservation_released",
            "cleaned_no_receipt",
            "cleanup_failed_latched"
          ]
        }
      }
    },
    "profile": {
      "const": "agent_brain_negative_control_cleanup_attestation_v1"
    },
    "reservation_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "released",
        "released_at",
        "release_evidence_sha256",
        "reservation_id"
      ],
      "properties": {
        "released": {
          "type": "boolean"
        },
        "released_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/utc_second"
            }
          ]
        },
        "release_evidence_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "reservation_id": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "cleanup_complete_reservation_released_record_only_not_receipt_authority",
        "cleanup_failed_latched_no_receipt"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "cleanup_complete_reservation_released_record_only_not_receipt_authority"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "cleanup": {
            "properties": {
              "disposable_run_root_removed": {
                "const": true
              },
              "failure_evidence_sha256": {
                "type": "null"
              },
              "unexpected_entry_count": {
                "const": 0
              }
            }
          },
          "journal": {
            "oneOf": [
              {
                "properties": {
                  "receipt_forbidden_latch": {
                    "const": false
                  },
                  "recovery_mode": {
                    "const": "normal_cleanup"
                  },
                  "terminal_state": {
                    "const": "reservation_released"
                  }
                }
              },
              {
                "properties": {
                  "receipt_forbidden_latch": {
                    "const": true
                  },
                  "recovery_mode": {
                    "const": "restart_cleanup_no_resume"
                  },
                  "terminal_state": {
                    "const": "cleaned_no_receipt"
                  }
                }
              }
            ]
          },
          "reservation_release": {
            "properties": {
              "released": {
                "const": true
              },
              "released_at": {
                "$ref": "#/$defs/utc_second"
              },
              "release_evidence_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "cleanup": {
            "properties": {
              "failure_evidence_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "journal": {
            "properties": {
              "receipt_forbidden_latch": {
                "const": true
              },
              "terminal_state": {
                "const": "cleanup_failed_latched"
              }
            }
          }
        }
      }
    }
  ]
}
