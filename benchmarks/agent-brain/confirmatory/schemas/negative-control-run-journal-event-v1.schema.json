{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entire.io/schemas/agent-brain/negative-control-run-journal-event-v1.json",
  "title": "Non-authorizing negative-control durable run-journal event v1",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "utc_second": {
      "type": "string",
      "pattern": "^(?:[0-9]{4})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "run_state": {
      "enum": [
        "contract_checked_execution_forbidden",
        "authority_and_inputs_verified",
        "capacity_reserved",
        "attempts_active",
        "run_cleaning",
        "reservation_released",
        "aggregate_receipt_committed",
        "run_aborting",
        "run_cleaning_no_receipt",
        "reservation_released_no_receipt",
        "cleaned_no_receipt",
        "cleanup_failed_latched"
      ]
    },
    "attempt_state": {
      "enum": [
        "attempt_bound",
        "attempt_staged",
        "attempt_running",
        "attempt_result_private",
        "attempt_cleaning",
        "attempt_cleanup_committed",
        "attempt_aborting",
        "cleanup_failed_latched"
      ]
    },
    "counter_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cache_bytes",
        "elapsed_wall_nanoseconds",
        "private_log_bytes",
        "public_receipt_bytes",
        "staging_bytes"
      ],
      "properties": {
        "cache_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        },
        "elapsed_wall_nanoseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 28800000000000
        },
        "private_log_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483648
        },
        "public_receipt_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "staging_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aggregate_accounting",
    "attempt_ordinal",
    "authority",
    "bindings",
    "event_kind",
    "external_effect",
    "occurred_at",
    "phase",
    "prepared_record_sha256",
    "previous_record_sha256",
    "profile",
    "receipt_forbidden_latch",
    "record_ordinal",
    "record_sha256",
    "schedule_cursor",
    "schema_version",
    "state",
    "status",
    "transition"
  ],
  "properties": {
    "aggregate_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after",
        "before",
        "durably_updated_before_cursor_advance"
      ],
      "properties": {
        "after": {
          "$ref": "#/$defs/counter_set"
        },
        "before": {
          "$ref": "#/$defs/counter_set"
        },
        "durably_updated_before_cursor_advance": {
          "const": true
        }
      }
    },
    "attempt_ordinal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 248
        }
      ]
    },
    "authority": {
      "const": {
        "aggregate_receipt_authority": false,
        "atomic_consumption_authority": false,
        "benchmark_execution": "not_authorized_by_this_event",
        "candidate_execution": "not_authorized_by_this_event",
        "execution_authority": false,
        "model_provider_execution": "not_authorized_by_this_event",
        "paid_execution": "not_authorized_by_this_event"
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_file_sha256",
        "approval_self_sha256",
        "approval_verification_report_sha256",
        "execution_contract_artifact_sha256",
        "execution_contract_sha256",
        "run_id",
        "run_identity_sha256",
        "run_storage_contract_sha256",
        "signed_payload_sha256"
      ],
      "properties": {
        "approval_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "approval_self_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "approval_verification_report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "execution_contract_artifact_sha256": {
          "const": "94422af8a5e24c6a855b66cf40868565ee3518d0c75eb5343b5d2450523b2c1e"
        },
        "execution_contract_sha256": {
          "const": "1e290b91d5e0be42f750bf0e655edee48d297f86ad3e3867b8fe9177fd5125ef"
        },
        "run_id": {
          "$ref": "#/$defs/sha256"
        },
        "run_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "run_storage_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signed_payload_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "event_kind": {
      "enum": [
        "atomic_approval_consumption_and_journal_genesis",
        "external_effect",
        "state_transition",
        "aggregate_accounting_update",
        "receipt_forbidden_latch",
        "recovery_cleanup"
      ]
    },
    "external_effect": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect_kind",
            "evidence_sha256"
          ],
          "properties": {
            "effect_kind": {
              "enum": [
                "atomic_approval_consumption",
                "capacity_reservation",
                "attempt_staging",
                "candidate_process_execution",
                "private_result_publication",
                "attempt_cleanup",
                "run_cleanup",
                "capacity_reservation_release",
                "aggregate_receipt_publication"
              ]
            },
            "evidence_sha256": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/sha256"
                }
              ]
            }
          }
        }
      ]
    },
    "occurred_at": {
      "$ref": "#/$defs/utc_second"
    },
    "phase": {
      "enum": [
        "GENESIS",
        "PREPARED",
        "COMMITTED"
      ]
    },
    "prepared_record_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "previous_record_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "profile": {
      "const": "agent_brain_negative_control_run_journal_event_v1"
    },
    "receipt_forbidden_latch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after",
        "before",
        "monotonic_false_to_true_only"
      ],
      "properties": {
        "after": {
          "type": "boolean"
        },
        "before": {
          "type": "boolean"
        },
        "monotonic_false_to_true_only": {
          "const": true
        }
      }
    },
    "record_ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 19999
    },
    "record_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "schedule_cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after",
        "before"
      ],
      "properties": {
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 248
        },
        "before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 248
        }
      }
    },
    "schema_version": {
      "const": 1
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after",
        "before",
        "scope"
      ],
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/run_state"
            },
            {
              "$ref": "#/$defs/attempt_state"
            }
          ]
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/run_state"
            },
            {
              "$ref": "#/$defs/attempt_state"
            }
          ]
        },
        "scope": {
          "enum": [
            "run",
            "attempt"
          ]
        }
      }
    },
    "status": {
      "const": "durable_journal_event_record_only_not_execution_authority"
    },
    "transition": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "e0_state_machine_sha256",
            "transition_verified"
          ],
          "properties": {
            "e0_state_machine_sha256": {
              "const": "31015d9150afaf6c73cbea84dc647039449cc5bfc498ac0efedddfabad271207"
            },
            "transition_verified": {
              "const": true
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "GENESIS"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "attempt_ordinal": {
            "type": "null"
          },
          "event_kind": {
            "const": "atomic_approval_consumption_and_journal_genesis"
          },
          "external_effect": {
            "const": {
              "effect_kind": "atomic_approval_consumption",
              "evidence_sha256": null
            }
          },
          "prepared_record_sha256": {
            "type": "null"
          },
          "previous_record_sha256": {
            "type": "null"
          },
          "record_ordinal": {
            "const": 0
          },
          "schedule_cursor": {
            "const": {
              "after": 0,
              "before": 0
            }
          },
          "state": {
            "const": {
              "after": "authority_and_inputs_verified",
              "before": "contract_checked_execution_forbidden",
              "scope": "run"
            }
          },
          "transition": {
            "const": {
              "e0_state_machine_sha256": "31015d9150afaf6c73cbea84dc647039449cc5bfc498ac0efedddfabad271207",
              "transition_verified": true
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "PREPARED"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "prepared_record_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "COMMITTED"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "prepared_record_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "properties": {
              "scope": {
                "const": "run"
              }
            },
            "required": [
              "scope"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "attempt_ordinal": {
            "type": "null"
          },
          "state": {
            "properties": {
              "after": {
                "$ref": "#/$defs/run_state"
              },
              "before": {
                "$ref": "#/$defs/run_state"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "attempt_ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 248
          },
          "state": {
            "properties": {
              "after": {
                "$ref": "#/$defs/attempt_state"
              },
              "before": {
                "$ref": "#/$defs/attempt_state"
              }
            }
          }
        }
      }
    }
  ]
}
