{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entire.io/schemas/agent-brain/offline-relevance-producer-identity-v1.json",
  "title": "Offline relevance ranked-run producer identity v1",
  "type": "object",
  "required": [
    "schema_version",
    "schema",
    "producer_id",
    "runner_sha256",
    "producer_code_sha256",
    "ranking_result_metadata_policy_id",
    "ranking_result_metadata_policy_sha256",
    "token_estimation_policy_id",
    "token_estimation_policy_sha256",
    "serialization_policy_id",
    "serialization_policy_sha256",
    "producer_identity_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "schema": {"const": "agent-brain-offline-relevance-producer-identity/v1"},
    "producer_id": {"$ref": "#/$defs/safeId"},
    "runner_sha256": {"$ref": "#/$defs/externalSha256"},
    "producer_code_sha256": {"$ref": "#/$defs/externalSha256"},
    "ranking_result_metadata_policy_id": {"$ref": "#/$defs/safeId"},
    "ranking_result_metadata_policy_sha256": {"$ref": "#/$defs/externalSha256"},
    "token_estimation_policy_id": {"$ref": "#/$defs/safeId"},
    "token_estimation_policy_sha256": {"$ref": "#/$defs/externalSha256"},
    "serialization_policy_id": {"$ref": "#/$defs/safeId"},
    "serialization_policy_sha256": {"$ref": "#/$defs/externalSha256"},
    "producer_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "externalSha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,255}$"
    }
  },
  "additionalProperties": false
}
