ests?\", distillCandidateCueRuleV1},\ninternal/cli/distill_candidates_test.go:794:\t\t{\"Would you always use JSON?\", distillCandidateCueRuleV1},\ninternal/cli/distill_candidates_test.go:795:\t\t{\"No, use JSON instead.\", distillCandidateCueCorrectionV1},\ninternal/cli/distill_candidates_test.go:796:\t\t{\"Use JSON instead of YAML because the tooling is stricter.\", distillCandidateCueDecisionV1},\ninternal/cli/distill_candidates_test.go:797:\t\t{\"This only fails when the cache is stale; otherwise it is safe.\", distillCandidateCueGotchaV1},\ninternal/cli/distill_candidates_test.go:798:\t\t{\"All handlers must return typed errors.\", distillCandidateCueInvariantV1},\ninternal/cli/distill_candidates_test.go:799:\t\t{\"Every migration must include a rollback.\", distillCandidateCueInvariantV1},\ninternal/cli/distill_candidates_test.go:800:\t\t{\"Tests are required for schema changes.\", distillCandidateCueInvariantV1},\ninternal/cli/distill_candidates_test.go:801:\t\t{\"My preference is explicit transactions.\", distillCandidateCuePreferenceV1},\ninternal/cli/distill_candidates_test.go:802:\t\t{\"I'd rather use PostgreSQL.\", distillCandidateCuePreferenceV1},\ninternal/cli/distill_candidates_test.go:803:\t\t{\"We'll stick with PostgreSQL.\", distillCandidateCueDecisionV1},\ninternal/cli/distill_candidates_test.go:804:\t\t{\"The fetcher must cap retry attempts at five to bound latency.\", distillCandidateCueInvariantV1},\ninternal/cli/distill_candidates_test.go:805:\t\t{\"Handlers must return typed errors.\", distillCandidateCueInvariantV1},\ninternal/cli/distill_candidates_test.go:806:\t\t{\"Migrations must include rollback.\", distillCandidateCueInvariantV1},\ninternal/cli/distill_candidates_test.go:809:\t\tif !slices.Contains(distillCandidateCuesV1(tc.text), tc.cue) {\ninternal/cli/distill_candidates_test.go:810:\t\t\tt.Errorf(\"%q missing cue %q: %v\", tc.text, tc.cue, distillCandidateCuesV1(tc.text))\ninternal/cli/distill_candidates_test.go:817:\t\t\"Need more context for this one task.\",\ninternal/cli/distill_candidates_test.go:821:\t\tif cues := distillCandidateCuesV1(text); len(cues) != 0 {\ninternal/cli/distill_candidates_test.go:822:\t\t\tt.Errorf(\"weak/task-local text %q produced cues %v\", text, cues)\ninternal/cli/distill_candidates_test.go:919:func TestPrepareCandidateInputCapsCueDenseSessions(t *testing.T) {\ninternal/cli/distill_quality_report_v1.go:113:\tout.WriteString(\"The default is a balanced 20-item calibration batch in a full-screen terminal workspace. Each screen shows only the exact statement under review, what the automatic filter decided, and every available Copilot, Cursor, and Claude decision with a short reason; unavailable judges are omitted. At the bottom, answer whether you agree with the judges' majority using `y` or `n`, or left/right plus Enter. If there is no majority, answer whether the filter itself was correct. Up/down scrolls, `x` skips, and `q` stops. Every answer is saved immediately and the same command resumes without repeating it. Human disagreements with the panel are retained for follow-up. Use `--plain` for the line-oriented accessibility or non-TTY fallback.\\n\\n\")\ninternal/cli/distill_quality_report_v1.go:184:\tout.WriteString(\"> **Audit archive — do not review this file linearly.** Use the resumable one-item-at-a-time reviewer instead:\\n>\\n> `entire brain facts distill-quality adjudicate --bundle <this-directory> --adjudicator <your-id>`\\n>\\n> It starts with a balanced 20-item calibration batch, saves every answer immediately, and resumes without repeating completed items. This document remains the complete immutable evidence trail.\\n\\n\")\ninternal/cli/distill_quality_judge_runner_v1.go:61:\tRecovery            bool                  `json:\"recovery,omitempty\"`\ninternal/cli/distill_quality_judge_runner_v1.go:381:func runDistillQualityJudgeProcessV1(ctx context.Context, workDir string, judge distillQualityJudgeV1, model string, prompt []byte, timeout time.Durat