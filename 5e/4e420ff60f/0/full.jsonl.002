t work|failed because|no effect|not worth|won't use|will not use)\\b|\\btried\\b.{0,120}\\b(?:failed|but|however|no effect)\\b|\\bavoid\\b.{0,80}\\bbecause\\b`)},\ninternal/cli/distill_candidates.go:995:\t{distillCandidateCueInvariantV1, regexp.MustCompile(`(?i)\\b(?:invariant|contract requires|only if|never|always|must not|cannot|must be|must remain|must stay|source of truth)\\b|\\b(?:the|this|that|all|every)\\b.{0,80}\\bmust\\b|\\b(?:[a-z][a-z-]*\\s+){0,3}[a-z][a-z-]*s\\s+must\\b|\\b(?:is|are) required (?:to|for)\\b`)},\ninternal/cli/distill_candidates.go:996:\t{distillCandidateCueGotchaV1, regexp.MustCompile(`(?i)\\b(?:gotcha|footgun|beware|watch out|non-obvious|surprising|edge case|root cause|turns out|only when|unless|otherwise|silent(?:ly)?|hangs?|races?|stale|breaks if|breaks when|fails if|fails when)\\b`)},\ninternal/cli/distill_candidates.go:997:\t{distillCandidateCueAcceptanceV1, regexp.MustCompile(`(?i)^(?:sounds good|approved|exactly|that's right|that is right|agreed|nice catch|ship it)(?:[.!]|$)|^yes[,!.]?\\s+(?:do|use|keep|make|that's|that is)\\b`)},\ninternal/cli/distill_candidates.go:1000:var distillCandidateQuestionV1 = regexp.MustCompile(`(?i)^(?:should|must|can|could|would|do|does|did|is|are|what|how|why|when)\\b.*\\?\\s*$`)\ninternal/cli/distill_candidates.go:1001:var distillCandidateStrongQuestionDirectiveV1 = regexp.MustCompile(`(?i)\\b(?:always|never|make sure|from now on|going forward|whenever|every time)\\b`)\ninternal/cli/distill_candidates.go:1006:// An imperative plan/spec header scopes the rest of its turn to a one-off\ninternal/cli/distill_candidates.go:1007:// implementation request. Such a turn often contains words like \"must\",\ninternal/cli/distill_candidates.go:1008:// \"invariant\", acceptance criteria, and verification commands, but those are\ninternal/cli/distill_candidates.go:1009:// task requirements rather than durable repository knowledge.\ninternal/cli/distill_candidates.go:1012:// Task briefs and continuation commands are