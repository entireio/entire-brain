\tcues := distillCandidateCuesV1(turn.Text)\ninternal/cli/distill_candidates.go:1123:\t\t\t\tcues = []distillCandidateCueV1{distillCandidateCueAcceptanceV1}\ninternal/cli/distill_candidates.go:1133:\t\t\tcues := distillCandidateAssistantCuesV1(turn.Text)\ninternal/cli/distill_candidates.go:1139:\t\t\tif index > 0 && transcript.Turns[index-1].Role == distillTranscriptRoleUserV1 && transcript.Turns[index-1].DirectUser && len(distillCandidateCuesV1(transcript.Turns[index-1].Text)) > 0 {\ninternal/cli/distill_candidates.go:1143:\t\t\t\tnextCues := distillCandidateCuesV1(transcript.Turns[index+1].Text)\ninternal/cli/distill_candidates.go:1144:\t\t\t\tif len(nextCues) == 0 && distillCandidateAdjacentAcceptanceV1.MatchString(strings.TrimSpace(transcript.Turns[index+1].Text)) {\ninternal/cli/distill_candidates.go:1145:\t\t\t\t\tnextCues = []distillCandidateCueV1{distillCandidateCueAcceptanceV1}\ninternal/cli/distill_candidates.go:1147:\t\t\t\tif distillCandidateCueSliceContainsV1(nextCues, distillCandidateCueAcceptanceV1) || distillCandidateCueSliceContainsV1(nextCues, distillCandidateCueCorrectionV1) {\ninternal/cli/distill_candidates.go:1191:\t\tacceptance := distillCandidateCueSliceContainsV1(trigger.cues, distillCandidateCueAcceptanceV1)\ninternal/cli/distill_candidates.go:1193:\t\t\tvar cues []distillCandidateCueV1\ninternal/cli/distill_candidates.go:1203:\t\t\t} else if acceptance && turns[index].Role == distillTranscriptRoleAssistantV1 && start+index == trigger.index-1 {\ninternal/cli/distill_candidates.go:1213:\t\t\tCues:                  append([]distillCandidateCueV1(nil), trigger.cues...),\ninternal/cli/distill_candidates.go:1226:\t\t\tfor _, cue := range trigger.Cues {\ninternal/cli/distill_candidates.go:1250:func boundDistillCandidateTextV1(text string, cues []distillCandidateCueV1, maxRunes int) string {\ninternal/cli/distill_candidates.go:1256:\tcueSet := make(map[distillCandidateCueV1]bool, len(cues))\ninternal/cli/distill_candidates.go:1260:\tfor _, rule :=