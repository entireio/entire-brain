istill_quality_adjudicate_v1.go:486:func saveDistillQualityHumanAdjudicationsV1(path string, records []distillQualityHumanAdjudicationV1) error {\ninternal/cli/distill_quality_adjudicate_v1.go:493:\t\treturn errors.New(\"quality human adjudications exceed the bounded store\")\ninternal/cli/distill_quality_adjudicate_v1.go:510:\t\t\treturn nil, fmt.Errorf(\"quality adjudication packet %q metadata: %w\", packet.PacketID, err)\ninternal/cli/distill_quality_adjudicate_v1.go:512:\t\tfocus, context, err := distillQualityReviewFocusV1(packet, metadata)\ninternal/cli/distill_quality_adjudicate_v1.go:514:\t\t\treturn nil, fmt.Errorf(\"quality adjudication packet %q focus: %w\", packet.PacketID, err)\ninternal/cli/distill_quality_adjudicate_v1.go:594:\trenderDistillQualityReviewEvidenceV1(output, item, fullEvidence)\ninternal/cli/distill_quality_adjudicate_v1.go:608:\t\t\t_, labels[score.Dimension] = distillQualityReviewScoreSummaryV1(score)\ninternal/cli/distill_quality_adjudicate_v1.go:628:func renderDistillQualityReviewEvidenceV1(output io.Writer, item distillQualityAdjudicateItemV1, full bool) {\ninternal/cli/distill_quality_adjudicate_v1.go:724:\t\treturn \"\", false, errors.New(\"quality adjudication: invalid terminal input\")\ninternal/cli/distill_quality_adjudicate_v1.go:729:func makeDistillQualityHumanAdjudicationV1(runID, adjudicatorID string, item distillQualityAdjudicateItemV1, admission, authority, safety, rationale string, at time.Time) distillQualityHumanAdjudicationV1 {\ninternal/cli/distill_quality_adjudicate_v1.go:744:\tidentity := distillQualitySHA256V1([]byte(strings.Join([]string{runID, adjudicatorID, item.Packet.PacketID}, \"\\x00\")))\ninternal/cli/distill_quality_adjudicate_v1.go:745:\treturn distillQualityHumanAdjudicationV1{\ninternal/cli/distill_quality_adjudicate_v1.go:750:\t\tAdvisoryDigest: distillQualityPanelAggregateDigestV1(item.Aggregate), AdjudicatorID: adjudicatorID,\ninternal/cli/distill_quality_adjudicate_tui_v1.go:23:func runDistillQualityAdjudicationTUIV1(bundleDir, adjudicatorID, queue string, limit int, input io.Reader, output io.Writer, theme tui.Theme, now func() time.Time) (distillQualityAdjudicateResultV1, error) {\ninternal/cli/distill_quality_adjudicate_tui_v1.go:26:\t\treturn result, fmt.Errorf(\"quality adjudication: input and output are required\")\ninternal/cli/distill_quality_adjudicate_tui_v1.go:31:\tsession, err := openDistillQualityAdjudicationSessionV1(bundleDir, adjudicatorID, queue, limit)\ninternal/cli/distill_quality_adjudicate_tui_v1.go:41:\tview, byViewID := makeDistillQualityReviewV1(session, queue)\ninternal/cli/distill_quality_adjudicate_tui_v1.go:42:\tuiResult, err := tui.RunQualityReview(input, output, theme, view, func(itemID, admission, authority, safety, rationale string) error {\ninternal/cli/distill_quality_adjudicate_tui_v1.go:45:\t\t\treturn fmt.Errorf(\"quality adjudication: unknown review item %q\", itemID)\ninternal/cli/distill_quality_adjudicate_tui_v1.go:55:\t\treturn session.result, fmt.Errorf(\"quality adjudication: terminal saved %d decisions but store committed %d\", uiResult.Saved, session.result.Reviewed)\ninternal/cli/distill_quality_adjudicate_tui_v1.go:60:func makeDistillQualityReviewV1(session *distillQualityAdjudicationSessionV1, queue string) (tui.QualityReview, map[string]distillQualityAdjudicateItemV1) {\ninternal/cli/distill_quality_adjudicate_tui_v1.go:61:\titems := make([]tui.QualityReviewItem, 0, len(session.items))\ninternal/cli/distill_quality_adjudicate_tui_v1.go:66:\t\titems = append(items, makeDistillQualityReviewItemV1(viewID, item))\ninternal/cli/distill_quality_adjudicate_tui_v1.go:68:\treturn tui.QualityReview{\ninternal/cli/distill_quality_adjudicate_tui_v1.go:69:\t\tTitle: \"Phase 2 quality review\",\ninternal/cli/distill_quality_adjudicate_tui_v1.go:71:\t\tProgress: tui.QualityReviewProgress{\ninternal/cli/distill_quality_adjudicate_tui_v1.go:79:func makeDistillQualityReviewItemV1(viewID string, item distillQualityAdjudicateItemV1) tui.QualityReviewItem {\ninternal/cli/distill_quality_adjudicate_tui_v1.go:84:\tview := tui.QualityReviewItem{\ninternal/cli/distill_quality_adjudicate_tui_v1.go:88:\t\tFocus:          make([]tui.QualityReviewEvidence, 0, len(item.Focus)),\ninternal/cli/distill_quality_adjudicate_tui_v1.go:89:\t\tContext:        make([]tui.QualityReviewEvidence, 0, len(item.Context)),\ninternal/cli/distill_quality_adjudicate_tui_v1.go:90:\t\tJudges:         make([]tui.QualityReviewJudge, 0, len(item.Aggregate.Verdicts)+len(item.Aggregate.MissingJudges)),\ninternal/cli/distill_quality_adjudicate_tui_v1.go:91:\t\tSources:        make([]tui.QualityReviewSource, 0, len(item.Sources)),\ninternal/cli/distill_quality_adjudicate_tui_v1.go:103:\t\tview.Focus = append(view.Focus, tui.QualityReviewEvidence{Label: label, Text: turn.Text})\ninternal/cli/distill_quality_adjudicate_tui_v1.go:110:\t\tview.Context = append(view.Context, tui.QualityReviewEvidence{Label: label, Kind: \"not the statement being judged\", Text: turn.Text})\ninternal/cli/distill_quality_adjudicate_tui_v1.go:117:\t\tjudge := tui.QualityReviewJudge{\ninternal/cli/distill_quality_adjudicate_tui_v1.go:119:\t\t\tRationale: distillQualityHumanVerdictNoteV1(verdict.Rationale), Scores: make([]tui.QualityReviewScore, 0, len(verdict.Scores)),\ninternal/cli/distill_quality_adjudicate_tui_v1.go:122:\t\t\tsummary, value := distillQualityReviewScoreSummaryV1(score)\ninternal/cli/distill_quality_adjudicate_tui_v1.go:123:\t\t\tjudge.Scores = append(judge.Scores, tui.QualityReviewScore{\ninternal/cli/distill_quality_adjudicate_tui_v1.go:140:\t\tview.Judges = append(view.Judges, tui.QualityReviewJudge{Name: string(missing), State: \"missing\", Rationale: \"No advisory verdict is available; the human decision remains independent.\"})\ninternal/cli/distill_quality_adjudicate_tui_v1.go:150:\t\tview.Sources = append(view.Sources, tui.QualityReviewSource{\ninternal/cli/distill_quality_adjudicate_tui_v1.go:200:func distillQualityReviewScoreSummaryV1(score distillQualityPanelScoreV1) (string, string) {\ninternal/cli/distill_quality_report_v1.go:111:\tout.WriteString(\"entire brain facts distill-quality adjudicate \\\\\\n  --bundle <this-directory> \\\\\\n  --adjudicator <your-id>\\n\")\ninternal/cli/distill_quality_report_v1.go:184:\tout.WriteString(\"> **Audit archive — do not review this file linearly.** Use the resumable one-item-at-a-time reviewer instead:\\n>\\n> `entire brain facts distill-quality adjudicate --bundle <this-directory> --adjudicator <your-id>`\\n>\\n> It starts with a balanced 20-item calibration batch, saves every answer immediately, and resumes without repeating completed items. This document remains the complete immutable evidence trail.\\n\\n\")\ninternal/cli/distill_quality_report_v1.go:203:\tout.WriteString(\"Read each advisory score as input for human adjudication. It is not a proof label and must not be copied as one. The JSONL template deliberately contains null decisions and null proof labels.\\n\\n\")\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a08c52-627e-72c2-ad24-e4d4de487a71"}}}
